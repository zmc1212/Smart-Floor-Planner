# 家客来 Smart Floor Planner V1.0 production runtime env template.
#
# Copy this file OUTSIDE the release directory (for example /opt/sfp/.env.production),
# keep it out of Git, and make it readable only by the deploy account:
#   install -m 600 runtime.env.template /opt/sfp/.env.production
#
# Every "replace_with_..." value is intentionally rejected by
# scripts/production-env-check.mjs. Self-owned secrets can be filled from the
# Secret Bootstrap plan with:
#   node scripts/apply-secret-plan.mjs --plan <plan.env> --target <runtime.env> --apply
# Never commit a filled copy.

NODE_ENV=production

# Database connections. Replace host, database and passwords with approved values.
DATABASE_URL="postgresql://sfp_app:replace_with_app_password@replace_with_db_host:5432/smart_floor_planner"
DATABASE_MIGRATION_URL="postgresql://sfp_migrator:replace_with_migrator_password@replace_with_db_host:5432/smart_floor_planner"
POSTGRES_PASSWORD="replace_with_owner_password"

# Self-owned secrets. Prefer the Secret Bootstrap plan; keep *_PREVIOUS when
# rotating so historical AI/media ciphertext stays readable.
JWT_SECRET="replace_with_at_least_32_random_characters"
INTERNAL_SECRET="replace_with_at_least_32_random_characters"
AI_PROVIDER_KEY_ENCRYPTION_SECRET="replace_with_a_separate_long_random_secret"
MEDIA_STORAGE_KEY_ENCRYPTION_SECRET="replace_with_a_long_random_secret"
CRON_SECRET="replace_with_an_independent_32_character_secret"
JWT_SECRET_PREVIOUS=""
AI_PROVIDER_KEY_ENCRYPTION_SECRET_PREVIOUS=""
MEDIA_STORAGE_KEY_ENCRYPTION_SECRET_PREVIOUS=""

AUTH_COOKIE_SECURE=true
ALLOW_TENANT_ENTERPRISE_RESET=false

# WeChat Mini Program production configuration.
WX_APPID="replace_with_production_appid"
WX_APPSECRET="replace_with_production_appsecret"
WECHAT_MINIPROGRAM_CODE_ENV=release
MINIPROGRAM_API_PUBLIC_ORIGIN="https://replace_with_public_origin"

# Bailian managed RAG and local embedding fallback.
ASSISTANT_KNOWLEDGE_PROVIDER=BAILIAN_RAG
ASSISTANT_BAILIAN_RAG_WORKSPACE_ID="replace_with_bailian_workspace_id"
ASSISTANT_BAILIAN_RAG_API_KEY="replace_with_bailian_api_key"
ASSISTANT_BAILIAN_RAG_CATEGORY_ID=default
ASSISTANT_BAILIAN_RAG_EMBEDDING_MODEL=text-embedding-v4
ASSISTANT_EMBEDDING_URL="https://replace_with_embedding_host"
ASSISTANT_EMBEDDING_API_KEY="replace_with_embedding_api_key"
ASSISTANT_TEXT_MODEL=qwen3.7-flash
ASSISTANT_RESPONSES_API=0

# Worker shared health file. Compose injects the same path for admin and worker.
ASSISTANT_WORKER_HEALTH_FILE=/shared/assistant-worker-health.json

# Deployment smoke account. Use a dedicated least-privilege account and rotate it.
DEPLOY_SMOKE_USERNAME="replace_with_smoke_user"
DEPLOY_SMOKE_PASSWORD="replace_with_a_dedicated_strong_password"
DEPLOY_SMOKE_PATHS=""

# Worker pilot gate stays closed until a separate approval provides real IDs.
# XIAOK_STAGE_REMINDER_MODE=pilot
# XIAOK_STAGE_REMINDER_ENTERPRISE_ID=
# XIAOK_STAGE_REMINDER_PILOT_ID=
# XIAOK_WEEKLY_REPORT_MODE=pilot
# XIAOK_WEEKLY_REPORT_ENTERPRISE_ID=
# XIAOK_WEEKLY_REPORT_PILOT_ID=

# Optional integrations. Leave unset or replace with approved values; do not use
# placeholders in production.
# AMAP_KEY=
# KUJIALE_APP_KEY=
# KUJIALE_APP_SECRET=
# POLLINATIONS_API_KEY=
# GOOGLE_AI_API_KEY=
# LONGCAT_API_KEY=
