{
  "name": "admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/sync-survey-dimension-plan.mjs",
    "dev": "next dev --turbopack -H 0.0.0.0 -p 3006",
    "dev:webpack": "next dev --webpack -H 0.0.0.0 -p 3006",
    "dev:turbo": "next dev --turbopack -H 0.0.0.0 -p 3006",
    "prebuild": "node scripts/sync-survey-dimension-plan.mjs",
    "build": "next build",
    "start": "next start",
    "worker:lead-claims": "node scripts/lead-claim-worker.mjs",
    "lint": "eslint",
    "test:survey-canvas": "npx tsx --test src/lib/__tests__/survey-canvas-viewport.test.ts src/lib/__tests__/survey-canvas-runtime.test.ts src/lib/__tests__/survey-floor-plan-snapshot.test.ts",
    "test:ai": "npx tsx --test src/lib/ai/__tests__/*.test.ts",
    "test:postgresql": "npx tsx --test src/lib/__tests__/postgresql.test.ts src/lib/__tests__/lead-lifecycle.test.ts src/lib/__tests__/lead-conversion.test.ts src/lib/__tests__/lead-source.test.ts src/lib/__tests__/lead-staff-visibility.test.ts src/lib/__tests__/subscription-notification.test.ts src/lib/__tests__/referral-attribution.test.ts src/lib/__tests__/wechat-access-token.test.ts src/lib/__tests__/customer-phone.test.ts src/db/__tests__/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/postgres-migrate.mjs",
    "db:check": "node scripts/postgres-check.mjs",
    "db:backup": "node scripts/postgres-backup.mjs",
    "db:restore-drill": "node scripts/postgres-restore-drill.mjs",
    "db:cleanup:dry-run": "node scripts/postgres-cleanup-dry-run.mjs",
    "db:cleanup:execute": "node scripts/postgres-cleanup-execute.mjs",
    "docker:build": "docker compose build",
    "docker:build-admin": "docker compose build --no-cache admin",
    "docker:migrate": "docker compose run --rm migrate",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:restart": "docker compose build admin && docker compose run --rm migrate && docker compose up -d --force-recreate admin",
    "docker:logs": "docker compose logs -f admin",
    "docker:release": "release.bat"
  },
  "dependencies": {
    "@alicloud/dysmsapi20170525": "^4.6.0",
    "@alicloud/openapi-client": "^0.4.15",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@ant-design/pro-components": "^2.8.10",
    "@google/generative-ai": "^0.24.1",
    "@napi-rs/canvas": "^1.0.7",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@tarikjabiri/dxf": "2.8.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/three": "^0.183.1",
    "antd": "^5.29.3",
    "bcryptjs": "^3.0.3",
    "camera-controls": "^3.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.8.0",
    "next": "16.2.3",
    "pg": "^8.22.0",
    "proxy-agent": "^5.0.0",
    "qiniu": "^7.15.2",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-image-crop": "^11.0.10",
    "react-photo-view": "^1.2.7",
    "shadcn": "^4.3.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "tencentcloud-sdk-nodejs-common": "^4.1.220",
    "tencentcloud-sdk-nodejs-sms": "^4.1.240",
    "three": "^0.183.2",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@dxfjs/parser": "0.3.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
