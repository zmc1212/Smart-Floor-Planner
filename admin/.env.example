# MongoDB connection string

# PostgreSQL application and migration connections.
# Supply DATABASE_MIGRATION_URL only to migration jobs in production; do not
# expose the migrator credential to the long-running admin container.
# The Docker Compose development defaults are documented in docker-compose.yml.
DATABASE_URL="postgresql://sfp_app:replace_with_app_password@localhost:5432/smart_floor_planner"
DATABASE_MIGRATION_URL="postgresql://sfp_migrator:replace_with_migration_password@localhost:5432/smart_floor_planner"
POSTGRES_APPLICATION_NAME="smart-floor-planner-admin"
POSTGRES_POOL_MAX="10"
POSTGRES_CONNECTION_TIMEOUT_MS="5000"
POSTGRES_IDLE_TIMEOUT_MS="30000"
POSTGRES_IDLE_TRANSACTION_TIMEOUT_MS="30000"
POSTGRES_STATEMENT_TIMEOUT_MS="30000"
POSTGRES_HEALTHCHECK_REQUIRED="false"

# WeChat Mini Program credentials
WX_APPID="your_appid_here"
WX_APPSECRET="your_appsecret_here"

# JWT Secret for admin authentication (generate a random string)
JWT_SECRET="your_jwt_secret_here"
# Internal bootstrap endpoint secret and one-time initial platform account.
# Use independent random values; the password must be at least 12 characters and
# the internal secret at least 32 characters.
INTERNAL_SECRET="replace_with_at_least_32_random_characters"
INITIAL_ADMIN_USERNAME="admin"
INITIAL_ADMIN_PASSWORD="replace_with_a_strong_initial_password"

# Public HTTPS origin used in signed Mini Program AI image URLs.
# Local development can omit this and use the incoming Host header.
MINIPROGRAM_API_PUBLIC_ORIGIN="https://api.example.com"

# Media storage. The first implementation uses the local provider; cloud
# providers can be registered later without changing business APIs.
MEDIA_STORAGE_PROVIDER="local"
AI_ASSET_STORAGE_DIR="/data/ai-assets"
MEDIA_ASSET_PURGE_GRACE_DAYS="7"
MEDIA_ASSET_SIGNED_URL_TTL_SECONDS="3600"
# Dedicated server-side master key for encrypting cloud media credentials.
# Generate a long random value and never expose it to the Mini Program/client.
MEDIA_STORAGE_KEY_ENCRYPTION_SECRET="replace_with_a_long_random_secret"

# Location Services
AMAP_KEY=your_amap_web_service_key_here

# Pollinations AI API
POLLINATIONS_API_KEY="your_pollinations_key_here"

# Google AI (Gemini) API
GOOGLE_AI_API_KEY="your_google_ai_key_here"
LONGCAT_API_KEY="your_longcat_key_here"

# KuJiale OpenAPI sandbox
KUJIALE_BASE_URL="https://sandbox-openapi.kujiale.com"
KUJIALE_APP_KEY="your_kujiale_openapi_appkey_here"
KUJIALE_APP_SECRET="your_kujiale_openapi_appsecret_here"
KUJIALE_SEARCH_PATH="/p/openapi/v2/floorplan/image/search"
