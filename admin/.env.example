# PostgreSQL application and migration connections.

# Explicit development-only C01 composable review rollout; comma-separated enterprise IDs.
# Empty or NODE_ENV=production keeps new runs on their previous protocol. Existing runs stay bound.
ASSISTANT_REVIEW_DEVELOPMENT_ENTERPRISE_IDS=""
# Supply DATABASE_MIGRATION_URL only to migration jobs in production; do not
# expose the migrator credential to the long-running admin container.
# The Docker Compose development defaults are documented in docker-compose.yml.
DATABASE_URL="postgresql://sfp_app:replace_with_app_password@localhost:5432/smart_floor_planner"
DATABASE_MIGRATION_URL="postgresql://sfp_migrator:replace_with_migration_password@localhost:5432/smart_floor_planner"
POSTGRES_APPLICATION_NAME="smart-floor-planner-admin"
POSTGRES_POOL_MAX="10"
POSTGRES_CONNECTION_TIMEOUT_MS="5000"
POSTGRES_IDLE_TIMEOUT_MS="30000"
POSTGRES_IDLE_TRANSACTION_TIMEOUT_MS="30000"
POSTGRES_STATEMENT_TIMEOUT_MS="30000"
POSTGRES_HEALTHCHECK_REQUIRED="false"

# WeChat Mini Program credentials
WX_APPID="your_appid_here"
WX_APPSECRET="your_appsecret_here"
# Optional: local/experience Mini Program code target. Defaults to develop in
# Next development and release in production.
WECHAT_MINIPROGRAM_CODE_ENV="develop"

# JWT Secret for admin authentication (generate a random string)
JWT_SECRET="your_jwt_secret_here"
# Set to false only for a trusted intranet deployment reached through plain HTTP.
# Keep true for every HTTPS or public deployment.
AUTH_COOKIE_SECURE="false"
# Tenant test-data reset/purge on /referrer-network-operations.
# `next dev` allows it automatically. Docker Compose and `next start` set
# NODE_ENV=production, so preview/reset/purge stay 403 unless this is exactly true.
# Set true only on internal-test servers; leave unset or false on a real production database.
ALLOW_TENANT_ENTERPRISE_RESET="false"
# Internal bootstrap endpoint secret and one-time initial platform account.
# Use independent random values; the password must be at least 12 characters and
# the internal secret at least 32 characters.
INTERNAL_SECRET="replace_with_at_least_32_random_characters"
CRON_SECRET="replace_with_an_independent_32_character_secret"
INITIAL_ADMIN_USERNAME="admin"
INITIAL_ADMIN_PASSWORD="replace_with_a_strong_initial_password"

# Production deployment smoke account. Use a dedicated active account with the
# smallest practical role. deploy.sh always verifies /api/auth/me after login;
# optional comma-separated authenticated GET endpoints can extend the check.
DEPLOY_SMOKE_USERNAME="deploy_smoke_account"
DEPLOY_SMOKE_PASSWORD="replace_with_a_dedicated_strong_password"
DEPLOY_SMOKE_PATHS=""

# Public HTTPS origin used in signed Mini Program AI image URLs.
# Local development can omit this and use the incoming Host header.
MINIPROGRAM_API_PUBLIC_ORIGIN="https://api.example.com"

# Media storage. The first implementation uses the local provider; cloud
# providers can be registered later without changing business APIs.
MEDIA_STORAGE_PROVIDER="local"
AI_ASSET_STORAGE_DIR="/data/ai-assets"
MEDIA_ASSET_PURGE_GRACE_DAYS="7"
MEDIA_ASSET_SIGNED_URL_TTL_SECONDS="3600"
# Dedicated server-side master key for encrypting cloud media credentials.
# Generate a long random value and never expose it to the Mini Program/client.
MEDIA_STORAGE_KEY_ENCRYPTION_SECRET="replace_with_a_long_random_secret"

# Location Services
AMAP_KEY=your_amap_web_service_key_here
# Prefer the platform /map-settings page. These optional legacy values can be
# explicitly imported once; later runtime changes use encrypted database config.
# A saved Key and the search switch control availability. Authorization records
# are optional project notes, not AMap console/API parameters or enablement gates.
# The legacy confirmation flags below are retained for compatibility only.
AMAP_WEB_SERVICE_KEY=""
AMAP_WEB_SERVICE_SIGNING_KEY=""
AMAP_COMMERCIAL_LICENSE_CONFIRMED="false"
AMAP_BINDING_RIGHTS_CONFIRMED="false"
AMAP_LICENSE_REFERENCE=""
AMAP_RIGHTS_VALID_UNTIL=""
# Application-wide request budget; no automatic purchases or recharge.
AMAP_APP_DAILY_LIMIT="1000"

# Pollinations AI API
POLLINATIONS_API_KEY="your_pollinations_key_here"

# API Nebula fallback (creates an image provider at priority 20 when set)
APINEBULA_API_KEY="your_apinebula_key_here"
APINEBULA_BASE_URL="https://apinebula.ai"
APINEBULA_IMAGE_MODEL="gpt-image-2"

# Google AI (Gemini) API
GOOGLE_AI_API_KEY="your_google_ai_key_here"
LONGCAT_API_KEY="your_longcat_key_here"

# KuJiale OpenAPI sandbox
KUJIALE_BASE_URL="https://sandbox-openapi.kujiale.com"
KUJIALE_APP_KEY="your_kujiale_openapi_appkey_here"
KUJIALE_APP_SECRET="your_kujiale_openapi_appsecret_here"
KUJIALE_SEARCH_PATH="/p/openapi/v2/floorplan/image/search"

# Optional assistant-only model on the existing text provider; does not change AI Studio.
# Verify availability with that provider before enabling. Empty uses its chat.general mapping.
ASSISTANT_TEXT_MODEL=""
ASSISTANT_TEXT_DISABLE_THINKING="0"
# Set to 1 only for a verified SiliconFlow model supporting enable_thinking=false.
# Keep the saved model unless an alternative passes isolated acceptance.
# Verified isolated choice: ASSISTANT_TEXT_MODEL="Qwen/Qwen3.5-4B"
# with ASSISTANT_TEXT_DISABLE_THINKING="1". See docs/xiaok-assistant-phase-1.md.

# Daily request/token/cost ceilings are disabled by default. Usage remains recorded.
# Set to 1 only when explicitly restoring daily limits (including quota-guard tests).
ASSISTANT_DAILY_LIMITS_ENABLED="0"

# B5.8 consumes project events on the existing assistant Worker.
# Apply migration 0121 before opting an isolated enterprise in.
NATIVE_WORKFLOW_DELEGATION_ENABLED="0"
NATIVE_WORKFLOW_DELEGATION_ENTERPRISE_IDS=""
# Enable B5.9 project collaboration for explicit development tenants.
NATIVE_WORKFLOW_COLLABORATION_ENTERPRISE_IDS=""

# Initial assistant monitoring thresholds; calibrate during the enterprise pilot.
# These return alert states only; they do not send notifications or enable cleanup.
ASSISTANT_OPERATIONS_QUEUE_BACKLOG_WARN="10"
ASSISTANT_OPERATIONS_QUEUE_BACKLOG_CRITICAL="50"
ASSISTANT_OPERATIONS_QUEUE_AGE_WARN_SECONDS="60"
ASSISTANT_OPERATIONS_QUEUE_AGE_CRITICAL_SECONDS="300"
ASSISTANT_OPERATIONS_LATENCY_P95_WARN_MS="30000"
ASSISTANT_OPERATIONS_LATENCY_P95_CRITICAL_MS="90000"
ASSISTANT_OPERATIONS_INSUFFICIENT_RATIO_WARN="0.2"
ASSISTANT_OPERATIONS_INSUFFICIENT_RATIO_CRITICAL="0.5"
ASSISTANT_OPERATIONS_CITATION_FAILURE_WARN="1"
ASSISTANT_OPERATIONS_CITATION_FAILURE_CRITICAL="5"
ASSISTANT_OPERATIONS_UNKNOWN_COST_WARN="1"
ASSISTANT_OPERATIONS_UNKNOWN_COST_CRITICAL="5"
ASSISTANT_OPERATIONS_WORKER_STALE_SECONDS="210"
# API and worker must see the same file to report heartbeat freshness across containers.
# Missing/inaccessible files remain unknown; absence is never a successful live probe.
# ASSISTANT_WORKER_HEALTH_FILE="/shared/assistant-worker-health.json"

# Designer portfolio third-party 3D tours. Comma-separated `host=provider` pairs;
# hosts only (no scheme/path) and HTTPS only. Empty uses the defaults below.
# The target host must also be registered as a Mini Program business domain,
# otherwise the web-view opens the in-app fallback instead of the tour.
# PORTFOLIO_TOUR_HOSTS="matterport.com=Matterport,kuula.co=Kuula,720yun.com=720云,3dvista.com=3DVista"

# Private construction camera gateway. Credentials are server-only.
# Production requires an HTTPS origin registered as the Mini Program business domain.
# CAMERA_PUBLIC_ORIGIN="https://video.example.com"
# CAMERA_APP_ORIGIN="http://127.0.0.1:3006"
# CAMERA_WVP_ORIGIN="http://127.0.0.1:18080"
# CAMERA_MEDIA_ORIGIN="http://127.0.0.1:8080"
# CAMERA_WVP_USERNAME="admin"
# CAMERA_WVP_PASSWORD=""
# CAMERA_GATEWAY_PORT="3017"
# CAMERA_BIND_HOST="127.0.0.1"
# CAMERA_ZLM_SECRET=""
# CAMERA_MEDIA_SERVER_ID="wvp-zlm-01"
# CAMERA_RECORDING_ROOT="/opt/media/www/record"
# CAMERA_NODE_RETENTION_DAYS="7" # Must not exceed the actual WVP node retention.
# CAMERA_STORAGE_ORIGIN="http://127.0.0.1:18082" # Private read-only media-volume probe.
# CAMERA_STORAGE_TOKEN="" # At least 32 characters; never expose to clients.
# CAMERA_MEDIA_VOLUME="wvp-stack_media-data" # Existing volume, mounted read-only by the probe.
# CAMERA_RECORDING_HOST_PATH="F:/SmartFloorPlannerCamera/media/record" # Approved local host bind; Windows virtual-disk free space is insufficient.
# SD playback requires a reachable private device clock/card reader; no device writes.
# CAMERA_SD_PYTHON="/usr/bin/python3"
# CAMERA_SD_VENDOR_ADAPTER="/opt/wvp/onboarding" # Verified vendor core.py adapter directory.
# CAMERA_SD_DEVICES_FILE="/run/secrets/camera-sd-devices.json" # Private device/channel -> ip,port,username,password,serial mapping. Never expose to clients.
# Alternative for the pinned WVP: authenticated, read-only DeviceStatus clock observer.
# CAMERA_SD_CLOCK_ORIGIN="http://127.0.0.1:28083"
# CAMERA_SD_CLOCK_TOKEN="" # Separate private token, at least 32 characters. No fallback on failure.

# Independent public live: separate owned silent relay; no photo-consent reuse.
# Server-only origins/secret. Blank keeps this capability unavailable.
PUBLIC_LIVE_ZLM_ORIGIN=""
PUBLIC_LIVE_ZLM_SECRET=""
PUBLIC_LIVE_SOURCE_ORIGIN=""
# HTTPS application origin for Mini Program media; loopback HTTP is development only.
PUBLIC_LIVE_PUBLIC_ORIGIN=""
# Run its separate cleanup duty when enabled: node --import tsx scripts/public-live-worker.ts

# Optional isolated FastGPT workflow bridge (development only). Empty preserves the original paths.
# ACL-protected JSON: baseUrl, apiKey, knowledgeAppId, stageAppId, optional auditFile.
# Uses approved SSH loopback :18300 and a temporary, owned reverse callback tunnel :18310.
XIAOK_FASTGPT_WORKFLOWS_FILE=""

# Optional opening scene registry (XIAOK_OPENINGS_FILE, protocol xiaok-openings-v1).
# One tool-free FastGPT app per scene; no entry means the local opening path stays.
XIAOK_OPENINGS_FILE=""

# Optional server-side voice transcription. Explicit local runtime/model only;
# no model download or paid fallback. Set these in .env.local for development.
# API and assistant job execution must use the same configuration.
ASSISTANT_ASR_PROVIDER=""
ASSISTANT_ASR_PYTHON=""
ASSISTANT_ASR_MODEL_PATH=""
ASSISTANT_ASR_MODEL_SHA256=""
# Provider: local-faster-whisper. Python/model paths must be absolute; SHA256
# identifies model.bin. Install scripts/assistant-speech-requirements.txt in the
# chosen Python environment. npm run dev supervises the existing job worker.
