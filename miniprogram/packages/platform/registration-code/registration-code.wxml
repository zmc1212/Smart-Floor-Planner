<!--
THESIS: 平台管理员现场出示当前生效企业开户码合成海报。
OWN-WORLD: 胶囊安全出示顶栏 + 全幅服务端合成海报，不新画小 K。
STORY: 打开即展示只读 er_ 海报；无码或微信失败可重试，不换新。
FIRST VIEWPORT: 返回、标题、海报与说明在 390x844 同屏可达。
FORM: 内置商户入驻海报模板 + 服务端二维码叠加
-->
<view class="page">
  <view
    class="nav"
    style="padding-top: {{navigationTop}}px; min-height: {{navigationHeight}}px; padding-right: {{navigationRight}}px;"
  >
    <view class="nav-back" bindtap="onBack" aria-role="button" aria-label="返回">
      <view class="back-chevron"></view>
    </view>
    <view class="brand-lockup">
      <image class="brand-logo" src="/images/home-ip-v1/brand-logo.png" mode="aspectFit" />
      <text class="brand-name">家客来</text>
      <view class="nav-divider"></view>
      <text class="nav-title">出示开户码</text>
    </view>
  </view>

  <scroll-view scroll-y class="body" enhanced show-scrollbar="{{false}}">
    <view wx:if="{{loading}}" class="poster-state">
      <text class="poster-state-copy">开户海报加载中</text>
    </view>
    <view wx:elif="{{!hasActive}}" class="poster-state">
      <image class="poster-state-icon" src="/images/mine-icons/shield-check.png" mode="aspectFit" />
      <text class="poster-state-title">暂无生效开户码</text>
      <text class="poster-state-copy">请在电脑后台生成后再出示</text>
    </view>
    <view wx:elif="{{errorMessage}}" class="poster-state">
      <image class="poster-state-icon" src="/images/mine-icons/shield-check.png" mode="aspectFit" />
      <text class="poster-state-title">开户海报暂不可用</text>
      <text class="poster-state-copy">{{errorMessage}}</text>
      <view class="retry" bindtap="onRetry">重新查看</view>
    </view>
    <view wx:else class="poster-wrap">
      <image class="poster-image" src="{{posterImagePath}}" mode="widthFix" show-menu-by-longpress />
      <text class="status-line">{{statusLine}}</text>
    </view>
  </scroll-view>
</view>
