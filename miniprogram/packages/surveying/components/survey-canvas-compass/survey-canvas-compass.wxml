<cover-view class="survey-canvas-compass {{active ? 'active' : ''}}" style="top: {{safeTop}}px;" catchtap="onTap">
  <cover-view class="compass-dial" style="transform: rotate({{rotationDeg}}deg);">
    <cover-view class="compass-needle"></cover-view>
    <cover-view class="compass-label">N</cover-view>
  </cover-view>
</cover-view>
