  height: 54rpx;
  padding: 0;
  border: 1rpx solid #dce4ee;
  border-radius: 12rpx;
  background: #ffffff;
  color: #17345e;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 30rpx;
  text-align: center;
  box-sizing: border-box;
  white-space: nowrap;
  overflow: hidden;
}

.opening-direction-option.active {
  border-color: #08ba48;
  background: #08ba48;
  color: #ffffff;
  font-weight: 700;
  box-shadow: 0 8rpx 16rpx rgba(8, 186, 72, 0.16);
}

.opening-direction-label {
  display: block;
  width: 100%;
  height: 52rpx;
  color: inherit;
  font-size: inherit;
  font-weight: inherit;
  line-height: 52rpx;
  text-align: center;
  white-space: nowrap;
}

.opening-primary-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 58rpx;
  margin-top: 24rpx;
  border-radius: 14rpx;
  background: #08ba48;
  color: #ffffff;
  box-shadow: 0 7rpx 16rpx rgba(8, 186, 72, 0.16);
  box-sizing: border-box;
  pointer-events: auto;
}

.opening-action-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 10rpx;
}

.opening-action-label {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 32rpx;
}

.opening-delete-divider {
  width: calc(100% - 20rpx);
  height: 1px;
  margin: 20rpx 10rpx 4rpx;
  background: #dbe5df;
  transform: scaleY(0.5);
  transform-origin: center;
}

.opening-delete-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 60rpx;
  color: #df2c24;
  pointer-events: auto;
}

.opening-delete-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 10rpx;
  flex: 0 0 auto;
}

.opening-delete-label {
  color: #df2c24;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 32rpx;
  white-space: nowrap;
}

.history-action-bar.bottom-control-dock {
  position: fixed;
  left: 50%;
  z-index: 24;
  display: flex;
  gap: 0;
  align-items: center;
  width: 575rpx;
  min-width: 575rpx;
  height: 108rpx;
  padding: 8rpx;
  border: 1rpx solid rgba(15, 35, 23, 0.08);
  border-radius: 38rpx;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 12rpx 30rpx rgba(15, 35, 23, 0.12);
  transform: translateX(-50%);
  box-sizing: border-box;
}

.history-action {
  min-width: 96rpx;
  height: 64rpx;
  padding: 0 18rpx;
  border-radius: 14rpx;
  background: #f5f8f5;
  color: #374151;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 64rpx;
  text-align: center;
  white-space: nowrap;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.history-action.danger {
  color: #b42318;
  background: #fff1f1;
}

.history-action.disabled {
  color: #9ca3af;
  background: #f1f5f1;
}

.history-action-count {
  min-width: 26rpx;
  height: 26rpx;
  margin-left: 6rpx;
  border-radius: 13rpx;
  background: rgba(23, 161, 76, 0.14);
  color: #16803e;
  font-size: 18rpx;
  line-height: 26rpx;
  text-align: center;
}

.cursor-fab {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

/* 拖拽时保留底部圆形状态容器，只把其中的光标图形“拖走”。 */
.cursor-fab-drop.is-dragging {
  opacity: 1;
}

.cursor-fab-drop.is-dragging .cursor-fab-icon {
  border: 3rpx solid #f07a21;
  background: rgba(255, 255, 255, 0.96);
}

.cursor-fab-drop.is-dragging .cursor-drop-h,
.cursor-fab-drop.is-dragging .cursor-drop-v,
.cursor-fab-drop.is-dragging .cursor-drop-box,
.cursor-fab-drop.is-dragging .cursor-fab-label {
  opacity: 0;
}

.cursor-fab-icon {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 14rpx 32rpx rgba(15, 23, 42, 0.2);
}

.cursor-fab-label {
  color: #374151;
  font-size: 18rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.cursor-reset-icon {
  border: 3rpx solid #f07a21;
  box-sizing: border-box;
}

.cursor-reset-image {
  width: 100%;
  height: 100%;
}

.cursor-drop-icon {
  background: rgba(255, 255, 255, 0.98);
  border: 2rpx solid rgba(240, 122, 33, 0.2);
  box-sizing: border-box;
}

.cursor-drop-h,
.cursor-drop-v {
  position: absolute;
  background: #f07a21;
  border-radius: 2rpx;
}

.cursor-drop-h {
  left: 14rpx;
  right: 14rpx;
  top: 49rpx;
  height: 2rpx;
}

.cursor-drop-v {
  top: 14rpx;
  bottom: 14rpx;
  left: 50%;
  width: 2rpx;
  transform: translateX(-50%);
  box-sizing: border-box;
}

.cursor-drop-box {
  position: absolute;
  left: 36rpx;
  top: 36rpx;
  width: 26rpx;
  height: 26rpx;
  border: 2rpx solid #f07a21;
  box-sizing: border-box;
}

/* ════════════════════════════════════════
   拖拽放置光标展示层
════════════════════════════════════════ */
.cursor-lens {
  position: absolute;
  left: 24rpx;
  top: 176rpx;
  z-index: 32;
  width: 196px;
  padding: 8px;
  border-radius: 22rpx;
  background: transparent;
  box-shadow: 0 12rpx 34rpx rgba(15, 23, 42, 0.24);
  box-sizing: border-box;
  pointer-events: none;
}

.cursor-lens-grid {
  position: relative;
  width: 180px;
  height: 180px;
  overflow: hidden;
  border-radius: 16rpx;
  background: transparent;
  box-shadow: inset 0 0 0 1px rgba(15, 23, 42, 0.08);
}

.cursor-lens.vertex .cursor-lens-target {
  border-color: #1677ff;
  background: rgba(22, 119, 255, 0.14);
}

.cursor-lens.vertex .cursor-lens-cross {
  background: #1677ff;
}

.cursor-lens-cross {
  position: absolute;
  left: 50%;
  top: 50%;
  background: #f07a21;
  transform: translate(-50%, -50%);
}

.cursor-lens-cross.horizontal {
  width: 180px;
  height: 2px;
}

.cursor-lens-cross.vertical {
  width: 2px;
  height: 180px;
}

.cursor-lens-target {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 18px;
  height: 18px;
  border: 3px solid #f07a21;
  border-radius: 50%;
  background: rgba(240, 122, 33, 0.12);
  transform: translate(-50%, -50%);
  box-sizing: border-box;
}

.cursor-lens-meta {
  display: flex;
  justify-content: space-between;
  gap: 8rpx;
  margin-top: 10rpx;
  color: #374151;
  font-size: 20rpx;
  font-weight: 600;
  white-space: nowrap;
}


