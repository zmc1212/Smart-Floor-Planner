  align-items: center;
}

.survey-guide-accent {
  color: var(--text-brand);
  font-weight: 700;
}

.guide-target-control {
  box-shadow: 0 10rpx 24rpx rgba(10, 89, 42, 0.28);
  animation: surveying-guide-control 1.6s ease-in-out infinite;
}

/* Bottom actions are native cover-view controls above the guide canvas. Their
   nested marker is in the same event tree as the real button, so it renders
   above the native background while touch events still bubble to the action. */
.bottom-control-dock .guide-target-control {
  position: relative;
  z-index: 26;
  overflow: visible;
  border-radius: 20rpx;
  box-shadow: none;
  animation: none;
}

.dock-guide-native-marker {
  position: absolute;
  left: 3rpx;
  right: 3rpx;
  top: 3rpx;
  bottom: 3rpx;
  z-index: 4;
  border: 3rpx solid #00b94d;
  border-radius: 18rpx;
  background: rgba(16, 185, 74, 0.07);
  box-sizing: border-box;
  pointer-events: none;
  animation: surveying-guide-native-marker 1.6s ease-in-out infinite;
}

.dock-guide-native-pointer {
  position: absolute;
  left: 50%;
  top: -9rpx;
  width: 14rpx;
  height: 14rpx;
  margin-left: -7rpx;
  border-radius: 3rpx;
  background: #00b94d;
  transform: rotate(45deg);
}

@keyframes surveying-guide-native-marker {
  0%, 100% {
    opacity: 0.72;
  }
  50% {
    opacity: 1;
  }
}

@keyframes surveying-guide-control {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.76;
  }
}

@keyframes surveying-guide-halo {
  0%, 100% {
    opacity: 0.82;
    transform: scale(0.92);
  }
  50% {
    opacity: 1;
    transform: scale(1.08);
  }
}

@media (prefers-reduced-motion: reduce) {
  .guide-target-control,
  .bottom-control-dock .guide-target-control,
  .dock-guide-native-marker,
  .survey-guide-target-halo {
    animation: none;
  }
}

/* ════════════════════════════════════════
   顶部右侧按钮组
════════════════════════════════════════ */
.topbar-right {
  display: flex;
  align-items: center;
  gap: 0;
  min-width: 0;
  flex-shrink: 0;
}

.topbar-right .topbar-chip + .topbar-chip {
  /* `gap` is not reliable for sibling cover-view controls on every device. */
  margin-left: 20rpx;
}

/* ════════════════════════════════════════
   底部圆形图标浮动按钮 (FAB)
════════════════════════════════════════ */
.bottom-fab-bar {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 18;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 0 28rpx;
}

/* 通用圆形按钮 */
.fab-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

/* 绿色主色大圆 */
.fab-btn.fab-primary .fab-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #17a14c;
  box-shadow: 0 12rpx 28rpx rgba(23, 161, 76, 0.36);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

/* 灰色空心圆 */
.fab-btn.fab-secondary .fab-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.14), 0 0 0 1.5rpx rgba(15, 23, 42, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.fab-btn.fab-dimmed .fab-icon {
  opacity: 0.5;
}

/* 加号按钮也是绿色大圆 */
.fab-btn.fab-plus .fab-icon {
  background: #17a14c;
}

/* 光标拖放子标签 */
.fab-sublabel {
  color: #4b5563;
  font-size: 18rpx;
  text-align: center;
  white-space: nowrap;
  margin-top: 2rpx;
}

/* ─ 测量图标 ─ */
.fab-icon-measure {
  position: relative;
}

.measure-line-h {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  top: 50%;
  height: 3rpx;
  background: rgba(255,255,255,0.9);
  transform: translateY(-50%);
  border-radius: 2rpx;
}

.measure-line-v {
  position: absolute;
  top: 18rpx;
  bottom: 18rpx;
  left: 50%;
  width: 3rpx;
  background: rgba(255,255,255,0.9);
  transform: translateX(-50%);
  border-radius: 2rpx;
}

.measure-corner {
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  border: 3rpx solid rgba(255,255,255,0.9);
  box-sizing: border-box;
}

.measure-corner.tl {
  top: 18rpx;
  left: 18rpx;
  border-right: none;
  border-bottom: none;
  border-radius: 2rpx 0 0 0;
}

.measure-corner.br {
  bottom: 18rpx;
  right: 18rpx;
  border-left: none;
  border-top: none;
  border-radius: 0 0 2rpx 0;
}

/* ─ 蓝牙图标 ─ */
.fab-icon-bluetooth {
  position: relative;
}

.bt-stem {
  position: absolute;
  left: 50%;
  top: 14rpx;
  bottom: 14rpx;
  width: 3rpx;
  background: #4b5563;
  transform: translateX(-50%);
  border-radius: 2rpx;
}

.bt-bar {
  position: absolute;
  width: 20rpx;
  height: 3rpx;
  background: #4b5563;
  border-radius: 2rpx;
  left: 50%;
}

.bt-bar.top {
  top: 22rpx;
  transform: translateX(0) rotate(45deg);
  transform-origin: left center;
}

.bt-bar.bottom {
  bottom: 22rpx;
  transform: translateX(0) rotate(-45deg);
  transform-origin: left center;
}

.bt-dot {
  position: absolute;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #4b5563;
}

.bt-dot.left {
  left: 18rpx;
  top: 50%;
  transform: translateY(-8rpx);
}

.bt-dot.right {
  left: 18rpx;
  top: 50%;
  transform: translateY(2rpx);
}

/* ─ 光标图标 ─ */
.fab-icon-cursor {
  position: relative;
}

.cursor-cross-h {
  position: absolute;
  left: 14rpx;
  right: 14rpx;
  top: 50%;
  height: 2rpx;
  background: #f07a21;
  transform: translateY(-50%);
  border-radius: 1rpx;
}

.cursor-cross-v {
  position: absolute;
  top: 14rpx;
  bottom: 14rpx;
  left: 50%;
  width: 2rpx;
  background: #f07a21;
  transform: translateX(-50%);
  border-radius: 1rpx;
}

.cursor-box {
  position: absolute;
  width: 22rpx;
  height: 22rpx;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  border: 2rpx solid #f07a21;
  background: rgba(240, 122, 33, 0.12);
  box-sizing: border-box;
}

/* ─ 加号图标 ─ */
.plus-h {
  position: absolute;
  left: 22rpx;
  right: 22rpx;
  top: 50%;
  height: 4rpx;
  background: #ffffff;
  transform: translateY(-50%);
  border-radius: 2rpx;
}

.plus-v {
  position: absolute;
  top: 22rpx;
  bottom: 22rpx;
  left: 50%;
  width: 4rpx;
  background: #ffffff;
  transform: translateX(-50%);
  border-radius: 2rpx;
}

/* ════════════════════════════════════════
   手输 mm 激活悬浮按钮
════════════════════════════════════════ */
.manual-fab {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  z-index: 19;
  height: 72rpx;
  min-width: 220rpx;
  padding: 0 36rpx;
  border-radius: 999rpx;
  background: #17a14c;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  box-shadow: 0 12rpx 28rpx rgba(23, 161, 76, 0.32);
}

.manual-fab-label {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

.manual-fab-sub {
  color: rgba(255,255,255,0.78);
  font-size: 18rpx;
}

/* ─ 去掉旧的 bottom-controls / bottom-reset-cursor ─ */
.bottom-controls,
.bottom-reset-cursor,
.reset-cursor-label,
.bottom-action,
.bottom-title,
.bottom-subtitle,
.mode-pill {
  display: none;
}

/* ─ survey-stage 旧布局清除 ─ */
.survey-stage {
  display: none;
}

/* ════════════════════════════════════════
   底部光标三态控件
════════════════════════════════════════ */
/* 覆盖 bottom-fab-bar 为居中单按钮 */
