page {
  background: #000;
}

.survey-page {
  position: fixed;
  inset: 0;
  overflow: hidden;
}

/* Keep all controls in a sibling composition layer above canvas-shell. */
.canvas-overlay-layer {
  position: fixed;
  inset: 0;
  z-index: 10;
  pointer-events: none;
}

.cursor-drag-canvas {
  position: fixed;
  inset: 0;
  z-index: 9;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.canvas-overlay-layer > .survey-topbar,
.canvas-overlay-layer > .right-rail,
.canvas-overlay-layer > .history-action-bar,
.canvas-overlay-layer > .bottom-fab-bar,
.canvas-overlay-layer > .bottom-control-dock,
.canvas-overlay-layer > .component-editor,
.canvas-overlay-layer > .number-pad-mask,
.canvas-overlay-layer > .number-pad-panel,
.canvas-overlay-layer > .top-measure-bubble,
.canvas-overlay-layer > .closure-action,
.canvas-overlay-layer > .wall-object-toolbar,
.canvas-overlay-layer > survey-canvas-compass {
  pointer-events: auto;
}


/* ─── 顶部导航浮层 ─── */
.survey-topbar {
  position: absolute;
  left: 16rpx;
  right: 16rpx;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 14rpx 16rpx;
  border: 1rpx solid rgba(207, 220, 207, 0.72);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(12px);
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.12);
  box-sizing: border-box;
}

.topbar-left,
.topbar-right,
.title-group {
  display: flex;
  align-items: center;
}

.topbar-left {
  min-width: 0;
  flex: 1;
}

.topbar-right {
  flex-shrink: 0;
  gap: 0;
}

.back-button + .title-group {
  margin-left: 18rpx;
}

.back-button {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  border-radius: 18rpx;
  background: var(--bg-surface-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 0 0 1rpx rgba(34, 197, 94, 0.14);
  box-sizing: border-box;
}

.topbar-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.topbar-back-icon {
  width: 42rpx;
  height: 42rpx;
}

.title-group {
  min-width: 0;
  flex-direction: column;
  align-items: flex-start;
  gap: 4rpx;
}

.page-title {
  max-width: 220rpx;
  color: var(--text-primary);
  font-size: 30rpx;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.page-subtitle {
  max-width: 220rpx;
  color: #7b8794;
  font-size: 21rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.view-tabs {
  order: 3;
  flex: 1 0 100%;
  justify-content: center;
  flex-shrink: 0;
  gap: 8rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: #f2f7f3;
}

.view-tab,
.topbar-chip {
  height: 80rpx;
  min-width: 108rpx;
  padding: 0 12rpx;
  border-radius: 18rpx;
  color: #647268;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  box-sizing: border-box;
}

.view-tab.active {
  color: #ffffff;
  background: #17a14c;
  box-shadow: 0 10rpx 20rpx rgba(17, 164, 66, 0.18);
}

.topbar-actions {
  order: 2;
  flex-shrink: 0;
  gap: 10rpx;
}

.topbar-chip {
  background: #f3f7f3;
}

.topbar-chip.save {
  min-width: 108rpx;
  color: #ffffff;
  background: #17a14c;
  box-shadow: 0 8rpx 18rpx rgba(23, 161, 76, 0.22);
}

.survey-stage {
  position: relative;
  flex: 1;
  height: auto;
  min-height: 0;
  margin-top: 18rpx;
  margin-left: -22rpx;
  margin-right: -22rpx;
  width: 100vw;
  display: flex;
  gap: 0;
  overflow: hidden;
}

/* ─── 全屏画布 ─── */
.canvas-shell {
  position: fixed;
  inset: 0;
  z-index: 0;
  background: #f8f8f8;
  overflow: hidden;
}

.grid-canvas {
  position: absolute;
  inset: 0;
  background-color: #f8f8f8;
}

.survey-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.compass {
  position: absolute;
  left: 26rpx;
  top: 26rpx;
  z-index: 5;
  width: 86rpx;
  height: 86rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: var(--shadow-float);
  color: #17a14c;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.compass-needle {
  position: absolute;
  width: 4rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #17a14c 0%, rgba(23, 161, 76, 0.15) 100%);
  transform: translateY(-8rpx);
}

.compass-label {
  position: absolute;
  top: 8rpx;
}

.measurement-bubble {
  position: absolute;
  left: 50%;
  top: 42rpx;
  z-index: 5;
  transform: translateX(-50%);
  min-width: 300rpx;
  padding: 16rpx 24rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: var(--shadow-float);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.bubble-title {
  color: #17a14c;
  font-size: 22rpx;
  font-weight: 600;
}

.bubble-value {
  color: #4b5563;
  font-size: 24rpx;
  text-align: center;
}

.top-measure-bubble {
  position: absolute;
  left: 50%;
  top: 42rpx;
  z-index: 7;
  transform: translateX(-50%);
  min-width: 180rpx;
  height: 72rpx;
  padding: 0 34rpx;
  border-radius: 999rpx;
  background: rgba(65, 65, 69, 0.92);
  color: #ffffff;
  box-shadow: var(--shadow-float);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.top-measure-angle {
  padding-left: 22rpx;
  border-left: 1px solid rgba(255, 255, 255, 0.22);
}

.top-measure-angle.actionable {
  color: #fbbf24;
}

.closure-action {
  position: absolute;
  z-index: 28;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: #f07a21;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 18rpx rgba(240, 122, 33, 0.28);
}

.closure-action-label {
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
}

.measure-position {
  position: absolute;
  z-index: 7;
  width: 140px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  pointer-events: auto;
}

.measure-position-tip {
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.96);
  color: #111827;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: var(--shadow-float);
  white-space: nowrap;
}

.measure-side-button {
  width: 76px;
  height: 76px;
  border-radius: 50%;
  background: rgba(65, 65, 69, 0.92);
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 700;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-float);
  pointer-events: auto;
}

.measure-side-line {
  width: 34px;
  height: 6px;
  border-radius: 999px;
  background: #ef4444;
  margin-bottom: 4px;
}

.cursor-anchor {
  position: absolute;
  z-index: 6;
  width: 48px;
  height: 48px;
  opacity: 0;
}

.cursor-line {
  position: absolute;
  background: #f07a21;
  border-radius: 0;
}

.cursor-line.horizontal {
  left: 0;
  right: 0;
  top: 22px;
  height: 4px;
}

.cursor-line.vertical {
  top: 0;
  bottom: 0;
  left: 22px;
  width: 4px;
}

.cursor-core {
  position: absolute;
  left: 14px;
  top: 14px;
  width: 20px;
  height: 20px;
  border-radius: 0;
  background: rgba(240, 122, 33, 0.16);
  border: 2px solid #f07a21;
  box-shadow: none;
  box-sizing: border-box;
}

.space-summary,
.wall-context {
  position: absolute;
  z-index: 7;
  background: rgba(31, 41, 55, 0.78);
  color: #ffffff;
  box-shadow: var(--shadow-float);
}

.space-summary {
  left: 32rpx;
  top: 132rpx;
  padding: 14rpx 20rpx;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 3rpx;
  font-size: 22rpx;
}

.space-area {
  color: #bbf7d0;
  font-size: 28rpx;
  font-weight: 700;
}

.wall-context {
  position: fixed;
  left: 22rpx;
  right: 22rpx;
  bottom: 160rpx;
  z-index: 16;
  width: auto;
  max-width: none;
  padding: 16rpx 18rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.96);
  color: #374151;
  box-sizing: border-box;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.12);
}


.wall-object-toolbar {
  position: absolute;
  z-index: 9;
  height: 54px;
  padding: 5px 8px;
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 18px;
  background: rgba(23, 32, 43, 0.96);
  box-shadow: 0 10px 24px rgba(15, 23, 42, 0.24);
  display: inline-flex;
  align-items: center;
  justify-content: flex-start;
  box-sizing: border-box;
}

.wall-object-action + .wall-object-action {
  margin-left: 8px;
}

.wall-object-action {
  position: relative;
  width: 36px;
  min-width: 36px;
  height: 42px;
  padding: 0;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.92);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
  box-sizing: border-box;
}

.wall-object-action.primary {
  border-color: rgba(134, 239, 172, 0.32);
  background: linear-gradient(135deg, #23b85d, #159447);
  color: #ffffff;
}

.wall-object-action.muted {
  color: #d1d5db;
  background: rgba(255, 255, 255, 0.08);
}

.wall-object-action.delete {
  border-color: rgba(252, 165, 165, 0.18);
  background: rgba(239, 68, 68, 0.18);
  color: #fca5a5;
}

.wall-action-image {
  position: absolute;
  left: 50%;
  top: 4px;
  width: 20px;
  height: 20px;
  margin-left: -10px;
}

.wall-action-label {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 3px;
  color: currentColor;
  font-size: 8px;
  line-height: 10px;
  font-weight: 600;
  letter-spacing: 0;
  text-align: center;
  white-space: nowrap;
}

.wall-context-title {
  color: #17a14c;
  font-size: 24rpx;
  font-weight: 700;
}

.wall-context-meta,
.wall-context-actions {
  display: flex;
  align-items: center;
}

.wall-context-meta {
  gap: 12rpx;
  margin-top: 8rpx;
  color: #647268;
  font-size: 22rpx;
  flex-wrap: wrap;
}

.wall-context-actions {
  gap: 8rpx;
  margin-top: 14rpx;
  flex-wrap: wrap;
}

.context-action {
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: #edf7ef;
  color: #17a14c;
  font-size: 22rpx;
  font-weight: 600;
}

.context-action.primary {
  color: #ffffff;
  background: #17a14c;
}

.context-action.muted {
  color: #6b7280;
  background: #f3f4f6;
}

.opening-context {
  width: 100%;
  padding: 14rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.97);
  color: #111827;
  box-shadow: var(--shadow-home-card);
  box-sizing: border-box;
  border: 1px solid rgba(148, 163, 184, 0.22);
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.opening-context.door {
  border-color: rgba(240, 122, 33, 0.28);
}

.opening-context.window {
  border-color: rgba(14, 165, 233, 0.3);
}

.opening-title {
  display: block;
  color: #111827;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.2;
}

.opening-context.door .opening-title {
  color: #c4550f;
}

.opening-context.window .opening-title {
  color: #0369a1;
}

.opening-fields {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.opening-field {
  padding: 8rpx 10rpx;
  border-radius: 12rpx;
  background: #f3f7f4;
  color: #374151;
  font-size: 19rpx;
  font-weight: 600;
  line-height: 1.25;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.opening-context.door .opening-field {
  background: #fff7ed;
  color: #9a3412;
}

.opening-context.window .opening-field {
  background: #eff8ff;
  color: #075985;
}

.opening-resume-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 60rpx;
  min-height: 60rpx;
  margin: 28rpx 0 0;
  padding: 0;
  border: 1rpx solid rgba(8, 160, 61, 0.42);
  border-radius: 14rpx;
  color: #087f38;
  background: rgba(255, 255, 255, 0.98);
  flex-shrink: 0;
  box-sizing: border-box;
  pointer-events: auto;
}

.opening-resume-content {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 58rpx;
}

.opening-resume-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 10rpx;
  flex: 0 0 auto;
}

.opening-resume-label {
  display: block;
  width: auto;
  height: 58rpx;
  color: #087f38;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 58rpx;
  text-align: center;
  white-space: nowrap;
}

.opening-side-switch {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 56rpx;
  padding: 0 10rpx;
  border-radius: 12rpx;
  background: #f3f7f4;
  box-sizing: border-box;
}

.opening-context.window .opening-side-switch {
  background: #eff8ff;
}

.opening-context.door .opening-side-switch {
  background: #fff7ed;
}

.opening-side-switch .side-label,
.opening-side-switch .side-value {
  line-height: 1;
}

/* ─── 右侧工具栏 ─── */
.right-rail {
  position: fixed;
  right: 18rpx;
  top: 200rpx;
  bottom: 160rpx;
  z-index: 15;
  width: auto;
  max-width: calc(100vw - 32rpx);
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
  overflow-y: auto;
  padding-bottom: 12rpx;
  box-sizing: border-box;
  pointer-events: none;
}

.right-rail > .tool-group:not(.reserved-tools),
.right-rail > .side-switch,
.right-rail > .opening-context {
  pointer-events: auto;
}


.tool-group,
.side-switch {
  width: auto;
  align-self: flex-end;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: var(--shadow-home-card);
  padding: 8rpx;
  box-sizing: border-box;
}

.tool-button,
.reserved-button,
.side-switch {
  display: flex;
  align-items: center;
  justify-content: center;
}

.tool-button {
  min-height: 74rpx;
  margin-bottom: 8rpx;
  padding: 0 12rpx;
  border-radius: 18rpx;
  color: #5f6e65;
  background: #f5f8f5;
  flex-direction: column;
  gap: 4rpx;
  white-space: nowrap;
}

.tool-button:last-child {
  margin-bottom: 0;
}

.tool-button.active {
  background: #17a14c;
  color: #ffffff;
  box-shadow: 0 10rpx 20rpx rgba(17, 164, 66, 0.18);
}

.object-tools .tool-button:first-child {
  background: #17a14c;
  color: #ffffff;
}

.tool-label {
  font-size: 23rpx;
  font-weight: 600;
}

.tool-helper {
  font-size: 16rpx;
  opacity: 0.75;
}

.side-switch {
  min-height: 82rpx;
  flex-direction: column;
  gap: 6rpx;
}

.side-label {
  color: #7b8794;
  font-size: 20rpx;
}

.side-value {
  color: #17a14c;
  font-size: 24rpx;
  font-weight: 600;
}

.reserved-tools {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8rpx;
}

.reserved-button {
  min-height: 50rpx;
  border-radius: 16rpx;
  background: #f5f6f5;
  color: #9aa3ad;
  font-size: 18rpx;
}

.bottom-controls {
  position: absolute;
  left: 0;
  right: auto;
  bottom: 16rpx;
  width: 100vw;
  height: 72rpx;
  gap: 8rpx;
  padding: 8rpx 14rpx;
  border-radius: 20rpx 20rpx 0 0;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: var(--shadow-float);
  box-sizing: border-box;
  z-index: 12;
}

.bottom-reset-cursor {
  position: absolute;
  right: 22rpx;
  z-index: 13;
  height: 68rpx;
  min-width: 160rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: rgba(31, 41, 55, 0.88);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.22);
  box-sizing: border-box;
}

.reset-cursor-label {
  font-size: 22rpx;
  font-weight: 600;
  color: #ffffff;
  white-space: nowrap;
}

.mode-pill {
  flex-shrink: 0;
  height: 54rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #17a14c;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
}

.bottom-action {
  flex: 1;
  min-width: 0;
  height: 54rpx;
  border-radius: 18rpx;
  background: #f4f8f4;
  flex-direction: column;
  justify-content: center;
  gap: 1rpx;
}

.bottom-action.active {
  background: rgba(23, 161, 76, 0.12);
  box-shadow: inset 0 0 0 2rpx rgba(23, 161, 76, 0.18);
}

.bottom-title {
  color: #374151;
  font-size: 21rpx;
  font-weight: 600;
}

.bottom-action.active .bottom-title {
  color: #17a14c;
}

.bottom-subtitle {
  color: #8a949f;
  font-size: 16rpx;
}

.bottom-action.active .bottom-subtitle {
  color: #2f7d4a;
}

.component-editor {
  position: fixed;
  inset: 0;
  z-index: 50;
  background: #ffffff;
  overflow: hidden;
}

.component-topbar {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  z-index: 12;
  height: 132rpx;
  padding: 20rpx 32rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  pointer-events: none;
}

.component-back {
  position: relative;
  z-index: 2;
  pointer-events: auto;
  width: 74rpx;
  height: 74rpx;
  border-radius: 22rpx;
  background: #ffffff;
  color: #4b5563;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  width: 32rpx;
  height: 32rpx;
}

.component-title {
  margin-left: 16rpx;
  color: #1f2937;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 74rpx;
}

.component-webgl {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  width: 100%;
  height: calc(100% - 848rpx - env(safe-area-inset-bottom));
  background: #fbfcfa;
}

.component-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 5;
  height: calc(736rpx + env(safe-area-inset-bottom));
  padding: 14rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  border-radius: 36rpx 36rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -12rpx 32rpx rgba(15, 35, 23, 0.08);
  box-sizing: border-box;
}

/* Native canvas overlays keep the undo/reset controls above web views. */
.component-panel-raised {
  bottom: 112rpx;
}

.component-sheet-handle {
  width: 68rpx;
  height: 8rpx;
  margin: 0 auto 12rpx;
