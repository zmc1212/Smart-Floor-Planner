}

.survey-guide-path.curve-down-left .survey-guide-path-line,
.survey-guide-path.curve-down-left .survey-guide-path-arrow {
  transform: scaleX(-1);
}

.survey-guide-path.curve-up-left .survey-guide-path-line,
.survey-guide-path.curve-up-left .survey-guide-path-arrow {
  transform: scale(-1);
}

.survey-guide-path.curve-up-right .survey-guide-path-arrow,
.survey-guide-path.curve-up-left .survey-guide-path-arrow {
