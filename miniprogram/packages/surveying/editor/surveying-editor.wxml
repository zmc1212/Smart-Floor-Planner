<view class="survey-page">

  <!-- ══════════════════════════════════════════════ -->
  <!--  全屏画布                                      -->
  <!-- ══════════════════════════════════════════════ -->
  <view class="canvas-shell">
    <view class="grid-canvas">
      <canvas
        type="2d"
        id="survey-canvas"
        class="survey-canvas"
        bindtouchstart="onCanvasTouchStart"
        bindtouchmove="onCanvasTouchMove"
        bindtouchend="onCanvasTouchEnd"
        bindtouchcancel="onCanvasTouchEnd"
        bindtap="onCanvasTap"
      ></canvas>
    </view>

  </view>

  <!-- 常驻轻量拖拽画布：只绘制跟手光标和十字辅助线，不重绘正式墙图。 -->
  <canvas
    type="2d"
    id="cursor-drag-canvas"
    class="cursor-drag-canvas"
    disable-scroll="true"
  ></canvas>

  <!-- 所有测绘覆盖 UI 与 canvas-shell 保持同级，由本层统一承载。 -->
  <view class="canvas-overlay-layer">

    <!-- 顶部量测气泡 -->
    <cover-view wx:if="{{!componentEditorVisible && topMetricVisible && topMetricLength && cursorPlacementState === 'placed'}}" class="top-measure-bubble" style="top: {{overlayContentTop}}px;">
      <cover-view>{{topMetricLength}}</cover-view>
      <cover-view
        wx:if="{{topMetricAngle}}"
        class="top-measure-angle {{angleActionAvailable ? 'actionable' : ''}}"
        bindtap="onTopMetricAngleTap"
      >{{topMetricAngle}}</cover-view>
    </cover-view>

    <cover-view
      wx:if="{{!componentEditorVisible && closeActionVisible}}"
      class="closure-action {{surveyGuideTarget === 'close' ? 'guide-target-control' : ''}}"
      style="{{closeActionStyle}}"
      catchtap="onConfirmClose"
    >
      <cover-view class="closure-action-label">可闭合</cover-view>
    </cover-view>

    <!-- 选中墙体时的浮动工具栏（图标行） -->
    <cover-view wx:if="{{!componentEditorVisible && selectedWall && !selectedOpening}}" class="wall-object-toolbar {{surveyGuideTarget === 'object' ? 'guide-target-control' : ''}}" style="{{selectedWall.actionStyle}}">
      <cover-view class="wall-object-action primary" data-action="door" aria-label="添加门" bindtap="onWallContextAction">
        <cover-image class="wall-action-image" src="/packages/surveying/assets/icons/wall-toolbar/door.png" mode="aspectFit"></cover-image>
        <cover-view class="wall-action-label">添门</cover-view>
      </cover-view>
      <cover-view class="wall-object-action primary" data-action="window" aria-label="添加窗" bindtap="onWallContextAction">
        <cover-image class="wall-action-image" src="/packages/surveying/assets/icons/wall-toolbar/window.png" mode="aspectFit"></cover-image>
        <cover-view class="wall-action-label">添窗</cover-view>
      </cover-view>
      <cover-view class="wall-object-action" data-action="remeasure" aria-label="复尺" bindtap="onWallContextAction">
        <cover-image class="wall-action-image" src="/packages/surveying/assets/icons/wall-toolbar/remeasure.png" mode="aspectFit"></cover-image>
        <cover-view class="wall-action-label">复尺</cover-view>
      </cover-view>
      <cover-view class="wall-object-action delete" data-action="delete" aria-label="删除墙" bindtap="onWallContextAction">
        <cover-image class="wall-action-image" src="/packages/surveying/assets/icons/wall-toolbar/delete.png" mode="aspectFit"></cover-image>
        <cover-view class="wall-action-label">删除</cover-view>
      </cover-view>
      <cover-view class="wall-object-action" aria-label="退出" catchtouchend="onExitWallSelection" catchtap="onExitWallSelection">
        <cover-image class="wall-action-image" src="/packages/surveying/assets/icons/wall-toolbar/close.png" mode="aspectFit"></cover-image>
        <cover-view class="wall-action-label">收起</cover-view>
      </cover-view>
    </cover-view>

  <!-- 使用 cover-view 作为组件根节点，验证组件是否可覆盖原生画布。 -->
  <survey-canvas-compass wx:if="{{showFormalExtras && !componentEditorVisible}}" safe-top="{{overlayContentTop}}" bind:tap="onDisabledTap"></survey-canvas-compass>

  <!-- ══════════════════════════════════════════════ -->
  <!--  顶部导航浮层                                   -->
  <!-- ══════════════════════════════════════════════ -->
  <cover-view wx:if="{{!componentEditorVisible}}" class="survey-topbar native-canvas-overlay" style="top: {{statusBarHeight}}px;">
    <cover-view class="back-button" bindtap="onBack" aria-label="返回">
      <cover-image class="topbar-icon topbar-back-icon" src="/packages/surveying/assets/icons/topbar-back.png"></cover-image>
    </cover-view>
    <cover-view class="title-group">
      <cover-view class="page-title">{{title}}</cover-view>
      <cover-view class="page-subtitle">
        <cover-view class="save-status-dot"></cover-view>
        <cover-view class="page-subtitle-text">{{formalNotice}}</cover-view>
      </cover-view>
    </cover-view>
    <cover-view class="topbar-right">
      <cover-view
        class="topbar-chip guide-trigger {{guideEnabled ? 'active' : ''}}"
        bindtap="onGuideToggle"
        aria-label="{{guideEnabled ? '关闭引导模式' : '开启引导模式'}}"
      >
        <cover-image class="topbar-chip-icon" src="/packages/surveying/assets/icons/guide-help.png" mode="aspectFit"></cover-image>
        <cover-view>引导</cover-view>
      </cover-view>
      <cover-view class="topbar-chip save-draft" bindtap="onSaveDraft">
        <cover-image class="topbar-chip-icon" src="/packages/surveying/assets/icons/save-draft.png" mode="aspectFit"></cover-image>
        <cover-view>保存</cover-view>
      </cover-view>
      <cover-view class="topbar-chip finish" bindtap="onSubmitFloorPlan">
        <cover-image class="topbar-chip-icon finish-icon" src="/packages/surveying/assets/icons/angle/circle-check.png" mode="aspectFit"></cover-image>
        <cover-view>完成</cover-view>
      </cover-view>
    </cover-view>
  </cover-view>

  <!-- ══════════════════════════════════════════════ -->
  <!--  右侧工具栏（浮层）                              -->
  <!-- ══════════════════════════════════════════════ -->
  <cover-view wx:if="{{!componentEditorVisible}}" class="right-rail native-canvas-overlay {{selectedOpening ? 'with-opening' : ''}}" style="top: {{rightRailTop}}px; bottom: {{rightRailBottom}}px;">
    <cover-view wx:if="{{selectedOpening}}" class="opening-context {{selectedOpening.type}}">
      <cover-view class="opening-title">
        <cover-image class="opening-title-icon" src="/packages/surveying/assets/icons/object-rail/opening.png" mode="aspectFit"></cover-image>
        <cover-view>门 · 窗</cover-view>
      </cover-view>
      <cover-view class="opening-fields">
        <cover-view class="opening-field" data-field="width" bindtap="onOpeningEditField">
          <cover-view class="opening-field-label">宽</cover-view>
          <cover-view class="opening-field-value">{{selectedOpening.width}}</cover-view>
        </cover-view>
        <cover-view class="opening-field" data-field="height" bindtap="onOpeningEditField">
          <cover-view class="opening-field-label">高</cover-view>
          <cover-view class="opening-field-value">{{selectedOpening.height}}</cover-view>
        </cover-view>
      </cover-view>
      <cover-view wx:if="{{selectedOpening.type === 'door'}}" class="opening-direction">
        <cover-view class="opening-direction-title">开启方式</cover-view>
        <cover-view class="opening-direction-options">
          <cover-view
            class="opening-direction-option {{selectedOpening.openDirection === 'inside' ? 'active' : ''}}"
            data-direction="inside"
            bindtap="onOpeningDirectionTap"
          ><cover-view class="opening-direction-label">内开</cover-view></cover-view>
          <cover-view
            class="opening-direction-option {{selectedOpening.openDirection === 'outside' ? 'active' : ''}}"
            data-direction="outside"
            bindtap="onOpeningDirectionTap"
          ><cover-view class="opening-direction-label">外开</cover-view></cover-view>
        </cover-view>
      </cover-view>

      <cover-view class="opening-primary-action" data-tool="object-edit" bindtap="onToolTap" aria-label="编辑门窗">
        <cover-image class="opening-action-icon" src="/packages/surveying/assets/icons/object-rail/edit.png" mode="aspectFit"></cover-image>
        <cover-view class="opening-action-label">编辑</cover-view>
      </cover-view>

      <cover-view class="opening-delete-divider"></cover-view>
      <cover-view class="opening-delete-action" data-tool="object-delete" bindtap="onToolTap" aria-label="删除门窗">
        <cover-image class="opening-delete-icon" src="/packages/surveying/assets/icons/object-rail/delete-danger.png" mode="aspectFit"></cover-image>
        <cover-view class="opening-delete-label">删除门窗</cover-view>
      </cover-view>
    </cover-view>

    <cover-view wx:if="{{selectedOpening && canResumeWallDrawing}}" class="opening-resume-action" bindtap="onResumeWallDrawing" aria-role="button" aria-label="继续测墙">
      <cover-view class="opening-resume-content">
        <cover-image class="opening-resume-icon" src="/packages/surveying/assets/icons/object-rail/continue-wall.png" mode="aspectFit"></cover-image>
        <cover-view class="opening-resume-label">继续测墙</cover-view>
      </cover-view>
    </cover-view>

    <cover-view wx:if="{{objectToolsVisible && !selectedOpening}}" class="tool-group primary-tools object-tools">
      <cover-view
        class="tool-button"
        wx:for="{{objectTools}}"
        wx:key="key"
        data-tool="{{item.key}}"
        bindtap="onToolTap"
      >
        <cover-view class="tool-label">{{item.label}}</cover-view>
        <cover-view class="tool-helper">{{item.helper}}</cover-view>
      </cover-view>
    </cover-view>

    <cover-view wx:if="{{!objectToolsVisible && !selectedOpening}}" class="tool-group primary-tools">
      <cover-view
        class="tool-button {{item.active ? 'active' : ''}}"
        wx:for="{{coreTools}}"
        wx:key="key"
        wx:if="{{index < 4}}"
        data-tool="{{item.key}}"
        bindtap="onToolTap"
      >
        <cover-image class="tool-icon" src="/packages/surveying/assets/icons/editor-rail/{{item.icon}}.png" mode="aspectFit"></cover-image>
        <cover-view class="tool-label">{{item.label}}</cover-view>
      </cover-view>
    </cover-view>

    <cover-view wx:if="{{showFormalExtras}}" class="tool-group reserved-tools">
      <cover-view
        class="reserved-button disabled"
        wx:for="{{reservedTools}}"
        wx:key="key"
        bindtap="onDisabledTap"
      >
        {{item.label}}
      </cover-view>
    </cover-view>
  </cover-view>

  <!-- ══════════════════════════════════════════════ -->
  <!--  底部光标控件：已放置 / 等待拖放 / 拖拽中为空      -->
  <!-- ══════════════════════════════════════════════ -->
  <!-- The existing angle-sheet visibility contract remains independent of the restored dock. -->
  <cover-view wx:if="{{!numberPadVisible}}" class="bottom-fab-bar legacy-angle-sheet-anchor"></cover-view>
  <cover-view wx:if="{{!numberPadVisible}}" class="history-action-bar bottom-control-dock native-canvas-overlay" style="bottom: calc(64rpx + {{bottomSafeArea}}px);">
    <cover-view class="dock-action {{historySummary.undo > 0 ? '' : 'disabled'}}" bindtap="onUndoTap">
      <cover-image src="/packages/surveying/assets/icons/history-undo.png" mode="aspectFit"></cover-image>
      <cover-view>撤销</cover-view>
    </cover-view>
    <cover-view class="dock-action {{historySummary.redo > 0 ? '' : 'disabled'}}" bindtap="onRedoTap">
      <cover-image src="/packages/surveying/assets/icons/history-redo.png" mode="aspectFit"></cover-image>
      <cover-view>重做</cover-view>
    </cover-view>
    <cover-view wx:if="{{cursorPlacementState === 'placed'}}" class="dock-action cursor-action {{surveyGuideTarget === 'dock-cursor' ? 'guide-target-control' : ''}}" bindtap="onResetCursorTap">
      <cover-image class="dock-cursor-icon" src="/packages/surveying/assets/icons/editor-rail/align.png" mode="aspectFit"></cover-image>
      <cover-view>重置光标</cover-view>
      <cover-view wx:if="{{surveyGuideTarget === 'dock-cursor'}}" class="dock-guide-native-marker">
        <cover-view class="dock-guide-native-pointer"></cover-view>
      </cover-view>
    </cover-view>
    <cover-view
      wx:else
      id="cursor-drag-control"
      class="dock-action cursor-action {{cursorPlacementState === 'dragging' ? 'is-dragging' : ''}} {{surveyGuideTarget === 'dock-cursor' ? 'guide-target-control' : ''}}"
      data-cursor-control="true"
      bindtouchstart="onCursorControlTouchStart"
      catchtouchmove="onCursorControlTouchMove"
      bindtouchend="onCursorDragEnd"
      bindtouchcancel="onCursorDragCancel"
    >
      <cover-image class="dock-cursor-icon" src="/packages/surveying/assets/icons/editor-rail/align.png" mode="aspectFit"></cover-image>
      <cover-view>拖动光标</cover-view>
      <cover-view wx:if="{{surveyGuideTarget === 'dock-cursor'}}" class="dock-guide-native-marker">
        <cover-view class="dock-guide-native-pointer"></cover-view>
      </cover-view>
    </cover-view>
    <cover-view class="dock-measure {{bleConnected ? '' : 'disconnected'}} {{surveyGuideTarget === 'measure' ? 'guide-target-control' : ''}}" bindtap="onBottomMeasure">
      <cover-image class="dock-bluetooth" src="/packages/surveying/assets/icons/ble-{{bleConnected ? 'green' : 'muted'}}.png" mode="aspectFit"></cover-image>
      <cover-view>测距{{bleConnected ? ' · 已连接' : ''}}</cover-view>
      <cover-view class="dock-status-dot"></cover-view>
      <cover-view wx:if="{{surveyGuideTarget === 'measure'}}" class="dock-guide-native-marker">
        <cover-view class="dock-guide-native-pointer"></cover-view>
      </cover-view>
    </cover-view>
  </cover-view>

  <!-- ══════════════════════════════════════════════ -->
  <!--  拖拽放置光标的纯展示层（不接收触摸，事件始终由底部按钮承接） -->
  <!-- ══════════════════════════════════════════════ -->
  <block wx:if="{{cursorPlacementState === 'dragging' && !numberPadVisible}}">
    <cover-view wx:if="{{cursorLensVisible}}" class="cursor-lens {{cursorLensSnapType}}">
      <cover-view class="cursor-lens-grid">
        <cover-view class="cursor-lens-cross horizontal"></cover-view>
        <cover-view class="cursor-lens-cross vertical"></cover-view>
        <cover-view class="cursor-lens-target"></cover-view>
      </cover-view>
      <cover-view class="cursor-lens-meta">
        <cover-view>{{cursorLensSnapLabel}}</cover-view>
        <cover-view>{{cursorLensXLabel}} / {{cursorLensYLabel}}</cover-view>
      </cover-view>
    </cover-view>
  </block>


  <!-- ══════════════════════════════════════════════ -->
  <!--  门窗构件编辑器（全屏覆盖）                       -->
  <!-- ══════════════════════════════════════════════ -->
  <view wx:if="{{componentEditorVisible}}" class="component-editor">
    <cover-view class="component-topbar" style="top: {{statusBarHeight}}px;">
      <cover-view class="component-back" bindtap="closeComponentEditor" aria-role="button" aria-label="返回量房编辑器">
        <cover-image class="back-icon" src="/images/back-arrow.png" mode="aspectFit"></cover-image>
      </cover-view>
      <cover-view class="component-title">{{componentEditorTitle}}</cover-view>
    </cover-view>

    <canvas
      type="webgl"
      id="component-webgl"
      class="component-webgl"
      bindtouchstart="onComponentTouchStart"
      bindtouchmove="onComponentTouchMove"
      bindtouchend="onComponentTouchEnd"
      bindtouchcancel="onComponentTouchEnd"
      disable-scroll="true"
    ></canvas>

    <!-- 墙体尺寸标注悬浮层 -->
    <cover-view class="dimension-overlay-label" style="{{wallLengthStyle}}">{{wallLengthLabel}}</cover-view>
    <cover-view class="dimension-overlay-label" style="{{wallHeightStyle}}">{{wallHeightLabel}}</cover-view>

    <!-- 门窗构件参数标注悬浮层 -->
    <cover-view class="dimension-overlay-label {{componentSpecMode === 'edge1' ? 'active' : ''}}" style="{{paramEdge1Style}}">{{paramEdge1Label}}</cover-view>
    <cover-view class="dimension-overlay-label {{componentSpecMode === 'edge2' ? 'active' : ''}}" style="{{paramEdge2Style}}">{{paramEdge2Label}}</cover-view>
    <cover-view class="dimension-overlay-label {{componentSpecMode === 'length' || componentSpecMode === 'spec' ? 'active' : ''}}" style="{{paramLengthStyle}}">{{paramLengthLabel}}</cover-view>
    <cover-view class="dimension-overlay-label {{componentSpecMode === 'height' ? 'active' : ''}}" style="{{paramHeightStyle}}">{{paramHeightLabel}}</cover-view>
    <cover-view class="dimension-overlay-label {{componentSpecMode === 'sill' ? 'active' : ''}}" style="{{paramSillStyle}}">{{paramSillLabel}}</cover-view>

    <view class="component-panel component-panel-raised">
      <view class="component-sheet-handle"></view>
      <view class="component-panel-heading">
        <view class="component-panel-title">尺寸参数</view>
        <view class="component-type-tag">{{componentTypeLabel}}</view>
      </view>

      <scroll-view class="component-spec-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
        <view class="component-spec-tabs">
          <view
            class="component-spec-tab {{componentSpecMode === item.key ? 'active' : ''}}"
            wx:for="{{componentSpecOptions}}"
            wx:key="key"
            data-mode="{{item.key}}"
            bindtap="onComponentSpecTab"
            aria-role="button"
            aria-label="编辑{{item.label}}，当前值{{item.value}}毫米"
          >
            <view class="component-spec-tab-label">{{item.label}}</view>
            <view class="component-spec-tab-value">{{item.value}}</view>
          </view>
        </view>
      </scroll-view>

      <view class="component-spec-display">
        <view class="component-spec-value-wrap">
          <text class="component-spec-val">{{componentSpecValue}}</text>
          <text class="component-spec-unit">mm</text>
        </view>
        <image class="component-spec-guide-k" src="/packages/surveying/assets/surveying-guide-k-down-v3.png" mode="aspectFit"></image>
      </view>

      <view class="component-spec-keyboard">
        <view
          class="keyboard-key {{item === '清空' || item === '退格' ? 'utility' : ''}}"
          wx:for="{{numberKeys}}"
          wx:key="*this"
          data-key="{{item}}"
          bindtap="onComponentKeyboardKey"
          hover-class="keyboard-key-pressed"
          aria-role="button"
          aria-label="{{item}}"
        >
          {{item}}
        </view>
      </view>

      <view class="component-spec-footer">
        <view class="component-spec-helper">已选中{{componentSpecLabel}}，可手输或使用底部测距</view>
        <view wx:if="{{componentSpecMode === 'depth'}}" class="component-sync-row" bindtap="onToggleComponentThicknessSync" aria-role="checkbox" aria-checked="{{componentSyncWallThickness}}">
          <view class="sync-dot {{componentSyncWallThickness ? 'active' : ''}}"></view>
          <text>同步更改墙体厚度</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ══════════════════════════════════════════════ -->
  <!--  数字键盘弹层                                   -->
  <!-- ══════════════════════════════════════════════ -->
  <!-- 2D canvas 与 cover-view 组合在部分开发者工具版本中不渲染复杂测角层；
       测角工作台使用同层 view，其他数字面板继续保持原生覆盖实现。 -->
  <view wx:if="{{numberPadVisible && angleMeasureVisible}}" class="number-pad-mask angle-sheet-mask" bindtap="onNumberClose"></view>
  <view wx:if="{{numberPadVisible && angleMeasureVisible}}" class="number-pad-panel angle-sheet-panel">
    <view class="angle-sheet-handle"></view>
    <view class="number-pad-header">
      <view class="number-pad-heading">
        <view class="number-pad-title">{{numberPadTitle}}</view>
        <view class="number-pad-subtitle">{{numberPadSubtitle}}</view>
      </view>
    </view>
    <view wx:if="{{!angleManualInputVisible}}" class="angle-measure-tools">
      <view class="angle-measure-tabs">
        <view
          class="angle-measure-tab {{angleMeasureTab === 'phone' ? 'active' : ''}}"
          data-tab="phone"
          bindtap="onAngleMeasureTab"
          hover-class="angle-control-pressed"
          aria-label="手机测量角度"
        >
          <view>手机测量</view>
          <view wx:if="{{angleMeasureTab === 'phone'}}" class="angle-tab-indicator"></view>
        </view>
        <view
          class="angle-measure-tab {{angleMeasureTab === 'pythagorean' ? 'active' : ''}}"
          data-tab="pythagorean"
          bindtap="onAngleMeasureTab"
          hover-class="angle-control-pressed"
          aria-label="勾股定理测量角度"
        >
          <view>勾股定理</view>
          <view wx:if="{{angleMeasureTab === 'pythagorean'}}" class="angle-tab-indicator"></view>
        </view>
      </view>

      <view wx:if="{{angleMeasureTab === 'phone'}}" class="phone-angle-tool">
        <view class="phone-angle-dial-column">
          <view class="phone-angle-dial {{anglePhoneLevelReady ? 'level' : ''}}">
            <view class="phone-angle-tick tick-0"></view>
            <view class="phone-angle-tick tick-30"></view>
            <view class="phone-angle-tick tick-60"></view>
            <view class="phone-angle-tick tick-90"></view>
            <view class="phone-angle-tick tick-120"></view>
            <view class="phone-angle-tick tick-150"></view>
            <view class="phone-angle-needle" style="{{anglePhoneDialStyle}}"></view>
            <view class="phone-angle-level-ring"></view>
            <view class="phone-angle-axis horizontal"></view>
            <view class="phone-angle-axis vertical"></view>
            <view class="phone-angle-center {{anglePhoneLevelReady ? 'level' : ''}}"></view>
            <view class="phone-angle-mark mark-0">0</view>
            <view class="phone-angle-mark mark-90-left">90</view>
            <view class="phone-angle-mark mark-90-right">90</view>
            <view class="phone-angle-mark mark-180">180</view>
          </view>
        </view>
        <view class="phone-angle-reading-card">
          <image class="phone-level-image" src="/packages/surveying/assets/icons/angle/phone-level.png" mode="aspectFit"></image>
          <view class="phone-angle-value">{{anglePhoneLiveValue}}°</view>
          <view class="phone-angle-status">{{angleMeasureStatus}}</view>
          <view
            class="phone-angle-baseline {{anglePhoneLevelReady ? '' : 'disabled'}}"
            bindtap="onPhoneSetAngleBaseline"
            hover-class="angle-control-pressed"
            aria-label="{{anglePhoneReferenceReady ? '重新设为角度基准' : '设为角度基准'}}"
          >
            <image class="angle-action-icon" src="/packages/surveying/assets/icons/angle/crosshair.png" mode="aspectFit"></image>
            <view>{{anglePhoneReferenceReady ? '重新设为基准' : '设为基准'}}</view>
          </view>
        </view>
      </view>

      <view wx:else class="triangle-angle-tool">
        <view class="triangle-angle-hint">从同一拐角向两面墙取点，依次测量两边和两点连线。</view>
        <view class="triangle-side-row {{angleTriangleA ? 'complete' : ''}}">
          <view class="triangle-side-step">1</view>
          <view class="triangle-side-name">边 A</view>
          <view class="triangle-side-value">{{angleTriangleA ? angleTriangleAmm : '待测'}}<text wx:if="{{angleTriangleA}}" class="triangle-side-unit">mm</text></view>
          <view class="triangle-side-action {{angleTriangleMeasuringSide === 'a' ? 'measuring' : ''}} {{angleTriangleMeasuringSide && angleTriangleMeasuringSide !== 'a' ? 'disabled' : ''}}" data-side="a" bindtap="onTriangleMeasure" hover-class="angle-control-pressed" aria-label="测量边 A">
            <image class="triangle-measure-icon" src="/packages/surveying/assets/icons/angle/bluetooth.png" mode="aspectFit"></image>
            <view>{{angleTriangleMeasuringSide === 'a' ? '测量中' : '测量'}}</view>
          </view>
          <image wx:if="{{angleTriangleA}}" class="triangle-complete-icon" src="/packages/surveying/assets/icons/angle/circle-check.png" mode="aspectFit"></image>
        </view>
        <view class="triangle-side-row {{angleTriangleB ? 'complete' : ''}}">
          <view class="triangle-side-step">2</view>
          <view class="triangle-side-name">边 B</view>
          <view class="triangle-side-value">{{angleTriangleB ? angleTriangleBmm : '待测'}}<text wx:if="{{angleTriangleB}}" class="triangle-side-unit">mm</text></view>
          <view class="triangle-side-action {{angleTriangleMeasuringSide === 'b' ? 'measuring' : ''}} {{angleTriangleMeasuringSide && angleTriangleMeasuringSide !== 'b' ? 'disabled' : ''}}" data-side="b" bindtap="onTriangleMeasure" hover-class="angle-control-pressed" aria-label="测量边 B">
            <image class="triangle-measure-icon" src="/packages/surveying/assets/icons/angle/bluetooth.png" mode="aspectFit"></image>
            <view>{{angleTriangleMeasuringSide === 'b' ? '测量中' : '测量'}}</view>
          </view>
          <image wx:if="{{angleTriangleB}}" class="triangle-complete-icon" src="/packages/surveying/assets/icons/angle/circle-check.png" mode="aspectFit"></image>
        </view>
        <view class="triangle-side-row {{angleTriangleD ? 'complete' : ''}}">
          <view class="triangle-side-step">3</view>
          <view class="triangle-side-name">连线 D</view>
          <view class="triangle-side-value">{{angleTriangleD ? angleTriangleDmm : '待测'}}<text wx:if="{{angleTriangleD}}" class="triangle-side-unit">mm</text></view>
          <view class="triangle-side-action {{angleTriangleMeasuringSide === 'd' ? 'measuring' : ''}} {{angleTriangleMeasuringSide && angleTriangleMeasuringSide !== 'd' ? 'disabled' : ''}}" data-side="d" bindtap="onTriangleMeasure" hover-class="angle-control-pressed" aria-label="测量连线 D">
            <image class="triangle-measure-icon" src="/packages/surveying/assets/icons/angle/bluetooth.png" mode="aspectFit"></image>
            <view>{{angleTriangleMeasuringSide === 'd' ? '测量中' : '测量'}}</view>
          </view>
          <image wx:if="{{angleTriangleD}}" class="triangle-complete-icon" src="/packages/surveying/assets/icons/angle/circle-check.png" mode="aspectFit"></image>
        </view>
        <view class="triangle-result-row {{angleTriangleResult ? 'ready' : ''}}">
          <view class="triangle-result-label">计算结果</view>
          <view class="triangle-angle-result">{{angleTriangleResult || '--'}}</view>
          <view class="triangle-reset" bindtap="onResetAngleTriangle" hover-class="angle-control-pressed" aria-label="重新测量三边">
            <image class="angle-action-icon" src="/packages/surveying/assets/icons/angle/refresh-cw.png" mode="aspectFit"></image>
            <view>重新测量三边</view>
          </view>
        </view>
        <view wx:if="{{angleTriangleError}}" class="triangle-angle-error">{{angleTriangleError}}</view>
      </view>
    </view>
    <view wx:if="{{angleManualInputVisible}}" class="number-display angle-manual-display">
      <view class="number-display-value">{{numberInput || '0'}}</view>
      <view class="number-display-unit">{{numberUnit}}</view>
    </view>
    <view wx:if="{{angleManualInputVisible}}" class="number-grid angle-manual-grid">
      <view
        class="number-key {{item === '清空' || item === '退格' ? 'utility' : ''}}"
        wx:for="{{numberKeys}}"
        wx:key="*this"
        data-key="{{item}}"
        bindtap="onNumberKey"
      >
        {{item}}
      </view>
    </view>
    <view class="angle-sheet-actions">
      <view wx:if="{{angleManualInputVisible}}" class="angle-secondary-action" bindtap="onAngleManualInputBack" hover-class="angle-control-pressed">返回测量</view>
      <view wx:elif="{{angleMeasureTab === 'phone'}}" class="angle-secondary-action" bindtap="onAngleManualInput" hover-class="angle-control-pressed">手动输入</view>
      <view wx:else class="angle-secondary-action" bindtap="onNumberClose" hover-class="angle-control-pressed">取消</view>
      <view wx:if="{{numberInput}}" class="angle-primary-action" bindtap="onNumberConfirm" hover-class="angle-control-pressed">确认角度</view>
      <view wx:else class="angle-primary-action disabled" aria-disabled="true">确认角度</view>
    </view>
  </view>

  <cover-view wx:if="{{numberPadVisible && !angleMeasureVisible}}" class="number-pad-mask native-canvas-overlay" bindtap="onNumberClose"></cover-view>
  <cover-view wx:if="{{numberPadVisible && !angleMeasureVisible}}" class="number-pad-panel native-canvas-overlay">
    <cover-view class="number-pad-header">
      <cover-view class="number-pad-heading">
        <cover-view class="number-pad-title">{{numberPadTitle}}</cover-view>
        <cover-view class="number-pad-subtitle">{{numberPadSubtitle}}</cover-view>
      </cover-view>
      <cover-view class="number-pad-close" bindtap="onNumberClose">关闭</cover-view>
    </cover-view>
    <cover-view class="number-display">
      <cover-view class="number-display-value">{{numberInput || '0'}}</cover-view>
      <cover-view class="number-display-unit">{{numberUnit}}</cover-view>
    </cover-view>
    <cover-view class="number-grid">
      <cover-view
        class="number-key {{item === '清空' || item === '退格' ? 'utility' : ''}}"
        wx:for="{{numberKeys}}"
        wx:key="*this"
        data-key="{{item}}"
        bindtap="onNumberKey"
      >
        {{item}}
      </cover-view>
    </cover-view>
    <cover-view class="number-actions">
      <cover-view class="number-measure" bindtap="triggerBluetoothNumberMeasure">测距</cover-view>
      <cover-view class="number-confirm" bindtap="onNumberConfirm">确认</cover-view>
    </cover-view>
  </cover-view>

  </view>
</view>
