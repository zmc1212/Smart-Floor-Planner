.project-page{min-height:100vh;padding:0 24rpx calc(56rpx + env(safe-area-inset-bottom));box-sizing:border-box}.nav{display:flex;align-items:center;padding-bottom:16rpx;box-sizing:content-box}.back{display:flex;width:62rpx;height:62rpx;align-items:center;justify-content:center;flex:none}.back-chevron{width:16rpx;height:16rpx;border-top:3rpx solid #26312a;border-right:3rpx solid #26312a;transform:rotate(-135deg);box-sizing:border-box}.nav-title{font-size:36rpx;font-weight:700;color:#1f2b22}.content{display:flex;flex-direction:column;gap:20rpx;padding-bottom:16rpx}.project-rail,.service-card,.folio-card{padding:28rpx;box-sizing:border-box}.rail-heading,.folio-heading,.appointment-row{display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx}.rail-title,.section-title{display:block;font-size:30rpx;font-weight:700;color:#1f2b22}.rail-enterprise,.section-subtitle{display:block;margin-top:8rpx;font-size:22rpx;line-height:1.4;color:#728078}.delivery-k{width:122rpx;height:122rpx;margin:-14rpx -4rpx -18rpx 0;flex:none}.stages{display:flex;align-items:flex-start;margin-top:24rpx}.stage{display:flex;min-width:0;flex:1;flex-direction:column;align-items:center;gap:10rpx}.stage-dot{width:22rpx;height:22rpx;border:6rpx solid #d9e2da;border-radius:50%;background:#fff;box-sizing:border-box}.stage.done .stage-dot{border-color:#18a94b;background:#18a94b}.stage.current .stage-dot{border-color:#18a94b;background:#eaf8ec;box-shadow:0 0 0 6rpx rgba(24,169,75,.13)}.stage-label{font-size:22rpx;line-height:1.3;text-align:center;color:#7a857d;white-space:nowrap}.stage.done .stage-label,.stage.current .stage-label{color:#27844b;font-weight:600}.stage-line{height:4rpx;flex:1;margin-top:9rpx;background:#dce5dd;transform:scaleY(.5)}.stage-line.done{background:#18a94b}.service-rows{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin-top:22rpx}.service-person{display:flex;min-width:0;gap:14rpx;align-items:flex-start}.avatar{display:flex;width:52rpx;height:52rpx;flex:none;a