.project-page{min-height:100vh;padding:0 24rpx 56rpx;box-sizing:border-box}.nav{display:flex;align-items:center;padding-bottom:14rpx;box-sizing:content-box}.back{display:flex;width:62rpx;height:62rpx;align-items:center;justify-content:center;flex:none}.back-chevron{width:16rpx;height:16rpx;border-top:3rpx solid #26312a;border-right:3rpx solid #26312a;transform:rotate(-135deg);box-sizing:border-box}.nav-title{font-size:36rpx;font-weight:700}.content{display:flex;flex-direction:column;gap:20rpx}.hero{min-height:190rpx;padding:30rpx;display:flex;justify-content:space-between;box-sizing:border-box}.check{width:52rpx;height:52rpx;border-radius:50%;background:#16ad4a;color:#fff;text-align:center;line-height:52rpx;font-size:32rpx}.hero-title{display:block;font-size:36rpx;font-weight:700;margin-top:12rpx}.hero-note,.person-note,.hint{display:block;font-size:24rpx;color:#6b7280;margin-top:8rpx}.measure-k{width:150rpx;height:150rpx}.card{padding:28rpx;display:flex;flex-direction:column;gap:24rpx}.section-title{font-size:28rpx;font-weight:600}.person,.line{display:flex;align-items:center;gap:18rpx;font-size:26rpx}.avatar{width:58rpx;height:58rpx;line-height:58rpx;text-align:center;border-radius:50%;background:#edf1ed;color:#333}.avatar.green{background:#eaf8ec;color:#18a94b}.person-title{display:block;font-size:26rpx}.line{justify-content:space-between}.address{text-align:right}.address text:last-child{max-width:390rpx}.reschedule{height:82rpx;margin-top:10rpx}.hint{text-align:center}.state{padding:160rpx 32rpx;text-align:center;font-size:26rpx;color:#6b7280}.retry{margin:24rpx auto;color:#18a94b;background:#fff;font-size:26rpx}
