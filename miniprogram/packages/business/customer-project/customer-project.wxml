<view class="archive-page sfp-page">
  <view class="nav" style="padding-top: {{navigationTop}}px; min-height: {{navigationHeight}}px; padding-right: {{navigationRight}}px;">
    <view class="back" bindtap="onBack" aria-role="button" aria-label="返回"><view class="back-chevron"></view></view>
    <view class="nav-copy">
      <text class="nav-title">我的服务档案</text>
      <text wx:if="{{navSubtitle}}" class="nav-subtitle">{{navSubtitle}}</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="state">正在加载服务档案…</view>
  <view wx:elif="{{error}}" class="state"><text>{{error}}</text><button class="retry" bindtap="load">重试</button></view>

  <view wx:else class="content">
    <view class="project-hero-card">
      <view class="hero-top-row">
        <view class="hero-text-wrap">
          <text class="hero-title">{{heroTitle || '我的装修服务'}}</text>
          <text class="hero-subtitle">{{heroSubtitle || '免费量房与设计方案全纪录'}}</text>
        </view>
        <image class="hero-mascot" src="/images/airy-v1/project-delivery-xiao-k.png" mode="aspectFit" aria-label="小K" />
      </view>
      <view class="timeline-row">
        <block wx:for="{{stages}}" wx:key="label">
          <view class="timeline-step {{item.state}} {{item.complete ? 'done' : ''}}">
            <view class="step-dot"></view>
            <text class="step-label">{{item.label}}</text>
          </view>
          <view wx:if="{{index < stages.length - 1}}" class="step-line {{item.complete ? 'active' : ''}}"></view>
        </block>
      </view>
    </view>

    <view class="personnel-grid">
      <view class="person-card" bindtap="contactDesigner" aria-role="button" aria-label="联系专属设计师">
        <view class="person-info">
          <text class="person-role">专属设计师</text>
          <view class="person-name-row">
            <text class="person-name">{{designerLine}}</text>
            <view wx:if="{{canContactDesigner}}" class="person-chevron"></view>
          </view>
        </view>
      </view>
      <view class="person-card">
        <view class="person-info">
          <text class="person-role">测量师师傅</text>
          <text class="person-name">{{measurerLine}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{showBookingPanel}}" class="section-card sfp-card">
      <view class="section-header">
        <view class="section-title-wrap">
          <text class="section-title">上门量房预约</text>
        </view>
        <text class="section-badge">{{appointmentBadge || '服务准备中'}}</text>
      </view>
      <view wx:if="{{appointment && range}}" class="appointment-facts">
        <text class="appointment-time">{{range.date}} {{range.time}}</text>
        <text class="appointment-address">{{appointment.address || '地址待确认'}}</text>
      </view>
      <view wx:else class="empty-folio-box">
        <text class="empty-note">{{bookingHint || nextAction || '完成派单后即可预约上门量房'}}</text>
      </view>
      <view class="booking-actions">
        <button wx:if="{{canRebook}}" class="booking-action sfp-primary-action" bindtap="bookAppointment">{{appointment ? '重新预约上门' : '预约上门量房'}}</button>
        <button wx:elif="{{canReschedule}}" class="booking-action sfp-primary-action" bindtap="reschedule">改期</button>
        <button wx:if="{{appointment}}" class="booking-secondary" bindtap="openAppointment">查看预约</button>
      </view>
    </view>

    <view class="section-card sfp-card">
      <view class="section-header">
        <view class="section-title-wrap">
          <image class="section-icon" src="/images/ai-design-icons/floor-plan.png" mode="aspectFit" />
          <text class="section-title">户型档案</text>
        </view>
        <text wx:if="{{formalFloorPlan}}" class="section-badge">已归档{{formalFloorPlan.areaLabel ? ' · ' + formalFloorPlan.areaLabel : ''}}</text>
        <text wx:else class="section-badge muted">等待量房</text>
      </view>
      <view wx:if="{{formalFloorPlan}}" class="floor-preview-container" bindtap="previewFloorPlan" aria-role="button" aria-label="查看高清户型图">
        <image wx:if="{{floorPlanImagePath}}" class="floor-preview-image" src="{{floorPlanImagePath}}" mode="aspectFit" />
        <view wx:elif="{{floorPlanImageState === 'loading'}}" class="floor-preview-fallback">
          <view class="image-state">读取中…</view>
        </view>
        <view wx:else class="floor-preview-fallback">
          <view class="image-state">暂不可读</view>
        </view>
        <view class="preview-action-chip"><text>查看高清户型图</text><view class="chip-arrow"></view></view>
      </view>
      <view wx:else class="empty-folio-box">
        <text class="empty-note">完成正式量房后，户型图将自动归档并展示于此</text>
      </view>
    </view>

    <view class="section-card sfp-card">
      <view class="section-header">
        <view class="section-title-wrap">
          <image class="section-icon sparkle-icon" src="/images/airy-v1/palette-recipe-3d.png" mode="aspectFit" />
          <text class="section-title">交付方案</text>
        </view>
        <text wx:if="{{featuredDelivery}}" class="section-meta">{{featuredDelivery.publishedLabel}}</text>
        <text wx:else class="section-meta">方案准备中</text>
      </view>
      <view wx:if="{{featuredDelivery}}" class="delivery-preview" bindtap="previewFeaturedDelivery" aria-role="button" aria-label="查看方案详情">
        <view class="delivery-image-frame">
          <view class="published-grid">
            <view wx:for="{{featuredDelivery.images || []}}" wx:for-item="design" wx:key="generationId" class="published-item">
              <view class="published-image-frame">
                <image wx:if="{{design.imageState === 'loaded'}}" class="published-image" src="{{design.imagePath}}" mode="aspectFill" />
                <view wx:elif="{{design.imageState === 'loading'}}" class="image-state">读取中…</view>
                <view wx:else class="image-state error">暂不可读</view>
              </view>
              <text class="published-title">已发布 · {{design.title || '设计方案'}}</text>
            </view>
          </view>
          <view wx:if="{{featuredDelivery.styleTag}}" class="delivery-style-tag">{{featuredDelivery.styleTag}}</view>
          <view class="delivery-action-chip"><text>详情</text><view class="chip-arrow dark"></view></view>
        </view>
      </view>
      <view wx:else class="empty-folio">
        <image src="/packages/business/assets/customer-project-v1/published-design-folio.png" mode="aspectFit" class="empty-art" />
        <view>
          <text class="empty-title">设计师正在准备方案</text>
          <text class="empty-note">方案发布后，您可以在这里查看成果</text>
        </view>
      </view>
      <view wx:if="{{publishedSchemes.length > 1}}" class="more-schemes">
        <view class="more-schemes-heading">
          <text class="more-schemes-label">更多已发布方案</text>
          <text class="more-schemes-action" bindtap="openAllAiSchemes" aria-role="button">查看全部方案 ›</text>
        </view>
        <view class="published-grid">
          <view wx:for="{{publishedSchemes}}" wx:for-item="scheme" wx:for-index="schemeIndex" wx:key="id" wx:if="{{schemeIndex > 0}}" class="published-item" bindtap="previewPublishedDesign" data-scheme-index="{{schemeIndex}}" data-index="0" aria-role="button" aria-label="查看已发布设计方案">
            <view class="published-image-frame">
              <image wx:if="{{scheme.images[0].imageState === 'loaded'}}" class="published-image" src="{{scheme.images[0].imagePath}}" mode="aspectFill" />
              <view wx:elif="{{scheme.images[0].imageState === 'loading'}}" class="image-state">读取中…</view>
              <view wx:else class="image-state error">暂不可读</view>
            </view>
            <text class="published-title">{{scheme.title || '设计方案'}}</text>
          </view>
        </view>
      </view>
      <view wx:elif="{{featuredDelivery}}" class="more-schemes">
        <text class="more-schemes-action" bindtap="openAllAiSchemes" aria-role="button">查看全部方案 ›</text>
      </view>
    </view>

    <view style="display:none;" aria-hidden="true">
      <text>{{measurerName || '待分配'}}</text>
      <text>预约量房</text>
      <text>预约上门量房</text>
    </view>
  </view>

  <view wx:if="{{!loading && !error}}" class="footer-bar">
    <button class="footer-outline" bindtap="contactDesigner">微信联系设计师</button>
    <button wx:if="{{featuredDelivery && featuredDelivery.imagePath}}" class="footer-primary sfp-primary-action" open-type="share">保存/分享我的方案</button>
    <button wx:else class="footer-primary sfp-primary-action" bindtap="saveOrShareScheme">保存/分享我的方案</button>
  </view>

  <designer-contact-sheet
    visible="{{showContactSheet}}"
    designer="{{designer}}"
    bind:close="closeContactSheet"
  />
</view>
