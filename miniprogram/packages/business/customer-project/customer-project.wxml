<view class="project-page sfp-page">
  <view class="nav" style="padding-top: {{navigationTop}}px; min-height: {{navigationHeight}}px; padding-right: {{navigationRight}}px;"><view class="back" bindtap="onBack" aria-role="button" aria-label="返回"><view class="back-chevron"></view></view><text class="nav-title">我的预约</text></view>
  <view wx:if="{{loading}}" class="state">正在加载服务档案…</view>
  <view wx:elif="{{error}}" class="state"><text>{{error}}</text><button class="retry" bindtap="load">重试</button></view>
  <view wx:elif="{{appointment}}" class="content">
    <view class="hero sfp-hero-card"><view><view class="check">✓</view><text class="hero-title">预约已确认</text><text class="hero-note">上门量房服务已为您安排</text></view><image src="/images/home-ip-v1/measure-k.png" mode="aspectFit" class="measure-k" /></view>
    <view class="card sfp-card"><text class="section-title">服务信息</text><view class="person"><view class="avatar">设</view><view><text class="person-title">{{designer && designer.displayName ? designer.displayName : '专属设计师'}}</text><text class="person-note">{{designer && designer.wechatId ? designer.wechatId : '将陪您完成量房与设计沟通'}}</text></view></view><view class="person"><view class="avatar green">量</view><view><text class="person-title">{{appointment.measurerName || '测量伙伴'}}</text><text class="person-note">请提前保留现场测量条件</text></view></view></view>
    <view class="card sfp-card"><text class="section-title">预约安排</text><view class="line"><text>预约日期</text><text>{{range.date}}</text></view><view class="line"><text>预约时间</text><text>{{range.time}}</text></view><view class="line address"><text>上门地址</text><text>{{appointment.address}}</text></view></view>
    <button class="reschedule sfp-secondary-action" bindtap="reschedule">改期</button><text class="hint">如需调整时间，请在截止时间前选择可用时段</text>
  </view>
  <view wx:else class="state">当前暂无已确认的上门预约</view>
</view>
