<view class="archive-page sfp-page">
  <view class="nav" style="padding-top: {{navigationTop}}px; min-height: {{navigationHeight}}px; padding-right: {{navigationRight}}px;">
    <view class="back" bindtap="onBack" aria-role="button" aria-label="返回"><view class="back-chevron"></view></view>
    <view class="nav-copy">
      <text class="nav-title">我的服务档案</text>
      <text wx:if="{{navSubtitle}}" class="nav-subtitle">{{navSubtitle}}</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="state">正在加载服务档案…</view>
  <view wx:elif="{{error}}" class="state"><text>{{error}}</text><button class="retry" bindtap="load">重试</button></view>

  <view wx:else class="content">
    <view class="project-hero-card">
      <view class="hero-top-row">
        <view class="hero-text-wrap">
          <text class="hero-title">您的家装顾问</text>
          <text class="hero-subtitle">现场顾问与设计方案全记录</text>
        </view>
        <image class="hero-mascot" src="/images/airy-v1/project-delivery-xiao-k.png" mode="aspectFit" aria-label="正在整理服务档案的小K" />
      </view>
      <view wx:if="{{isTerminated}}" class="termination-banner">
        <text class="termination-title">服务已终止</text>
        <text class="termination-copy">本次推广服务记录已撤销，如需继续服务，请重新扫描有效服务码</text>
      </view>
      <view class="timeline-row">
        <block wx:for="{{stages}}" wx:key="label">
          <view class="timeline-step {{item.state}} {{item.complete ? 'done' : ''}}">
            <view class="step-dot">{{index + 1}}</view>
            <text class="step-label">{{item.label}}</text>
          </view>
          <view wx:if="{{index < stages.length - 1}}" class="step-line {{item.complete ? 'active' : ''}}"></view>
        </block>
      </view>
    </view>

    <view wx:if="{{showBookingPanel}}" class="booking-panel">
      <view class="booking-summary">
        <view class="booking-icon-well">
          <image class="booking-icon" src="/packages/business/assets/customer-project-v4/calendar-check.png" mode="aspectFit" />
        </view>
        <view class="booking-copy">
          <text class="booking-title">预约量房</text>
          <text wx:if="{{appointment && range}}" class="booking-helper">{{range.date}} {{range.time}}{{appointment.address ? ' · ' + appointment.address : ''}}</text>
          <text wx:else class="booking-helper">{{bookingHint || '选择方便的时间，家装现场顾问会提前与你确认'}}</text>
        </view>
        <view class="booking-badge">{{appointmentBadge || '服务准备中'}}</view>
      </view>
      <view class="booking-actions">
        <button wx:if="{{canRebook}}" class="booking-action sfp-primary-action" bindtap="bookAppointment">{{appointment ? '重新预约' : '预约量房'}}</button>
        <button wx:elif="{{canReschedule}}" class="booking-action sfp-primary-action sfp-icon-action" bindtap="reschedule">
          <image class="sfp-icon-action__icon" src="/packages/business/assets/promotion-detail/calendar.png" mode="aspectFit" />
          <text>改期</text>
        </button>
        <button wx:if="{{appointment}}" class="booking-secondary sfp-icon-action" bindtap="openAppointment">
          <image class="sfp-icon-action__icon" src="/packages/business/assets/promotion-detail/calendar.png" mode="aspectFit" />
          <text>查看预约</text>
        </button>
      </view>
    </view>

    <view class="service-team {{isTerminated ? 'is-readonly' : ''}}">
      <text class="group-title">服务小组</text>
      <view class="personnel-grid">
        <view class="person-card is-designer" bindtap="contactDesigner" aria-role="button" aria-label="联系家装设计顾问">
          <view class="person-heading">
            <view class="person-icon-well">
              <image class="person-role-icon" src="/packages/business/assets/customer-project-v4/designer-user.png" mode="aspectFit" />
            </view>
            <view class="person-identity">
              <text class="person-role">家装设计顾问</text>
              <text class="person-name">{{designerName}}</text>
            </view>
          </view>
          <view wx:if="{{designerAssigned && (designerProfessionalTitle || designerExperienceLabel || designerServiceLabel)}}" class="person-professional">
            <text wx:if="{{designerProfessionalTitle}}" class="person-professional-title">{{designerProfessionalTitle}}</text>
            <text wx:if="{{designerExperienceLabel}}" class="person-professional-proof">{{designerExperienceLabel}}</text>
            <text wx:if="{{designerServiceLabel}}" class="person-professional-proof">{{designerServiceLabel}}</text>
          </view>
          <view class="person-card-footer">
            <text class="person-status">{{designerAssigned ? (canContactDesigner ? '在线沟通' : '专属服务') : '待分配'}}</text>
            <view
              wx:if="{{designerPhone}}"
              class="person-phone-button"
              catchtap="callStaff"
              data-phone="{{designerPhone}}"
              aria-role="button"
              aria-label="拨打家装设计顾问电话 {{designerPhone}}"
            >
              <image class="person-phone-icon" src="/packages/business/assets/customer-project-v4/phone.png" mode="aspectFit" />
            </view>
          </view>
        </view>

        <view
          class="person-card is-measurer"
          bindtap="callStaff"
          data-phone="{{measurerPhone}}"
          aria-role="{{measurerPhone ? 'button' : 'text'}}"
          aria-label="{{measurerPhone ? '拨打家装现场顾问电话 ' + measurerPhone : '家装现场顾问'}}"
        >
          <view class="person-heading">
            <view class="person-icon-well">
              <image class="person-role-icon is-ruler" src="/packages/business/assets/customer-project-v4/measurer-ruler.png" mode="aspectFit" />
            </view>
            <view class="person-identity">
              <text class="person-role">家装现场顾问</text>
              <text class="person-name">{{measurerName || '待分配'}}</text>
            </view>
          </view>
          <view wx:if="{{measurerName && (measurerProfessionalTitle || measurerExperienceLabel || measurerServiceLabel)}}" class="person-professional">
            <text wx:if="{{measurerProfessionalTitle}}" class="person-professional-title">{{measurerProfessionalTitle}}</text>
            <text wx:if="{{measurerExperienceLabel}}" class="person-professional-proof">{{measurerExperienceLabel}}</text>
            <text wx:if="{{measurerServiceLabel}}" class="person-professional-proof">{{measurerServiceLabel}}</text>
          </view>
          <view class="person-card-footer">
            <text class="person-status">{{measurerName ? (formalFloorPlan ? '已量房' : '待预约') : '待分配'}}</text>
            <view wx:if="{{measurerPhone}}" class="person-phone-button" aria-hidden="true">
              <image class="person-phone-icon" src="/packages/business/assets/customer-project-v4/phone.png" mode="aspectFit" />
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="dossier-book">
      <view class="dossier-spine"></view>

      <view class="dossier-row" bindtap="handleDossierRow" data-kind="floor" aria-role="{{formalFloorPlan ? 'button' : 'text'}}" aria-label="{{formalFloorPlan ? '查看高清户型图' : '户型档案等待量房'}}">
        <view class="dossier-dot is-floor"></view>
        <view class="dossier-icon-well is-floor">
          <image class="dossier-icon" src="/packages/business/assets/customer-project-v4/dossier-file.png" mode="aspectFit" />
        </view>
        <view class="dossier-copy">
          <text class="dossier-title">户型档案</text>
          <text class="dossier-helper">{{formalFloorPlan ? '正式户型已归档，可查看高清图' : '完成正式量房后自动归档'}}</text>
        </view>
        <view class="dossier-status is-floor {{formalFloorPlan ? '' : 'is-muted'}}">{{formalFloorPlan ? '已归档' : '等待量房'}}</view>
        <view class="dossier-chevron {{formalFloorPlan ? '' : 'is-muted'}}"></view>
      </view>

      <view class="dossier-divider"></view>

      <view class="dossier-row" bindtap="handleDossierRow" data-kind="site" aria-role="button" aria-label="{{sitePhotoManagerOpen ? '收起房屋现场图' : '查看或补充房屋现场图'}}">
        <view class="dossier-dot is-site"></view>
        <view class="dossier-icon-well is-site">
          <image class="dossier-icon" src="/packages/business/assets/customer-project-v4/dossier-image.png" mode="aspectFit" />
        </view>
        <view class="dossier-copy">
          <text class="dossier-title">房屋现场图</text>
          <text class="dossier-helper">量房前后都可补充</text>
        </view>
        <view class="dossier-status is-site">{{sitePhotos.length ? sitePhotos.length + ' 张' : '待采集'}}</view>
        <view class="dossier-chevron {{sitePhotoManagerOpen ? 'is-open' : ''}}"></view>
      </view>
      <view wx:if="{{sitePhotoManagerOpen}}" class="dossier-body" catchtap="noop">
        <site-photo-grid
          lead-id="{{leadId}}"
          photos="{{sitePhotos}}"
          space-tags="{{sitePhotoTags}}"
      show-add="{{!isTerminated}}"
          uploading="{{sitePhotoUploading}}"
          limit-reached="{{sitePhotoLimitReached}}"
          bind:change="onSitePhotosChange"
          bind:uploading="onSitePhotoUploading"
          bind:sheetchange="onSitePhotoSheetChange"
        />
      </view>

      <view class="dossier-divider"></view>

      <view class="dossier-row" bindtap="handleDossierRow" data-kind="delivery" aria-role="{{featuredDelivery ? 'button' : 'text'}}" aria-label="{{featuredDelivery ? '查看交付方案' : '交付方案待设计'}}">
        <view class="dossier-dot is-delivery"></view>
        <view class="dossier-icon-well is-delivery">
          <image class="dossier-icon" src="/packages/business/assets/customer-project-v4/dossier-delivery.png" mode="aspectFit" />
        </view>
        <view class="dossier-copy">
          <text class="dossier-title">交付方案</text>
          <text class="dossier-helper">{{featuredDelivery ? featuredDelivery.publishedLabel : '家装设计顾问发布后可查看与分享'}}</text>
        </view>
        <view class="dossier-status is-delivery">{{featuredDelivery ? '可查看' : '待设计'}}</view>
        <view class="dossier-chevron {{featuredDelivery ? '' : 'is-muted'}}"></view>
      </view>
    </view>
  </view>

  <view wx:if="{{!loading && !error && !sitePhotoSheetOpen && !isTerminated}}" class="footer-bar">
    <button class="footer-outline" bindtap="contactDesigner">
      <image class="footer-contact-icon" src="/packages/business/assets/customer-project-v4/message-circle-more.png" mode="aspectFit" />
      <text>微信联系家装设计顾问</text>
    </button>
    <button wx:if="{{canRebook}}" class="footer-primary sfp-primary-action" bindtap="bookAppointment">预约量房</button>
    <button wx:elif="{{showBookingPanel && appointment}}" class="footer-primary sfp-primary-action" bindtap="openAppointment">查看预约</button>
    <button wx:else class="footer-primary sfp-primary-action" bindtap="saveOrShareScheme">保存/分享我的方案</button>
  </view>

  <designer-contact-sheet
    visible="{{showContactSheet}}"
    designer="{{designer}}"
    bind:close="closeContactSheet"
  />

  <scheme-share-poster
    visible="{{showSchemePoster}}"
    imagePath="{{posterImagePath}}"
    schemeTitle="{{posterSchemeTitle}}"
    bind:close="closeSchemePoster"
  />
</view>
