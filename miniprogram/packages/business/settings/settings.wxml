<view class="account-page settings-page">
  <view class="account-hero">
    <view class="account-hero-green"></view>
    <view class="account-hero-copy">
      <view class="account-hero-title">权限管家 · 小K</view>
      <view class="account-hero-copy-text">通知与系统权限，都由您亲自掌握</view>
    </view>
    <image class="account-hero-art" src="../assets/account-v1/settings-guardian-scene-v3.png" mode="aspectFit" aria-hidden="true" />
  </view>

  <view class="account-section-title">通知与权限</view>
  <view class="account-surface">
    <view class="account-row" hover-class="account-row-pressed" bindtap="onEnableNotification" aria-role="button">
      <image class="account-row-icon" src="/images/mine-icons/bell.png" mode="aspectFit" />
      <view class="account-row-copy">
        <view class="account-row-label">订阅任务通知</view>
        <view class="account-row-helper">接收客户交接与工作任务提醒</view>
      </view>
      <view class="account-row-status {{notificationAccepted ? 'account-row-status-active' : ''}}">{{notificationStatus}}</view>
      <view class="account-chevron"></view>
    </view>
    <view class="account-row" hover-class="account-row-pressed" bindtap="onOpenSystemSettings" aria-role="button">
      <image class="account-row-icon" src="/images/mine-v6/settings.png" mode="aspectFit" />
      <view class="account-row-copy">
        <view class="account-row-label">微信权限管理</view>
        <view class="account-row-helper">查看通知、相册等系统授权</view>
      </view>
      <view class="account-chevron"></view>
    </view>
  </view>

  <view class="account-section-title">账号</view>
  <view class="account-surface">
    <view class="account-row" hover-class="account-row-pressed" bindtap="onOpenAccountSecurity" aria-role="button">
      <image class="account-row-icon" src="/images/mine-icons/shield-check.png" mode="aspectFit" />
      <view class="account-row-copy">
        <view class="account-row-label">账号与安全</view>
        <view class="account-row-helper">查看登录账号、手机号和密码设置</view>
      </view>
      <view class="account-chevron"></view>
    </view>
  </view>

  <button class="danger-action" bindtap="onLogout">退出当前账号</button>
</view>
