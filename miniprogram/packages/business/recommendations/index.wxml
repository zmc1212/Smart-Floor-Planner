<view class="container">
  <view class="header">
    <view class="header-copy">
      <view class="recommendation-kicker"><text class="eyebrow">装修方案推荐</text><text class="example-chip">示例</text></view>
      <text class="title">为家精选合适方案</text>
      <text class="subtitle">根据户型与偏好生成适合你的装修方向</text>
    </view>
    <image class="recommendation-scene" src="/packages/business/assets/recommendations/recommendations.png" mode="aspectFit"></image>
  </view>

  <view class="progress-section">
    <view class="progress-title">装修进度</view>
    <view class="progress-steps">
      <block wx:for="{{progressStages}}" wx:key="id">
        <view class="step-item {{currentStep >= index ? 'active' : ''}} {{completedSteps.includes(item.id) ? 'completed' : ''}}">
          <view class="step-number">{{index + 1}}</view>
          <view class="step-content">
            <text class="step-title">{{item.title}}</text>
            <text class="step-description">{{item.description}}</text>
          </view>
        </view>
        <view class="step-line {{currentStep > index ? 'completed' : ''}}" wx:if="{{index < progressStages.length - 1}}"></view>
      </block>
    </view>
  </view>

  <view class="recommendations-section">
    <view class="section-title">推荐方案</view>
    <scroll-view scroll-x="true" class="recommendations-scroll" show-scrollbar="{{false}}">
      <block wx:for="{{recommendations}}" wx:key="id">
        <view class="recommendation-card">
          <image src="{{item.imageUrl}}" class="recommendation-image" mode="aspectFill" />
          <view class="card-content">
            <text class="card-title">{{item.name}}</text>
            <text class="card-description">{{item.description}}</text>
            <view class="budget-info">
              <text>预算：{{item.budgetLabel}}</text>
            </view>
            <view class="match-score">
              <text>匹配度 {{item.matchPercent}}%</text>
            </view>
            <view class="card-actions">
              <button
                class="action-btn primary"
                bindtap="onStyleSelect"
                data-style-id="{{item.id}}"
              >
                {{selectedStyle === item.id ? '已选择' : '查看详情'}}
              </button>
            </view>
          </view>
        </view>
      </block>
    </scroll-view>
  </view>

  <view class="share-section" wx:if="{{selectedStyle}}">
    <view class="share-tips">
      <text class="tips-text">选择喜欢的风格，分享给家人一起确认。</text>
      <button class="share-btn" open-type="share">分享方案</button>
    </view>
  </view>
</view>
