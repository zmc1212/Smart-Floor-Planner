<view class="account-page profile-edit-page">
  <view class="account-hero">
    <view class="account-hero-green"></view>
    <view class="account-hero-copy">
      <view class="account-hero-title">资料管家 · 小K</view>
      <view class="account-hero-copy-text">帮您整理专业信息，生成空间服务名片</view>
    </view>
    <image class="account-hero-art" src="../assets/account-v1/profile-dossier-scene-v3.png" mode="aspectFit" aria-hidden="true" />
  </view>

  <view wx:if="{{loading}}" class="state-message">正在读取个人资料…</view>
  <view wx:elif="{{loadError}}" class="state-message">
    <view>{{loadError}}</view>
    <view class="state-retry" bindtap="loadProfile" aria-role="button">重新加载</view>
  </view>
  <block wx:else>
    <view class="account-profile-card">
      <view class="account-avatar-shell">
        <image class="account-profile-avatar" src="{{pendingAvatarPath || profile.avatar || defaultAvatar}}" mode="aspectFill" />
        <button class="account-avatar-picker" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" aria-label="更换头像">
          <view class="account-avatar-camera">更换头像</view>
        </button>
      </view>
      <view class="account-profile-copy">
        <view class="account-profile-name">{{nickname || '未设置昵称'}}</view>
        <view class="account-profile-role">{{profile.roleLabel || '成员'}}</view>
        <view class="account-profile-change" aria-hidden="true">更新工作名片 <view class="account-profile-change-arrow"></view></view>
      </view>
    </view>

    <view class="account-surface profile-name-surface">
      <view class="field-group">
        <text class="field-label">昵称</text>
        <input class="field-input" value="{{nickname}}" maxlength="30" placeholder="请输入昵称" placeholder-class="field-placeholder" bindinput="onNicknameInput" />
        <view class="field-counter">{{nickname.length}} / 30</view>
      </view>
    </view>

    <view class="account-section-title">身份信息</view>
    <view class="account-surface">
      <view class="account-row">
        <image class="account-row-icon" src="/images/mine-icons/building.png" mode="aspectFit" />
        <view class="account-row-label">所属企业</view>
        <view class="account-row-value">{{profile.enterpriseName || '暂无企业归属'}}</view>
      </view>
      <view class="account-row">
        <image class="account-row-icon" src="/images/mine-icons/user.png" mode="aspectFit" />
        <view class="account-row-label">当前角色</view>
        <view class="account-row-value">{{profile.roleLabel || '成员'}}</view>
      </view>
      <view class="account-row">
        <image class="account-row-icon" src="/images/mine-icons/shield-check.png" mode="aspectFit" />
        <view class="account-row-label">绑定手机</view>
        <view class="account-row-value">{{profile.phoneMasked || '未绑定'}}</view>
      </view>
    </view>

    <block wx:if="{{isProfessionalStaff}}">
      <view class="account-section-title">客户可见专业背书</view>
      <view wx:if="{{professionalProfileLocked}}" class="professional-rule-note is-locked">
        职业资料已由企业管理员锁定，如需修改请联系管理员
      </view>
      <view wx:elif="{{professionalProfile && professionalProfile.enterpriseForceProfile}}" class="professional-rule-note">
        当前企业统一背书正在生效；你填写的个人资料会保存，企业关闭统一覆盖后自动使用
      </view>
      <view class="account-surface professional-profile-surface">
        <view class="field-group">
          <text class="field-label">我的专业头衔</text>
          <input class="field-input" disabled="{{professionalProfileLocked}}" value="{{professionalTitle}}" maxlength="20" placeholder="例如：全案设计师" placeholder-class="field-placeholder" bindinput="onProfessionalTitleInput" />
          <view class="field-counter">{{professionalTitle.length}} / 20</view>
        </view>
        <view class="professional-divider"></view>
        <view class="field-group">
          <text class="field-label">从业起始年份</text>
          <input class="field-input" disabled="{{professionalProfileLocked}}" type="number" value="{{professionalCareerStartYear}}" maxlength="4" placeholder="例如：2016" placeholder-class="field-placeholder" bindinput="onProfessionalCareerYearInput" />
          <text class="field-helper">系统会自动计算从业年限；企业统一配置生效时按企业经验年限展示</text>
        </view>
        <view class="professional-divider"></view>
        <view class="professional-switch-row">
          <view class="professional-switch-copy">
            <text class="field-label">显示专业头衔</text>
            <text class="field-helper">{{professionalVisibilityControlled ? '当前由企业统一控制显示或隐藏' : '关闭后仍保留经验与服务客户背书'}}</text>
          </view>
          <switch color="#12b85a" checked="{{professionalTitleVisible}}" disabled="{{professionalProfileLocked || professionalVisibilityControlled}}" bindchange="onProfessionalTitleVisibleChange" />
        </view>
        <view class="professional-divider"></view>
        <view class="professional-switch-row">
          <view class="professional-switch-copy">
            <text class="field-label">展示真实服务人数</text>
            <text class="field-helper">{{professionalProfile && professionalProfile.canShowActualServiceCount ? '已超过企业门槛，可展示系统准确数字' : '超过企业门槛后才能开启；当前客户侧显示100+'}}</text>
          </view>
          <switch color="#12b85a" checked="{{professionalShowActualServiceCount}}" disabled="{{professionalProfileLocked || !professionalProfile || !professionalProfile.canShowActualServiceCount}}" bindchange="onProfessionalActualCountChange" />
        </view>
      </view>
      <view wx:if="{{professionalProfile}}" class="professional-preview">
        <text class="professional-preview-label">客户侧预览</text>
        <text wx:if="{{professionalProfile.titleVisible && professionalProfile.title}}" class="professional-preview-title">{{professionalProfile.title}}</text>
        <view class="professional-preview-proof">
          <text>{{professionalProfile.experienceLabel}}</text>
          <view class="professional-proof-dot"></view>
          <text>{{professionalProfile.serviceLabel}}</text>
        </view>
        <text class="professional-preview-note">真实服务客户 {{professionalProfile.actualServiceCount}} 位，仅你和企业管理员可见</text>
      </view>
    </block>

    <block wx:if="{{isDesigner}}">
      <view class="account-section-title">设计师服务资料</view>
      <view class="wechat-eligibility tone-{{eligibilityTone}}">
        <text class="wechat-eligibility-label">{{eligibilityLabel}}</text>
      </view>
      <view class="account-surface profile-name-surface">
        <view class="field-group">
          <text class="field-label">微信号</text>
          <input class="field-input" value="{{wechatId}}" maxlength="64" placeholder="微信「我」页的微信号，不是昵称" placeholder-class="field-placeholder" bindinput="onWechatIdInput" />
          <view class="field-counter">{{wechatId.length}} / 64</view>
        </view>
      </view>
      <view class="account-surface wechat-qr-surface">
        <view class="wechat-qr-copy">
          <text class="field-label">个人微信二维码</text>
          <text class="wechat-qr-hint">请从微信「我」页打开二维码名片后点保存图片再上传；客户会在领取成功页和服务档案看到这张码</text>
        </view>
        <image wx:if="{{wechatQrPath}}" class="wechat-qr-preview" src="{{wechatQrPath}}" mode="aspectFit" show-menu-by-longpress="{{true}}" />
        <view wx:elif="{{hasWechatQr}}" class="wechat-qr-empty">二维码已上传，正在加载预览…</view>
        <view wx:else class="wechat-qr-empty">尚未上传</view>
        <view
          class="wechat-qr-upload {{uploadingQr ? 'is-disabled' : ''}}"
          hover-class="btn-pressed"
          hover-stay-time="80"
          catchtap="onChooseWechatQr"
          aria-role="button"
        >{{uploadingQr ? '上传中…' : (hasWechatQr ? '更换二维码' : '上传二维码')}}</view>
      </view>
    </block>

    <view
      class="primary-action {{saving || !nickname ? 'is-disabled' : ''}}"
      hover-class="btn-pressed"
      hover-stay-time="80"
      catchtap="onSave"
      aria-role="button"
    >{{saving ? '保存中…' : '保存资料'}}</view>
  </block>
</view>
