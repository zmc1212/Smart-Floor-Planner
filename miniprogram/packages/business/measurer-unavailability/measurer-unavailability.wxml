<view class="page sfp-page">
  <view class="nav" style="padding-top: {{navigationTop}}px; min-height: {{navigationHeight}}px; padding-right: {{navigationRight}}px;"><view class="back" bindtap="onBack" aria-role="button" aria-label="返回"><view class="back-chevron"></view></view><view><text class="nav-title">不可预约时间</text><text class="nav-subtitle">量房日程 · 我的安排</text></view></view>
  <view class="scene" aria-hidden="true"><view class="scene-ruler"></view><view class="scene-calendar"><view></view><view></view><view></view><view></view><view class="scene-calendar-active"></view><view></view></view></view>
  <view class="editor sfp-card">
    <picker mode="date" value="{{date}}" bindchange="onDateChange"><view class="date-row"><text>日期</text><text>{{date}}</text></view></picker>
    <view class="hairline"></view>
    <view class="time-row"><picker mode="time" value="{{startTime}}" bindchange="onStartTimeChange"><view class="time-picker"><text>开始时间</text><text>{{startTime}}</text></view></picker><picker mode="time" value="{{endTime}}" bindchange="onEndTimeChange"><view class="time-picker"><text>结束时间</text><text>{{endTime}}</text></view></picker></view>
    <view class="reason-label">原因备注（选填）</view>
    <input class="reason-input sfp-input-surface" value="{{reason}}" maxlength="100" placeholder="如午休、个人事务" bindinput="onReasonInput" />
    <button class="save sfp-primary-action" loading="{{saving}}" disabled="{{saving}}" bindtap="save">保存不可用时间</button>
  </view>
  <view class="section-head"><text>已设时段（{{periods.length}}）</text></view>
  <view wx:if="{{loading}}" class="state">正在加载已设时段…</view>
  <view wx:elif="{{error}}" class="state"><text>{{error}}</text><button class="retry" bindtap="load">重试</button></view>
  <view wx:elif="{{periods.length}}" class="period-list"><view wx:for="{{periods}}" wx:key="id" class="period sfp-card"><view><text class="period-time">{{item.date}} {{item.time}}</text><text wx:if="{{item.reason}}" class="period-reason">{{item.reason}}</text></view><button class="delete" data-id="{{item.id}}" loading="{{deletingId === item.id}}" disabled="{{deletingId === item.id}}" bindtap="remove">删除</button></view></view>
  <view wx:else class="state">还没有设置不可预约时段</view>
</view>
