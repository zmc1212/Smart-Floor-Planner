<!--
  企业开户页：复用入驻页品牌锁与极简透气体，无独立设计稿 / 无新 IP 插画。
  流程：解析 er_ → 授权手机号 → 填表 → 待审成功态。
-->
<view class="register-page state-{{pageState}}">
  <view
    class="register-nav"
    style="padding-top: {{navigationTop}}px; min-height: {{navigationHeight}}px; padding-right: {{navigationRight}}px;"
  >
    <view class="brand-lockup">
      <image class="brand-logo" src="/images/home-ip-v1/brand-logo.png" mode="aspectFit" />
      <text class="brand-name">家客来</text>
      <view class="nav-divider"></view>
      <text class="nav-title">{{navTitle}}</text>
    </view>
  </view>

  <view wx:if="{{pageState === 'resolving'}}" class="register-state">
    <view class="resolving-ring"></view>
    <view class="state-title">正在确认开户码</view>
    <view class="state-copy">请稍候，正在校验本次企业开户资格。</view>
  </view>

  <scroll-view wx:elif="{{pageState === 'ready' || pageState === 'submitting'}}" scroll-y class="register-scroll">
    <view class="register-content">
      <view class="hero-copy">
        <text class="welcome-title">申请企业开户</text>
        <text class="welcome-subtitle">{{platformLabel}} · 审核通过后可用该手机号登录</text>
      </view>

      <view class="form-card">
        <view class="section-title">企业资料</view>
        <input
          class="form-input"
          value="{{enterpriseName}}"
          maxlength="80"
          placeholder="企业全称"
          placeholder-class="form-placeholder"
          bindinput="onEnterpriseNameInput"
          disabled="{{submitting}}"
        />
        <input
          class="form-input"
          value="{{creditCode}}"
          maxlength="32"
          placeholder="统一社会信用代码"
          placeholder-class="form-placeholder"
          bindinput="onCreditCodeInput"
          disabled="{{submitting}}"
        />
      </view>

      <view class="form-card">
        <view class="section-title">联系人信息</view>
        <input
          class="form-input"
          value="{{contactName}}"
          maxlength="30"
          placeholder="联系人姓名"
          placeholder-class="form-placeholder"
          bindinput="onContactNameInput"
          disabled="{{submitting}}"
        />
        <view class="phone-row">
          <text class="phone-label">联系人手机</text>
          <text class="phone-value">{{authorizedPhone || '授权后自动填写'}}</text>
        </view>
        <input
          class="form-input"
          value="{{contactEmail}}"
          maxlength="80"
          placeholder="邮箱（可选）"
          placeholder-class="form-placeholder"
          bindinput="onContactEmailInput"
          disabled="{{submitting}}"
        />
      </view>

      <view class="privacy-note">
        <view class="privacy-mark"><view class="privacy-check"></view></view>
        <text>联系人手机必须与微信授权手机号一致，审核通过后将作为管理员登录账号</text>
      </view>

      <button
        wx:if="{{!authorizedPhone}}"
        class="join-action {{submitting ? 'is-disabled' : ''}}"
        open-type="getPhoneNumber"
        bindgetphonenumber="onGetPhoneNumber"
        loading="{{submitting}}"
        disabled="{{submitting}}"
      >
        <image class="join-shield" src="/images/mine-icons/shield-check.png" mode="aspectFit" />
        <text>授权手机号</text>
      </button>

      <button
        wx:else
        class="join-action {{submitting ? 'is-disabled' : ''}}"
        bindtap="onSubmit"
        loading="{{submitting}}"
        disabled="{{submitting}}"
      >
        <text>提交开户申请</text>
      </button>

      <view class="identity-link" bindtap="onGoToLogin" aria-role="button">
        <text>已有账号，去登录</text>
        <view class="link-chevron"></view>
      </view>
    </view>
  </scroll-view>

  <view wx:elif="{{pageState === 'recovery'}}" class="register-state recovery-state">
    <view class="state-title">当前开户码暂不可用</view>
    <view class="state-copy">{{errorMessage}}</view>
    <button class="state-action" bindtap="onGoToLogin">去登录</button>
    <button class="state-action-secondary" bindtap="onOpenIdentitySwitch">切换可用身份</button>
  </view>

  <view wx:elif="{{pageState === 'success'}}" class="register-state success-state">
    <view class="success-mark"><view class="success-check"></view></view>
    <view class="state-title">申请已提交</view>
    <view class="state-copy">资料已进入平台审核。审核通过后，可用该手机号登录管理后台与小程序，初始密码为 123456。</view>
    <button class="state-action" bindtap="onGoToLogin">去登录</button>
  </view>

  <view wx:elif="{{pageState === 'account'}}" class="register-state error-state">
    <view class="state-title">该手机号已有账号</view>
    <view class="state-copy">{{errorMessage}}</view>
    <button class="state-action" bindtap="onGoToLogin">去登录</button>
  </view>

  <view wx:else class="register-state error-state">
    <image src="/images/mine-icons/shield-check.png" mode="aspectFit" aria-label="开户校验提示" />
    <view class="state-title">暂未完成提交</view>
    <view class="state-copy">{{errorMessage}}</view>
    <button class="state-action" bindtap="onGoToLogin">去登录</button>
    <button class="state-action-secondary" bindtap="onRetry">重新校验</button>
  </view>
</view>
