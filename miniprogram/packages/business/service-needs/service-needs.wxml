<view class="service-needs-page">
  <view
    class="needs-nav"
    style="padding-top: {{navigationTop}}px; min-height: {{navigationHeight}}px; padding-right: {{navigationRight}}px;"
  >
    <view class="needs-nav-back" bindtap="onBack" aria-role="button" aria-label="返回">
      <view class="needs-back-chevron"></view>
    </view>
    <view class="needs-brand">
      <image src="/images/home-ip-v1/brand-logo.png" mode="aspectFit" />
      <text>家客来</text>
      <view class="needs-nav-divider"></view>
      <text class="needs-nav-title">服务需求</text>
    </view>
  </view>

  <scroll-view scroll-y class="needs-scroll" enhanced show-scrollbar="{{false}}">
    <view class="needs-content">
      <view class="needs-hero">
        <view class="needs-kicker">补充服务记录</view>
        <text class="needs-title">还有哪些问题，想先聊聊？</text>
        <text class="needs-subtitle">可多选，提交后由设计师通过微信和你确认</text>
      </view>

      <view wx:if="{{error}}" class="needs-error">
        <text>{{error}}</text>
        <view class="needs-retry" bindtap="load">重新加载</view>
      </view>

      <view wx:elif="{{loading}}" class="needs-loading">正在读取服务需求…</view>

      <view wx:else class="needs-form">
        <view class="needs-section-title">选择你想先解决的问题</view>
        <view class="needs-options">
          <view
            wx:for="{{options}}"
            wx:key="key"
            class="needs-option {{item.selected ? 'is-selected' : ''}}"
            data-key="{{item.key}}"
            bindtap="onToggle"
            hover-class="needs-option-pressed"
            aria-role="checkbox"
            aria-checked="{{item.selected}}"
          >
            <view class="needs-option-check" aria-hidden="true">
              <view wx:if="{{item.selected}}" class="needs-option-checkmark"></view>
            </view>
            <view class="needs-option-copy">
              <text class="needs-option-label">{{item.label}}</text>
              <text wx:if="{{item.key === 'old_house_consultation'}}" class="needs-option-helper">翻新思路、空间问题与改造重点</text>
              <text wx:elif="{{item.key === 'materials_consultation'}}" class="needs-option-helper">主材怎么选、怎么买更合适</text>
              <text wx:else class="needs-option-helper">厨房、卫生间、阳台等局部空间</text>
            </view>
            <view class="needs-option-arrow" aria-hidden="true">›</view>
          </view>
        </view>

        <view
          class="needs-empty-option {{hasSelection ? '' : 'is-selected'}}"
          bindtap="onClear"
          hover-class="needs-option-pressed"
          aria-role="checkbox"
          aria-checked="{{!hasSelection}}"
        >
          <view class="needs-option-check" aria-hidden="true">
            <view wx:if="{{!hasSelection}}" class="needs-option-checkmark"></view>
          </view>
          <view class="needs-option-copy">
            <text class="needs-option-label">暂时没有其他需求</text>
            <text class="needs-option-helper">之后也可以让设计师帮你补充</text>
          </view>
        </view>

        <view class="needs-note">
          <image src="/images/mine-icons/shield-check.png" mode="aspectFit" />
          <text>这一步不会改变你的服务进度，只用于记录沟通重点</text>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="needs-footer">
    <button class="needs-save" bindtap="onSave" loading="{{saving}}" disabled="{{saving || loading || !!error}}">
      保存服务需求
    </button>
  </view>
</view>
