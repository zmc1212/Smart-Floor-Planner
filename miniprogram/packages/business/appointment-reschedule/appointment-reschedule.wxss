.page{min-height:100vh;padding:0 24rpx 48rpx;box-sizing:border-box}.nav{display:flex;align-items:center;padding-bottom:14rpx;padding-left:2rpx;box-sizing:content-box;font-size:36rpx;font-weight:700}.back{display:flex;width:62rpx;height:62rpx;align-items:center;justify-content:center;flex:none}.back-chevron,.chevron{width:16rpx;height:16rpx;border-top:3rpx solid #26312a;border-right:3rpx solid #26312a;transform:rotate(45deg);box-sizing:border-box}.back-chevron{transform:rotate(-135deg)}.panel{padding:28rpx;box-sizing:border-box}.title{font-size:30rpx;font-weight:700}.desc{display:block;font-size:22rpx;color:#6b7280;margin:10rpx 0 26rpx}.date-picker{display:flex;align-items:center;gap:10rpx}.days{display:flex;gap:12rpx;flex:1;overflow:hidden}.day{flex:1;min-width:0;min-height:104rpx;border-radius:14rpx;border:1rpx solid #e5e7eb;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:24rpx;gap:8rpx}.day.active{background:#18a94b;color:#fff;border-color:#18a94b}.window-button{display:flex;width:34rpx;height:84rpx;align-items:center;justify-content:center;flex:none}.window-button.disabled{opacity:.28}.chevron.previous{transform:rotate(-135deg)}.slots{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx;margin-top:28rpx}.slot{height:72rpx;border:1rpx solid #e2e8e2;border-radius:12rpx;display:flex;align-items:center;justify-content:center;font-size:24rpx}.slot.selected{border-color:#18a94b;background:#eaf8ec;color:#168a3d;font-weight:600}.loading{grid-column:1/4;text-align:center;color:#6b7280;padding:44rpx 0;font-size:24rpx}.confirm-bar{position:fixed;left:24rpx;right:24rpx;bottom:calc(32rpx + env(safe-area-inset-bottom));z-index:5}.confirm{display:block;height:88rpx;margin:0;font-size:26rpx}.confirm[disabled]{opacity:.45}
