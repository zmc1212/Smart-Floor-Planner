<!--
THESIS: 客户与内部人员共享同一套真实时段选择，内部改期额外留下原因审计。
OWN-WORLD: 延续已批准的绿色预约选择器，不创建第二套排期视觉。
FORM: Scheduling sheet with role-aware confirmation fields.
-->
<view class="page sfp-page"><view class="nav" style="padding-top: {{navigationTop}}px; min-height: {{navigationHeight}}px; padding-right: {{navigationRight}}px;"><view class="back" bindtap="onBack" aria-role="button" aria-label="返回"><view class="back-chevron"></view></view><text>{{pageTitle}}</text></view><view class="panel sfp-card"><text class="title">选择新的上门时间</text><text class="desc">仅展示测量伙伴真实可用的时段</text><view class="date-picker"><view class="window-button {{dateOffset===0?'disabled':''}}" bindtap="previousDates" aria-role="button" aria-label="查看更早日期"><view class="chevron previous"></view></view><view class="days"><view wx:for="{{dates}}" wx:key="key" class="day {{selectedDate===item.key?'active':''}}" data-date="{{item.key}}" bindtap="chooseDate"><text>{{item.label}}</text><text>{{item.key.slice(5)}}</text></view></view><view class="window-button {{dateOffset+dates.length>maxAdvanceDays?'disabled':''}}" bindtap="nextDates" aria-role="button" aria-label="查看后续日期"><view class="chevron"></view></view></view><view wx:if="{{loading}}" class="loading">正在计算可用时段…</view><view wx:elif="{{error}}" class="loading">{{error}}</view><view wx:else class="slots"><view wx:for="{{slots}}" wx:key="startAt" class="slot {{selectedSlotStart===item.startAt?'selected':''}}" data-slot="{{item}}" bindtap="chooseSlot">{{item.label}}</view><text wx:if="{{!slots.length}}" class="loading">当天暂无可用时段</text></view><view class="reason-field" wx:if="{{internalMode}}"><text>调整原因</text><textarea value="{{reason}}" maxlength="200" auto-height placeholder="填写原因，便于客户与服务人员了解变更" bindinput="onReasonInput"></textarea></view></view><view class="confirm-bar"><button class="confirm sfp-primary-action" style="width: {{actionWidth}}px;" loading="{{submitting}}" disabled="{{!selectedSlot || (internalMode && !reason)}}" bindtap="submit">确认改期{{selectedSlot?'为 '+selectedDate+' '+selectedSlot.label:''}}</button></view></view>
