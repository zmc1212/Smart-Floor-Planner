<!--
  THESIS: 登录像小 K 亲手打开家门，拒绝通用插画加表单的拼贴感。
  OWN-WORLD: 暖白家居、亮绿空间门框、柔和白色面板与克制的细线图标。
  STORY: 员工识别企业工作台，选择登录方式，授权后进入真实业务流程。
  FIRST VIEWPORT: 上半屏是完整开门场景；登录面板在场景下缘上浮，能力摘要和返回入口同屏收束。
  FORM: Operate 模式，按 design-references/all-pages-ip-v1/06-login.png 直接高保真还原。
-->
<view class="login-page">
  <view class="hero-wrap" aria-label="家客来企业客户工作台，欢迎回来，家客来伙伴">
    <image class="hero-image" src="/packages/business/assets/login-v1/hero-scene.jpg" mode="aspectFill" />
  </view>

  <view class="login-card">
    <view class="tabs" role="tablist">
      <view class="tab {{loginType === 'phone' ? 'active' : ''}}" bindtap="switchTab" data-type="phone" role="tab" aria-selected="{{loginType === 'phone'}}">
        <text>快捷登录</text>
        <view class="tab-line"></view>
      </view>
      <view class="tab {{loginType === 'password' ? 'active' : ''}}" bindtap="switchTab" data-type="password" role="tab" aria-selected="{{loginType === 'password'}}">
        <text>账号登录</text>
        <view class="tab-line"></view>
      </view>
    </view>

    <view wx:if="{{loginType === 'phone'}}" class="login-body quick-body">
      <image class="wechat-icon" src="/packages/business/assets/login-v1/wechat.png" mode="aspectFit" />
      <view class="login-title">微信授权登录</view>
      <view class="login-desc">授权后即可使用完整功能</view>

      <button wx:if="{{agreed}}" class="primary-btn" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber" loading="{{loading}}" disabled="{{loading}}">
        <view class="primary-inner">
          <image class="button-icon" src="/packages/business/assets/login-v1/smartphone.png" mode="aspectFit" />
          <text>手机号快捷登录</text>
        </view>
      </button>
      <button wx:else class="primary-btn" bindtap="onNeedAgreement" disabled="{{loading}}">
        <view class="primary-inner">
          <image class="button-icon" src="/packages/business/assets/login-v1/smartphone.png" mode="aspectFit" />
          <text>手机号快捷登录</text>
        </view>
      </button>

      <view class="agreement" bindtap="onToggleAgreement" hover-class="none" role="checkbox" aria-checked="{{agreed}}">
        <view class="agreement-check {{agreed ? 'is-checked' : ''}}"></view>
        <text>我已阅读并同意</text>
        <view class="legal-link" catchtap="onOpenLegalDoc" data-kind="user" hover-class="none">
          <text class="link">《用户协议》</text>
        </view>
        <view class="legal-link" catchtap="onOpenLegalDoc" data-kind="privacy" hover-class="none">
          <text class="link">《隐私政策》</text>
        </view>
        <text>和</text>
        <view class="legal-link" catchtap="onOpenLegalDoc" data-kind="disclaimer" hover-class="none">
          <text class="link">《免责协议》</text>
        </view>
      </view>
    </view>

    <view wx:else class="login-body password-body">
      <view class="field">
        <text class="label">账号 / 手机号</text>
        <input class="input" placeholder="请输入员工账号或手机号" placeholder-class="placeholder" bindinput="onInputUsername" value="{{username}}" />
      </view>

      <view class="field">
        <text class="label">密码</text>
        <input class="input" password placeholder="请输入登录密码" placeholder-class="placeholder" bindinput="onInputPassword" value="{{password}}" />
      </view>

      <button class="primary-btn password-btn {{(!username || !password || loading) ? 'disabled' : ''}}" bindtap="onPasswordLogin" loading="{{loading}}" disabled="{{!username || !password || loading}}">
        <text>立即登录</text>
      </button>

      <view class="staff-tip">
        <text class="tip-badge">i</text>
        <text class="tip-text">账号登录面向设计师、地推员等企业内部员工。</text>
      </view>
    </view>
  </view>

  <view class="feature-row">
    <view class="feature-item">
      <image class="feature-icon" src="/packages/business/assets/login-v1/measure.png" mode="aspectFit" />
      <view class="feature-copy">
        <view class="feature-title">精准量房</view>
        <view class="feature-desc">快速获取数据</view>
      </view>
    </view>
    <view class="feature-divider"></view>
    <view class="feature-item">
      <image class="feature-icon" src="/packages/business/assets/login-v1/ai.png" mode="aspectFit" />
      <view class="feature-copy">
        <view class="feature-title">AI设计</view>
        <view class="feature-desc">高效方案生成</view>
      </view>
    </view>
    <view class="feature-divider"></view>
    <view class="feature-item">
      <image class="feature-icon" src="/packages/business/assets/login-v1/images.png" mode="aspectFit" />
      <view class="feature-copy">
        <view class="feature-title">灵感图库</view>
        <view class="feature-desc">海量案例参考</view>
      </view>
    </view>
  </view>

  <view class="back-row" bindtap="onBack" role="button" aria-label="返回首页">
    <text>返回首页</text>
    <image class="back-chevron" src="/packages/business/assets/login-v1/chevron-right.png" mode="aspectFit" />
  </view>
</view>
