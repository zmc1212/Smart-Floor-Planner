.page{min-height:100vh;padding:0 24rpx 52rpx;box-sizing:border-box}.nav{display:flex;align-items:center;padding-bottom:14rpx;padding-left:2rpx;box-sizing:content-box;font-size:36rpx;font-weight:700}.back{display:flex;width:62rpx;height:62rpx;align-items:center;justify-content:center;flex:none}.back-chevron{width:16rpx;height:16rpx;border-top:3rpx solid #26312a;border-right:3rpx solid #26312a;transform:rotate(-135deg);box-sizing:border-box}.month{margin-left:auto;font-size:26rpx;font-weight:400}.week{display:flex;justify-content:space-around;padding:22rpx 0;font-size:22rpx;color:#6b7280}.list{display:flex;flex-direction:column;gap:16rpx}.appointment{padding:26rpx}.top{display:flex;justify-content:space-between;align-items:center}.time{font-size:28rpx;font-weight:700}.tag{font-size:22rpx;color:#168a3d;background:#eaf8ec;padding:6rpx 12rpx;border-radius:8rpx}.address{display:block;font-size:26rpx;margin-top:18rpx}.meta{display:block;color:#6b7280;font-size:22rpx;margin-top:10rpx}.state{text-align:center;padding:80rpx 0;color:#6b7280;font-size:26rpx}.unavailable{margin-top:28rpx;padding:24rpx;border-top:1rpx solid #e5e7eb;display:flex;align-items:center;justify-content:space-between;gap:20rpx;font-size:26rpx}.unavailable text{display:block}.unavailable text:last-child{font-size:22rpx;color:#6b7280;margin-top:8rpx}.unavailable-pressed{background:#f6fbf7}.unavailability-add{width:48rpx;height:48rpx;border:2rpx solid #22c55e;border-radius:50%;position:relative;flex:none;box-sizing:border-box}.unavailability-add::before,.unavailability-add::after{content:"";position:absolute;background:#22c55e;left:50%;top:50%;transform:translate(-50%,-50%)}.unavailability-add::before{width:20rpx;height:2rpx}.unavailability-add::after{width:2rpx;height:20rpx}
