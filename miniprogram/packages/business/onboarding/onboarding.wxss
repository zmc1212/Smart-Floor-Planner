page { height: 100%; overflow: hidden; background: #fbfdfb; }

.onboarding-page { display: flex; height: 100vh; flex-direction: column; color: #172019; background: linear-gradient(180deg, #f9fdf9 0%, #f3f8f3 100%); }
.onboarding-nav { position: relative; z-index: 2; display: flex; padding-left: 20rpx; padding-bottom: 14rpx; align-items: center; gap: 10rpx; box-sizing: content-box; }
.nav-back { display: flex; width: 72rpx; height: 72rpx; align-items: center; justify-content: center; border-radius: 50%; }
.nav-back:active { background: rgba(18, 137, 66, 0.09); }
.nav-back image { width: 30rpx; height: 30rpx; }
.nav-title { font-size: 30rpx; font-weight: 700; line-height: 1.2; }

.onboarding-scroll { min-height: 0; flex: 1; }
.onboarding-content { display: flex; min-height: 100%; padding: 20rpx 32rpx calc(36rpx + env(safe-area-inset-bottom)); flex-direction: column; box-sizing: border-box; }
.welcome-panel { position: relative; display: flex; min-height: 220rpx; padding: 28rpx 30rpx; overflow: hidden; align-items: center; border-radius: 24rpx; background: linear-gradient(135deg, #ddf6e4 0%, #edf9ef 65%, #f9fcf9 100%); box-shadow: 0 12rpx 34rpx rgba(62, 102, 70, 0.1); box-sizing: border-box; }
.welcome-copy { position: relative; z-index: 1; width: 62%; }
.role-tag { display: inline-flex; min-height: 44rpx; padding: 0 18rpx; align-items: center; border-radius: 22rpx; color: #087c36; background: rgba(255, 255, 255, 0.82); font-size: 22rpx; font-weight: 700; line-height: 44rpx; }
.welcome-title { margin-top: 16rpx; font-size: 36rpx; font-weight: 800; line-height: 1.25; }
.welcome-subtitle { margin-top: 8rpx; color: #53705a; font-size: 22rpx; line-height: 1.5; }
.guide-k { position: absolute; right: -14rpx; bottom: -14rpx; width: 230rpx; height: 230rpx; }

.role-section, .referrer-note { margin-top: 28rpx; padding: 26rpx 28rpx; border: 1rpx solid rgba(207, 225, 211, 0.92); border-radius: 22rpx; background: #ffffff; box-shadow: 0 8rpx 24rpx rgba(42, 72, 48, 0.06); }
.section-title { font-size: 28rpx; font-weight: 800; line-height: 1.35; }
.section-copy { margin-top: 8rpx; color: #657269; font-size: 22rpx; line-height: 1.55; }
.role-options { display: grid; margin-top: 22rpx; grid-template-columns: 1fr; gap: 14rpx; }
.role-option { position: relative; min-height: 126rpx; padding: 20rpx 74rpx 20rpx 20rpx; border: 2rpx solid #e1e9e2; border-radius: 16rpx; background: #fbfdfb; box-sizing: border-box; }
.role-option:active { opacity: 0.76; }
.role-option.is-selected { border-color: #22c55e; background: #f0fbf2; box-shadow: 0 7rpx 18rpx rgba(34, 197, 94, 0.1); }
.role-option-title { font-size: 26rpx; font-weight: 800; line-height: 1.35; }
.role-option-copy { margin-top: 6rpx; color: #68756c; font-size: 22rpx; line-height: 1.45; }
.selection-mark { position: absolute; top: 50%; right: 22rpx; display: flex; width: 34rpx; height: 34rpx; align-items: center; justify-content: center; border: 2rpx solid #b9c8bd; border-radius: 50%; transform: translateY(-50%); box-sizing: border-box; }
.is-selected .selection-mark { border-color: #19a94c; }
.selection-dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: #19a94c; }

.privacy-note { display: flex; margin: 22rpx 8rpx 0; align-items: flex-start; gap: 10rpx; color: #657269; font-size: 20rpx; line-height: 1.5; }
.privacy-mark { display: flex; width: 28rpx; height: 28rpx; margin-top: 1rpx; align-items: center; justify-content: center; flex: 0 0 auto; border-radius: 50%; background: #e5f7e9; }
.privacy-check { width: 12rpx; height: 7rpx; border-bottom: 3rpx solid #159447; border-left: 3rpx solid #159447; transform: translateY(-2rpx) rotate(-45deg); }
.join-action, .state-action { min-height: 92rpx; margin: 28rpx 0 0; border: 0; border-radius: 16rpx; color: #ffffff; background: linear-gradient(135deg, #0eb44d 0%, #079c3f 100%); box-shadow: 0 10rpx 22rpx rgba(10, 158, 65, 0.2); font-size: 28rpx; font-weight: 700; line-height: 92rpx; }
.join-action::after, .state-action::after { border: 0; }
.join-action:active, .state-action:active { opacity: 0.84; }
.join-action.is-disabled { background: #a9d9b8; box-shadow: none; }

.onboarding-state { display: flex; min-height: 0; padding: 22rpx 44rpx calc(36rpx + env(safe-area-inset-bottom)); align-items: center; justify-content: center; flex: 1; flex-direction: column; box-sizing: border-box; text-align: center; }
.resolving-ring { width: 92rpx; height: 92rpx; border: 8rpx solid #dff3e6; border-top-color: #0baa48; border-radius: 50%; animation: onboarding-spin 0.8s linear infinite; }
.state-title { margin-top: 22rpx; font-size: 32rpx; font-weight: 800; line-height: 1.3; }
.state-copy { max-width: 560rpx; margin-top: 12rpx; color: #68756c; font-size: 24rpx; line-height: 1.55; }
.success-mark { display: flex; width: 94rpx; height: 94rpx; align-items: center; justify-content: center; border-radius: 50%; background: #0eaf4a; box-shadow: 0 12rpx 28rpx rgba(14, 175, 74, 0.22); }
.success-check { width: 40rpx; height: 23rpx; border-bottom: 7rpx solid #ffffff; border-left: 7rpx solid #ffffff; transform: translateY(-5rpx) rotate(-45deg); }
.state-action { min-width: 280rpx; margin-top: 34rpx; }
.error-state > image { width: 88rpx; height: 88rpx; }

@keyframes onboarding-spin { to { transform: rotate(360deg); } }

@media (max-width: 360px) {
  .onboarding-content { padding-right: 26rpx; padding-left: 26rpx; }
  .welcome-panel { min-height: 204rpx; padding-right: 22rpx; padding-left: 22rpx; }
  .guide-k { right: -20rpx; width: 210rpx; height: 210rpx; }
  .role-section, .referrer-note { padding-right: 22rpx; padding-left: 22rpx; }
}
