<!--
  企业入驻页：遵循 miniprogram/DESIGN.md、app.wxss 的绿色操作型页面规范。
  小K在此处担任“入驻引导员”；只使用现有独立透明角色资产，不复用客户匿名领取页布局或文案。
-->
<view class="onboarding-page state-{{pageState}}">
  <view class="onboarding-nav" style="padding-top: {{navigationTop}}px; min-height: {{navigationHeight}}px; padding-right: {{navigationRight}}px;">
    <view class="nav-back" bindtap="onBack" aria-role="button" aria-label="返回">
      <image src="/images/back-arrow.png" mode="aspectFit" />
    </view>
    <view class="nav-title">加入企业</view>
  </view>

  <view wx:if="{{pageState === 'resolving'}}" class="onboarding-state">
    <view class="resolving-ring"></view>
    <view class="state-title">正在确认入驻码</view>
    <view class="state-copy">请稍候，正在校验本次企业入驻资格。</view>
  </view>

  <scroll-view wx:elif="{{pageState === 'ready' || pageState === 'submitting'}}" scroll-y class="onboarding-scroll">
    <view class="onboarding-content">
      <view class="welcome-panel">
        <view class="welcome-copy">
          <view class="role-tag">{{codeType === 'staff' ? '员工入驻' : '推荐人入驻'}}</view>
          <view class="welcome-title">欢迎加入服务协作</view>
          <view class="enterprise-target">
            <view class="enterprise-label">正在加入企业</view>
            <view class="enterprise-name">{{enterpriseName}}</view>
          </view>
          <view class="welcome-subtitle">完成手机号授权后，即可使用与你身份匹配的企业服务入口。</view>
        </view>
        <image class="guide-k" src="/packages/business/assets/referral-service-v1/thumbs-up-xiao-k.png" mode="aspectFit" aria-label="小K入驻引导" />
      </view>

      <view wx:if="{{codeType === 'staff'}}" class="role-section">
        <view class="section-title">选择你的岗位</view>
        <view class="section-copy">请选择实际承担的工作岗位；入驻后由企业管理员统一管理权限。</view>
        <view class="role-options">
          <view class="role-option {{selectedStaffRole === 'designer' ? 'is-selected' : ''}}" data-role="designer" bindtap="onChooseStaffRole" aria-role="radio" aria-checked="{{selectedStaffRole === 'designer'}}">
            <view class="role-option-title">设计师</view>
            <view class="role-option-copy">跟进客户需求，完成方案与预约服务</view>
            <view class="selection-mark"><view wx:if="{{selectedStaffRole === 'designer'}}" class="selection-dot"></view></view>
          </view>
          <view class="role-option {{selectedStaffRole === 'measurer' ? 'is-selected' : ''}}" data-role="measurer" bindtap="onChooseStaffRole" aria-role="radio" aria-checked="{{selectedStaffRole === 'measurer'}}">
            <view class="role-option-title">测量员</view>
            <view class="role-option-copy">接收量房安排，维护可服务时间</view>
            <view class="selection-mark"><view wx:if="{{selectedStaffRole === 'measurer'}}" class="selection-dot"></view></view>
          </view>
        </view>
      </view>

      <view wx:else class="referrer-note">
        <view class="section-title">成为企业推荐人</view>
        <view class="section-copy">入驻后可查看专属推广服务码、推广记录与对应提成信息。</view>
      </view>

      <view class="privacy-note">
        <view class="privacy-mark"><view class="privacy-check"></view></view>
        <view>手机号仅用于确认你的服务身份，不会向其他人员公开。</view>
      </view>

      <button class="join-action {{pageState === 'submitting' ? 'is-disabled' : ''}}" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber" loading="{{pageState === 'submitting'}}" disabled="{{pageState === 'submitting'}}">
        授权手机号并加入
      </button>
    </view>
  </scroll-view>

  <view wx:elif="{{pageState === 'success'}}" class="onboarding-state success-state">
    <view class="success-mark"><view class="success-check"></view></view>
    <view class="state-title">已加入企业</view>
    <view class="state-copy">你的{{joinedLabel}}身份已生效，现在可以进入对应工作台。</view>
    <button class="state-action" bindtap="onContinue">进入工作台</button>
  </view>

  <view wx:else class="onboarding-state error-state">
    <image src="/images/mine-icons/shield-check.png" mode="aspectFit" aria-label="入驻校验提示" />
    <view class="state-title">暂未完成入驻</view>
    <view class="state-copy">{{errorMessage}}</view>
    <button class="state-action" bindtap="onRetry">重新校验</button>
  </view>
</view>
