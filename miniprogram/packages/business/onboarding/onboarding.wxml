<!--
  企业入驻页：极简透气版 16/17 设计，胶囊安全品牌锁、角色选择与入驻恢复。
  小K 使用 referral-service-v1 独立透明资产；仍走既有 resolve / 授权 / 写入合同。
  FORM: design-references/miniprogram-airy-minimalist-v1/16-onboarding.jpg, 17-onboarding-recovery.jpg
-->
<view class="onboarding-page state-{{pageState}}">
  <view
    class="onboarding-nav"
    style="padding-top: {{navigationTop}}px; min-height: {{navigationHeight}}px; padding-right: {{navigationRight}}px;"
  >
    <view class="nav-back" bindtap="onBack" aria-role="button" aria-label="返回">
      <view class="back-chevron"></view>
    </view>
    <view class="brand-lockup">
      <image class="brand-logo" src="/images/home-ip-v1/brand-logo.png" mode="aspectFit" />
      <text class="brand-name">家客来</text>
      <view class="nav-divider"></view>
      <text class="nav-title">{{navTitle}}</text>
    </view>
  </view>

  <view wx:if="{{pageState === 'resolving'}}" class="onboarding-state">
    <view class="resolving-ring"></view>
    <view class="state-title">正在确认入驻码</view>
    <view class="state-copy">请稍候，正在校验本次企业入驻资格。</view>
  </view>

  <scroll-view wx:elif="{{pageState === 'ready' || pageState === 'submitting' || pageState === 'name'}}" scroll-y class="onboarding-scroll">
    <view class="onboarding-content">
      <view class="welcome-hero">
        <view class="hero-leaf hero-leaf-tl" aria-hidden="true"></view>
        <view class="hero-leaf hero-leaf-tr" aria-hidden="true"></view>
        <view class="hero-copy">
          <text class="welcome-title">欢迎加入服务团队</text>
          <text class="welcome-subtitle">完成身份选择后，即可开始服务客户</text>
        </view>
        <image
          class="guide-k"
          src="/packages/business/assets/referral-service-v1/xiao-k-onboarding-welcome-complete.png"
          mode="aspectFit"
          aria-label="小K入驻引导"
        />
      </view>

      <view wx:if="{{codeType === 'staff'}}" class="role-card">
        <view class="section-title">选择你的服务身份</view>
        <view class="role-options">
          <view
            class="role-option {{selectedStaffRole === 'designer' ? 'is-selected' : ''}}"
            data-role="designer"
            bindtap="onChooseStaffRole"
            aria-role="radio"
            aria-checked="{{selectedStaffRole === 'designer'}}"
          >
            <view class="role-icon">
              <image src="/packages/business/assets/referral-service-v1/designer-service.png" mode="aspectFit" />
            </view>
            <view class="role-text">
              <view class="role-option-title">家装设计顾问</view>
              <view class="role-option-copy">承接客户沟通与方案服务</view>
            </view>
            <view class="selection-mark"><view wx:if="{{selectedStaffRole === 'designer'}}" class="selection-dot"></view></view>
          </view>
          <view
            class="role-option {{selectedStaffRole === 'measurer' ? 'is-selected' : ''}}"
            data-role="measurer"
            bindtap="onChooseStaffRole"
            aria-role="radio"
            aria-checked="{{selectedStaffRole === 'measurer'}}"
          >
            <view class="role-icon">
              <image src="/packages/business/assets/referral-service-v1/onsite-measurement.png" mode="aspectFit" />
            </view>
            <view class="role-text">
              <view class="role-option-title">家装现场顾问</view>
              <view class="role-option-copy">承接上门量房与户型建立</view>
            </view>
            <view class="selection-mark"><view wx:if="{{selectedStaffRole === 'measurer'}}" class="selection-dot"></view></view>
          </view>
        </view>
        <view class="enterprise-pill">
          <image class="pill-icon" src="/images/home-ip-v1/brand-logo.png" mode="aspectFit" />
          <text>将加入：<text class="pill-name">{{enterpriseName}}</text></text>
        </view>
      </view>

      <view wx:else class="role-card">
        <view class="section-title">成为企业推荐人</view>
        <view class="section-copy">入驻后可查看专属推广服务码、推广记录与对应提成信息。</view>
        <view class="enterprise-pill">
          <image class="pill-icon" src="/images/home-ip-v1/brand-logo.png" mode="aspectFit" />
          <text>将加入：<text class="pill-name">{{enterpriseName}}</text></text>
        </view>
      </view>

      <view class="privacy-note">
        <view class="privacy-mark"><view class="privacy-check"></view></view>
        <text>授权手机号后创建你的服务身份</text>
      </view>

      <button
        class="join-action {{pageState === 'submitting' ? 'is-disabled' : ''}}"
        open-type="getPhoneNumber"
        bindgetphonenumber="onGetPhoneNumber"
        loading="{{pageState === 'submitting' && !nameSheetVisible}}"
        disabled="{{pageState === 'submitting' || nameSheetVisible}}"
      >
        <view class="join-inner">
          <image class="join-shield" src="/images/mine-icons/shield-check.png" mode="aspectFit" />
          <text>授权手机号并加入</text>
        </view>
      </button>

      <view class="identity-link" bindtap="onOpenIdentitySwitch" aria-role="button">
        <text>切换身份后可在我的页面管理</text>
        <view class="link-chevron"></view>
      </view>
    </view>
  </scroll-view>

  <view wx:elif="{{pageState === 'recovery'}}" class="onboarding-recovery">
    <view class="recovery-hero">
      <view class="hero-leaf hero-leaf-tl" aria-hidden="true"></view>
      <view class="hero-leaf hero-leaf-tr" aria-hidden="true"></view>
      <view class="hero-copy">
        <text class="recovery-title">当前邀请暂不可用</text>
        <text class="recovery-subtitle">{{errorMessage || '可能已失效、停用或与当前身份不匹配'}}</text>
      </view>
      <image
        class="guide-k"
        src="/packages/business/assets/referral-service-v1/xiao-k-onboarding-recovery.png"
        mode="aspectFit"
        aria-label="小K入驻引导"
      />
    </view>

    <view class="recovery-card">
      <view class="section-title">选择恢复方式</view>
      <view class="recovery-option">
        <view class="recovery-icon"><view class="icon-clock"></view></view>
        <view class="recovery-text">
          <text class="recovery-option-title">邀请已失效</text>
          <text class="recovery-option-copy">请联系服务团队获取新邀请</text>
        </view>
        <view class="option-chevron"></view>
      </view>
      <view class="recovery-option" bindtap="onOpenIdentitySwitch" aria-role="button">
        <view class="recovery-icon"><view class="icon-person"></view></view>
        <view class="recovery-text">
          <text class="recovery-option-title">当前身份不可用</text>
          <text class="recovery-option-copy">可切换其他可用身份</text>
        </view>
        <view class="option-chevron"></view>
      </view>
      <view class="recovery-option" bindtap="onScanNewInvite" aria-role="button">
        <view class="recovery-icon"><view class="icon-scan"></view></view>
        <view class="recovery-text">
          <text class="recovery-option-title">换码继续入驻</text>
          <text class="recovery-option-copy">扫描新的有效邀请</text>
        </view>
        <view class="option-chevron"></view>
      </view>
    </view>

    <button class="join-action recovery-scan" bindtap="onScanNewInvite">
      <view class="join-inner">
        <image class="join-action-icon" src="/images/mine-icons/scan.png" mode="aspectFit" />
        <text>扫描新邀请</text>
      </view>
    </button>
    <button class="join-action-outline" bindtap="onOpenIdentitySwitch">
      <view class="join-inner">
        <image class="join-action-icon outline" src="/images/mine-icons/users.png" mode="aspectFit" />
        <text>切换可用身份</text>
      </view>
    </button>
    <view class="recovery-help">
      <image src="/images/mine-icons/bell.png" mode="aspectFit" />
      <text>如需协助，请联系邀请方</text>
    </view>
  </view>

  <view wx:elif="{{pageState === 'success'}}" class="onboarding-state success-state">
    <view class="success-mark"><view class="success-check"></view></view>
    <view class="state-title">已加入企业</view>
    <view class="state-copy">你的{{joinedLabel}}身份已生效，现在可以进入对应工作台。</view>
    <button class="state-action" bindtap="onContinue">进入工作台</button>
  </view>

  <view wx:else class="onboarding-state error-state">
    <image src="/images/mine-icons/shield-check.png" mode="aspectFit" aria-label="入驻校验提示" />
    <view class="state-title">暂未完成入驻</view>
    <view class="state-copy">{{errorMessage}}</view>
    <button class="state-action" bindtap="onRetry">重新校验</button>
  </view>

  <view wx:if="{{nameSheetVisible}}" class="name-overlay" catchtouchmove="preventMove">
    <view class="name-card">
      <view class="section-title">设置推荐人姓名</view>
      <view class="section-copy">企业会用这个姓名识别你，请填写真实姓名。</view>
      <input class="name-input" value="{{displayName}}" maxlength="30" placeholder="请输入真实姓名" placeholder-class="name-placeholder" bindinput="onDisplayNameInput" />
      <view class="name-counter">{{displayName.length}} / 30</view>
      <button class="join-action {{pageState === 'submitting' ? 'is-disabled' : ''}}" loading="{{pageState === 'submitting'}}" disabled="{{pageState === 'submitting'}}" bindtap="onConfirmReferrerName">确认加入</button>
    </view>
  </view>
</view>
