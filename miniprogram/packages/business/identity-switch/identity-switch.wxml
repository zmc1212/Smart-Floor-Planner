<!--
THESIS: 身份切换是查看完整岗位名称并确认去向的档案柜，不再以横滑小卡牺牲阅读。
OWN-WORLD: 暖白纸面、家客来绿和一处轻量的档案管理员小 K 场景；岗位工具插画只服务识别，不替代文字。
STORY: 用户先看清每个可用身份及其工作范围，点选卡片预览，再确认进入对应区域；单身份不制造无意义的切换动作。
FIRST VIEWPORT: 顶部是紧凑的小 K 身份档案提示，随后为双列可读身份卡片；当前身份以绿色边框和状态签确认，主操作位于卡片后。
FORM: 已批准的双列档案卡方案；原生文本完整呈现岗位名，使用独立透明岗位工具 PNG，不切片复用设计稿。
-->
<view class="account-page identity-page identity-lobby">
  <view wx:if="{{loading}}" class="state-message">正在读取可用身份…</view>
  <view wx:elif="{{error}}" class="state-message">
    {{error}}
    <view wx:if="{{sessionExpired}}" class="state-retry" bindtap="goToLogin" aria-role="button">重新登录</view>
    <view wx:else class="state-retry" bindtap="load" aria-role="button">重新加载</view>
  </view>

  <view wx:elif="{{selectedContext}}" class="identity-selector">
    <view class="identity-intro">
      <view class="intro-copy">
        <text class="intro-title">小K的身份档案管理员</text>
        <text class="intro-detail">选择身份，进入对应工作区域</text>
      </view>
      <view class="intro-art-stage" aria-hidden="true">
        <view class="intro-folder-back"></view>
        <view class="intro-folder-front"></view>
        <image class="intro-character" src="{{selectedContext.icon}}" mode="aspectFit"></image>
      </view>
    </view>

    <view wx:if="{{contexts.length > 1}}" class="identity-section">
      <text class="identity-section-title">选择要进入的身份</text>
      <text class="identity-section-helper">每张卡都会完整显示身份名称</text>
      <view class="role-grid">
        <view
          wx:for="{{contexts}}"
          wx:key="contextKey"
          class="role-card {{item.selected ? 'role-card-selected' : ''}}"
          data-context="{{item}}"
          bindtap="selectIdentity"
          hover-class="role-card-pressed"
          aria-role="button"
          aria-label="选择{{item.roleLabel}}身份"
        >
          <text wx:if="{{item.current}}" class="role-card-status">当前使用</text>
          <view class="role-card-art-wrap" aria-hidden="true">
            <image class="role-card-art" src="{{item.cardArt}}" mode="aspectFit"></image>
          </view>
          <view class="role-card-copy">
            <text class="role-card-label">{{item.roleLabel}}</text>
            <text class="role-card-detail">{{item.current ? item.title : item.cardHelper}}</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:else class="single-identity-note">当前账号只有一个有效身份，暂时无需切换。</view>

    <text wx:if="{{contexts.length > 1}}" class="identity-helper">点击卡片选择身份</text>
    <button
      wx:if="{{contexts.length > 1}}"
      class="identity-confirm"
      disabled="{{selectedContext.current || switchingKey}}"
      bindtap="confirmSelectedIdentity"
      aria-label="{{selectedContext.current ? '当前身份' : '确认切换身份'}}"
    >{{switchingKey ? '切换中…' : (selectedContext.current ? '当前身份' : '确认切换')}}</button>
    <text wx:else class="identity-helper">返回“我的”可继续管理账号</text>
  </view>
</view>
