@import "../account-common.wxss";
.identity-page .account-section-title{margin-top:54rpx}.identity-list{display:flex;flex-direction:column;gap:18rpx}.identity-item{display:flex;min-height:132rpx;padding:20rpx 28rpx;align-items:center;gap:22rpx;border:1rpx solid transparent;border-radius:30rpx;background:#fff;box-shadow:0 14rpx 34rpx rgba(42,68,51,.07);box-sizing:border-box}.identity-pressed{background:#f2faf5}.identity-current{border-color:rgba(15,172,88,.28);background:#f0faf3}.identity-mark{display:flex;width:62rpx;height:62rpx;align-items:center;justify-content:center;flex:none;border-radius:20rpx;color:#0a8e49;background:#ddf5e5;font-size:28rpx;font-weight:700}.identity-copy{min-width:0;flex:1}.identity-title,.identity-detail{display:block}.identity-title{color:#222522;font-size:29rpx;font-weight:600}.identity-detail{margin-top:7rpx;color:#858c87;font-size:22rpx;line-height:1.45}.identity-status{padding:7rpx 15rpx;border-radius:99rpx;color:#0b9850;background:#dcf4e3;font-size:22rpx;font-weight:600}.identity-status.pending{color:#6e766f;background:#eef1ef}.single-note{margin:28rpx 10rpx 0;color:#7d847f;font-size:22rpx;line-height:1.6}
