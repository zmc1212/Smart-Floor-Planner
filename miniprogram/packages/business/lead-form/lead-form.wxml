<view class="lead-page">
  <view class="content-shell">
      <view class="lead-intake-hero">
        <view class="lead-intake-copy">
          <view class="lead-intake-title" wx:if="{{!isEditMode}}">让<text>家</text>更懂你</view>
          <view class="lead-intake-title" wx:else>完善<text>客户</text>资料</view>
          <view class="lead-intake-subtitle">{{isEditMode ? '补充小区、面积和风格，方便后续服务跟进' : '完善资料，获得更精准的服务与方案'}}</view>
        </view>
        <image class="lead-intake-scene" src="/packages/business/assets/leads/lead-form.png" mode="aspectFit"></image>
      </view>

      <block wx:if="{{!isEditMode}}">
      <view class="recent-head">
        <text class="recent-title">最近客户</text>
        <view class="refresh-action" bindtap="onRefreshRecent">
          <text class="refresh-icon">↻</text>
          <text>换一批</text>
        </view>
      </view>

      <view class="recent-list">
        <view
          wx:for="{{recentLeadChips}}"
          wx:key="name"
          class="recent-chip"
          data-index="{{index}}"
          bindtap="onSelectRecentLead"
        >
          <image wx:if="{{item.fullImage}}" class="recent-chip-image" src="{{item.fullImage}}" mode="aspectFill"></image>
          <block wx:else>
            <image class="recent-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
            <text class="recent-name">{{item.name}}</text>
          </block>
        </view>
      </view>

      <view class="section-divider"></view>
      </block>

      <view class="form-panel">
        <view class="form-group">
          <text class="label">客户称呼 <text class="required">*</text></text>
          <view class="input-shell">
            <view class="field-icon person-icon"></view>
            <input class="input" placeholder="请输入称呼，如：张先生" placeholder-class="placeholder" value="{{formData.name}}" data-field="name" bindinput="onInput" />
          </view>
        </view>

        <view class="form-group">
          <text class="label">手机号码 <text class="required">*</text></text>
          <view class="input-shell">
            <view class="field-icon phone-icon"></view>
            <input class="input" type="number" placeholder="请输入手机号" placeholder-class="placeholder" value="{{formData.phone}}" data-field="phone" bindinput="onInput" />
          </view>
        </view>

        <view class="form-group">
          <text class="label">小区名称 <text class="required">*</text></text>
          <view class="input-shell">
            <view class="field-icon building-icon"></view>
            <input class="input input-with-location" maxlength="160" placeholder="请输入小区名称" placeholder-class="placeholder" value="{{formData.communityName}}" data-field="communityName" bindinput="onInput" />
            <view class="location-action sfp-icon-action" catchtap="chooseCommunityLocation" hover-class="location-action-pressed" aria-role="button" aria-label="在地图上选择小区">
              <image class="sfp-icon-action__icon" src="/images/leads-v4/map-pin.png" mode="aspectFit" />
              <text>选择地点</text>
            </view>
          </view>
        </view>

        <view class="form-group">
          <text class="label">房屋面积</text>
          <view class="input-shell">
            <view class="field-icon area-icon">㎡</view>
            <input class="input input-with-unit" type="digit" placeholder="请输入房屋面积" placeholder-class="placeholder" value="{{formData.area}}" data-field="area" bindinput="onInput" />
            <text class="unit">m²</text>
          </view>
        </view>

        <view class="form-group">
          <text class="label">意向风格</text>
          <picker mode="selector" range="{{styleOptions}}" bindchange="onStyleChange">
            <view class="input-shell picker-shell">
              <view class="field-icon style-icon"></view>
              <text class="picker-text {{formData.stylePreference ? '' : 'placeholder-text'}}">{{formData.stylePreference || '请选择意向风格'}}</text>
              <text class="picker-arrow">›</text>
            </view>
          </picker>
        </view>

        <view wx:if="{{isEditMode}}" class="service-needs-form-group">
          <text class="label">服务需求记录</text>
          <text class="service-needs-helper">家装设计顾问可根据微信沟通结果补充，客户首页仅展示已记录状态</text>
          <view class="service-needs-form-options">
            <view
              wx:for="{{serviceNeedOptions}}"
              wx:key="key"
              class="service-needs-form-option {{item.selected ? 'is-selected' : ''}}"
              data-key="{{item.key}}"
              bindtap="onToggleServiceNeed"
              hover-class="service-needs-form-option-pressed"
              aria-role="checkbox"
              aria-checked="{{item.selected}}"
            >
              <view class="service-needs-form-check" aria-hidden="true">
                <view wx:if="{{item.selected}}" class="service-needs-form-checkmark"></view>
              </view>
              <text>{{item.label}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="submit-wrap">
        <button class="submit-btn" hover-class="submit-btn-hover" bindtap="onSubmit" loading="{{loading || pageLoading}}" disabled="{{loading || pageLoading}}">
          {{submitLabel}}
        </button>
        <view class="privacy-note">
          <image class="privacy-icon" src="/packages/business/assets/leads/lead-privacy-icon.png" mode="widthFix"></image>
          <text>我们将严格保护您的隐私信息，仅用于家装服务</text>
        </view>
      </view>
    </view>
</view>
