<view class="service-code-page">
<view
class="service-nav"
style="padding-top: {{navigationTop}}px; min-height: {{navigationHeight}}px; padding-right: {{navigationRight}}px;"
>
<view class="nav-back" bindtap="onBack" aria-role="button" aria-label="返回首页">
<view class="back-chevron"></view>
</view>
<view class="brand-lockup">
<image class="brand-logo" src="/images/home-ip-v1/brand-logo.png" mode="aspectFit" />
<text class="brand-name">家客来</text>
<view class="nav-divider"></view>
<text class="nav-title">出示入驻码</text>
</view>
</view>
<scroll-view class="service-code-scroll" scroll-y>
<view class="service-code-content">
<view class="code-tabs {{tabs.length === 1 ? 'single' : ''}}">
<view
wx:for="{{tabs}}"
wx:key="codeType"
class="code-tab {{activeType === item.codeType ? 'active' : ''}}"
data-type="{{item.codeType}}"
bindtap="selectTab"
aria-role="button"
aria-label="切换至{{item.label}}"
>
<text>{{item.label}}</text>
</view>
</view>
<view class="code-invitation-card">
<view class="hero-leaf hero-leaf-tl" aria-hidden="true"></view>
<view class="hero-leaf hero-leaf-br" aria-hidden="true"></view>
<view class="hero-copy-group">
<text wx:if="{{enterpriseName}}" class="hero-enterprise">{{enterpriseName}}</text>
<text class="hero-title">{{activeCopy.title}}</text>
<text class="hero-subtitle">{{activeCopy.subtitle}}</text>
</view>
<view class="qr-presentation">
<view class="qr-stage">
<view wx:if="{{loading}}" class="qr-loading">
<view class="qr-loading-grid"></view>
<text class="qr-state-copy">入驻码加载中</text>
</view>
<view wx:elif="{{!hasActive}}" class="qr-error">
<image src="/images/mine-icons/shield-check.png" mode="aspectFit" />
<text class="qr-state-title">暂无生效入驻码</text>
<text class="qr-state-copy">{{activeCopy.emptyHint}}</text>
</view>
<view wx:elif="{{errorMessage}}" class="qr-error">
<image src="/images/mine-icons/shield-check.png" mode="aspectFit" />
<text class="qr-state-title">入驻码暂不可用</text>
<text class="qr-state-copy">{{errorMessage}}</text>
<button class="qr-retry" bindtap="onRetry" disabled="{{acting}}">重新查看</button>
</view>
<image wx:else class="service-qr" src="{{qrImagePath}}" mode="aspectFit" show-menu-by-longpress />
</view>
<view class="scan-guide" aria-hidden="true">
<image class="guide-xiaok" src="/packages/business/assets/code-presenter-v3/xiao-k-scan-presenter.png" mode="aspectFit" />
<view class="scan-plaque">
<image class="scan-glyph" src="/packages/business/assets/code-presenter-v2/scan-frame.png" mode="aspectFit" />
<text class="scan-plaque-text">请扫码</text>
</view>
</view>
</view>
<text class="scan-copy">{{activeCopy.scanCopy}}</text>
</view>
<view class="journey-rail">
<view class="journey-item" wx:for="{{activeCopy.promises}}" wx:key="title">
<view class="journey-icon"><image src="/packages/business/assets/code-presenter-v3/{{item.icon}}" mode="aspectFit" /></view>
<text class="journey-title">{{item.title}}</text>
<text class="journey-copy">{{item.copy}}</text>
</view>
</view>
<view class="info-bar">
<image class="info-shield" src="/images/mine-icons/shield-check.png" mode="aspectFit" />
<text class="info-copy">{{hasActive ? activeCopy.info : '查看不会换新；换新后旧码立即失效'}}</text>
</view>
<view
class="roster-link"
bindtap="openReferrerRoster"
aria-role="button"
aria-label="{{rosterLinkLabel}}"
>
<text>{{rosterLinkLabel}}</text>
</view>
<view class="action-dock">
<button wx:if="{{canShare}}" class="share-action" open-type="share" hover-class="share-action-pressed" aria-label="一键分享当前入驻码">
<view class="share-inner">
<image class="share-scan" src="/packages/business/assets/code-presenter-v2/scan-frame.png" mode="aspectFit" aria-hidden="true" />
<text>{{activeCopy.shareLabel}}</text>
</view>
</button>
<view wx:if="{{!hasActive}}" class="manage-actions">
<button class="manage-primary" loading="{{acting}}" disabled="{{acting || loading}}" bindtap="onGenerate" hover-class="manage-pressed">生成入驻码</button>
</view>
<view wx:else class="manage-actions split">
<button class="manage-secondary" loading="{{acting}}" disabled="{{acting || loading}}" bindtap="onRotate" hover-class="manage-pressed">换新</button>
<button class="manage-danger" loading="{{acting}}" disabled="{{acting || loading}}" bindtap="onDisable" hover-class="manage-pressed">停用</button>
</view>
</view>
</view>
</scroll-view>
</view>
