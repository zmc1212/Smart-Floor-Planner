<!--
THESIS: 推广人客户页用档案簿识别脱敏推荐客户，拒绝把撤回做成文字链。
OWN-WORLD: 家客来薄荷绿 Hero、小K客户管家、实底绿撤回胶囊。
STORY: 用记录编号认出客户、看服务阶段、必要时撤回。
FIRST VIEWPORT: 胶囊左侧「客户」、Hero+小K、客户卡与实底撤回。
FORM: design-references/referrer-customers-v1/referrer-customers-v1.png
-->
<view class="portal-page sfp-page">
  <view
    class="portal-nav"
    style="padding-top: {{navigationTop}}px; min-height: {{navigationHeight}}px; padding-right: {{navigationRight}}px;"
  >
    <text class="nav-title">客户</text>
  </view>

  <view class="customers-hero sfp-hero-card">
    <view class="hero-copy">
      <text class="hero-title">我的推荐客户</text>
      <text class="hero-helper">用记录编号识别客户，不展示姓名和电话。</text>
      <text wx:if="{{enterpriseName}}" class="enterprise-name">{{enterpriseName}}</text>
    </view>
    <image
      class="hero-mascot"
      src="/packages/business/assets/referrer-customers-v1/xiao-k-customer-dossier.png"
      mode="aspectFit"
    />
  </view>

  <view wx:if="{{loading}}" class="state-card sfp-card">正在读取客户…</view>
  <view wx:elif="{{error}}" class="state-card sfp-card">
    <text>{{error}}</text>
    <button class="retry" bindtap="load">重新加载</button>
  </view>
  <view wx:elif="{{!items.length}}" class="state-card sfp-card">
    <text class="empty-title">还没有推荐客户</text>
    <text class="empty-copy">出示服务码后，客户会以记录编号出现在这里。</text>
    <button class="return-action sfp-primary-action" bindtap="backToPromotion">出示服务码</button>
  </view>
  <view wx:else class="fact-list">
    <view
      wx:for="{{items}}"
      wx:key="id"
      class="fact-card customer-file sfp-card {{item.terminationType ? 'fact-card-withdrawn' : ''}}"
    >
      <view class="fact-top">
        <view>
          <text class="customer-label">{{item.recordCode}}</text>
          <text class="customer-secondary">{{item.customerLabel}}</text>
        </view>
        <text class="updated">{{item.createdLabel}}</text>
      </view>
      <view class="file-action">
        <view class="stage-line">
          <view class="stage-dot {{item.terminationType ? 'withdrawn' : ''}}"></view>
          <text>{{item.stage.label}}</text>
        </view>
        <button
          wx:if="{{item.canWithdraw}}"
          class="withdraw-btn"
          data-item="{{item}}"
          bindtap="withdrawLead"
          hover-class="withdraw-btn-pressed"
        >撤回</button>
        <button
          wx:if="{{item.canUndo}}"
          class="restore-btn"
          data-item="{{item}}"
          bindtap="undoWithdrawal"
          hover-class="restore-btn-pressed"
        >恢复</button>
      </view>
      <text wx:if="{{item.terminationType}}" class="withdrawn-copy">{{item.withdrawnLabel}}</text>
      <text wx:if="{{item.canUndo}}" class="countdown-copy">{{item.countdownLabel}}</text>
    </view>
  </view>
</view>
<custom-tab-bar />
