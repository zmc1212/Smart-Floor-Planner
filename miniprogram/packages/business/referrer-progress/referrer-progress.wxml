<view class="portal-page sfp-page"><view class="portal-nav" style="padding-top: {{navigationTop}}px; min-height: {{navigationHeight}}px; padding-right: {{navigationRight}}px;"><text class="nav-title">服务进度</text></view><view class="portal-intro sfp-hero-card"><text class="intro-title">当前企业的服务事实</text><text class="intro-copy">用记录编号和建档时间识别线索，不展示个人信息。</text><text wx:if="{{enterpriseName}}" class="enterprise-name">{{enterpriseName}}</text></view><view wx:if="{{loading}}" class="state-card sfp-card">正在读取服务进度…</view><view wx:elif="{{error}}" class="state-card sfp-card"><text>{{error}}</text><button class="retry" bindtap="load">重新加载</button></view><view wx:elif="{{!items.length}}" class="state-card sfp-card"><text class="empty-title">暂时还没有可展示的服务事实</text><text class="empty-copy">客户领取服务后，阶段会在这里更新。</text><button class="return-action sfp-primary-action" bindtap="backToPromotion">返回推广</button></view><view wx:else class="fact-list"><view wx:for="{{items}}" wx:key="id" class="fact-card sfp-card {{item.terminationType ? 'fact-card-withdrawn' : ''}}"><view class="fact-top"><view><text class="customer-label">{{item.recordCode}}</text><text class="customer-secondary">{{item.customerLabel}}</text></view><text class="updated">{{item.createdLabel}}</text></view><view class="stage-line"><view class="stage-dot {{item.terminationType ? 'withdrawn' : ''}}"></view><text>{{item.stage.label}}</text></view><text wx:if="{{item.terminationType}}" class="withdrawn-copy">{{item.terminationNote || '测试记录'}} · 已撤销</text><button wx:if="{{item.canWithdraw}}" class="withdraw-action" data-item="{{item}}" bindtap="withdrawLead">··· 撤销测试线索</button><view wx:if="{{item.canUndo}}" class="undo-row"><text>{{item.countdownLabel}}</text><button class="undo-action" data-item="{{item}}" bindtap="undoWithdrawal">撤回撤销</button></view></view></view></view>
<custom-tab-bar />
