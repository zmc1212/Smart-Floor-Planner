.container {
  min-height: 100vh;
  background:
    linear-gradient(180deg, #fcfdfb 0%, #f5f7f4 46%, var(--bg-page) 100%);
  padding: 20rpx 20rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.detail-hero,
.empty-state,
.kujiale-panel,
.template-item,
.room-item,
.summary-card,
.whole-home-card {
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(207, 220, 207, 0.55);
  border-radius: 22rpx;
  box-shadow: var(--shadow-home-card);
  box-sizing: border-box;
}

.detail-hero {
  min-height: 220rpx;
  padding: 28rpx 26rpx;
  margin-bottom: 16rpx;
  background:
    radial-gradient(circle at 82% 18%, rgba(168, 230, 191, 0.34) 0%, rgba(168, 230, 191, 0) 34%),
    linear-gradient(135deg, #eff9ef 0%, #edf8f2 48%, #f9fbf9 100%);
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  overflow: hidden;
}

/* all-pages-ip-v3 / 08-lead-detail */
.detail-hero {
  position: relative;
  min-height: 286rpx;
  padding: 42rpx 28rpx 30rpx;
  background: linear-gradient(128deg, #0f9f4e 0%, #1fba61 48%, #eef7ed 48%, #f8fbf7 100%);
}

.detail-hero .eyebrow,
.detail-hero .title,
.detail-hero .info {
  color: #fff;
}

.detail-hero .hero-copy {
  width: 48%;
  position: relative;
  z-index: 2;
}

.lead-detail-scene {
  position: absolute;
  right: -4rpx;
  bottom: -6rpx;
  width: 390rpx;
  height: 278rpx;
}

.lead-status-summary {
  display: flex;
  align-items: flex-start;
  margin-top: 16rpx;
}

.lead-status-summary .status-pill {
  position: static;
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  color: #147b3a;
  background: rgba(255, 255, 255, 0.9);
}

.lead-stage-rail {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 8rpx;
  padding: 20rpx 8rpx 18rpx;
  margin-bottom: 16rpx;
  background: #ffffff;
  border: 1rpx solid rgba(207, 220, 207, 0.6);
  border-radius: 18rpx;
}

.lead-stage-item {
  position: relative;
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  color: #9aa1aa;
  font-size: 22rpx;
  line-height: 1.25;
  text-align: center;
}

.lead-stage-item:not(:last-child)::after {
  content: '';
  position: absolute;
  top: 10rpx;
  left: calc(50% + 16rpx);
  width: calc(100% - 32rpx);
  height: 2rpx;
  background: #e5ebe5;
}

.lead-stage-dot {
  position: relative;
  z-index: 1;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #e5ebe5;
  box-sizing: border-box;
}

.lead-stage-item.state-done,
.lead-stage-item.state-current {
  color: #147b3a;
}

.lead-stage-item.state-done .lead-stage-dot,
.lead-stage-item.state-current .lead-stage-dot {
  background: #22c55e;
}

.lead-stage-item.state-current {
  font-weight: 600;
}

.appointment-entry {
  display: flex;
  margin: 20rpx 28rpx 0;
  padding: 24rpx;
  align-items: center;
  gap: 20rpx;
  border: 1rpx solid #dbe9de;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(24, 107, 54, 0.06);
}

.appointment-entry-copy { min-width: 0; flex: 1; }

.appointment-entry-title {
  display: block;
  color: #253128;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
}

.appointment-entry-note {
  display: block;
  margin-top: 7rpx;
  color: #68756c;
  font-size: 22rpx;
  line-height: 1.45;
}

.appointment-entry-action {
  min-width: 180rpx;
  min-height: 68rpx;
  margin: 0;
  padding: 0 16rpx;
  border: 0;
  border-radius: 14rpx;
  color: #ffffff;
  background: #0aa447;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 68rpx;
}

.appointment-entry-action::after { border: 0; }

.appointment-entry-action-secondary {
  color: #087c36;
  background: #e9f8ed;
}

.conversion-card {
  margin-bottom: 18rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(87, 174, 110, 0.28);
  border-radius: 22rpx;
  background: #f1f9f3;
  box-sizing: border-box;
}

.conversion-card-heading,
.conversion-summary-row,
.conversion-sheet-header,
.conversion-sheet-actions,
.conversion-amount-control,
.conversion-field-control {
  display: flex;
  align-items: center;
}

.conversion-card-heading,
.conversion-sheet-header,
.conversion-summary-row,
.conversion-field-control {
  justify-content: space-between;
}

.conversion-card-copy {
  min-width: 0;
  display: flex;
  flex: 1;
  flex-direction: column;
}

.conversion-card-title {
  color: #1f2c22;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.3;
}

.conversion-card-subtitle {
  margin-top: 6rpx;
  color: #647168;
  font-size: 22rpx;
  line-height: 1.45;
}

.conversion-status {
  flex-shrink: 0;
  margin-left: 18rpx;
  padding: 8rpx 18rpx;
  border-radius: var(--radius-full);
  color: #147b3a;
  background: #dff5e5;
  font-size: 22rpx;
  font-weight: 600;
}

.conversion-primary-action,
.conversion-sheet-primary,
.conversion-sheet-secondary,
.conversion-sheet-danger,
.conversion-revert-action {
  margin: 0;
  border: 0;
  font-size: 26rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.conversion-primary-action {
  width: 100%;
  height: 82rpx;
  margin-top: 22rpx;
  border-radius: 16rpx;
  color: #ffffff;
  background: #18a94b;
  line-height: 82rpx;
}

.conversion-primary-action::after,
.conversion-sheet-primary::after,
.conversion-sheet-secondary::after,
.conversion-sheet-danger::after,
.conversion-revert-action::after {
  border: 0;
}

.conversion-summary {
  margin-top: 18rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(87, 174, 110, 0.2);
}

.conversion-summary-row {
  min-height: 54rpx;
  gap: 20rpx;
  color: #68746b;
  font-size: 24rpx;
  line-height: 1.4;
}

.conversion-summary-row text:last-child {
  color: #253128;
  text-align: right;
}

.conversion-summary-note {
  margin-top: 10rpx;
  padding: 16rpx;
  border-radius: 14rpx;
  color: #425048;
  background: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
  line-height: 1.5;
}

.conversion-revert-action {
  min-height: 72rpx;
  margin-top: 10rpx;
  padding: 0 8rpx;
  color: #c23a3a;
  background: transparent;
  line-height: 72rpx;
}

.acquisition-info {
  margin-bottom: 18rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(207, 220, 207, 0.55);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: var(--shadow-home-card);
  box-sizing: border-box;
}

.acquisition-info-heading,
.acquisition-info-row,
.acquisition-info-actions {
  display: flex;
  align-items: center;
}

.acquisition-info-heading {
  justify-content: space-between;
  gap: 18rpx;
}

.acquisition-info-title {
  color: #202a23;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.3;
}

.acquisition-info-subtitle {
  margin-top: 5rpx;
  color: #7b857e;
  font-size: 20rpx;
  line-height: 1.35;
}

.acquisition-info-status {
  min-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 22rpx;
  color: #9a6a14;
  background: #fff5db;
  font-size: 20rpx;
  line-height: 44rpx;
}

.acquisition-info-status.is-confirmed {
  color: #177a3f;
  background: #e9f8ee;
}

.acquisition-info-grid {
  margin-top: 18rpx;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  background: #f7f9f7;
}

.acquisition-info-row {
  min-height: 54rpx;
  justify-content: space-between;
  gap: 20rpx;
  color: #667169;
  font-size: 24rpx;
  line-height: 1.4;
}

.acquisition-info-row text:last-child {
  color: #2f3932;
  text-align: right;
}

.acquisition-info-actions {
  min-height: 70rpx;
  margin-top: 8rpx;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 8rpx 24rpx;
}

.acquisition-info-link {
  min-height: 64rpx;
  color: #218249;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 64rpx;
}

.whole-home-card {
  position: relative;
  padding-top: 76rpx;
  overflow: visible;
}

.whole-home-tab {
  position: absolute;
  top: -1rpx;
  left: -1rpx;
  height: 58rpx;
  padding: 0 28rpx;
  border-radius: 22rpx 0 22rpx 0;
  background: var(--brand-primary);
  color: #fff;
  font-size: 24rpx;
  line-height: 58rpx;
  font-weight: 700;
}

.whole-home-action text {
  float: right;
  font-size: 34rpx;
  line-height: 1;
}

.hero-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.eyebrow {
  font-size: 22rpx;
  color: #17a14c;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.title {
  font-size: 40rpx;
  line-height: 1.2;
  font-weight: 600;
  color: #20262d;
  margin-bottom: 14rpx;
}

.info,
.subtitle,
.template-desc,
.room-meta,
.loading-state {
  font-size: 24rpx;
  color: #7e8793;
  line-height: 1.5;
}

.hero-status {
  width: 178rpx;
  flex-shrink: 0;
  position: relative;
}

.status-pill {
  position: absolute;
  right: 0;
  top: 0;
  padding: 8rpx 18rpx;
  border-radius: var(--radius-full);
  background: rgba(34, 197, 94, 0.12);
  color: #17a14c;
  font-size: 22rpx;
  font-weight: 500;
}

.hero-house {
  position: absolute;
  right: 8rpx;
  bottom: 0;
  width: 150rpx;
  height: 110rpx;
  transform: rotate(-8deg);
}

.house-room {
  position: absolute;
  background: rgba(255, 255, 255, 0.96);
  border: 2rpx solid rgba(198, 228, 203, 0.86);
  box-shadow: 0 10rpx 24rpx rgba(90, 110, 92, 0.1);
}

.house-room-a { left: 6rpx; top: 18rpx; width: 74rpx; height: 52rpx; border-radius: 16rpx; }
.house-room-b { left: 76rpx; top: 8rpx; width: 64rpx; height: 64rpx; border-radius: 16rpx; }
.house-room-c { left: 40rpx; top: 68rpx; width: 88rpx; height: 34rpx; border-radius: 14rpx; }

.summary-card {
  display: grid;
  grid-template-columns: 1fr 1fr auto;
  gap: 12rpx;
  align-items: center;
  padding: 18rpx;
  margin-bottom: 16rpx;
}

.summary-item {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.summary-value {
  font-size: 32rpx;
  line-height: 1;
  font-weight: 600;
  color: #20262d;
}

.summary-label {
  font-size: 21rpx;
  color: #9aa1aa;
}

.summary-action,
.template-action,
.add-btn {
  color: #17a14c;
  background: rgba(34, 197, 94, 0.12);
  border-radius: var(--radius-full);
  font-size: 23rpx;
  font-weight: 500;
}

.summary-action {
  padding: 12rpx 20rpx;
}

.summary-action.primary {
  background: #17a14c;
  color: #ffffff;
}

.summary-actions {
  grid-column: 1 / -1;
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.whole-home-card {
  /* Keep the content below the 58rpx absolute tab, with a readable gap. */
  padding: 76rpx 24rpx 24rpx;
  margin-bottom: 18rpx;
  display: block;
}

.whole-home-copy {
  margin-bottom: 24rpx;
}

.whole-home-next-action {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  min-width: 0;
}

.whole-home-next-label {
  flex-shrink: 0;
  margin-top: 2rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
  background: var(--brand-primary-20);
  color: #147b3a;
  font-size: 20rpx;
  line-height: 1.35;
  font-weight: 600;
}

.whole-home-next-copy {
  min-width: 0;
  color: #334155;
  font-size: 24rpx;
  line-height: 1.5;
  font-weight: 500;
}

.whole-home-subtitle {
  margin-top: 12rpx;
  color: #7e8793;
  font-size: 23rpx;
  line-height: 1.45;
}

.whole-home-action {
  width: 100%;
  min-width: 0;
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #17a14c;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.whole-home-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.whole-home-secondary-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.whole-home-action.secondary {
  background: #eff9f1;
  color: #17a14c;
}

.whole-home-action.danger {
  background: #fff1f1;
  color: #dc2626;
}

.measurement-history {
  margin-top: 26rpx;
}

.measurement-history-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 4rpx 14rpx;
  color: #20262d;
  font-size: 28rpx;
  font-weight: 600;
}

.measurement-history-heading text:last-child {
  color: #8a939e;
  font-size: 22rpx;
  font-weight: 400;
}

.measurement-record {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 20rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid rgba(207, 220, 207, 0.6);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: var(--shadow-home-card);
}

.measurement-record-copy {
  flex: 1;
  min-width: 0;
}

.measurement-record-name,
.measurement-record-meta {
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.measurement-record-name {
  color: #20262d;
  font-size: 26rpx;
  font-weight: 600;
}

.measurement-record-meta {
  margin-top: 6rpx;
  color: #7e8793;
  font-size: 22rpx;
}

.measurement-record-actions {
  display: flex;
  gap: 10rpx;
}

.measurement-record-continue,
.measurement-record-delete {
  min-width: 80rpx;
  height: 56rpx;
  padding: 0 14rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font-size: 23rpx;
  font-weight: 500;
}

.measurement-record-continue {
  background: #eff9f1;
  color: #17a14c;
}

.measurement-record-delete {
  background: #fff1f1;
  color: #dc2626;
}

.source-pill {
  padding: 10rpx 18rpx;
  border-radius: var(--radius-full);
  color: #0f766e;
  background: rgba(20, 184, 166, 0.12);
  font-size: 22rpx;
  font-weight: 500;
  white-space: nowrap;
}

.kujiale-panel {
  padding: 24rpx;
  margin-bottom: 18rpx;
}

.kujiale-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 18rpx;
  margin-bottom: 20rpx;
}

.kujiale-title {
  color: #20262d;
  font-size: 30rpx;
  line-height: 1.25;
  font-weight: 600;
}

.kujiale-subtitle {
  color: #7e8793;
  font-size: 23rpx;
  line-height: 1.5;
  margin-top: 8rpx;
}

.kujiale-badge {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-full);
  color: #166534;
  background: rgba(34, 197, 94, 0.12);
  font-size: 22rpx;
  font-weight: 600;
}

.kujiale-form {
  display: grid;
  grid-template-columns: 1fr 1.5fr;
  gap: 12rpx;
}

.kujiale-input {
  min-width: 0;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  background: #f6f8f6;
  color: #20262d;
  font-size: 24rpx;
  box-sizing: border-box;
}

.kujiale-input.main {
  grid-column: span 1;
}

.kujiale-search-btn {
  margin-top: 16rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: #17a14c;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.kujiale-error {
  margin-top: 14rpx;
  color: #b45309;
  background: rgba(251, 191, 36, 0.14);
  border-radius: 16rpx;
  padding: 14rpx 18rpx;
  font-size: 23rpx;
  line-height: 1.45;
}

.kujiale-list {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.kujiale-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx;
  border-radius: 18rpx;
  background: #f8faf8;
}

.kujiale-preview {
  width: 86rpx;
  height: 86rpx;
  border-radius: 18rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: rgba(34, 197, 94, 0.12);
  color: #17a14c;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
}

.kujiale-preview image {
  width: 100%;
  height: 100%;
}

.kujiale-copy {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.kujiale-name {
  color: #20262d;
  font-size: 26rpx;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.kujiale-meta,
.kujiale-origin {
  color: #7e8793;
  font-size: 22rpx;
  line-height: 1.35;
}

.kujiale-import {
  flex-shrink: 0;
  min-width: 88rpx;
  height: 56rpx;
  padding: 0 16rpx;
  border-radius: var(--radius-full);
  background: rgba(34, 197, 94, 0.14);
  color: #17a14c;
  font-size: 23rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-state {
  padding: 72rpx 32rpx;
  text-align: center;
  margin-bottom: 18rpx;
}

.icon {
  width: 128rpx;
  height: 128rpx;
  margin: 0 auto 22rpx;
  border-radius: var(--radius-full);
  background: var(--brand-primary-20);
  color: var(--text-brand);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  font-weight: 600;
}

.template-list,
.room-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 29rpx;
  font-weight: 500;
  color: #21262d;
  margin: 22rpx 4rpx 14rpx;
}

.add-btn {
  padding: 10rpx 18rpx;
}

.template-item,
.room-item {
  padding: 22rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.template-thumb,
.room-icon {
  width: 66rpx;
  height: 66rpx;
  border-radius: 22rpx;
  background: rgba(34, 197, 94, 0.12);
  color: #17a14c;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-weight: 600;
  position: relative;
}

.template-line {
  position: absolute;
  background: #17a14c;
  opacity: 0.78;
}

.line-a { width: 34rpx; height: 3rpx; left: 16rpx; top: 20rpx; }
.line-b { width: 3rpx; height: 32rpx; left: 30rpx; top: 18rpx; }
.line-c { width: 34rpx; height: 3rpx; left: 16rpx; top: 44rpx; }

.template-copy,
.room-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.template-name,
.room-name {
  color: #20262d;
  font-size: 28rpx;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.template-action {
  padding: 10rpx 18rpx;
  flex-shrink: 0;
}

.room-status {
  padding: 7rpx 16rpx;
  border-radius: var(--radius-full);
  background: var(--status-cancelled-bg);
  color: var(--status-cancelled-text);
  font-size: 21rpx;
  flex-shrink: 0;
}

.room-status.measured {
  background: var(--status-measuring-bg);
  color: var(--status-measuring-text);
}

.loading-state {
  text-align: center;
  padding: 120rpx 0;
}
.detail-error {
  display: flex;
  min-height: 520rpx;
  margin: 28rpx 20rpx;
  padding: 40rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  border-radius: 24rpx;
  text-align: center;
  background: #ffffff;
  box-sizing: border-box;
}

.detail-error-title {
  color: #283229;
  font-size: 28rpx;
  font-weight: 700;
}

.detail-error-copy {
  margin-top: 10rpx;
  color: #737e76;
  font-size: 22rpx;
  line-height: 1.5;
}

.detail-error-action {
  min-width: 200rpx;
  min-height: 80rpx;
  margin-top: 24rpx;
  padding: 0 24rpx;
  border: 0;
  border-radius: 18rpx;
  color: #ffffff;
  background: #18a94b;
  font-size: 24rpx;
  line-height: 80rpx;
}

.detail-error-action::after {
  border: 0;
}

.conversion-sheet-mask {
  position: fixed;
  z-index: 1200;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(19, 33, 23, 0.46);
}

.conversion-sheet {
  width: 100%;
  max-height: 86vh;
  padding: 14rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 30rpx 30rpx 0 0;
  background: #ffffff;
  overflow-y: auto;
  box-sizing: border-box;
}

.conversion-sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 22rpx;
  border-radius: var(--radius-full);
  background: #d8dfd9;
}

.conversion-sheet-header {
  gap: 24rpx;
  margin-bottom: 22rpx;
}

.conversion-sheet-header > view {
  min-width: 0;
  display: flex;
  flex: 1;
  flex-direction: column;
}

.conversion-sheet-title {
  color: #1f2b22;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.3;
}

.conversion-sheet-customer {
  margin-top: 6rpx;
  color: #6b766e;
  font-size: 22rpx;
  line-height: 1.4;
}

.conversion-sheet-close {
  min-width: 88rpx;
  min-height: 72rpx;
  color: #4e5a52;
  font-size: 24rpx;
  line-height: 72rpx;
  text-align: right;
}

.conversion-skip-warning,
.conversion-revert-warning,
.conversion-boundary-copy {
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  font-size: 22rpx;
  line-height: 1.5;
}

.conversion-skip-warning {
  margin-bottom: 18rpx;
  color: #8a5a12;
  background: #fff6df;
}

.conversion-revert-warning {
  margin-bottom: 18rpx;
  color: #a33a3a;
  background: #fff0f0;
}

.conversion-field {
  margin-top: 18rpx;
}

.conversion-field-label {
  display: block;
  margin-bottom: 10rpx;
  color: #273229;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
}

.conversion-field-control,
.conversion-amount-control,
.conversion-note-control {
  width: 100%;
  min-height: 82rpx;
  padding: 0 20rpx;
  border: 1rpx solid #dbe3dc;
  border-radius: 16rpx;
  color: #253128;
  background: #f8faf8;
  font-size: 24rpx;
  box-sizing: border-box;
}

.conversion-field-control {
  line-height: 82rpx;
}

.conversion-field-control text {
  color: #218249;
  font-size: 22rpx;
}

.conversion-amount-control {
  gap: 10rpx;
}

.conversion-amount-control > text {
  color: #455148;
  font-size: 26rpx;
}

.conversion-amount-control input {
  min-width: 0;
  height: 80rpx;
  flex: 1;
  color: #253128;
  font-size: 24rpx;
}

.conversion-note-control {
  min-height: 128rpx;
  padding-top: 18rpx;
  padding-bottom: 18rpx;
  line-height: 1.5;
}

.conversion-boundary-copy {
  margin-top: 18rpx;
  color: #647168;
  background: #f1f4f1;
}

.conversion-sheet-actions {
  gap: 14rpx;
  margin-top: 24rpx;
}

.conversion-sheet-primary,
.conversion-sheet-secondary,
.conversion-sheet-danger {
  min-height: 88rpx;
  flex: 1;
  border-radius: 16rpx;
  line-height: 88rpx;
}

.conversion-sheet-primary {
  color: #ffffff;
  background: #18a94b;
}

.conversion-sheet-secondary {
  color: #354039;
  background: #f1f4f1;
}

.conversion-sheet-danger {
  color: #ffffff;
  background: #d84a4a;
}

.conversion-primary-action[disabled],
.conversion-sheet-primary[disabled],
.conversion-sheet-secondary[disabled],
.conversion-sheet-danger[disabled],
.conversion-revert-action[disabled] {
  opacity: 0.55;
}
