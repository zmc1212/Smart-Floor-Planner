<view class="container" wx:if="{{!loading && lead}}">
  <view class="detail-hero" wx:if="{{lead}}">
    <view class="hero-copy">
      <text class="eyebrow">客户详情</text>
      <text class="title">{{lead.name}}</text>
      <text class="info">手机：{{lead.phone}}</text>
      <text class="info">小区：{{lead.communityName || '未填写'}}</text>
      <view class="lead-status-summary">
        <text class="status-pill">{{statusLabel}}</text>
      </view>
    </view>
    <image class="lead-detail-scene" src="/packages/business/assets/leads/lead-detail.png" mode="aspectFit"></image>
  </view>
  <view class="lead-stage-rail" wx:if="{{lead}}">
    <view class="lead-stage-item state-{{item.state}}" wx:for="{{stageRail}}" wx:key="label">
      <view class="lead-stage-dot"></view>
      <text>{{item.label}}</text>
    </view>
  </view>
  <view class="appointment-entry" wx:if="{{canScheduleAppointment}}">
    <view class="appointment-entry-copy">
      <text class="appointment-entry-title">上门量房</text>
      <text class="appointment-entry-note">{{canRebookAppointment ? (lead.nextAction || '预约已过期或已取消，请选择新的上门时段') : '先从真实可用时段安排首次上门服务'}}</text>
    </view>
    <button class="appointment-entry-action" wx:if="{{canRebookAppointment}}" bindtap="onScheduleAppointment">重新预约上门</button>
    <button class="appointment-entry-action" wx:else bindtap="onScheduleAppointment">安排上门量房</button>
  </view>
  <view class="appointment-entry" wx:elif="{{appointment}}">
    <view class="appointment-entry-copy">
      <text class="appointment-entry-title">上门量房 · {{lead.serviceStageLabel || '已确认'}}</text>
      <text class="appointment-entry-note">{{appointment.summary}} · {{appointment.address}}</text>
    </view>
    <button class="appointment-entry-action appointment-entry-action-secondary" bindtap="onOpenAppointment">查看预约</button>
  </view>
  <view class="whole-home-card">
    <view class="whole-home-tab">正式量房</view>
    <view class="whole-home-copy">
      <view class="whole-home-next-action">
        <text class="whole-home-next-label">下一步</text>
        <text class="whole-home-next-copy">{{nextAction}}</text>
      </view>
      <view class="whole-home-subtitle">{{activeFloorPlan ? activeFloorPlan.displayMeta : '从墙图开始建立客户户型'}}</view>
    </view>
    <view wx:if="{{canEditMeasurements}}" class="whole-home-actions">
      <view class="whole-home-action" bindtap="onStartMeasure">{{activeFloorPlan ? '继续量房' : '开始量房'}} <text>›</text></view>
      <view class="whole-home-secondary-actions" wx:if="{{activeFloorPlan}}">
        <view class="whole-home-action secondary" bindtap="onStartNewMeasure">新增量房</view>
        <view class="whole-home-action danger" bindtap="onDeleteMeasure">{{deleting ? '删除中' : '删除'}}</view>
      </view>
    </view>
  </view>
  <view class="measurement-history" wx:if="{{previousFloorPlans.length > 0}}">
    <view class="measurement-history-heading">
      <text>历史量房记录</text>
      <text>{{previousFloorPlans.length}} 份</text>
    </view>
    <view
      class="measurement-record"
      wx:for="{{previousFloorPlans}}"
      wx:key="_id"
      data-id="{{item._id}}"
      wx:if="{{canEditMeasurements}}"
      bindtap="onContinueMeasure"
      aria-role="button"
      aria-label="继续量房 {{item.historyName}}"
    >
      <view class="measurement-record-copy">
        <text class="measurement-record-name">{{item.historyName}}</text>
        <text class="measurement-record-meta">{{item.displayMeta}}</text>
      </view>
      <view wx:if="{{canEditMeasurements}}" class="measurement-record-actions">
        <view class="measurement-record-continue" data-id="{{item._id}}" catchtap="onContinueMeasure">继续</view>
        <view class="measurement-record-delete" data-id="{{item._id}}" catchtap="onDeleteMeasure">删除</view>
      </view>
    </view>
  </view>
  <view class="conversion-card" wx:if="{{lead && (canMarkConverted || lead.status === 'converted')}}">
    <view class="conversion-card-heading">
      <view class="conversion-card-copy">
        <text class="conversion-card-title">成交进度</text>
        <text class="conversion-card-subtitle" wx:if="{{canMarkConverted}}">客户完成合同签署后，在这里结束业务跟进</text>
        <text class="conversion-card-subtitle" wx:else>签约事实已记录，客户进入已签约阶段</text>
      </view>
      <text class="conversion-status" wx:if="{{lead.status === 'converted'}}">已签约</text>
    </view>
    <button
      wx:if="{{canMarkConverted}}"
      class="conversion-primary-action flex-row justify-center"
      bindtap="onOpenConversionSheet"
      disabled="{{conversionSubmitting}}"
      aria-label="标记客户已签约"
    >标记已签约</button>
    <view class="conversion-summary" wx:elif="{{lead.status === 'converted'}}">
      <view class="conversion-summary-row">
        <text>签约日期</text>
        <text>{{lead.convertedOn || '历史数据未记录'}}</text>
      </view>
      <view class="conversion-summary-row" wx:if="{{showInternalConversionDetails}}">
        <text>标记人</text>
        <text>{{convertedByName}}</text>
      </view>
      <view class="conversion-summary-row" wx:if="{{showInternalConversionDetails && convertedTime}}">
        <text>标记时间</text>
        <text>{{convertedTime}}</text>
      </view>
      <view class="conversion-summary-row" wx:if="{{showInternalConversionDetails && convertedAmountText}}">
        <text>签约金额</text>
        <text>{{convertedAmountText}}</text>
      </view>
      <view class="conversion-summary-note" wx:if="{{showInternalConversionDetails && lead.conversionNote}}">{{lead.conversionNote}}</view>
      <button
        wx:if="{{canRevertConversion}}"
        class="conversion-revert-action"
        bindtap="onOpenRevertConversionSheet"
        disabled="{{conversionSubmitting}}"
      >撤销签约标记</button>
    </view>
  </view>
</view>
<view class="detail-error" wx:elif="{{errorMessage}}">
  <view class="detail-error-title">线索详情暂时无法加载</view>
  <view class="detail-error-copy">{{errorMessage}}</view>
  <button class="detail-error-action" bindtap="onRetryDetail">重新加载</button>
</view>
<view class="loading-state" wx:else>加载中...</view>

<view class="conversion-sheet-mask" wx:if="{{showConversionSheet}}" catchtap="onCloseConversionSheet">
  <view class="conversion-sheet" catchtap="onSheetTap">
    <view class="conversion-sheet-handle"></view>
    <view class="conversion-sheet-header">
      <view>
        <text class="conversion-sheet-title">确认客户已签约</text>
        <text class="conversion-sheet-customer">{{lead.name}} · {{lead.communityName || '未填写小区'}}</text>
      </view>
      <text class="conversion-sheet-close" catchtap="onCloseConversionSheet">关闭</text>
    </view>
    <view class="conversion-skip-warning" wx:if="{{conversionSkipsStages}}">本次操作将跳过尚未完成的中间阶段</view>
    <view class="conversion-field">
      <text class="conversion-field-label">签约日期</text>
      <picker mode="date" value="{{conversionDate}}" end="{{todayDateValue}}" bindchange="onConversionDateChange">
        <view class="conversion-field-control">{{conversionDate}} <text>选择</text></view>
      </picker>
    </view>
    <view class="conversion-field">
      <text class="conversion-field-label">签约金额（选填）</text>
      <view class="conversion-amount-control">
        <text>¥</text>
        <input
          type="digit"
          value="{{conversionAmount}}"
          placeholder="用于经营统计，不作为财务结算凭证"
          bindinput="onConversionAmountInput"
        />
      </view>
    </view>
    <view class="conversion-field">
      <text class="conversion-field-label">签约备注（选填）</text>
      <textarea
        class="conversion-note-control"
        value="{{conversionNote}}"
        maxlength="200"
        auto-height
        placeholder="可记录合同编号或需要交接的事项"
        bindinput="onConversionNoteInput"
      ></textarea>
    </view>
    <view class="conversion-boundary-copy">仅更新客户业务状态，不会自动生成订单、扣款或生成提成记录。</view>
    <view class="conversion-sheet-actions">
      <button class="conversion-sheet-secondary" catchtap="onCloseConversionSheet" disabled="{{conversionSubmitting}}">取消</button>
      <button class="conversion-sheet-primary" catchtap="onConfirmConversion" loading="{{conversionSubmitting}}" disabled="{{conversionSubmitting || !conversionDate}}">确认已签约</button>
    </view>
  </view>
</view>

<view class="conversion-sheet-mask" wx:if="{{showRevertConversionSheet}}" catchtap="onCloseRevertConversionSheet">
  <view class="conversion-sheet" catchtap="onSheetTap">
    <view class="conversion-sheet-handle"></view>
    <view class="conversion-sheet-header">
      <view>
        <text class="conversion-sheet-title">撤销签约标记</text>
        <text class="conversion-sheet-customer">撤销后恢复为签约前的业务阶段</text>
      </view>
      <text class="conversion-sheet-close" catchtap="onCloseRevertConversionSheet">关闭</text>
    </view>
    <view class="conversion-revert-warning">签约审计记录会保留，请填写本次修正原因。</view>
    <view class="conversion-field">
      <text class="conversion-field-label">撤销原因</text>
      <textarea
        class="conversion-note-control"
        value="{{revertConversionReason}}"
        maxlength="200"
        auto-height
        placeholder="请说明合同未生效或误操作等原因"
        bindinput="onRevertConversionReasonInput"
      ></textarea>
    </view>
    <view class="conversion-sheet-actions">
      <button class="conversion-sheet-secondary" catchtap="onCloseRevertConversionSheet" disabled="{{conversionSubmitting}}">取消</button>
      <button class="conversion-sheet-danger" catchtap="onConfirmRevertConversion" loading="{{conversionSubmitting}}" disabled="{{conversionSubmitting || !revertConversionReason}}">确认撤销</button>
    </view>
  </view>
</view>
