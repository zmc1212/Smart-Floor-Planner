page{background:#fbfdfb}.detail-page{min-height:100vh;padding-bottom:calc(44rpx + env(safe-area-inset-bottom));box-sizing:border-box;color:#1d2820}.detail-nav{display:flex;padding:0 30rpx 14rpx;align-items:center;box-sizing:content-box}.back{display:flex;width:62rpx;height:62rpx;align-items:center;justify-content:center}.back-chevron{width:16rpx;height:16rpx;border-top:3rpx solid #1d2820;border-right:3rpx solid #1d2820;transform:rotate(-135deg);box-sizing:border-box}.nav-title{margin-left:10rpx;font-size:30rpx;font-weight:700}.detail-content{padding:0 28rpx}.dispatch-scene{display:flex;min-height:148rpx;margin:4rpx 0 18rpx;padding:8rpx 24rpx 8rpx 12rpx;align-items:center;border-radius:24rpx;background:linear-gradient(110deg,#edf9ef,#f8fcf8);box-sizing:border-box}.dispatch-scene image{width:142rpx;height:142rpx;flex:none}.scene-kicker,.scene-copy{display:block}.scene-kicker{color:#176d39;font-size:26rpx;font-weight:700}.scene-copy{margin-top:8rpx;color:#5d6f62;font-size:22rpx;line-height:1.5}.schedule-card{padding:28rpx}.schedule-heading{display:flex;align-items:center;justify-content:space-between;font-size:28rpx;font-weight:700}.status{padding:7rpx 14rpx;border-radius:10rpx;color:#168a3d;background:#eaf8ec;font-size:22rpx;font-weight:600}.status-completed{color:#2f6e49;background:#edf4ef}.status-cancelled{color:#8a5550;background:#f8ecea}.date{display:block;margin-top:32rpx;color:#29352c;font-size:26rpx}.time{display:block;margin-top:10rpx;color:#087c36;font-size:42rpx;font-weight:750;letter-spacing:.5rpx}.hairline{height:1px;margin:28rpx 0 12rpx;transform:scaleY(.5);background:#dce7de}.detail-row{display:flex;padding:15rpx 0;align-items:flex-start;gap:24rpx;font-size:24rpx;line-height:1.5}.detail-row text:first-child{width:112rpx;flex:none;color:#69756c;font-size:22rpx}.detail-row text:last-child{min-width:0;flex:1;text-align:right;word-break:break-all}.role-note,.finished-note{margin:18rpx 4rpx 0;color:#657269;font-size:22rpx;line-height:1.6}.finished-note{padding:22rpx;border-radius:16rpx;background:#f1f5f2}.actions{display:flex;margin-top:32rpx;flex-direction:column;gap:16rpx}.actions button{width:100%;min-height:84rpx;margin:0;border:0;border-radius:18rpx;font-size:26rpx;line-height:84rpx}.actions button::after{border:0}.primary{color:#fff;background:#0aa447}.secondary{color:#087c36;background:#e9f8ed}.danger{color:#b43e35;background:#fff;border:1rpx solid #edc9c5!important}.state-card{margin:50rpx 28rpx;padding:36rpx 28rpx;color:#69756c;font-size:24rpx;text-align:center}.retry{display:block;min-height:64rpx;margin:18rpx auto 0;padding:0 28rpx;border:0;border-radius:32rpx;color:#087c36;background:#e9f8ed;font-size:24rpx;line-height:64rpx}.retry::after{border:0}
