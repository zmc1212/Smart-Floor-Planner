<!--
THESIS: 将真实预约整理成一张服务调度单，让每个岗位只看到自己能执行的下一步。
OWN-WORLD: 延续已批准的预约协调小 K、绿色时段语言与原生胶囊安全区。
FORM: Service dispatch slip; approved appointment artwork is reused as a standalone asset.
-->
<view class="detail-page sfp-page">
  <view class="detail-nav" style="padding-top: {{navigationTop}}px; min-height: {{navigationHeight}}px; padding-right: {{navigationRight}}px;">
    <view class="back" bindtap="onBack" aria-role="button" aria-label="返回"><view class="back-chevron"></view></view>
    <text class="nav-title">预约详情</text>
  </view>

  <view wx:if="{{loading}}" class="state-card sfp-card">正在读取预约详情…</view>
  <view wx:elif="{{error}}" class="state-card sfp-card">
    <text>{{error}}</text>
    <button wx:if="{{leadId}}" class="retry" bindtap="load">重新加载</button>
    <button wx:else class="retry" bindtap="onBack">返回上一页</button>
  </view>
  <view wx:elif="{{appointment}}" class="detail-content">
    <view class="dispatch-scene">
      <image src="/packages/business/assets/appointment-booking-v1/schedule-guide.png" mode="aspectFit"></image>
      <view><text class="scene-kicker">小 K 服务调度单</text><text class="scene-copy">时间、地点与岗位动作保持同步</text></view>
    </view>

    <view class="schedule-card sfp-card">
      <view class="schedule-heading"><text>上门量房</text><text class="status status-{{appointment.status}}">{{appointment.statusLabel}}</text></view>
      <text class="date">{{appointment.dateText}}</text>
      <text class="time">{{appointment.timeText}}</text>
      <view class="hairline"></view>
      <view class="detail-row"><text>上门地址</text><text>{{appointment.address || '待补充'}}</text></view>
      <view class="detail-row"><text>预约编号</text><text>#{{appointment.id}}</text></view>
    </view>

    <view class="role-note" wx:if="{{appointment.status === 'confirmed'}}">{{customerMode ? '如需调整时间，请在截止时间前选择可用时段。' : '设计师负责协调时间与取消，测量员完成上门后确认完成；企业负责人可处理全部动作。'}}</view>
    <view class="finished-note" wx:else>该预约已结束，当前记录仅供查看。</view>

    <view class="actions" wx:if="{{canReschedule || canCancel || canComplete || canUpdateAddress}}">
      <button wx:if="{{canComplete}}" class="primary sfp-primary-action" loading="{{acting}}" bindtap="complete">确认完成量房</button>
      <button wx:if="{{canReschedule}}" class="secondary" disabled="{{acting}}" bindtap="reschedule">调整上门时间</button>
      <button wx:if="{{canCancel}}" class="danger" disabled="{{acting}}" bindtap="cancel">取消本次预约</button>
      <button wx:if="{{canUpdateAddress}}" class="secondary" loading="{{acting}}" disabled="{{acting}}" bindtap="updateAddress">{{appointment.address ? '修改服务地址' : '补充服务地址'}}</button>
    </view>
  </view>
</view>
