page { min-height: 100%; background: #f3f8f3; }

.debug-page { display: flex; min-height: 100vh; padding: 48rpx 32rpx calc(48rpx + env(safe-area-inset-bottom)); align-items: center; box-sizing: border-box; }
.debug-card, .locked-state { width: 100%; padding: 40rpx 32rpx; border: 1rpx solid rgba(207, 225, 211, 0.92); border-radius: 24rpx; background: #ffffff; box-shadow: 0 12rpx 34rpx rgba(62, 102, 70, 0.1); box-sizing: border-box; }
.eyebrow { display: inline-flex; min-height: 40rpx; padding: 0 16rpx; align-items: center; border-radius: 20rpx; color: #087c36; background: #e5f7e9; font-size: 20rpx; font-weight: 700; line-height: 40rpx; }
.title { margin-top: 18rpx; color: #172019; font-size: 36rpx; font-weight: 800; line-height: 1.3; }
.copy { margin-top: 12rpx; color: #657269; font-size: 24rpx; line-height: 1.6; }
.primary-action, .secondary-action { min-height: 92rpx; margin-top: 28rpx; border: 0; border-radius: 16rpx; font-size: 28rpx; font-weight: 700; line-height: 92rpx; }
.primary-action { color: #ffffff; background: linear-gradient(135deg, #0eb44d 0%, #079c3f 100%); box-shadow: 0 10rpx 22rpx rgba(10, 158, 65, 0.2); }
.secondary-action { margin-top: 18rpx; color: #087c36; background: #ffffff; box-shadow: inset 0 0 0 2rpx #22c55e; }
.primary-action::after, .secondary-action::after { border: 0; }
.primary-action:active, .secondary-action:active { opacity: 0.84; }
.error-copy { margin-top: 18rpx; color: #c53d32; font-size: 24rpx; line-height: 1.5; }
.locked-state { text-align: center; }
