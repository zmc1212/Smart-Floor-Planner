<view class="project-page">
  <view class="project-nav" style="padding-top:{{navigationTop}}px;padding-right:{{navigationRight}}px;min-height:{{navigationTop + navigationHeight}}px">
    <view class="nav-back" bindtap="goBack"><view></view></view>
    <view>
      <text wx:if="{{step === 'leads'}}">选择客户</text>
      <text wx:elif="{{step === 'schemes'}}">选择方案</text>
      <text wx:else>选择设计空间</text>
      <text wx:if="{{step === 'leads'}}">先选客户，再选要续接的方案</text>
      <text wx:elif="{{step === 'schemes'}}">{{selectedLead.displayTitle}}</text>
      <text wx:else>{{selectedScheme.title}}</text>
    </view>
  </view>
  <view wx:if="{{loading}}" class="project-state"><view class="state-card shimmer"></view><text>正在整理客户方案册…</text></view>
  <view wx:elif="{{error}}" class="project-state"><text class="state-title">客户方案加载失败</text><text>{{error}}</text><view class="state-action" bindtap="retry">重新加载</view></view>
  <block wx:else>
    <scroll-view wx:if="{{step === 'leads'}}" scroll-y enhanced show-scrollbar="{{false}}" class="project-scroll">
      <view class="project-content">
        <view class="selected-recipe-mini">
          <image wx:if="{{recipe.previewUrl}}" src="{{recipe.previewUrl}}" mode="aspectFill"></image>
          <view class="mini-shade"></view>
          <view><text>已选配方</text><text>{{recipe.name}}</text></view>
        </view>
        <view class="project-search">
          <image src="/images/mine-icons/search.png" mode="aspectFit"></image>
          <input placeholder="搜索客户或小区" value="{{leadSearch}}" bindinput="onLeadSearch" />
        </view>
        <scroll-view scroll-x show-scrollbar="{{false}}" class="project-group-scroll">
          <view class="project-groups">
            <view wx:for="{{leadGroups}}" wx:key="key" class="project-group {{item.active ? 'active' : ''}}" data-key="{{item.key}}" bindtap="selectLeadGroup">
              <text>{{item.label}}</text>
              <text>{{item.count}}</text>
            </view>
          </view>
        </scroll-view>
        <view wx:if="{{!filteredLeads.length}}" class="project-empty">
          <text>{{leadEmptyCopy}}</text>
          <text>{{leadGroup === 'needs_survey' ? '完成正式量房后，这里会出现可设计客户。' : '可以返回客户线索创建并完成一次正式量房。'}}</text>
          <view class="project-empty-action" bindtap="openCustomerLeads">前往客户线索</view>
        </view>
        <view wx:else class="project-list">
          <view wx:for="{{filteredLeads}}" wx:key="id" class="project-card {{item.group}}" data-id="{{item.id}}" bindtap="selectLead">
            <view class="project-cover">
              <image src="/images/ai-design-project-folio-cover-v1.png" mode="aspectFill"></image>
              <text>{{item.statusLabel}}</text>
            </view>
            <view class="project-card-copy">
              <text>{{item.displayTitle}}</text>
              <text>{{item.meta}}</text>
              <text>{{item.helper}}</text>
            </view>
            <view class="project-action">{{item.actionLabel}}</view>
          </view>
        </view>
      </view>
    </scroll-view>

    <scroll-view wx:elif="{{step === 'schemes'}}" scroll-y enhanced show-scrollbar="{{false}}" class="project-scroll">
      <view class="project-content">
        <view class="selected-recipe-mini">
          <image wx:if="{{recipe.previewUrl}}" src="{{recipe.previewUrl}}" mode="aspectFill"></image>
          <view class="mini-shade"></view>
          <view><text>已选配方</text><text>{{recipe.name}}</text></view>
        </view>
        <view class="scheme-toolbar">
          <text>方案对话</text>
          <view class="{{creating ? 'disabled' : ''}}" bindtap="createScheme">{{creating ? '正在新建…' : '新建'}}</view>
        </view>
        <view wx:if="{{schemesLoading}}" class="project-empty"><text>正在加载方案对话…</text><text>与后台工作台使用同一套客户方案。</text></view>
        <view wx:elif="{{!schemes.length}}" class="project-empty">
          <text>还没有方案对话</text>
          <text>新建后，这次配方会进入该方案继续出图。</text>
          <view class="project-empty-action {{creating ? 'disabled' : ''}}" bindtap="createScheme">{{creating ? '正在新建…' : '新建方案'}}</view>
        </view>
        <view wx:else class="project-list">
          <view wx:for="{{schemes}}" wx:key="id" class="project-card" data-id="{{item.id}}" bindtap="selectScheme">
            <view class="project-cover">
              <image src="{{item.coverUrl}}" mode="aspectFill"></image>
              <text>方案对话</text>
            </view>
            <view class="project-card-copy">
              <text>{{item.title}}</text>
              <text>{{item.meta}}</text>
              <text>选择后在此方案里再出一轮</text>
            </view>
            <view class="project-action">选择</view>
          </view>
        </view>
      </view>
    </scroll-view>

    <scroll-view wx:else scroll-y enhanced show-scrollbar="{{false}}" class="project-scroll">
      <view class="scope-content">
        <view class="project-identity">
          <text>当前方案</text>
          <text>{{selectedScheme.title}}</text>
          <text>{{selectedLead.displayTitle}} · {{closedRoomCount}} 个闭合空间</text>
        </view>
        <text class="scope-heading">应用到哪里</text>
        <view class="scope-list">
          <view wx:for="{{scopes}}" wx:key="key" class="scope-card {{selectedScope.key === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="selectScope">
            <view class="scope-mark"><view></view></view>
            <view>
              <text>{{item.name}}</text>
              <text>{{item.meta}}</text>
            </view>
            <text>{{item.targetScope === 'whole_floor_plan' ? '整屋方案' : '单房间'}}</text>
          </view>
        </view>
        <view class="scope-note">配方只应用到当前选择，不会自动为其他房间生成，也不会产生额外扣点。</view>
        <view class="scope-bottom-space"></view>
      </view>
    </scroll-view>
  </block>
  <view wx:if="{{step === 'scope' && selectedScope}}" class="project-bottom"><view bindtap="continueToConfirm">确认空间，继续</view></view>
</view>
