<!-- Approved sources: design-references/ai-design/unified-entry-v2/02-project-picker-v2.png and 03-recipe-bind-v2.png -->
<wxs src="../../../utils/stat-format.wxs" module="stat" />
<view class="project-page {{selectedLead ? 'is-binding' : 'is-picker'}}">
  <view wx:if="{{loading}}" class="project-state"><view class="state-card shimmer"></view><text>正在整理客户方案册…</text></view>
  <view wx:elif="{{error}}" class="project-state"><text class="state-title">客户方案加载失败</text><text>{{error}}</text><view class="state-action" bindtap="retry">重新加载</view></view>

  <!-- V2 project-picker state: recipe stays in context, but selecting a customer is the first task. -->
  <scroll-view wx:elif="{{!selectedLead}}" scroll-y enhanced show-scrollbar="{{false}}" class="picker-scroll" lower-threshold="120" bindscrolltolower="onLoadMoreLeads">
    <view class="picker-hero" style="padding-top:{{navigationTop + navigationHeight + 38}}px">
      <image class="picker-hero-image" src="{{recipe.previewUrl}}" mode="aspectFill"></image>
      <view class="picker-hero-wash"></view>
      <view class="picker-nav" style="padding-top:{{navigationTop}}px;padding-right:{{navigationRight}}px;min-height:{{navigationTop + navigationHeight}}px"><view class="nav-back picker-nav-back" bindtap="goBack" aria-role="button" aria-label="返回"><image src="/images/ai-studio-icons-v3/nav-back.png" mode="aspectFit"></image></view></view>
      <view class="picker-heading-plate" style="position:relative;z-index:1;display:table;padding:12rpx 18rpx 14rpx;border-radius:20rpx;background:rgba(247,247,243,.84);box-shadow:0 4rpx 12rpx rgba(22,40,29,.08)"><view class="picker-heading"><text>选择客户项目</text><text>先绑定客户，再开始创作</text></view></view>
    </view>
    <view class="picker-sheet">
      <view class="sheet-handle"></view>
      <view class="bind-project-search"><image src="/images/mine-icons/search.png" mode="aspectFit"></image><input placeholder="搜索客户或小区" value="{{leadSearch}}" bindinput="onLeadSearch" /></view>
      <scroll-view scroll-x show-scrollbar="{{false}}" class="bind-group-scroll"><view class="bind-groups"><view wx:for="{{leadGroups}}" wx:key="key" class="bind-group {{item.active ? 'active' : ''}}" style="min-width:150rpx" data-key="{{item.key}}" bindtap="selectLeadGroup">{{item.label}}</view></view></scroll-view>
      <view wx:if="{{!filteredLeads.length}}" class="bind-empty"><text>{{leadEmptyCopy}}</text><text>{{leadGroup === 'needs_survey' ? '完成正式量房后即可带入客户方案。' : '请先创建客户并完成正式量房。'}}</text><view bindtap="openCustomerLeads">前往客户线索</view></view>
      <view wx:else class="lead-list picker-lead-list">
        <view wx:for="{{filteredLeads}}" wx:key="id" class="lead-option {{item.group}} {{focusedLead && focusedLead.id === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectLead" aria-label="{{item.actionLabel}}">
          <view class="lead-cover"><image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill"></image><image wx:else src="{{recipe.previewUrl}}" mode="aspectFill"></image></view>
          <view class="lead-copy"><text>{{item.displayTitle}}</text><text>{{item.workflowCount ? '方案 ' + stat.count(item.workflowCount) + ' · 最近更新' : '尚未创建方案'}}</text><view class="lead-facts"><view><text>户型图</text><text>{{item.group === 'designable' ? '已完成' : '待量房'}}</text></view><view><text>方案状态</text><text>{{item.workflowCount ? '进行中' : '可开始'}}</text></view></view></view>
          <view class="lead-selection"><image wx:if="{{focusedLead && focusedLead.id === item.id}}" src="/images/ai-studio-icons-v3/check-white.png" mode="aspectFit"></image></view>
        </view>
        <view wx:if="{{footerText}}" class="sfp-list-footer">{{footerText}}</view>
      </view>
    </view>
    <view class="picker-bottom-space"></view>
  </scroll-view>

  <view wx:if="{{!loading && !error && !selectedLead}}" class="picker-bottom"><view class="picker-bottom-action {{!focusedLead ? 'disabled' : ''}}" bindtap="continueWithFocusedLead"><image src="/images/ai-studio-icons-v3/generate-white.png" mode="aspectFit"></image><text>{{focusedLead ? (focusedLead.group === 'needs_survey' ? '去完成正式量房' : '进入方案工作台') : '请选择客户项目'}}</text></view></view>

  <!-- V2 recipe-binding state: the chosen customer and the target scheme appear together. -->
  <block wx:if="{{!loading && !error && selectedLead}}">
    <view class="project-nav" style="padding-top:{{navigationTop}}px;padding-right:{{navigationRight}}px;min-height:{{navigationTop + navigationHeight}}px"><view class="nav-back" bindtap="goBack" aria-role="button" aria-label="返回"><image src="/images/ai-studio-icons-v3/nav-back.png" mode="aspectFit"></image></view></view>
    <scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="project-scroll">
      <view class="bind-content">
        <view class="page-heading"><text>带入客户方案</text><text>选择一个客户项目，配方将成为本轮创作预设</text></view>
        <view class="recipe-showcase"><image src="{{recipe.previewUrl}}" mode="aspectFill"></image><view class="recipe-showcase-shade"></view><view class="recipe-selected-badge"><image src="/images/ai-studio-icons-v3/check-white.png" mode="aspectFit"></image><text>已选配方</text></view><view class="recipe-showcase-copy"><text>{{recipe.name}}</text><text>{{recipe.spaceLabel}}</text><text>整屋 / {{stat.count(recipe.recipeCredits || 10)}} 点</text></view></view>

        <view class="bind-card customer-card">
          <view class="bind-card-head"><text>选择客户项目</text></view>
          <view class="selected-project"><view class="customer-avatar">{{selectedLead.avatarText}}</view><view><text>{{selectedLead.displayTitle}}</text><text>{{selectedLead.meta}}</text></view><view class="change-lead" bindtap="goBack">更换 <image src="/images/ai-studio-icons-v3/chevron-right.png" mode="aspectFit"></image></view></view>
        </view>

        <view class="bind-card scheme-card">
          <view class="bind-card-head"><text>选择方案</text></view>
          <view wx:if="{{schemesLoading}}" class="bind-loading">正在加载方案…</view>
          <block wx:else>
            <view wx:for="{{schemes}}" wx:key="id" class="scheme-choice {{selectedScheme && selectedScheme.id === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectScheme"><view class="scheme-icon"><image src="/images/ai-studio-icons-v3/template.png" mode="aspectFit"></image></view><view><text>{{item.title}}</text><text>{{item.meta}}</text></view><view class="scheme-check"><image wx:if="{{selectedScheme && selectedScheme.id === item.id}}" src="/images/ai-studio-icons-v3/check-white.png" mode="aspectFit"></image></view></view>
            <view class="scheme-choice new {{creating ? 'disabled' : ''}}" bindtap="createScheme"><view class="scheme-plus"><image src="/images/ai-studio-icons-v3/add.png" mode="aspectFit"></image></view><view><text>新建方案</text><text>创建一个新的方案对话</text></view></view>
          </block>
        </view>
        <view class="truth-note"><image class="info-icon" src="/images/ai-studio-icons-v3/info.png" mode="aspectFit"></image><text>配方只作为风格预设，不会在此创建生成任务</text></view>
        <view class="bottom-space"></view>
      </view>
    </scroll-view>
    <view class="project-bottom"><view class="{{!selectedScheme ? 'disabled' : ''}}" bindtap="continueWithSelectedScheme"><image class="button-spark" src="/images/ai-studio-icons-v3/generate-white.png" mode="aspectFit"></image>{{selectedScheme ? ('带入方案工作台 · ' + stat.count(recipe.recipeCredits || 10) + ' 点') : '请选择方案'}}</view></view>
  </block>
</view>
