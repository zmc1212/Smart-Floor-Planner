.history-page { height: 100vh; background: #f5f7f5; color: var(--text-primary); }
.history-shell { min-height: 100%; padding: 32rpx 28rpx calc(64rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.history-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 26rpx; }
.history-title { font-size: 42rpx; font-weight: 700; }
.history-count { color: var(--text-secondary); font-size: 23rpx; }
.history-list { display: flex; flex-direction: column; gap: 18rpx; }
.history-item { display: grid; grid-template-columns: 220rpx minmax(0, 1fr); min-height: 220rpx; overflow: hidden; background: #fff; border-radius: var(--radius-lg); box-shadow: var(--shadow-card); }
.history-image { width: 220rpx; height: 220rpx; background: var(--neutral-100); }
.history-body { min-width: 0; display: flex; flex-direction: column; justify-content: space-between; padding: 22rpx; box-sizing: border-box; }
.history-info { min-width: 0; }
.item-title { display: block; overflow: hidden; color: var(--text-primary); font-size: 27rpx; font-weight: 600; white-space: nowrap; text-overflow: ellipsis; }
.item-target { display: block; margin-top: 6rpx; overflow: hidden; color: var(--text-brand); font-size: 20rpx; white-space: nowrap; text-overflow: ellipsis; }
.sync-row { display: flex; align-items: center; min-width: 0; margin-top: 8rpx; }
.sync-chip { flex-shrink: 0; padding: 4rpx 10rpx; border-radius: var(--radius-full); background: var(--neutral-100); color: var(--text-secondary); font-size: 18rpx; }
.sync-chip.synced { background: var(--brand-primary-20); color: var(--text-brand); }
.workflow-name { min-width: 0; margin-left: 8rpx; overflow: hidden; color: var(--text-secondary); font-size: 19rpx; white-space: nowrap; text-overflow: ellipsis; }
.item-meta { display: block; margin-top: 10rpx; color: var(--text-secondary); font-size: 21rpx; }
.item-meta.processing { color: var(--text-brand); font-weight: 600; }
.item-actions { display: flex; justify-content: flex-end; gap: 10rpx; }
.mini-action { min-width: 104rpx; height: 54rpx; margin: 0; padding: 0 16rpx; border: none; border-radius: var(--radius-full); background: var(--brand-primary-20); color: var(--text-brand); font-size: 21rpx; line-height: 54rpx; }
.mini-action::after { border: none; }
.mini-action.danger { background: #fff0ee; color: #c8463b; }
.loading-more { padding: 28rpx; text-align: center; color: var(--text-secondary); font-size: 22rpx; }
.history-empty { min-height: 560rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; background: #fff; border-radius: var(--radius-lg); box-shadow: var(--shadow-card); }
.empty-mark { display: flex; align-items: center; justify-content: center; width: 92rpx; height: 92rpx; border-radius: var(--radius-full); background: var(--brand-primary-20); color: var(--brand-primary); font-size: 28rpx; font-weight: 700; }
.empty-title { margin-top: 20rpx; color: var(--text-secondary); font-size: 25rpx; }

/* all-pages-ip-v3 / 16-ai-design-history */
.history-shell { padding-top: 0; }
.history-hero { position: relative; min-height: 260rpx; margin: 0 -28rpx 24rpx; padding: 62rpx 34rpx 24rpx; overflow: hidden; background: linear-gradient(122deg, #fbfdf9 0%, #edf7ee 58%, #f5eee4 100%); box-sizing: border-box; }
.history-hero .history-head { position: relative; z-index: 2; width: 44%; flex-direction: column; align-items: flex-start; gap: 8rpx; }
.history-archive-scene { position: absolute; right: -8rpx; bottom: -30rpx; width: 420rpx; height: 300rpx; }
.history-filters { display: flex; gap: 14rpx; margin-bottom: 24rpx; overflow: hidden; }
.history-filter { min-width: 120rpx; height: 72rpx; padding: 0 22rpx; border-radius: 22rpx; background: #fff; color: var(--text-secondary); font-size: 24rpx; line-height: 72rpx; text-align: center; box-sizing: border-box; }
.history-filter.active { background: #e4f5e8; color: #118a43; font-weight: 700; }
.history-item { border-radius: 26rpx; }
