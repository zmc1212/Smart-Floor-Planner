<wxs src="../../../utils/stat-format.wxs" module="stat" />

<scroll-view scroll-y class="history-page" lower-threshold="120" bindscrolltolower="loadMore" refresher-enabled refresher-triggered="{{refreshing}}" bindrefresherrefresh="reload">
  <view class="history-shell">
    <view class="history-hero">
      <view class="history-head">
      <text class="history-title">我的设计</text>
      <text class="history-count">{{stat.count(items.length)}} 条</text>
      </view>
      <image class="history-archive-scene" src="/packages/ai-workflow/assets/page-ip-v3/ai-history.jpg" mode="aspectFit"></image>
    </view>

    <view class="history-filters">
      <view wx:for="{{historyFilters}}" wx:key="value" class="history-filter {{activeFilter === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="selectHistoryFilter">{{item.label}}</view>
    </view>

    <view wx:if="{{filteredItems.length}}" class="history-list">
      <view wx:for="{{filteredItems}}" wx:key="id" class="history-item">
        <image wx:if="{{item.resultImageUrl || item.spaceImageUrl}}" class="history-image" src="{{item.resultImageUrl || item.spaceImageUrl}}" mode="aspectFill" data-id="{{item.id}}" bindtap="openResult"></image>
        <view wx:else class="history-image history-image-placeholder" data-id="{{item.id}}" bindtap="openResult"><text>AI</text></view>
        <view class="history-body">
          <view class="history-info" data-id="{{item.id}}" bindtap="openResult">
            <text class="history-time">{{item.timeLabel}}</text>
            <text class="item-title">{{item.modeTitle}}</text>
            <text wx:if="{{item.recipeName}}" class="recipe-origin">装修配方</text>
            <text wx:if="{{item.projectTitle}}" class="item-project">{{item.projectTitle}}</text>
            <view wx:if="{{item.targetLabel}}" class="item-target-row">
              <image class="item-target-icon" src="/images/leads-v4/map-pin.png" mode="aspectFit"></image>
              <text class="item-target">{{item.targetLabel}}</text>
            </view>
            <view class="sync-row">
              <text class="sync-chip {{item.syncedToWorkflow ? 'synced' : ''}}">{{item.syncedToWorkflow ? '已同步方案' : '独立任务'}}</text>
              <text wx:if="{{item.workflowTitle}}" class="workflow-name">{{item.workflowTitle}}</text>
            </view>
            <view class="item-status-row {{item.statusClass}}">
              <view class="item-status-dot"></view>
              <text class="item-meta">{{item.statusLabel}} · {{stat.count(item.credits)}} 点</text>
            </view>
            <view wx:if="{{item.statusClass === 'processing' && !item.recipeId}}" class="history-progress-track"><view class="history-progress-bar" style="width: {{item.progress}}%;"></view></view>
          </view>
          <view class="item-actions">
            <button wx:if="{{item.canOpenScheme}}" class="mini-action primary" data-id="{{item.id}}" catchtap="openScheme">进入方案</button>
            <button class="mini-action" data-id="{{item.id}}" catchtap="reuse">再设计</button>
            <button class="mini-action danger" data-id="{{item.id}}" catchtap="remove">删除</button>
          </view>
        </view>
        <image class="history-chevron" src="/images/leads-v4/chevron-right.png" mode="aspectFit" data-id="{{item.id}}" bindtap="openResult"></image>
      </view>
      <view wx:if="{{loading}}" class="loading-more">加载中...</view>
    </view>

    <view wx:else class="history-empty">
      <view class="empty-mark">AI</view>
      <text class="empty-title">还没有使用过装修配方</text>
    </view>
  </view>
</scroll-view>
