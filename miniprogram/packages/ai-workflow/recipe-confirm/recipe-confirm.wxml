<view class="confirm-page">
  <view class="confirm-nav" style="padding-top:{{navigationTop}}px;padding-right:{{navigationRight}}px;min-height:{{navigationTop + navigationHeight}}px"><view class="nav-back" bindtap="goBack"><view></view></view><view><text>确认生成</text><text>{{inputMode === 'photo' ? '上传照片后即可出图并发送' : '核对这次配方会应用到哪里'}}</text></view></view>
  <view wx:if="{{loading}}" class="confirm-state"><view class="state-card shimmer"></view><text>正在准备生成清单…</text></view>
  <view wx:elif="{{error}}" class="confirm-state"><text class="state-title">确认信息加载失败</text><text>{{error}}</text><view class="state-action" bindtap="retry">重新加载</view></view>
  <scroll-view wx:else scroll-y enhanced show-scrollbar="{{false}}" class="confirm-scroll"><view class="confirm-content">
    <view class="confirm-recipe"><image wx:if="{{recipe.previewUrl}}" src="{{recipe.previewUrl}}" mode="aspectFill"></image><view class="confirm-shade"></view><view><text>装修配方</text><text>{{recipe.name}}</text><text>{{recipe.categoryName}} · {{recipe.spaceLabel}}</text></view></view>
    <view class="confirm-list"><view><text>客户</text><view><text>{{leadName}}</text><text>{{communityName}}</text></view></view><view><text>方案</text><view><text>{{schemeTitle}}</text><text>续接当前方案对话</text></view></view><view wx:if="{{scope}}"><text>设计范围</text><view><text>{{scope.name}}</text><text>{{scope.meta}}</text></view></view><view><text>预计点数</text><view><text>{{price}} 点</text><text>创建时冻结，失败自动释放</text></view></view></view>
    <view wx:if="{{inputMode === 'photo'}}" class="photo-block"><view class="block-head"><view><text>补充现场照片</text><text>先选客厅、主卧或主卫，再拍照、从相册或本户现场图选用</text></view><view wx:if="{{spaceImagePath}}" bindtap="removePhoto">删除</view></view><view wx:if="{{!spaceImagePath}}" class="photo-uploader" bindtap="choosePhoto"><image src="/images/ai-design-icons/reference.png" mode="aspectFit"></image><text>拍摄或选择照片</text><text>建议光线充足、空间边界完整</text></view><view wx:else class="photo-preview"><image src="{{spaceImagePath}}" mode="aspectFill"></image><view class="photo-status {{uploadError ? 'failed' : uploading ? 'uploading' : 'ready'}}">{{uploadError ? '上传失败' : uploading ? '正在上传' : sourceResultTaskId ? '已选客户成果' : '图片已就绪'}}</view><view wx:if="{{uploadError}}" class="photo-retry" bindtap="retryPhoto">重新上传</view><view wx:elif="{{!uploading}}" class="photo-retry" bindtap="choosePhoto">替换</view></view><view wx:if="{{customerResults.length}}" class="customer-result-source"><text>该客户已有成果</text><scroll-view scroll-x show-scrollbar="{{false}}"><view class="customer-result-row"><view wx:for="{{customerResults}}" wx:key="id" class="customer-result-card {{sourceResultTaskId === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectCustomerResult"><image src="{{item.resultImageUrl}}" mode="aspectFill"></image><text>{{item.targetLabel || '当前空间方案'}}</text></view></view></scroll-view></view></view>
    <view class="workflow-note"><image src="/images/mine-icons/shield-check.png" mode="aspectFit"></image><view><text>本次将续接到当前方案</text><text>配方会进入「{{schemeTitle}}」再出一轮，不会另开新方案。页面不会显示内部方案编号。</text></view></view>
    <view class="confirm-safe"></view>
  </view></scroll-view>
  <view wx:if="{{recipe && !workflowConflictOpen}}" class="confirm-bottom"><view class="generate-action {{submitting || uploading ? 'disabled' : ''}}" bindtap="startGeneration">{{submitting ? '正在创建任务…' : uploading ? '等待图片上传' : '开始生成 · ' + price + ' 点'}}</view></view>
  <view wx:if="{{workflowConflictOpen}}" class="conflict-overlay" bindtap="closeWorkflowConflict"><view class="conflict-sheet" catchtap="noop"><view class="sheet-handle"></view><text class="conflict-title">选择要继续的客户方案</text><text class="conflict-copy">同一客户存在多个正在使用的方案，需要你确认本次成果归到哪里。</text><view class="workflow-options"><view wx:for="{{workflows}}" wx:key="id" class="workflow-option {{selectedWorkflowId === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectWorkflow"><view class="radio"><view></view></view><view><text>{{item.title || '客户设计方案'}}</text><text>继续现有方案，保留此前成果</text></view></view><view class="workflow-option {{createNewWorkflow ? 'active' : ''}}" bindtap="selectNewWorkflow"><view class="radio"><view></view></view><view><text>新建备选方案</text><text>与现有方案分开保存</text></view></view></view><view class="conflict-action" bindtap="startGeneration">确认并开始生成</view></view></view>
  <site-photo-grid
    wx:if="{{inputMode === 'photo' && leadId}}"
    embed="{{false}}"
    lead-id="{{leadId}}"
    photos="{{sitePhotos}}"
    space-tags="{{sitePhotoTags}}"
    show-add="{{false}}"
    uploading="{{uploading}}"
    limit-reached="{{sitePhotoLimitReached}}"
    capture-nonce="{{sitePhotoCaptureNonce}}"
    capture-source="{{sitePhotoCaptureSource}}"
    bind:captured="onSitePhotoCaptured"
    bind:change="onSitePhotosChange"
    bind:uploading="onSitePhotoUploading"
  />
  <view wx:if="{{galleryMounted}}" class="gallery-root">
    <view class="gallery-mask {{galleryOpen ? 'open' : ''}}" bindtap="closeGalleryPicker"></view>
    <view class="gallery-sheet {{galleryOpen ? 'open' : ''}}" catchtap="noop">
      <view class="sheet-handle"></view>
      <text class="gallery-title">本户现场图</text>
      <text class="gallery-copy">点选一张已拍好的房间照片，直接用于这次出图</text>
      <site-photo-grid
        lead-id="{{leadId}}"
        photos="{{sitePhotos}}"
        space-tags="{{sitePhotoTags}}"
        mode="picker"
        show-add="{{false}}"
        selected-asset-id="{{spaceAssetId}}"
        bind:select="onSitePhotoSelect"
      />
    </view>
  </view>
</view>
