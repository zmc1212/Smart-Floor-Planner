.detail-page{min-height:100vh;background:#f6f7f4;color:#101613}.detail-nav{padding-left:24rpx;padding-bottom:12rpx;display:flex;align-items:flex-end;gap:12rpx;box-sizing:border-box}.detail-nav>text{height:64rpx;display:flex;align-items:center;font-size:34rpx;font-weight:800}.back-action{width:72rpx;height:64rpx;display:flex;align-items:center;justify-content:center}.back-action view{width:20rpx;height:20rpx;border-left:4rpx solid #18201b;border-bottom:4rpx solid #18201b;transform:rotate(45deg)}.detail-scroll{height:calc(100vh - 104rpx)}.detail-content{padding:12rpx 32rpx 0}.detail-hero{height:620rpx;position:relative;overflow:hidden;border-radius:40rpx;background:#003a24;box-shadow:0 18rpx 44rpx rgba(0,59,35,.16)}.detail-hero>image,.detail-placeholder{position:absolute;inset:0;width:100%;height:100%}.detail-placeholder{display:flex;align-items:center;justify-content:center;background:linear-gradient(145deg,#0e6842,#003a24)}.detail-placeholder image{width:100rpx;height:100rpx;filter:brightness(0) invert(1);opacity:.7}.detail-shade{position:absolute;inset:35% 0 0;background:linear-gradient(0deg,rgba(2,28,16,.97),rgba(2,32,18,.55),transparent)}.detail-bookmark{position:absolute;left:24rpx;top:0;min-height:60rpx;padding:0 22rpx 4rpx;border-radius:0 0 18rpx 18rpx;background:#004c2b;color:#fff;display:flex;align-items:center;font-size:20rpx;font-weight:700}.detail-hero-copy{position:absolute;left:28rpx;right:28rpx;bottom:28rpx;display:flex;flex-direction:column;color:#fff}.detail-hero-copy text:first-child{font-size:42rpx;line-height:1.15;font-weight:800}.detail-hero-copy text:last-child{margin-top:12rpx;font-size:22rpx;line-height:1.5;color:#d9e8de}.recipe-facts{margin-top:24rpx;padding:6rpx 24rpx;border-radius:30rpx;background:#fff;box-shadow:0 8rpx 28rpx rgba(24,39,30,.06)}.recipe-facts>view{min-height:94rpx;display:flex;align-items:center;justify-content:space-between;gap:24rpx}.recipe-facts>view+view{position:relative}.recipe-facts>view+view:before{content:'';position:absolute;left:0;right:0;top:0;height:1rpx;background:#e4e9e5;transform:scaleY(.5)}.recipe-facts text:first-child{font-size:22rpx;color:#6b746e}.recipe-facts text:last-child{max-width:450rpx;text-align:right;font-size:24rpx;font-weight:650}.input-choice{margin-top:34rpx}.block-title{font-size:30rpx;font-weight:800}.choice-row{margin-top:18rpx;display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.choice-card{min-height:210rpx;padding:24rpx 18rpx;border-radius:28rpx;background:#fff;display:flex;flex-direction:column;align-items:flex-start;box-sizing:border-box;box-shadow:0 8rpx 26rpx rgba(24,39,30,.06)}.choice-card.active{background:#effbf3;box-shadow:inset 0 0 0 3rpx #00bd57,0 8rpx 26rpx rgba(24,39,30,.05)}.choice-card image{width:52rpx;height:52rpx}.choice-card text:nth-child(2){margin-top:16rpx;font-size:24rpx;font-weight:750}.choice-card text:last-child{margin-top:8rpx;font-size:20rpx;line-height:1.35;color:#6b746e}.material-notice{min-height:150rpx;margin-top:28rpx;padding:24rpx;border-radius:28rpx;background:#e9f8ef;display:flex;align-items:center;gap:20rpx;box-sizing:border-box}.material-notice image{width:60rpx;height:60rpx}.material-notice>view{display:flex;flex-direction:column;gap:8rpx}.material-notice text:first-child{font-size:24rpx;font-weight:750;color:#004c2b}.material-notice text:last-child{font-size:20rpx;line-height:1.45;color:#4e6658}.detail-safe-space{height:180rpx}.detail-bottom{position:fixed;z-index:10;left:0;right:0;bottom:0;padding:20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));background:rgba(255,255,255,.97);box-shadow:0 -10rpx 30rpx rgba(20,37,27,.06)}.use-recipe{height:96rpx;border-radius:28rpx;background:#00bd57;color:#fff;display:flex;align-items:center;justify-content:center;font-size:28rpx;font-weight:800;box-shadow:0 12rpx 24rpx rgba(0,162,73,.2)}.detail-state{min-height:70vh;padding:64rpx 40rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;box-sizing:border-box;color:#6b746e;font-size:22rpx}.state-art{width:100%;height:420rpx;border-radius:40rpx;margin-bottom:24rpx}.state-title{font-size:30rpx;font-weight:750;color:#101613}.state-action{min-width:220rpx;min-height:88rpx;margin-top:28rpx;border-radius:44rpx;background:#00bd57;color:#fff;display:flex;align-items:center;justify-content:center;font-size:24rpx;font-weight:700}.shimmer{background:linear-gradient(105deg,#e5e9e5 20%,#f4f6f3 42%,#e5e9e5 64%);background-size:240% 100%;animation:shimmer 1.25s linear infinite}@keyframes shimmer{to{background-position:-240% 0}}
