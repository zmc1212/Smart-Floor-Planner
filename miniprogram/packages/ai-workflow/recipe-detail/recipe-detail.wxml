<view class="detail-page">
  <view class="detail-nav" style="padding-top: {{navigationTop}}px; padding-right: {{navigationRight}}px; min-height: {{navigationTop + navigationHeight}}px;">
    <view class="back-action" bindtap="goBack"><view></view></view>
    <text>装修配方</text>
  </view>
  <view wx:if="{{loading}}" class="detail-state"><view class="state-art shimmer"></view><text>正在带入客户方案…</text></view>
  <view wx:elif="{{error}}" class="detail-state"><text class="state-title">这份配方暂时无法使用</text><text>{{error}}</text><view class="state-action" bindtap="retry">重新加载</view></view>
</view>
