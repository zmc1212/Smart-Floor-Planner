.result-page {
  width: 100%;
  height: 100vh;
  overflow-x: hidden;
  background: #fafbf8;
  color: var(--text-primary);
}

.result-shell {
  min-height: 100%;
  width: 100%;
  padding: 0 24rpx calc(18rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
  box-sizing: border-box;
}

button::after {
  border: none;
}

.state-panel {
  min-height: 650rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: var(--bg-surface);
  border: 1rpx solid rgba(207, 220, 207, 0.55);
  border-radius: 32rpx;
  box-shadow: var(--shadow-card);
  text-align: center;
  box-sizing: border-box;
}

.state-spinner {
  width: 72rpx;
  height: 72rpx;
  border: 7rpx solid var(--brand-primary-20);
  border-top-color: var(--brand-primary);
  border-radius: var(--radius-full);
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.processing-mark,
.failed-mark {
  width: 108rpx;
  height: 108rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
  font-size: 34rpx;
  font-weight: var(--font-weight-bold);
}

.processing-mark {
  background: var(--brand-primary-20);
  color: var(--brand-primary);
  animation: pulse 1.5s ease-in-out infinite;
}

.failed-mark {
  background: #fff0ee;
  color: #dc4b3e;
}

@keyframes pulse {
  50% { opacity: 0.58; transform: scale(0.96); }
}

.state-title {
  margin-top: 30rpx;
  font-size: 34rpx;
  font-weight: var(--font-weight-bold);
}

.state-meta,
.error-message {
  margin-top: 16rpx;
  color: var(--text-secondary);
  font-size: 23rpx;
  line-height: 1.55;
}

.progress-track {
  width: 78%;
  height: 10rpx;
  margin-top: 10rpx;
  overflow: hidden;
  background: var(--brand-primary-20);
  border-radius: var(--radius-full);
}

.progress-copy {
  width: 78%;
  margin-top: 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--text-secondary);
  font-size: 22rpx;
}

.progress-value {
  color: var(--text-brand);
  font-size: 27rpx;
  font-weight: var(--font-weight-bold);
}

.progress-bar {
  height: 100%;
  background: var(--brand-primary);
  border-radius: var(--radius-full);
  transition: width 0.3s ease;
}

.retry-button {
  min-width: 276rpx;
  height: 88rpx;
  margin-top: 36rpx;
  padding: 0 34rpx;
  border: none;
  border-radius: var(--radius-full);
  background: var(--brand-primary);
  color: var(--text-inverse);
  font-size: 27rpx;
  line-height: 88rpx;
}

.result-heading {
  position: relative;
  min-height: 146rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 2rpx;
  background: #fff;
}

/* all-pages-ip-v3 / 15-ai-design-result */
.result-delivery-character {
  position: absolute;
  right: 10rpx;
  bottom: -2rpx;
  width: 178rpx;
  height: 168rpx;
  overflow: hidden;
  z-index: 1;
}

.result-delivery-scene {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 178rpx;
  height: 168rpx;
}
.complete-chip {
  position: absolute;
  top: 0;
  left: 59%;
  z-index: 2;
  min-height: 50rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: translateX(-50%);
  background: rgba(255, 255, 255, 0.96);
  border: 2rpx solid var(--brand-primary-80);
  border-radius: var(--radius-full);
  color: var(--text-brand);
  font-size: 24rpx;
  font-weight: var(--font-weight-medium);
  box-sizing: border-box;
  white-space: nowrap;
}

.complete-chip::after {
  content: '';
  position: absolute;
  right: 20rpx;
  bottom: -10rpx;
  width: 16rpx;
  height: 16rpx;
  background: #fff;
  border-right: 2rpx solid var(--brand-primary-80);
  border-bottom: 2rpx solid var(--brand-primary-80);
  transform: rotate(45deg);
}

.complete-check {
  width: 19rpx;
  height: 11rpx;
  margin: -5rpx 12rpx 0 0;
  border-bottom: 4rpx solid var(--brand-primary);
  border-left: 4rpx solid var(--brand-primary);
  transform: rotate(-45deg);
  box-sizing: border-box;
}

.delivery-bubble {
  position: absolute;
  left: 50%;
  bottom: 8rpx;
  z-index: 2;
  width: 316rpx;
  min-height: 66rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  transform: translateX(-50%);
  background: rgba(255, 255, 255, 0.96);
  border-radius: 24rpx;
  box-shadow: 0 12rpx 28rpx rgba(35, 47, 38, 0.12);
  color: var(--text-primary);
  font-size: 24rpx;
  font-weight: var(--font-weight-medium);
  line-height: 1.35;
  box-sizing: border-box;
}

.compare-stage {
  position: relative;
  width: 100%;
  height: 680rpx;
  overflow: hidden;
  background: var(--neutral-100);
  border: 1rpx solid rgba(207, 220, 207, 0.48);
  border-radius: 26rpx;
  box-shadow: 0 14rpx 34rpx rgba(41, 58, 45, 0.12);
  box-sizing: border-box;
}

.compare-image {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.before-layer {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  overflow: hidden;
}

.before-image {
  width: calc(100vw - 80rpx);
  max-width: none;
}

.compare-line {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 3rpx;
  margin-left: -1rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 0 12rpx rgba(31, 41, 55, 0.24);
}

.compare-handle {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: translate(-50%, -50%);
  background: var(--bg-surface);
  border: 1rpx solid rgba(207, 220, 207, 0.55);
  border-radius: var(--radius-full);
  box-shadow: var(--shadow-float);
}

.compare-handle-icon {
  width: 30rpx;
  height: 30rpx;
}

.compare-label {
  position: absolute;
  bottom: 18rpx;
  top: auto;
  min-height: 46rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  border-radius: 18rpx;
  color: var(--text-inverse);
  font-size: 26rpx;
  font-weight: var(--font-weight-medium);
  box-sizing: border-box;
  backdrop-filter: blur(10rpx);
}

.before-label { left: 28rpx; background: rgba(45, 45, 45, 0.64); }
.after-label { right: 28rpx; background: var(--brand-primary); }

.result-actions {
  position: relative;
  min-height: 100rpx;
  margin-top: 12rpx;
  padding: 4rpx;
  display: flex;
  align-items: center;
  overflow: hidden;
  background: var(--bg-surface);
  border: 1rpx solid rgba(207, 220, 207, 0.46);
  border-radius: 26rpx;
  box-shadow: var(--shadow-card);
  box-sizing: border-box;
}

.result-action {
  position: relative;
  flex: 1 1 0%;
  width: 0;
  min-width: 0 !important;
  max-width: none;
  height: 92rpx;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  border-radius: 18rpx;
  background: transparent;
  color: var(--text-brand);
  font-size: 24rpx;
  font-weight: var(--font-weight-medium);
  line-height: 1;
  box-sizing: border-box;
}

.action-share {
  background: transparent;
  color: var(--text-brand);
  box-shadow: none;
}

.action-pressed { background: var(--brand-primary-20); }
.primary-pressed { opacity: 0.86; }

.action-icon-image {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  margin-right: 8rpx;
}

.result-action + .result-action::before {
  content: '';
  position: absolute;
  top: 26rpx;
  bottom: 26rpx;
  left: 0;
  width: 1px;
  background: rgba(209, 213, 219, 0.72);
  transform: scaleX(0.5);
  transform-origin: center;
  pointer-events: none;
}

.task-summary {
  margin-top: 24rpx;
  padding: 0 28rpx;
  background: var(--bg-surface);
  border: 1rpx solid rgba(207, 220, 207, 0.46);
  border-radius: 28rpx;
  box-shadow: var(--shadow-card);
  box-sizing: border-box;
}

.summary-item {
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  position: relative;
}

.summary-item::after {
  content: '';
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 1px;
  background: rgba(209, 213, 219, 0.62);
  transform: scaleY(0.5);
  transform-origin: center bottom;
}

.summary-item:last-child::after { display: none; }

.summary-label {
  flex: 1;
  color: var(--neutral-700);
  font-size: 27rpx;
}

.summary-value {
  max-width: 58%;
  overflow: hidden;
  color: var(--text-primary);
  font-size: 27rpx;
  font-weight: var(--font-weight-medium);
  white-space: nowrap;
  text-overflow: ellipsis;
}

.summary-workflow-value { font-weight: var(--font-weight-medium); }
.summary-points { font-weight: var(--font-weight-bold); }

.summary-icon {
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
}

.summary-icon-credit { width: 34rpx; height: 34rpx; }

.bottom-actions {
  margin-top: 26rpx;
  display: flex;
  align-items: center;
  width: 100%;
}

.bottom-action {
  flex: 1 1 0%;
  width: 0;
  min-width: 0 !important;
  height: 84rpx;
  margin: 0;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--border-brand);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.72);
  color: var(--text-brand);
  font-size: 32rpx;
  font-weight: var(--font-weight-medium);
  line-height: 1;
  box-sizing: border-box;
}

.bottom-action + .bottom-action {
  margin-left: 20rpx;
}

.bottom-action:first-child {
  border-color: transparent;
  background: linear-gradient(135deg, #0fb04d 0%, #18a94b 100%);
  color: var(--text-inverse);
  box-shadow: 0 10rpx 20rpx rgba(17, 164, 66, 0.20);
}

.outline-pressed { background: var(--brand-primary-20); }

@media (max-width: 360px) {
  .result-shell { padding-right: 24rpx; padding-left: 24rpx; }
  .result-heading { min-height: 146rpx; }
  .delivery-bubble { width: 316rpx; font-size: 24rpx; }
  .result-actions { margin-right: -2rpx; margin-left: -2rpx; }
  .result-action { font-size: 20rpx; }
  .action-icon-image { width: 26rpx; height: 26rpx; margin-right: 6rpx; }
}
