<scroll-view scroll-y enhanced show-scrollbar="{{false}}" scroll-top="{{pageScrollTop}}" class="result-page">
  <view class="result-shell sfp-scroll-content">
    <view wx:if="{{loading}}" class="state-panel">
      <view class="state-spinner"></view>
      <text class="state-title">正在加载成果</text>
      <text class="state-meta">请稍候，正在读取本次设计任务</text>
    </view>

    <block wx:elif="{{task}}">
      <view wx:if="{{task.status === 'created' || task.status === 'pending' || task.status === 'processing'}}" class="state-panel processing">
        <view class="processing-mark">AI</view>
        <text class="state-title">正在重塑空间</text>
        <view class="progress-copy">
          <text>生成进度</text>
          <text class="progress-value">{{task.progress}}%</text>
        </view>
        <view class="progress-track"><view class="progress-bar" style="width: {{task.progress}}%;"></view></view>
        <text class="state-meta">已冻结 {{task.credits}} 点，失败会自动释放</text>
      </view>

      <view wx:elif="{{task.status === 'failed'}}" class="state-panel failed">
        <view class="failed-mark">!</view>
        <text class="state-title">本次生成没有完成</text>
        <text class="error-message">{{task.error || 'AI 服务暂时不可用'}}</text>
        <button class="retry-button" disabled="{{running}}" bindtap="retry">{{running ? '重试中...' : '重新生成'}}</button>
      </view>

      <block wx:elif="{{task.status === 'succeeded'}}">
        <view class="result-heading">
          <view class="complete-chip">
            <view class="complete-check"></view>
            <text>{{task.workflowId ? '已同步方案' : '设计已完成'}}</text>
          </view>
          <view class="delivery-bubble">
            <text>方案已生成，看看效果如何吧！</text>
          </view>
          <view class="result-delivery-character">
            <image class="result-delivery-scene" src="/images/page-ip-v3/ai-result.png" mode="aspectFit"></image>
          </view>
        </view>

        <view wx:if="{{task.showComparison}}" class="compare-stage {{task.floorPlanCompare ? 'floor-plan-compare' : ''}}" style="height: {{task.resultStageHeight}}rpx;" bindtouchstart="handleCompareTouch" catchtouchmove="handleCompareTouch">
          <image class="compare-image" src="{{task.resultImageUrl}}" mode="{{task.floorPlanCompare || task.preserveComposition ? 'aspectFit' : 'aspectFill'}}"></image>
          <view class="before-layer" style="width: {{comparePercent}}%;">
            <image class="compare-image before-image" src="{{task.sourceCompareImageUrl}}" mode="{{task.floorPlanCompare || task.preserveComposition ? 'aspectFit' : 'aspectFill'}}"></image>
          </view>
          <view class="compare-line" style="left: {{comparePercent}}%;">
            <view class="compare-handle">
              <image class="compare-handle-icon" src="/packages/ai-workflow/assets/result-icons/move-horizontal.png" mode="aspectFit"></image>
            </view>
          </view>
          <view class="compare-label before-label">{{task.preserveComposition ? '参考构图' : task.floorPlanCompare ? '原始户型' : '原空间'}}</view>
          <view class="compare-label after-label">{{task.floorPlanCompare ? '全屋效果' : 'AI 方案'}}</view>
        </view>

        <view wx:else class="compare-stage single-result" style="height: {{task.resultStageHeight}}rpx;">
          <image class="compare-image" src="{{task.resultImageUrl}}" mode="aspectFill"></image>
          <view class="compare-label after-label">AI 概念方案</view>
        </view>

        <view class="result-actions">
          <button class="result-action" hover-class="action-pressed" bindtap="previewResult">
            <image class="action-icon-image" src="/packages/ai-workflow/assets/result-icons/eye.png" mode="aspectFit"></image>
            <text>预览</text>
          </button>
          <button class="result-action action-save" hover-class="action-pressed" disabled="{{saving}}" bindtap="saveResult">
            <image class="action-icon-image" src="/packages/ai-workflow/assets/result-icons/download.png" mode="aspectFit"></image>
            <text>{{saving ? '保存中' : '保存'}}</text>
          </button>
          <button class="result-action action-share" hover-class="primary-pressed" open-type="share">
            <image class="action-icon-image" src="/packages/ai-workflow/assets/result-icons/share-white.png" mode="aspectFit"></image>
            <text>分享</text>
          </button>
          <button class="result-action" hover-class="action-pressed" bindtap="handlePrimaryAction">
            <image class="action-icon-image" src="/packages/ai-workflow/assets/result-icons/refresh-cw.png" mode="aspectFit"></image>
            <text>继续优化</text>
          </button>
          <button class="result-action" hover-class="action-pressed" bindtap="openHistory">
            <image class="action-icon-image" src="/packages/ai-workflow/assets/result-icons/history.png" mode="aspectFit"></image>
            <text>查看历史</text>
          </button>
        </view>

        <view class="task-summary">
          <view wx:if="{{task.workflowId}}" class="workflow-summary">
            <image class="summary-icon" src="/images/mine-icons/users.png" mode="aspectFit"></image>
            <view class="workflow-summary-copy">
              <text class="workflow-summary-label">所属客户方案</text>
              <text class="workflow-summary-title">{{task.workflowTitle || '客户 AI 方案'}}</text>
              <text wx:if="{{task.leadName}}" class="workflow-summary-meta">{{task.leadName}}</text>
            </view>
            <text class="workflow-summary-status">{{task.isSelectedBaseline ? '当前定稿' : '候选版本'}}</text>
          </view>
          <view class="summary-item">
            <image class="summary-icon" src="/images/ai-design-icons/palette.png" mode="aspectFit"></image>
            <text class="summary-label">生成模式</text>
            <text class="summary-value">{{task.modeTitle}}</text>
          </view>
          <view wx:if="{{task.targetLabel}}" class="summary-item">
            <image class="summary-icon" src="/images/ai-design-icons/floor-plan.png" mode="aspectFit"></image>
            <text class="summary-label">设计范围</text>
            <text class="summary-value">{{task.targetLabel}}</text>
          </view>
          <view class="summary-item">
            <image class="summary-icon summary-icon-credit" src="/images/mine-icons/wallet.png" mode="aspectFit"></image>
            <text class="summary-label">消耗点数</text>
            <text class="summary-value summary-points">{{task.credits}} 点</text>
          </view>
        </view>

        <view class="bottom-actions">
          <button class="bottom-action" hover-class="outline-pressed" bindtap="handlePrimaryAction">
            <text>{{task.canContinueWorkflow && task.nextStageKey === 'soft_furnishing' ? '继续软装' : task.canContinueWorkflow && task.nextStageKey === 'base_render' ? '换风格' : task.workflowId && task.hasExactTargetContext && task.nextStageKey ? '后台继续深化' : '继续优化'}}</text>
          </button>
          <button class="bottom-action" hover-class="outline-pressed" bindtap="openHistory">
            <text>查看历史</text>
          </button>
        </view>
      </block>
    </block>
  </view>
</scroll-view>
