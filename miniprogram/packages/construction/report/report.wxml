<view class="report-page">
  <image class="notebook-page-grain" src="../assets/notebook/capture-v3-paper.png" mode="aspectFill" aria-hidden="true" />
  <view class="book-spine" aria-hidden="true">
    <view class="book-stitch" style="top:84px" />
    <view class="book-stitch" style="top:37%" />
    <view class="book-stitch" style="top:65%" />
    <view class="book-stitch" style="bottom:28px" />
  </view>

  <view class="book-nav" style="padding-top:{{navTop}}px;padding-right:{{navRight}}px">
    <button class="book-back" bindtap="back" aria-label="返回"><image src="../assets/notebook/back.png" /></button>
    <text class="book-nav-title">现场上报</text>
  </view>

  <view class="report-scroll">
    <view class="report-content">
      <view wx:if="{{loading}}" class="state">正在读取工地…</view>
      <view wx:elif="{{error}}" class="state" role="alert">
        <text>{{error}}</text>
        <button class="primary" bindtap="back">返回工地</button>
      </view>
      <block wx:else>
        <view class="project-line">
          <text class="project-name">{{project.name}} · {{project.stageName}}</text>
        </view>

        <view class="paper stage-paper">
          <view class="stage-heading">
            <view class="fabric stage-fabric">阶段</view>
            <text class="stage-title">施工阶段（可多选）</text>
          </view>
          <view class="stage-chips">
            <view wx:for="{{stageChips}}" wx:key="key" class="stage-chip stage-choice {{item.selected ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="toggleStage" aria-role="button" aria-pressed="{{item.selected}}">
              <text class="stage-choice-face">{{item.name}}</text>
            </view>
          </view>
          <text class="helper">可多选 · 来自企业施工节点配置</text>
          <block wx:if="{{checkpoints.length}}">
            <text class="stage-title checkpoint-title">必须到场审核的工序（选填）</text>
            <view class="stage-chips">
              <button wx:for="{{checkpoints}}" wx:key="choiceId" class="stage-chip {{item.selected ? 'selected' : ''}}" data-id="{{item.choiceId}}" bindtap="toggleCheckpoint">{{item.name}}</button>
            </view>
          </block>
        </view>

        <view class="paper photo-paper">
          <view class="paper-heading">
            <view class="fabric">现场照片</view>
            <text class="paper-limit">最多9张</text>
          </view>
          <view class="photo-wall">
            <view wx:for="{{photos}}" wx:key="id" class="photo-cell">
              <image src="{{item.path}}" mode="aspectFill" data-path="{{item.path}}" bindtap="previewPhoto" />
              <button class="photo-remove" data-id="{{item.id}}" catchtap="removePhoto" aria-label="删除照片">×</button>
            </view>
            <view wx:if="{{photos.length < maxPhotos}}" class="photo-add" bindtap="addPhotos" aria-label="添加照片">
              <image class="photo-add-icon" src="../assets/notebook/camera.png" mode="aspectFit" aria-hidden="true" />
              <text>添加照片</text>
            </view>
          </view>
        </view>

        <view class="paper voice-paper">
          <view class="paper-heading"><view class="fabric">语音说明（选填）</view></view>
          <view wx:if="{{voice}}" class="voice-row recorded">
            <view class="voice-symbol" aria-hidden="true"><image class="voice-icon" src="../assets/notebook/mic.png" mode="aspectFit" /></view>
            <text class="voice-label">语音 {{voice.durationSeconds || 0}}秒</text>
            <button class="text-action" bindtap="playVoice">{{voicePlaying ? '停止' : '回听'}}</button>
            <button class="text-action voice-remove" bindtap="removeVoice">删除</button>
          </view>
          <view wx:else class="voice-row" bindtap="toggleRecord" aria-role="button">
            <view class="voice-symbol" aria-hidden="true"><image class="voice-icon" src="../assets/notebook/mic.png" mode="aspectFit" /></view>
            <text class="voice-label">{{recording ? '录音中 ' + recordSeconds + '秒 · 点击结束' : '点击录音'}}</text>
            <text class="voice-limit">最长60秒</text>
          </view>
        </view>

        <view class="paper text-paper">
          <view class="paper-heading"><view class="fabric">文字说明（选填）</view></view>
          <textarea class="report-textarea" value="{{text}}" maxlength="{{managerPublish ? 2000 : 4000}}" placeholder="补充说明，例如：客厅东墙线管已铺完，等待验收" bindinput="onTextInput" adjust-position="{{true}}" show-confirm-bar="{{false}}" />
          <text class="text-count">{{textLength}}/{{managerPublish ? 2000 : 4000}}</text>
        </view>

        <view wx:if="{{captureError}}" class="feedback" role="alert">
          <text>{{captureError}}</text>
          <button wx:if="{{queue.length}}" class="outline" bindtap="retryUpload" disabled="{{sending}}">重试上传</button>
        </view>
        <view wx:if="{{queue.length}}" class="queue-row">
          <text>{{sending ? '正在提交…' : checkpointChanged ? '必到工序已调整' : (managerPublish && queue[0].error) || '待提交 ' + queue.length + ' 条…'}}</text>
          <button wx:if="{{checkpointChanged}}" class="outline" bindtap="replaceCheckpoint" disabled="{{sending}}">重新选择工序</button>
          <button wx:elif="{{managerPublish && queue[0].targetChanged}}" class="outline" bindtap="replaceCheckpoint" disabled="{{sending}}">重新核对</button>
          <button wx:elif="{{managerPublish && !sending && !captureError}}" class="outline" bindtap="retryUpload">核对提交</button>
        </view>
        <text class="submit-helper">{{managerPublish ? '先核对内容和可见范围，再确认发布' : '提交后进入待审核，由施工经理、设计师或老板审核通过'}}</text>
      </block>
    </view>
  </view>

  <view class="report-footer">
    <button class="primary submit-button" bindtap="submit" loading="{{submitting}}" disabled="{{loading || submitting}}">{{managerPublish ? '预览并发布' : '提交审核'}}</button>
  </view>
  <view wx:if="{{preview}}" class="sheet-mask" bindtap="closePreview">
    <view class="sheet report-preview" catchtap="noop">
      <view class="report-preview-handle" aria-hidden="true" />
      <view class="sheet-heading">
        <text>{{preview.checkpoint ? '核对现场上报' : '发布给业主'}}</text>
        <button class="report-preview-close" bindtap="closePreview" aria-label="关闭"><image src="../assets/notebook/close.png" mode="aspectFit" aria-hidden="true" /></button>
      </view>
      <scroll-view class="sheet-body" scroll-y>
        <text class="report-preview-project">{{project.name}}</text>
        <view class="report-preview-paper">
          <text class="report-preview-stage">{{preview.stageNames}}</text>
          <text class="report-preview-text" user-select>{{preview.text}}</text>
          <view wx:if="{{preview.photos.length}}" class="photo-wall">
            <view wx:for="{{preview.photos}}" wx:key="id" class="photo-cell"><image src="{{item.path}}" mode="aspectFill" /></view>
          </view>
        </view>
        <view wx:if="{{preview.checkpoint}}" class="report-preview-scope">该工序需先到场审核。</view>
        <view wx:else class="report-preview-scope">
          <image class="report-preview-lock" src="../assets/notebook/lock-keyhole.png" mode="aspectFit" aria-hidden="true" />
          <view><text class="report-preview-scope-title">可见范围</text><text>本工地业主及已授权家人</text></view>
        </view>
      </scroll-view>
      <button class="primary submit-button" bindtap="confirmPublication" loading="{{submitting}}" disabled="{{submitting}}">{{preview.checkpoint ? '前往到场审核' : '确认发布 →'}}</button>
    </view>
  </view>
</view>
