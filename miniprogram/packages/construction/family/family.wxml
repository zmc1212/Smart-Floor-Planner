<template name="progress-nodes">
  <view wx:for="{{nodes}}" wx:key="key" class="node">
    <view class="node-dot dot-{{item.color}}"></view>
    <view class="node-body">
      <view class="node-title">{{item.roomName ? item.roomName + ' · ' : ''}}{{item.stageName}}</view>
      <view class="node-meta">{{item.label}}<text wx:if="{{item.timeText && item.timeText !== item.label}}"> · {{item.timeText}}</text><text wx:elif="{{!item.timeText && item.plannedStart}}"> · {{item.plannedStart}} 至 {{item.plannedEnd}}</text></view>
      <view wx:if="{{showReason && item.reason}}" class="node-reason">{{item.reason}}</view>
    </view>
  </view>
</template>

<view class="construction-page family-shell">
  <image class="family-paper-grain" src="../assets/notebook/capture-v3-paper.png" mode="aspectFill" aria-hidden="true" />
  <view class="book-spine" aria-hidden="true">
    <view class="book-stitch" style="top: 84px;" />
    <view class="book-stitch" style="top: 33%;" />
    <view class="book-stitch" style="top: 45%;" />
    <view class="book-stitch" style="bottom: 16%;" />
  </view>
  <view class="book-nav family-nav" style="padding-top: {{navTop}}px; padding-right: {{navRight}}px;">
    <button class="book-back" bindtap="goBack" aria-label="返回">
      <image class="family-back-icon" src="../assets/notebook/chevron.png" mode="aspectFit" aria-hidden="true" />
    </button>
    <text class="book-nav-title">云工地</text>
  </view>

  <view class="content family-content">
    <view wx:if="{{loading}}" class="state">正在读取云工地…</view>
    <view wx:elif="{{error || (progressError && progressError === cameraError)}}" class="state feedback">
      <text>{{error || progressError}}</text>
      <button wx:if="{{needLogin}}" class="text-action" bindtap="goLogin">去登录</button>
      <button wx:else class="text-action" bindtap="load">重试</button>
    </view>

    <view wx:elif="{{!projectId}}" class="project-list">
      <text class="page-title family-project-title">我的工地</text>
      <button wx:for="{{items}}" wx:key="id" class="paper project-card" data-id="{{item.id}}" bindtap="selectProject">
        <view class="project-card-main">
          <text class="project-name">{{item.name}}</text>
          <text class="project-role">{{item.role === 'owner' ? '我是业主' : '家人查看'}}</text>
        </view>
        <image class="book-icon" src="../assets/notebook/right.png" mode="aspectFit" aria-hidden="true" />
      </button>
    </view>

    <block wx:else>
      <view class="family-project-head">
        <text class="page-title family-project-title">{{projectName}}</text>
        <text class="family-role">家人 · 只读</text>
      </view>
      <view wx:if="{{cameraError}}" class="feedback family-section-state">{{cameraError}}</view>
      <view wx:elif="{{cameras.length}}" class="family-live">
        <view class="family-live-heading"><text class="fabric family-live-tab">直播</text></view>
        <view class="paper family-camera">
          <native-live-player id="family-live-player"
            src="{{liveSrc}}" epoch="{{liveEpoch}}" phase="{{livePhase}}" message="{{liveMessage}}" audio-allowed="{{true}}"
            bindadvance="onLiveAdvance" bindplaybackerror="onLiveError" bindplay="startFamilyLive" bindstop="stopFamilyLive"
          />
          <view class="family-live-caption">
            <picker wx:if="{{cameras.length > 1}}" class="family-camera-picker" range="{{cameras}}" range-key="name" value="{{cameraIndex}}" bindchange="switchFamilyCamera">
              <view class="family-camera-choice">
                <text class="family-camera-name">{{cameras[cameraIndex].name}}</text>
                <image class="family-caption-chevron" src="../assets/notebook/chevron.png" mode="aspectFit" aria-hidden="true" />
              </view>
            </picker>
            <text wx:else class="family-camera-name">{{cameras[0].name}}</text>
            <button size="mini" class="family-player-settings" bindtap="toggleFamilyLiveSettings" aria-expanded="{{liveSettings}}">
              <text>播放设置</text>
              <image class="family-caption-chevron" src="../assets/notebook/chevron.png" mode="aspectFit" aria-hidden="true" />
            </button>
          </view>
          <view wx:if="{{liveSettings}}" class="family-live-settings">
            <button class="text-action" bindtap="openCamera">用兼容播放器打开</button>
          </view>
        </view>
      </view>
      <view wx:if="{{progressError}}" class="feedback family-section-state">{{progressError}}</view>
      <view wx:elif="{{progress}}" class="paper family-progress">
        <view class="section-heading family-progress-head">
          <text class="fabric family-fabric">施工进度</text>
          <text class="stage-tag family-overall overall-{{progress.overall.color}}">{{progress.overall.label}}</text>
        </view>
        <text class="family-stage-label">当前节点</text>
        <text class="family-stage-value">{{progress.construction.stageName || '团队尚未标记'}}</text>
        <text class="family-summary">{{progress.available === false ? '施工计划尚未发布，暂无法判断进度是否正常。' : progress.summary}}</text>
        <template is="progress-nodes" data="{{nodes: progress.nodes, showReason: true}}" />
      </view>
      <view class="family-permission">
        <image class="family-permission-icon" src="../assets/notebook/lock-keyhole.png" mode="aspectFit" aria-hidden="true" />
        <view class="family-permission-copy">
          <text>家人可查看施工进度和直播。</text>
          <text>不会收到报告或提醒，也无法修改施工记录。</text>
        </view>
      </view>
    </block>
  </view>
</view>
