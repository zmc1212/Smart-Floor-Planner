<!-- Approved site-chat-record-interactions-v3, 853×1844 → 390×844. Native controls and originals only. -->
<view class="site-chat" style="height: {{viewportHeight - keyboardHeight}}px;">
  <view class="book-spine"><view wx:for="{{[0,1,2,3,4,5]}}" wx:key="*this" class="book-stitch" style="top:{{88 + item * 130}}px"/></view>
  <view class="book-nav" style="padding-top:{{navTop}}px;padding-right:{{navRight}}px"><button class="book-back" bindtap="back" aria-label="返回"><image src="../assets/notebook/back.png"/></button><text class="book-nav-title">工地交流</text></view>
  <view wx:if="{{project}}" class="project-context"><image class="book-icon" src="../assets/notebook/members.png"/><view><text class="project-name">{{project.name}} · {{project.stageName || '节点待标记'}}</text><text class="helper">项目成员共享</text></view></view>
  <scroll-view class="chat-scroll" scroll-y enhanced scroll-into-view="{{scrollTarget}}" show-scrollbar="{{false}}">
    <view class="chat-content">
      <view wx:if="{{loading}}" class="state">正在读取本工地对话…</view>
      <view wx:if="{{!loading && !fatal && !write}}" class="feedback">当前只可查看工地记录，发送和核对操作暂不可用。</view>
      <view wx:if="{{error}}" class="feedback" role="alert"><text>{{error}}</text><button wx:if="{{pending}}" bindtap="reconcile" disabled="{{busy}}">核对同一次操作</button><button wx:else bindtap="refresh" disabled="{{busy}}">重新读取</button></view>
      <view wx:if="{{speechBusy || speechError}}" class="feedback" role="status"><text>{{speechBusy ? '正在录音，结束后可回听并发送。' : speechError}}</text><button wx:if="{{!speechBusy}}" bindtap="voice">处理录音</button></view>
      <view wx:if="{{success && !error}}" class="success" aria-live="polite">{{success}}</view>
      <view wx:if="{{pending && !error}}" class="feedback"><text>提交结果待核对，原内容和版本已保留。</text><button bindtap="reconcile" disabled="{{busy}}">核对同一次操作</button></view>
      <button wx:if="{{nextCursor}}" class="text-button history" bindtap="older" disabled="{{busy}}">查看更早的对话</button>
      <view wx:if="{{!loading && !items.length && !captureQueue.length && !fatal}}" class="empty"><text>说说现场进展</text><text class="helper">拍照、说一句或选常用工作，发完可查看送达状态。</text></view>
      <view wx:for="{{items}}" wx:key="message.id" class="conversation-turn" id="source-{{item.message.id}}">
        <view class="source-message"><view class="source-copy"><view class="source-bubble"><text class="source-author">{{item.message.display_name || '项目成员'}} · {{item.time}}</text><text user-select>{{item.text}}</text>
          <button wx:if="{{item.record.speech}}" class="voice-original text-button" data-message="{{item.message.id}}" bindtap="voiceMessage">回听原音</button>
          <text wx:if="{{item.record.speech.transcript}}" class="speech-transcript" user-select>语音转写：{{item.record.speech.transcript}}</text>
          <view wx:if="{{item.record.captured && item.record.media.length}}" class="photo-grid capture-photos"><view wx:for="{{item.record.media}}" wx:for-item="media" wx:key="id" class="photo-slot" data-id="{{media.id}}" bindtap="preview"><image wx:if="{{mediaPaths[media.id]}}" src="{{mediaPaths[media.id]}}" mode="aspectFill"/><text wx:else>照片读取中</text></view></view>
        </view><view wx:if="{{item.record.captured}}" class="delivery-receipt received"><view class="receipt-badge"><image src="../assets/notebook/capture-received.png"/><text>已收到</text></view><text class="receipt-detail">{{item.record.status === 'published' ? '已核对发布' : item.record.status === 'withdrawn' ? '已撤回' : '等经理核对'}}</text></view></view></view>
        <view wx:if="{{!item.record.captured && item.record.media.length}}" class="source-photos"><text class="photos-label">{{item.response ? '资料原件' : '现场照片'}} · {{item.record.media.length}}张</text><view class="photo-grid"><view wx:for="{{item.record.media}}" wx:for-item="media" wx:key="id" class="photo-slot" data-id="{{media.id}}" bindtap="preview"><image wx:if="{{mediaPaths[media.id]}}" src="{{mediaPaths[media.id]}}" mode="aspectFill" /><text wx:else>照片读取中</text></view></view></view>
        <text wx:if="{{item.record.captured && item.record.generating}}" class="organizing-note">小K正在整理，原材料已收到。</text>
        <view wx:else class="xiaok-reply">
          <view class="xiaok-heading"><image wx:if="{{index === items.length - 1}}" class="xiaok-art" src="../assets/notebook/xiaok-chat.png" mode="aspectFit" /><text class="xiaok-name">小K</text><text class="xiaok-chip">{{item.response ? '项目协作' : '现场整理'}}</text></view>
          <text wx:if="{{item.response}}" class="reply-intro" user-select>{{item.response.text}}</text>
          <view wx:if="{{item.response && item.response.citations && item.response.citations.length}}" class="record-actions"><button wx:for="{{item.response.citations}}" wx:for-item="citation" wx:key="id" class="text-button" data-id="{{citation.id}}" bindtap="openCitation" disabled="{{busy || pending}}">知识来源 · {{citation.title}}</button></view>
          <text wx:else class="reply-intro">{{item.record.generating ? '原话和照片已保存，正在整理进展草稿…' : item.record.failed ? '本次整理未完成，原话和照片已保留。可以稍后重试，或先人工核对内容。' : item.record.status === 'changes_requested' ? (item.record.resubmittedRecordId ? '补拍已关联提交，请查看补交记录的审核结果。' : '请按补拍要求提供新照片，补交后等待管理人员复审。') : item.record.status === 'withdrawn' ? '这条发布记录已撤回，内部原始资料继续保留。' : item.record.media.length && item.record.image_input ? '我把这段话和照片整理成了进展草稿，发布前请核对一下。' : '按原话整理的进展草稿，照片随记录保留，发布前请核对一下。'}}</text>
          <view wx:if="{{!item.response}}" class="record-card">
            <view class="record-heading"><image src="../assets/notebook/file.png" mode="aspectFit" /><text class="record-title">{{item.record.data.title || '现场施工进展'}}</text><text class="status-chip">{{item.record.label}}</text></view>
            <view wx:for="{{item.record.rows}}" wx:for-item="row" wx:key="label" class="record-row {{row.coordination && item.record.data.coordination ? 'coordination' : ''}}"><text class="record-label">{{row.label}}</text><text class="record-value" user-select>{{row.value}}</text></view>
            <text wx:if="{{item.record.data.note}}" class="record-note" user-select>{{item.record.data.note}}</text>
            <text wx:if="{{item.record.resubmission_of_id}}" class="record-helper">补拍原记录 {{item.record.original_record_id}} · 上次提交 {{item.record.resubmission_of_id}}</text>
            <text wx:if="{{item.record.review_requirements}}" class="record-note" user-select>补拍要求：{{item.record.review_requirements}}</text>
            <text wx:if="{{item.record.resubmittedRecordId}}" class="record-helper">已关联补交记录 {{item.record.resubmittedRecordId}}，审核请查看该次提交。</text>
            <text class="record-helper">进展按原话整理，照片随记录保留。</text>
            <text wx:if="{{item.issue}}" class="record-helper" user-select>{{item.issue.text}}</text>
            <text wx:if="{{item.record.updatedLabel}}" class="record-helper">最后更新：{{item.record.updatedLabel}} · 版本 {{item.record.version}}</text>
            <view wx:if="{{item.record.status === 'published'}}" class="publication"><text>发布人：{{item.record.approved_name}} · 版本 {{item.record.published_version}}</text><text>{{item.record.scopeLabel}}</text></view>
            <text wx:elif="{{item.record.status === 'withdrawn'}}" class="record-helper">撤回原因：{{item.record.withdrawal_reason}}</text>
            <view wx:else class="scope-row">共享草稿：仅本项目成员可查看</view>
            <view wx:if="{{(item.record.canEdit || item.record.canResubmit) && write}}" class="record-actions">
              <button wx:if="{{item.record.canResubmit}}" class="primary begin-resubmit" data-id="{{item.record.id}}" bindtap="beginResubmit" disabled="{{busy || pending}}">按要求补拍</button>
              <button wx:elif="{{item.record.status === 'draft' && item.record.canPublish}}" class="primary" data-id="{{item.record.id}}" bindtap="openPublish" disabled="{{busy || pending}}">{{item.record.resubmission_of_id ? '复审并发布' : '核对发布'}}</button>
              <button wx:elif="{{item.record.canRetry}}" class="primary" data-id="{{item.record.id}}" bindtap="retry" disabled="{{busy || pending}}">重新整理</button>
              <button wx:if="{{item.record.canEdit}}" class="secondary" data-id="{{item.record.id}}" bindtap="openEdit" disabled="{{busy || pending}}">{{item.record.status === 'published' ? '更正内容' : '修改内容'}}</button>
            </view>
            <view class="record-links"><button class="text-button" data-id="{{item.record.id}}" bindtap="versions" disabled="{{busy || pending}}">原记录与版本</button><button wx:if="{{item.record.canRequestChanges && write}}" class="text-button request-changes" data-id="{{item.record.id}}" bindtap="openRequestChanges" disabled="{{busy || pending}}">打回补拍</button><button wx:if="{{item.record.status === 'published' && item.record.canEdit && write}}" class="text-button" data-id="{{item.record.id}}" bindtap="openWithdraw" disabled="{{busy || pending}}">撤回发布</button></view>
          </view>
        </view>
      </view>
      <view wx:for="{{captureQueue}}" wx:key="key" class="conversation-turn local-capture" id="capture-{{item.key}}">
        <view class="source-message"><view class="source-copy"><view class="source-bubble"><text class="source-author">我的现场上报</text><text user-select>{{item.text}}</text>
          <button wx:if="{{item.voice}}" class="text-button voice-original" data-path="{{item.voice.path}}" bindtap="playCapture">回听原音</button>
          <view wx:if="{{item.photos.length}}" class="photo-grid capture-photos"><view wx:for="{{item.photos}}" wx:for-item="photo" wx:key="id" class="photo-slot" data-path="{{photo.path}}" bindtap="previewCapture"><image src="{{photo.path}}" mode="aspectFill"/></view></view>
        </view><view class="delivery-receipt {{item.received ? 'received' : 'waiting'}}"><view class="receipt-badge"><image src="{{item.received ? '../assets/notebook/capture-received.png' : '../assets/notebook/capture-upload.png'}}"/><text>{{item.received ? '已收到' : item.uploading ? '发送中' : item.uncertain ? '送达待核对' : '待上传'}}</text></view><text class="receipt-detail">{{item.received ? '等经理核对' : '已留在手机'}}</text></view>
          <button wx:if="{{!item.received}}" class="text-button retry-capture" bindtap="retryCapture" disabled="{{captureSending || !write || fatal}}">{{item.uncertain ? '核对送达' : '继续上传'}}</button>
          <text wx:if="{{item.error && !item.received}}" class="helper">{{item.error}}</text>
        </view></view>
      </view>
      <view class="scroll-end"></view>
    </view>
  </scroll-view>
  <view class="composer-wrap">
    <view wx:if="{{resubmit || pendingRetakeCount}}" class="feedback"><text wx:if="{{resubmit}}">正在补拍原记录 {{resubmit.originalId}}，请按原记录中的要求添加新照片。</text><text wx:else>有{{pendingRetakeCount}}条施工记录需要补拍，请查看具体要求。</text><button wx:if="{{resubmit}}" bindtap="cancelResubmit" disabled="{{busy || pending}}">退出补拍</button><button wx:else class="view-retake" bindtap="showRetake" disabled="{{busy || pending}}">查看补拍要求</button></view>
    <view wx:if="{{attachments.length}}" class="queued-photos"><view wx:for="{{attachments}}" wx:key="*this" class="queued-photo"><image src="{{mediaPaths[item]}}" mode="aspectFill" data-id="{{item}}" bindtap="preview" /><button class="text-button" data-id="{{item}}" bindtap="removePhoto" disabled="{{busy || pending}}">移除</button></view></view>
    <view wx:if="{{captureError}}" class="feedback" role="alert">{{captureError}}</view>
    <view wx:if="{{capturePhotos.length}}" class="queued-photos"><view wx:for="{{capturePhotos}}" wx:key="id" class="queued-photo"><image src="{{item.path}}" mode="aspectFill" data-path="{{item.path}}" bindtap="previewCapture"/><button class="text-button" data-id="{{item.id}}" bindtap="removeCapture">移除</button></view></view>
    <view wx:if="{{captureVoice}}" class="queued-voice"><button class="text-button" bindtap="playCapture">回听录音 · {{captureVoice.durationSeconds}}秒</button><button class="text-button" data-id="{{captureVoice.id}}" bindtap="removeCapture">移除</button></view>
    <view wx:if="{{textMode || captureText || draft || resubmit}}" class="composer"><textarea class="composer-input" value="{{resubmit || draft || attachments.length ? draft : captureText}}" focus="{{inputFocus}}" placeholder="说说今天干了什么…" maxlength="4000" auto-height adjust-position="{{false}}" show-confirm-bar="{{false}}" aria-label="现场进展" bindinput="input" bindkeyboardheightchange="keyboard" disabled="{{busy || pending || !write || fatal}}"/></view>
    <view wx:if="{{captureText || capturePhotos.length || captureVoice || draft || attachments.length}}" class="capture-submit-row"><button class="primary capture-send" bindtap="send" disabled="{{busy || pending || !write || fatal || speechBusy || captureSaving}}" loading="{{captureSaving}}">发送</button></view>
    <view class="capture-secondary"><button class="quick-entry" bindtap="openQuickWork" disabled="{{!write || fatal || resubmit || busy || pending}}"><text>选常用工作</text></button><button class="type-entry" bindtap="typeReport" disabled="{{!write || fatal}}">打字</button></view>
    <view class="capture-actions"><button class="capture-action add-photo" bindtap="photo" disabled="{{busy || pending || !write || fatal || captureSaving || capturePhotos.length >= 4}}"><image src="../assets/notebook/capture-camera.png"/><text>拍照</text></button><button class="capture-action voice" bindtap="voice" disabled="{{busy || pending || !write || fatal || speechBusy || resubmit || captureSaving}}"><image src="../assets/notebook/capture-mic.png"/><text>说一句</text></button></view>
  </view>
  <view wx:if="{{sheet === 'quick'}}" class="sheet-mask quick-mask {{sheetOpen ? 'open' : ''}}" bindtap="closeSheet" catchtouchmove="stop"><view class="sheet quick-sheet" catchtap="stop">
    <view class="quick-heading"><text>选常用工作</text><button class="text-button" bindtap="closeSheet">收起</button></view>
    <text wx:if="{{captureError}}" class="feedback">{{captureError}}</text>
    <scroll-view scroll-y class="quick-body"><text class="quick-stage">{{project.stageKey === 'utilities' ? '水电常用' : project.stageKey === 'masonry_carpentry' ? '泥木常用' : '常用工作'}}</text>
      <view class="quick-works"><button wx:for="{{quickWorks}}" wx:key="id" class="quick-option {{quickChoice.workId === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectQuickWork"><image wx:if="{{quickChoice.workId === item.id}}" src="../assets/notebook/capture-check.png"/>{{item.label}}</button></view>
      <picker range="{{quickRooms}}" range-key="name" value="{{quickRoomIndex}}" bindchange="quickRoomChange"><view class="quick-room"><text>部位</text><text>{{quickRooms[quickRoomIndex].name}}</text><image src="../assets/notebook/chevron.png"/></view></picker>
      <text class="quick-progress-label">做到哪</text><view class="quick-progress"><button wx:for="{{progressOptions}}" wx:key="id" class="quick-option {{quickChoice.progress === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectQuickProgress"><image wx:if="{{quickChoice.progress === item.id}}" src="../assets/notebook/capture-check.png"/>{{item.label}}</button></view>
    </scroll-view>
    <view class="quick-footer"><button class="text-button" bindtap="quickToText">直接说或写</button><button class="primary quick-submit" bindtap="submitQuickWork" disabled="{{!quickChoice.workId || !quickChoice.progress || quickChoice.roomId === '' || captureSaving || !write || fatal}}">提交经理核对</button></view>
  </view></view>
  <view wx:elif="{{sheet}}" class="sheet-mask {{sheetOpen ? 'open' : ''}}" bindtap="closeSheet" catchtouchmove="stop"><view class="sheet" catchtap="stop">
    <view class="sheet-heading"><text>{{sheet === 'edit' ? '核对现场内容' : sheet === 'publish' ? '核对发布范围' : sheet === 'withdraw' ? '撤回发布' : sheet === 'request_changes' ? '打回并要求补拍' : sheet === 'source' ? '知识来源' : '原记录与版本'}}</text><button class="text-button" bindtap="closeSheet" disabled="{{busy || pending}}">关闭</button></view>
    <view wx:if="{{pending || error}}" class="feedback" role="alert"><text>{{pending ? '提交结果待核对，原内容和版本已保留。' : error}}</text><button wx:if="{{pending}}" bindtap="reconcile" disabled="{{busy}}">核对同一次操作</button></view>
    <scroll-view class="sheet-body {{sheet === 'edit' || sheet === 'versions' || sheet === 'source' || conflict ? 'is-long' : ''}}" scroll-y>
      <view wx:if="{{conflict}}" class="feedback"><text>最新版本 {{conflict.version}}：{{conflict.data.title}}</text><text class="helper">{{conflict.label}} · {{conflict.scopeLabel}}</text><text class="helper" user-select>施工部位：{{conflict.room_name_snapshot || '待核对'}}
本次完成：{{conflict.data.completed || '未说明'}}
尚未完成：{{conflict.data.pending || '未说明'}}
待沟通：{{conflict.data.coordination || '未说明'}}
{{conflict.data.note}}</text><button bindtap="adoptLatest" disabled="{{busy || pending}}">{{sheet === 'edit' ? '已核对最新版，保留我的修改' : '重新核对最新版'}}</button></view>
      <block wx:if="{{sheet === 'source'}}">
        <text wx:if="{{citationLoading}}" class="helper">正在核对资料访问权限…</text>
        <view wx:elif="{{citationError}}" class="feedback"><text>{{citationError}}</text><button class="text-button" bindtap="retryCitation">重试</button></view>
        <view wx:elif="{{citation && citation.available}}"><text class="record-title">{{citation.title}}</text><text class="helper">版本 {{citation.versionNumber}}{{citation.historical ? ' · 回答时引用的历史版本' : ''}}</text><text wx:if="{{citation.sourceLocation}}" class="helper" user-select>{{citation.sourceLocation}}</text><text class="record-note" user-select>{{citation.quote}}</text></view>
        <text wx:else class="helper">这份资料已撤回、过期或不再对当前身份开放。请重新提问。</text>
      </block>
      <block wx:elif="{{sheet === 'edit'}}">
        <text class="field-label">标题</text><input class="field" value="{{edit.title}}" maxlength="80" data-field="title" bindinput="editInput" />
        <text class="field-label">施工部位</text><picker range="{{roomOptions}}" range-key="name" value="{{selectedRoom}}" bindchange="roomChange"><view class="field">{{roomOptions[selectedRoom].name}}</view></picker>
        <text class="field-label">本次完成</text><textarea class="field" value="{{edit.completed}}" maxlength="1000" data-field="completed" bindinput="editInput" />
        <text class="field-label">尚未完成</text><textarea class="field" value="{{edit.pending}}" maxlength="1000" data-field="pending" bindinput="editInput" />
        <text class="field-label">待沟通</text><textarea class="field" value="{{edit.coordination}}" maxlength="1000" data-field="coordination" bindinput="editInput" />
        <text class="field-label">补充说明</text><textarea class="field" value="{{edit.note}}" maxlength="2000" data-field="note" bindinput="editInput" />
        <text class="helper">更正会撤销旧发布，需要重新核对发布；原话和照片保持原样。</text>
      </block>
      <block wx:elif="{{sheet === 'publish'}}"><view class="scope-row">本项目有效成员可查看</view><view wx:if="{{publishCanCustomer}}" class="scope-option"><text>同时向本项目业主开放本条记录及照片</text><switch checked="{{publishCustomer}}" bindchange="publishScope" color="#00C888" /></view><text class="helper">业主不会加入内部对话。发布不代表微信订阅通知已送达，也不代表正式方案、费用、工期或验收批准。</text></block>
      <block wx:elif="{{sheet === 'withdraw'}}"><text class="field-label">撤回原因</text><textarea class="field" value="{{withdrawalReason}}" maxlength="500" bindinput="reason" /><text class="helper">撤回后业主不能继续读取本条内容及照片，内部历史仍保留。</text></block>
      <block wx:elif="{{sheet === 'request_changes'}}"><text class="field-label">补拍要求（必填）</text><textarea class="field requirements-input" value="{{reworkRequirements}}" maxlength="1000" bindinput="requirementsInput" /><text class="helper">写清需要补拍的部位、角度和细节。原话和照片会保留，师傅补交后须由管理人员复审；本条已发布内容会暂停向业主开放。</text></block>
      <block wx:else><text wx:if="{{versionsLoading}}" class="helper">正在读取原记录版本…</text><view wx:for="{{versions}}" wx:key="key" class="version-row"><text>记录 {{item.record_id}} · 版本 {{item.version}} · {{item.display_name || '项目管理人员'}}</text><text class="helper">{{item.action === 'organized' ? '整理草稿' : item.action === 'edit' ? '修改内容' : item.action === 'publish' ? '核对发布' : item.action === 'request_changes' ? '打回补拍' : item.action === 'resubmit' ? '关联补交' : item.action === 'submitted' ? (item.snapshot.capture ? '现场上报' : '补拍提交') : '撤回发布'}} · {{item.snapshot.audience === 'customer' ? '项目业主和成员' : '项目成员'}}</text><text class="record-note" user-select>{{item.snapshot.data.title}}</text><text class="helper" user-select>施工部位：{{item.snapshot.roomName || '待核对'}}</text><text wx:if="{{item.snapshot.data.completed}}" class="record-note" user-select>本次完成：{{item.snapshot.data.completed}}</text><text wx:if="{{item.snapshot.data.pending}}" class="record-note" user-select>尚未完成：{{item.snapshot.data.pending}}</text><text wx:if="{{item.snapshot.data.coordination}}" class="record-note" user-select>待沟通：{{item.snapshot.data.coordination}}</text><text wx:if="{{item.snapshot.data.note}}" class="record-note" user-select>{{item.snapshot.data.note}}</text><text class="helper">{{item.snapshot.reason}}</text><text wx:if="{{item.snapshot.reviewRequirements}}" class="record-note" user-select>补拍要求：{{item.snapshot.reviewRequirements}}</text><text wx:if="{{item.originalText}}" class="record-note" user-select>提交原话：{{item.originalText}}</text><view class="photo-grid"><view wx:for="{{item.media_ids}}" wx:for-item="mid" wx:key="*this" class="photo-slot" data-id="{{mid}}" bindtap="preview"><image wx:if="{{mediaPaths[mid]}}" src="{{mediaPaths[mid]}}" mode="aspectFill" /><text wx:else>照片读取中</text></view></view></view></block>
    </scroll-view>
    <button wx:if="{{sheet === 'edit'}}" class="primary" bindtap="saveEdit" disabled="{{busy || pending || conflict || !edit.title}}" loading="{{busy}}">保存核对内容</button>
    <button wx:elif="{{sheet === 'publish'}}" class="primary publish-confirm" bindtap="publish" disabled="{{busy || pending || conflict}}" loading="{{busy}}">核对并发布</button>
    <button wx:elif="{{sheet === 'withdraw'}}" class="primary" bindtap="withdraw" disabled="{{busy || pending || conflict || !withdrawalReason}}" loading="{{busy}}">确认撤回</button>
    <button wx:elif="{{sheet === 'request_changes'}}" class="primary confirm-changes" bindtap="requestChanges" disabled="{{busy || pending || conflict || !reworkRequirements}}" loading="{{busy}}">确认打回</button>
  </view></view>
</view>
