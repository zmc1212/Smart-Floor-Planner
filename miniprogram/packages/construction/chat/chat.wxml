<!-- S04: original PPT22/38 (853x1844), not the rejected alternate mockups. All content is native UI. -->
<view class="site-chat" style="height: {{viewportHeight - keyboardHeight}}px;">
  <view class="chat-nav" style="padding-top: {{navTop}}px; padding-right: {{navRight}}px;">
    <view class="nav-lane" style="min-height: {{navHeight}}px;">
      <button class="back" size="mini" bindtap="back" aria-label="返回工地"><image src="../assets/arrow-left.png" /></button>
      <image class="brand-logo" src="/images/home-ip-v1/brand-logo.png" mode="aspectFit" />
      <view class="brand-copy"><view class="brand-heading"><text>家客来</text><text class="role-chip">{{portalLabel || '项目协作'}}</text></view><text class="brand-subtitle">小K · 施工助手</text></view>
    </view>
  </view>
  <view wx:if="{{project}}" class="project-context"><text>当前项目 / {{project.stageName || '节点待标记'}}</text><text class="project-name">{{project.name}}</text></view>
  <scroll-view class="chat-scroll" scroll-y enhanced scroll-into-view="{{scrollTarget}}" show-scrollbar="{{false}}">
    <view class="chat-content">
      <view wx:if="{{loading}}" class="state">正在读取本工地对话…</view>
      <view wx:if="{{!loading && !fatal && !write}}" class="feedback">当前只可查看工地记录，发送和核对操作暂不可用。</view>
      <view wx:if="{{error}}" class="feedback" role="alert"><text>{{error}}</text><button wx:if="{{pending}}" bindtap="reconcile" disabled="{{busy}}">核对同一次操作</button><button wx:else bindtap="refresh" disabled="{{busy}}">重新读取</button></view>
      <view wx:if="{{success && !error}}" class="success" aria-live="polite">{{success}}</view>
      <view wx:if="{{pending && !error}}" class="feedback"><text>提交结果待核对，原内容和版本已保留。</text><button bindtap="reconcile" disabled="{{busy}}">核对同一次操作</button></view>
      <button wx:if="{{nextCursor}}" class="text-button history" bindtap="older" disabled="{{busy}}">查看更早的对话</button>
      <view wx:if="{{!loading && !items.length && !fatal}}" class="empty"><text>说说现场进展</text><text class="helper">文字和照片会留在本工地，小K整理后由有权人员核对发布。</text></view>
      <view wx:for="{{items}}" wx:key="message.id" class="conversation-turn" id="source-{{item.message.id}}">
        <text class="message-time">{{item.time}}</text>
        <view class="source-message"><view class="source-copy"><text class="source-author">{{item.message.display_name || '项目成员'}}</text><view class="source-bubble"><text user-select>{{item.text}}</text></view></view><view class="source-avatar"><image src="../assets/person.png" mode="aspectFit" /></view></view>
        <view wx:if="{{item.record.media.length}}" class="source-photos"><text class="photos-label">现场照片 · {{item.record.media.length}}张</text><view class="photo-grid"><view wx:for="{{item.record.media}}" wx:for-item="media" wx:key="id" class="photo-slot" data-id="{{media.id}}" bindtap="preview"><image wx:if="{{mediaPaths[media.id]}}" src="{{mediaPaths[media.id]}}" mode="aspectFill" /><text wx:else>照片读取中</text></view></view></view>
        <view class="xiaok-reply">
          <view class="xiaok-heading"><image class="xiaok-art" src="../assets/xiaok-site-assistant.png" mode="aspectFit" /><text class="xiaok-name">小K</text><text class="xiaok-chip">{{item.response ? '项目协作' : '现场整理'}}</text></view>
          <text wx:if="{{item.response}}" class="reply-intro" user-select>{{item.response.text}}</text>
          <text wx:else class="reply-intro">{{item.record.generating ? '原话和照片已保存，正在整理进展草稿…' : item.record.failed ? '本次整理未完成，原话和照片已保留。可以稍后重试，或先人工核对内容。' : item.record.status === 'withdrawn' ? '这条发布记录已撤回，内部原始资料继续保留。' : item.record.media.length && item.record.image_input ? '我把这段话和照片整理成了进展草稿，发布前请核对一下。' : '按原话整理的进展草稿，照片随记录保留，发布前请核对一下。'}}</text>
          <view wx:if="{{!item.response}}" class="record-card">
            <view class="record-heading"><image src="../assets/file-text.png" mode="aspectFit" /><text class="record-title">{{item.record.data.title || '现场施工进展'}}</text><text class="status-chip">{{item.record.label}}</text></view>
            <view wx:for="{{item.record.rows}}" wx:for-item="row" wx:key="label" class="record-row {{row.coordination && item.record.data.coordination ? 'coordination' : ''}}"><text class="record-label">{{row.label}}</text><text class="record-value" user-select>{{row.value}}</text></view>
            <text wx:if="{{item.record.data.note}}" class="record-note" user-select>{{item.record.data.note}}</text>
            <text class="record-helper">进展按原话整理，照片随记录保留。</text>
            <text wx:if="{{item.record.updatedLabel}}" class="record-helper">最后更新：{{item.record.updatedLabel}} · 版本 {{item.record.version}}</text>
            <view wx:if="{{item.record.status === 'published'}}" class="publication"><text>发布人：{{item.record.approved_name}} · 版本 {{item.record.published_version}}</text><text>{{item.record.scopeLabel}}</text></view>
            <text wx:elif="{{item.record.status === 'withdrawn'}}" class="record-helper">撤回原因：{{item.record.withdrawal_reason}}</text>
            <view wx:else class="scope-row">共享草稿：仅本项目成员可查看</view>
            <view wx:if="{{item.record.canEdit && write}}" class="record-actions">
              <button wx:if="{{item.record.status === 'draft'}}" class="primary" data-id="{{item.record.id}}" bindtap="openPublish" disabled="{{busy || pending}}">核对并发布</button>
              <button wx:elif="{{item.record.canRetry}}" class="primary" data-id="{{item.record.id}}" bindtap="retry" disabled="{{busy || pending}}">重新整理</button>
              <button class="secondary" data-id="{{item.record.id}}" bindtap="openEdit" disabled="{{busy || pending}}">{{item.record.status === 'published' ? '更正内容' : '修改内容'}}</button>
            </view>
            <view class="record-links"><button class="text-button" data-id="{{item.record.id}}" bindtap="versions" disabled="{{busy || pending}}">原记录与版本</button><button wx:if="{{item.record.status === 'published' && item.record.canEdit && write}}" class="text-button" data-id="{{item.record.id}}" bindtap="openWithdraw" disabled="{{busy || pending}}">撤回发布</button></view>
          </view>
        </view>
      </view>
      <view class="scroll-end"></view>
    </view>
  </scroll-view>
  <view class="composer-wrap">
    <view wx:if="{{attachments.length}}" class="queued-photos"><view wx:for="{{attachments}}" wx:key="*this" class="queued-photo"><image src="{{mediaPaths[item]}}" mode="aspectFill" data-id="{{item}}" bindtap="preview" /><button class="text-button" data-id="{{item}}" bindtap="removePhoto" disabled="{{busy || pending}}">移除</button></view></view>
    <view class="composer"><button class="composer-icon voice" size="mini" bindtap="voice" aria-label="语音暂未接通"><image src="../assets/microphone.png" /></button><textarea class="composer-input" value="{{draft}}" placeholder="说说现场进展…" maxlength="4000" auto-height adjust-position="{{false}}" bindinput="input" bindkeyboardheightchange="keyboard" disabled="{{busy || pending || !write || fatal}}" /><button class="composer-icon" size="mini" bindtap="photo" aria-label="添加现场照片" disabled="{{busy || pending || !write || fatal || attachments.length >= 4}}"><image src="../assets/image.png" /></button><button class="send" size="mini" bindtap="send" aria-label="发送现场进展" disabled="{{busy || pending || !write || fatal || (!draft && !attachments.length)}}"><image src="../assets/arrow-up.png" /></button></view>
  </view>
  <view wx:if="{{sheet}}" class="sheet-mask {{sheetOpen ? 'open' : ''}}" bindtap="closeSheet" catchtouchmove="stop"><view class="sheet" catchtap="stop">
    <view class="sheet-heading"><text>{{sheet === 'edit' ? '核对现场内容' : sheet === 'publish' ? '核对发布范围' : sheet === 'withdraw' ? '撤回发布' : '原记录与版本'}}</text><button class="text-button" bindtap="closeSheet" disabled="{{busy || pending}}">关闭</button></view>
    <view wx:if="{{pending || error}}" class="feedback" role="alert"><text>{{pending ? '提交结果待核对，原内容和版本已保留。' : error}}</text><button wx:if="{{pending}}" bindtap="reconcile" disabled="{{busy}}">核对同一次操作</button></view>
    <scroll-view class="sheet-body {{sheet === 'edit' || sheet === 'versions' || conflict ? 'is-long' : ''}}" scroll-y>
      <view wx:if="{{conflict}}" class="feedback"><text>最新版本 {{conflict.version}}：{{conflict.data.title}}</text><text class="helper">{{conflict.label}} · {{conflict.scopeLabel}}</text><text class="helper" user-select>施工部位：{{conflict.room_name_snapshot || '待核对'}}
本次完成：{{conflict.data.completed || '未说明'}}
尚未完成：{{conflict.data.pending || '未说明'}}
待沟通：{{conflict.data.coordination || '未说明'}}
{{conflict.data.note}}</text><button bindtap="adoptLatest" disabled="{{busy || pending}}">{{sheet === 'edit' ? '已核对最新版，保留我的修改' : '重新核对最新版'}}</button></view>
      <block wx:if="{{sheet === 'edit'}}">
        <text class="field-label">标题</text><input class="field" value="{{edit.title}}" maxlength="80" data-field="title" bindinput="editInput" />
        <text class="field-label">施工部位</text><picker range="{{roomOptions}}" range-key="name" value="{{selectedRoom}}" bindchange="roomChange"><view class="field">{{roomOptions[selectedRoom].name}}</view></picker>
        <text class="field-label">本次完成</text><textarea class="field" value="{{edit.completed}}" maxlength="1000" data-field="completed" bindinput="editInput" />
        <text class="field-label">尚未完成</text><textarea class="field" value="{{edit.pending}}" maxlength="1000" data-field="pending" bindinput="editInput" />
        <text class="field-label">待沟通</text><textarea class="field" value="{{edit.coordination}}" maxlength="1000" data-field="coordination" bindinput="editInput" />
        <text class="field-label">补充说明</text><textarea class="field" value="{{edit.note}}" maxlength="2000" data-field="note" bindinput="editInput" />
        <text class="helper">更正会撤销旧发布，需要重新核对发布；原话和照片保持原样。</text>
      </block>
      <block wx:elif="{{sheet === 'publish'}}"><view class="scope-row">本项目有效成员可查看</view><view wx:if="{{publishCanCustomer}}" class="scope-option"><text>同时向本项目业主开放本条记录及照片</text><switch checked="{{publishCustomer}}" bindchange="publishScope" color="#00C888" /></view><text class="helper">业主不会加入内部对话。发布不代表微信订阅通知已送达，也不代表正式方案、费用、工期或验收批准。</text></block>
      <block wx:elif="{{sheet === 'withdraw'}}"><text class="field-label">撤回原因</text><textarea class="field" value="{{withdrawalReason}}" maxlength="500" bindinput="reason" /><text class="helper">撤回后业主不能继续读取本条内容及照片，内部历史仍保留。</text></block>
      <block wx:else><text wx:if="{{versionsLoading}}" class="helper">正在读取原记录版本…</text><view wx:for="{{versions}}" wx:key="version" class="version-row"><text>版本 {{item.version}} · {{item.display_name || '项目管理人员'}}</text><text class="helper">{{item.action === 'organized' ? '整理草稿' : item.action === 'edit' ? '修改内容' : item.action === 'publish' ? '核对发布' : '撤回发布'}} · {{item.snapshot.audience === 'customer' ? '项目业主和成员' : '项目成员'}}</text><text class="record-note" user-select>{{item.snapshot.data.title}}</text><text class="helper" user-select>施工部位：{{item.snapshot.roomName || '待核对'}}</text><text wx:if="{{item.snapshot.data.completed}}" class="record-note" user-select>本次完成：{{item.snapshot.data.completed}}</text><text wx:if="{{item.snapshot.data.pending}}" class="record-note" user-select>尚未完成：{{item.snapshot.data.pending}}</text><text wx:if="{{item.snapshot.data.coordination}}" class="record-note" user-select>待沟通：{{item.snapshot.data.coordination}}</text><text wx:if="{{item.snapshot.data.note}}" class="record-note" user-select>{{item.snapshot.data.note}}</text><text class="helper">{{item.snapshot.reason}}</text></view></block>
    </scroll-view>
    <button wx:if="{{sheet === 'edit'}}" class="primary" bindtap="saveEdit" disabled="{{busy || pending || conflict || !edit.title}}" loading="{{busy}}">保存核对内容</button>
    <button wx:elif="{{sheet === 'publish'}}" class="primary" bindtap="publish" disabled="{{busy || pending || conflict}}" loading="{{busy}}">核对并发布</button>
    <button wx:elif="{{sheet === 'withdraw'}}" class="primary" bindtap="withdraw" disabled="{{busy || pending || conflict || !withdrawalReason}}" loading="{{busy}}">确认撤回</button>
  </view></view>
</view>
