<view class="live-notebook">
  <view class="book-spine"><view wx:for="{{[0,1,2,3,4,5]}}" wx:key="*this" class="book-stitch" style="top:{{88 + item * 130}}px"/></view>
  <view class="book-nav" style="padding-top:{{navTop}}px;padding-right:{{navRight}}px"><button class="book-back" bindtap="back" aria-label="返回"><image src="../assets/notebook/back.png"/></button><text class="book-nav-title">公开工地</text></view>
  <view class="content public-detail-content">
    <text wx:if="{{loading && !site}}" class="state">正在读取公开内容…</text>
    <view wx:if="{{error || publicError}}" class="state public-feedback" role="alert"><text>{{error || publicError}}</text><button class="outline" bindtap="refresh">重新读取</button><button class="book-link" bindtap="back">返回工地列表</button></view>
    <block wx:if="{{site && !unavailable}}"><text class="page-title">{{site.name}}</text><view class="public-detail-meta"><text class="stage-tag">{{site.stageName}}</text><text class="helper">{{site.district}} · 业主授权公开</text></view>
      <view class="public-photo-mat"><image wx:if="{{site.photos.length && publicPaths[site.photos[0].key]}}" src="{{publicPaths[site.photos[0].key]}}" mode="aspectFill" data-key="{{site.photos[0].key}}" bindtap="preview"/><view wx:else class="public-photo-empty">这一版没有公开现场照片。</view></view>
      <button wx:if="{{liveEntry}}" class="primary public-live-row" bindtap="watchLive"><image class="book-icon" src="../assets/notebook/video-white.png"/><text>观看工地直播 · {{liveEntry.alias}}</text><text>›</text></button>
      <view class="public-detail-tabs"><button class="{{tab === 'photos' ? 'fabric' : ''}}" data-tab="photos" bindtap="changeTab">现场进展</button><button class="{{tab === 'records' ? 'fabric' : ''}}" data-tab="records" bindtap="changeTab">小K服务记录</button></view>
      <view class="paper"><block wx:if="{{tab === 'records'}}"><view wx:for="{{site.excerpts}}" wx:key="key" class="public-record"><text class="public-record-author">{{item.role}} <text>· {{item.dateLabel}}</text></text><text class="body-text public-record-body" user-select>{{item.text}}</text></view><text wx:if="{{!site.excerpts.length}}" class="helper">这一版没有公开服务记录。</text></block>
      <block wx:else><view wx:for="{{site.photos}}" wx:key="key" class="public-extra-photo"><image wx:if="{{publicPaths[item.key]}}" src="{{publicPaths[item.key]}}" mode="widthFix" data-key="{{item.key}}" bindtap="preview"/></view><text wx:if="{{!site.photos.length}}" class="helper">这一版没有公开现场照片。</text></block></view>
      <text class="helper public-privacy">角色与时间已保留，私人信息已隐藏。</text><button class="primary" bindtap="consult">围观中有疑问？问小K</button><button class="book-link" bindtap="designer">找设计师聊 ↗</button>
    </block>
  </view>
</view>
