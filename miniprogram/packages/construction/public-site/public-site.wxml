<view class="public-page detail-page">
  <view class="public-nav" style="padding-top:{{navTop}}px;padding-right:{{navRight}}px"><button class="brand" style="min-height:{{navHeight}}px" bindtap="back"><view class="brand-mark"><image class="brand-logo" src="/images/home-ip-v1/brand-logo.png" mode="aspectFit"/></view><view><text class="brand-name">家客来</text><text class="meta">业主授权公开</text></view></button></view>
  <view class="public-content"><text class="heading">云工地围观</text><text class="subtitle">看真实工地进展，了解家装全过程</text>
    <view wx:if="{{loading && !site}}" class="state">正在读取公开内容…</view><view wx:if="{{error || publicError}}" class="state" role="alert"><text>{{error || publicError}}</text><button class="secondary" bindtap="refresh">重新读取</button><button class="secondary" bindtap="back">返回工地列表</button></view>
    <block wx:if="{{site && !unavailable}}"><view class="detail-cover"><image wx:if="{{site.photos.length && publicPaths[site.photos[0].key]}}" src="{{publicPaths[site.photos[0].key]}}" mode="aspectFill" data-key="{{site.photos[0].key}}" bindtap="preview"/><view wx:else class="state">现场照片未公开</view><view class="detail-info"><text class="site-title">{{site.name}} · {{site.stageName}}</text><text class="meta">{{site.cityName}}{{site.district}} · {{site.dateLabel}}</text><text class="scope-note">仅展示授权脱敏的服务节选</text></view></view>
    <view class="tabs"><button class="{{tab === 'photos' ? 'active' : ''}}" data-tab="photos" bindtap="changeTab">现场进展</button><button class="{{tab === 'records' ? 'active' : ''}}" data-tab="records" bindtap="changeTab">小K服务记录</button></view>
    <view wx:if="{{tab === 'photos'}}" class="photo-list"><block wx:for="{{site.photos}}" wx:key="id"><image wx:if="{{publicPaths[item.key]}}" src="{{publicPaths[item.key]}}" mode="widthFix" data-key="{{item.key}}" bindtap="preview"/></block><text wx:if="{{!site.photos.length}}" class="meta">这一版没有公开现场照片。</text></view>
    <view wx:else class="timeline"><view wx:for="{{site.excerpts}}" wx:key="key" class="timeline-row"><view class="timeline-dot"/><text class="role">{{item.role}} <text class="meta">· {{item.dateLabel}}</text></text><view class="excerpt" user-select>{{item.text}}</view></view></view>
    <text class="privacy-note">角色与时间已保留，私人信息已隐藏。</text><button class="primary detail-action" bindtap="consult">围观中有疑问？问小K <text>›</text></button><button class="secondary detail-action" bindtap="designer">找设计师聊 <text>›</text></button></block>
  </view>
</view>
