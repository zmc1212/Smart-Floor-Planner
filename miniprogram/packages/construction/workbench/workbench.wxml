<import src="../notebook-v2.wxml" />
<template name="issue-row">
  <button class="workbench-row workbench-issue-row" data-issue="{{issue.issueId}}" data-record="{{issue.recordId}}" bindtap="openIssue" aria-label="{{issue.title}}">
    <text class="row-title">{{issue.title}}</text><text class="workbench-tag pending">{{label}}</text><view class="workbench-chevron" />
  </button>
</template>

<template name="inspection-summary">
  <button class="workbench-paper inspection-summary" bindtap="openInspection">
    <view class="inspection-summary-copy">
      <text class="workbench-section-title">巡检待办</text>
      <text class="workbench-meta">{{inspection.count}} 项待到场 · {{inspection.projects}} 个工地</text>
      <text wx:if="{{inspection.next}}" class="record-title">优先查看 · {{inspection.next}}</text>
    </view>
    <view class="workbench-chevron" />
  </button>
</template>

<import src="../../../components/staff-password-required/staff-password-required.wxml"/>

<view class="site-workbench {{model && (!model.emptyProject || model.notebookTask || model.appointments.length || model.survey.records.length) ? 'site-workbench-v2' : ''}} {{model.view === 'manager' ? 'manager-workbench-v2' : ''}}">
  <image class="notebook-cover-v2 workbench-cover-v2" src="../assets/notebook/v2-notebook-binding.jpg" mode="aspectFill" aria-hidden="true" />
  <image class="workbench-texture" src="../assets/notebook/capture-v3-paper.png" mode="aspectFill" />
  <view class="book-spine"><view wx:for="{{[10.2,32.9,53.4,83.6]}}" wx:key="*this" class="book-stitch" style="top:{{item}}%"/></view>
  <scroll-view class="workbench-scroll" scroll-y enhanced show-scrollbar="{{false}}" refresher-enabled refresher-triggered="{{refreshing}}" bindrefresherrefresh="refresh">
    <view class="workbench-nav" style="padding-top:{{navTop}}px; padding-right:{{navRight}}px">
      <text class="workbench-nav-title" style="line-height:{{navHeight}}px">{{title}}</text>
    </view>
    <view class="workbench-content">
      <view wx:if="{{notice}}" class="workbench-feedback" role="status">{{notice}}</view>
      <view wx:if="{{loading}}" class="workbench-feedback" role="status">正在读取工地…</view>
      <template wx:elif="{{passwordRequired}}" is="staff-password-required" />
      <view wx:elif="{{error}}" class="workbench-feedback" role="alert"><text>{{error}}</text><button class="workbench-plain" bindtap="retry">重新读取</button></view>
      <block wx:elif="{{model.emptyProject && !model.notebookTask && !model.appointments.length && !model.survey.records.length}}">
        <view class="workbench-no-site">
          <image wx:if="{{model.view === 'designer'}}" class="workbench-no-site-art" src="../assets/notebook/workbench-empty-designer.png" mode="aspectFit" aria-hidden="true" />
          <image wx:elif="{{model.view === 'boss'}}" class="workbench-no-site-art" src="../assets/notebook/workbench-empty-boss.png" mode="aspectFit" aria-hidden="true" />
          <image wx:else class="workbench-no-site-art" src="../assets/notebook/workbench-empty-construction.png" mode="aspectFit" aria-hidden="true" />
          <text class="workbench-no-site-title">{{model.emptyProject.title}}</text>
          <view class="workbench-no-site-copy">
            <text wx:for="{{model.emptyProject.lines}}" wx:key="*this">{{item}}</text>
          </view>
          <button class="workbench-state-action workbench-no-site-refresh" bindtap="retry">
            <text>刷新工地</text><image src="/images/ai-studio-icons-v3/refresh.png" mode="aspectFit" aria-hidden="true" />
          </button>
          <text wx:if="{{model.customerTasksError}}" class="workbench-meta">{{model.customerTasksError}}</text>
        </view>
        <button wx:if="{{model.view === 'designer' && canDesign}}" class="workbench-row workbench-no-site-tool" bindtap="openDesign">
          <view class="workbench-tool-icon"><image src="/images/mine-icons/tab-ai-active.png" mode="aspectFit" aria-hidden="true" /></view>
          <text class="row-title">AI 设计</text><text class="workbench-meta">选择户型</text><view class="workbench-chevron" />
        </button>
        <button wx:elif="{{model.view === 'boss'}}" class="workbench-row workbench-no-site-tool" bindtap="openReports">
          <view class="workbench-tool-icon"><image src="../assets/notebook/file.png" mode="aspectFit" aria-hidden="true" /></view>
          <text class="row-title">企业日周报</text><view class="workbench-chevron" />
        </button>
      </block>
      <block wx:elif="{{model.view === 'boss'}}">
        <view class="notebook-context-v2"><text>{{model.enterpriseName}}{{model.enterpriseName && model.date ? ' · ' : ''}}{{model.date}}</text></view>
        <template wx:if="{{model.notebookTask}}" is="notebook-task-v2" data="{{task: model.notebookTask}}" />
        <text wx:if="{{!model.exceptions.length}}" class="workbench-boss-clear">暂无超期或待协调事项</text>
        <block wx:if="{{model.pendingReport && model.notebookTask.kind !== 'approval'}}">
          <view class="notebook-section-v2">待审核上报</view>
          <button class="notebook-row-v2" data-project="{{model.pendingReport.projectId}}" data-record="{{model.pendingReport.recordId}}" bindtap="openApproval">
            <view class="notebook-row-copy"><text>{{model.pendingReport.title}}</text><text class="notebook-muted-v2">{{model.pendingReport.projectName}} · {{model.pendingReport.time}}{{model.pendingReport.photoCount ? ' · ' + model.pendingReport.photoCount + ' 张照片' : ''}}</text></view>
            <view class="notebook-link-v2"><text>审核上报</text><view class="workbench-chevron" /></view>
          </button>
        </block>
        <block wx:for="{{model.exceptions}}" wx:key="key">
          <block wx:if="{{index > 0}}">
            <button wx:if="{{item.kind === 'late'}}" class="notebook-row-v2" data-project="{{item.id}}" data-node="{{item.nodeKey}}" bindtap="openNode"><view class="notebook-row-copy">{{item.name}} · {{item.title}}</view><view class="notebook-link-v2"><text>查看节点</text><view class="workbench-chevron" /></view></button>
            <button wx:else class="notebook-row-v2" data-project="{{item.id}}" data-issue="{{item.issueId}}" bindtap="openIssue"><view class="notebook-row-copy">{{item.name}} · {{item.title}}</view><view class="notebook-link-v2"><text>查看事项</text><view class="workbench-chevron" /></view></button>
          </block>
        </block>
        <view class="summary-grid notebook-summary-v2">
          <view><text class="summary-value">{{model.totals[0]}}</text><text>在建工地</text></view>
          <view><text class="summary-value {{model.totals[1] ? 'late-text' : ''}}">{{model.totals[1]}}</text><text>进度落后</text></view>
          <view><text class="summary-value">{{model.totals[2]}}</text><text>待协调事项</text></view>
        </view>
        <text wx:if="{{model.hasMoreProjects}}" class="workbench-meta summary-note">以上汇总当前简报中的 {{model.items.length}} 个工地。</text>
        <text wx:if="{{model.unverified}}" class="workbench-meta summary-note">部分工地进度待核实。</text>
        <template wx:if="{{model.inspection}}" is="inspection-summary" data="{{inspection: model.inspection}}" />
        <button class="notebook-row-v2" bindtap="openAll"><image class="notebook-row-icon" src="/images/mine-icons/tab-home.png" mode="aspectFit" /><view class="notebook-row-copy">全部工地</view><view class="workbench-chevron" /></button>
        <button class="notebook-row-v2" bindtap="openReports"><image class="notebook-row-icon" src="../assets/notebook/file.png" mode="aspectFit" /><view class="notebook-row-copy">企业日周报</view><view class="workbench-chevron" /></button>
      </block>
      <block wx:elif="{{model.view === 'designer' || model.view === 'manager'}}">
        <view class="notebook-context-v2">
          <view wx:if="{{model.view === 'manager'}}" class="manager-project-context">
            <text class="notebook-context-name">{{model.project.name}}</text>
            <text>{{model.combinedManager ? '兼任施工经理' : model.project.stageName}}{{model.project.status === 'paused' ? ' · 已暂停' : ''}}</text>
          </view>
          <text wx:else>{{model.enterpriseName}}{{model.enterpriseName && model.date ? ' · ' : ''}}{{model.date}}</text>
          <picker wx:if="{{model.choices.length > 1}}" class="workbench-picker" aria-label="换工地"
            range="{{model.choices}}" range-key="name" value="{{selectedIndex}}" bindchange="changeProject">
            <view class="{{model.view === 'manager' ? 'manager-project-picker' : 'picker-chip'}}">换工地<view class="workbench-chevron down" /></view>
          </picker>
        </view>
        <template wx:if="{{model.notebookTask}}" is="notebook-task-v2" data="{{task: model.notebookTask}}" />
        <button wx:if="{{model.notebookTask.kind === 'survey'}}" class="notebook-row-v2 notebook-appointment-receipt"
          data-lead="{{model.notebookTask.item.leadId}}" data-appointment="{{model.notebookTask.item.appointmentId}}" bindtap="openCustomerAppointment">
          <view class="notebook-link-v2"><text>查看预约详情</text><view class="workbench-chevron" /></view>
        </button>
        <block wx:if="{{model.view === 'manager'}}">
          <view class="notebook-section-v2 manager-section">{{model.combinedManager ? '施工管理' : '现场待办'}}</view>
          <button wx:if="{{model.onsiteTask && model.notebookTask.kind !== 'inspection' && model.notebookTask.kind !== 'inspection-route'}}"
            class="notebook-row-v2 manager-detail-row" bindtap="openProjectInspection">
            <image class="notebook-row-icon notebook-ink-icon" src="../assets/notebook/review-clock.png" mode="aspectFit" aria-hidden="true" />
            <view class="notebook-row-copy">
              <text>{{model.onsiteTask.title}}</text>
              <text class="notebook-muted-v2">{{model.onsiteTask.inspection.source === 'ai' ? '建议到场' : '需到场'}}</text>
            </view>
            <view class="notebook-link-v2"><text>巡检</text><image src="../assets/notebook/arrow-right.png" mode="aspectFit" aria-hidden="true" /></view>
          </button>
          <button wx:if="{{model.pendingReport && model.notebookTask.kind !== 'approval'}}" class="notebook-row-v2 manager-detail-row"
            data-project="{{model.pendingReport.projectId}}" data-record="{{model.pendingReport.recordId}}" bindtap="openApproval">
            <image class="notebook-row-icon notebook-ink-icon" src="../assets/notebook/v2-dossier-file.png" mode="aspectFit" aria-hidden="true" />
            <view class="notebook-row-copy">
              <text>{{model.pendingReport.title}}</text>
              <text class="notebook-muted-v2">待审核{{model.pendingReport.mediaLabel ? ' · ' + model.pendingReport.mediaLabel : ''}}</text>
            </view>
            <view class="notebook-link-v2"><text>审核</text><image src="../assets/notebook/arrow-right.png" mode="aspectFit" aria-hidden="true" /></view>
          </button>
          <button wx:if="{{model.review && model.notebookTask.kind !== 'recheck'}}" class="notebook-row-v2 manager-detail-row" bindtap="openManagerRecheck">
            <image class="notebook-row-icon" src="../assets/notebook/review-clock.png" mode="aspectFit" aria-hidden="true" />
            <view class="notebook-row-copy">
              <text>{{model.review.title}}</text><text class="notebook-muted-v2">{{model.review.recordId ? '已补交 · 待复查' : '待复查'}}</text>
            </view>
            <view class="notebook-link-v2"><text>复查</text><image src="../assets/notebook/arrow-right.png" mode="aspectFit" aria-hidden="true" /></view>
          </button>
          <view wx:if="{{!model.onsiteTask && !model.pendingReport && !model.review}}" class="notebook-row-v2 notebook-muted-v2">当前工地暂无待处理的施工事项</view>
          <button wx:if="{{model.canCapture}}" class="notebook-row-v2 manager-project-link" bindtap="capture">
            <image class="notebook-row-icon" src="../assets/notebook/file.png" mode="aspectFit" aria-hidden="true" />
            <view class="notebook-row-copy">记进展</view><view class="notebook-link-v2"><image src="../assets/notebook/arrow-right.png" mode="aspectFit" aria-hidden="true" /></view>
          </button>
          <button class="notebook-row-v2 manager-project-link {{model.combinedManager ? 'compact' : ''}}" bindtap="openProject">
            <image class="notebook-row-icon notebook-ink-icon" src="/custom-tab-bar/assets/notebook-home.png" mode="aspectFit" aria-hidden="true" />
            <view class="notebook-row-copy">排期与分工</view><view class="notebook-link-v2"><text>查看工地</text><image src="../assets/notebook/arrow-right.png" mode="aspectFit" aria-hidden="true" /></view>
          </button>
        </block>
        <block wx:if="{{model.survey.records.length}}">
          <view class="notebook-section-v2">量房记录</view>
          <button wx:for="{{model.survey.records}}" wx:key="key" class="notebook-row-v2 notebook-survey-record" data-index="{{index}}" bindtap="openSurveyRecord">
            <image class="notebook-row-icon notebook-ink-icon" src="../assets/notebook/{{item.action === 'plan' ? 'file' : 'v2-ruler'}}.png" mode="aspectFit" aria-hidden="true" />
            <view class="notebook-row-copy"><text>{{item.title}}</text><text class="notebook-muted-v2">{{item.status}}</text></view>
            <view class="notebook-link-v2"><text>{{item.action === 'plan' ? '查看户型' : '继续量房'}}</text><view class="workbench-chevron" /></view>
          </button>
        </block>
        <block wx:if="{{model.view === 'designer' || model.combinedManager}}">
        <view class="notebook-section-v2 {{model.combinedManager ? 'manager-customer-section' : ''}}">客户服务</view>
        <button wx:if="{{model.customerTasksError}}" class="notebook-row-v2" bindtap="retry">{{model.customerTasksError}} · 重试</button>
        <block wx:for="{{model.appointments}}" wx:key="appointmentId">
          <button wx:if="{{item.appointmentId !== model.notebookTask.item.appointmentId}}" class="notebook-row-v2 {{model.combinedManager ? 'manager-detail-row' : ''}}"
            data-lead="{{item.leadId}}" data-appointment="{{item.appointmentId}}" bindtap="openCustomerAppointment">
            <image class="notebook-row-icon notebook-ink-icon" src="../assets/notebook/v2-calendar.png" mode="aspectFit" aria-hidden="true" />
            <view class="notebook-row-copy">
              <text>{{model.combinedManager ? (item.canPerformSurvey ? '上门量房' : '量房预约') : (item.communityName || item.title)}}</text>
              <text class="notebook-muted-v2">{{model.combinedManager ? item.serviceTime + ' · ' + (item.communityName || item.title) : item.timeLabel + ' · 已预约量房'}}</text>
            </view>
            <view class="notebook-link-v2"><text>查看预约</text><view class="workbench-chevron" /></view>
          </button>
        </block>
        <block wx:for="{{model.deliveries}}" wx:key="leadId">
          <button wx:if="{{item.leadId !== model.notebookTask.delivery.leadId}}" class="notebook-row-v2 notebook-delivery-row {{model.combinedManager ? 'manager-detail-row' : ''}}"
            data-lead="{{item.leadId}}" bindtap="{{model.combinedManager ? 'continueDelivery' : 'openDelivery'}}">
            <image wx:if="{{model.combinedManager}}" class="notebook-row-icon notebook-ink-icon"
              src="../assets/notebook/v2-dossier-file.png" mode="aspectFit" aria-hidden="true" />
            <view class="notebook-row-copy">
              <text>{{model.combinedManager ? '交付设计方案' : (item.communityName || item.title)}}</text>
              <text class="notebook-muted-v2">{{model.combinedManager ? (item.communityName || item.title) + ' · 正式户型已归档' : '待交付方案'}}</text>
            </view>
            <view class="notebook-link-v2"><text>{{model.combinedManager && canDesign ? '继续交付' : '查看客户'}}</text><view class="workbench-chevron" /></view>
          </button>
        </block>
        </block>
        <block wx:if="{{model.view === 'designer'}}">
        <view class="notebook-row-v2"><text>现场协作</text><text class="notebook-muted-v2">{{model.project ? model.project.name : '暂未分配工地'}}</text></view>
        <template wx:if="{{model.inspection}}" is="inspection-summary" data="{{inspection: model.inspection}}" />
        <button wx:if="{{model.pendingReport && model.notebookTask.kind !== 'approval'}}" class="notebook-row-v2" data-project="{{model.pendingReport.projectId}}" data-record="{{model.pendingReport.recordId}}" bindtap="openApproval">
          <view class="notebook-row-copy">{{model.pendingReport.title}}</view><view class="notebook-link-v2"><text>审核上报</text><view class="workbench-chevron" /></view>
        </button>
        <block wx:for="{{model.reply}}" wx:key="issueId">
          <template wx:if="{{item.issueId !== model.notebookTask.issue}}" is="issue-row" data="{{issue: item, label: '待回复'}}" />
        </block>
        <block wx:for="{{model.changes}}" wx:key="issueId">
          <template wx:if="{{item.issueId !== model.notebookTask.issue}}" is="issue-row" data="{{issue: item, label: '待核对'}}" />
        </block>
        <button wx:if="{{model.project}}" class="notebook-row-v2" bindtap="openReports"><image class="notebook-row-icon" src="../assets/notebook/file.png" mode="aspectFit" /><view class="notebook-row-copy">工地日报与周报</view><view class="workbench-chevron" /></button>
        <button wx:if="{{canDesign}}" class="notebook-row-v2" bindtap="openDesign"><image class="notebook-row-icon" src="/images/mine-icons/tab-ai-active.png" mode="aspectFit" /><view class="notebook-row-copy">AI 设计</view><view class="notebook-link-v2"><text>选择户型</text><view class="workbench-chevron" /></view></button>
        </block>
        <block wx:if="{{model.view === 'manager'}}">
          <button class="notebook-row-v2 manager-report-link" bindtap="openReports">
            <image class="notebook-row-icon notebook-ink-icon" src="../assets/notebook/v2-dossier-file.png" mode="aspectFit" aria-hidden="true" />
            <view class="notebook-row-copy">工地日报与周报</view><image class="manager-arrow" src="../assets/notebook/arrow-right.png" mode="aspectFit" aria-hidden="true" />
          </button>
          <button wx:if="{{model.inspection.count && model.notebookTask.kind !== 'inspection-route'}}" class="notebook-row-v2 manager-extra-link" bindtap="openInspectionRoute">
            <view class="notebook-row-copy">巡检路线</view><view class="workbench-chevron" />
          </button>
          <button wx:if="{{model.inspection}}" class="notebook-row-v2 manager-extra-link" bindtap="openInspection">
            <view class="notebook-row-copy">全部审核上报</view><view class="workbench-chevron" />
          </button>
        </block>
      </block>
      <block wx:else>
        <block wx:if="{{model.project}}">
          <view class="{{model.view === 'worker' ? 'notebook-context-v2 worker-context-v2' : 'workbench-heading'}}">
            <view class="project-copy"><text class="workbench-title">{{model.project.name}}</text><text class="workbench-stage">{{model.project.stageName}}{{model.project.status === 'paused' ? ' · 已暂停' : ''}}</text></view>
            <picker wx:if="{{model.choices.length > 1}}" class="workbench-picker" range="{{model.choices}}" range-key="name" value="{{selectedIndex}}" bindchange="changeProject">
              <view class="picker-chip">换工地<view class="workbench-chevron down" /></view>
            </picker>
          </view>
          <block wx:if="{{model.view === 'worker'}}">
            <template wx:if="{{model.notebookTask}}" is="notebook-task-v2" data="{{task: model.notebookTask}}" />
            <button wx:if="{{model.notebookTask.kind === 'return'}}" class="notebook-row-v2 capture-section" bindtap="capture" aria-label="现场上报">
              <image class="notebook-row-icon notebook-ink-icon" src="../assets/notebook/capture-camera.png" mode="aspectFit" aria-hidden="true" />
              <view class="notebook-row-copy">现场上报</view><view class="workbench-chevron" />
            </button>
            <text wx:if="{{!model.canCapture}}" class="workbench-meta capture-paused">当前工地已暂停上报，请联系施工经理。</text>
            <button wx:if="{{model.task}}" class="notebook-row-v2 workbench-issue-row" bindtap="openTask">
              <view class="notebook-row-copy"><text>{{model.task.title}}</text><text class="notebook-muted-v2">{{model.task.label}}</text></view><view class="workbench-chevron" />
            </button>

            <view class="report-list notebook-report-list-v2 {{(!reportLoading && !reportError && !reports.length) ? 'report-list-empty' : ''}}">
              <view class="notebook-section-v2">
                <text>{{reportRange.key === 'today' ? '今日上报' : '上报记录'}}</text>
                <text class="notebook-muted-v2">{{reportRange.key === 'today' ? '' : reportRange.label + ' · '}}{{reports.length}} 条</text>
              </view>
              <view wx:if="{{reportLoading}}" class="workbench-state">正在读取上报…</view>
              <view wx:elif="{{reportError}}" class="workbench-state" role="alert"><text>{{reportError}}</text><button class="workbench-plain" bindtap="retry">重新读取</button></view>
              <text wx:elif="{{!reports.length}}" class="workbench-empty-detail">{{reportRange.key === 'today' ? '今天还没有上报' : '这段时间还没有上报'}}</text>
              <block wx:else>
                <button wx:for="{{reports}}" wx:key="recordId" class="report-row" data-record="{{item.recordId}}" bindtap="openRecord">
                  <view class="report-copy">
                    <text class="record-title">{{item.title}}</text>
                    <text class="workbench-meta">{{item.meta}}</text>
                    <text wx:if="{{item.statusClass === 'done' && item.approvedByName}}" class="workbench-meta">审核人 {{item.approvedByName}}</text>
                    <text wx:if="{{item.statusClass === 'returned' && item.returnShort}}" class="return-hint">退回：{{item.returnShort}}</text>
                  </view>
                  <view class="report-status">
                    <text class="workbench-tag {{item.statusClass}}">{{item.statusLabel}}</text>
                    <view class="workbench-chevron" />
                  </view>
                </button>
              </block>
            </view>

            <button class="notebook-row-v2" bindtap="openReports">
              <image class="notebook-row-icon" src="../assets/notebook/file.png" mode="aspectFit" /><view class="notebook-row-copy">工地日报与周报</view><view class="workbench-chevron" />
            </button>
            <view class="filter-bar">
              <button class="filter-chip {{reportRange.key === 'today' ? 'active' : ''}}" data-key="today" bindtap="selectRange"><view class="filter-chip-label">今天</view></button>
              <button class="filter-chip {{reportRange.key === 'yesterday' ? 'active' : ''}}" data-key="yesterday" bindtap="selectRange"><view class="filter-chip-label">昨天</view></button>
              <button class="filter-chip filter-chip-wide {{reportRange.key === 'week' ? 'active' : ''}}" data-key="week" bindtap="selectRange"><view class="filter-chip-label">近7天</view></button>
              <button class="filter-chip filter-chip-wide calendar-chip {{reportRange.key === 'custom' ? 'active' : ''}}" bindtap="openCalendar">
                <view class="filter-chip-label"><view class="calendar-glyph" aria-hidden="true"></view>日历</view>
              </button>
            </view>

          </block>
        </block>
      </block>
    </view>
  </scroll-view>

  <view wx:if="{{showCalendar}}" class="overlay is-open" style="z-index:1200" catchtouchmove="noop">
    <view class="sheet calendar-sheet">
      <view class="sheet-tag-row">
        <text class="sheet-fabric">选择日期</text>
        <button class="text-action" bindtap="resetCalendar">重置</button>
      </view>
      <view class="calendar-quick">
        <button class="filter-chip" data-key="today" bindtap="pickCalendarQuick">今天</button>
        <button class="filter-chip" data-key="yesterday" bindtap="pickCalendarQuick">昨天</button>
        <button class="filter-chip" data-key="week" bindtap="pickCalendarQuick">近7天</button>
        <button class="filter-chip" data-key="month" bindtap="pickCalendarQuick">本月</button>
      </view>
      <view class="calendar-month">
        <button class="calendar-arrow" bindtap="calendarPrev" aria-label="上个月">‹</button>
        <text>{{calendar.monthLabel}}</text>
        <button class="calendar-arrow" bindtap="calendarNext" aria-label="下个月">›</button>
      </view>
      <view class="calendar-weekdays">
        <text wx:for="{{['一','二','三','四','五','六','日']}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="calendar-weeks">
        <view wx:for="{{calendar.weeks}}" wx:key="index" wx:for-item="week" wx:for-index="weekIndex" class="calendar-week">
          <view wx:for="{{week}}" wx:key="key" wx:for-item="day"
            class="calendar-day {{day.disabled ? 'disabled' : ''}} {{day.inRange ? 'in-range' : ''}} {{day.start || day.end ? 'range-end' : ''}} {{day.today ? 'today' : ''}}"
            data-date="{{day.date}}" bindtap="pickCalendar">
            <text>{{day.day}}</text>
          </view>
        </view>
      </view>
      <view class="calendar-summary">
        <text>最多可查近3个月</text>
        <text>{{calendar.rangeLabel}}</text>
      </view>
      <button class="primary" bindtap="applyCalendar">查看这段时间的记录</button>
    </view>
  </view>

  <view wx:if="{{showDetail}}" class="overlay is-open" style="z-index:1200" catchtouchmove="noop">
    <view class="sheet detail-sheet">
      <view class="detail-heading">
        <text class="sheet-fabric">上报详情</text>
        <button class="detail-close" bindtap="closeDetail" aria-label="关闭">×</button>
      </view>
      <scroll-view class="detail-scroll" scroll-y enhanced show-scrollbar="{{false}}">
        <view wx:if="{{detailLoading}}" class="detail-state">正在读取上报…</view>
        <view wx:elif="{{detailError}}" class="detail-state" role="alert"><text>{{detailError}}</text><button class="text-action" bindtap="closeDetail">关闭</button></view>
        <block wx:elif="{{detail}}">
          <view class="paper detail-status">
            <view class="detail-status-copy">
              <text class="workbench-tag {{detail.statusClass}}">{{detail.statusLabel}}</text>
              <text wx:if="{{detail.approvedByName}}" class="workbench-meta">审核人 {{detail.approvedByName}} · {{detail.approvedAt}}</text>
              <text wx:if="{{detail.inspectionNote}}" class="workbench-meta">到场核查 · {{detail.inspectionNote}}</text>
              <text wx:elif="{{detail.statusClass === 'pending'}}" class="workbench-meta">等待施工经理、设计师或老板审核</text>
            </view>
            <view class="detail-check {{detail.statusClass}}">✓</view>
          </view>
          <text class="detail-title">{{detail.title}}</text>
          <text class="workbench-meta detail-meta">{{detail.time}} · {{model.project.name}}</text>
          <view class="detail-stages">
            <text wx:if="{{detail.stageText}}" class="stage-pill">{{detail.stageText}}</text>
            <text class="workbench-meta">本次上报阶段</text>
          </view>
          <view wx:if="{{detailPhotos.length}}" class="detail-photos">
            <image wx:for="{{detailPhotos}}" wx:key="id" src="{{item.path}}" mode="aspectFill" data-path="{{item.path}}" bindtap="previewDetail" />
          </view>
          <view wx:if="{{detail.speech}}" class="detail-voice" bindtap="playDetailVoice">
            <image src="../assets/notebook/capture-mic.png" mode="aspectFit" />
            <text>语音 {{detail.speechSeconds}}秒</text>
            <view class="detail-play {{detailPlaying ? 'playing' : ''}}" aria-hidden="true"></view>
          </view>
          <view wx:if="{{detail.reviewRequirements}}" class="paper return-paper">
            <text class="workbench-fabric">需补充</text>
            <text class="detail-text">{{detail.reviewRequirements}}</text>
            <button class="primary" bindtap="openDetailRework">按退回要求补充</button>
          </view>
          <view class="paper detail-content">
            <text class="workbench-fabric">上报内容</text>
            <view wx:if="{{detail.completed}}" class="detail-row"><text class="detail-label">本次完成</text><text class="detail-text">{{detail.completed}}</text></view>
            <view wx:if="{{detail.pending}}" class="detail-row"><text class="detail-label">尚未完成</text><text class="detail-text">{{detail.pending}}</text></view>
            <view wx:if="{{detail.coordination}}" class="detail-row"><text class="detail-label">待沟通</text><text class="detail-text">{{detail.coordination}}</text></view>
            <view wx:if="{{detail.note}}" class="detail-row"><text class="detail-label">补充说明</text><text class="detail-text">{{detail.note}}</text></view>
          </view>
          <button class="text-action detail-report-link" bindtap="openReports">查看工地日报与周报</button>
        </block>
      </scroll-view>
    </view>
  </view>
</view>
