<template name="issue-row">
  <button class="workbench-row workbench-issue-row" data-issue="{{issue.issueId}}" data-record="{{issue.recordId}}" bindtap="openIssue" aria-label="{{issue.title}}">
    <text class="row-title">{{issue.title}}</text><text class="workbench-tag pending">{{label}}</text><view class="workbench-chevron" />
  </button>
</template>

<view class="site-workbench">
  <image class="workbench-texture" src="../assets/notebook/capture-v3-paper.png" mode="aspectFill" />
  <view class="book-spine"><view wx:for="{{[10.2,32.9,53.4,83.6]}}" wx:key="*this" class="book-stitch" style="top:{{item}}%"/></view>
  <scroll-view class="workbench-scroll" scroll-y enhanced show-scrollbar="{{false}}" refresher-enabled refresher-triggered="{{refreshing}}" bindrefresherrefresh="refresh">
    <view class="workbench-nav" style="padding-top:{{navTop}}px; padding-right:{{navRight}}px">
      <text class="workbench-nav-title" style="line-height:{{navHeight}}px">{{title}}</text>
    </view>
    <view class="workbench-content">
      <view wx:if="{{loading}}" class="workbench-paper workbench-state" role="status">正在读取工地…</view>
      <view wx:elif="{{error}}" class="workbench-paper workbench-state" role="alert"><text>{{error}}</text><button class="workbench-plain" bindtap="retry">重新读取</button></view>
      <block wx:elif="{{model.view === 'boss'}}">
        <view class="workbench-heading boss-heading">
          <text class="workbench-title">工地简报</text>
          <text class="workbench-meta">{{model.enterpriseName}}{{model.date ? ' · ' + model.date : ''}}</text>
        </view>
        <view class="workbench-paper workbench-summary">
          <view><text class="summary-value">{{model.totals[0]}}</text><text>在建工地</text></view>
          <view><text class="summary-value {{model.totals[1] ? 'late-text' : ''}}">{{model.totals[1]}}</text><text>进度落后</text></view>
          <view><text class="summary-value">{{model.totals[2]}}</text><text>待协调事项</text></view>
        </view>
        <text wx:if="{{model.hasMoreProjects}}" class="workbench-meta summary-note">以上汇总当前简报中的 {{model.items.length}} 个工地。</text>
        <text wx:if="{{model.unverified}}" class="workbench-meta summary-note">部分工地进度待核实。</text>
        <view wx:if="{{model.pendingReport}}" class="workbench-paper manager-draft boss-pending">
          <text class="workbench-fabric">待审核上报</text>
          <view class="record-copy">
            <text class="record-title draft-title">{{model.pendingReport.title}}</text>
            <text class="workbench-meta">{{model.pendingReport.projectName}} · {{model.pendingReport.authorName}} · {{model.pendingReport.time}}</text>
            <text wx:if="{{model.pendingReport.photoCount || model.pendingReport.hasVoice}}" class="workbench-meta">{{model.pendingReport.photoCount ? '照片 ' + model.pendingReport.photoCount + ' 张' : ''}}{{model.pendingReport.photoCount && model.pendingReport.hasVoice ? ' · ' : ''}}{{model.pendingReport.hasVoice ? '语音 1 段' : ''}}</text>
          </view>
          <button class="workbench-primary" data-project="{{model.pendingReport.projectId}}" data-record="{{model.pendingReport.recordId}}" bindtap="openApproval">审核上报<view class="workbench-chevron" /></button>
        </view>
        <view class="workbench-section boss-exceptions">
          <text class="workbench-fabric">优先处理</text>
          <view wx:for="{{model.exceptions}}" wx:key="key" class="workbench-paper exception-card">
            <view class="exception-heading"><text class="workbench-section-title">{{item.name}}</text>
              <text class="workbench-tag {{item.kind === 'late' ? 'late' : 'pending'}}">{{item.kind === 'late' ? '进度落后' : '待协调'}}</text></view>
            <text class="record-title">{{item.title}}</text>
            <text class="workbench-meta">{{item.kind === 'late' ? '负责人' : '跟进状态'}} · {{item.waitingFor || '待分配'}}</text>
            <button wx:if="{{item.kind === 'late'}}" class="workbench-row exception-link" data-project="{{item.id}}" data-node="{{item.nodeKey}}" bindtap="openNode">查看节点<view class="workbench-chevron" /></button>
            <button wx:else class="workbench-row exception-link" data-project="{{item.id}}" data-issue="{{item.issueId}}" bindtap="openIssue">查看事项<view class="workbench-chevron" /></button>
          </view>
          <view wx:if="{{!model.exceptions.length}}" class="workbench-paper workbench-state">{{model.items.length ? '暂无需要优先处理的事项' : '暂无可查看的工地'}}</view>
        </view>
        <view class="workbench-paper boss-links">
          <button class="workbench-row" bindtap="openAll">全部工地<view class="workbench-chevron" /></button>
          <button class="workbench-row" bindtap="openReports">企业日周报<view class="workbench-chevron" /></button>
        </view>
      </block>
      <block wx:else>
        <view wx:if="{{notice}}" class="workbench-paper workbench-state" role="status">{{notice}}</view>
        <view wx:if="{{!model.project}}" class="workbench-paper workbench-state">暂时没有分配的工地</view>
        <block wx:else>
          <view class="workbench-heading">
            <view class="project-copy"><text class="workbench-title">{{model.project.name}}</text><text class="workbench-stage">{{model.project.stageName}}{{model.project.status === 'paused' ? ' · 已暂停' : ''}}</text></view>
            <picker wx:if="{{model.choices.length > 1}}" class="workbench-picker" range="{{model.choices}}" range-key="name" value="{{selectedIndex}}" bindchange="changeProject">
              <view class="picker-chip">换工地<view class="workbench-chevron down" /></view>
            </picker>
          </view>
          <block wx:if="{{model.view === 'worker'}}">
            <view wx:if="{{model.task}}" class="workbench-paper worker-task">
              <text class="workbench-tag pending">今日任务</text>
              <button class="workbench-row workbench-issue-row" bindtap="openTask">
                <text class="row-title">{{model.task.title}}</text><text class="workbench-tag {{model.task.issueId ? 'pending' : 'done'}}">{{model.task.label}}</text><view class="workbench-chevron" />
              </button>
            </view>

            <view class="workbench-paper today-summary">
              <text class="workbench-fabric summary-fabric">今日汇总</text>
              <view class="summary-grid">
                <view><text class="summary-value">{{todaySummary.total}}</text><text>今日上报</text></view>
                <view><text class="summary-value pending-text">{{todaySummary.pending}}</text><text>待审核</text></view>
                <view><text class="summary-value done-text">{{todaySummary.approved}}</text><text>审核通过</text></view>
              </view>
            </view>

            <view wx:if="{{model.canCapture}}" class="workbench-section capture-section">
              <text class="workbench-section-title">现场上报</text>
              <view class="capture-actions">
                <button class="workbench-primary" data-action="photo" bindtap="capture"><image src="../assets/notebook/capture-camera.png" mode="aspectFit" />拍照</button>
                <button class="workbench-primary" data-action="voice" bindtap="capture"><image src="../assets/notebook/capture-mic.png" mode="aspectFit" />说一句</button>
              </view>
            </view>
            <text wx:else class="workbench-meta capture-paused">当前工地已暂停上报，请联系施工经理。</text>

            <view class="filter-bar">
              <button class="filter-chip {{reportRange.key === 'today' ? 'active' : ''}}" data-key="today" bindtap="selectRange">今天</button>
              <button class="filter-chip {{reportRange.key === 'yesterday' ? 'active' : ''}}" data-key="yesterday" bindtap="selectRange">昨天</button>
              <button class="filter-chip {{reportRange.key === 'week' ? 'active' : ''}}" data-key="week" bindtap="selectRange">近7天</button>
              <button class="filter-chip calendar-chip {{reportRange.key === 'custom' ? 'active' : ''}}" bindtap="openCalendar">
                <view class="calendar-glyph" aria-hidden="true"></view>日历
              </button>
            </view>

            <view class="workbench-paper report-list">
              <view class="report-list-heading">
                <text class="workbench-fabric">上报记录</text>
                <text class="workbench-meta">{{reportRange.label}}</text>
              </view>
              <view wx:if="{{reportLoading}}" class="workbench-state">正在读取上报…</view>
              <view wx:elif="{{reportError}}" class="workbench-state" role="alert"><text>{{reportError}}</text><button class="workbench-plain" bindtap="retry">重新读取</button></view>
              <view wx:elif="{{!reports.length}}" class="workbench-state">{{reportRange.key === 'today' ? '今天还没有上报' : '这段时间还没有上报'}}</view>
              <block wx:else>
                <button wx:for="{{reports}}" wx:key="recordId" class="report-row" data-record="{{item.recordId}}" bindtap="openRecord">
                  <view class="report-copy">
                    <text class="record-title">{{item.title}}</text>
                    <text class="workbench-meta">{{item.meta}}</text>
                    <text wx:if="{{item.statusClass === 'done' && item.approvedByName}}" class="workbench-meta">审核人 {{item.approvedByName}}</text>
                    <text wx:if="{{item.statusClass === 'returned' && item.returnShort}}" class="return-hint">退回：{{item.returnShort}}</text>
                  </view>
                  <view class="report-status">
                    <text class="workbench-tag {{item.statusClass}}">{{item.statusLabel}}</text>
                    <view class="workbench-chevron" />
                  </view>
                </button>
              </block>
            </view>

            <button class="workbench-row workbench-link" bindtap="openReports">
              <image src="../assets/notebook/file.png" mode="aspectFit" /><text class="row-title">工地日报与周报</text><view class="workbench-chevron" />
            </button>
          </block>
          <block wx:elif="{{model.view === 'manager'}}">
            <view class="workbench-section">
              <text class="workbench-fabric">待审核上报</text>
              <view wx:if="{{model.draft}}" class="workbench-paper manager-draft">
                <view class="draft-source">
                  <view class="record-copy">
                    <text class="record-title draft-title">{{model.draft.title}}</text>
                    <text class="workbench-meta">{{model.draft.authorName}} · {{model.draft.time}}</text>
                    <text wx:if="{{model.draft.photoCount || model.draft.hasVoice}}" class="workbench-meta">{{model.draft.photoCount ? '照片 ' + model.draft.photoCount + ' 张' : ''}}{{model.draft.photoCount && model.draft.hasVoice ? ' · ' : ''}}{{model.draft.hasVoice ? '语音 1 段' : ''}}</text>
                  </view>
                  <image wx:if="{{photo}}" class="draft-photo" src="{{photo}}" mode="aspectFill" />
                </view>
                <button class="workbench-primary" data-project="{{model.project.id}}" data-record="{{model.draft.recordId}}" bindtap="openApproval">审核上报<view class="workbench-chevron" /></button>
              </view>
              <view wx:else class="workbench-paper workbench-state empty-fabric">暂无待审核上报</view>
            </view>
            <view class="workbench-paper workbench-section manager-review">
              <text class="workbench-section-title">整改复查</text>
              <template wx:if="{{model.review}}" is="issue-row" data="{{issue: model.review, label: '待复查'}}" />
              <text wx:else class="workbench-meta workbench-empty">暂无待复查事项</text>
              <text wx:if="{{model.review.recordId}}" class="workbench-meta">已补拍</text>
            </view>
            <button class="workbench-row workbench-link" bindtap="openProject">查看工地<view class="workbench-chevron" /></button>
          </block>
          <block wx:else>
            <view wx:if="{{model.pendingReport}}" class="workbench-section">
              <text class="workbench-fabric">待审核上报</text>
              <view class="workbench-paper manager-draft">
                <view class="draft-source">
                  <view class="record-copy">
                    <text class="record-title draft-title">{{model.pendingReport.title}}</text>
                    <text class="workbench-meta">{{model.pendingReport.authorName}} · {{model.pendingReport.time}}</text>
                    <text wx:if="{{model.pendingReport.photoCount || model.pendingReport.hasVoice}}" class="workbench-meta">{{model.pendingReport.photoCount ? '照片 ' + model.pendingReport.photoCount + ' 张' : ''}}{{model.pendingReport.photoCount && model.pendingReport.hasVoice ? ' · ' : ''}}{{model.pendingReport.hasVoice ? '语音 1 段' : ''}}</text>
                  </view>
                </view>
                <button class="workbench-primary" data-project="{{model.pendingReport.projectId}}" data-record="{{model.pendingReport.recordId}}" bindtap="openApproval">审核上报<view class="workbench-chevron" /></button>
              </view>
            </view>
            <view class="workbench-section">
              <text class="workbench-fabric">待我答复</text>
              <view wx:if="{{model.reply.length}}" class="workbench-paper designer-reply">
                <text class="workbench-section-title">{{model.reply[0].title}}</text>
                <text wx:if="{{model.reply[0].roomName}}" class="workbench-meta">{{model.reply[0].roomName}}</text>
                <button class="workbench-primary reply-primary" data-issue="{{model.reply[0].issueId}}" bindtap="openIssue">查看并回复<view class="workbench-chevron" /></button>
                <block wx:for="{{model.reply}}" wx:key="issueId"><template wx:if="{{index > 0}}" is="issue-row" data="{{issue: item, label: '待回复'}}" /></block>
              </view>
              <view wx:else class="workbench-paper workbench-state empty-fabric">暂无待回复的现场问题</view>
            </view>
            <view class="workbench-paper workbench-section designer-changes">
              <text class="workbench-section-title">待核对变更</text>
              <block wx:for="{{model.changes}}" wx:key="issueId"><template is="issue-row" data="{{issue: item, label: '待核对'}}" /></block>
              <text wx:if="{{!model.changes.length}}" class="workbench-meta workbench-empty">暂无待核对变更</text>
            </view>
          </block>
          <button class="workbench-row workbench-link {{model.view === 'designer' ? 'designer-report' : ''}}" bindtap="openReports">
            <image wx:if="{{model.view === 'designer'}}" src="../assets/notebook/file.png" mode="aspectFit" /><text class="row-title">工地日报与周报</text><view class="workbench-chevron" />
          </button>
        </block>
        <button wx:if="{{model.view === 'designer'}}" class="workbench-row workbench-paper designer-tool" bindtap="openDesign">
          <image src="/images/mine-icons/tab-ai-active.png" mode="aspectFit" /><text class="row-title">AI 设计</text><text class="workbench-meta">选择户型</text><view class="workbench-chevron" />
        </button>
      </block>
    </view>
  </scroll-view>

  <view wx:if="{{showCalendar}}" class="overlay is-open" catchtouchmove="noop">
    <view class="sheet calendar-sheet">
      <view class="sheet-tag-row">
        <text class="sheet-fabric">选择日期</text>
        <button class="text-action" bindtap="resetCalendar">重置</button>
      </view>
      <view class="calendar-quick">
        <button class="filter-chip" data-key="today" bindtap="pickCalendarQuick">今天</button>
        <button class="filter-chip" data-key="yesterday" bindtap="pickCalendarQuick">昨天</button>
        <button class="filter-chip" data-key="week" bindtap="pickCalendarQuick">近7天</button>
        <button class="filter-chip" data-key="month" bindtap="pickCalendarQuick">本月</button>
      </view>
      <view class="calendar-month">
        <button class="calendar-arrow" bindtap="calendarPrev" aria-label="上个月">‹</button>
        <text>{{calendar.monthLabel}}</text>
        <button class="calendar-arrow" bindtap="calendarNext" aria-label="下个月">›</button>
      </view>
      <view class="calendar-weekdays">
        <text wx:for="{{['一','二','三','四','五','六','日']}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="calendar-weeks">
        <view wx:for="{{calendar.weeks}}" wx:key="index" wx:for-item="week" wx:for-index="weekIndex" class="calendar-week">
          <view wx:for="{{week}}" wx:key="key" wx:for-item="day"
            class="calendar-day {{day.disabled ? 'disabled' : ''}} {{day.inRange ? 'in-range' : ''}} {{day.start || day.end ? 'range-end' : ''}} {{day.today ? 'today' : ''}}"
            data-date="{{day.date}}" bindtap="pickCalendar">
            <text>{{day.day}}</text>
          </view>
        </view>
      </view>
      <view class="calendar-summary">
        <text>最多可查近3个月</text>
        <text>{{calendar.rangeLabel}}</text>
      </view>
      <button class="primary" bindtap="applyCalendar">查看这段时间的记录</button>
    </view>
  </view>

  <view wx:if="{{showDetail}}" class="overlay is-open" catchtouchmove="noop">
    <view class="sheet detail-sheet">
      <view class="detail-heading">
        <text class="sheet-fabric">上报详情</text>
        <button class="detail-close" bindtap="closeDetail" aria-label="关闭">×</button>
      </view>
      <scroll-view class="detail-scroll" scroll-y enhanced show-scrollbar="{{false}}">
        <view wx:if="{{detailLoading}}" class="detail-state">正在读取上报…</view>
        <view wx:elif="{{detailError}}" class="detail-state" role="alert"><text>{{detailError}}</text><button class="text-action" bindtap="closeDetail">关闭</button></view>
        <block wx:elif="{{detail}}">
          <view class="paper detail-status">
            <view class="detail-status-copy">
              <text class="workbench-tag {{detail.statusClass}}">{{detail.statusLabel}}</text>
              <text wx:if="{{detail.approvedByName}}" class="workbench-meta">审核人 {{detail.approvedByName}} · {{detail.approvedAt}}</text>
              <text wx:elif="{{detail.statusClass === 'pending'}}" class="workbench-meta">等待施工经理、设计师或老板审核</text>
            </view>
            <view class="detail-check {{detail.statusClass}}">✓</view>
          </view>
          <text class="detail-title">{{detail.title}}</text>
          <text class="workbench-meta detail-meta">{{detail.time}} · {{model.project.name}}</text>
          <view class="detail-stages">
            <text wx:if="{{detail.stageText}}" class="stage-pill">{{detail.stageText}}</text>
            <text class="workbench-meta">本次上报阶段</text>
          </view>
          <view wx:if="{{detailPhotos.length}}" class="detail-photos">
            <image wx:for="{{detailPhotos}}" wx:key="id" src="{{item.path}}" mode="aspectFill" data-path="{{item.path}}" bindtap="previewDetail" />
          </view>
          <view wx:if="{{detail.speech}}" class="detail-voice" bindtap="playDetailVoice">
            <image src="../assets/notebook/capture-mic.png" mode="aspectFit" />
            <text>语音 {{detail.speechSeconds}}秒</text>
            <view class="detail-play {{detailPlaying ? 'playing' : ''}}" aria-hidden="true"></view>
          </view>
          <view wx:if="{{detail.reviewRequirements}}" class="paper return-paper">
            <text class="workbench-fabric">需补充</text>
            <text class="detail-text">{{detail.reviewRequirements}}</text>
            <button class="primary" bindtap="openDetailRework">按退回要求补充</button>
          </view>
          <view class="paper detail-content">
            <text class="workbench-fabric">上报内容</text>
            <view wx:if="{{detail.completed}}" class="detail-row"><text class="detail-label">本次完成</text><text class="detail-text">{{detail.completed}}</text></view>
            <view wx:if="{{detail.pending}}" class="detail-row"><text class="detail-label">尚未完成</text><text class="detail-text">{{detail.pending}}</text></view>
            <view wx:if="{{detail.coordination}}" class="detail-row"><text class="detail-label">待沟通</text><text class="detail-text">{{detail.coordination}}</text></view>
            <view wx:if="{{detail.note}}" class="detail-row"><text class="detail-label">补充说明</text><text class="detail-text">{{detail.note}}</text></view>
          </view>
          <button class="text-action detail-report-link" bindtap="openReports">查看工地日报与周报</button>
        </block>
      </scroll-view>
    </view>
  </view>
</view>
