<view class="family-layer {{open ? 'is-open' : ''}}">
  <view class="family-mask" bindtap="close" catchtouchmove="stop" aria-hidden="true" />
  <view class="family-sheet" role="dialog" aria-label="{{inviteCodeOpen ? '当面扫码' : '家人查看'}}">
    <image class="family-sheet-paper" src="../assets/notebook/capture-v3-paper.png" mode="aspectFill" aria-hidden="true" />
    <view class="family-grip" aria-hidden="true" />
    <view class="family-heading">
      <text>{{inviteCodeOpen ? '当面扫码' : '家人查看'}}</text>
      <button wx:if="{{inviteCodeOpen}}" class="family-close family-link" bindtap="closeInviteCode" aria-label="返回家人查看">返回</button>
      <button wx:else class="family-close" bindtap="close" aria-label="关闭家人查看">
        <image src="../assets/notebook/close.png" mode="aspectFit" />
      </button>
    </view>
    <scroll-view class="family-scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <view wx:if="{{inviteCodeOpen}}" class="family-content family-code">
        <text class="family-help">请家人用微信扫一扫</text>
        <image wx:if="{{inviteCodePath}}" class="family-code-image" src="{{inviteCodePath}}" mode="aspectFit" show-menu-by-longpress bindtap="previewInviteCode" aria-label="家人邀请小程序码" />
        <view wx:else class="family-code-state">
          <text wx:if="{{inviteCodeLoading}}" class="family-meta">正在生成小程序码…</text>
          <view wx:elif="{{inviteCodeError}}" class="family-inline-state family-feedback" role="alert">
            <text>{{inviteCodeError}}</text><button class="family-link" bindtap="loadInviteCode">重试</button>
          </view>
        </view>
      </view>
      <view wx:else class="family-content">
        <text class="family-help">家人可查看施工进度和已授权的直播。</text>
        <button wx:if="{{inviteToken}}" class="family-share" open-type="share" data-share-type="owner-family">微信邀请家人</button>
        <button wx:else class="family-share" bindtap="createInvite" disabled="{{inviteLoading}}">{{inviteLoading ? '正在准备邀请…' : (inviteError ? '重试' : '准备邀请')}}</button>
        <text wx:if="{{inviteError}}" class="family-feedback" role="alert">{{inviteError}}</text>
        <view class="family-invite-meta">
          <text class="family-meta">每位家人一张邀请卡</text>
          <button class="family-link family-code-link" bindtap="openInviteCode" aria-label="当面扫码邀请">
            <text>当面扫码</text>
            <image src="../assets/notebook/arrow-right.png" mode="aspectFit" />
          </button>
        </view>

        <view class="family-viewers">
          <view class="family-viewer-heading">
            <text>已加入的家人</text>
            <text wx:if="{{viewerLoading}}" class="family-meta">加载中…</text>
            <text wx:elif="{{!viewerError && !viewers.length}}" class="family-meta">暂无</text>
          </view>
          <view wx:if="{{viewerError}}" class="family-inline-state family-feedback" role="alert">
            <text>{{viewerError}}</text><button class="family-link" bindtap="loadViewers">重试</button>
          </view>
          <view wx:for="{{viewers}}" wx:key="viewerId" class="family-viewer">
            <view class="family-viewer-label"><text class="family-viewer-name">{{item.nickname}}</text><text class="family-meta">可查看</text></view>
            <button class="family-link family-remove" data-viewer="{{item.viewerId}}" data-version="{{item.version}}" bindtap="revokeViewer" disabled="{{busy || viewerLoading}}">移除</button>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
