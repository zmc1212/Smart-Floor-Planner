<!-- PPT20/25 proactive-service/boss.png, 853x1844. Live records replace illustrative photos and example claims. -->
<view class="construction-page brief-page">
  <view class="book-spine"><view wx:for="{{[0,1,2,3,4,5]}}" wx:key="*this" class="book-stitch" style="top:{{88 + item * 130}}px"/></view>
  <view class="book-nav" style="padding-top:{{navTop}}px;padding-right:{{navRight}}px"><button class="book-back" bindtap="back" aria-label="返回"><image src="../assets/notebook/back.png"/></button><text class="book-nav-title">项目简报</text></view>
  <view class="content">
    <view class="brief-context">公司项目 / 今日简报</view>
    <view wx:if="{{loading}}" class="surface state">正在读取项目简报…</view>
    <view wx:elif="{{error}}" class="surface state"><text>{{error}}</text><button bindtap="load">重新读取</button></view>
    <view wx:elif="{{!items.length}}" class="surface state"><text>暂无有管理权限的工地</text><button bindtap="load">重新读取</button></view>
    <view wx:else class="brief-assistant">
      <view class="brief-intro"><image src="../assets/notebook/xiaok-chat.png" mode="aspectFit" /><view><text class="fabric">小K</text><text class="intro-copy">项目团队的新记录和还在等回复的事项，帮你整理好了。</text></view></view>
      <view class="brief-paper">
        <view class="brief-title"><image src="../assets/notebook/file.png" mode="aspectFit" /><text class="section-title">今日项目简报</text></view>
        <text class="helper">依据已上传记录 · {{asOf}}</text>
        <view wx:for="{{items}}" wx:key="projectId" wx:for-item="project" class="brief-project" data-project="{{project.projectId}}" data-issue="{{project.focusIssueId}}" bindtap="openProject" aria-role="button" aria-label="{{project.name + '，查看原记录和事项'}}">
          <view class="project-heading"><text class="project-name">{{project.name}}</text><text class="stage-tag">{{project.stageName}}</text><view class="chevron forward"></view></view>
          <text wx:if="{{project.progressNote}}" class="helper">{{project.progressNote}}</text>
          <text class="brief-summary">{{project.summary}}</text>
          <text wx:if="{{project.latestRecord}}" class="helper">{{project.latestRecord.authorName}} · 记录{{project.latestRecord.id}}</text>
          <text wx:if="{{project.hasMoreIssues}}" class="helper">仅整理最近50条事项，更多事项请进入原项目查看。</text>
        </view>
        <text wx:if="{{hasMoreProjects}}" class="helper">本次显示最近20个有管理权限的项目，更多项目请返回总览查看。</text>
        <text class="brief-originals">每条进展都可以查看原记录 ›</text>
      </view>
      <text class="brief-note">未回复不等于施工异常。未记录明确期限时，不推断逾期。</text>
      <view class="brief-actions"><button class="primary" bindtap="back">查看项目明细</button><button class="outline" bindtap="ask">追问小K</button></view>
    </view>
  </view>
</view>
