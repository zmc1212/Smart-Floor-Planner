<view class="live-notebook">
  <view class="book-spine"><view wx:for="{{[0,1,2,3,4,5]}}" wx:key="*this" class="book-stitch" style="top:{{88 + item * 130}}px"/></view>
  <view class="book-nav" style="padding-top:{{navTop}}px;padding-right:{{navRight}}px"><button class="book-back" bindtap="back" aria-label="返回"><image src="../assets/notebook/back.png"/></button><text class="book-nav-title">工地直播</text></view>
  <view class="content live-content"><text class="page-title">{{detail.name || '公开工地'}}</text><view class="live-context"><text class="stage-tag">{{detail.alias || '公开机位'}}</text><text class="helper">业主授权公开</text></view>
    <view class="live-mode"><text class="fabric">{{state === 'playing' ? '直播中' : state === 'paused' ? '已暂停' : state === 'failed' ? '连接失败' : state === 'stopped' ? '已停止公开' : '正在连接'}}</text></view>
    <view class="live-video-mat {{shareAvailable ? 'has-share' : ''}}">
      <native-live-player id="public-live-player" src="{{src}}" epoch="{{playerEpoch}}" phase="{{state}}"
        pausable="{{true}}" track-progress="{{true}}" audio-allowed="{{false}}"
        message="{{error || (state === 'connecting' ? '正在连接直播' : '')}}"
        bindadvance="played" bindplaybackerror="playbackError" bindplay="retry" bindpause="pause">
        <button wx:if="{{state === 'stopped'}}" class="live-player-back" bindtap="back">返回工地</button>
      </native-live-player>
    </view>
    <button wx:if="{{shareAvailable}}" id="public-live-share" class="primary live-share" open-type="share">
      <image class="book-icon" src="../assets/notebook/public-live-share-icon.png" mode="aspectFit" aria-hidden="true" />
      <text>分享给朋友</text>
    </button>
    <view class="paper live-scope"><text class="section-title">公开机位</text><text class="body-text">{{detail.alias || '当前不可用'}}</text><text class="helper">仅此机位的实时无声画面。</text><text class="helper">由业主授权，经企业审核公开。</text></view>
    <text wx:if="{{aiEntriesEnabled && guideQuestion && canConsult && shareAvailable}}" class="helper live-guide">{{guideQuestion}}</text>
    <button wx:if="{{aiEntriesEnabled && canConsult && shareAvailable}}" class="primary live-primary {{guideQuestion ? 'with-guide' : ''}}" bindtap="consult">围观中有疑问？问小K</button><button class="book-link live-link" bindtap="back">返回工地详情 ↗</button><button wx:if="{{aiEntriesEnabled && canConsult && shareAvailable}}" class="book-link" data-designer="1" bindtap="consult">找设计师聊 ↗</button>
  </view>
</view>
