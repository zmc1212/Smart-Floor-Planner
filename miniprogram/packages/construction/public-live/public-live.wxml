<view class="live-notebook">
  <view class="book-spine"><view wx:for="{{[0,1,2,3,4,5]}}" wx:key="*this" class="book-stitch" style="top:{{88 + item * 130}}px"/></view>
  <view class="book-nav" style="padding-top:{{navTop}}px;padding-right:{{navRight}}px"><button class="book-back" bindtap="back" aria-label="返回"><image src="../assets/notebook/back.png"/></button><text class="book-nav-title">工地直播</text></view>
  <view class="content live-content"><text class="page-title">{{detail.name || '公开工地'}}</text><view class="live-context"><text class="stage-tag">{{detail.alias || '公开机位'}}</text><text class="helper">业主授权公开</text></view>
    <view class="live-mode"><text class="fabric">{{state === 'playing' ? '直播中' : state === 'paused' ? '已暂停' : state === 'failed' ? '连接失败' : state === 'stopped' ? '已停止公开' : '正在连接'}}</text></view>
    <view class="live-video-mat"><view class="live-video-frame"><video wx:if="{{src}}" id="public-live-video" src="{{src}}" data-player-epoch="{{playerEpoch}}" autoplay muted object-fit="contain" controls="{{false}}" show-center-play-btn="{{false}}" show-play-btn="{{false}}" enable-progress-gesture="{{false}}" bindtimeupdate="played" binderror="playbackError"/><view wx:if="{{!src || state === 'connecting'}}" class="live-state-layer"><text>{{error || '正在连接直播'}}</text><button wx:if="{{state === 'failed'}}" bindtap="retry">重试</button><button wx:if="{{state === 'stopped'}}" bindtap="back">返回工地</button></view></view><view wx:if="{{src}}" class="live-video-tools"><button id="public-live-toggle" bindtap="toggle" disabled="{{state !== 'playing' && state !== 'paused'}}">{{paused ? '继续观看' : '暂停'}}</button><text>实时 · 无声</text><button bindtap="fullscreen">全屏</button></view></view>
    <view class="paper live-scope"><text class="section-title">公开机位</text><text class="body-text">{{detail.alias || '当前不可用'}}</text><text class="helper">仅此机位的实时无声画面。</text><text class="helper">由业主授权，经企业审核公开。</text></view>
    <button class="primary live-primary" bindtap="consult">围观中有疑问？问小K</button><button class="book-link live-link" bindtap="back">返回工地详情 ↗</button><button class="book-link" bindtap="designer">找设计师聊 ↗</button>
  </view>
</view>
