<view class="owner-site-page">
  <image class="site-paper-grain" src="../assets/notebook/capture-v3-paper.png" mode="aspectFill" aria-hidden="true" />
  <view class="book-spine" aria-hidden="true">
    <view class="book-stitch" style="top: 84px;" />
    <view class="book-stitch" style="top: 37%;" />
    <view class="book-stitch" style="top: 61%;" />
    <view class="book-stitch" style="bottom: 34px;" />
  </view>
  <view class="site-nav" style="padding-top: {{navTop}}px; padding-right: {{navRight}}px; min-height: {{navHeight}}px;">
    <text class="book-nav-title">我家工地</text>
  </view>
  <scroll-view class="site-scroll" scroll-y="{{!familyVisible}}" enhanced show-scrollbar="{{false}}">
    <view class="site-content">
      <view wx:if="{{!needsLogin && (error || loading || projectLoading || projectError)}}" class="site-paper site-state">
        <text>{{error || projectError || '正在读取工地…'}}</text>
        <button wx:if="{{error || projectError}}" class="text-action" bindtap="retryProject">重新读取</button>
      </view>
      <view wx:elif="{{needsLogin || (!project && !familyProjects.length)}}" class="site-empty">
        <view class="site-empty-art" aria-hidden="true">
          <image wx:if="{{needsLogin}}" src="../assets/notebook/owner-site-empty-guest.png" mode="aspectFit" />
          <image wx:else src="../assets/notebook/owner-site-empty-signed-in.png" mode="aspectFit" />
        </view>
        <text class="site-empty-heading">{{needsLogin ? '打开你的施工手账' : '暂无关联工地'}}</text>
        <view class="site-empty-copy {{needsLogin ? '' : 'site-empty-copy-signed-in'}}">
          <text>{{needsLogin ? '登录后可查看施工进度、' : '已有工地？请联系装修团队开通权限。'}}</text>
          <text>{{needsLogin ? '现场照片和工地日报。' : '收到家人邀请，可从微信邀请卡加入。'}}</text>
        </view>
        <button wx:if="{{needsLogin}}" class="site-empty-action site-empty-login" hover-class="site-empty-action-pressed" bindtap="login">
          <text>去登录</text>
          <view class="site-chevron" aria-hidden="true" />
        </button>
        <button wx:else class="site-empty-action site-empty-refresh" hover-class="site-empty-action-pressed" bindtap="retryProject">
          <text>刷新工地</text>
          <image class="site-empty-refresh-icon" src="/images/ai-studio-icons-v3/refresh.png" mode="aspectFit" aria-hidden="true" />
        </button>
      </view>
      <block wx:else>
        <block wx:if="{{project}}">
        <picker wx:if="{{projects.length > 1}}" range="{{projects}}" range-key="name" value="{{selectedIndex}}" bindchange="selectProject">
          <view class="site-project-selector"><text class="site-project-title">{{project.name}}</text><view class="site-chevron site-chevron-down" /></view>
        </picker>
        <text wx:else class="site-project-title">{{project.name}}</text>
        <view class="site-stage">
          <view class="site-stage-current">
            <button wx:if="{{schedule.nodes.length}}" class="site-stage-control" bindtap="toggleSchedule" aria-label="查看施工排期" aria-expanded="{{scheduleOpen}}">
              <view class="site-stage-label">当前阶段<view class="site-chevron {{scheduleOpen ? 'site-chevron-up' : 'site-chevron-down'}}" /></view>
            </button>
            <text wx:else class="site-stage-label">当前阶段</text>
            <text class="site-stage-value">{{project.stageName || (project.progressAccess ? '待更新' : '暂无可查看阶段')}}</text>
          </view>
          <button wx:if="{{scheduleError}}" class="site-schedule-retry" bindtap="readSchedule">{{scheduleError}} · 重试</button>
          <text wx:elif="{{project.progressAccess}}" class="site-schedule-status site-schedule-{{schedule.color || 'gray'}}">{{scheduleLoading ? '读取排期…' : schedule.label}}</text>
        </view>
        <view wx:if="{{scheduleOpen && schedule.nodes.length}}" class="site-paper site-schedule">
          <view wx:for="{{schedule.nodes}}" wx:key="key" class="site-schedule-node">
            <view class="site-schedule-dot site-schedule-dot-{{item.color}}" />
            <view class="site-schedule-node-copy">
              <text>{{item.roomName ? item.roomName + ' · ' : ''}}{{item.stageName}}</text>
              <text class="site-meta">{{item.label}}<text wx:if="{{item.timeText && item.timeText !== item.label}}"> · {{item.timeText}}</text><text wx:elif="{{!item.timeText && item.plannedStart}}"> · {{item.plannedStart}} 至 {{item.plannedEnd}}</text></text>
            </view>
          </view>
        </view>

        <button wx:if="{{camera}}" class="site-paper site-camera" bindtap="openCamera" aria-label="查看监控">
          <view class="site-camera-frame">
            <image wx:if="{{camera.src}}" class="site-camera-image" src="{{camera.src}}" mode="aspectFill"
              binderror="cameraImageFailed" data-date="{{camera.dateLabel}}" />
            <text wx:else class="site-camera-placeholder">监控封面暂不可用</text>
            <view class="site-camera-play" aria-hidden="true"><view class="site-play-triangle" /></view>
          </view>
          <view class="site-camera-footer">
            <view class="site-camera-meta"><text class="site-camera-name">{{camera.name}}</text><text wx:if="{{camera.dateLabel}}" class="site-meta">{{camera.dateLabel}}</text></view>
            <view class="site-camera-cta"><text>查看监控</text><view class="site-chevron" /></view>
          </view>
        </button>
        <view wx:else class="site-paper site-state site-camera-state">
          <text>{{cameraLoading ? '正在读取监控…' : (cameraError || '工地监控尚未开通')}}</text>
          <button wx:if="{{cameraError}}" class="text-action" bindtap="retryCover">重新读取</button>
        </view>

        <view wx:if="{{liveApplication.canDecide || report.pending.length}}" class="site-paper site-pending">
          <button wx:if="{{liveApplication.canDecide}}" class="site-pending-row site-live-application" bindtap="openLiveApplication">
            <text class="site-pending-label">待我确认</text>
            <text class="site-row-title">直播公开申请 · {{liveApplication.alias}}</text><view class="site-chevron" />
          </button>
          <button wx:for="{{report.pending}}" wx:key="key" class="site-pending-row" data-record="{{item.recordId}}" bindtap="openReport">
            <text wx:if="{{index === 0 && !liveApplication.canDecide}}" class="site-pending-label">现场待沟通</text>
            <text class="site-row-title">{{item.text}}</text><view class="site-chevron" />
          </button>
        </view>
        <view wx:if="{{liveApplication && !liveApplication.canDecide}}" class="site-paper site-live-progress">
          <button class="site-pending-row" bindtap="openLiveApplication">
            <view><text>直播公开进度 · {{liveApplication.alias}}</text><text class="site-meta">{{liveApplication.statusLabel}}</text></view>
            <view class="site-chevron" />
          </button>
        </view>
        <view wx:if="{{liveError}}" class="site-paper site-state">
          <text>{{liveError}}</text><button class="text-action" bindtap="retryLiveApplication">重新读取</button>
        </view>

        <view class="site-paper site-report">
          <view class="site-report-heading"><text class="fabric site-report-label">最新日报</text><text class="site-meta">{{report.dateLabel}}</text></view>
          <view wx:if="{{report.progress.length}}" class="site-report-lines">
            <view wx:for="{{report.progress}}" wx:key="index" class="site-report-line"><view class="site-bullet" /><text>{{item}}</text></view>
          </view>
          <text wx:else class="site-meta site-report-empty">{{report ? '这份日报暂无进展摘要' : '暂无已发布的日报'}}</text>
          <view wx:if="{{project.progressAccess}}" class="site-report-actions">
            <button wx:if="{{report}}" class="site-report-ask" bindtap="askXiaok" disabled="{{!report.bindingId || !project.leadId}}">问小K</button>
            <view wx:if="{{report}}" class="site-report-divider" aria-hidden="true"></view>
            <button class="site-report-link text-action" bindtap="openReport"><text>查看日报与周报</text><view class="site-chevron" /></button>
          </view>
        </view>

        <view wx:if="{{project.progressAccess}}" class="site-paper site-utility">
          <button class="site-utility-row site-reminders-toggle" bindtap="toggleSiteReminders" aria-expanded="{{remindersOpen}}">
            <text>当前提醒</text><view class="site-chevron {{remindersOpen ? 'site-chevron-down' : ''}}" />
          </button>
          <block wx:if="{{remindersOpen}}">
            <text wx:if="{{remindersLoading}}" class="site-meta site-report-empty">正在读取提醒…</text>
            <view wx:elif="{{remindersError}}" class="site-reminder-state" role="alert"><text class="site-meta">{{remindersError}}</text><button class="text-action" bindtap="loadSiteReminders">重试</button></view>
            <text wx:elif="{{!siteReminders.length}}" class="site-meta site-report-empty">暂无已送达的提醒</text>
            <view wx:for="{{siteReminders}}" wx:key="reminderId" class="site-reminder-row">
              <button class="site-utility-row site-reminder-item" bindtap="openSiteReminder" data-id="{{item.reminderId}}" aria-expanded="{{reminderDetail.reminderId === item.reminderId}}">
                <view class="site-reminder-heading"><text>{{item.title}}</text><text wx:if="{{item.dateLabel}}" class="site-meta">{{item.dateLabel}}</text></view>
                <text class="site-reminder-status {{item.readAt ? 'site-meta' : 'site-reminder-unread'}}">{{item.readAt ? '已读' : '未读'}}</text>
              </button>
              <block wx:if="{{reminderSelected === item.reminderId}}">
                <text wx:if="{{reminderReading}}" class="site-meta site-report-empty">正在读取提醒…</text>
                <view wx:elif="{{reminderReadError}}" class="site-reminder-state" role="alert"><text class="site-meta">{{reminderReadError}}</text><button class="text-action" bindtap="openSiteReminder" data-id="{{item.reminderId}}">重试</button></view>
                <text wx:elif="{{reminderDetail}}" class="site-reminder-body" user-select>{{reminderDetail.body}}</text>
              </block>
            </view>
          </block>
          <button class="site-utility-row site-family" bindtap="openFamilySheet" aria-label="家人查看，邀请与管理">
            <text>家人查看</text><view class="site-family-action"><text>邀请与管理</text><view class="site-chevron" /></view>
          </button>
        </view>
        </block>
        <view wx:if="{{familyProjects.length}}" class="site-family-shared">
          <view class="site-family-shared-head">
            <text class="site-family-shared-title">家人分享的工地</text>
            <text class="site-meta">只读查看施工进度和直播</text>
          </view>
          <button wx:for="{{familyProjects}}" wx:key="id" class="site-paper site-family-shared-card" data-id="{{item.id}}" bindtap="openFamilyProject">
            <view class="site-family-shared-main">
              <text class="site-family-shared-name">{{item.name}}</text>
              <text class="site-meta">家人查看</text>
            </view>
            <view class="site-chevron" />
          </button>
        </view>
      </block>
    </view>
  </scroll-view>
  <family-sheet wx:if="{{familyVisible}}" id="owner-family-sheet" project-id="{{project.id}}" binddismiss="closeFamilySheet" />
</view>
