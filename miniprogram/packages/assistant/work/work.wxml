<!-- D-02 (780x1688 -> 390x844): work detail with 3D entry, space filter, grouped galleries and design notes. -->
<view class="portfolio-page">
  <view class="portfolio-nav" style="padding-top: {{navigationTop}}px; padding-right: {{navigationRight}}px;"><view class="portfolio-nav-lane" style="min-height: {{navigationHeight}}px;"><button class="back" bindtap="back" aria-label="返回"><image src="../assets/arrow-left.png" /></button><text class="nav-title">作品详情</text></view></view>
  <view class="portfolio-content">
    <text wx:if="{{loading}}" class="state-copy">正在读取作品…</text>
    <view wx:if="{{error}}" class="notice" role="alert"><text>{{error}}</text><button wx:if="{{needsLogin}}" bindtap="login">去登录</button><button wx:elif="{{pendingAction}}" bindtap="retryWrite" disabled="{{busy}}">核对操作结果</button><button wx:else bindtap="retry">重新读取</button></view>
    <block wx:if="{{work && !unavailable}}">
      <view class="work-intro">
        <text class="designer-bio">{{work.authorName}} · {{work.authorRole}}</text>
        <text class="detail-title">{{work.title}}</text>
        <text class="work-metadata">{{work.metadata}}</text>
        <text class="city-label">{{work.cityName}}{{work.district ? ' · ' + work.district : ''}}{{work.community ? ' · ' + work.community.name : ''}}</text>
        <text class="detail-description">{{work.description}}</text>
        <view wx:if="{{work.styleTags.length || work.layoutTypes.length}}" class="tag-row intro-tags">
          <text wx:for="{{work.styleTags}}" wx:for-item="tag" wx:key="*this" class="work-tag style-tag">{{tag}}</text>
          <text wx:for="{{work.layoutTypes}}" wx:for-item="tag" wx:key="*this" class="work-tag">{{tag}}</text>
        </view>
      </view>
      <button wx:if="{{work.tours.length}}" class="tour-card" bindtap="openTour" aria-label="查看3D空间">
        <view class="tour-icon"><image src="../assets/tour-3d.png" /></view>
        <view class="tour-copy"><text class="tour-title">3D 空间 · 在线看房</text><text class="tour-meta">{{work.tourCount}} 个空间 · {{work.tourProviderLabel}}</text></view>
        <view wx:if="{{images['i' + work.coverAssetId]}}" class="tour-thumb"><image class="tour-thumb-image" src="{{images['i' + work.coverAssetId]}}" mode="aspectFill" /><view class="tour-play"><image src="../assets/tour-play.png" /></view></view>
        <view class="tour-arrow"><view class="chevron" /></view>
      </button>
      <view wx:if="{{work.hasSpaceTags}}" class="space-filter">
        <text class="space-filter-label">空间</text>
        <scroll-view class="space-scroll" scroll-x="true" enable-flex="true" show-scrollbar="{{false}}">
          <view class="space-chip-row">
            <button class="filter-chip {{spaceFilter === 'all' ? 'is-active' : ''}}" data-space="all" bindtap="setSpace">全部 {{work.images.length}}</button>
            <button wx:for="{{work.spaceGroups}}" wx:key="key" class="filter-chip {{spaceFilter === item.key ? 'is-active' : ''}}" data-space="{{item.key}}" bindtap="setSpace">{{item.label}} {{item.count}}</button>
          </view>
        </scroll-view>
      </view>
      <view wx:if="{{work.renders.length}}" class="gallery-section">
        <view class="gallery-heading"><text class="section-title">效果图</text><text class="gallery-count">{{work.renders.length}} 张</text></view>
        <view class="gallery-grid">
          <view wx:for="{{work.renders}}" wx:key="assetId" class="gallery-item">
            <view class="gallery-image">
              <image wx:if="{{images['i' + item.assetId]}}" src="{{images['i' + item.assetId]}}" mode="aspectFill" data-id="{{item.assetId}}" bindtap="preview" />
              <text wx:else class="image-loading">图片加载中</text>
              <text wx:if="{{item.space}}" class="image-badge space-badge">{{item.space}}</text>
              <text class="image-badge">{{item.label}}</text>
            </view>
            <text wx:if="{{item.caption}}" class="image-caption">{{item.caption}}</text>
          </view>
        </view>
      </view>
      <view wx:if="{{work.photos.length}}" class="gallery-section">
        <view class="gallery-heading"><text class="section-title">实拍图</text><text class="gallery-count">{{work.photos.length}} 张</text></view>
        <view class="gallery-grid">
          <view wx:for="{{work.photos}}" wx:key="assetId" class="gallery-item">
            <view class="gallery-image">
              <image wx:if="{{images['i' + item.assetId]}}" src="{{images['i' + item.assetId]}}" mode="aspectFill" data-id="{{item.assetId}}" bindtap="preview" />
              <text wx:else class="image-loading">图片加载中</text>
              <text wx:if="{{item.space}}" class="image-badge space-badge">{{item.space}}</text>
              <text class="image-badge">{{item.label}}</text>
            </view>
            <text wx:if="{{item.caption}}" class="image-caption">{{item.caption}}</text>
          </view>
        </view>
      </view>
      <view wx:if="{{work.hasSpaceTags && !work.renders.length && !work.photos.length}}" class="state-copy">这个空间下暂无图片，可以查看全部。</view>
      <button wx:if="{{imageError}}" class="state-copy" bindtap="retryImages">{{imageError}}</button>
      <view wx:if="{{work.highlights.length || work.materials.length || work.palette.length}}" class="highlights-section">
        <text class="section-title">设计亮点</text>
        <view wx:if="{{work.highlights.length}}" class="highlight-list">
          <view wx:for="{{work.highlights}}" wx:key="*this" class="highlight-item"><text class="highlight-dot" aria-hidden="true"></text><text class="highlight-copy">{{item}}</text></view>
        </view>
        <view wx:if="{{work.materials.length}}" class="material-row"><text class="highlight-label">材料</text><view class="chip-row"><text wx:for="{{work.materials}}" wx:key="*this" class="meta-chip material-chip">{{item}}</text></view></view>
        <view wx:if="{{work.palette.length}}" class="material-row"><text class="highlight-label">配色</text><view class="palette-list"><view wx:for="{{work.palette}}" wx:key="hex" class="palette-item"><view class="palette-swatch" style="background: {{item.hex}};"></view><text class="palette-name">{{item.name}}</text></view></view></view>
      </view>
      <view class="preference-section"><text class="section-title">这个方向适合你吗？</text><view class="preference-row"><button class="preference-button {{work.preference === 'like' ? 'is-selected' : ''}}" data-sentiment="like" bindtap="preference" disabled="{{busy || readOnly || pendingAction}}">喜欢这个方向</button><button class="preference-button {{work.preference === 'dislike' ? 'is-selected' : ''}}" data-sentiment="dislike" bindtap="preference" disabled="{{busy || readOnly || pendingAction}}">不太适合</button></view><text class="action-helper">只记录本次咨询偏好，随时可以更正。</text></view>
      <view wx:if="{{feedback}}" class="notice" role="status">{{feedback}}</view>
      <text class="action-helper">作品供方向参考，同小区不代表同户型；实拍不表示当前可预约参观。</text>
      <button class="primary-action" bindtap="continueChat">回原咨询继续聊</button><button class="secondary-action" bindtap="contact" disabled="{{busy || readOnly || pendingAction}}">申请联系{{work.authorName}}</button>
      <button wx:if="{{sharePath}}" class="share-work" open-type="share">分享设计室</button><button wx:else class="share-work" bindtap="retry" disabled="{{loading}}">重新准备分享</button>
    </block>
    <button wx:if="{{unavailable || (!loading && !work)}}" class="secondary-action" bindtap="continueChat">{{conversationId ? '回到原咨询' : '返回首页'}}</button>
  </view>
</view>
