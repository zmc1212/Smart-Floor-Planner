<import src="./report-sections.wxml"/><!-- Approved follow-up-v1. -->
<import src="./report-question.wxml"/>
<import src="./boss-weekly.wxml"/>
<import src="./owner-daily.wxml"/>
<import src="./stage-reminder.wxml"/>
<import src="./report-board.wxml"/>
<import src="./chat-network.wxml"/>
<include src="./report-board.wxml"/>
<view wx:if="{{followupActive && !reportBoard}}" class="followup-thread followup-role-{{followupContext.audience}}"><view class="followup-scope"><text class="followup-scope-title">{{followupContext.title || (followupPlatform ? '企业工地简报' : '装修跟进')}}</text><view class="followup-scope-meta"><button wx:if="{{followupPlatform}}" class="followup-enterprise-choice chat-button {{(followupBusy || followupPending || followupEnterpriseBusy) ? 'is-disabled' : ''}}" bindtap="openFollowupEnterprise" disabled="{{followupBusy || followupPending || followupEnterpriseBusy}}">{{followupContext.enterprise.name || followupEnterpriseName || '选择企业'}}⌄ · 仅自己可见</button><text wx:elif="{{followupContext.audience === 'worker' || followupContext.audience === 'designer' || followupContext.audience === 'boss'}}">{{followupContext.enterprise.name ? followupContext.enterprise.name + ' · ' : ''}}仅自己可见</text><text wx:else>{{followupContext.audience === 'customer' ? followupContext.projects[0].stageName : '仅自己可见'}}{{followupContext.enterprise.name ? ' · ' + followupContext.enterprise.name : ''}}</text><button class="chat-button {{(followupLoading || !followupContext) ? 'is-disabled' : ''}}" bindtap="followupHistory" disabled="{{followupLoading || !followupContext}}">简报记录 ↗</button></view><text wx:if="{{followupContext.audience === 'boss'}}" class="followup-caption">本企业获权项目</text><text wx:elif="{{followupContext.audience !== 'customer' && followupContext}}" class="followup-caption">{{followupContext.projects.length}}{{followupContext.projectsTruncated ? '+' : ''}}个获权工地</text></view>
  <template wx:if="{{followupConnectionInterrupted && !followupPending}}" is="chat-network"
    data="{{action: 'refreshFollowup', disabled: followupBusy || followupLoading || followupListLoading, reconnecting: followupLoading || followupListLoading}}"/>
  <view wx:elif="{{followupError || followupPending}}" class="followup-feedback" role="alert">
    <text>{{followupPending ? '上次操作结果正在核对，请先确认结果。' : followupError}}</text>
    <button class="chat-button {{(followupBusy || followupLoading || followupListLoading) ? 'is-disabled' : ''}}"
      bindtap="{{followupPending ? 'recoverFollowup' : 'refreshFollowup'}}" disabled="{{followupBusy || followupLoading || followupListLoading}}">{{followupPending ? '核对上次操作' : '重新读取'}}</button>
  </view>
  <scroll-view scroll-y class="followup-scroll {{followupChat.reception ? 'followup-reception-scroll' : ''}}" scroll-into-view="{{followupScrollTarget}}" show-scrollbar="{{false}}"><template is="report-question-paper" data="{{q: reportQuestion}}"/><text wx:if="{{followupLoading && !followupConnectionInterrupted}}" class="followup-state">正在读取简报…</text><view wx:if="{{followupChat.reception}}" class="followup-paper followup-human handoff-state" id="followup-reception"><text class="fabric-label">小K</text><text class="handoff-heading">{{followupChat.conversation.mode === 'human' ? followupChat.conversation.ownerAvailable === false ? '接待人暂不可用' : (followupChat.conversation.humanName || '设计师') + '正在接待' : '正在等待设计师'}}</text><view class="followup-reception-body"><text class="handoff-description">{{followupChat.conversation.ownerAvailable === false ? '你可以结束接续，回到小K继续聊。' : '你可以继续补充资料；小K已暂停自动回复。'}}</text><button class="handoff-return chat-button {{(followupChat.busy || followupChat.handoffBusy || followupChat.pendingSend || followupChat.pendingAction || followupChat.mediaBusy || followupChat.mediaPending) ? 'is-disabled' : ''}}" bindtap="endFollowupHandoff" disabled="{{followupChat.busy || followupChat.handoffBusy || followupChat.pendingSend || followupChat.pendingAction || followupChat.mediaBusy || followupChat.mediaPending}}">{{followupChat.handoffBusy ? (followupChat.conversation.mode === 'human' ? '正在结束接续…' : '正在取消等待…') : followupChat.conversation.mode === 'human' ? '结束接续，回到小K' : '取消等待，回到小K'}}</button></view></view><view wx:elif="{{followupContext.conversation.mode !== 'ai' && followupContext && followupContext.audience !== 'customer'}}" class="followup-paper followup-human"><text class="fabric-label">小K</text><text class="followup-paper-title">小K已暂停自动回复</text><text class="followup-muted">已保存的简报仍可只读查看。</text></view><text wx:if="{{!followupLoading && !followupHasCards && !followupError}}" class="followup-state">{{followupPlatform && !followupContext ? '请选择企业后查看工地简报。' : '还没有已保存的简报，有新记录后可在这里回看。'}}</text><block wx:for="{{followupReports}}" wx:key="reportId" wx:for-item="report"><block wx:if="{{report.deliveryState !== 'muted' && !reportQuestion.selected}}"><text wx:if="{{!report.bossWeekly || followupChat.reception || !report.ready}}" class="followup-time">{{report.dateLabel}}</text><template wx:if="{{report.bossWeekly && report.ready && !followupChat.reception}}" is="boss-weekly-card" data="{{report, reportQuestion}}"/><template wx:elif="{{report.ownerDaily && report.ready && !followupChat.reception}}" is="owner-daily-card" data="{{report, reportQuestion}}"/><template wx:elif="{{report.stageReminder && !followupChat.reception}}" is="stage-reminder-card" data="{{report, audience: followupContext.audience, busy: followupBusy, pending: followupPending}}"/><view wx:else class="followup-paper followup-card" data-report="{{report.reportId}}"><view class="followup-card-marker" data-report="{{report.reportId}}"></view><text class="fabric-label">{{followupChat.reception ? '已保存的简报' : report.cardLabel || report.kindLabel || '已保存的简报'}}</text><text class="followup-paper-title">{{followupChat.reception ? report.takeoverTitle : report.cardTitle || report.title}}</text><text wx:if="{{report.weeklyReport}}" class="followup-caption">{{report.weeklyReport.summary}}</text><text wx:for="{{report.weeklyPreview}}" wx:key="*this" class="followup-line">• {{item}}</text><text class="followup-muted">{{report.available ? followupChat.reception ? '接待期间也可查看报告' : report.cardPeriodLabel || report.periodLabel : report.stateLabel}}</text><block wx:if="{{report.ready}}"><view wx:if="{{!followupChat.reception}}" wx:for="{{report.projects}}" wx:key="id" wx:for-item="project" class="followup-project"><text wx:if="{{followupContext.audience !== 'customer'}}" class="followup-project-name">{{project.name}}</text><text wx:if="{{project.stageName}}" class="followup-muted">{{project.stageName}}</text><text wx:for="{{project.highlights}}" wx:key="key" wx:for-item="line" class="followup-line">• {{line.text}}</text><text wx:if="{{!project.highlights.length}}" class="followup-muted">这段时间还没有新的现场记录，有新进展会及时更新。</text><button wx:if="{{followupContext.audience !== 'customer'}}" class="followup-text-action chat-button" data-report="{{report.reportId}}" data-revision="{{report.revision}}" data-project="{{project.id}}" bindtap="readFollowupReport">打开项目简报 ↗</button></view><text wx:if="{{report.truncated}}" class="followup-caption">这份简报只包含部分工地。</text><text wx:if="{{report.factsOnly && !followupChat.reception}}" class="followup-caption">这份简报直接按现场记录整理，还没有工艺建议。</text><view class="followup-actions"><button class="followup-card-action chat-button" data-report="{{report.reportId}}" data-revision="{{report.revision}}" bindtap="readFollowupReport">查看完整{{report.kindLabel}}</button><button class="followup-card-action followup-primary chat-button {{(followupChat.reception || reportQuestion.disabled || reportQuestion.busy || reportQuestion.pending) ? 'is-disabled' : ''}}" data-report="{{report.reportId}}" data-revision="{{report.revision}}" bindtap="askFollowupReport" disabled="{{followupChat.reception || reportQuestion.disabled || reportQuestion.busy || reportQuestion.pending}}">{{followupContext.audience === 'customer' ? '问这份报告' : '选工地追问'}}</button></view><text wx:if="{{followupChat.reception}}" class="followup-caption">结束人工接待后，可继续问小K。</text></block><view wx:else class="followup-state">{{report.stateLabel}}</view></view></block></block><block wx:for="{{followupChat.messages}}" wx:key="id"><view wx:if="{{item.authorKind === 'user' || item.authorKind === 'admin' || item.authorKind === 'assistant'}}" class="message followup-chat-message report-question-message {{item.isUser ? 'user-message' : 'assistant-message'}}" id="followup-message-{{item.id}}"><view class="message-main"><text wx:if="{{item.authorKind === 'assistant'}}" class="fabric-label">小K</text><view class="bubble"><text wx:if="{{item.id === followupChat.revealingReplyId}}" class="message-block" user-select>{{followupChat.liveAnswerText}}</text><image wx:elif="{{item.mediaId && followupChat.mediaPaths[item.mediaId]}}" class="message-photo" src="{{followupChat.mediaPaths[item.mediaId]}}" mode="widthFix" data-id="{{item.mediaId}}" bindtap="previewFollowupImage"/><block wx:else><text wx:for="{{item.blocks}}" wx:for-item="block" wx:key="key" class="message-block" user-select>{{block.text}}</text></block><view wx:if="{{item.citations.length && item.id !== followupChat.revealingReplyId}}" class="citations"><button wx:for="{{item.citations}}" wx:for-item="citation" wx:key="id" class="citation-chip {{citation.available ? '' : 'unavailable'}} chat-button" data-id="{{citation.id}}" bindtap="openFollowupCitation"><image class="chat-image" src="../assets/book-open.png"/><text class="chat-text">{{citation.title}}</text></button></view></view></view></view></block><view wx:if="{{followupChat.pendingText}}" class="message user-message pending-message followup-chat-message"><view class="bubble"><text>{{followupChat.pendingText}}</text><text class="pending-label">{{followupChat.busy ? '发送中…' : followupChat.pendingSend ? '发送结果待确认' : '发送失败，内容已保留'}}</text><button class="chat-button" wx:if="{{!followupChat.busy}}" bindtap="sendFollowup">{{followupChat.pendingSend ? '核对结果' : '重试'}}</button></view></view><view wx:if="{{followupChat.runLabel}}" class="run-state followup-run-state"><view class="avatar"><image class="chat-image" src="../assets/xiaok-chat-avatar.png" mode="aspectFit"/></view><view class="run-paper"><text class="run-label">{{followupChat.runLabel}}</text><view wx:if="{{followupChat.generating}}" class="processing-dots" aria-hidden="true"><view class="chat-group"></view><view class="chat-group"></view><view class="chat-group"></view></view><button wx:if="{{followupChat.generating}}" class="run-action chat-button {{(followupChat.busy || followupChat.pendingAction) ? 'is-disabled' : ''}}" bindtap="stopFollowup" disabled="{{followupChat.busy || followupChat.pendingAction}}"><text>停止回答</text></button><button wx:elif="{{followupChat.retryable && followupChat.canCompose && !followupChat.readOnly}}" class="run-action chat-button {{(followupChat.busy || followupChat.pendingAction) ? 'is-disabled' : ''}}" bindtap="retryFollowupRun" disabled="{{followupChat.busy || followupChat.pendingAction}}"><text>重新回答</text><image class="chat-image" src="../assets/chat-arrow-up-right.png" mode="aspectFit"/></button><button wx:elif="{{followupChat.uncertainRun}}" class="run-action chat-button {{(followupChat.busy) ? 'is-disabled' : ''}}" bindtap="refreshFollowupChat" disabled="{{followupChat.busy}}"><text>刷新状态</text></button></view></view><button wx:if="{{followupCursor}}" class="followup-more chat-button {{(followupLoading) ? 'is-disabled' : ''}}" bindtap="moreFollowupReports" disabled="{{followupLoading}}">查看更多简报</button><view id="followup-conversation-end"></view></scroll-view><view wx:if="{{followupChat.error || followupChat.mediaError || followupChat.pendingSend || followupChat.pendingAction}}" class="followup-feedback" role="alert"><text>{{followupChat.error || followupChat.mediaError}}</text><button class="chat-button {{(followupChat.busy) ? 'is-disabled' : ''}}" wx:if="{{followupChat.pendingSend || followupChat.pendingAction}}" bindtap="recoverFollowupChat" disabled="{{followupChat.busy}}">{{followupChat.pendingSend ? '确认发送结果' : '确认操作结果'}}</button><button class="chat-button {{(followupChat.mediaBusy) ? 'is-disabled' : ''}}" wx:elif="{{followupChat.mediaPending}}" bindtap="recoverFollowupImage" disabled="{{followupChat.mediaBusy}}">核对发送结果</button><button class="chat-button {{(followupChat.busy) ? 'is-disabled' : ''}}" wx:else bindtap="refreshFollowupChat" disabled="{{followupChat.busy}}">重新连接</button></view><template is="report-question-strip" data="{{q: reportQuestion}}"/>
  <view wx:if="{{!followupConnectionInterrupted && (followupChat.reception || followupChat.canDraft || followupChat.pendingSend || reportQuestion.selected || followupChat.draft)}}" class="followup-human-composer composer" style="margin-bottom: {{keyboardHeight ? 12 : professionalFollowup ? bottomInset + 12 : 12}}px;"><button class="media-button chat-button is-disabled" disabled aria-label="语音暂不可用，可以打字"><image class="chat-image" src="../assets/microphone.png"/></button><view class="composer-divider"></view><button class="media-button chat-button {{(!followupChat.reception || !followupChat.canCompose || followupChat.loading || followupChat.busy || followupChat.pendingSend || followupChat.pendingAction || followupChat.mediaBusy || followupChat.mediaPending) ? 'is-disabled' : ''}}" bindtap="pickFollowupImage" disabled="{{!followupChat.reception || !followupChat.canCompose || followupChat.loading || followupChat.busy || followupChat.pendingSend || followupChat.pendingAction || followupChat.mediaBusy || followupChat.mediaPending}}" aria-label="发送图片资料"><image class="chat-image" src="../assets/image.png"/></button><textarea class="composer-input" value="{{followupChat.draft}}" auto-height adjust-position="{{false}}" maxlength="4000" show-confirm-bar="{{false}}" placeholder="{{followupChat.reception ? '发给接待设计师…' : reportQuestion.selected ? '继续问这份报告…' : '聊聊你关心的进展…'}}" placeholder-class="input-placeholder" bindinput="inputFollowup" bindfocus="focusInput" bindblur="blurInput" bindkeyboardheightchange="keyboardChange" disabled="{{!followupChat.canDraft || followupChat.loading || followupChat.busy || followupChat.pendingSend || followupChat.pendingAction || followupChat.mediaBusy || followupChat.mediaPending || followupChat.generating || followupChat.uncertainRun || reportQuestion.busy || reportQuestion.pending}}" aria-label="当前跟进会话消息"/><button class="send-button chat-button {{((!followupChat.canCompose && (!followupChat.canDraft || reportQuestion.selected || reportQuestion.disabled)) || !followupChat.draft || followupChat.loading || followupChat.busy || followupChat.pendingSend || followupChat.pendingAction || followupChat.mediaBusy || followupChat.mediaPending || followupChat.generating || followupChat.uncertainRun || reportQuestion.busy || reportQuestion.pending) ? 'is-disabled' : ''}}" bindtap="sendFollowup" disabled="{{(!followupChat.canCompose && (!followupChat.canDraft || reportQuestion.selected || reportQuestion.disabled)) || !followupChat.draft || followupChat.loading || followupChat.busy || followupChat.pendingSend || followupChat.pendingAction || followupChat.mediaBusy || followupChat.mediaPending || followupChat.generating || followupChat.uncertainRun || reportQuestion.busy || reportQuestion.pending}}" aria-label="发送跟进消息"><image class="chat-image" src="../assets/arrow-up.png"/></button></view><view wx:else class="followup-composer" style="margin-bottom: {{professionalFollowup ? bottomInset + 12 : 12}}px;">
    <image class="chat-image" src="../assets/microphone.png"/>
    <view class="composer-divider"></view>
    <image class="chat-image" src="../assets/image.png"/>
    <text wx:if="{{followupConnectionInterrupted || (!followupContext && !followupPlatform)}}" class="chat-text">聊聊你关心的进展…</text>
    <text wx:elif="{{followupPlatform && !followupContext}}" class="chat-text">选择企业后查看工地简报。</text>
    <text wx:elif="{{followupContext.conversation.mode && followupContext.conversation.mode !== 'ai'}}" class="chat-text">小K已暂停回复，可先查看简报。</text>
    <text wx:else class="chat-text">简报还在整理，可以先看看现场记录。</text>
    <view class="followup-send"><image class="chat-image" src="../assets/arrow-up.png"/></view>
  </view>
</view>

<include src="./followup-enterprise.wxml"/>

<view wx:if="{{followupDetail}}" class="followup-layer" catchtouchmove="swallow"><view class="followup-mask" bindtap="closeFollowupReport"></view><block wx:if="{{followupDetail.ownerDaily && followupDetail.ready}}"><include src="./owner-report-detail.wxml"/></block><view wx:else class="followup-sheet followup-detail-sheet"><view class="followup-grip"></view><button class="followup-close chat-button" bindtap="closeFollowupReport" aria-label="关闭报告"><image class="chat-image" src="../assets/x.png"/></button><view class="followup-detail-heading"><text class="followup-detail-title">{{followupDetail.title}}</text><text class="followup-project-name">{{followupContext.title}}</text><text class="followup-muted">{{followupDetail.periodLabel}}</text><text class="followup-muted">{{followupDetail.generatedLabel ? followupDetail.generatedLabel + '保存' : ''}}{{followupDetail.revision > 1 ? ' · 版本' + followupDetail.revision : ''}}</text></view><scroll-view class="followup-detail-scroll" scroll-y show-scrollbar="{{false}}"><text wx:if="{{!followupDetail.available}}" class="followup-state">这份简报暂时看不了了，可能是权限有调整或内容已更新。</text><block wx:for="{{followupDetail.projects}}" wx:key="id" wx:for-item="project"><text wx:if="{{followupContext.audience !== 'customer'}}" class="followup-detail-project">{{project.name}} · {{project.stageName}}</text><view class="followup-section"><text class="fabric-label">{{followupDetail.kind === 'weekly' ? '本周记录' : '今日记录'}}</text><text wx:for="{{project.progress}}" wx:key="key" class="followup-line" user-select>{{item.text}}</text><text wx:if="{{!project.progress.length}}" class="followup-line">这一期还没有上传现场进展。</text><view class="followup-original-links"><button wx:for="{{project.originalIds}}" wx:key="*this" class="followup-text-action chat-button" data-project="{{project.id}}" data-record="{{item}}" bindtap="readFollowupOriginal">查看原记录 {{item}} ↗</button></view><text wx:if="{{project.recordsTruncated}}" class="followup-caption">本项目记录达到读取上限，未包含全部记录。</text></view><view class="followup-section"><text class="followup-tag">待核对</text><template is="report-pending" data="{{project, followupDetail, followupBusy, followupPending}}"/></view><view class="followup-section"><text class="fabric-label">工艺关注</text><button wx:if="{{project.knowledgeSources.length}}" class="followup-text-action chat-button" data-project="{{project.id}}" bindtap="openReportSource">查看工艺依据 ↗</button><template is="report-standards" data="{{project, followupDetail, followupBusy, followupPending}}"/></view><view class="followup-section"><text class="fabric-label">已确认安排</text><template is="report-arrangements" data="{{project, followupDetail, followupBusy, followupPending}}"/></view></block><view wx:if="{{followupDetail.weeklyReport}}" class="followup-section followup-role-weekly"><text class="fabric-label">{{followupDetail.weeklyReport.contract.recipientRole === 'boss' ? '本周企业角色周报' : '本周角色周报'}}</text><text class="followup-line" user-select>{{followupDetail.weeklyReport.summary}}</text><text wx:if="{{followupDetail.sourceSnapshotLabel}}" class="followup-caption">来源快照 {{followupDetail.sourceSnapshotLabel}} · 报告版本 {{followupDetail.weeklyReport.contract.reportVersion}}</text><text wx:if="{{followupDetail.factsOnly}}" class="followup-caption">这份周报直接按现场记录整理，还没有工艺建议。</text><block wx:for="{{followupDetail.weeklyReport.sections}}" wx:key="key" wx:for-item="section"><text class="followup-tag">{{reportBoard && followupContext.audience === 'customer' && section.key === 'confirmations' ? '原记录中的待沟通事项' : section.label}}</text><text wx:for="{{section.lines}}" wx:key="index" wx:for-item="line" class="followup-line" user-select>{{line.text}}</text><text wx:if="{{!section.lines.length}}" class="followup-muted">{{reportBoard && followupContext.audience === 'customer' && section.key === 'confirmations' ? '本期暂无待沟通记录。' : section.emptyText}}</text></block></view><text class="followup-caption followup-footnote">简报只反映已上传的现场记录，不代替现场验收。</text><view wx:if="{{followupError || followupPending}}" class="followup-feedback"><text>{{followupPending ? '上次操作结果正在核对。' : followupError}}</text><button class="chat-button {{(followupBusy) ? 'is-disabled' : ''}}" wx:if="{{followupPending}}" bindtap="recoverFollowup" disabled="{{followupBusy}}">核对上次操作</button></view></scroll-view><button class="followup-detail-ask followup-primary chat-button {{(followupChat.reception || reportQuestion.disabled || reportQuestion.busy || reportQuestion.pending || !followupDetail.available || !followupDetail.ready) ? 'is-disabled' : ''}}" bindtap="askFollowupReport" disabled="{{followupChat.reception || reportQuestion.disabled || reportQuestion.busy || reportQuestion.pending || !followupDetail.available || !followupDetail.ready}}">{{followupContext.audience === 'customer' ? '问这份报告' : '选工地追问'}}</button></view></view>

<include src="./followup-settings.wxml"/><include src="./followup-plan.wxml"/><view wx:if="{{followupHistoryOpen && !followupDetail}}" class="followup-layer" catchtouchmove="swallow"><view class="followup-mask" bindtap="closeFollowupHistory"></view><view class="followup-sheet followup-history-sheet"><view class="followup-grip"></view><button class="followup-close chat-button" bindtap="closeFollowupHistory" aria-label="关闭简报记录"><image class="chat-image" src="../assets/x.png"/></button><text class="followup-detail-title">简报记录</text><picker class="followup-history-project" range="{{followupHistoryProjects}}" range-key="name" value="{{followupHistoryProjectIndex}}" bindchange="filterFollowupProject" disabled="{{followupBusy || followupPending || followupHistoryProjectsLoading || !followupHistoryProjects.length}}"><view class="followup-history-project-value"><image class="chat-image" src="../assets/requirement-home.png"/><text class="chat-text">{{followupHistoryProjectLabel || '当前范围不可用'}}</text><view class="followup-chevron"></view></view></picker><view class="followup-history-toolbar"><picker class="chat-picker" mode="date" fields="month" value="{{followupHistoryFilters.month}}" bindchange="filterFollowupMonth" disabled="{{followupBusy || followupPending}}"><view class="followup-history-month"><text>{{followupHistoryMonthLabel}}</text><view class="followup-chevron"></view></view></picker><button class="chat-button {{(followupBusy || followupPending) ? 'is-disabled' : ''}}" bindtap="settingsFromFollowupHistory" disabled="{{followupBusy || followupPending}}">跟进设置 ↗</button></view><view class="followup-history-kinds"><button class="{{!followupHistoryFilters.kind ? 'selected' : ''}} chat-button {{(followupBusy || followupPending) ? 'is-disabled' : ''}}" data-kind="" bindtap="filterFollowupKind" disabled="{{followupBusy || followupPending}}"><view class="followup-history-kind">全部</view></button><button class="{{followupHistoryFilters.kind === 'daily' ? 'selected' : ''}} chat-button {{(followupBusy || followupPending) ? 'is-disabled' : ''}}" data-kind="daily" bindtap="filterFollowupKind" disabled="{{followupBusy || followupPending}}"><view class="followup-history-kind">日报</view></button><button class="{{followupHistoryFilters.kind === 'weekly' ? 'selected' : ''}} chat-button {{(followupBusy || followupPending) ? 'is-disabled' : ''}}" data-kind="weekly" bindtap="filterFollowupKind" disabled="{{followupBusy || followupPending}}"><view class="followup-history-kind">周报</view></button></view><scroll-view class="followup-detail-scroll" scroll-y show-scrollbar="{{false}}" scroll-top="{{followupHistoryScroll}}" bindscroll="scrollFollowupHistory"><text wx:if="{{followupHistoryLoading || followupLoading}}" class="followup-history-state">正在读取简报…</text><view wx:if="{{followupHistoryError || followupError || followupPending}}" class="followup-feedback"><text>{{followupPending ? '上次操作结果正在核对。' : followupHistoryError || followupError}}</text><button class="chat-button {{(followupBusy || followupHistoryLoading) ? 'is-disabled' : ''}}" bindtap="{{followupPending ? 'recoverFollowup' : 'refreshFollowupHistory'}}" disabled="{{followupBusy || followupHistoryLoading}}">{{followupPending ? '核对上次操作' : '重新读取'}}</button></view><text wx:if="{{!followupHistoryLoading && !followupHistoryError && !followupHistoryItems.length}}" class="followup-history-state">这个范围还没有已保存的简报，换个项目或月份试试。</text><button wx:for="{{followupHistoryItems}}" wx:key="reportId" class="followup-history-row chat-button {{(followupLoading || followupBusy || followupPending) ? 'is-disabled' : ''}}" data-report="{{item.reportId}}" data-revision="{{item.revision}}" bindtap="readFollowupReport" disabled="{{followupLoading || followupBusy || followupPending}}"><view class="chat-group"><view class="followup-history-heading"><text class="chat-text">{{item.title}}</text><text wx:if="{{item.available}}" class="followup-history-read chat-text">{{item.readAt ? '已读' : '● 未读'}}</text></view><text wx:if="{{item.stageLabel}}" class="followup-history-stage">{{item.stageLabel}}</text><text class="followup-history-summary">{{item.summaryLabel}}</text><text wx:if="{{item.revision > 1}}" class="followup-caption">版本{{item.revision}}</text></view><text class="followup-history-arrow chat-text">›</text></button><button wx:if="{{followupHistoryCursor}}" class="followup-more chat-button {{(followupHistoryLoading) ? 'is-disabled' : ''}}" bindtap="moreFollowupHistory" disabled="{{followupHistoryLoading}}">查看更多简报</button><text wx:if="{{followupHistoryProjectsLoading}}" class="followup-history-state">正在读取获权工地…</text></scroll-view></view></view>

<view wx:if="{{followupOriginal}}" class="followup-layer followup-original-layer" catchtouchmove="swallow"><view class="followup-mask" bindtap="closeFollowupOriginal"></view><view class="followup-sheet"><view class="followup-grip"></view><button class="followup-close chat-button" bindtap="closeFollowupOriginal" aria-label="关闭原记录"><image class="chat-image" src="../assets/x.png"/></button><text class="followup-detail-title">工地原记录</text><text class="followup-muted">{{followupOriginal.room}} · 记录{{followupOriginal.id}} · 版本{{followupOriginal.version}}</text><scroll-view scroll-y class="followup-detail-scroll"><text class="followup-paper-title">{{followupOriginal.data.title}}</text><text class="followup-line" user-select>{{followupOriginal.data.completed}}</text><text class="followup-line" user-select>{{followupOriginal.data.pending}}</text><text class="followup-line" user-select>{{followupOriginal.data.coordination}}</text><text class="followup-line" user-select>{{followupOriginal.data.note}}</text><view class="site-record-photos"><image wx:for="{{followupOriginal.media}}" wx:key="id" wx:if="{{followupOriginalPaths[followupOriginal.id + '_' + followupOriginal.version + '_' + item.id]}}" class="message-photo" src="{{followupOriginalPaths[followupOriginal.id + '_' + followupOriginal.version + '_' + item.id]}}" mode="aspectFill" data-media="{{item.id}}" bindtap="previewFollowupOriginal"/></view><text wx:if="{{followupOriginalError}}" class="followup-caption">{{followupOriginalError}}</text></scroll-view></view></view>
