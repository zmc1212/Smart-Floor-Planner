<!-- Approved follow-up-v1 02/03/06/07/08/11; original records are data, never screenshot pixels. -->
<import src="./report-question.wxml" />
<import src="./boss-weekly.wxml" />
<import src="./owner-daily.wxml" />
<view wx:if="{{followupActive}}" class="followup-thread followup-role-{{followupContext.audience}}">
  <view class="followup-scope">
    <text class="followup-scope-title">{{followupContext.title || (followupPlatform ? '企业工地简报' : '装修跟进')}}</text>
    <view class="followup-scope-meta"><button wx:if="{{followupPlatform}}" class="followup-enterprise-choice" bindtap="openFollowupEnterprise" disabled="{{followupBusy || followupPending || followupEnterpriseBusy}}">{{followupContext.enterprise.name || followupEnterpriseName || '选择企业'}}⌄ · 仅自己可见</button><text wx:elif="{{followupContext.audience === 'worker' || followupContext.audience === 'designer' || followupContext.audience === 'boss'}}">{{followupContext.enterprise.name ? followupContext.enterprise.name + ' · ' : ''}}仅自己可见</text><text wx:else>{{followupContext.audience === 'customer' ? followupContext.projects[0].stageName : '仅自己可见'}}{{followupContext.enterprise.name ? ' · ' + followupContext.enterprise.name : ''}}</text><button bindtap="followupHistory" disabled="{{followupLoading || !followupContext}}">简报记录 ↗</button></view>
    <text wx:if="{{followupContext.audience === 'boss'}}" class="followup-caption">本企业获权项目</text><text wx:elif="{{followupContext.audience !== 'customer' && followupContext}}" class="followup-caption">{{followupContext.projects.length}}{{followupContext.projectsTruncated ? '+' : ''}}个获权工地</text>
  </view>
  <view wx:if="{{followupError || followupPending}}" class="followup-feedback" role="alert"><text>{{followupPending ? '上次操作结果正在核对，请先确认结果。' : followupError}}</text><button bindtap="{{followupPending ? 'recoverFollowup' : 'refreshFollowup'}}" disabled="{{followupBusy}}">{{followupPending ? '核对上次操作' : '重新读取'}}</button></view>
  <scroll-view scroll-y class="followup-scroll {{followupChat.reception ? 'followup-reception-scroll' : ''}}" scroll-into-view="{{followupScrollTarget}}" show-scrollbar="{{false}}">
    <template is="report-question-paper" data="{{q: reportQuestion}}" />
    <text wx:if="{{followupLoading}}" class="followup-state">正在读取简报与当前权限…</text>
    <view wx:if="{{followupChat.reception}}" class="followup-paper followup-human handoff-state" id="followup-reception"><text class="fabric-label">小K</text><text class="handoff-heading">{{followupChat.conversation.mode === 'human' ? followupChat.conversation.ownerAvailable === false ? '接待人暂不可用' : (followupChat.conversation.humanName || '设计师') + '正在接待' : '正在等待设计师'}}</text><view class="followup-reception-body"><text class="handoff-description">{{followupChat.conversation.ownerAvailable === false ? '你可以结束接续，回到小K继续聊。' : '你可以继续补充资料；小K已暂停自动回复。'}}</text><button class="handoff-return" bindtap="endFollowupHandoff" disabled="{{followupChat.busy || followupChat.pendingSend || followupChat.pendingAction || followupChat.mediaBusy || followupChat.mediaPending}}">{{followupChat.conversation.mode === 'human' ? '结束接续，回到小K' : '取消等待，回到小K'}}</button></view></view>
    <view wx:elif="{{followupContext.conversation.mode !== 'ai' && followupContext && followupContext.audience !== 'customer'}}" class="followup-paper followup-human"><text class="fabric-label">小K</text><text class="followup-paper-title">小K已暂停自动回复</text><text class="followup-muted">已保存的简报仍可只读查看。</text></view>
    <text wx:if="{{!followupLoading && !followupHasCards && !followupError}}" class="followup-state">{{followupPlatform && !followupContext ? '请选择企业后查看工地简报。' : '还没有已保存的简报，有新记录后可在这里回看。'}}</text>
    <block wx:for="{{followupReports}}" wx:key="reportId" wx:for-item="report"><block wx:if="{{report.deliveryState !== 'muted' && !reportQuestion.selected}}">
      <text wx:if="{{!report.bossWeekly || followupChat.reception || !report.ready}}" class="followup-time">{{report.dateLabel}}</text>
      <template wx:if="{{report.bossWeekly && report.ready && !followupChat.reception}}" is="boss-weekly-card" data="{{report, reportQuestion}}" />
      <template wx:elif="{{report.ownerDaily && report.ready && !followupChat.reception}}" is="owner-daily-card" data="{{report, reportQuestion}}" />
      <view wx:else class="followup-paper followup-card" data-report="{{report.reportId}}"><view class="followup-card-marker" data-report="{{report.reportId}}"></view>
        <text class="fabric-label">{{followupChat.reception ? '已保存的简报' : report.cardLabel || report.kindLabel || '已保存的简报'}}</text>
        <text class="followup-paper-title">{{followupChat.reception ? report.takeoverTitle : report.cardTitle || report.title}}</text>
        <text class="followup-muted">{{report.available ? followupChat.reception ? '接待期间也可查看报告' : report.cardPeriodLabel || report.periodLabel : report.stateLabel}}</text>
        <block wx:if="{{report.ready}}">
          <view wx:if="{{!followupChat.reception}}" wx:for="{{report.projects}}" wx:key="id" wx:for-item="project" class="followup-project">
            <text wx:if="{{followupContext.audience !== 'customer'}}" class="followup-project-name">{{project.name}}</text>
            <text wx:if="{{project.stageName}}" class="followup-muted">{{project.stageName}}</text>
            <text wx:for="{{project.highlights}}" wx:key="key" wx:for-item="line" class="followup-line">• {{line.text}}</text>
            <text wx:if="{{!project.highlights.length}}" class="followup-muted">本期暂无可见记录，未记录不等于未施工。</text>
            <button wx:if="{{followupContext.audience !== 'customer'}}" class="followup-text-action" data-report="{{report.reportId}}" data-revision="{{report.revision}}" data-project="{{project.id}}" bindtap="readFollowupReport">打开项目简报 ↗</button>
          </view>
          <text wx:if="{{report.truncated}}" class="followup-caption">本份简报只包含部分工地。</text>
          <text wx:if="{{report.factsOnly && !followupChat.reception}}" class="followup-caption">本份仅含现场记录，暂无工艺说明。</text>
          <view class="followup-actions"><button class="followup-card-action" data-report="{{report.reportId}}" data-revision="{{report.revision}}" bindtap="readFollowupReport">查看完整{{report.kindLabel}}</button><button class="followup-card-action followup-primary" data-report="{{report.reportId}}" data-revision="{{report.revision}}" bindtap="askFollowupReport" disabled="{{followupChat.reception || reportQuestion.disabled || reportQuestion.busy || reportQuestion.pending}}">{{followupContext.audience === 'customer' ? '问这份报告' : '选工地追问'}}</button></view>
          <text wx:if="{{followupChat.reception}}" class="followup-caption">结束人工接待后，可继续问小K。</text>
        </block>
        <view wx:else class="followup-state">{{report.stateLabel}}</view>
      </view>
    </block></block>
    <block wx:for="{{followupChat.messages}}" wx:key="id"><view wx:if="{{item.authorKind === 'user' || item.authorKind === 'admin' || item.authorKind === 'assistant'}}" class="message followup-chat-message report-question-message {{item.isUser ? 'user-message' : 'assistant-message'}}" id="followup-message-{{item.id}}"><view class="message-main"><text wx:if="{{item.authorKind === 'assistant'}}" class="fabric-label">小K</text><view class="bubble"><image wx:if="{{item.mediaId && followupChat.mediaPaths[item.mediaId]}}" class="message-photo" src="{{followupChat.mediaPaths[item.mediaId]}}" mode="widthFix" data-id="{{item.mediaId}}" bindtap="previewFollowupImage"/><block wx:else><text wx:for="{{item.blocks}}" wx:for-item="block" wx:key="key" class="message-block" user-select>{{block.text}}</text></block><view wx:if="{{item.citations.length}}" class="citations"><button wx:for="{{item.citations}}" wx:for-item="citation" wx:key="id" class="citation-chip {{citation.available ? '' : 'unavailable'}}" data-id="{{citation.id}}" bindtap="openFollowupCitation"><image src="../assets/book-open.png"/><text>{{citation.title}}</text></button></view></view></view></view></block>
    <view wx:if="{{followupChat.pendingText}}" class="message user-message pending-message followup-chat-message"><view class="bubble"><text>{{followupChat.pendingText}}</text><text class="pending-label">{{followupChat.busy ? '发送中…' : followupChat.pendingSend ? '发送结果待确认' : '发送失败，内容已保留'}}</text><button wx:if="{{!followupChat.busy}}" bindtap="sendFollowup">{{followupChat.pendingSend ? '核对结果' : '重试'}}</button></view></view>
    <view wx:if="{{followupChat.runLabel}}" class="run-state followup-run-state">
      <view class="avatar"><image src="../assets/xiaok-chat-avatar.png" mode="aspectFit"/></view>
      <view class="run-paper"><text class="run-label">{{followupChat.runLabel}}</text><view wx:if="{{followupChat.generating}}" class="processing-dots" aria-hidden="true"><view></view><view></view><view></view></view>
        <button wx:if="{{followupChat.generating}}" class="run-action" bindtap="stopFollowup" disabled="{{followupChat.busy || followupChat.pendingAction}}"><text>停止回答</text></button>
        <button wx:elif="{{followupChat.retryable && followupChat.canCompose && !followupChat.readOnly}}" class="run-action" bindtap="retryFollowupRun" disabled="{{followupChat.busy || followupChat.pendingAction}}"><text>重新回答</text><image src="../assets/chat-arrow-up-right.png" mode="aspectFit"/></button>
        <button wx:elif="{{followupChat.uncertainRun}}" class="run-action" bindtap="refreshFollowupChat" disabled="{{followupChat.busy}}"><text>刷新状态</text></button>
      </view>
    </view>
    <button wx:if="{{followupCursor}}" class="followup-more" bindtap="moreFollowupReports" disabled="{{followupLoading}}">查看更多简报</button>
  </scroll-view>
  <view wx:if="{{followupChat.error || followupChat.mediaError || followupChat.pendingSend || followupChat.pendingAction}}" class="followup-feedback" role="alert"><text>{{followupChat.error || followupChat.mediaError}}</text><button wx:if="{{followupChat.pendingSend || followupChat.pendingAction}}" bindtap="recoverFollowupChat" disabled="{{followupChat.busy}}">{{followupChat.pendingSend ? '确认发送结果' : '确认操作结果'}}</button><button wx:elif="{{followupChat.mediaPending}}" bindtap="recoverFollowupImage" disabled="{{followupChat.mediaBusy}}">核对发送结果</button><button wx:else bindtap="refreshFollowupChat" disabled="{{followupChat.busy}}">重新连接</button></view>
  <template is="report-question-strip" data="{{q: reportQuestion}}" />
  <view wx:if="{{followupChat.reception || followupChat.pendingSend || reportQuestion.selected || followupChat.draft}}" class="followup-human-composer composer" style="margin-bottom: {{keyboardHeight ? 12 : professionalFollowup ? bottomInset + 12 : 12}}px;"><button class="media-button" disabled aria-label="语音暂不可用，可以打字"><image src="../assets/microphone.png"/></button><view class="composer-divider"></view><button class="media-button" bindtap="pickFollowupImage" disabled="{{!followupChat.reception || !followupChat.canCompose || followupChat.loading || followupChat.busy || followupChat.pendingSend || followupChat.pendingAction || followupChat.mediaBusy || followupChat.mediaPending}}" aria-label="发送图片资料"><image src="../assets/image.png"/></button><textarea class="composer-input" value="{{followupChat.draft}}" auto-height adjust-position="{{false}}" maxlength="4000" show-confirm-bar="{{false}}" placeholder="{{followupChat.reception ? '发给接待设计师…' : '继续问这份报告…'}}" placeholder-class="input-placeholder" bindinput="inputFollowup" bindfocus="focusInput" bindblur="blurInput" bindkeyboardheightchange="keyboardChange" disabled="{{!followupChat.canDraft || followupChat.loading || followupChat.busy || followupChat.pendingSend || followupChat.pendingAction || followupChat.mediaBusy || followupChat.mediaPending || followupChat.generating || followupChat.uncertainRun || reportQuestion.busy || reportQuestion.pending}}" aria-label="当前跟进会话消息"/><button class="send-button" bindtap="sendFollowup" disabled="{{!followupChat.canCompose || !followupChat.draft || followupChat.loading || followupChat.busy || followupChat.pendingSend || followupChat.pendingAction || followupChat.mediaBusy || followupChat.mediaPending || followupChat.generating || followupChat.uncertainRun || reportQuestion.busy || reportQuestion.pending}}" aria-label="发送跟进消息"><image src="../assets/arrow-up.png"/></button></view>
  <view wx:else class="followup-composer" style="margin-bottom: {{professionalFollowup ? bottomInset + 12 : 12}}px;"><image src="../assets/microphone.png"/><view class="composer-divider"></view><image src="../assets/image.png"/><text>{{followupPlatform && !followupContext ? '选择企业后查看工地简报。' : followupContext.conversation.mode !== 'ai' ? '小K已暂停回复，可先查看简报。' : '工艺内容尚未生成，可先查看记录。'}}</text><view class="followup-send"><image src="../assets/arrow-up.png"/></view></view>
</view>

<include src="./followup-enterprise.wxml" />

<view wx:if="{{followupDetail}}" class="followup-layer" catchtouchmove="swallow">
  <view class="followup-mask" bindtap="closeFollowupReport"></view>
  <block wx:if="{{followupDetail.ownerDaily && followupDetail.ready}}"><include src="./owner-report-detail.wxml" /></block>
  <view wx:else class="followup-sheet followup-detail-sheet">
    <view class="followup-grip"></view><button class="followup-close" bindtap="closeFollowupReport" aria-label="关闭报告"><image src="../assets/x.png"/></button>
    <view class="followup-detail-heading"><text class="followup-detail-title">{{followupDetail.title}}</text><text class="followup-project-name">{{followupContext.title}}</text><text class="followup-muted">{{followupDetail.periodLabel}}</text><text class="followup-muted">{{followupDetail.generatedLabel ? followupDetail.generatedLabel + '保存' : ''}}{{followupDetail.revision > 1 ? ' · 版本' + followupDetail.revision : ''}}</text></view>
    <scroll-view class="followup-detail-scroll" scroll-y show-scrollbar="{{false}}">
      <text wx:if="{{!followupDetail.available}}" class="followup-state">来源或权限已变化，这份简报当前不可查看。</text>
      <block wx:for="{{followupDetail.projects}}" wx:key="id" wx:for-item="project">
        <text wx:if="{{followupContext.audience !== 'customer'}}" class="followup-detail-project">{{project.name}} · {{project.stageName}}</text>
        <view class="followup-section"><text class="fabric-label">{{followupDetail.kind === 'weekly' ? '本周记录' : '今日记录'}}</text><text wx:for="{{project.progress}}" wx:key="key" class="followup-line" user-select>{{item.text}}</text><text wx:if="{{!project.progress.length}}" class="followup-line">本期暂无已记录进展，未记录不等于未施工。</text><view class="followup-original-links"><button wx:for="{{project.originalIds}}" wx:key="*this" class="followup-text-action" data-project="{{project.id}}" data-record="{{item}}" bindtap="readFollowupOriginal">查看原记录 {{item}} ↗</button></view><text wx:if="{{project.recordsTruncated}}" class="followup-caption">本项目记录达到读取上限，未包含全部记录。</text></view>
        <view class="followup-section"><text class="followup-tag">待核对</text><view wx:for="{{project.pending}}" wx:key="key"><text wx:if="{{item.carriedOver}}" class="followup-caption">期前原记录</text><text class="followup-line" user-select>{{item.text}}</text></view><text wx:if="{{!project.pending.length}}" class="followup-line">本期没有可见的待核对记录。</text><text wx:if="{{project.publishedRecordItemsTruncated || project.issuesTruncated}}" class="followup-caption">记录较多，本份简报未包含全部记录。</text></view>
        <view class="followup-section"><text class="fabric-label">工艺关注</text><text class="followup-line">本份仅含已保存的现场记录，暂无工艺说明。</text></view>
        <view class="followup-section"><text class="fabric-label">已确认安排</text><text wx:for="{{project.arrangements}}" wx:key="key" class="followup-line" user-select>{{item.text}}</text><text wx:if="{{!project.arrangements.length}}" class="followup-line">本份简报没有可引用的已确认后续安排。</text><text class="followup-caption">同意方案不等于落实、验收或付款。</text></view>
      </block>
      <text class="followup-caption followup-footnote">未记录不等于未施工，本日/周报不代替现场验收。</text>
      <view wx:if="{{followupError || followupPending}}" class="followup-feedback"><text>{{followupPending ? '已阅结果尚未确认。' : followupError}}</text><button wx:if="{{followupPending}}" bindtap="recoverFollowup" disabled="{{followupBusy}}">核对上次操作</button></view>
    </scroll-view>
    <button class="followup-detail-ask followup-primary" bindtap="askFollowupReport" disabled="{{followupChat.reception || reportQuestion.disabled || reportQuestion.busy || reportQuestion.pending || !followupDetail.available || !followupDetail.ready}}">{{followupContext.audience === 'customer' ? '问这份报告' : '选工地追问'}}</button>
  </view>
</view>

<include src="./followup-settings.wxml" />
<include src="./followup-plan.wxml" />
<view wx:if="{{followupHistoryOpen && !followupDetail}}" class="followup-layer" catchtouchmove="swallow">
  <view class="followup-mask" bindtap="closeFollowupHistory"></view>
  <view class="followup-sheet followup-history-sheet"><view class="followup-grip"></view><button class="followup-close" bindtap="closeFollowupHistory" aria-label="关闭简报记录"><image src="../assets/x.png"/></button><text class="followup-detail-title">简报记录</text>
    <picker class="followup-history-project" range="{{followupHistoryProjects}}" range-key="name" value="{{followupHistoryProjectIndex}}" bindchange="filterFollowupProject" disabled="{{followupBusy || followupPending || followupHistoryProjectsLoading || !followupHistoryProjects.length}}"><view class="followup-history-project-value"><image src="../assets/requirement-home.png"/><text>{{followupHistoryProjectLabel || '当前范围不可用'}}</text><view class="followup-chevron"></view></view></picker>
    <view class="followup-history-toolbar"><picker mode="date" fields="month" value="{{followupHistoryFilters.month}}" bindchange="filterFollowupMonth" disabled="{{followupBusy || followupPending}}"><view class="followup-history-month"><text>{{followupHistoryMonthLabel}}</text><view class="followup-chevron"></view></view></picker><button bindtap="settingsFromFollowupHistory" disabled="{{followupBusy || followupPending}}">跟进设置 ↗</button></view>
    <view class="followup-history-kinds"><button class="{{!followupHistoryFilters.kind ? 'selected' : ''}}" data-kind="" bindtap="filterFollowupKind" disabled="{{followupBusy || followupPending}}"><view class="followup-history-kind">全部</view></button><button class="{{followupHistoryFilters.kind === 'daily' ? 'selected' : ''}}" data-kind="daily" bindtap="filterFollowupKind" disabled="{{followupBusy || followupPending}}"><view class="followup-history-kind">日报</view></button><button class="{{followupHistoryFilters.kind === 'weekly' ? 'selected' : ''}}" data-kind="weekly" bindtap="filterFollowupKind" disabled="{{followupBusy || followupPending}}"><view class="followup-history-kind">周报</view></button></view>
    <scroll-view class="followup-detail-scroll" scroll-y show-scrollbar="{{false}}" scroll-top="{{followupHistoryScroll}}" bindscroll="scrollFollowupHistory">
      <text wx:if="{{followupHistoryLoading || followupLoading}}" class="followup-history-state">正在读取简报与当前权限…</text>
      <view wx:if="{{followupHistoryError || followupError || followupPending}}" class="followup-feedback"><text>{{followupPending ? '上次操作结果正在核对。' : followupHistoryError || followupError}}</text><button bindtap="{{followupPending ? 'recoverFollowup' : 'refreshFollowupHistory'}}" disabled="{{followupBusy || followupHistoryLoading}}">{{followupPending ? '核对上次操作' : '重新读取'}}</button></view>
      <text wx:if="{{!followupHistoryLoading && !followupHistoryError && !followupHistoryItems.length}}" class="followup-history-state">当前筛选暂无已保存的简报，可调整项目、月份或类型。</text>
      <button wx:for="{{followupHistoryItems}}" wx:key="reportId" class="followup-history-row" data-report="{{item.reportId}}" data-revision="{{item.revision}}" bindtap="readFollowupReport" disabled="{{followupLoading || followupBusy || followupPending}}"><view><view class="followup-history-heading"><text>{{item.title}}</text><text wx:if="{{item.available}}" class="followup-history-read">{{item.readAt ? '已读' : '● 未读'}}</text></view><text wx:if="{{item.stageLabel}}" class="followup-history-stage">{{item.stageLabel}}</text><text class="followup-history-summary">{{item.summaryLabel}}</text><text wx:if="{{item.revision > 1}}" class="followup-caption">版本{{item.revision}}</text></view><text class="followup-history-arrow">›</text></button>
      <button wx:if="{{followupHistoryCursor}}" class="followup-more" bindtap="moreFollowupHistory" disabled="{{followupHistoryLoading}}">查看更多简报</button><text wx:if="{{followupHistoryProjectsLoading}}" class="followup-history-state">正在读取获权工地…</text>
    </scroll-view>
  </view>
</view>

<view wx:if="{{followupOriginal}}" class="followup-layer followup-original-layer" catchtouchmove="swallow"><view class="followup-mask" bindtap="closeFollowupOriginal"></view><view class="followup-sheet"><view class="followup-grip"></view><button class="followup-close" bindtap="closeFollowupOriginal" aria-label="关闭原记录"><image src="../assets/x.png"/></button><text class="followup-detail-title">工地原记录</text><text class="followup-muted">{{followupOriginal.room}} · 记录{{followupOriginal.id}} · 版本{{followupOriginal.version}}</text><scroll-view scroll-y class="followup-detail-scroll"><text class="followup-paper-title">{{followupOriginal.data.title}}</text><text class="followup-line" user-select>{{followupOriginal.data.completed}}</text><text class="followup-line" user-select>{{followupOriginal.data.pending}}</text><text class="followup-line" user-select>{{followupOriginal.data.coordination}}</text><text class="followup-line" user-select>{{followupOriginal.data.note}}</text><view class="site-record-photos"><image wx:for="{{followupOriginal.media}}" wx:key="id" wx:if="{{followupOriginalPaths[followupOriginal.id + '_' + followupOriginal.version + '_' + item.id]}}" class="message-photo" src="{{followupOriginalPaths[followupOriginal.id + '_' + followupOriginal.version + '_' + item.id]}}" mode="aspectFill" data-media="{{item.id}}" bindtap="previewFollowupOriginal"/></view><text wx:if="{{followupOriginalError}}" class="followup-caption">{{followupOriginalError}}</text></scroll-view></view></view>
