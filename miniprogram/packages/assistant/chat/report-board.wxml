<template name="report-board-photo">
  <button wx:if="{{path}}" class="report-board-photo chat-button" data-original="{{photo.projectId + ':' + photo.recordId}}" bindtap="openReportBoardDetail"
    aria-label="{{photo.room ? '查看' + photo.room + '原记录' : '查看现场原记录'}}">
    <image class="chat-image" src="{{path}}" mode="aspectFill" />
    <text class="chat-text" wx:if="{{label && photo.room}}">{{photo.room}}</text>
  </button>
</template>

<template name="report-board-progress">
  <view class="report-board-paper">
    <view class="report-board-paper-head">
      <text class="fabric-label">{{view.kind === 'weekly' ? '本期进展' : '现场进展'}}</text>
      <button wx:if="{{view.originals.length}}" class="report-board-link chat-button" data-original="{{view.originals.length === 1 ? view.originals[0].key : ''}}" bindtap="openReportBoardDetail">查看原记录 ↗</button>
    </view>
    <block wx:for="{{view.projects}}" wx:key="key" wx:for-item="project">
      <text wx:if="{{project.title}}" class="report-board-item-title">{{project.title}}</text>
      <text wx:for="{{project.progress}}" wx:key="key" class="report-board-line" user-select>{{item.text}}</text>
      <text wx:if="{{!project.progress.length}}" class="report-board-meta">暂无已发布的进展记录。</text>
    </block>
    <view wx:if="{{view.photos.length}}" class="report-board-photos">
      <block wx:for="{{view.photos}}" wx:key="key">
        <template is="report-board-photo" data="{{photo: item, path: paths[item.key], label: true}}" />
      </block>
    </view>
    <text wx:if="{{photoError}}" class="report-board-meta">{{photoError}}</text>
  </view>
</template>

<template name="report-board-reading">
  <view class="report-board-paper report-reading-overview">
    <view class="report-board-stats report-reading-stats">
      <view class="chat-group" wx:for="{{reading.stats}}" wx:key="label">
        <text class="report-board-number">{{item.value}}</text><text>{{item.label}}</text>
      </view>
    </view>
    <text wx:for="{{reading.notices}}" wx:key="*this" class="report-board-tag pending report-reading-notice">{{item}}</text>
  </view>
  <view class="report-board-paper report-reading-sites">
    <text class="fabric-label">{{reading.section}}</text>
    <view wx:for="{{reading.projects}}" wx:key="id" wx:for-item="project" class="report-reading-site">
      <button class="report-board-link report-reading-expand chat-button" data-project="{{project.id}}" bindtap="toggleReportBoardSite"
        aria-label="{{(expanded === project.id ? '收起' : '展开') + project.name + '详情'}}" aria-expanded="{{expanded === project.id}}">
        <text class="report-board-item-title report-reading-site-title">{{project.name}}</text>
        <text class="report-board-tag report-reading-stage {{project.stage ? 'done' : 'pending'}}">{{project.stage || '阶段待确认'}}</text>
        <text class="report-reading-chevron {{expanded === project.id ? 'is-open' : ''}}" aria-hidden="true">›</text>
      </button>
      <text class="report-board-line report-reading-progress" user-select>{{project.progress}}</text>
      <text wx:if="{{project.attention}}" class="report-board-meta" user-select>{{project.attention}}</text>
      <text wx:if="{{project.arrangement}}" class="report-board-meta" user-select>{{project.arrangement}}</text>
      <template wx:if="{{expanded === project.id}}" is="report-reading-site-detail"
        data="{{site: details[project.id], paths, photoError}}" />
    </view>
  </view>
</template>

<template name="report-reading-site-detail">
  <view class="report-reading-detail">
    <text class="report-board-line" wx:for="{{site.progress}}" wx:key="key" user-select>{{item.text}}</text>
    <text class="report-board-line" wx:for="{{site.notes}}" wx:key="*this" user-select>{{item}}</text>
    <text wx:if="{{site.arrangements.length}}" class="report-board-meta report-board-note-label">已确认安排</text>
    <text class="report-board-line" wx:for="{{site.arrangements}}" wx:key="key" user-select>{{item.text}}</text>
    <view wx:if="{{site.photos.length}}" class="report-board-photos">
      <block wx:for="{{site.photos}}" wx:key="key">
        <template is="report-board-photo" data="{{photo: item, path: paths[item.key], label: true}}" />
      </block>
    </view>
    <text wx:if="{{site.photos.length && photoError}}" class="report-board-meta">{{photoError}}</text>
    <button class="report-board-link report-reading-original chat-button" wx:for="{{site.originals}}" wx:key="key" data-original="{{item.key}}"
      bindtap="openReportBoardDetail">{{item.room || '工地'}}原记录与照片 <text aria-hidden="true">↗</text></button>
    <button class="report-board-link report-reading-original chat-button" wx:for="{{site.actions}}" wx:key="key" data-key="{{item.key}}"
      bindtap="openReportBoardAction">{{item.title}} <text aria-hidden="true">↗</text></button>
    <text wx:if="{{!site.progress.length && !site.notes.length && !site.arrangements.length && !site.originals.length && !site.actions.length}}"
      class="report-board-meta">本期暂无可展开的记录或事项。</text>
  </view>
</template>

<template name="report-book-heading">
  <view class="chat-nav report-book-nav" style="padding-top: {{top}}px; padding-right: {{right}}px;">
    <view class="nav-lane" style="min-height: {{height}}px;">
      <button class="notebook-history chat-button" bindtap="back" aria-label="返回"><view class="history-paper"><view class="followup-back"/></view></button>
      <text class="notebook-brand">小K</text>
      <button wx:if="{{hasContext}}" size="mini" class="designer-entry wechat-subscription-entry chat-button" bindtap="manageWechatSubscription">
        <text class="chat-text">微信订阅</text><image class="chat-image" src="../assets/chat-arrow-up-right.png" mode="aspectFit"/>
      </button>
    </view>
  </view>
  <view class="report-book-toolbar">
    <view class="report-book-tabs" aria-label="报告周期">
      <button class="{{kind === 'daily' ? 'active' : ''}} chat-button" data-kind="daily" bindtap="switchReportBoard" aria-pressed="{{kind === 'daily'}}"><text class="report-book-tab">日报</text></button>
      <button class="{{kind === 'weekly' ? 'active' : ''}} chat-button" data-kind="weekly" bindtap="switchReportBoard" aria-pressed="{{kind === 'weekly'}}"><text class="report-book-tab">周报</text></button>
    </view>
    <button wx:if="{{hasContext}}" class="report-book-history chat-button" bindtap="reportBoardHistory">历史 <text aria-hidden="true">›</text></button>
  </view>
</template>

<view wx:if="{{reportBoard && followupActive}}" class="report-book"
  bindtouchstart="startReportBookTouch" bindtouchmove="moveReportBookTouch" bindtouchend="endReportBookTouch" bindtouchcancel="cancelReportBookTouch">
  <view class="report-book-page report-book-back {{reportBookPage === 1 ? '' : 'report-book-inactive'}}"
    aria-hidden="{{reportBookPage !== 1}}" style="padding-bottom: {{bottomInset}}px;">
    <image class="report-book-paper" src="../assets/welcome-notebook/paper-grain.png" mode="aspectFill" aria-hidden="true"/>
    <template is="report-book-heading" data="{{top: navigationTop, right: navigationRight, height: navigationHeight, kind: reportBoardKind, hasContext: followupContext}}"/>
    <scroll-view class="report-book-image-scroll" scroll-y="{{!reportBookMoving}}" enhanced show-scrollbar="{{false}}">
      <view wx:if="{{reportBookImage}}" class="report-book-image-wrap">
        <image class="report-book-image" src="{{reportBookImage}}" mode="widthFix" data-path="{{reportBookImage}}"
          aria-label="{{reportBoardKind === 'weekly' ? '工地周报手账长图' : '工地日报手账长图'}}" binderror="reportBookImageFailed"/>
        <button class="report-book-original chat-button" bindtap="previewReportBookImage">
          <view class="report-book-original-tab">原图 <text aria-hidden="true">↗</text></view>
        </button>
      </view>
      <view wx:else class="report-book-image-feedback">
        <text role="status">{{reportBookImageState === 'stale' ? '可查看的报告内容已变化。' : reportBookImageState === 'unavailable' ? '这期图版暂不可查看。' : reportBookImageState === 'error' ? '图版暂时读取失败。' : reportBookImageState === 'loading' || reportBoardLoading ? '正在读取图版…' : reportBoardKind === 'weekly' ? '暂无可查看的周报图版。' : '暂无可查看的日报图版。'}}</text>
        <button wx:if="{{reportBookImageState === 'error' || reportBookImageState === 'unavailable' || reportBookImageState === 'stale'}}" class="report-board-link chat-button" bindtap="retryReportBookImage">重新读取</button>
      </view>
    </scroll-view>
    <view class="report-book-folio {{reportBookPage !== 1 ? 'report-book-folio-pending' : ''}}">
      <button class="report-book-turn chat-button" data-page="0" bindtap="tapReportBook" aria-label="右滑或轻点，回到详情">
        <view class="report-book-turn-icon report-book-return-icon" aria-hidden="true"><view/></view>
        <view class="report-book-turn-copy"><text>回到详情</text><text>右滑或轻点</text></view>
      </button>
      <view class="report-book-location report-book-location-right"><text>图版</text><text><text class="report-book-page-number">02</text> / 02</text></view>
    </view>
  </view>
  <view class="report-book-page report-book-front {{reportBookPage === 1 && !reportBookMoving ? 'report-book-covered' : ''}}"
    aria-hidden="{{reportBookPage !== 0}}"
    style="padding-bottom: {{bottomInset}}px; {{reportBookClip ? 'clip-path:' + reportBookClip + ';-webkit-clip-path:' + reportBookClip + ';' : ''}}">
    <image class="report-book-paper" src="../assets/welcome-notebook/paper-grain.png" mode="aspectFill" aria-hidden="true"/>
    <template is="report-book-heading" data="{{top: navigationTop, right: navigationRight, height: navigationHeight, kind: reportBoardKind, hasContext: followupContext}}"/>
    <scroll-view class="report-board report-book-detail-scroll" scroll-y="{{!reportBookMoving}}" enhanced show-scrollbar="{{false}}" scroll-top="{{reportBoardScroll}}"
      bindscroll="scrollReportBoard" refresher-enabled="{{!reportBookMoving}}" refresher-triggered="{{reportBoardRefreshing}}" bindrefresherrefresh="refreshReportBoard">
      <view class="report-board-inner">
        <text class="report-board-title">{{reportBoardTitle || '工地日报与周报'}}</text>
        <view wx:if="{{reportBoardView.reading}}" class="report-book-meta">
          <text class="report-board-period">{{reportBoardView.period}}</text>
          <text wx:if="{{reportBoardView.subtitle}}" class="report-board-meta">{{reportBoardView.subtitle}}</text>
        </view>
        <view wx:else class="report-book-meta">
          <text wx:if="{{reportBoardView.subtitle || followupContext.enterprise.name}}" class="report-board-meta">{{reportBoardView.subtitle || followupContext.enterprise.name}}</text>
          <text wx:if="{{reportBoardView.period}}" class="report-board-period">{{reportBoardView.period}}</text>
        </view>
        <text wx:if="{{reportBoardView.scopeName}}" class="report-board-meta">{{reportBoardView.scopeName}}</text>
    <view wx:if="{{reportBoardError || followupError || followupPending}}" class="report-board-paper report-board-feedback" role="alert">
      <text>{{followupPending ? '上次操作结果正在核对。' : reportBoardError || followupError}}</text>
      <button class="report-board-link chat-button" bindtap="{{followupPending ? 'recoverFollowup' : 'refreshReportBoard'}}">{{followupPending ? '核对结果' : '重新读取'}}</button>
    </view>
    <view wx:elif="{{reportBoardLoading || followupLoading}}" class="report-board-paper report-board-feedback" role="status">正在读取简报…</view>
    <view wx:elif="{{!reportBoardView || reportBoardView.status}}" class="report-board-paper report-board-feedback" role="status">{{reportBoardView.status || (reportBoardKind === 'weekly' ? '暂无已保存的周报。' : '暂无已保存的日报。')}}</view>
    <block wx:if="{{followupContext && reportBoardView && !reportBoardView.status}}">
      <template wx:if="{{reportBoardView.reading}}" is="report-board-reading"
        data="{{reading: reportBoardView.reading, details: reportBoardView.siteDetails, expanded: reportBoardExpandedSite, paths: reportBoardPaths, photoError: reportBoardPhotoError}}" />
      <block wx:if="{{reportBoardRole === 'customer'}}">
        <view wx:for="{{reportBoardView.decisions}}" wx:key="id" class="report-board-paper">
          <text class="report-board-tag pending">待你确认</text>
          <text class="report-board-item-title">{{item.title}}</text>
          <text class="report-board-meta">{{item.room ? item.room + ' · ' : ''}}方案 V{{item.number}} · 当前状态</text>
          <button class="report-board-button primary chat-button" data-id="{{item.id}}" bindtap="openReportBoardDecision">查看并确认 <text aria-hidden="true">›</text></button>
        </view>
        <view wx:if="{{!reportBoardView.decisions.length}}" class="report-board-paper report-board-feedback">暂无需你确认的事项。</view>
        <template wx:if="{{!reportBoardView.reading}}" is="report-board-progress" data="{{view: reportBoardView, paths: reportBoardPaths, photoError: reportBoardPhotoError}}" />
        <view wx:if="{{!reportBoardView.reading}}" class="report-board-paper">
          <text class="fabric-label">接下来</text>
          <block wx:for="{{reportBoardView.projects}}" wx:key="key" wx:for-item="project">
            <text wx:for="{{project.arrangements}}" wx:key="key" class="report-board-line">{{item.text}}</text>
            <text wx:if="{{!project.arrangements.length}}" class="report-board-meta">暂无已确认安排。</text>
            <block wx:if="{{project.notes.length}}">
              <text class="report-board-meta report-board-note-label">现场待沟通记录</text>
              <text wx:for="{{project.notes}}" wx:key="*this" class="report-board-line">{{item}}</text>
            </block>
          </block>
          <button class="report-board-button compact chat-button" bindtap="askReportBoard">问小K</button>
        </view>
        <button wx:else class="report-board-button compact chat-button" bindtap="askReportBoard">问小K</button>
        <view wx:if="{{reportBoardView.decided.length}}" class="report-board-paper">
          <text class="fabric-label">方案处理记录</text>
          <button wx:for="{{reportBoardView.decided}}" wx:key="id" class="report-board-row chat-button" data-id="{{item.id}}" bindtap="openReportBoardDecision"><text class="chat-text">{{item.title}}</text><text class="report-board-tag done chat-text">{{item.label}}</text></button>
        </view>
      </block>
      <block wx:elif="{{reportBoardRole === 'designer'}}">
        <view class="report-board-paper">
          <view class="report-board-paper-head"><text class="fabric-label">待我核对</text><text class="report-board-meta">当前 {{reportBoardView.review.length || 0}} 项</text></view>
          <text wx:if="{{!reportBoardView.review.length}}" class="report-board-meta">暂无待你核对的事项。</text>
          <block wx:for="{{reportBoardView.review}}" wx:key="key">
            <view wx:if="{{index === 0}}" class="report-board-design-feature">
              <view class="report-board-design-copy">
                <text class="report-board-meta">{{item.projectName}}{{item.room ? ' · ' + item.room : ''}}</text>
                <text class="report-board-item-title">{{item.title}}</text>
                <text wx:if="{{item.planNumber || item.photoCount}}" class="report-board-meta">{{item.planNumber ? '方案 V' + item.planNumber : ''}}{{item.planNumber && item.photoCount ? ' · ' : ''}}{{item.photoCount ? '现场照片 ' + item.photoCount + ' 张' : ''}}</text>
                <button class="report-board-button primary chat-button" data-key="{{item.key}}" bindtap="openReportBoardAction">查看并答复 <text aria-hidden="true">›</text></button>
              </view>
              <template is="report-board-photo" data="{{photo: item.photo, path: reportBoardPaths[item.photo.key]}}" />
            </view>
            <button wx:else class="report-board-row chat-button" data-key="{{item.key}}" bindtap="openReportBoardAction">
              <view class="chat-group"><text class="report-board-meta">{{item.projectName}}{{item.room ? ' · ' + item.room : ''}}</text><text>{{item.title}}</text></view>
              <text class="report-board-tag pending chat-text">待核对</text><text class="chat-text" aria-hidden="true">›</text>
            </button>
          </block>
        </view>
        <view class="report-board-paper">
          <text class="fabric-label">已核对</text>
          <text wx:if="{{!reportBoardView.replied.length}}" class="report-board-meta">暂无已回复事项。</text>
          <button wx:for="{{reportBoardView.replied}}" wx:key="key" class="report-board-row chat-button" data-key="{{item.key}}" bindtap="openReportBoardAction">
            <text class="chat-text">{{item.projectName}} · {{item.title}}</text><text class="report-board-tag done chat-text">已回复</text><text class="chat-text" aria-hidden="true">›</text>
          </button>
        </view>
        <text wx:if="{{reportBoardPhotoError}}" class="report-board-meta">{{reportBoardPhotoError}}</text>
      </block>
      <block wx:elif="{{reportBoardRole === 'worker'}}">
        <view wx:for="{{reportBoardView.returned}}" wx:key="key" class="report-board-paper">
          <text class="report-board-tag late">需补充</text>
          <text class="report-board-item-title">{{item.title}}</text>
          <text wx:if="{{item.returnReason}}" class="report-board-line">{{item.returnReason}}</text>
          <button class="report-board-button primary chat-button" data-key="{{item.key}}" bindtap="openReportBoardAction">去补充 <text aria-hidden="true">›</text></button>
        </view>
        <view class="report-board-paper">
          <text class="fabric-label">{{reportBoardKind === 'weekly' ? '接下来要交接' : '下一步'}}</text>
          <text wx:if="{{!reportBoardView.next.length}}" class="report-board-meta">暂无待你处理的下一步任务。</text>
          <button wx:for="{{reportBoardView.next}}" wx:key="key" class="report-board-row chat-button" data-key="{{item.key}}" bindtap="openReportBoardAction">
            <text class="chat-text">{{item.title}}</text><text class="report-board-tag pending chat-text">{{item.label}}</text><text class="chat-text" aria-hidden="true">›</text>
          </button>
        </view>
        <view class="report-board-paper">
          <view class="report-board-paper-head"><text class="fabric-label">我的上报</text><text class="report-board-meta">当前审核状态</text></view>
          <text wx:if="{{!reportBoardView.receipts.length}}" class="report-board-meta">本期暂无上报回执。</text>
          <button wx:for="{{reportBoardView.receipts}}" wx:key="key" class="report-board-row chat-button" data-key="{{item.key}}" bindtap="openReportBoardAction">
            <text class="chat-text">{{item.title}}</text><text class="report-board-tag {{item.status === 'approved' || item.resubmittedRecordId ? 'done' : 'pending'}} chat-text">{{item.label}}</text><text class="chat-text" aria-hidden="true">›</text>
          </button>
        </view>
        <button wx:if="{{reportBoardView.captureProject}}" class="report-board-button chat-button" bindtap="captureReportBoard">现场上报 <text aria-hidden="true">›</text></button>
      </block>
      <block wx:elif="{{reportBoardRole === 'boss'}}">
        <view wx:if="{{!reportBoardView.reading && reportBoardView.stats.length}}" class="report-board-paper report-board-stats">
          <view class="chat-group" wx:for="{{reportBoardView.stats}}" wx:key="label"><text class="report-board-number {{index === 1 && item.value !== '0' ? 'late' : ''}}">{{item.value}}</text><text>{{item.label}}</text></view>
        </view>
        <view class="report-board-paper">
          <view class="report-board-paper-head"><text class="fabric-label">优先处理</text><text class="report-board-meta">当前异常</text></view>
          <text wx:if="{{!reportBoardView.actions.length}}" class="report-board-meta">暂无需优先处理的事项。</text>
          <text wx:if="{{reportBoardView.reading}}" class="report-board-meta">当期已关闭 {{reportBoardView.closed}} 项</text>
          <view wx:for="{{reportBoardView.actions}}" wx:key="key" class="report-board-exception">
            <view class="report-board-paper-head"><text class="report-board-item-title">{{item.name}}</text><text class="report-board-tag {{item.late ? 'late' : 'pending'}}">{{item.tag}}</text></view>
            <text class="report-board-line">{{item.title}}</text>
            <text wx:if="{{item.waitingFor}}" class="report-board-meta">{{item.late ? '负责人 · ' : '等待 · '}}{{item.waitingFor}}</text>
            <button class="report-board-link chat-button" data-key="{{item.key}}" bindtap="openReportBoardAction">{{item.late ? '查看节点' : '查看事项'}} ›</button>
          </view>
          <text wx:if="{{reportBoardView.unverified}}" class="report-board-meta">部分工地计划待核实。</text>
        </view>
        <view wx:if="{{!reportBoardView.reading}}" class="report-board-paper">
          <text class="fabric-label">已确认安排</text>
          <text wx:for="{{reportBoardView.plans}}" wx:key="key" class="report-board-line">{{item.projectName}} · {{item.text}}</text>
          <text wx:if="{{!reportBoardView.plans.length}}" class="report-board-meta">暂无已确认安排。</text>
        </view>
        <button class="report-board-row report-book-all-sites chat-button" bindtap="reportBoardProjects">查看全部工地 <text aria-hidden="true">›</text></button>
      </block>
      <text wx:if="{{!reportBoardView.reading && reportBoardView.truncated}}" class="report-board-meta report-board-note-label">本份简报未包含全部工地。</text>
      <button class="report-board-link report-board-more chat-button {{(followupBusy || followupPending) ? 'is-disabled' : ''}}" bindtap="openReportBoardDetail" disabled="{{followupBusy || followupPending}}">{{reportBoardKind === 'weekly' ? '查看完整周报' : '查看完整日报'}} ↗</button>
    </block>
      </view>
    </scroll-view>
    <view wx:if="{{reportBoardView.detail.ready}}" class="report-book-folio">
      <view class="report-book-location"><text>详情</text><text><text class="report-book-page-number">01</text> / 02</text></view>
      <button class="report-book-turn report-book-next chat-button" data-page="1" bindtap="tapReportBook"
        aria-label="{{reportBoardKind === 'weekly' ? '左滑或轻点，查看周报图版' : '左滑或轻点，查看日报图版'}}">
        <view class="report-book-turn-copy"><text>{{reportBoardKind === 'weekly' ? '周报图版' : '日报图版'}}</text><text>左滑或轻点</text></view>
        <view class="report-book-turn-icon" aria-hidden="true"><view/></view>
      </button>
    </view>
  </view>
  <canvas type="2d" id="report-book-curl" class="report-book-curl {{reportBookMoving ? 'report-book-curl-active' : ''}}" aria-hidden="true"/>
</view>
