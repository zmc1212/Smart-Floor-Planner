<template name="report-pending"><view wx:for="{{project.pending}}" wx:key="key"><text wx:if="{{item.carriedOver}}" class="followup-caption">期前原记录</text><text class="followup-line" user-select>{{item.text}}</text></view><text wx:if="{{!project.pending.length}}" class="followup-line">{{reportBoard ? '这期暂无待沟通记录。' : '这期没有需要你确认的事。'}}</text><text wx:if="{{project.publishedRecordItemsTruncated || project.issuesTruncated}}" class="followup-caption">记录较多，本份简报未包含全部记录。</text></template>
<template name="report-standards"><text wx:for="{{project.standards}}" wx:key="key" class="followup-line" user-select>{{item.text}}</text><text wx:if="{{!project.standards.length}}" class="followup-line">{{followupDetail.generationLabel || '这份简报只整理了现场记录，工艺建议还在准备中。'}}</text><button wx:if="{{followupDetail.generationRetryable}}" class="followup-text-action chat-button {{(followupBusy || followupPending) ? 'is-disabled' : ''}}" bindtap="retryFollowupReport" disabled="{{followupBusy || followupPending}}">重试正文生成</button></template>
<template name="report-arrangements"><text wx:for="{{project.arrangements}}" wx:key="key" class="followup-line" user-select>{{item.text}}</text><text wx:if="{{!project.arrangements.length}}" class="followup-line">暂时没有已确认的后续安排。</text><text class="followup-caption">方案确认后还要按现场进度落实，验收和付款另行确认。</text></template>
