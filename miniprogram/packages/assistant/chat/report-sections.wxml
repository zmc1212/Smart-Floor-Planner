<template name="report-pending"><view wx:for="{{project.pending}}" wx:key="key"><text wx:if="{{item.carriedOver}}" class="followup-caption">期前原记录</text><text class="followup-line" user-select>{{item.text}}</text></view><text wx:if="{{!project.pending.length}}" class="followup-line">本期没有可见的待核对记录。</text><text wx:if="{{project.publishedRecordItemsTruncated || project.issuesTruncated}}" class="followup-caption">记录较多，本份简报未包含全部记录。</text></template>
<template name="report-standards"><text wx:for="{{project.standards}}" wx:key="key" class="followup-line" user-select>{{item.text}}</text><text wx:if="{{!project.standards.length}}" class="followup-line">{{followupDetail.generationLabel || '本份仅含已保存的现场记录，暂无工艺说明。'}}</text><button wx:if="{{followupDetail.generationRetryable}}" class="followup-text-action" bindtap="retryFollowupReport" disabled="{{followupBusy || followupPending}}">重试正文生成</button></template>
<template name="report-arrangements"><text wx:for="{{project.arrangements}}" wx:key="key" class="followup-line" user-select>{{item.text}}</text><text wx:if="{{!project.arrangements.length}}" class="followup-line">本份简报没有可引用的已确认后续安排。</text><text class="followup-caption">同意方案不等于落实、验收或付款。</text></template>
