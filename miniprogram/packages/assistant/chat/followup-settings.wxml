<!-- Approved 09 paper sheet and its shared feedback states. -->
<view wx:if="{{followupManageOpen}}" class="followup-layer" catchtouchmove="swallow">
  <view class="followup-mask" bindtap="closeFollowupManage"></view>
  <view class="followup-sheet followup-settings-sheet followup-personal-settings {{followupSetting ? '' : 'is-compact'}} {{embedded ? 'is-embedded' : ''}}">
    <image class="followup-settings-paper" src="../assets/welcome-notebook/paper-grain.png" mode="aspectFill" aria-hidden="true"/>
    <view class="followup-grip"></view>
    <button class="followup-close chat-button" bindtap="closeFollowupManage" aria-label="关闭跟进设置"><image class="chat-image" src="../assets/x.png" mode="aspectFit"/></button>
    <text class="followup-detail-title">跟进设置</text>
    <picker wx:if="{{followupManagement.length}}" class="followup-settings-project" range="{{followupManagement}}" range-key="title" bindchange="selectFollowupSetting" disabled="{{followupBusy || followupPending || followupManageLoading}}">
      <view class="followup-settings-picker">
        <image class="chat-image" src="../assets/requirement-home.png" mode="aspectFit" aria-hidden="true"/>
        <text class="followup-settings-project-name">{{followupSetting.title || '选择要管理的跟进'}}</text>
        <view class="followup-chevron" aria-hidden="true"></view>
      </view>
    </picker>
    <text wx:if="{{followupSetting}}" class="followup-caption followup-settings-scope">仅调整你自己的站内提醒</text>
    <scroll-view wx:if="{{followupSetting}}" class="followup-detail-scroll followup-settings-scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="followup-settings-group followup-settings-reception">
        <text class="fabric-label">接收内容</text>
        <label class="followup-preference-row">
          <image class="followup-settings-icon" src="../assets/followup-settings/bell.png" mode="aspectFit" aria-hidden="true"/>
          <text class="chat-text">阶段提醒</text>
          <switch class="chat-switch" checked="{{followupPreferenceDraft.stage}}" color="#00543f" data-preference="stage" bindchange="editFollowupPreference" disabled="{{followupBusy || followupPending}}" aria-label="接收阶段提醒"/>
        </label>
        <label class="followup-preference-row">
          <image class="followup-settings-icon" src="../assets/followup-settings/report.png" mode="aspectFit" aria-hidden="true"/>
          <text class="chat-text">施工日报</text>
          <switch class="chat-switch" checked="{{followupPreferenceDraft.daily}}" color="#00543f" data-preference="daily" bindchange="editFollowupPreference" disabled="{{followupBusy || followupPending}}" aria-label="接收施工日报"/>
        </label>
        <label class="followup-preference-row">
          <image class="followup-settings-icon" src="../assets/followup-settings/calendar.png" mode="aspectFit" aria-hidden="true"/>
          <text class="chat-text">施工周报</text>
          <switch class="chat-switch" checked="{{followupPreferenceDraft.weekly}}" color="#00543f" data-preference="weekly" bindchange="editFollowupPreference" disabled="{{followupBusy || followupPending}}" aria-label="接收施工周报"/>
        </label>
      </view>
      <view class="followup-settings-group">
        <text class="fabric-label">会话管理</text>
        <button class="followup-setting-row chat-button {{(followupBusy || followupPending || followupSetting.retentionRedacted || followupSetting.status === 'deleted') ? 'is-disabled' : ''}}" data-action="archive" bindtap="changeFollowup" disabled="{{followupBusy || followupPending || followupSetting.retentionRedacted || followupSetting.status === 'deleted'}}">
          <image class="followup-settings-icon" src="../assets/followup-settings/hide.png" mode="aspectFit" aria-hidden="true"/>
          <view class="followup-settings-row-copy"><text>收起会话</text><text class="followup-caption">从列表收起，有新报告时重新显示</text></view>
          <view class="followup-chevron" aria-hidden="true"></view>
        </button>
        <button class="followup-setting-row chat-button {{(followupBusy || followupPending) ? 'is-disabled' : ''}}" data-action="{{followupSetting.status !== 'enabled' || followupSetting.retentionRedacted ? 'resume' : 'stop'}}" bindtap="changeFollowup" disabled="{{followupBusy || followupPending}}">
          <image class="followup-settings-icon" src="../assets/followup-settings/pause.png" mode="aspectFit" aria-hidden="true"/>
          <view class="followup-settings-row-copy"><text>{{followupSetting.status !== 'enabled' || followupSetting.retentionRedacted ? '重新开启跟进' : '停止自动跟进'}}</text><text class="followup-caption">{{followupSetting.status === 'deleted' || followupSetting.retentionRedacted ? '重开会建立新的会话，旧消息不恢复' : '停止后不再接收，可在这里重新开启'}}</text></view>
          <view class="followup-chevron" aria-hidden="true"></view>
        </button>
        <button class="followup-setting-row followup-setting-delete chat-button {{(followupBusy || followupPending || followupSetting.status === 'deleted') ? 'is-disabled' : ''}}" data-action="delete" bindtap="changeFollowup" disabled="{{followupBusy || followupPending || followupSetting.status === 'deleted'}}">
          <image class="followup-settings-icon" src="../assets/followup-settings/delete.png" mode="aspectFit" aria-hidden="true"/>
          <view class="followup-settings-row-copy"><text>删除会话</text><text class="followup-caption">删除同时停止跟进，不会次日自动重建</text></view>
          <view class="followup-chevron" aria-hidden="true"></view>
        </button>
      </view>
      <text class="followup-caption followup-settings-note">这些操作不删除工地原记录。</text>
      <button wx:if="{{followupContext && followupContext.bindingId === followupSetting.bindingId && followupSetting.status === 'enabled'}}" class="followup-setting-row followup-settings-wechat chat-button" bindtap="manageWechatSubscription">
        <image class="followup-settings-icon" src="../assets/followup-settings/report.png" mode="aspectFit" aria-hidden="true"/>
        <text class="followup-settings-row-copy">微信订阅</text>
        <view class="followup-chevron" aria-hidden="true"></view>
      </button>
    </scroll-view>
    <text wx:if="{{followupManageLoading}}" class="followup-caption followup-settings-status" role="status">正在读取当前设置…</text>
    <text wx:elif="{{!followupManagement.length && !followupError && !followupPending && !followupSettingsConflict}}" class="followup-caption followup-settings-status followup-settings-empty" role="status">当前没有可管理的跟进。</text>
    <button wx:if="{{followupManagementCursor}}" class="followup-text-action chat-button {{(followupManageLoading || followupBusy || followupPending) ? 'is-disabled' : ''}}" bindtap="moreFollowupSettings" disabled="{{followupManageLoading || followupBusy || followupPending}}">更多跟进 ↗</button>
    <view wx:if="{{followupError || followupPending || followupSettingsConflict}}" class="followup-settings-feedback" role="alert">
      <text>{{followupPending ? '上次操作结果正在核对。' : followupSettingsConflict ? '设置已变化，你的选择已保留。请重新读取并核对后保存。' : followupError}}</text>
      <button class="followup-text-action chat-button {{(followupBusy || followupManageLoading) ? 'is-disabled' : ''}}" bindtap="{{followupPending ? 'recoverFollowup' : 'refreshFollowupSettings'}}" disabled="{{followupBusy || followupManageLoading}}">{{followupPending ? '核对上次操作' : '重新读取'}}</button>
    </view>
    <text wx:if="{{followupSettingsNotice}}" class="followup-caption followup-settings-status" role="status">{{followupSettingsNotice}}</text>
    <button wx:if="{{followupSetting}}" class="followup-settings-save chat-button {{(!followupPreferenceDirty || followupSettingsConflict || followupBusy || followupPending) ? 'is-disabled' : ''}}" bindtap="saveFollowupPreferences" disabled="{{!followupPreferenceDirty || followupSettingsConflict || followupBusy || followupPending}}">
      <text class="followup-settings-save-face">{{followupBusy ? '正在保存…' : '保存提醒偏好'}}</text>
    </button>
  </view>
</view>
