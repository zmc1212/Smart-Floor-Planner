 ? 'is-disabled' : ''}}" bindtap="openHandoff" disabled="{{busy || pendingSend || pendingAction}}">找设计师聊聊</button></view></block></view><view wx:if="{{item.citations.length && (!item.answerProcess || staffTab || professionalFollowup || ownerSiteReport)}}" class="citations"><button wx:for="{{item.citations}}" wx:for-item="citation" wx:key="id" class="citation-chip {{citation.available ? '' : 'unavailable'}} chat-button" data-id="{{citation.id}}" bindtap="openCitation"><image class="chat-image" src="../assets/book-open.png"/><text class="chat-text">{{citation.title}}</text></button></view><button wx:if="{{item.suggestDesigner && conversation.mode === 'ai'}}" class="notice-action chat-button {{(busy || pendingSend || pendingAction) ? 'is-disabled' : ''}}" bindtap="openHandoff" disabled="{{busy || pendingSend || pendingAction}}">请设计师接着聊</button><button wx:for="{{item.constructionContacts}}" wx:for-item="contact" wx:key="projectId" class="construction-contact chat-button {{(contactLoading || loading || fatal) ? 'is-disabled' : ''}}" data-project="{{contact.projectId}}" data-message="{{item.id}}" bindtap="contactKeeper" disabled="{{contactLoading || loading || fatal}}">联系管家{{item.constructionContacts.length > 1 ? ' · ' + contact.projectName : ''}}</button><text wx:if="{{item.constructionReminder && !item.constructionContacts.length}}" class="pending-label">本阶段联系电话尚未配置。</text><view wx:for="{{item.siteRecordList}}" wx:for-item="record" wx:key="id" class="site-record-photos"><block wx:for="{{record.assets}}" wx:for-item="asset" wx:key="*this"><image wx:if="{{siteRecordPaths[record.id + '_' + record.version + '_' + asset]}}" class="message-photo" src="{{siteRecordPaths[record.id + '_' + record.version + '_' + asset]}}" mode="aspectFill" data-record="{{record.id}}" data-version="{{record.version}}" data-media="{{asset}}" bindtap="previewSiteRecord"/></block></view><text wx:if="{{item.siteRecordList.length && siteRecordError}}" class="pending-label">{{siteRecordError}}</text><button wx:if="{{item.siteWatch}}" class="notice-action chat-button {{(busy || pendingSend || pendingAction) ? 'is-disabled' : ''}}" data-message="{{item.id}}" bindtap="cancelSiteWatch" disabled="{{busy || pendingSend || pendingAction}}">取消关注</button><template wx:if="{{item.publicConsent}}" is="owner-public-card" data="{{card: publicCards[item.publicConsent.id + '_' + item.publicConsent.versionId], expanded: publicExpanded, paths: publicPaths, busy: publicBusy, pending: publicPending, disabled: readOnly || fatal}}"/><template wx:if="{{liveCards[item.id]}}" is="owner-live-card" data="{{card: liveCards[item.id], coverPath: liveCoverPaths[liveCards[item.id].cover.id], busy: liveBusy, pending: livePending, error: liveError}}"/><template wx:if="{{item.planDecision}}" is="plan-decision-card" data="{{card: planCards[item.planDecision.id], expanded: planExpanded, paths: planPaths, busy: planBusy, pending: planPending, disabled: readOnly || fatal}}"/><button wx:if="{{item.publicContext}}" class="citation-chip chat-button" data-id="{{item.publicContext.id}}" data-version="{{item.publicContext.versionId}}" bindtap="openPublicSite">正在围观：{{item.publicContext.name}} · 查看公开节选</button><button wx:for="{{item.publicReferences}}" wx:for-item="reference" wx:key="id" class="citation-chip public-reference-chip chat-button" data-id="{{reference.id}}" data-version="{{reference.versionId}}" bindtap="openPublicSite">公开工地 · {{reference.name}}</button><template wx:if="{{item.designerRecommendation && item.id == latestDesignerMessageId}}" is="portfolio-designer-cards" data="{{recommendation:item.designerRecommendation, portraits:designerCardPortraits, images:designerCardImages, blocked:busy || pendingSend || pendingAction}}" />
  <template wx:if="{{item.replyActions && !staffTab && !professionalFollowup && !ownerSiteReport}}" is="reply-actions"
