      <text class="fabric-label fp-sheet-label">{{sheet === 'floorplan' ? '户型档案' : '预约量房'}}</text>
      <button class="sheet-close-tab paper-close chat-button" bindtap="closeSheet" aria-label="关闭"><view class="paper-close-face"><image class="chat-image" src="../assets/x.png" mode="aspectFit"/></view></button>
    </block>
    <view wx:else class="sheet-head">
      <text>{{sheet === 'history' ? '我的对话' : sheet === 'answerFeedback' ? '反馈这条回答' : sheet === 'answerMore' ? '回答操作' : sheet === 'messageShare' ? '分享这条消息' : sheet === 'publicSite' ? '公开工地' : sheet === 'ownerReminder' ? '小K提醒' : sheet === 'reportDecision' ? '方案确认' : '回答依据'}}</text>
      <button class="icon-button chat-button" bindtap="closeSheet" aria-label="关闭"><image class="chat-image" src="../assets/x.png" mode="aspectFit"/></button>
    </view>
    <scroll-view class="sheet-scroll" scroll-y enhanced="{{sheet === 'floorplan' || sheet === 'measure' || sheet === 'citation'}}" show-scrollbar="{{false}}" scroll-into-view="{{sheet === 'measure' && keyboardHeight ? 'measure-address' : ''}}">
<block wx:if="{{sheet === 'history'}}"><text class="sheet-helper">{{followupContext.enterprise.name || enterpriseName}} · 仅自己可见</text><button wx:if="{{!professionalFollowup}}" class="notice-action followup-new chat-button {{(busy || pendingSend || pendingAction) ? 'is-disabled' : ''}}" bindtap="newConversation" disabled="{{busy || pendingSend || pendingAction}}"><view class="conversation-list-plus"></view><text>开启新对话</text></button>
  <template wx:if="{{!staffTab && !professionalFollowup && !ownerSiteReport}}" is="answer-history-field" data="{{historyQuery}}"/>
  <block wx:if="{{historyTerm}}"><template is="answer-history-results" data="{{historyMatches, historySearching, historySearchError, historySearchCursor, busy, pendingSend, pendingAction}}"/></block>
  <block wx:else><view class="followup-list-label"><text class="fabric-label">装修跟进</text><button class="followup-text-action chat-button {{(followupListLoading) ? 'is-disabled' : ''}}" bindtap="manageFollowup" disabled="{{followupListLoading}}">管理跟进 ↗</button></view><button wx:if="{{followupPlanManager}}" class="followup-text-action followup-plan-entry chat-button {{(followupBusy || followupPending) ? 'is-disabled' : ''}}" bindtap="openReportPlan" disabled="{{followupBusy || followupPending}}">企业报告计划 ↗</button><text wx:if="{{followupListLoading && !followupBindings.length}}" class="sheet-state">正在读取私人跟进…</text><view wx:if="{{followupError}}" class="notice"><text class="chat-text">{{followupError}}</text><button class="notice-action chat-button" bindtap="openHistory">重新读取</button></view><button wx:for="{{followupBindings}}" wx:key="bindingId" wx:if="{{!item.hidden}}" class="followup-list-entry chat-button {{(busy || pendingSend || pendingAction || mediaBusy || mediaPending) ? 'is-disabled' : ''}}" data-id="{{item.bindingId}}" bindtap="selectFollowup" disabled="{{busy || pendingSend || pendingAction || mediaBusy || mediaPending}}"><view class="followup-list-top chat-group"><image class="followup-list-home" src="../assets/requirement-home.png" mode="aspectFit"/><view class="followup-list-identity"><view class="followup-list-heading"><text class="followup-list-title">{{item.title}}</text><text wx:if="{{item.unreadMessages}}" class="followup-list-count">{{item.unreadMessages}}{{item.unreadTruncated ? '+' : ''}}</text></view><view class="followup-list-meta"><text class="followup-list-stage">{{item.audience === 'customer' ? item.projects[0].stageName : item.enterprise.name}}</text><text class="followup-list-date">{{item.latestDateLabel}}</text></view></view></view><view class="followup-list-footer chat-group"><text class="followup-list-delivery">{{item.status === 'stopped' ? '自动跟进已停止' : item.latestReport ? '现场简报已送达' : '等待新的简报'}}</text><view class="followup-list-tail"><text>{{item.latestReport ? '查看已保存记录，接着问小K' : '有新简报时，会在这里保存。'}}</text><view class="conversation-list-arrow"></view></view></view></button><text wx:if="{{!followupListLoading && !followupBindings.length && !followupError}}" class="sheet-helper">当前没有可查看的装修跟进。</text><view wx:if="{{!professionalFollowup}}" class="followup-list-label"><text>最近咨询</text><view class="followup-rule"></view></view>

<text wx:if="{{historyLoading}}" class="sheet-state">正在读取对话记录…</text><view wx:if="{{historyError}}" class="notice"><text class="chat-text">{{historyError}}</text><button class="notice-action chat-button" bindtap="openHistory">重新加载</button></view><text wx:if="{{!professionalFollowup && !historyLoading && !historyError && !history.length}}" class="sheet-state">还没有对话，从一个装修问题开始吧。</text><button wx:for="{{history}}" wx:key="id" class="history-row conversation-list-row chat-button" data-id="{{item.id}}" bindtap="selectHistory"><image class="conversation-list-icon" src="../assets/conversation-outline.png" mode="aspectFit"/><view class="conversation-list-content"><view class="conversation-list-heading"><text class="history-title">{{item.title || '装修咨询'}}</text><text class="conversation-list-date">{{item.createdDateLabel}}</text></view><text class="history-meta">{{item.status === 'open' ? '可继续咨询' : '已结束 · 查看记录'}}</text></view></button><button wx:if="{{historyCursor}}" class="older-action chat-button {{(historyLoading) ? 'is-disabled' : ''}}" bindtap="moreHistory" disabled="{{historyLoading}}">查看更多对话</button></block></block>
<block wx:elif="{{sheet === 'messageShare'}}">
  <text wx:if="{{messageShare}}" class="message-share-text" user-select>{{messageShare.text}}</text>
</block><block wx:elif="{{sheet === 'answerFeedback'}}">
  <template is="reply-feedback" data="{{feedbackReasons, feedbackReason, feedbackNote, feedbackError, feedbackSaved, feedbackBusyId, feedbackPending}}"/>
</block><block wx:elif="{{sheet === 'answerMore'}}">
  <template is="answer-more-menu" data="{{canRegenerateAnswer, canReadAnswer, moreError, regenerationPending, busy, generating, pendingSend, pendingAction, canSend, readOnly, audioState: replyAudioId === replyTarget ? replyAudioState : ''}}"/>
</block><block wx:elif="{{sheet === 'floorplan'}}">
  <view wx:if="{{!contextDetail}}" class="fp-head">
    <text class="fp-headline">{{contextBrowseOnly ? '查看我的户型' : '这次想结合哪份户型？'}}</text>
    <text class="fp-subline">档案只读。选用后，小K会结合这套房子的记录回答。</text>
  </view>
  <view wx:if="{{contextError}}" class="notice"><text class="chat-text">{{contextError}}</text><button class="notice-action chat-button" bindtap="reloadFloorplanContext">{{contextPending ? '核对选择结果' : '重新读取'}}</button></view>
  <text wx:if="{{contextLoading && !contextDetail}}" class="sheet-state">正在核对档案与访问权限…</text>
  <block wx:elif="{{contextDetail}}">
