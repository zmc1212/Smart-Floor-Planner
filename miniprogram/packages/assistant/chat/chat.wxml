    <view class="mb-group-title"><text>选择时段</text></view>
    <text wx:if="{{measureSlotsLoading}}" class="mb-empty" role="status">正在读取可用时段…</text>
    <text wx:elif="{{!measureSlots.length && !measureBookingError}}" class="mb-empty">{{measureProjects.length > 1 && !measureLeadId ? '请先选择服务档案。' : '当天暂无可用时段，请选择其他日期。'}}</text>
    <block wx:elif="{{measureSlots.length}}">
      <view class="mb-slots">
        <button wx:for="{{measureSlots}}" wx:key="startAt" wx:if="{{index < 6 || measureSlotsExpanded || measureSlot.startAt === item.startAt}}" class="mb-slot {{measureSlot.startAt === item.startAt ? 'is-selected' : ''}} chat-button {{(measureBookingPending || measureBookingBusy) ? 'is-disabled' : ''}}" data-slot="{{item}}" bindtap="selectMeasureSlot" disabled="{{measureBookingPending || measureBookingBusy}}">
          <image wx:if="{{measureSlot.startAt === item.startAt}}" class="mb-slot-check" src="../assets/studio-check.png" mode="aspectFit"/>
          <text>{{item.label}}</text>
        </button>
      </view>
      <button wx:if="{{measureSlots.length > 6}}" class="mb-more chat-button" bindtap="toggleMeasureSlots"><text>{{measureSlotsExpanded ? '收起时段' : '查看全部 ' + measureSlots.length + ' 个时段'}}</text><view class="booking-chevron {{measureSlotsExpanded ? 'is-up' : 'is-down'}}"/></button>
    </block>
    <view id="measure-address" class="mb-address">
      <view class="mb-group-title"><text>上门地址</text><text class="mb-section-meta">仅用于本次上门</text></view>
      <view class="mb-address-card">
        <text class="mb-addr-label">详细地址</text>
        <textarea class="mb-input" value="{{measureAddress}}" maxlength="300" auto-height fixed="{{true}}" adjust-position="{{false}}" show-confirm-bar="{{false}}" placeholder="填写小区、楼栋、单元和门牌号" placeholder-class="mb-input-placeholder" bindinput="inputMeasureAddress" bindkeyboardheightchange="keyboardChange" disabled="{{measureBookingPending || measureBookingBusy}}" aria-label="详细地址"/>
        <view class="mb-addr-row">
          <text class="mb-map-location">{{measureLocation.locationName || '地图位置（选填）'}}</text>
          <button class="mb-map chat-button {{(measureBookingPending || measureBookingBusy) ? 'is-disabled' : ''}}" bindtap="chooseMeasureLocation" disabled="{{measureBookingPending || measureBookingBusy}}"><text class="chat-text">选择地点</text><view class="booking-chevron"/></button>
        </view>
      </view>
    </view>

  </block>
</block><block wx:elif="{{sheet === 'publicSite'}}">
  <text wx:if="{{publicDetailLoading}}" class="sheet-state">正在核对资料访问权限…</text>
  <view wx:if="{{publicDetailError || publicError || publicPending}}" class="notice"><text class="chat-text">{{publicDetailError || publicError || '有一项公开材料操作等待确认结果。'}}</text><button class="notice-action chat-button {{(publicBusy || publicDetailLoading) ? 'is-disabled' : ''}}" bindtap="retryPublic" disabled="{{publicBusy || publicDetailLoading}}">{{publicPending ? '核对同次操作结果' : '重新读取'}}</button></view>
  <view wx:if="{{publicDetail}}" class="agent-public-detail">
    <text class="agent-public-project">{{publicDetail.name}}<text wx:if="{{publicDetail.stageName}}"> · {{publicDetail.stageName}}</text></text>
    <view class="agent-public-meta"><text>{{publicDetail.district}}</text><text class="fabric-label">业主授权公开</text></view>
    <view class="agent-public-photo"><image class="chat-image" wx:if="{{publicDetail.photos.length && publicDetailPaths[publicDetail.photos[0].key]}}" src="{{publicDetailPaths[publicDetail.photos[0].key]}}" mode="aspectFill" data-key="{{publicDetail.photos[0].key}}" bindtap="previewPublicDetail"/><text class="chat-text" wx:else>这一版没有公开现场照片。</text><view class="agent-public-tape"/></view>
    <view wx:if="{{publicLiveEntry}}" class="public-live-entry"><text>● 直播可观看 · {{publicLiveEntry.alias}}</text><button class="chat-button" bindtap="watchPublicLive">观看直播 ↗</button></view>
    <view class="agent-public-tabs"><button class="{{publicLiveTab === 'photos' ? 'is-active' : ''}} chat-button" data-tab="photos" bindtap="publicLiveTab">现场进展</button><button class="{{publicLiveTab !== 'photos' ? 'is-active' : ''}} chat-button" data-tab="records" bindtap="publicLiveTab">小K服务记录</button></view>
    <block wx:if="{{publicLiveTab === 'photos'}}"><view wx:for="{{publicDetail.photos}}" wx:key="key" class="agent-public-extra"><image class="chat-image" wx:if="{{publicDetailPaths[item.key]}}" src="{{publicDetailPaths[item.key]}}" mode="widthFix" data-key="{{item.key}}" bindtap="previewPublicDetail"/></view></block>
    <block wx:else><text class="fabric-label agent-public-record-label">小K服务记录</text><view wx:for="{{publicDetail.excerpts}}" wx:key="key" class="agent-public-record"><text>{{item.role}} <text class="agent-public-time">· {{item.dateLabel}}</text></text><text class="agent-public-quote" user-select>{{item.text}}</text></view></block>
    <button class="owner-live-primary chat-button {{(!canSend || publicBusy || publicPending || publicDetailLoading || loading || fatal || readOnly || busy || generating || pendingSend || pendingAction || uncertainRun || contextBusy || contextPending || speechBusy) ? 'is-disabled' : ''}}" bindtap="askPublicSite" disabled="{{!canSend || publicBusy || publicPending || publicDetailLoading || loading || fatal || readOnly || busy || generating || pendingSend || pendingAction || uncertainRun || contextBusy || contextPending || speechBusy}}">围观中有疑问？问小K</button>
    <button class="agent-public-designer chat-button" bindtap="publicLiveDesigner">找设计师聊 ↗</button>
  </view>
</block>
<block wx:elif="{{sheet === 'ownerReminder'}}">
  <text wx:if="{{ownerReminderLoading}}" class="sheet-state">正在读取提醒…</text>
  <view wx:elif="{{ownerReminderError}}" class="notice" role="alert"><text class="chat-text">{{ownerReminderError}}</text><button class="notice-action chat-button" bindtap="readOwnerReminder">重试</button></view>
  <view wx:elif="{{ownerReminderDetail}}" class="owner-reminder-detail">
    <text class="sheet-helper">{{ownerReminderDetail.projectName}}</text>
    <text class="owner-reminder-detail-title">{{ownerReminderDetail.title}}</text>
    <text class="owner-reminder-detail-body" user-select>{{ownerReminderDetail.body}}</text>
  </view>
</block>
<block wx:elif="{{sheet === 'reportDecision'}}">
  <text wx:if="{{planBusy && !planCards[reportBoardDecision]}}" class="sheet-state">正在读取原方案…</text>
  <view wx:if="{{planError || planPending}}" class="notice" role="alert"><text class="chat-text">{{planError || '上次决定正在核对。'}}</text><button wx:if="{{planPending}}" class="notice-action chat-button" bindtap="retryPlan">核对决定结果</button></view>
  <template wx:if="{{planCards[reportBoardDecision].status === 'approved'}}" is="approved-plan-card" data="{{card: planCards[reportBoardDecision], paths: planPaths, busy: planBusy, pending: planPending}}"/><template wx:elif="{{planCards[reportBoardDecision]}}" is="plan-decision-card" data="{{card: planCards[reportBoardDecision], paths: planPaths, expanded: planExpanded, busy: planBusy, pending: planPending}}"/>
</block>
<block wx:elif="{{sheet === 'reportSource'}}"><template is="citation-content" data="{{citation: reportSource, citationLoading: reportSourceLoading, citationError: reportSourceError, retry: 'retryReportSource'}}"/><button wx:if="{{reportSource.available && reportSource.originalAvailable && !reportSourceLoading && !reportSourceError}}" class="notice-action chat-button" bindtap="openReportSourceFile">打开原文件</button></block><template wx:elif="{{sheet === 'followupCitation'}}" is="citation-content" data="{{citation: followupChat.citation, citationLoading: followupChat.citationLoading, citationError: followupChat.citationError, retry: 'retryFollowupCitation'}}"/><template wx:else is="citation-content" data="{{citation, citationLoading, citationError, retry: 'retryCitation', paper: sheet === 'citation'}}"/>
    </scroll-view>
<view wx:if="{{sheet === 'messageShare' && messageShare}}" class="message-share-footer">
  <text wx:if="{{messageShareError}}" class="sheet-helper" role="status">{{messageShareError}}</text>
  <button class="answer-feedback-submit chat-button {{(messageShareBusy) ? 'is-disabled' : ''}}" bindtap="shareSelectedMessage" disabled="{{messageShareBusy}}">{{messageShareBusy ? '正在准备…' : '分享到微信'}}</button>
</view>
<view wx:if="{{sheet === 'floorplan' && contextDetail}}" class="fp-actions">
  <button class="fp-open-action chat-button" bindtap="previewFloorplan"><image class="chat-image" src="../assets/receipt-plan-map.png" mode="aspectFit"/><text class="chat-text">打开户型图</text></button>
  <button class="fp-use booking-primary chat-button {{(contextBusy || contextPending || readOnly || generating) ? 'is-disabled' : ''}}" data-index="detail" bindtap="chooseFloorplan" disabled="{{contextBusy || contextPending || readOnly || generating}}">{{contextBusy ? '正在选用…' : '使用此档案'}}</button>
</view>
<view wx:if="{{sheet === 'measure' && !measureAppointment && !measureBookingLoading}}" class="mb-confirm-bar">
  <view wx:if="{{measureBookingError}}" class="mb-feedback" role="status">
    <text class="chat-text">{{measureBookingError}}</text><button wx:if="{{!measureBookingPending}}" class="mb-retry chat-button {{(measureBookingBusy) ? 'is-disabled' : ''}}" bindtap="retryMeasureBooking" disabled="{{measureBookingBusy}}">重试</button>
  </view>
  <button class="mb-primary booking-primary chat-button {{(!measureSlot || !measureAddress || measureBookingBusy || measureSlotsLoading || (measureProjects.length > 1 && !measureLeadId)) ? 'is-disabled' : ''}}" bindtap="submitMeasureBooking" disabled="{{!measureSlot || !measureAddress || measureBookingBusy || measureSlotsLoading || (measureProjects.length > 1 && !measureLeadId)}}">{{measureBookingBusy ? '正在提交…' : measureBookingPending ? '核对预约结果' : measureSlot ? '确认预约 ' + measureSlotHeading : '确认预约'}}</button>
</view>
</view></view></view>
