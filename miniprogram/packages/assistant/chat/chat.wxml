</view><template wx:if="{{runLabel && generating && run.answerPhase && !revealingReplyId && !connectionInterrupted && !staffTab && !professionalFollowup && !ownerSiteReport}}" is="answer-process-running" data="{{label: runLabel, busy, pendingAction}}"/>
<view wx:elif="{{runLabel && !revealingReplyId}}" class="run-state"><view class="avatar"><image class="chat-image" src="../assets/xiaok-chat-avatar.png" mode="aspectFit"/></view><view class="run-paper"><text class="run-label">{{runLabel}}</text><view wx:if="{{generating}}" class="processing-dots" aria-hidden="true"><view class="chat-group"></view><view class="chat-group"></view><view class="chat-group"></view></view><button wx:if="{{generating}}" class="run-action chat-button {{(busy || pendingAction) ? 'is-disabled' : ''}}" bindtap="stop" disabled="{{busy || pendingAction}}"><text>停止回答</text></button><button wx:elif="{{retryable && canSend && !readOnly}}" class="run-action chat-button {{(busy || pendingAction) ? 'is-disabled' : ''}}" bindtap="retryRun" disabled="{{busy || pendingAction}}"><text>重新回答</text><image class="chat-image" src="../assets/chat-arrow-up-right.png" mode="aspectFit"/></button><button wx:elif="{{uncertainRun}}" class="run-action chat-button {{(busy) ? 'is-disabled' : ''}}" bindtap="refresh" disabled="{{busy}}"><text>刷新状态</text></button></view></view>
