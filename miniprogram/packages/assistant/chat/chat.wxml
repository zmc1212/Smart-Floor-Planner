    </button>
    <view class="floorplan-context-link">
      <view class="floorplan-context-divider" aria-hidden="true"></view>
      <button class="floorplan-browse chat-button {{(contextBusy || loading || fatal) ? 'is-disabled' : ''}}" bindtap="browseFloorplan" disabled="{{contextBusy || loading || fatal}}">
        <text>查看档案</text><image class="chat-image" src="../assets/chat-arrow-up-right.png" mode="aspectFit" aria-hidden="true"/>
      </button>
    </view>
  </view><view wx:if="{{contextError}}" class="context-error"><text>{{contextError}}</text><button class="chat-button" bindtap="reloadFloorplanContext">重试</button></view><view wx:if="{{draft.length > maxChars - 200}}" class="composer-footer"><text>{{draft.length}}/{{maxChars}}</text></view></view>

<template wx:if="{{messageMenu && !sheet && !followupActive}}" is="message-actions-menu" data="{{menu:messageMenu, actions:messageActionItems, idle:canSend && !busy && !pendingSend && !pendingAction && !generating}}"/>
<view wx:if="{{sheet}}" class="sheet-layer {{sheetOpen ? 'is-open' : ''}}" catchtouchmove="swallow">
  <view class="sheet-mask" bindtap="closeSheet"></view>
  <view class="sheet-panel {{sheet === 'history' ? 'conversation-list-sheet' : sheet === 'answerFeedback' ? 'answer-action-sheet' : sheet === 'messageShare' ? 'answer-action-sheet message-share-sheet' : sheet === 'answerMore' ? 'answer-action-sheet answer-more-sheet' : sheet === 'floorplan' ? 'archive-booking-sheet floorplan-sheet ' + floorplanSheetMode : sheet === 'measure' ? 'archive-booking-sheet measure-sheet' : sheet === 'citation' ? 'answer-citation-sheet' : ''}}"
    style="--archive-top: {{navigationTop + navigationHeight + 14}}px; --archive-keyboard: {{sheet === 'measure' ? keyboardHeight : 0}}px; --archive-inset: {{sheet === 'measure' && keyboardHeight ? 0 : bottomInset}}px; --interaction-keyboard: {{interactionKeyboard}}px; --citation-inset: {{bottomInset}}px;">
    <view wx:if="{{sheet === 'history' || sheet === 'answerFeedback' || sheet === 'answerMore' || sheet === 'messageShare' || sheet === 'citation'}}" class="conversation-list-grip"></view>
