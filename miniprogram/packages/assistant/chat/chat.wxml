    <view wx:if="{{!contextItems.length && !contextLoading && !contextError}}" class="fp-empty-state"><text class="fp-list-title">暂无可用的正式户型</text><text class="fp-subline">你可以继续和小K聊，也可以自己发图。</text></view>
