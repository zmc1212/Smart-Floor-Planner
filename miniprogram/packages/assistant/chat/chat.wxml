      <text class="fp-mat-note">图内墙边记录 · 非净尺寸</text>
    </view>
    <view wx:for="{{contextDetail.rooms}}" wx:key="id" class="fp-room">
      <view class="fp-room-head">
        <text class="fp-room-name">{{item.name}}</text>
        <view class="fp-room-tags">
          <text class="fp-room-tag">{{item.floorName}}</text>
          <text wx:if="{{item.ceilingLabel}}" class="fp-room-tag">{{item.ceilingLabel}}</text>
        </view>
      </view>
      <view class="fp-line">
        <text class="fp-line-label">墙边 mm</text>
        <view class="fp-values">
          <text wx:for="{{item.wallItems}}" wx:for-item="wall" wx:key="key" class="fp-ruler">{{wall.value}}</text>
          <text wx:if="{{item.partialWalls}}" class="fp-empty">部分墙边无可读长度</text>
        </view>
      </view>
      <view class="fp-line">
        <text class="fp-line-label">门窗</text>
        <view class="fp-doors">
          <text wx:for="{{item.openingItems}}" wx:for-item="opening" wx:key="key" class="fp-door">{{opening.label}}</text>
          <text wx:if="{{item.openingEmpty}}" class="fp-empty">本次图内未提供可读的门窗尺寸记录</text>
        </view>
      </view>
    </view>
    <view wx:if="{{!contextDetail.rooms.length && contextDetail.text}}" class="fp-fallback" user-select>{{contextDetail.text}}</view>
    <view class="fp-note">
      <text class="fp-note-label">读数说明</text>
      <text class="fp-note-copy">图内墙边不等于房间净尺寸或柜体长度，也不把两条边拼成矩形；照片未与具体墙边对应，不证明现场复核或隐蔽工程。</text>
      <text wx:if="{{contextDetail.truncated}}" class="fp-note-copy">其余房间或墙边/门窗记录未在本次展开。</text>
    </view>

  </block>
  <block wx:else>
