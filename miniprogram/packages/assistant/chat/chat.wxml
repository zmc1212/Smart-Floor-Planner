    </button>
    <view class="composer-divider" aria-hidden="true"></view>
    <button class="media-button chat-button {{(promotionEntry || loading || busy || fatal || pendingSend || pendingAction || mediaBusy) ? 'is-disabled' : ''}}" wx:if="{{!stageExperience || stageExperience.attachments}}" bindtap="openMedia" disabled="{{promotionEntry || loading || busy || fatal || pendingSend || pendingAction || mediaBusy}}" aria-label="本次图片资料">
      <image class="composer-picture-glyph chat-image" src="../assets/welcome-notebook/picture.png" mode="aspectFit"/>
    </button>
    <textarea class="composer-input" value="{{draft}}" cursor="{{stageInputCursor}}" hold-keyboard="{{inputCandidates.length > 0}}" maxlength="{{maxChars}}" auto-height adjust-position="{{false}}" show-confirm-bar="{{false}}" placeholder="{{reportQuestion.selected ? '继续问这份报告…' : '说说你想改变的地方…'}}" placeholder-class="input-placeholder" bindinput="input" bindtap="focusInput" bindfocus="focusInput" bindblur="blurInput" bindkeyboardheightchange="keyboardChange" disabled="{{promotionEntry || loading || busy || fatal && !needsLogin || !canSend && !needsLogin || pendingSend || generating || uncertainRun || pendingAction || readOnly}}" aria-label="装修咨询内容"/>
    <button class="send-button chat-button {{(promotionEntry || !draft || loading || busy || sending || fatal && !needsLogin || !canSend && !needsLogin || pendingSend || generating || uncertainRun || pendingAction || readOnly || speechBusy || contextBusy || contextLoading || contextPending || reportQuestion.busy || reportQuestion.pending) ? 'is-disabled' : ''}}" bindtap="send" disabled="{{promotionEntry || !draft || loading || busy || sending || fatal && !needsLogin || !canSend && !needsLogin || pendingSend || generating || uncertainRun || pendingAction || readOnly || speechBusy || contextBusy || contextLoading || contextPending || reportQuestion.busy || reportQuestion.pending}}" aria-label="发送">
      <image class="composer-send-glyph chat-image" src="../assets/welcome-notebook/send.png" mode="aspectFit"/>
    </button>
  </view>
  <view wx:if="{{inputFocused || keyboardHeight}}" class="floorplan-context-row">
    <button class="floorplan-scope chat-button {{(contextBusy || loading || fatal || pendingSend || pendingAction || generating) ? 'is-disabled' : ''}}" bindtap="openFloorplanPicker" disabled="{{contextBusy || loading || fatal || pendingSend || pendingAction || generating}}">
      <view class="floorplan-scope-pill">
        <image class="chat-image" src="../assets/requirement-home.png" mode="aspectFit" aria-hidden="true"/>
