<!-- C05 extends the approved C01 conversation; server metadata alone creates decision actions. -->
<import src="./report-question.wxml"/>
<import src="./public-live.wxml"/>
<import src="./designer-cards.wxml"/>
<import src="./construction-receipts.wxml"/>
<import src="./reply-actions.wxml"/>
<import src="./message-actions.wxml"/>
<import src="./answer-process.wxml"/>
<import src="./chat-network.wxml"/>
<template name="message-text">
  <view wx:if="{{markdown}}" class="message-block message-markdown">
    <block wx:for="{{markdown}}" wx:for-item="part" wx:key="key">
      <rich-text wx:if="{{part.kind === 'text'}}" class="markdown-part" nodes="{{part.nodes}}" user-select/>
      <scroll-view wx:else id="markdown-{{messageId}}-{{blockKey}}-{{part.key}}" class="markdown-part markdown-scroll markdown-scroll-{{part.kind}}" scroll-x enhanced>
        <rich-text class="markdown-scroll-content" nodes="{{part.nodes}}" user-select/>
      </scroll-view>
    </block>
  </view>
  <text wx:else class="message-block" user-select="{{selectable}}">{{text}}</text>
</template>
<template name="citation-content">
  <text wx:if="{{citationLoading}}" class="sheet-state">正在核对资料访问权限…</text>
  <view wx:elif="{{citationError}}" class="notice">
    <text class="chat-text">{{citationError}}</text>
    <button class="notice-action chat-button" bindtap="{{retry}}">重试</button>
  </view>
  <view wx:elif="{{citation && citation.available}}" class="source-content">
    <view wx:if="{{paper}}" class="citation-source">
      <view wx:if="{{citation.sourceUrl}}" class="answer-process-globe citation-source-icon" aria-hidden="true"/>
      <image wx:else class="answer-process-book citation-source-icon" src="../assets/book-open.png" mode="aspectFit" aria-hidden="true"/>
      <view class="citation-source-copy">
        <view class="citation-source-heading">
          <text class="citation-source-title">{{citation.title}}</text>
          <text wx:if="{{citation.paper.page}}" class="citation-page">{{citation.paper.page}}</text>
        </view>
        <text wx:if="{{citation.paper.meta}}" class="citation-meta" user-select>{{citation.paper.meta}}</text>
      </view>
    </view>
    <block wx:else>
      <text class="source-title">{{citation.title}}</text>
      <text wx:if="{{citation.versionLabel}}" class="sheet-helper">{{citation.versionLabel}}</text>
      <text wx:else class="sheet-helper">版本 {{citation.versionNumber}}{{citation.historical ? ' · 回答时引用的历史版本' : ''}}</text>
      <text wx:if="{{citation.sourceLocation}}" class="sheet-helper" user-select>{{citation.sourceLocation}}</text>
    </block>
    <image wx:if="{{citation.imagePath}}" class="message-photo" src="{{citation.imagePath}}" mode="widthFix"/>
    <view wx:if="{{paper && citation.paper.paragraphs.length}}" class="citation-excerpt">
      <text class="citation-excerpt-label">原文摘录</text>
      <view class="citation-excerpts">
        <text wx:for="{{citation.paper.paragraphs}}" wx:key="index" class="citation-paragraph" user-select>{{item.text}}</text>
      </view>
    </view>
    <text wx:elif="{{!paper}}" class="source-quote" user-select>{{citation.quote}}</text>
    <block wx:if="{{citation.reference}}">
      <text class="sheet-helper" user-select>出处：{{citation.reference.source}}</text>
      <text class="sheet-helper" user-select>授权：{{citation.reference.authorization}}</text>
      <text class="sheet-helper">仅供装修方向参考，不是你家的正式施工方案；可直接说喜欢或不合适。</text>
    </block>
  </view>
  <text wx:else class="sheet-state">这份资料已撤回、过期或不再对当前身份开放。请重新提问。</text>
</template>
<template name="owner-public-card"><view wx:if="{{card}}" class="owner-public-card"><text class="owner-public-title">这次拟公开的内容</text><text class="owner-public-name">{{card.name}} · {{card.stageName}}</text><view class="owner-public-photos"><block wx:for="{{expanded === card.key && card.full ? card.photos : card.summaryPhotos}}" wx:key="id"><image class="chat-image" wx:if="{{paths[item.key]}}" src="{{paths[item.key]}}" mode="aspectFill" data-key="{{item.key}}" bindtap="previewPublic"/></block></view><text class="owner-public-count">现场照片 {{card.photos.length}} 张 · 服务节选 {{card.excerptCount}} 条</text><view wx:for="{{expanded === card.key && card.full ? card.full.excerpts : card.excerpts}}" wx:key="key" class="owner-public-quote"><text wx:if="{{expanded === card.key}}" class="owner-public-meta chat-text">{{item.role}} · {{item.dateLabel}}</text><text class="chat-text" user-select>{{item.text}}</text></view><text class="owner-public-scope">公开后，进入本企业公开工地页的访客可查看。</text><text class="owner-public-scope">不公开姓名、电话和门牌；新增内容会重新征求同意。</text><text class="owner-public-meta">{{card.statusLabel}}{{card.reason ? ' · ' + card.reason : ''}}</text><block wx:if="{{card.canDecide}}"><button class="owner-public-primary chat-button {{(busy || pending || disabled) ? 'is-disabled' : ''}}" data-key="{{card.key}}" data-action="{{expanded === card.key && card.full ? 'approve' : 'preview'}}" bindtap="publicDecision" disabled="{{busy || pending || disabled}}">{{busy ? '正在确认…' : expanded === card.key && card.full ? '同意公开这一版' : '查看全部公开内容'}}</button><view class="owner-public-options"><button class="chat-button {{(busy || pending || disabled) ? 'is-disabled' : ''}}" data-key="{{card.key}}" data-action="decline" bindtap="publicDecision" disabled="{{busy || pending || disabled}}">暂不公开</button><button class="chat-button {{(busy) ? 'is-disabled' : ''}}" bindtap="laterPublic" disabled="{{busy}}">稍后再看</button></view></block><button wx:elif="{{card.canWithdraw}}" class="notice-action chat-button {{(busy || pending || disabled) ? 'is-disabled' : ''}}" data-key="{{card.key}}" data-action="withdraw" bindtap="publicDecision" disabled="{{busy || pending || disabled}}">撤回这一版公开授权</button><text class="owner-public-meta">只决定这次预览，其他聊天照常继续。</text></view></template>
<template name="plan-decision-card"><view wx:if="{{card}}" class="owner-public-card"><text class="owner-public-title">这次方案，请你决定</text><text class="owner-public-name">{{card.title}} · V{{card.number}} · {{card.roomName}}</text><view class="owner-public-quote"><text class="chat-text" user-select>{{card.full ? card.difference : card.summary}}</text></view><text class="owner-public-scope">费用变化 {{card.costLabel}} · 工期变化 {{card.scheduleLabel}}</text><view wx:if="{{card.full}}" class="owner-public-photos"><image class="chat-image" wx:if="{{paths[card.key]}}" src="{{paths[card.key]}}" mode="aspectFit" data-id="{{card.id}}" bindtap="previewPlan"/><text wx:else class="owner-public-meta">正在读取这一版图纸…</text></view><text class="owner-public-meta">方案 {{card.id}} · {{card.statusLabel}}{{card.reason ? ' · ' + card.reason : ''}}</text><text class="owner-public-scope">只决定这一版图纸、差异及上述影响；现场落实与事项关闭由团队另行核对。</text><block wx:if="{{card.canDecide}}"><button class="owner-public-primary chat-button {{(busy || pending || disabled || card.full && !paths[card.key]) ? 'is-disabled' : ''}}" data-id="{{card.id}}" data-action="{{card.full && expanded === card.id ? 'approve' : 'preview'}}" bindtap="planDecision" disabled="{{busy || pending || disabled || card.full && !paths[card.key]}}">{{busy ? '正在确认…' : card.full && expanded === card.id ? '同意这一版方案' : '查看完整图纸与差异'}}</button><view class="owner-public-options"><button class="chat-button {{(busy || pending || disabled) ? 'is-disabled' : ''}}" data-id="{{card.id}}" data-action="decline" bindtap="planDecision" disabled="{{busy || pending || disabled}}">不同意这一版</button><button class="chat-button {{(busy || pending || disabled) ? 'is-disabled' : ''}}" data-id="{{card.id}}" data-action="defer" bindtap="planDecision" disabled="{{busy || pending || disabled}}">稍后决定</button></view><button class="notice-action chat-button {{(busy || pending || disabled) ? 'is-disabled' : ''}}" data-id="{{card.id}}" data-action="request-changes" bindtap="planDecision" disabled="{{busy || pending || disabled}}">希望调整一下</button></block><button wx:elif="{{!card.full}}" class="notice-action chat-button {{(busy || pending || disabled) ? 'is-disabled' : ''}}" data-id="{{card.id}}" data-action="details" bindtap="planDecision" disabled="{{busy || pending || disabled}}">查看这一版图纸</button><text class="owner-public-meta">拒绝或稍后决定，其他聊天照常继续。</text></view></template><view class="chat-page notebook-chat {{!promotionEntry && !siteContext && !staffTab && !professionalFollowup && !ownerSiteReport && !followupActive && !reportQuestion.selected && !sending && !messages.length && !pendingText && !loading && (!fatal || needsLogin) ? 'welcome-notebook' : ''}} {{promotionEntry ? 'promotion-entry-active' : ''}} {{embedded ? 'embedded-chat' : ''}} {{sheet === 'floorplan' || sheet === 'measure' ? 'notebook-sheet-open' : ''}}" style="height: {{viewportHeight - keyboardHeight - (embedded && !keyboardHeight ? 50 + bottomInset : 0)}}px;"><image class="notebook-paper-grain notebook-cover-grain" src="../assets/welcome-notebook/paper-grain.png" mode="aspectFill" aria-hidden="true"/>
<view class="notebook-spine" aria-hidden="true"><view class="book-ring ring-one"></view><view class="book-ring ring-two"></view><view class="book-ring ring-three"></view><view class="book-ring ring-four"></view></view><view wx:if="{{!(reportBoard && followupActive)}}" class="chat-nav" style="padding-top: {{navigationTop}}px; padding-right: {{navigationRight}}px;"><view class="nav-lane" style="min-height: {{navigationHeight}}px;"><button wx:if="{{(professionalFollowup && !staffTab) || ownerSiteReport}}" class="notebook-history chat-button" bindtap="back" aria-label="返回"><view class="history-paper"><view class="followup-back"></view></view></button><button wx:elif="{{!staffTab}}" class="notebook-history chat-button {{(promotionEntry || loading || needsLogin || fatal || busy || pendingSend || pendingAction) ? 'is-disabled' : ''}}" bindtap="openHistory" aria-label="历史对话" disabled="{{promotionEntry || loading || needsLogin || fatal || busy || pendingSend || pendingAction}}"><view class="history-paper"><image class="welcome-clock-glyph chat-image" src="../assets/welcome-notebook/clock.png" mode="aspectFit"/></view></button><text class="notebook-brand">小K</text><button wx:if="{{professionalFollowup && !reportBoard}}" class="notebook-history chat-button" bindtap="openHistory" aria-label="跟进会话"><image style="width: 25px; height: 25px;" src="../assets/history.png" mode="aspectFit"/></button><button wx:if="{{!reportBoard && followupActive && followupContext.audience === 'customer'}}" size="mini" class="designer-entry chat-button {{(followupChat.loading || followupChat.fatal || !followupChat.conversation || followupChat.busy || followupChat.handoffBusy || followupChat.pendingSend || followupChat.pendingAction) ? 'is-disabled' : ''}}" bindtap="openFollowupHandoff" disabled="{{followupChat.loading || followupChat.fatal || !followupChat.conversation || followupChat.busy || followupChat.handoffBusy || followupChat.pendingSend || followupChat.pendingAction}}"><text class="chat-text">{{followupChat.handoffBusy && !followupChat.reception ? '正在转接…' : followupChat.reception ? '查看接待' : '找设计师'}}</text><image class="chat-image" src="../assets/chat-arrow-up-right.png" mode="aspectFit"/></button><button wx:if="{{!professionalFollowup && !followupActive && (!conversation || conversation.status === 'open')}}" size="mini" class="designer-entry chat-button {{(promotionEntry || loading || fatal || !canSend || busy || handoffBusy || pendingSend || pendingAction) ? 'is-disabled' : ''}}" bindtap="openHandoff" disabled="{{promotionEntry || loading || fatal || !canSend || busy || handoffBusy || pendingSend || pendingAction}}"><text class="chat-text">{{handoffBusy && (!conversation || conversation.mode === 'ai') ? '正在转接…' : conversation.mode === 'human' || conversation.mode === 'handoff_requested' ? '查看接待' : '找设计师'}}</text><image class="chat-image" src="../assets/chat-arrow-up-right.png" mode="aspectFit"/></button></view></view>

<include src="./followup-view.wxml"/>
<template wx:if="{{!followupActive && connectionInterrupted}}" is="chat-network"
  data="{{action: 'reconnectChat', disabled: busy || loading || reconnectingChat, reconnecting: reconnectingChat}}"/>
<view wx:if="{{needsLogin && !followupActive && !promotionEntry}}" class="guest-login-note">
  <image class="notebook-paper-grain" src="../assets/welcome-notebook/paper-grain.png" mode="aspectFill" aria-hidden="true"/>
  <view class="guest-login-copy">
    <text class="guest-login-title">登录后和小K聊装修</text>
    <text class="guest-login-helper">咨询记录随时可查</text>
  </view>
  <button class="guest-login-action chat-button" bindtap="login" aria-label="去登录">
    <view class="fabric-label guest-login-fabric">
      <text>去登录</text>
      <view class="guest-login-arrow" aria-hidden="true"></view>
    </view>
  </button>
</view>

<view wx:if="{{promotionResumedLeadId && !promotionEntry && !loading && !fatal && !followupActive}}" class="promotion-resume">
  <text class="promotion-resume-mark" aria-hidden="true">✓</text><text>已接续原有服务</text>
  <button class="promotion-resume-link chat-button" bindtap="openPromotionArchive"><text class="chat-text">服务档案 ↗</text></button>
</view>
<scroll-view wx:if="{{!followupActive}}" class="conversation-scroll" scroll-y enhanced show-scrollbar="{{false}}" scroll-into-view="{{scrollTarget}}" scroll-top="{{replyScrollTop}}" scroll-with-animation="{{false}}" bindscroll="watchReplyScroll" bindtouchmove="pauseReplyScroll"><include src="./promotion-entry.wxml"/><view wx:if="{{!promotionEntry}}" class="conversation-content {{!reportQuestion.selected && !sending && !messages.length && !pendingText && !loading && (!fatal || needsLogin) ? 'new-conversation-content' : ''}}"><template is="report-question-paper" data="{{q: reportQuestion}}"/><view wx:if="{{siteContext && !reportQuestion.selected && !sending && !messages.length && !pendingText && !loading && (!fatal || needsLogin)}}" class="notebook-welcome">
  <view class="welcome-art-group"><image class="welcome-sage" src="../assets/chat-notebook-sage.png" mode="aspectFit" aria-hidden="true"/><image class="welcome-mascot" src="../assets/chat-notebook-mascot.png" mode="aspectFit" aria-hidden="true"/></view>
  <view class="welcome-paper">
    <view class="welcome-paper-under" aria-hidden="true"></view>
    <view class="welcome-tape" aria-hidden="true"></view>
    <text class="fabric-label welcome-label">工地动态</text>
    <text class="welcome-title">我家的工地</text>
    <view class="pencil-underline" aria-hidden="true"></view>
    <view class="welcome-subtitle site-project-line" style="display:flex;align-items:center;gap:8rpx;margin:0 4rpx;max-width:100%;text-align:left;white-space:nowrap;" bindtap="openOwnerSite"><text class="site-project-text" style="display:block;flex:1;min-width:0;max-width:100%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">{{siteContext.name}} · {{siteContext.stageName ? siteContext.stageName + '阶段' : '施工中'}}<text wx:if="{{siteContext.hasTodayReport}}"> · 今日有更新</text><text wx:elif="{{siteContext.hasReport}}"> · 有新日报</text></text><text class="site-project-arrow" style="flex:none;">›</text></view>
    <view class="welcome-subtitle site-subtitle" style="margin:0 4rpx;text-align:left;white-space:normal;word-break:break-all;">{{siteGreeting}}</view>
    <view class="topic-intro"><view class="chat-group"></view><text>{{stageExperience ? "开场预设问题" : "猜你想问"}}</text><view class="chat-group"></view></view>
    <view class="notebook-topics">
      <button wx:for="{{siteTopics}}" wx:key="title" class="topic-note topic-{{index}} chat-button {{(busy || pendingSend) ? 'is-disabled' : ''}}" data-text="{{item.text}}" bindtap="pickPrompt" disabled="{{busy || pendingSend}}"><text class="topic-number">0{{index + 1}}</text><image class="topic-icon" src="../assets/{{item.icon}}.png" mode="aspectFit"/><text class="topic-title">{{item.title}}</text><text class="topic-helper">{{item.helper}}</text><view class="note-fold" aria-hidden="true"></view></button>
    </view>
    <view class="welcome-handnote"><image class="chat-image" src="../assets/chat-corner-arrow.png" mode="aspectFit" aria-hidden="true"/><text class="chat-text">也可以直接写下你的想法</text></view>
  </view>
</view>
<view wx:if="{{!siteContext && !reportQuestion.selected && !sending && !messages.length && !pendingText && !loading && (!fatal || needsLogin)}}" class="notebook-welcome welcome-default">
  <view class="welcome-art-group">
    <image class="welcome-sage" src="../assets/chat-notebook-sage.png" mode="aspectFit" aria-hidden="true"/>
    <image class="welcome-art-doodle" src="../assets/welcome-notebook/paper-doodle.png" mode="aspectFit" aria-hidden="true"/>
    <view class="welcome-mascot-ground" aria-hidden="true"></view>
    <image class="welcome-mascot" src="../assets/chat-notebook-mascot.png" mode="aspectFit" aria-hidden="true"/>
  </view>
  <view class="welcome-paper">
    <view class="welcome-paper-back" aria-hidden="true"></view>
    <view class="welcome-paper-shadow" aria-hidden="true">
      <view class="welcome-paper-face">
        <image class="notebook-paper-grain" src="../assets/welcome-notebook/paper-grain.png" mode="aspectFill" aria-hidden="true"/>
      </view>
    </view>
    <view class="welcome-tape" aria-hidden="true"></view>
    <image class="welcome-label-sprig" src="../assets/welcome-notebook/sage-sprig.png" mode="aspectFit" aria-hidden="true"/>
    <text class="fabric-label welcome-label">新的一页</text>
    <text class="welcome-title">小K会客室</text>
    <image class="welcome-title-underline" src="../assets/welcome-notebook/title-underline.png" mode="aspectFit" aria-hidden="true"/>
    <text class="welcome-subtitle">{{staffProfileCapture ? '装修需求将整理给这套房的服务团队。' : '把关于家的想法，慢慢聊清楚。'}}</text>
    <view class="topic-intro"><view class="chat-group"></view><text>今天，想先聊点什么？</text><view class="chat-group"></view></view>
    <view class="notebook-topics">
      <button wx:for="{{topics}}" wx:key="title" class="topic-note topic-{{index}} chat-button {{(busy || pendingSend) ? 'is-disabled' : ''}}" data-text="{{item.text}}" bindtap="pickPrompt" disabled="{{busy || pendingSend}}">
        <view class="topic-paper-shadow" aria-hidden="true">
          <view class="topic-paper">
            <image class="notebook-paper-grain" src="../assets/welcome-notebook/paper-grain.png" mode="aspectFill" aria-hidden="true"/>
            <image wx:if="{{index !== 1}}" class="topic-sprig" src="../assets/welcome-notebook/sage-sprig.png" mode="aspectFit" aria-hidden="true"/>
          </view>
          <view class="note-fold" aria-hidden="true"></view>
        </view>
        <text class="topic-number">0{{index + 1}}</text>
        <image class="topic-icon" src="../assets/welcome-notebook/{{item.icon}}.png" mode="aspectFit" aria-hidden="true"/>
        <text class="topic-title">{{item.title}}</text>
        <text class="topic-helper">{{item.helper}}</text>
      </button>
    </view>
    <view class="welcome-handnote">
      <image class="welcome-writing-arrow chat-image" src="../assets/welcome-notebook/writing-arrow.png" mode="aspectFit" aria-hidden="true"/>
      <text class="welcome-writing-text chat-text">也可以直接写下你的想法</text>
    </view>
  </view>
</view>

<view wx:if="{{loading}}" class="status-message"><view class="loading-dot"></view><text>正在读取你的装修咨询…</text></view><view wx:if="{{error && !needsLogin && !connectionInterrupted && (!pendingText || fatal || needsServiceCode || pendingAction)}}" class="notice" role="alert"><text class="chat-text">{{error}}</text><button wx:if="{{needsServiceCode}}" class="notice-action chat-button" bindtap="scanServiceCode">扫推广码</button><button wx:elif="{{pendingSend}}" class="notice-action chat-button {{(busy) ? 'is-disabled' : ''}}" bindtap="send" disabled="{{busy}}">确认发送结果</button><button wx:elif="{{pendingAction}}" class="notice-action chat-button {{(busy) ? 'is-disabled' : ''}}" bindtap="confirmAction" disabled="{{busy}}">确认操作结果</button><button wx:else class="notice-action chat-button {{(busy) ? 'is-disabled' : ''}}" bindtap="refresh" disabled="{{busy}}">重新连接</button></view><view wx:if="{{!loading && !fatal}}"><view wx:if="{{!canSend}}" class="notice muted">当前企业暂未开放小K咨询，已有对话仍可查看。</view><view wx:if="{{conversation.mode === 'handoff_requested' || conversation.mode === 'human'}}" class="handoff-state" id="handoff-state"><text class="fabric-label">小K</text><text class="handoff-heading">{{conversation.mode === 'human' ? conversation.ownerAvailable === false ? '接待人暂不可用' : (conversation.humanName || '设计师') + '正在接待' : '正在等待设计师'}}</text><text class="handoff-description">{{conversation.mode === 'human' && conversation.ownerAvailable === false ? '你可以结束接续，回到小K继续聊。' : '你可以继续补充资料；小K已暂停自动回复。'}}</text><button class="handoff-return chat-button {{(busy || handoffBusy || pendingSend || pendingAction) ? 'is-disabled' : ''}}" bindtap="endHandoff" disabled="{{busy || handoffBusy || pendingSend || pendingAction}}">{{handoffBusy ? (conversation.mode === 'human' ? '正在结束接续…' : '正在取消等待…') : conversation.mode === 'human' ? '结束接续，回到小K' : '取消等待，回到小K'}}</button></view><button wx:if="{{messageCursor}}" class="older-action chat-button {{(busy) ? 'is-disabled' : ''}}" bindtap="olderMessages" disabled="{{busy}}">查看更早的消息</button>

<block wx:for="{{messages}}" wx:key="id">
<template wx:if="{{item.id === revealingReplyId && item.answerProcess && !staffTab && !professionalFollowup && !ownerSiteReport}}" is="answer-process"
  data="{{process: item.answerProcess, messageId: item.id, expanded: expandedAnswerProcessId === item.id}}"/>
<view wx:if="{{item.id !== revealingReplyId && (!item.replyVersion || (replyVersionChoice['r' + item.replyVersion.root] || item.replyVersion.latest) === item.id)}}" class="message-range">
<view wx:if="{{item.constructionClosure}}" class="message construction-paper-message" id="message-{{item.id}}">
  <template is="construction-closure-card" data="{{receipt: item.constructionClosure, record: item.siteRecordList[0], paths: siteRecordPaths, photoError: siteRecordError}}"/>
</view>
<view wx:elif="{{item.planDecision && planCards[item.planDecision.id].status === 'approved'}}" class="message construction-paper-message" id="message-{{item.id}}">
  <template is="approved-plan-card" data="{{card: planCards[item.planDecision.id], paths: planPaths, busy: planBusy, pending: planPending, disabled: readOnly || fatal}}"/>
</view>
<block wx:else>
  <template wx:if="{{item.answerProcess && !staffTab && !professionalFollowup && !ownerSiteReport}}" is="answer-process"
    data="{{process: item.answerProcess, messageId: item.id, expanded: expandedAnswerProcessId === item.id}}"/>
