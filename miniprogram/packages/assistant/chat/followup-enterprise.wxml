<!-- Approved08 enterprise selector; shared paper sheet/search/list states. -->
<view wx:if="{{followupEnterpriseOpen}}" class="followup-layer" catchtouchmove="swallow"><view class="followup-mask" bindtap="closeFollowupEnterprise"></view><view class="followup-sheet"><view class="followup-grip"></view><button class="followup-close" bindtap="closeFollowupEnterprise" aria-label="关闭企业选择" disabled="{{followupEnterpriseBusy}}"><image src="../assets/x.png"/></button><text class="followup-detail-title">选择企业</text><text class="followup-muted">仅查看所选企业的获权工地</text>
  <view class="followup-enterprise-search"><input value="{{followupEnterpriseQuery}}" maxlength="64" placeholder="查找企业" bindinput="inputFollowupEnterprise" bindconfirm="searchFollowupEnterprises" disabled="{{followupEnterpriseBusy}}"/><button class="followup-text-action" bindtap="searchFollowupEnterprises" disabled="{{followupEnterpriseBusy || followupEnterpriseLoading}}">查找</button></view>
  <scroll-view class="followup-detail-scroll" scroll-y><button wx:for="{{followupEnterprises}}" wx:key="_id" class="followup-setting-row" data-id="{{item._id}}" bindtap="selectFollowupEnterprise" disabled="{{followupEnterpriseBusy}}"><text>{{item.name}}</text><text>›</text></button><text wx:if="{{followupEnterpriseLoading}}" class="followup-muted">正在读取企业…</text><text wx:if="{{!followupEnterpriseLoading && !followupEnterprises.length && !followupEnterpriseError}}" class="followup-muted">没有符合条件的有效企业。</text><button wx:if="{{followupEnterpriseMore}}" class="followup-text-action" bindtap="moreFollowupEnterprises" disabled="{{followupEnterpriseBusy || followupEnterpriseLoading}}">查看更多企业</button><view wx:if="{{followupEnterpriseError}}" class="followup-feedback"><text>{{followupEnterpriseError}}</text><button bindtap="searchFollowupEnterprises" disabled="{{followupEnterpriseBusy}}">重新读取</button></view><text wx:if="{{followupEnterpriseBusy}}" class="followup-muted">正在切换企业…</text></scroll-view>
</view></view>
