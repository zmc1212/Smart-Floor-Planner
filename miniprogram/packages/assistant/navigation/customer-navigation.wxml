<view wx:if="{{!keyboardHidden}}" class="customer-navigation {{floating ? 'customer-floating' : ''}}">
  <view class="tabbar">
    <view wx:for="{{items}}" wx:key="key" class="tab-item tab-key-{{item.key}} {{selected === index ? 'active' : ''}}" data-index="{{index}}" bindtap="switchTab" aria-role="button" aria-label="{{item.text + (item.key === 'service' && reminderBadge ? '，' + reminderBadge + '条未读提醒' : '')}}">
      <view class="tab-icon">
        <image wx:if="{{!floating && selected !== index && item.key !== 'xiaok'}}" class="tab-image" src="../assets/welcome-notebook/dock-{{item.key}}.png" mode="aspectFit" />
        <image wx:elif="{{item.key === 'service'}}" class="tab-image" src="../assets/notebook-tab-home{{selected === index ? '-active' : ''}}.png" mode="aspectFit" />
        <image wx:else class="tab-image" src="/custom-tab-bar/assets/notebook-{{item.key === 'xiaok' ? 'chat' : 'mine'}}{{selected === index ? '-active' : ''}}.png" mode="aspectFit" />
        <view wx:if="{{item.key === 'service' ? reminderBadge : item.badgeText}}" class="tab-badge">{{item.key === 'service' ? reminderBadge : item.badgeText}}</view>
      </view>
      <text class="tab-text">{{item.text}}</text>
    </view>
  </view>
</view>
