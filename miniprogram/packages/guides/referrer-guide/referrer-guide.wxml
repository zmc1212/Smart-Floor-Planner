<!--
THESIS: 推广人第一次进入工作台时，用三步讲清服务码、进度和收益的真实闭环。
OWN-WORLD: 继承家客来明亮薄荷绿和 F1 小 K 角色体系，业务插画独立打包，不使用设计稿切片。
FIRST VIEWPORT: 390x844 下保留原生微信胶囊安全区，标题、插画、说明、步骤和主按钮同屏可见。
FORM: design-references/role-onboarding-v1/referrer-onboarding-v1.png
-->
<view class="guide-page sfp-page">
  <view
    class="guide-nav"
    style="padding-top: {{navigationTop}}px; min-height: {{navigationTop + navigationHeight}}px; padding-right: {{navigationRight}}px;"
  >
    <view class="guide-nav-title">推广人使用引导</view>
  </view>

  <view class="guide-content">
    <swiper
      class="guide-swiper"
      current="{{currentStep}}"
      duration="280"
      easing-function="easeOutCubic"
      indicator-dots="{{false}}"
      autoplay="{{false}}"
      circular="{{false}}"
      bindchange="onSwiperChange"
    >
      <swiper-item wx:for="{{slides}}" wx:key="title">
        <view class="guide-slide">
          <view class="art-stage" aria-hidden="true">
            <view class="art-backdrop art-backdrop-left"></view>
            <view class="art-backdrop art-backdrop-right"></view>
            <image
              class="guide-art {{item.imageClass}}"
              src="{{item.image}}"
              mode="aspectFit"
            />
          </view>
          <view class="guide-copy">
            <view class="guide-title">{{item.title}}</view>
            <text class="guide-description">{{item.description}}</text>
          </view>
          <view wx:if="{{item.assurance}}" class="assurance-pill">
            <image src="/images/mine-icons/shield-check.png" mode="aspectFit" />
            <text>{{item.assurance}}</text>
          </view>
          <view wx:else class="assurance-placeholder" aria-hidden="true"></view>
        </view>
      </swiper-item>
    </swiper>

    <view class="step-dots" aria-label="第 {{currentStep + 1}} 步，共 {{totalSteps}} 步">
      <view
        wx:for="{{steps}}"
        wx:key="*this"
        class="step-dot-hit"
        data-index="{{index}}"
        bindtap="onDotTap"
        aria-label="查看第 {{index + 1}} 步"
      >
        <view class="step-dot {{index === currentStep ? 'active' : ''}}"></view>
      </view>
    </view>

    <button class="primary-action" bindtap="onPrimary" hover-class="primary-action-pressed">
      {{currentStep === totalSteps - 1 ? '去出示服务码' : '下一步'}}
    </button>
    <button class="skip-action" bindtap="onSkip" aria-label="跳过推广人使用引导">跳过</button>
  </view>
</view>
