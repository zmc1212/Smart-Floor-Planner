var stageLabels = {
  reported: '已报备',
  contacted: '已联系',
  measuring: '量房中',
  designing: '设计中',
  quoted: '已报价',
  paid: '已成交',
  closed_lost: '已失效'
};

var ownershipLabels = {
  unassigned: '待分配',
  auto_locked: '系统锁定',
  manually_locked: '人工锁定',
  conflict_pending: '冲突待核'
};

var taskStatusLabels = {
  unassigned: '待分配',
  pending: '待处理',
  assigned: '已分配',
  accepted: '已接收',
  in_progress: '进行中',
  submitted: '已提交',
  completed: '已完成',
  rejected: '已拒绝'
};

var roleLabels = {
  none: '无',
  salesperson: '渠道地推',
  measurer: '测量员',
  designer: '设计师',
  enterprise_admin: '企业负责人',
  admin: '平台负责人',
  super_admin: '平台负责人'
};

var commissionStatusLabels = {
  pending: '待发放',
  pending_settlement: '待结算',
  paid: '已结算',
  voided: '已作废',
  cancelled: '已取消'
};

var commissionTypeLabels = {
  fixed: '固定提成',
  percentage: '比例分成',
  fixed_per_paid_order: '成交订单固定提成'
};

var poolStatusLabels = {
  protected: '保护中',
  in_pool: '公海中',
  claimed: '待审批认领'
};

var timelineTypeLabels = {
  report_created: '创建报备',
  note: '备注',
  follow_up: '跟进记录',
  ownership_assigned: '指派地推',
  pool_released: '释放公海',
  pool_auto_released: '系统释放',
  pool_claimed: '认领成功',
  pool_claim_requested: '申请认领',
  pool_claim_approved: '认领通过',
  pool_claim_rejected: '认领驳回',
  pool_assigned: '公海分配'
};

module.exports = {
  stage: function(key) { return stageLabels[key] || key || ''; },
  ownership: function(key) { return ownershipLabels[key] || key || ''; },
  taskStatus: function(key) { return taskStatusLabels[key] || key || '待分配'; },
  role: function(key) { return roleLabels[key] || key || '无'; },
  commissionStatus: function(key) { return commissionStatusLabels[key] || key || ''; },
  commissionType: function(key) { return commissionTypeLabels[key] || key || ''; },
  poolStatus: function(key) { return poolStatusLabels[key] || key || ''; },
  timelineType: function(key) { return timelineTypeLabels[key] || key || '操作记录'; }
};
