.container {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 130rpx;
}

.filter-bar {
  white-space: nowrap;
  background: var(--bg-surface);
  padding: var(--space-lg) var(--space-section);
  box-shadow: var(--shadow-card);
}

.type-bar {
  margin-top: var(--space-sm);
}

.filter-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 28rpx;
  margin-right: var(--space-lg);
  border-radius: var(--radius-full);
  background: var(--neutral-100);
  color: var(--text-secondary);
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-medium);
}

.filter-item.active {
  background: var(--brand-primary);
  color: var(--text-inverse);
}

.case-list {
  height: calc(100vh - 200rpx);
}

.case-grid {
  padding: var(--space-section);
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-xxl);
}

.case-card {
  background: var(--bg-surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.case-cover-box {
  height: 230rpx;
  position: relative;
  overflow: hidden;
}

.case-cover,
.cover-placeholder {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-surface-soft);
}

.placeholder-text {
  color: var(--text-brand);
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-medium);
}

.case-badge {
  position: absolute;
  top: var(--space-md);
  right: var(--space-md);
  padding: 6rpx 14rpx;
  border-radius: var(--radius-full);
  background: var(--brand-primary);
  color: var(--text-inverse);
  font-size: 20rpx;
}

.case-info {
  padding: var(--space-lg);
}

.case-title {
  display: block;
  color: var(--text-primary);
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
  margin-bottom: var(--space-md);
}

.case-meta,
.case-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
}

.case-tag,
.case-views,
.btn-share {
  color: var(--text-secondary);
  font-size: 22rpx;
}

.case-actions {
  margin-top: var(--space-lg);
}

.btn-copy {
  background: var(--brand-primary);
  color: var(--text-inverse);
  padding: 10rpx 18rpx;
  border-radius: var(--radius-full);
  font-size: 22rpx;
}

.btn-share {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
}

.loading-status,
.empty-state {
  text-align: center;
  color: var(--text-secondary);
  font-size: var(--font-size-caption);
  padding: 60rpx 0;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-lg);
}

.float-lead-btn {
  position: fixed;
  left: var(--space-section);
  right: var(--space-section);
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  height: 88rpx;
  border-radius: var(--radius-full);
  background: var(--brand-primary);
  color: var(--text-inverse);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
  box-shadow: var(--shadow-float);
}
