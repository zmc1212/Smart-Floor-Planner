page {
  background: #000;
}

.survey-page {
  position: fixed;
  inset: 0;
  overflow: hidden;
}


/* ─── 顶部导航浮层 ─── */
.survey-topbar {
  position: absolute;
  left: 16rpx;
  right: 16rpx;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 12rpx 18rpx;
  border-radius: 0 0 24rpx 24rpx;
  background: rgba(255, 255, 255, 0.88);
  backdrop-filter: blur(12px);
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.1);
  box-sizing: border-box;
}

.topbar-left,
.topbar-right,
.title-group {
  display: flex;
  align-items: center;
}

.topbar-left {
  min-width: 0;
  flex: 1;
  gap: 16rpx;
}

.back-button {
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  background: var(--bg-surface-soft);
  color: var(--text-brand);
  font-size: 52rpx;
  line-height: 58rpx;
  text-align: center;
  font-weight: 300;
}

.title-group {
  min-width: 0;
  flex-direction: column;
  align-items: flex-start;
  gap: 4rpx;
}

.page-title {
  max-width: 280rpx;
  color: var(--text-primary);
  font-size: 30rpx;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.page-subtitle {
  color: #7b8794;
  font-size: 21rpx;
  white-space: nowrap;
}

.view-tabs {
  order: 3;
  flex: 1 0 100%;
  justify-content: center;
  flex-shrink: 0;
  gap: 8rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: #f2f7f3;
}

.view-tab,
.topbar-chip {
  height: 54rpx;
  min-width: 72rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #647268;
  font-size: 23rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.view-tab.active {
  color: #ffffff;
  background: #17a14c;
  box-shadow: 0 10rpx 20rpx rgba(17, 164, 66, 0.18);
}

.topbar-actions {
  order: 2;
  flex-shrink: 0;
  gap: 10rpx;
}

.topbar-chip {
  background: #f4f7f4;
}

.topbar-chip.save {
  color: #17a14c;
  background: rgba(34, 197, 94, 0.12);
}

.survey-stage {
  position: relative;
  flex: 1;
  height: auto;
  min-height: 0;
  margin-top: 18rpx;
  margin-left: -22rpx;
  margin-right: -22rpx;
  width: 100vw;
  display: flex;
  gap: 0;
  overflow: hidden;
}

/* ─── 全屏画布 ─── */
.canvas-shell {
  position: fixed;
  inset: 0;
  z-index: 0;
  background: #f8f8f8;
  overflow: hidden;
}

.grid-canvas {
  position: absolute;
  inset: 0;
  background-color: #f8f8f8;
}

.survey-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.compass {
  position: absolute;
  left: 26rpx;
  top: 26rpx;
  z-index: 5;
  width: 86rpx;
  height: 86rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: var(--shadow-float);
  color: #17a14c;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.compass-needle {
  position: absolute;
  width: 4rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #17a14c 0%, rgba(23, 161, 76, 0.15) 100%);
  transform: translateY(-8rpx);
}

.compass text {
  position: absolute;
  top: 8rpx;
}

.measurement-bubble {
  position: absolute;
  left: 50%;
  top: 42rpx;
  z-index: 5;
  transform: translateX(-50%);
  min-width: 300rpx;
  padding: 16rpx 24rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: var(--shadow-float);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.bubble-title {
  color: #17a14c;
  font-size: 22rpx;
  font-weight: 600;
}

.bubble-value {
  color: #4b5563;
  font-size: 24rpx;
  text-align: center;
}

.top-measure-bubble {
  position: absolute;
  left: 50%;
  top: 42rpx;
  z-index: 7;
  transform: translateX(-50%);
  min-width: 180rpx;
  height: 72rpx;
  padding: 0 34rpx;
  border-radius: 999rpx;
  background: rgba(65, 65, 69, 0.92);
  color: #ffffff;
  box-shadow: var(--shadow-float);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.top-measure-angle {
  padding-left: 22rpx;
  border-left: 1px solid rgba(255, 255, 255, 0.22);
}

.closure-action {
  position: absolute;
  z-index: 8;
  width: 68px;
  height: 68px;
  border-radius: 50%;
  background: #f07a21;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 18rpx rgba(240, 122, 33, 0.28);
}

.measure-position {
  position: absolute;
  z-index: 7;
  width: 140px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  pointer-events: auto;
}

.measure-position-tip {
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.96);
  color: #111827;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: var(--shadow-float);
  white-space: nowrap;
}

.measure-side-button {
  width: 76px;
  height: 76px;
  border-radius: 50%;
  background: rgba(65, 65, 69, 0.92);
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 700;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-float);
  pointer-events: auto;
}

.measure-side-line {
  width: 34px;
  height: 6px;
  border-radius: 999px;
  background: #ef4444;
  margin-bottom: 4px;
}

.cursor-anchor {
  position: absolute;
  z-index: 6;
  width: 48px;
  height: 48px;
  opacity: 0;
}

.cursor-line {
  position: absolute;
  background: #f07a21;
  border-radius: 0;
}

.cursor-line.horizontal {
  left: 0;
  right: 0;
  top: 22px;
  height: 4px;
}

.cursor-line.vertical {
  top: 0;
  bottom: 0;
  left: 22px;
  width: 4px;
}

.cursor-core {
  position: absolute;
  left: 14px;
  top: 14px;
  width: 20px;
  height: 20px;
  border-radius: 0;
  background: rgba(240, 122, 33, 0.16);
  border: 2px solid #f07a21;
  box-shadow: none;
  box-sizing: border-box;
}

.close-hint,
.space-summary,
.wall-context {
  position: absolute;
  z-index: 7;
  background: rgba(31, 41, 55, 0.78);
  color: #ffffff;
  box-shadow: var(--shadow-float);
}

.close-hint {
  left: 32rpx;
  bottom: 34rpx;
  max-width: 520rpx;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.close-hint.actionable {
  background: #17a14c;
  font-weight: 600;
}

.space-summary {
  left: 32rpx;
  top: 132rpx;
  padding: 14rpx 20rpx;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 3rpx;
  font-size: 22rpx;
}

.space-area {
  color: #bbf7d0;
  font-size: 28rpx;
  font-weight: 700;
}

.wall-context {
  position: fixed;
  left: 22rpx;
  right: 22rpx;
  bottom: 160rpx;
  z-index: 16;
  width: auto;
  max-width: none;
  padding: 16rpx 18rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.96);
  color: #374151;
  box-sizing: border-box;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.12);
}


.wall-object-toolbar {
  position: absolute;
  z-index: 9;
  height: 36px;
  width: 228px;
  min-width: 228px;
  padding: 4px;
  border-radius: 18px;
  background: rgba(31, 41, 55, 0.94);
  box-shadow: var(--shadow-float);
  display: flex;
  align-items: center;
  gap: 4px;
  box-sizing: border-box;
}

.wall-object-action {
  width: 28px;
  min-width: 28px;
  height: 28px;
  padding: 0;
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.12);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.wall-object-action.primary {
  background: #17a14c;
}

.wall-object-action.muted {
  color: #d1d5db;
  background: rgba(255, 255, 255, 0.08);
}

.wall-object-action.delete {
  background: rgba(239, 68, 68, 0.25);
  color: #f87171;
}

.delete-lid {
  position: absolute;
  left: 5px;
  top: 5px;
  width: 14px;
  height: 2px;
  background: currentColor;
  border-radius: 1px;
}

.delete-body {
  position: absolute;
  left: 7px;
  top: 9px;
  width: 10px;
  height: 10px;
  border: 1.8px solid currentColor;
  border-top: none;
  box-sizing: border-box;
  border-radius: 0 0 2px 2px;
}

.side-wall-line {
  position: absolute;
  left: 11px;
  top: 4px;
  width: 2px;
  height: 16px;
  background: currentColor;
}

.side-dot-left {
  position: absolute;
  left: 4px;
  top: 10px;
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: currentColor;
}

.side-dot-right {
  position: absolute;
  right: 4px;
  top: 10px;
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: currentColor;
  opacity: 0.3;
}

.wall-action-icon {
  position: relative;
  width: 24px;
  height: 24px;
  transform: scale(0.7);
  transform-origin: center;
}

.door-frame {
  position: absolute;
  left: 6px;
  top: 4px;
  width: 11px;
  height: 16px;
  border: 2px solid currentColor;
  border-bottom: none;
  box-sizing: border-box;
}

.door-swing {
  position: absolute;
  left: 6px;
  top: 7px;
  width: 14px;
  height: 14px;
  border: 2px solid currentColor;
  border-top-color: transparent;
  border-left-color: transparent;
  border-radius: 0 0 14px 0;
  transform: rotate(-8deg);
  box-sizing: border-box;
}

.window-frame {
  position: absolute;
  left: 4px;
  top: 7px;
  width: 16px;
  height: 10px;
  border: 2px solid currentColor;
  box-sizing: border-box;
}

.window-line {
  position: absolute;
  left: 11px;
  top: 7px;
  width: 2px;
  height: 10px;
  background: currentColor;
}

.edit-stem {
  position: absolute;
  left: 11px;
  top: 3px;
  width: 4px;
  height: 17px;
  border-radius: 3px;
  background: currentColor;
  transform: rotate(42deg);
}

.edit-tip {
  position: absolute;
  left: 5px;
  top: 16px;
  width: 8px;
  height: 3px;
  border-radius: 999rpx;
  background: currentColor;
  transform: rotate(42deg);
}


.remeasure-ruler {
  position: absolute;
  left: 3px;
  top: 9px;
  width: 18px;
  height: 6px;
  border: 1.8px solid currentColor;
  box-sizing: border-box;
  border-radius: 1px;
}

.remeasure-tick {
  position: absolute;
  top: 9px;
  width: 1.5px;
  height: 3px;
  background: currentColor;
}

.remeasure-tick.one {
  left: 7px;
}

.remeasure-tick.two {
  left: 11px;
}

.remeasure-tick.three {
  left: 15px;
}

.exit-line {
  position: absolute;
  left: 5px;
  top: 11px;
  width: 14px;
  height: 2px;
  border-radius: 999rpx;
  background: currentColor;
}

.exit-line.one {
  transform: rotate(45deg);
}

.exit-line.two {
  transform: rotate(-45deg);
}

.wall-context-title {
  color: #17a14c;
  font-size: 24rpx;
  font-weight: 700;
}

.wall-context-meta,
.wall-context-actions {
  display: flex;
  align-items: center;
}

.wall-context-meta {
  gap: 12rpx;
  margin-top: 8rpx;
  color: #647268;
  font-size: 22rpx;
  flex-wrap: wrap;
}

.wall-context-actions {
  gap: 8rpx;
  margin-top: 14rpx;
  flex-wrap: wrap;
}

.context-action {
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: #edf7ef;
  color: #17a14c;
  font-size: 22rpx;
  font-weight: 600;
}

.context-action.primary {
  color: #ffffff;
  background: #17a14c;
}

.context-action.muted {
  color: #6b7280;
  background: #f3f4f6;
}

.opening-context {
  width: 100%;
  padding: 12rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.97);
  color: #111827;
  box-shadow: var(--shadow-home-card);
  box-sizing: border-box;
  border: 1px solid rgba(148, 163, 184, 0.22);
}

.opening-context.door {
  border-color: rgba(240, 122, 33, 0.28);
}

.opening-context.window {
  border-color: rgba(14, 165, 233, 0.3);
}

.opening-title {
  display: block;
  color: #111827;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.2;
}

.opening-context.door .opening-title {
  color: #c4550f;
}

.opening-context.window .opening-title {
  color: #0369a1;
}

.opening-fields {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-top: 10rpx;
}

.opening-field {
  padding: 8rpx 10rpx;
  border-radius: 12rpx;
  background: #f3f7f4;
  color: #374151;
  font-size: 19rpx;
  font-weight: 600;
  line-height: 1.25;
}

.opening-context.door .opening-field {
  background: #fff7ed;
  color: #9a3412;
}

.opening-context.window .opening-field {
  background: #eff8ff;
  color: #075985;
}

.undo-redo {
  position: absolute;
  right: 26rpx;
  bottom: 28rpx;
  z-index: 8;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.round-action {
  width: 82rpx;
  height: 82rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: var(--shadow-float);
  color: #4b5563;
  font-size: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
}

.history-count {
  color: #17a14c;
  font-size: 18rpx;
  font-weight: 700;
}

/* ─── 右侧工具栏 ─── */
.right-rail {
  position: fixed;
  right: 18rpx;
  top: 200rpx;
  bottom: 160rpx;
  z-index: 15;
  width: 136rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  overflow-y: auto;
  padding-bottom: 12rpx;
  box-sizing: border-box;
  pointer-events: none;
}

.right-rail > .tool-group:not(.reserved-tools),
.right-rail > .side-switch,
.right-rail > .opening-context {
  pointer-events: auto;
}


.tool-group,
.side-switch {
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: var(--shadow-home-card);
  padding: 10rpx;
  box-sizing: border-box;
}

.tool-button,
.reserved-button,
.side-switch {
  display: flex;
  align-items: center;
  justify-content: center;
}

.tool-button {
  min-height: 74rpx;
  margin-bottom: 8rpx;
  border-radius: 18rpx;
  color: #5f6e65;
  background: #f5f8f5;
  flex-direction: column;
  gap: 4rpx;
}

.tool-button:last-child {
  margin-bottom: 0;
}

.tool-button.active {
  background: #17a14c;
  color: #ffffff;
  box-shadow: 0 10rpx 20rpx rgba(17, 164, 66, 0.18);
}

.object-tools .tool-button:first-child {
  background: #17a14c;
  color: #ffffff;
}

.tool-label {
  font-size: 23rpx;
  font-weight: 600;
}

.tool-helper {
  font-size: 16rpx;
  opacity: 0.75;
}

.side-switch {
  min-height: 82rpx;
  flex-direction: column;
  gap: 6rpx;
}

.side-label {
  color: #7b8794;
  font-size: 20rpx;
}

.side-value {
  color: #17a14c;
  font-size: 24rpx;
  font-weight: 600;
}

.reserved-tools {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8rpx;
}

.reserved-button {
  min-height: 50rpx;
  border-radius: 16rpx;
  background: #f5f6f5;
  color: #9aa3ad;
  font-size: 18rpx;
}

.bottom-controls {
  position: absolute;
  left: 0;
  right: auto;
  bottom: 16rpx;
  width: 100vw;
  height: 72rpx;
  gap: 8rpx;
  padding: 8rpx 14rpx;
  border-radius: 20rpx 20rpx 0 0;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: var(--shadow-float);
  box-sizing: border-box;
  z-index: 12;
}

.bottom-reset-cursor {
  position: absolute;
  right: 22rpx;
  z-index: 13;
  height: 68rpx;
  min-width: 160rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: rgba(31, 41, 55, 0.88);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.22);
  box-sizing: border-box;
}

.reset-cursor-label {
  font-size: 22rpx;
  font-weight: 600;
  color: #ffffff;
  white-space: nowrap;
}

.mode-pill {
  flex-shrink: 0;
  height: 54rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #17a14c;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
}

.bottom-action {
  flex: 1;
  min-width: 0;
  height: 54rpx;
  border-radius: 18rpx;
  background: #f4f8f4;
  flex-direction: column;
  justify-content: center;
  gap: 1rpx;
}

.bottom-action.active {
  background: rgba(23, 161, 76, 0.12);
  box-shadow: inset 0 0 0 2rpx rgba(23, 161, 76, 0.18);
}

.bottom-title {
  color: #374151;
  font-size: 21rpx;
  font-weight: 600;
}

.bottom-action.active .bottom-title {
  color: #17a14c;
}

.bottom-subtitle {
  color: #8a949f;
  font-size: 16rpx;
}

.bottom-action.active .bottom-subtitle {
  color: #2f7d4a;
}

.component-editor {
  position: fixed;
  inset: 0;
  z-index: 50;
  background: #ffffff;
  overflow: hidden;
}

.component-topbar {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  z-index: 12;
  height: 132rpx;
  padding: 20rpx 28rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  pointer-events: none;
}

.component-back,
.component-lock {
  position: relative;
  z-index: 2;
  pointer-events: auto;
  width: 74rpx;
  height: 74rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.98);
  color: #4b5563;
  box-shadow: var(--shadow-float);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
}

.back-icon {
  width: 32rpx;
  height: 32rpx;
}

.component-lock {
  font-size: 28rpx;
}

.component-title {
  color: #1f2937;
  font-size: 38rpx;
  font-weight: 600;
}

.component-webgl {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  width: 100%;
  height: calc(100% - 620rpx - env(safe-area-inset-bottom));
  background: #ffffff;
}

.entry-door-action {
  position: absolute;
  left: 28rpx;
  bottom: 500rpx;
  z-index: 4;
  min-width: 188rpx;
  height: 76rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #3b82f6;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 14rpx 28rpx rgba(59, 130, 246, 0.26);
  box-sizing: border-box;
}

.component-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 5;
  height: calc(620rpx + env(safe-area-inset-bottom));
  padding: 26rpx 22rpx calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 30rpx 30rpx 0 0;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -12rpx 30rpx rgba(15, 23, 42, 0.1);
  box-sizing: border-box;
}

.component-panel-tabs {
  display: flex;
  justify-content: center;
  gap: 80rpx;
  margin-bottom: 28rpx;
}

.component-panel-tab {
  position: relative;
  color: #4b5563;
  font-size: 25rpx;
  font-weight: 600;
  padding-bottom: 12rpx;
}

.component-panel-tab.active {
  color: #e2702e;
}

.component-panel-tab.active::after,
.component-spec-tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 42rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: #e2702e;
  transform: translateX(-50%);
}

.component-spec-tabs {
  display: flex;
  justify-content: space-between;
  gap: 14rpx;
}

.component-spec-tab {
  position: relative;
  flex: 1;
  padding-bottom: 16rpx;
  color: #1f2937;
  font-size: 29rpx;
  font-weight: 600;
  text-align: center;
}

.component-spec-tab.active {
  color: #e2702e;
}

.component-value-row {
  margin-top: 26rpx;
  height: 80rpx;
  padding: 0 22rpx;
  border-radius: 10rpx;
  background: #f8fafc;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.component-value {
  flex: 1;
  color: #e2702e;
  font-size: 44rpx;
  font-weight: 700;
  text-align: center;
}

.component-unit,
.component-edit-hint,
.component-note {
  color: #9ca3af;
  font-size: 24rpx;
}

.component-edit-hint {
  color: #6b7280;
}

.component-spec-display {
  margin-top: 14rpx;
  height: 68rpx;
  border-radius: 12rpx;
  background: #f8fafc;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.component-spec-val {
  color: #e2702e;
  font-size: 38rpx;
  font-weight: 700;
}

.component-spec-unit {
  color: #9ca3af;
  font-size: 22rpx;
  font-weight: 600;
}

.component-spec-keyboard {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  margin-top: 16rpx;
}

.keyboard-key {
  height: 70rpx;
  border-radius: 16rpx;
  background: #f8faf8;
  color: #111827;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0px 0px 0px 1rpx rgba(17, 24, 39, 0.05);
}

.keyboard-key:active {
  background: #e2e8f0;
}

.keyboard-key.utility {
  color: #647268;
  font-size: 23rpx;
  font-weight: 600;
}

.component-sync-row {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #4b5563;
  font-size: 24rpx;
}

.sync-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 4rpx solid #9ca3af;
  box-sizing: border-box;
}

.sync-dot.active {
  border-color: #e2702e;
  background: #e2702e;
}

.component-flip {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.flip-card {
  height: 116rpx;
  border-radius: 18rpx;
  background: #f3f4f6;
  color: #374151;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.flip-card.active {
  color: #ffffff;
  background: #e2702e;
}

.component-note {
  grid-column: 1 / -1;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #fff7ed;
  color: #9a3412;
}

.library-toolbar,
.category-row,
.library-grid {
  display: flex;
}

.library-toolbar {
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
}

.library-type,
.library-source,
.category-chip {
  border-radius: 14rpx;
  background: #f3f4f6;
  color: #374151;
  font-size: 25rpx;
  font-weight: 600;
}

.library-type,
.library-source {
  padding: 18rpx 22rpx;
}

.library-source {
  color: #4b5563;
}

.category-row {
  margin-top: 18rpx;
  gap: 12rpx;
  overflow-x: auto;
}

.category-chip {
  flex: 0 0 auto;
  padding: 14rpx 24rpx;
}

.category-chip.active {
  color: #e2702e;
  background: #fff7ed;
  box-shadow: inset 0 0 0 2rpx rgba(226, 112, 46, 0.45);
}

.library-grid {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
  max-height: 260rpx;
  overflow-y: auto;
}

.library-item {
  position: relative;
  min-height: 142rpx;
  padding: 12rpx;
  border-radius: 18rpx;
  background: #f8fafc;
  color: #374151;
  font-size: 21rpx;
  font-weight: 600;
  text-align: center;
  box-sizing: border-box;
}

.library-item.active {
  box-shadow: inset 0 0 0 3rpx #e2702e;
}

.library-thumb {
  height: 82rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
  border: 1px solid rgba(17, 24, 39, 0.08);
}

.library-check {
  position: absolute;
  right: 0;
  top: 0;
  width: 46rpx;
  height: 46rpx;
  border-radius: 0 18rpx 0 18rpx;
  background: #e2702e;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
}

.number-pad-mask {
  position: fixed;
  inset: 0;
  z-index: 60;
  background: rgba(15, 23, 42, 0.18);
}

.number-pad-panel {
  position: fixed;
  left: 22rpx;
  right: 22rpx;
  bottom: 22rpx;
  z-index: 61;
  padding: 22rpx;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: var(--shadow-float);
  box-sizing: border-box;
}

.number-pad-header {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.number-pad-title,
.number-pad-subtitle {
  display: block;
}

.number-pad-title {
  color: #111827;
  font-size: 30rpx;
  font-weight: 700;
}

.number-pad-subtitle {
  margin-top: 4rpx;
  color: #6b7280;
  font-size: 22rpx;
}

.number-pad-close {
  color: #6b7280;
  font-size: 24rpx;
  padding: 10rpx 16rpx;
}

.number-display {
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  background: #f4f8f4;
  color: #17a14c;
  font-size: 42rpx;
  font-weight: 800;
  text-align: right;
}

.number-display text {
  margin-left: 8rpx;
  color: #6b7280;
  font-size: 24rpx;
  font-weight: 600;
}

.number-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 18rpx;
}

.number-key {
  height: 78rpx;
  border-radius: 22rpx;
  background: #f8faf8;
  color: #111827;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.number-key.utility {
  color: #647268;
  font-size: 24rpx;
  font-weight: 600;
}

.number-confirm {
  margin-top: 16rpx;
  height: 76rpx;
  border-radius: 24rpx;
  color: #ffffff;
  background: #17a14c;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.disabled {
  opacity: 0.58;
}

.dimension-overlay-label {
  position: absolute;
  font-family: monospace;
  font-size: 20rpx;
  color: #171717;
  font-weight: 600;
  padding: 4rpx 10rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 1px solid rgba(17, 24, 39, 0.08);
  border-radius: 6rpx;
  box-shadow: 0px 0px 0px 1px rgba(0,0,0,0.08), 0 2px 4px rgba(0,0,0,0.04);
  pointer-events: none;
  z-index: 99;
}

.dimension-overlay-label.active {
  color: #e12d2d;
  background: rgba(254, 242, 242, 0.95);
  border-color: rgba(239, 68, 68, 0.35);
  box-shadow: 0px 0px 0px 1px rgba(239, 68, 68, 0.15), 0 2px 4px rgba(225, 45, 45, 0.08);
}

/* ════════════════════════════════════════
   顶部右侧按钮组
════════════════════════════════════════ */
.topbar-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

/* ════════════════════════════════════════
   底部圆形图标浮动按钮 (FAB)
════════════════════════════════════════ */
.bottom-fab-bar {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 18;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 0 28rpx;
}

/* 通用圆形按钮 */
.fab-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

/* 绿色主色大圆 */
.fab-btn.fab-primary .fab-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #17a14c;
  box-shadow: 0 12rpx 28rpx rgba(23, 161, 76, 0.36);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

/* 灰色空心圆 */
.fab-btn.fab-secondary .fab-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.14), 0 0 0 1.5rpx rgba(15, 23, 42, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.fab-btn.fab-dimmed .fab-icon {
  opacity: 0.5;
}

/* 加号按钮也是绿色大圆 */
.fab-btn.fab-plus .fab-icon {
  background: #17a14c;
}

/* 子标签（光标拖动到墙体） */
.fab-sublabel {
  color: #4b5563;
  font-size: 18rpx;
  text-align: center;
  white-space: nowrap;
  margin-top: 2rpx;
}

/* ─ 测量图标 ─ */
.fab-icon-measure {
  position: relative;
}

.measure-line-h {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  top: 50%;
  height: 3rpx;
  background: rgba(255,255,255,0.9);
  transform: translateY(-50%);
  border-radius: 2rpx;
}

.measure-line-v {
  position: absolute;
  top: 18rpx;
  bottom: 18rpx;
  left: 50%;
  width: 3rpx;
  background: rgba(255,255,255,0.9);
  transform: translateX(-50%);
  border-radius: 2rpx;
}

.measure-corner {
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  border: 3rpx solid rgba(255,255,255,0.9);
  box-sizing: border-box;
}

.measure-corner.tl {
  top: 18rpx;
  left: 18rpx;
  border-right: none;
  border-bottom: none;
  border-radius: 2rpx 0 0 0;
}

.measure-corner.br {
  bottom: 18rpx;
  right: 18rpx;
  border-left: none;
  border-top: none;
  border-radius: 0 0 2rpx 0;
}

/* ─ 蓝牙图标 ─ */
.fab-icon-bluetooth {
  position: relative;
}

.bt-stem {
  position: absolute;
  left: 50%;
  top: 14rpx;
  bottom: 14rpx;
  width: 3rpx;
  background: #4b5563;
  transform: translateX(-50%);
  border-radius: 2rpx;
}

.bt-bar {
  position: absolute;
  width: 20rpx;
  height: 3rpx;
  background: #4b5563;
  border-radius: 2rpx;
  left: 50%;
}

.bt-bar.top {
  top: 22rpx;
  transform: translateX(0) rotate(45deg);
  transform-origin: left center;
}

.bt-bar.bottom {
  bottom: 22rpx;
  transform: translateX(0) rotate(-45deg);
  transform-origin: left center;
}

.bt-dot {
  position: absolute;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #4b5563;
}

.bt-dot.left {
  left: 18rpx;
  top: 50%;
  transform: translateY(-8rpx);
}

.bt-dot.right {
  left: 18rpx;
  top: 50%;
  transform: translateY(2rpx);
}

/* ─ 光标图标 ─ */
.fab-icon-cursor {
  position: relative;
}

.cursor-cross-h {
  position: absolute;
  left: 14rpx;
  right: 14rpx;
  top: 50%;
  height: 2rpx;
  background: #f07a21;
  transform: translateY(-50%);
  border-radius: 1rpx;
}

.cursor-cross-v {
  position: absolute;
  top: 14rpx;
  bottom: 14rpx;
  left: 50%;
  width: 2rpx;
  background: #f07a21;
  transform: translateX(-50%);
  border-radius: 1rpx;
}

.cursor-box {
  position: absolute;
  width: 22rpx;
  height: 22rpx;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  border: 2rpx solid #f07a21;
  background: rgba(240, 122, 33, 0.12);
  box-sizing: border-box;
}

/* ─ 加号图标 ─ */
.plus-h {
  position: absolute;
  left: 22rpx;
  right: 22rpx;
  top: 50%;
  height: 4rpx;
  background: #ffffff;
  transform: translateY(-50%);
  border-radius: 2rpx;
}

.plus-v {
  position: absolute;
  top: 22rpx;
  bottom: 22rpx;
  left: 50%;
  width: 4rpx;
  background: #ffffff;
  transform: translateX(-50%);
  border-radius: 2rpx;
}

/* ════════════════════════════════════════
   手输 mm 激活悬浮按钮
════════════════════════════════════════ */
.manual-fab {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  z-index: 19;
  height: 72rpx;
  min-width: 220rpx;
  padding: 0 36rpx;
  border-radius: 999rpx;
  background: #17a14c;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  box-shadow: 0 12rpx 28rpx rgba(23, 161, 76, 0.32);
}

.manual-fab-label {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

.manual-fab-sub {
  color: rgba(255,255,255,0.78);
  font-size: 18rpx;
}

/* ─ 去掉旧的 bottom-controls / bottom-reset-cursor ─ */
.bottom-controls,
.bottom-reset-cursor,
.reset-cursor-label,
.bottom-action,
.bottom-title,
.bottom-subtitle,
.mode-pill {
  display: none;
}

/* ─ survey-stage 旧布局清除 ─ */
.survey-stage {
  display: none;
}

/* ════════════════════════════════════════
   新建光标 FAB 按钮（底部唯一按钮）
════════════════════════════════════════ */
/* 覆盖 bottom-fab-bar 为居中单按钮 */
.bottom-fab-bar {
  justify-content: center;
}

.fab-new-cursor {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.fab-new-cursor-icon {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #17a14c;
  box-shadow: 0 14rpx 32rpx rgba(23, 161, 76, 0.38);
}

/* 十字横线 */
.nc-h {
  position: absolute;
  left: 22rpx;
  right: 22rpx;
  top: 50%;
  height: 3rpx;
  background: #ffffff;
  transform: translateY(-50%);
  border-radius: 2rpx;
}

/* 十字竖线 */
.nc-v {
  position: absolute;
  top: 22rpx;
  bottom: 22rpx;
  left: 50%;
  width: 3rpx;
  background: #ffffff;
  transform: translateX(-50%);
  border-radius: 2rpx;
}

/* 中心小圆环 */
.nc-ring {
  position: absolute;
  width: 28rpx;
  height: 28rpx;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  border: 3rpx solid #ffffff;
  border-radius: 50%;
  box-sizing: border-box;
}

.fab-new-cursor-label {
  color: #374151;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

/* ════════════════════════════════════════
   拖拽放置光标覆盖层
════════════════════════════════════════ */
.cursor-drag-overlay {
  position: fixed;
  inset: 0;
  z-index: 30;
  background: rgba(15, 23, 42, 0.35);
}

/* 顶部提示 + 取消 */
.cursor-drag-hint-bar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  padding: 24rpx 28rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(15, 23, 42, 0.72);
  box-sizing: border-box;
}

.cursor-drag-hint-text {
  color: rgba(255, 255, 255, 0.9);
  font-size: 24rpx;
  flex: 1;
}

.cursor-drag-cancel {
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  margin-left: 24rpx;
  flex-shrink: 0;
}

/* 跟随手指的光标标记（以手指位置为圆心） */
.cursor-drag-marker {
  position: absolute;
  width: 0;
  height: 0;
  /* 通过负 margin 让中心对齐手指位置 */
  pointer-events: none;
}

/* 外圆环 */
.cdm-ring-outer {
  position: absolute;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.6);
  background: transparent;
  transform: translate(-50%, -50%);
  box-sizing: border-box;
}

/* 内圆 */
.cdm-ring-inner {
  position: absolute;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #f07a21;
  transform: translate(-50%, -50%);
  box-shadow: 0 0 0 3rpx rgba(240, 122, 33, 0.4);
}

/* 横向准星线 */
.cdm-cross-h {
  position: absolute;
  width: 120rpx;
  height: 2rpx;
  background: rgba(240, 122, 33, 0.85);
  transform: translate(-50%, -50%);
  border-radius: 1rpx;
}

/* 纵向准星线 */
.cdm-cross-v {
  position: absolute;
  width: 2rpx;
  height: 120rpx;
  background: rgba(240, 122, 33, 0.85);
  transform: translate(-50%, -50%);
  border-radius: 1rpx;
}


