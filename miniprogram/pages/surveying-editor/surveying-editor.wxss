page {
  background: #eef3ef;
}

.survey-page {
  position: relative;
  min-height: 100vh;
  padding: 22rpx 22rpx 118rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 18% 14%, rgba(168, 230, 207, 0.38) 0%, rgba(168, 230, 207, 0) 30%),
    linear-gradient(180deg, #fbfdfb 0%, #eef4ef 100%);
  overflow: hidden;
}

.survey-topbar {
  height: 108rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: var(--shadow-home-card);
  box-sizing: border-box;
}

.topbar-left,
.view-tabs,
.topbar-actions,
.bottom-controls,
.bottom-action,
.title-group {
  display: flex;
  align-items: center;
}

.topbar-left {
  min-width: 0;
  flex: 1;
  gap: 16rpx;
}

.back-button {
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  background: var(--bg-surface-soft);
  color: var(--text-brand);
  font-size: 52rpx;
  line-height: 58rpx;
  text-align: center;
  font-weight: 300;
}

.title-group {
  min-width: 0;
  flex-direction: column;
  align-items: flex-start;
  gap: 4rpx;
}

.page-title {
  max-width: 280rpx;
  color: var(--text-primary);
  font-size: 30rpx;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.page-subtitle {
  color: #7b8794;
  font-size: 21rpx;
  white-space: nowrap;
}

.view-tabs {
  flex-shrink: 0;
  gap: 8rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: #f2f7f3;
}

.view-tab,
.topbar-chip {
  height: 54rpx;
  min-width: 72rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #647268;
  font-size: 23rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.view-tab.active {
  color: #ffffff;
  background: #17a14c;
  box-shadow: 0 10rpx 20rpx rgba(17, 164, 66, 0.18);
}

.topbar-actions {
  flex-shrink: 0;
  gap: 10rpx;
}

.topbar-chip {
  background: #f4f7f4;
}

.topbar-chip.save {
  color: #17a14c;
  background: rgba(34, 197, 94, 0.12);
}

.survey-stage {
  height: calc(100vh - 250rpx);
  min-height: 720rpx;
  margin-top: 18rpx;
  display: flex;
  gap: 18rpx;
}

.canvas-shell {
  position: relative;
  flex: 1;
  min-width: 0;
  border-radius: 30rpx;
  overflow: hidden;
  background: #ffffff;
  box-shadow: var(--shadow-home-card);
}

.grid-canvas {
  position: absolute;
  inset: 0;
  background-color: #f8fbf8;
  background-image:
    linear-gradient(rgba(137, 157, 141, 0.12) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(137, 157, 141, 0.12) 1rpx, transparent 1rpx),
    linear-gradient(rgba(34, 197, 94, 0.12) 2rpx, transparent 2rpx),
    linear-gradient(90deg, rgba(34, 197, 94, 0.12) 2rpx, transparent 2rpx);
  background-size: 42rpx 42rpx, 42rpx 42rpx, 210rpx 210rpx, 210rpx 210rpx;
}

.origin-axis {
  position: absolute;
  background: rgba(31, 41, 55, 0.08);
  pointer-events: none;
}

.x-axis {
  left: 0;
  right: 0;
  top: 50%;
  height: 2rpx;
}

.y-axis {
  top: 0;
  bottom: 0;
  left: 50%;
  width: 2rpx;
}

.compass {
  position: absolute;
  left: 26rpx;
  top: 26rpx;
  z-index: 5;
  width: 86rpx;
  height: 86rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: var(--shadow-float);
  color: #17a14c;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.compass-needle {
  position: absolute;
  width: 4rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #17a14c 0%, rgba(23, 161, 76, 0.15) 100%);
  transform: translateY(-8rpx);
}

.compass text {
  position: absolute;
  top: 8rpx;
}

.measurement-bubble {
  position: absolute;
  left: 50%;
  top: 42rpx;
  z-index: 5;
  transform: translateX(-50%);
  min-width: 300rpx;
  padding: 16rpx 24rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: var(--shadow-float);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.bubble-title {
  color: #17a14c;
  font-size: 22rpx;
  font-weight: 600;
}

.bubble-value {
  color: #4b5563;
  font-size: 24rpx;
  text-align: center;
}

.wall-render {
  position: absolute;
  z-index: 2;
  height: 80px;
  transform-origin: left center;
}

.wall-render.preview {
  z-index: 3;
}

.wall-render.selected {
  z-index: 4;
}

.wall-body {
  position: absolute;
  left: 0;
  width: 100%;
  border-radius: 8px;
  background: rgba(85, 98, 94, 0.28);
  box-shadow: inset 0 0 0 1px rgba(55, 65, 81, 0.08);
}

.wall-render.selected .wall-body {
  background: rgba(34, 197, 94, 0.28);
  box-shadow: inset 0 0 0 2px rgba(23, 161, 76, 0.28);
}

.preview-body {
  background: rgba(245, 158, 11, 0.2);
  border: 1px dashed rgba(245, 158, 11, 0.7);
}

.wall-redline {
  position: absolute;
  left: 0;
  right: 0;
  top: 38px;
  height: 4px;
  border-radius: 999px;
  background: #ef4444;
  box-shadow: 0 0 0 4rpx rgba(239, 68, 68, 0.08);
}

.preview-line {
  background: #f97316;
}

.wall-length {
  position: absolute;
  top: 0;
  transform: translateX(-50%);
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.96);
  color: #ef4444;
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
  box-shadow: 0 6rpx 14rpx rgba(31, 41, 55, 0.08);
}

.preview-label {
  color: #f97316;
}

.cursor-anchor {
  position: absolute;
  z-index: 6;
  width: 48rpx;
  height: 48rpx;
}

.cursor-line {
  position: absolute;
  background: #f59e0b;
  border-radius: 999rpx;
}

.cursor-line.horizontal {
  left: 0;
  right: 0;
  top: 22rpx;
  height: 4rpx;
}

.cursor-line.vertical {
  top: 0;
  bottom: 0;
  left: 22rpx;
  width: 4rpx;
}

.cursor-core {
  position: absolute;
  left: 14rpx;
  top: 14rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #f59e0b;
  box-shadow: 0 0 0 8rpx rgba(245, 158, 11, 0.16);
}

.close-hint,
.space-summary,
.wall-context {
  position: absolute;
  z-index: 7;
  background: rgba(31, 41, 55, 0.78);
  color: #ffffff;
  box-shadow: var(--shadow-float);
}

.close-hint {
  left: 32rpx;
  bottom: 34rpx;
  max-width: 520rpx;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.close-hint.actionable {
  background: #17a14c;
  font-weight: 600;
}

.space-summary {
  left: 32rpx;
  top: 132rpx;
  padding: 14rpx 20rpx;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 3rpx;
  font-size: 22rpx;
}

.space-area {
  color: #bbf7d0;
  font-size: 28rpx;
  font-weight: 700;
}

.wall-context {
  left: 32rpx;
  right: 120rpx;
  bottom: 34rpx;
  padding: 18rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  color: #374151;
}

.wall-context-title {
  color: #17a14c;
  font-size: 24rpx;
  font-weight: 700;
}

.wall-context-meta,
.wall-context-actions {
  display: flex;
  align-items: center;
}

.wall-context-meta {
  gap: 12rpx;
  margin-top: 8rpx;
  color: #647268;
  font-size: 22rpx;
  flex-wrap: wrap;
}

.wall-context-actions {
  gap: 10rpx;
  margin-top: 14rpx;
}

.context-action {
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: #edf7ef;
  color: #17a14c;
  font-size: 22rpx;
  font-weight: 600;
}

.context-action.primary {
  color: #ffffff;
  background: #17a14c;
}

.context-action.muted {
  color: #6b7280;
  background: #f3f4f6;
}

.undo-redo {
  position: absolute;
  right: 26rpx;
  bottom: 28rpx;
  z-index: 8;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.round-action {
  width: 82rpx;
  height: 82rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: var(--shadow-float);
  color: #4b5563;
  font-size: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
}

.history-count {
  color: #17a14c;
  font-size: 18rpx;
  font-weight: 700;
}

.right-rail {
  width: 150rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.tool-group,
.side-switch {
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: var(--shadow-home-card);
  padding: 12rpx;
  box-sizing: border-box;
}

.tool-button,
.reserved-button,
.side-switch {
  display: flex;
  align-items: center;
  justify-content: center;
}

.tool-button {
  min-height: 86rpx;
  margin-bottom: 10rpx;
  border-radius: 20rpx;
  color: #5f6e65;
  background: #f5f8f5;
  flex-direction: column;
  gap: 4rpx;
}

.tool-button:last-child {
  margin-bottom: 0;
}

.tool-button.active {
  background: #17a14c;
  color: #ffffff;
  box-shadow: 0 10rpx 20rpx rgba(17, 164, 66, 0.18);
}

.tool-label {
  font-size: 25rpx;
  font-weight: 600;
}

.tool-helper {
  font-size: 18rpx;
  opacity: 0.75;
}

.side-switch {
  min-height: 96rpx;
  flex-direction: column;
  gap: 6rpx;
}

.side-label {
  color: #7b8794;
  font-size: 20rpx;
}

.side-value {
  color: #17a14c;
  font-size: 24rpx;
  font-weight: 600;
}

.reserved-tools {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8rpx;
}

.reserved-button {
  min-height: 58rpx;
  border-radius: 18rpx;
  background: #f5f6f5;
  color: #9aa3ad;
  font-size: 20rpx;
}

.bottom-controls {
  position: absolute;
  left: 22rpx;
  right: 22rpx;
  bottom: 24rpx;
  height: 86rpx;
  gap: 12rpx;
  padding: 12rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: var(--shadow-float);
  box-sizing: border-box;
  z-index: 12;
}

.mode-pill {
  flex-shrink: 0;
  height: 62rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #17a14c;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
}

.bottom-action {
  flex: 1;
  min-width: 0;
  height: 62rpx;
  border-radius: 22rpx;
  background: #f4f8f4;
  flex-direction: column;
  justify-content: center;
  gap: 3rpx;
}

.bottom-title {
  color: #374151;
  font-size: 23rpx;
  font-weight: 600;
}

.bottom-subtitle {
  color: #8a949f;
  font-size: 18rpx;
}

.number-pad-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  background: rgba(15, 23, 42, 0.18);
}

.number-pad-panel {
  position: fixed;
  left: 22rpx;
  right: 22rpx;
  bottom: 22rpx;
  z-index: 21;
  padding: 22rpx;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: var(--shadow-float);
  box-sizing: border-box;
}

.number-pad-header {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.number-pad-title,
.number-pad-subtitle {
  display: block;
}

.number-pad-title {
  color: #111827;
  font-size: 30rpx;
  font-weight: 700;
}

.number-pad-subtitle {
  margin-top: 4rpx;
  color: #6b7280;
  font-size: 22rpx;
}

.number-pad-close {
  color: #6b7280;
  font-size: 24rpx;
  padding: 10rpx 16rpx;
}

.number-display {
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  background: #f4f8f4;
  color: #17a14c;
  font-size: 42rpx;
  font-weight: 800;
  text-align: right;
}

.number-display text {
  margin-left: 8rpx;
  color: #6b7280;
  font-size: 24rpx;
  font-weight: 600;
}

.number-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 18rpx;
}

.number-key {
  height: 78rpx;
  border-radius: 22rpx;
  background: #f8faf8;
  color: #111827;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.number-key.utility {
  color: #647268;
  font-size: 24rpx;
  font-weight: 600;
}

.number-confirm {
  margin-top: 16rpx;
  height: 76rpx;
  border-radius: 24rpx;
  color: #ffffff;
  background: #17a14c;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.disabled {
  opacity: 0.58;
}
