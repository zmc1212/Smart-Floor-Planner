<view class="survey-page" style="padding-bottom: calc(112rpx + {{bottomSafeArea}}px);">
  <view class="survey-topbar" style="margin-top: {{navigationSafeTop}}px;">
    <view class="topbar-left">
      <view class="back-button" bindtap="onBack">‹</view>
      <view class="title-group">
        <text class="page-title">{{title}}</text>
        <text class="page-subtitle">{{prototypeNotice}}</text>
      </view>
    </view>

    <view class="view-tabs">
      <view class="view-tab {{activeView === '2D' ? 'active' : ''}}" data-view="2D" bindtap="onViewTap">2D</view>
      <view class="view-tab disabled" data-view="3D" bindtap="onViewTap">3D</view>
      <view class="view-tab disabled" data-view="tour" bindtap="onViewTap">漫游</view>
      <view class="view-tab disabled" data-view="floor" bindtap="onViewTap">楼层</view>
    </view>

    <view class="topbar-actions">
      <view class="topbar-chip disabled" bindtap="onDisabledTap">助手</view>
      <view class="topbar-chip save disabled" bindtap="onDisabledTap">保存</view>
    </view>
  </view>

  <view class="survey-stage">
    <view class="canvas-shell">
      <view class="compass">
        <view class="compass-needle"></view>
        <text>N</text>
      </view>

      <view wx:if="{{topMetricVisible}}" class="top-measure-bubble">
        <text>{{topMetricLength}}</text>
        <text wx:if="{{topMetricAngle}}" class="top-measure-angle">{{topMetricAngle}}</text>
      </view>

      <view wx:else class="measurement-bubble">
        <text class="bubble-title">{{measurementTitle}}</text>
        <text class="bubble-value">{{measurementValue}}</text>
      </view>

      <view
        class="grid-canvas"
        bindtouchstart="onCanvasTouchStart"
        bindtouchmove="onCanvasTouchMove"
        bindtouchend="onCanvasTouchEnd"
        bindtouchcancel="onCanvasTouchEnd"
      >
        <view wx:if="{{guideVisible}}" class="origin-axis x-axis" style="{{cursorHorizontalGuideStyle}}"></view>
        <view wx:if="{{guideVisible}}" class="origin-axis y-axis" style="{{cursorVerticalGuideStyle}}"></view>

        <view
          wx:for="{{wallJoinFills}}"
          wx:key="id"
          class="wall-join-fill"
          style="{{item.style}}"
        ></view>

        <view
          wx:for="{{renderWalls}}"
          wx:key="id"
          class="wall-render wall-body-render {{item.selected ? 'selected' : ''}}"
          style="{{item.style}}"
          data-id="{{item.id}}"
          catchtap="onWallTap"
        >
          <view class="wall-body" style="{{item.bodyStyle}}"></view>
        </view>

        <view wx:if="{{previewWall && !previewWall.lineOnly}}" class="wall-render wall-body-render preview" style="{{previewWall.style}}">
          <view class="wall-body preview-body" style="{{previewWall.bodyStyle}}"></view>
        </view>

        <view
          wx:for="{{renderWalls}}"
          wx:key="id"
          class="wall-render wall-outline-render"
          style="{{item.style}}"
        >
          <view class="wall-outer-line" style="{{item.outerLineStyle}}"></view>
          <view wx:if="{{item.startCapVisible}}" class="wall-cap" style="{{item.startCapStyle}}"></view>
          <view wx:if="{{item.endCapVisible}}" class="wall-cap" style="{{item.endCapStyle}}"></view>
        </view>

        <view wx:if="{{previewWall && !previewWall.lineOnly}}" class="wall-render wall-outline-render preview" style="{{previewWall.style}}">
          <view class="wall-outer-line" style="{{previewWall.outerLineStyle}}"></view>
          <view wx:if="{{previewWall.startCapVisible}}" class="wall-cap" style="{{previewWall.startCapStyle}}"></view>
          <view wx:if="{{previewWall.endCapVisible}}" class="wall-cap" style="{{previewWall.endCapStyle}}"></view>
        </view>

        <view
          wx:for="{{renderWalls}}"
          wx:key="id"
          class="wall-render wall-dimension-render"
          style="{{item.style}}"
        >
          <view wx:if="{{item.showDimension}}" class="wall-dimension" style="{{item.dimensionStyle}}">
            <view class="dimension-extension start"></view>
            <view class="dimension-extension end"></view>
            <view class="dimension-main"></view>
            <view class="dimension-arrow start"></view>
            <view class="dimension-arrow end"></view>
            <text class="dimension-label">{{item.dimensionLabel}}</text>
          </view>
        </view>

        <view wx:if="{{previewWall && previewWall.showDimension}}" class="wall-render wall-dimension-render preview" style="{{previewWall.style}}">
          <view class="wall-dimension preview-dimension" style="{{previewWall.dimensionStyle}}">
            <view class="dimension-extension start"></view>
            <view class="dimension-extension end"></view>
            <view class="dimension-main"></view>
            <view class="dimension-arrow start"></view>
            <view class="dimension-arrow end"></view>
            <text class="dimension-label">{{previewWall.dimensionLabel}}</text>
          </view>
        </view>

        <view
          wx:for="{{renderWalls}}"
          wx:key="id"
          class="wall-render wall-redline-render"
          style="{{item.style}}"
        >
          <view
            wx:for="{{item.redlineParts}}"
            wx:for-item="part"
            wx:key="key"
            class="wall-redline"
            style="{{part.style}}"
          ></view>
        </view>

        <view wx:if="{{previewWall}}" class="wall-render wall-redline-render preview {{previewWall.lineOnly ? 'line-only' : ''}}" style="{{previewWall.style}}">
          <block wx:if="{{previewWall.lineOnly}}">
            <view class="drag-preview-line"></view>
          </block>
          <block wx:else>
            <view
              wx:for="{{previewWall.redlineParts}}"
              wx:for-item="part"
              wx:key="key"
              class="wall-redline preview-line"
              style="{{part.style}}"
            ></view>
          </block>
        </view>

        <view
          wx:for="{{redlineJoinFills}}"
          wx:key="id"
          class="redline-join-fill"
          style="{{item.style}}"
        ></view>

        <view wx:if="{{closureGuideVisible}}" class="closure-guide" style="{{closureGuideStyle}}"></view>
        <view wx:if="{{closeActionVisible}}" class="closure-action" style="{{closeActionStyle}}" bindtap="onConfirmClose">合</view>

        <view wx:if="{{measurePositionVisible}}" class="measure-position" style="{{measurePositionStyle}}">
          <view class="measure-position-tip">当前测量位置</view>
          <view class="measure-side-button" data-source="measure-position" bindtap="onToggleSide">
            <view class="measure-side-line"></view>
            <text>{{measurePositionButtonLabel}}</text>
          </view>
        </view>

        <view wx:if="{{cursorVisible}}" class="cursor-anchor" style="{{cursorStyle}}" data-cursor-hit="true">
          <view class="cursor-line horizontal" data-cursor-hit="true"></view>
          <view class="cursor-line vertical" data-cursor-hit="true"></view>
          <view class="cursor-core" data-cursor-hit="true"></view>
        </view>
      </view>

      <view wx:if="{{spaceSummary}}" class="space-summary">
        <text>{{spaceSummary.label}}</text>
        <text class="space-area">{{spaceSummary.area}}</text>
      </view>

      <view wx:if="{{selectedWall}}" class="wall-context">
        <view class="wall-context-title">当前墙体</view>
        <view class="wall-context-meta">
          <text>{{selectedWall.mode}}</text>
          <text>{{selectedWall.length}}</text>
          <text>{{selectedWall.side}}</text>
          <text>{{selectedWall.thickness}}</text>
        </view>
        <view class="wall-context-actions">
          <view class="context-action primary" bindtap="onStartRemeasure">复尺</view>
          <view class="context-action" bindtap="onToggleSide">切墙侧</view>
          <view class="context-action" data-tool="thickness" bindtap="onToolTap">墙厚</view>
          <view class="context-action muted" bindtap="onExitWallSelection">退出</view>
        </view>
      </view>

      <view class="undo-redo">
        <view class="round-action {{historySummary.undo ? '' : 'disabled'}}" bindtap="onUndo">
          <text>撤销</text>
          <text class="history-count">{{historySummary.undo}}</text>
        </view>
        <view class="round-action {{historySummary.redo ? '' : 'disabled'}}" bindtap="onRedo">
          <text>重做</text>
          <text class="history-count">{{historySummary.redo}}</text>
        </view>
      </view>
    </view>

    <view class="right-rail">
      <view class="tool-group primary-tools">
        <view
          class="tool-button {{item.active ? 'active' : ''}}"
          wx:for="{{coreTools}}"
          wx:key="key"
          data-tool="{{item.key}}"
          bindtap="onToolTap"
        >
          <text class="tool-label">{{item.label}}</text>
          <text class="tool-helper">{{item.helper}}</text>
        </view>
      </view>

      <view class="side-switch" bindtap="onToggleSide">
        <text class="side-label">墙侧</text>
        <text class="side-value">{{measurementSide === 'right' ? '右侧' : '左侧'}}</text>
      </view>

      <view class="tool-group reserved-tools">
        <view
          class="reserved-button disabled"
          wx:for="{{reservedTools}}"
          wx:key="key"
          bindtap="onDisabledTap"
        >
          {{item.label}}
        </view>
      </view>
    </view>
  </view>

  <view class="bottom-controls" style="bottom: calc(16rpx + {{bottomSafeArea}}px);">
    <view class="mode-pill active">测墙模式</view>
    <view class="bottom-action disabled" data-action="bluetooth" bindtap="onBottomAction">
      <text class="bottom-title">蓝牙</text>
      <text class="bottom-subtitle">Phase 3</text>
    </view>
    <view class="bottom-action" data-action="manual" bindtap="onBottomAction">
      <text class="bottom-title">手输 mm</text>
      <text class="bottom-subtitle">输入当前墙</text>
    </view>
    <view class="bottom-action" data-action="cursor" bindtap="onBottomAction">
      <text class="bottom-title">重置光标</text>
      <text class="bottom-subtitle">保留已测墙</text>
    </view>
    <view class="bottom-action disabled" data-action="add" bindtap="onBottomAction">
      <text class="bottom-title">新增</text>
      <text class="bottom-subtitle">待开放</text>
    </view>
  </view>

  <view wx:if="{{numberPadVisible}}" class="number-pad-mask" bindtap="onNumberClose"></view>
  <view wx:if="{{numberPadVisible}}" class="number-pad-panel">
    <view class="number-pad-header">
      <view>
        <text class="number-pad-title">{{numberPadTitle}}</text>
        <text class="number-pad-subtitle">{{numberPadSubtitle}}</text>
      </view>
      <view class="number-pad-close" bindtap="onNumberClose">关闭</view>
    </view>
    <view class="number-display">{{numberInput || '0'}}<text> mm</text></view>
    <view class="number-grid">
      <view
        class="number-key {{item === '清空' || item === '退格' ? 'utility' : ''}}"
        wx:for="{{numberKeys}}"
        wx:key="*this"
        data-key="{{item}}"
        bindtap="onNumberKey"
      >
        {{item}}
      </view>
    </view>
    <view class="number-confirm" bindtap="onNumberConfirm">确认</view>
  </view>
</view>
