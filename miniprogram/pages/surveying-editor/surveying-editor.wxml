<view class="survey-page">

  <!-- ══════════════════════════════════════════════ -->
  <!--  全屏画布                                      -->
  <!-- ══════════════════════════════════════════════ -->
  <view class="canvas-shell">
    <view class="grid-canvas">
      <canvas
        type="2d"
        id="survey-canvas"
        class="survey-canvas"
        bindtouchstart="onCanvasTouchStart"
        bindtouchmove="onCanvasTouchMove"
        bindtouchend="onCanvasTouchEnd"
        bindtouchcancel="onCanvasTouchEnd"
        bindtap="onCanvasTap"
      ></canvas>
    </view>

  </view>

  <!-- 常驻轻量拖拽画布：只绘制跟手光标和十字辅助线，不重绘正式墙图。 -->
  <canvas
    type="2d"
    id="cursor-drag-canvas"
    class="cursor-drag-canvas"
    disable-scroll="true"
  ></canvas>

  <!-- 所有测绘覆盖 UI 与 canvas-shell 保持同级，由本层统一承载。 -->
  <view class="canvas-overlay-layer">

    <!-- 顶部量测气泡 -->
    <cover-view wx:if="{{topMetricVisible}}" class="top-measure-bubble" style="top: {{overlayContentTop}}px;">
      <cover-view>{{topMetricLength}}</cover-view>
      <cover-view
        wx:if="{{topMetricAngle}}"
        class="top-measure-angle {{angleActionAvailable ? 'actionable' : ''}}"
        bindtap="onTopMetricAngleTap"
      >{{topMetricAngle}}</cover-view>
    </cover-view>
    <cover-view wx:else class="measurement-bubble" style="top: {{overlayContentTop}}px;">
      <cover-view class="bubble-title">{{measurementTitle}}</cover-view>
      <cover-view class="bubble-value">{{measurementValue}}</cover-view>
    </cover-view>

    <cover-view
      wx:if="{{closeActionVisible}}"
      class="closure-action"
      style="{{closeActionStyle}}"
      catchtap="onConfirmClose"
    >
      <cover-view class="closure-action-label">合</cover-view>
    </cover-view>

    <!-- 选中墙体时的浮动工具栏（图标行） -->
    <cover-view wx:if="{{selectedWall && !selectedOpening}}" class="wall-object-toolbar" style="{{selectedWall.actionStyle}}">
      <cover-view class="wall-object-action primary" data-action="door" aria-label="添加门" bindtap="onWallContextAction">
        <cover-image class="wall-action-image" src="/images/surveying-icons/wall-toolbar/door.png" mode="aspectFit"></cover-image>
        <cover-view class="wall-action-label">添门</cover-view>
      </cover-view>
      <cover-view class="wall-object-action primary" data-action="window" aria-label="添加窗" bindtap="onWallContextAction">
        <cover-image class="wall-action-image" src="/images/surveying-icons/wall-toolbar/window.png" mode="aspectFit"></cover-image>
        <cover-view class="wall-action-label">添窗</cover-view>
      </cover-view>
      <cover-view class="wall-object-action" data-action="remeasure" aria-label="复尺" bindtap="onWallContextAction">
        <cover-image class="wall-action-image" src="/images/surveying-icons/wall-toolbar/remeasure.png" mode="aspectFit"></cover-image>
        <cover-view class="wall-action-label">复尺</cover-view>
      </cover-view>
      <cover-view class="wall-object-action delete" data-action="delete" aria-label="删除墙" bindtap="onWallContextAction">
        <cover-image class="wall-action-image" src="/images/surveying-icons/wall-toolbar/delete.png" mode="aspectFit"></cover-image>
        <cover-view class="wall-action-label">删除</cover-view>
      </cover-view>
      <cover-view class="wall-object-action" aria-label="退出" catchtouchend="onExitWallSelection" catchtap="onExitWallSelection">
        <cover-image class="wall-action-image" src="/images/surveying-icons/wall-toolbar/close.png" mode="aspectFit"></cover-image>
        <cover-view class="wall-action-label">收起</cover-view>
      </cover-view>
    </cover-view>

  <!-- 使用 cover-view 作为组件根节点，验证组件是否可覆盖原生画布。 -->
  <survey-canvas-compass wx:if="{{showFormalExtras}}" safe-top="{{overlayContentTop}}" bind:tap="onDisabledTap"></survey-canvas-compass>

  <!-- ══════════════════════════════════════════════ -->
  <!--  顶部导航浮层                                   -->
  <!-- ══════════════════════════════════════════════ -->
  <cover-view class="survey-topbar native-canvas-overlay" style="top: {{navigationSafeTop}}px;">
    <cover-view class="topbar-left">
      <cover-view class="back-button" bindtap="onBack">
        <cover-image class="topbar-icon topbar-back-icon" src="/images/surveying-icons/topbar-back.png"></cover-image>
      </cover-view>
      <cover-view class="title-group">
        <cover-view class="page-title">{{title}}</cover-view>
        <cover-view class="page-subtitle">{{formalNotice}}</cover-view>
      </cover-view>
    </cover-view>
    <cover-view class="topbar-right">
      <cover-view class="topbar-chip save" bindtap="onSaveDraft">
        <cover-image class="topbar-icon" src="/images/surveying-icons/topbar-save.png"></cover-image>
        <cover-view>保存</cover-view>
      </cover-view>
      <cover-view class="topbar-chip save" bindtap="onSubmitFloorPlan">
        <cover-view>完成</cover-view>
      </cover-view>
    </cover-view>
  </cover-view>

  <!-- ══════════════════════════════════════════════ -->
  <!--  右侧工具栏（浮层）                              -->
  <!-- ══════════════════════════════════════════════ -->
  <cover-view class="right-rail native-canvas-overlay" style="top: {{rightRailTop}}px; bottom: {{rightRailBottom}}px;">
    <cover-view wx:if="{{selectedOpening}}" class="opening-context {{selectedOpening.type}}">
      <cover-view class="opening-title">{{selectedOpening.typeLabel}} · 正式量房</cover-view>
      <cover-view class="opening-fields">
        <cover-view class="opening-field" data-field="width" bindtap="onOpeningEditField">宽 {{selectedOpening.width}}</cover-view>
        <cover-view class="opening-field" data-field="height" bindtap="onOpeningEditField">高 {{selectedOpening.height}}</cover-view>
        <cover-view class="opening-field" data-field="sill" bindtap="onOpeningEditField">距地 {{selectedOpening.sill}}</cover-view>
      </cover-view>
      <cover-view wx:if="{{canResumeWallDrawing}}" class="opening-resume-action" bindtap="onResumeWallDrawing">
        <cover-view class="opening-resume-label">继续测墙</cover-view>
      </cover-view>
      <cover-view class="opening-side-switch" bindtap="onToggleSide">
        <cover-view class="side-label">{{selectedOpening.type === 'door' ? '开向' : '窗位'}}</cover-view>
        <cover-view class="side-value">{{selectedOpening.type === 'door' ? selectedOpening.openDirectionLabel : '固定'}}</cover-view>
      </cover-view>
    </cover-view>

    <cover-view wx:if="{{objectToolsVisible}}" class="tool-group primary-tools object-tools">
      <cover-view
        class="tool-button"
        wx:for="{{objectTools}}"
        wx:key="key"
        data-tool="{{item.key}}"
        bindtap="onToolTap"
      >
        <cover-view class="tool-label">{{item.label}}</cover-view>
        <cover-view class="tool-helper">{{item.helper}}</cover-view>
      </cover-view>
    </cover-view>

    <cover-view wx:else class="tool-group primary-tools">
      <cover-view
        class="tool-button {{item.active ? 'active' : ''}}"
        wx:for="{{coreTools}}"
        wx:key="key"
        data-tool="{{item.key}}"
        bindtap="onToolTap"
      >
        <cover-view class="tool-label">{{item.label}}</cover-view>
        <cover-view class="tool-helper">{{item.helper}}</cover-view>
      </cover-view>
    </cover-view>

    <cover-view wx:if="{{showFormalExtras}}" class="tool-group reserved-tools">
      <cover-view
        class="reserved-button disabled"
        wx:for="{{reservedTools}}"
        wx:key="key"
        bindtap="onDisabledTap"
      >
        {{item.label}}
      </cover-view>
    </cover-view>
  </cover-view>

  <!-- ══════════════════════════════════════════════ -->
  <!--  底部光标控件：已放置 / 等待拖放 / 拖拽中为空      -->
  <!-- ══════════════════════════════════════════════ -->
  <cover-view class="history-action-bar native-canvas-overlay" style="bottom: calc(42rpx + {{bottomSafeArea}}px);">
    <cover-view class="history-action {{historySummary.undo > 0 ? '' : 'disabled'}}" bindtap="onUndoTap">
      <cover-view>撤销</cover-view>
      <cover-view wx:if="{{historySummary.undo > 0}}" class="history-action-count">{{historySummary.undo}}</cover-view>
    </cover-view>
    <cover-view class="history-action danger" bindtap="onRequestResetCanvas">重画</cover-view>
  </cover-view>

  <cover-view class="bottom-fab-bar native-canvas-overlay" style="bottom: calc(36rpx + {{bottomSafeArea}}px);">
    <cover-view wx:if="{{cursorPlacementState === 'placed'}}" class="cursor-fab cursor-fab-reset" bindtap="onResetCursorTap">
      <cover-view class="cursor-fab-icon cursor-reset-icon">
        <cover-image class="cursor-reset-image" src="/images/surveying-icons/wall-toolbar/reset.png" mode="aspectFit"></cover-image>
      </cover-view>
      <cover-view class="cursor-fab-label">重置光标</cover-view>
    </cover-view>
    <cover-view
      wx:elif="{{cursorPlacementState === 'awaitingWallDrop' || cursorPlacementState === 'dragging'}}"
      class="cursor-fab cursor-fab-drop {{cursorPlacementState === 'dragging' ? 'is-dragging' : ''}}"
      data-cursor-control="true"
      bindtouchstart="onCursorControlTouchStart"
      catchtouchmove="onCursorControlTouchMove"
      bindtouchend="onCursorDragEnd"
      bindtouchcancel="onCursorDragCancel"
    >
      <cover-view class="cursor-fab-icon cursor-drop-icon">
        <cover-view class="cursor-drop-h"></cover-view>
        <cover-view class="cursor-drop-v"></cover-view>
        <cover-view class="cursor-drop-box"></cover-view>
      </cover-view>
      <cover-view class="cursor-fab-label">拖动放置光标</cover-view>
    </cover-view>
  </cover-view>

  <!-- ══════════════════════════════════════════════ -->
  <!--  拖拽放置光标的纯展示层（不接收触摸，事件始终由底部按钮承接） -->
  <!-- ══════════════════════════════════════════════ -->
  <cover-view
    wx:if="{{cursorPlacementState === 'dragging'}}"
    class="cursor-drag-lens-layer"
  >
    <cover-view wx:if="{{cursorLensVisible}}" class="cursor-lens {{cursorLensSnapType}}">
      <cover-view class="cursor-lens-grid">
        <cover-view class="cursor-lens-cross horizontal"></cover-view>
        <cover-view class="cursor-lens-cross vertical"></cover-view>
        <cover-view class="cursor-lens-target"></cover-view>
      </cover-view>
      <cover-view class="cursor-lens-meta">
        <cover-view>{{cursorLensSnapLabel}}</cover-view>
        <cover-view>{{cursorLensXLabel}} / {{cursorLensYLabel}}</cover-view>
      </cover-view>
    </cover-view>
  </cover-view>


  <!-- ══════════════════════════════════════════════ -->
  <!--  门窗构件编辑器（全屏覆盖）                       -->
  <!-- ══════════════════════════════════════════════ -->
  <view wx:if="{{componentEditorVisible}}" class="component-editor">
    <view class="component-topbar" style="top: {{navigationSafeTop}}px;">
      <view class="component-back" bindtap="closeComponentEditor">
        <image class="back-icon" src="/images/back-arrow.png"></image>
      </view>
      <view class="component-title">{{componentEditorTitle}}</view>
      <view class="component-lock">锁</view>
    </view>

    <canvas
      type="webgl"
      id="component-webgl"
      class="component-webgl"
      bindtouchstart="onComponentTouchStart"
      bindtouchmove="onComponentTouchMove"
      bindtouchend="onComponentTouchEnd"
      bindtouchcancel="onComponentTouchEnd"
      disable-scroll="true"
    ></canvas>

    <!-- 墙体尺寸标注悬浮层 -->
    <cover-view class="dimension-overlay-label" style="{{wallLengthStyle}}">{{wallLengthLabel}}</cover-view>
    <cover-view class="dimension-overlay-label" style="{{wallHeightStyle}}">{{wallHeightLabel}}</cover-view>

    <!-- 门窗构件参数标注悬浮层 -->
    <cover-view class="dimension-overlay-label {{componentSpecMode === 'edge1' ? 'active' : ''}}" style="{{paramEdge1Style}}">{{paramEdge1Label}}</cover-view>
    <cover-view class="dimension-overlay-label {{componentSpecMode === 'edge2' ? 'active' : ''}}" style="{{paramEdge2Style}}">{{paramEdge2Label}}</cover-view>
    <cover-view class="dimension-overlay-label {{componentSpecMode === 'length' || componentSpecMode === 'spec' ? 'active' : ''}}" style="{{paramLengthStyle}}">{{paramLengthLabel}}</cover-view>
    <cover-view class="dimension-overlay-label {{componentSpecMode === 'height' ? 'active' : ''}}" style="{{paramHeightStyle}}">{{paramHeightLabel}}</cover-view>
    <cover-view class="dimension-overlay-label {{componentSpecMode === 'sill' ? 'active' : ''}}" style="{{paramSillStyle}}">{{paramSillLabel}}</cover-view>

    <view wx:if="{{componentSelectedOpening && componentSelectedOpening.type === 'door'}}" class="entry-door-action" bindtap="onToggleEntryDoor">
      {{componentSelectedOpening.entryDoor ? '已设为入户门' : '设为入户门'}}
    </view>

    <view class="component-panel {{componentPanelMode === 'spec' ? 'component-panel-raised' : ''}}">
      <view class="component-panel-tabs">
        <view
          class="component-panel-tab {{componentPanelMode === item.key ? 'active' : ''}}"
          wx:for="{{componentPanelTabs}}"
          wx:key="key"
          data-mode="{{item.key}}"
          bindtap="onComponentPanelTab"
        >{{item.label}}</view>
      </view>

      <view wx:if="{{componentPanelMode === 'spec'}}" class="component-spec">
        <view class="component-spec-tabs">
          <view
            class="component-spec-tab {{componentSpecMode === item.key ? 'active' : ''}}"
            wx:for="{{componentSpecTabs}}"
            wx:key="key"
            data-mode="{{item.key}}"
            bindtap="onComponentSpecTab"
          >{{item.label}}</view>
        </view>
        <view class="component-spec-display">
          <text class="component-spec-val">{{componentSpecValue}}</text>
          <text class="component-spec-unit">mm</text>
        </view>
        <view class="component-spec-keyboard">
          <view
            class="keyboard-key {{item === '清空' || item === '退格' ? 'utility' : ''}}"
            wx:for="{{numberKeys}}"
            wx:key="*this"
            data-key="{{item}}"
            bindtap="onComponentKeyboardKey"
          >
            {{item}}
          </view>
        </view>
        <view class="component-spec-actions">
          <view class="component-spec-measure" bindtap="triggerComponentSpecBluetoothMeasure">测距</view>
          <view class="component-sync-row" bindtap="onToggleComponentThicknessSync">
            <view class="sync-dot {{componentSyncWallThickness ? 'active' : ''}}"></view>
            <text>同步更改墙体厚度</text>
          </view>
        </view>
      </view>

      <view wx:elif="{{componentPanelMode === 'flip'}}" class="component-flip">
        <view class="flip-card {{componentSelectedOpening && componentSelectedOpening.openDirection === 'inside' ? 'active' : ''}}" data-direction="inside" bindtap="onComponentFlip">内开</view>
        <view class="flip-card {{componentSelectedOpening && componentSelectedOpening.openDirection === 'outside' ? 'active' : ''}}" data-direction="outside" bindtap="onComponentFlip">外开</view>
        <view wx:if="{{componentSelectedOpening && componentSelectedOpening.type === 'window'}}" class="component-note">窗构件暂固定窗位，不支持开向切换。</view>
      </view>

      <view wx:else class="component-library">
        <view class="library-toolbar">
          <view class="library-type">{{componentSelectedOpening.modelLabel}}</view>
          <view class="library-source">公共库 ▾</view>
        </view>
        <view class="category-row">
          <view
            class="category-chip {{item.active ? 'active' : ''}}"
            wx:for="{{componentCategories}}"
            wx:key="key"
            data-category="{{item.key}}"
            bindtap="onComponentCategoryTap"
          >{{item.label}}</view>
        </view>
        <view class="library-grid">
          <view
            class="library-item {{item.active ? 'active' : ''}}"
            wx:for="{{componentLibraryItems}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="onComponentModelTap"
          >
            <view class="library-thumb" style="background:{{item.swatch}};"></view>
            <text>{{item.label}}</text>
            <view wx:if="{{item.active}}" class="library-check">选</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- ══════════════════════════════════════════════ -->
  <!--  数字键盘弹层                                   -->
  <!-- ══════════════════════════════════════════════ -->
  <cover-view wx:if="{{numberPadVisible}}" class="number-pad-mask native-canvas-overlay" bindtap="onNumberClose"></cover-view>
  <cover-view wx:if="{{numberPadVisible}}" class="number-pad-panel native-canvas-overlay">
    <cover-view class="number-pad-header">
      <cover-view>
        <cover-view class="number-pad-title">{{numberPadTitle}}</cover-view>
        <cover-view class="number-pad-subtitle">{{numberPadSubtitle}}</cover-view>
      </cover-view>
      <cover-view class="number-pad-close" bindtap="onNumberClose">关闭</cover-view>
    </cover-view>
    <cover-view wx:if="{{angleMeasureVisible}}" class="angle-measure-tools">
      <cover-view class="angle-measure-tabs">
        <cover-view
          class="angle-measure-tab {{angleMeasureTab === 'phone' ? 'active' : ''}}"
          data-tab="phone"
          bindtap="onAngleMeasureTab"
        >手机测量角度</cover-view>
        <cover-view
          class="angle-measure-tab {{angleMeasureTab === 'pythagorean' ? 'active' : ''}}"
          data-tab="pythagorean"
          bindtap="onAngleMeasureTab"
        >勾股定理测量角度</cover-view>
      </cover-view>

      <cover-view wx:if="{{angleMeasureTab === 'phone'}}" class="phone-angle-tool">
        <cover-view class="phone-angle-dial {{anglePhoneLevelReady ? 'level' : ''}}">
          <cover-view class="phone-angle-needle" style="{{anglePhoneDialStyle}}"></cover-view>
          <cover-view class="phone-angle-center {{anglePhoneLevelReady ? 'level' : ''}}"></cover-view>
        </cover-view>
        <cover-view class="phone-angle-value">{{anglePhoneLiveValue}}°</cover-view>
        <cover-view class="phone-angle-status">{{angleMeasureStatus}}</cover-view>
        <cover-view
          wx:if="{{!anglePhoneReferenceReady}}"
          class="phone-angle-baseline {{anglePhoneLevelReady ? '' : 'disabled'}}"
          bindtap="onPhoneSetAngleBaseline"
        >设为基准</cover-view>
      </cover-view>

      <cover-view wx:else class="triangle-angle-tool">
        <cover-view class="triangle-angle-hint">从同一拐角向两面墙取点，依次测量两边和两点连线。</cover-view>
        <cover-view class="triangle-side-row">
          <cover-view class="triangle-side-name">边 A</cover-view>
          <cover-view class="triangle-side-value">{{angleTriangleA ? angleTriangleA + ' m' : '待测'}}</cover-view>
          <cover-view class="triangle-side-action" data-side="a" bindtap="onTriangleMeasure">测量</cover-view>
        </cover-view>
        <cover-view class="triangle-side-row">
          <cover-view class="triangle-side-name">边 B</cover-view>
          <cover-view class="triangle-side-value">{{angleTriangleB ? angleTriangleB + ' m' : '待测'}}</cover-view>
          <cover-view class="triangle-side-action" data-side="b" bindtap="onTriangleMeasure">测量</cover-view>
        </cover-view>
        <cover-view class="triangle-side-row">
          <cover-view class="triangle-side-name">连线 D</cover-view>
          <cover-view class="triangle-side-value">{{angleTriangleD ? angleTriangleD + ' m' : '待测'}}</cover-view>
          <cover-view class="triangle-side-action" data-side="d" bindtap="onTriangleMeasure">测量</cover-view>
        </cover-view>
        <cover-view wx:if="{{angleTriangleResult}}" class="triangle-angle-result">计算结果 {{angleTriangleResult}}</cover-view>
        <cover-view wx:if="{{angleTriangleError}}" class="triangle-angle-error">{{angleTriangleError}}</cover-view>
        <cover-view class="triangle-reset" bindtap="onResetAngleTriangle">重新测量三边</cover-view>
      </cover-view>
    </cover-view>
    <cover-view class="number-display">
      <cover-view class="number-display-value">{{numberInput || '0'}}</cover-view>
      <cover-view class="number-display-unit">{{numberUnit}}</cover-view>
    </cover-view>
    <cover-view class="number-grid">
      <cover-view
        class="number-key {{item === '清空' || item === '退格' ? 'utility' : ''}}"
        wx:for="{{numberKeys}}"
        wx:key="*this"
        data-key="{{item}}"
        bindtap="onNumberKey"
      >
        {{item}}
      </cover-view>
    </cover-view>
    <cover-view class="number-actions">
      <cover-view wx:if="{{!angleMeasureVisible}}" class="number-measure" bindtap="triggerBluetoothNumberMeasure">测距</cover-view>
      <cover-view class="number-confirm {{angleMeasureVisible ? 'full' : ''}}" bindtap="onNumberConfirm">确认</cover-view>
    </cover-view>
  </cover-view>

  </view>
</view>
