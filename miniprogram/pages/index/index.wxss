.home-page {
  height: calc(100vh - var(--sfp-custom-tabbar-safe-height));
  background: #f7fbf7;
  color: var(--text-primary);
  overflow: hidden;
}

.home-scroll {
  width: 100%;
  height: 100%;
}

.home-content {
  min-height: 100%;
  padding-bottom: 16rpx;
  box-sizing: border-box;
}

.hero-stage {
  position: relative;
  overflow: hidden;
  background-color: #03974b;
  background-image: linear-gradient(
    90deg,
    #03974b 0%,
    #029e4a 24%,
    #16aa4a 47%,
    #3ebb5d 71%,
    #a2d985 100%
  );
}

.status-spacer {
  width: 100%;
}

.hero-nav {
  position: relative;
  z-index: 3;
  height: 64rpx;
  padding-left: 38rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.city-control,
.notification-control {
  min-height: 56rpx;
  display: flex;
  align-items: center;
}

.city-control {
  max-width: 300rpx;
  gap: 10rpx;
}

.city-icon {
  width: 34rpx;
  height: 42rpx;
  flex-shrink: 0;
}

.city-label {
  max-width: 208rpx;
  color: var(--text-inverse);
  font-size: 31rpx;
  line-height: 1;
  font-weight: 650;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  letter-spacing: 0;
}

.city-chevron {
  width: 0;
  height: 0;
  border-left: 7rpx solid transparent;
  border-right: 7rpx solid transparent;
  border-top: 10rpx solid rgba(255, 255, 255, 0.94);
  margin-top: 6rpx;
}

.notification-control {
  width: 58rpx;
  justify-content: center;
}

.notification-icon {
  width: 46rpx;
  height: 46rpx;
}

.hero-scene-image {
  display: block;
  width: 750rpx;
  height: 560rpx;
  margin-top: -2rpx;
}

.enterprise-chip {
  position: absolute;
  z-index: 4;
  left: 40rpx;
  bottom: 32rpx;
  max-width: 230rpx;
  min-height: 36rpx;
  padding: 4rpx 12rpx 4rpx 6rpx;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 8rpx 22rpx rgba(0, 102, 45, 0.16);
  display: flex;
  align-items: center;
  gap: 8rpx;
  box-sizing: border-box;
}

.enterprise-logo {
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.enterprise-name {
  min-width: 0;
  color: #16743b;
  font-size: 17rpx;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.enterprise-certified {
  flex-shrink: 0;
  color: #55a36f;
  font-size: 14rpx;
}

.measure-card {
  position: relative;
  z-index: 5;
  height: 216rpx;
  margin: -18rpx 32rpx 0;
  padding: 8rpx 38rpx 8rpx 18rpx;
  border-radius: 30rpx;
  background: var(--bg-surface);
  box-shadow: 0 18rpx 38rpx rgba(31, 117, 61, 0.14);
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.measure-orb {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.measure-copy {
  min-width: 0;
  flex: 1;
  padding: 12rpx 0 0 28rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.measure-title {
  color: #171a1d;
  font-size: 40rpx;
  line-height: 1.15;
  font-weight: 650;
  letter-spacing: 0;
}

.measure-subtitle {
  color: #7d838a;
  font-size: 23rpx;
  line-height: 1.35;
}

.measure-progress {
  color: #13a84a;
  font-size: 19rpx;
  line-height: 1.2;
}

.measure-divider {
  width: 1px;
  height: 72rpx;
  margin: 0 28rpx 0 14rpx;
  background: #c7dfcf;
  transform: scaleX(0.5);
  flex-shrink: 0;
}

.measure-action {
  width: 138rpx;
  height: 138rpx;
  border-radius: 50%;
  background: #08be53;
  box-shadow: 0 0 0 10rpx #e8f8ec;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.measure-action-text {
  color: var(--text-inverse);
  font-size: 25rpx;
  line-height: 1;
  font-weight: 650;
  white-space: nowrap;
}

.action-chevron,
.small-chevron,
.plan-action-chevron {
  width: 11rpx;
  height: 11rpx;
  border-top: 3rpx solid currentColor;
  border-right: 3rpx solid currentColor;
  transform: rotate(45deg);
  box-sizing: border-box;
}

.action-chevron {
  color: #ffffff;
}

.services-section,
.ongoing-section {
  margin-left: 28rpx;
  margin-right: 28rpx;
}

.services-section {
  margin-top: 18rpx;
}

.section-title {
  display: block;
  color: #171a1d;
  font-size: 28rpx;
  line-height: 32rpx;
  font-weight: 650;
  letter-spacing: 0;
}

.service-grid {
  height: 190rpx;
  margin-top: 8rpx;
  display: grid;
  grid-template-columns: 1.1fr 1fr 0.92fr;
  gap: 12rpx;
}

.service-card {
  min-width: 0;
  height: 190rpx;
  padding: 14rpx 16rpx;
  border-radius: 22rpx;
  box-shadow: 0 8rpx 22rpx rgba(78, 89, 78, 0.06);
  overflow: hidden;
  box-sizing: border-box;
}

.service-leads {
  background: #fff8f4;
  box-shadow: inset 0 0 0 1rpx #f3d7cb, 0 8rpx 22rpx rgba(165, 87, 53, 0.05);
}

.service-ai {
  background: #fffdf4;
  box-shadow: inset 0 0 0 1rpx #f1dfad, 0 8rpx 22rpx rgba(151, 113, 20, 0.05);
}

.service-device {
  background: #f4fbf6;
  box-shadow: inset 0 0 0 1rpx #c9e6d1, 0 8rpx 22rpx rgba(42, 126, 68, 0.05);
}

.service-heading,
.device-heading {
  display: flex;
  align-items: center;
  min-width: 0;
}

.service-heading {
  gap: 10rpx;
}

.device-heading {
  gap: 6rpx;
}

.service-icon {
  flex-shrink: 0;
  border-radius: 10rpx;
}

.service-icon-leads {
  width: 62rpx;
  height: 62rpx;
}

.service-icon-ai {
  width: 56rpx;
  height: 60rpx;
}

.service-icon-device {
  width: 50rpx;
  height: 58rpx;
}

.service-title-wrap {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 3rpx;
}

.service-title {
  font-size: 27rpx;
  line-height: 1.15;
  font-weight: 650;
  white-space: nowrap;
}

.service-title-coral {
  color: #ee572d;
}

.service-title-amber {
  color: #bd7500;
}

.service-title-green {
  color: #0c9f42;
}

.service-badge {
  align-self: flex-start;
  max-width: 100%;
  min-height: 28rpx;
  padding: 0 9rpx;
  border-radius: var(--radius-full);
  font-size: 19rpx;
  line-height: 28rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  box-sizing: border-box;
}

.service-badge-coral {
  color: #8e5a4c;
  background: #fff0e9;
}

.service-badge-amber {
  color: #8a6725;
  background: #fff4cc;
}

.service-badge-green {
  color: #27894a;
  background: #dcf3e2;
}

.service-description {
  display: block;
  margin-top: 7rpx;
  color: #62676d;
  font-size: 20rpx;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.service-footer {
  height: 48rpx;
  margin-top: 4rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.lead-avatars {
  width: 148rpx;
  height: 44rpx;
  border-radius: var(--radius-full);
}

.small-action {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: inset 0 0 0 1rpx #f0c9bb;
  color: #e95f3b;
  display: flex;
  align-items: center;
  justify-content: center;
}

.small-chevron {
  width: 9rpx;
  height: 9rpx;
  border-width: 2rpx;
  margin-left: -3rpx;
}

.ai-preview {
  display: block;
  width: 100%;
  height: 80rpx;
  margin-top: 4rpx;
  border-radius: 9rpx;
}

.device-summary {
  height: 78rpx;
  margin-top: 3rpx;
  padding: 4rpx 6rpx;
  border-radius: 11rpx;
  background: rgba(255, 255, 255, 0.82);
  display: flex;
  align-items: center;
  gap: 5rpx;
  box-sizing: border-box;
}

.laser-device {
  width: 54rpx;
  height: 68rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.device-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.device-name {
  color: #24282b;
  font-size: 20rpx;
  line-height: 1.1;
  font-weight: 600;
}

.device-status {
  max-width: 86rpx;
  color: #71777b;
  font-size: 15rpx;
  line-height: 1.1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.ongoing-section {
  margin-top: 34rpx;
  padding: 12rpx 16rpx 14rpx;
  border-radius: 22rpx;
  background: #fffdf8;
  box-shadow: inset 0 0 0 1rpx #f1dfb3, 0 8rpx 22rpx rgba(111, 89, 40, 0.05);
  box-sizing: border-box;
}

.section-heading-row,
.section-title-group,
.schedule-chip,
.plan-location-row,
.plan-status-row,
.plan-action-row,
.empty-action {
  display: flex;
  align-items: center;
}

.section-heading-row {
  height: 38rpx;
  justify-content: space-between;
}

.section-title-group {
  gap: 10rpx;
}

.section-pin {
  position: relative;
  width: 18rpx;
  height: 18rpx;
  border: 5rpx solid #ffc533;
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg) scale(0.75);
  box-sizing: border-box;
}

.schedule-chip {
  height: 34rpx;
  padding: 0 12rpx;
  gap: 7rpx;
  border-radius: var(--radius-full);
  background: #fffaf0;
  box-shadow: inset 0 0 0 1rpx #dccda8;
  color: #61594d;
  font-size: 18rpx;
}

.calendar-icon {
  position: relative;
  width: 17rpx;
  height: 16rpx;
  border: 2rpx solid currentColor;
  border-radius: 4rpx;
  box-sizing: border-box;
}

.calendar-top {
  position: absolute;
  left: 2rpx;
  right: 2rpx;
  top: 4rpx;
  height: 1px;
  background: currentColor;
  transform: scaleY(0.5);
}

.ongoing-card {
  height: 212rpx;
  margin-top: 8rpx;
  display: flex;
  gap: 22rpx;
}

.plan-preview {
  width: 322rpx;
  height: 212rpx;
  border-radius: 17rpx;
  box-shadow: 0 8rpx 18rpx rgba(115, 95, 51, 0.1);
  flex-shrink: 0;
}

.plan-copy {
  min-width: 0;
  flex: 1;
  padding: 4rpx 0 0;
  display: flex;
  flex-direction: column;
}

.plan-title {
  color: #14171a;
  font-size: 27rpx;
  line-height: 1.2;
  font-weight: 650;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  letter-spacing: 0;
}

.plan-location-row {
  min-width: 0;
  margin-top: 6rpx;
  gap: 6rpx;
  color: #6d7278;
  font-size: 17rpx;
  white-space: nowrap;
}

.plan-location-dot {
  width: 8rpx;
  height: 8rpx;
  border: 2rpx solid #6d7278;
  border-radius: 50%;
  flex-shrink: 0;
}

.plan-status-row {
  margin-top: 7rpx;
  gap: 8rpx;
  min-width: 0;
}

.plan-status,
.plan-time {
  min-height: 28rpx;
  padding: 0 9rpx;
  border-radius: var(--radius-full);
  font-size: 16rpx;
  line-height: 28rpx;
  box-sizing: border-box;
}

.plan-status.status-draft {
  color: #0d9d41;
  background: #e5f7e8;
}

.plan-status.status-designing {
  color: #b77100;
  background: #fff2cf;
}

.plan-status.status-completed {
  color: #536067;
  background: #ebeff0;
}

.plan-time {
  min-width: 0;
  max-width: 138rpx;
  padding: 0;
  color: #c18719;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.plan-current {
  margin-top: 7rpx;
  color: #32373b;
  font-size: 18rpx;
  line-height: 1.2;
}

.plan-progress-track {
  width: 100%;
  height: 7rpx;
  margin-top: 8rpx;
  border-radius: var(--radius-full);
  background: #e1e6e2;
  overflow: hidden;
}

.plan-progress-fill {
  height: 100%;
  border-radius: inherit;
  background: #10ae4a;
}

.plan-progress-fill.status-draft {
  width: 38%;
}

.plan-progress-fill.status-designing {
  width: 68%;
}

.plan-progress-fill.status-completed {
  width: 100%;
}

.plan-action-row {
  align-self: flex-end;
  margin-top: auto;
  gap: 10rpx;
  color: #0b9d40;
  font-size: 19rpx;
  line-height: 1;
}

.plan-action-chevron {
  width: 10rpx;
  height: 10rpx;
  border-width: 2rpx;
}

.ongoing-empty {
  align-items: center;
}

.empty-plan-preview {
  opacity: 0.52;
}

.empty-plan-copy {
  justify-content: center;
}

.empty-description {
  margin-top: 10rpx;
  color: #747a7e;
  font-size: 19rpx;
  line-height: 1.45;
}

.empty-action {
  align-self: flex-start;
  height: 42rpx;
  margin-top: 16rpx;
  padding: 0 18rpx;
  gap: 8rpx;
  border-radius: var(--radius-full);
  background: #0dad49;
  color: #ffffff;
  font-size: 18rpx;
}

.control-pressed {
  opacity: 0.72;
}

.card-pressed {
  transform: scale(0.985);
  opacity: 0.92;
}
