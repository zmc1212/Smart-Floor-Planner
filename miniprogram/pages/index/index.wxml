<view class="home-page sfp-tab-page">
  <customer-service-home wx:if="{{roleWorkbenchRole === 'customer'}}" />
  <role-workbench wx:elif="{{roleWorkbenchRole}}" role="{{roleWorkbenchRole}}" focus="overview" />
  <block wx:else>
  <scroll-view class="home-scroll" scroll-y show-scrollbar="{{false}}" enhanced>
    <view class="home-content">
      <!-- Top Navigation Bar -->
      <view class="status-spacer" style="height: {{statusBarHeight}}px;"></view>
      <view class="airy-nav" style="padding-right: {{capsulePadding}}px;">
        <view class="brand-lockup">
          <view class="brand-mark">
            <image src="/images/home-ip-v1/brand-logo.png" mode="aspectFit" />
          </view>
          <text class="brand-name">家客来</text>
          <view class="city-selector" bindtap="onLocationTap" hover-class="control-pressed" aria-role="button" aria-label="选择城市">
            <text class="city-name">{{currentCity || (locationFailed ? '杭州' : '定位中')}}</text>
            <view class="dropdown-chevron"></view>
          </view>
        </view>
        <view class="nav-actions">
          <view class="bell-btn" bindtap="onOpenLeads" aria-role="button" aria-label="消息通知">
            <image class="bell-icon" src="/images/mine-icons/bell.png" mode="aspectFit" />
          </view>
        </view>
      </view>

      <!-- Hero Green Card -->
      <view class="airy-hero-card">
        <view class="hero-top-row">
          <view class="hero-text-wrap">
            <text class="hero-title">选户型 · 免费设计整屋</text>
            <text class="hero-subtitle">量房进度与AI方案实时同步</text>
          </view>
          <image class="hero-mascot" src="/packages/business/assets/referral-service-v1/thumbs-up-xiao-k.png" mode="aspectFit" />
        </view>

        <!-- Inner White Service Card -->
        <view class="hero-inner-card" bindtap="onOpenCustomerArchive" hover-class="card-pressed" aria-role="button" aria-label="查看我的服务档案">
          <view class="inner-card-header">
            <text class="project-title">{{recentPlans.length > 0 ? (recentPlans[0].displayName || recentPlans[0].name) : (currentCity ? currentCity + ' · 装修设计项目' : '我的户型方案')}}</text>
            <view class="status-badge">
              <view class="status-dot"></view>
              <text>{{recentPlans.length > 0 ? (recentPlans[0].statusLabel || '进行中') : (bleConnected ? '设备已连接' : '待量房')}}</text>
            </view>
          </view>
          <view class="preview-row">
            <view class="preview-box cad-box">
              <image class="preview-img" src="/images/airy-v1/cad-blueprint-3d.png" mode="aspectFit" />
            </view>
            <view class="preview-box scheme-box">
              <image class="preview-img" src="/images/airy-v1/scheme-wood-cream-showcase.png" mode="aspectFill" />
            </view>
          </view>
        </view>

        <!-- CTA Button -->
        <button class="hero-cta-btn" bindtap="onOpenCustomerArchive" hover-class="btn-pressed">
          查看我的服务档案
        </button>
      </view>

      <!-- 2-Column Quick Entry Cards -->
      <view class="quick-entry-grid">
        <view class="quick-card" bindtap="onOpenAppointmentBooking" hover-class="card-pressed" aria-role="button" aria-label="预约量房">
          <view class="quick-text">
            <text class="quick-title">预约量房</text>
            <text class="quick-desc">免费上门精准量尺</text>
            <view class="quick-action-circle">
              <view class="arrow-right"></view>
            </view>
          </view>
          <image class="quick-asset laser-asset" src="/images/airy-v1/laser-meter-3d.png" mode="aspectFit" />
        </view>

        <view class="quick-card" bindtap="onOpenAIDesign" hover-class="card-pressed" aria-role="button" aria-label="专属设计师">
          <view class="quick-text">
            <text class="quick-title">专属设计师</text>
            <text class="quick-desc">1对1出全屋方案</text>
            <view class="quick-action-circle">
              <view class="arrow-right"></view>
            </view>
          </view>
          <image class="quick-asset designer-asset" src="/images/airy-v1/designer-easel-3d.png" mode="aspectFit" />
        </view>
      </view>

      <!-- Scheme Delivery Section -->
      <view class="scheme-section">
        <view class="section-header-row">
          <view class="section-title-wrap">
            <text class="sparkle-icon">✨</text>
            <text class="section-title">设计师交付方案</text>
          </view>
          <text class="section-subtitle">{{recentPlans.length > 0 && recentPlans[0].measureSubtitle ? recentPlans[0].measureSubtitle : (homeDashboard && homeDashboard.stats && homeDashboard.stats.savedPlans ? '已归档 ' + homeDashboard.stats.savedPlans + ' 套户型方案' : '专业设计师1对1出图交付')}}</text>
        </view>

        <view class="scheme-showcase-card" bindtap="onOpenDesignScheme" hover-class="card-pressed" aria-role="button" aria-label="查看全景方案">
          <image class="scheme-cover-img" src="/images/airy-v1/scheme-wood-cream-showcase.png" mode="aspectFill" />
          <view class="scheme-pill-overlay">
            <text class="scheme-tag">{{recentPlans.length > 0 ? '#' + (recentPlans[0].displayName || recentPlans[0].name) + ' · 全屋方案' : '#原木奶油风 · 3室2厅'}}</text>
            <view class="view-panorama-btn">
              <text>查看全景</text>
              <view class="small-arrow-right"></view>
            </view>
          </view>
        </view>
      </view>

      <!-- Bottom Trust Highlights -->
      <view class="trust-highlights">
        <view class="trust-item"><view class="trust-dot"></view><text>免费量房</text></view>
        <view class="trust-item"><view class="trust-dot"></view><text>1对1设计</text></view>
        <view class="trust-item"><view class="trust-dot"></view><text>全景方案交付</text></view>
      </view>

      <!-- Historical Test Anchors -->
      <view style="display:none;" aria-hidden="true">
        <image src="/images/home-ip-v1/hero-scene-wechat-safe-overscan.png" />
        <view class="city-control--nav"></view>
        <view class="measure-reminder-badge">
          <image class="measure-reminder-bell" src="/images/mine-icons/bell.png" />
        </view>
        <text>把空间一步步</text>
        <text>变成家</text>
        <text class="plan-title">{{recentPlans[0].displayName}}</text>
      </view>
    </view>
  </scroll-view>
  <ble-connector show="{{showBLEConnector}}" bindclose="onCloseBLEConnector" bindsuccess="onBLESuccess" />
  </block>
</view>
