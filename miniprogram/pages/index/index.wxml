<view class="home-page sfp-tab-page">
  <scroll-view class="home-scroll" scroll-y show-scrollbar="{{false}}" enhanced>
    <view class="home-content">
      <view class="hero-stage">
        <image class="hero-scene-image" src="/images/home-ip-v1/hero-scene-wechat-safe.jpg" mode="aspectFill" />
        <view class="status-spacer" style="height: {{statusBarHeight}}px;"></view>

        <view class="hero-nav" style="padding-right: {{capsulePadding}}px;">
          <view class="brand-lockup">
            <view class="brand-mark"><image src="/images/home-ip-v1/brand-logo.png" mode="aspectFit" /></view>
            <text class="brand-name">家客来</text>
          </view>
        </view>

        <view class="hero-copy">
          <view class="city-control" bindtap="onLocationTap" hover-class="control-pressed" aria-role="button" aria-label="选择城市">
            <image class="city-icon" src="/images/home-v5/location.png" mode="aspectFit" />
            <text class="city-label">{{currentCity || (locationFailed ? '选择城市' : '定位中')}}</text>
          </view>
          <view class="hero-title" aria-label="让小K陪你，把空间一步步变成家">
            <text>让小K陪你</text>
            <text>把空间一步步变</text>
            <text>成家</text>
          </view>
          <view class="hero-subtitle">
            <text>从客户线索、正式量房到 AI 设计，</text>
            <text>一套形象贯穿每个关键节点</text>
          </view>
        </view>

        <view class="hero-reminder" wx:if="{{recentPlans.length > 0}}">
          <text class="hero-reminder-kicker">小K · 今日提醒</text>
          <text class="hero-reminder-text">{{recentPlans[0].statusClass === 'status-completed' ? recentPlans[0].name + '已完成，可查看户型' : recentPlans[0].name + '正在编辑，点击继续量房'}}</text>
        </view>
      </view>

      <view class="measure-card" bindtap="onPrimaryMeasureTap" hover-class="card-pressed" aria-role="button" aria-label="{{recentPlans.length > 0 ? (recentPlans[0].statusClass === 'status-completed' ? '查看户型' : '继续量房') : (plannedRooms.length > 0 ? '继续量房' : '开始量房')}}">
        <view class="measure-label-row">
          <image class="measure-mini-orb" src="/images/home-ip-v1/measure-k.png" mode="aspectFit" />
          <text>{{recentPlans.length > 0 && recentPlans[0].statusClass === 'status-completed' ? '小K已完成本次量房' : '小K正在协助量房'}}</text>
        </view>
        <view class="measure-main-row">
          <view class="measure-copy">
            <text class="measure-title">{{recentPlans.length > 0 ? recentPlans[0].name : '开始创建量房项目'}}</text>
            <text class="measure-subtitle">{{recentPlans.length > 0 ? (recentPlans[0].statusClass === 'status-completed' ? '正式户型已完成，可查看与继续编辑' : '继续完善正式户型，数据会自动同步') : '建立客户线索后，进入正式量房工作台'}}</text>
            <view class="measure-progress-row" wx:if="{{recentPlans.length > 0}}">
              <text class="measure-status">{{recentPlans[0].statusLabel}}</text>
              <text>{{recentPlans[0].areaLabel || (recentPlans[0].roomCount ? recentPlans[0].roomCount + ' 个已闭合空间' : recentPlans[0].meta)}}</text>
            </view>
          </view>
          <view class="measure-action">
            <text>{{recentPlans.length > 0 ? (recentPlans[0].statusClass === 'status-completed' ? '查看户型' : '继续量房') : '开始量房'}}</text>
            <view class="action-chevron"></view>
          </view>
        </view>
      </view>

      <view class="services-section">
        <view class="section-heading-row">
          <text class="section-title">快捷服务</text>
          <text class="section-helper">常用服务，一步到位</text>
        </view>
        <view class="service-grid">
          <view class="service-card service-leads" bindtap="onOpenLeads" hover-class="card-pressed" aria-role="button" aria-label="打开客户线索">
            <view class="service-heading">
              <image class="service-icon service-icon-leads" src="/images/home-v5/leads-icon.jpg" mode="aspectFit" />
              <view class="service-title-wrap">
                <text class="service-title service-title-coral">客户线索</text>
                <text class="service-badge service-badge-coral">{{homeLeadCount}} 条待跟进</text>
              </view>
            </view>
            <text class="service-description">管理客户，高效跟进</text>
            <view class="service-footer">
              <image class="lead-avatars" src="/images/home-v5/lead-avatars.jpg" mode="aspectFit" />
              <view class="small-action"><view class="small-chevron"></view></view>
            </view>
          </view>

          <view class="service-card service-ai" bindtap="onOpenAIDesign" hover-class="card-pressed" aria-role="button" aria-label="打开 AI 设计">
            <view class="service-heading">
              <image class="service-icon service-icon-ai" src="/images/home-v5/ai-wand.jpg" mode="aspectFit" />
              <view class="service-title-wrap">
                <text class="service-title service-title-amber">AI 设计</text>
                <text class="service-badge service-badge-amber">{{homeAiCaseCount}} 个方案待生成</text>
              </view>
            </view>
            <text class="service-description">一键生成设计方案</text>
            <image class="ai-preview" src="/images/home-v5/ai-preview.jpg" mode="aspectFill" />
          </view>

          <view class="service-card service-device" bindtap="onQuickBluetoothTap" hover-class="card-pressed" aria-role="button" aria-label="{{bleConnected ? '蓝牙设备已配对' : '连接蓝牙设备'}}">
            <view class="device-heading">
              <image class="service-icon service-icon-device" src="/images/home-v5/bluetooth-mark.jpg" mode="aspectFit" />
              <view class="service-title-wrap">
                <text class="service-title service-title-green">设备连接</text>
                <text class="service-badge service-badge-green">{{bleConnected ? '已配对' : '待连接'}}</text>
              </view>
            </view>
            <text class="service-description">连接设备，开始量房</text>
            <view class="device-summary">
              <image class="laser-device" src="/images/home-v5/laser-device.jpg" mode="aspectFit" />
              <view class="device-copy">
                <text class="device-name">激光仪</text>
                <text class="device-status">{{bleStatusText}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="ongoing-section">
        <view class="section-heading-row">
          <view class="section-title-group"><text class="section-title">项目进度</text><view class="section-pin"></view></view>
          <text class="section-helper">最近项目</text>
        </view>
        <view class="ongoing-card" wx:if="{{recentPlans.length > 0}}" data-id="{{recentPlans[0]._id}}" bindtap="onTapRecentPlan" hover-class="card-pressed" aria-role="button" aria-label="继续量房 {{recentPlans[0].name}}">
          <image class="plan-preview" src="/images/home-v5/plan-preview.jpg" mode="aspectFill" />
          <view class="plan-copy">
            <text class="plan-title">{{recentPlans[0].name}}</text>
            <view class="plan-location-row"><view class="plan-location-dot"></view><text>{{currentCity || '所在城市'}} · {{recentPlans[0].meta}}</text></view>
            <text class="plan-status {{recentPlans[0].statusClass}}">{{recentPlans[0].statusLabel}}</text>
            <text class="plan-detail">{{recentPlans[0].areaLabel || (recentPlans[0].roomCount ? recentPlans[0].roomCount + ' 个已闭合空间' : '最近更新的正式户型')}}</text>
            <view class="plan-action-row"><text>{{recentPlans[0].statusClass === 'status-completed' ? '查看户型' : '进入项目'}}</text><view class="plan-action-chevron"></view></view>
          </view>
        </view>
        <view class="ongoing-card ongoing-empty" wx:else bindtap="onPrimaryMeasureTap" hover-class="card-pressed" aria-role="button" aria-label="创建第一套正式量房户型">
          <image class="plan-preview empty-plan-preview" src="/images/home-v5/plan-preview.jpg" mode="aspectFill" />
          <view class="plan-copy empty-plan-copy">
            <text class="plan-title">还没有进行中的量房</text>
            <text class="empty-description">创建客户线索后，即可开始正式测量并保存户型。</text>
            <view class="empty-action"><text>开始量房</text><view class="plan-action-chevron"></view></view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
  <ble-connector show="{{showBLEConnector}}" bindclose="onCloseBLEConnector" bindsuccess="onBLESuccess" />
</view>
