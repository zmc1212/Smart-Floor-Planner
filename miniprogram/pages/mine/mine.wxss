.container {
  min-height: 100vh;
  background-color: #ffffff;
  padding-bottom: 60rpx;
}

/* ===== Profile Header ===== */
.profile-header {
  padding: 80rpx 40rpx 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.profile-main {
  display: flex;
  align-items: center;
}

.avatar-wrapper {
  padding: 0;
  margin: 0;
  width: 140rpx !important;
  height: 140rpx !important;
  border-radius: 70rpx;
  background-color: #f5f5f5;
  position: relative;
  overflow: visible;
  border: none;
  flex-shrink: 0;
}

.avatar-wrapper::after {
  border: none;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 70rpx;
  display: block;
}

.edit-badge {
  position: absolute;
  bottom: 4rpx;
  right: -4rpx;
  background-color: #171717;
  color: #fff;
  font-size: 18rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 18rpx;
  border: 4rpx solid #fff;
}

.profile-info {
  margin-left: 32rpx;
  display: flex;
  flex-direction: column;
}

.profile-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #171717;
  letter-spacing: -0.02em;
}

.identity-tag {
  background: #f4f4f5;
  color: #171717;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 100rpx;
  font-weight: 500;
}

.profile-enterprise {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 4rpx;
}

.profile-phone {
  font-size: 24rpx;
  color: #999;
  font-family: monospace;
}

.logout-icon-btn {
  padding: 10rpx;
  margin-top: 10rpx;
}

/* ===== Action Grid ===== */
.action-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
  padding: 0 40rpx;
  margin-bottom: 60rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.action-item.full {
  grid-column: span 4;
  flex-direction: row;
  background: #f8fafc;
  width: 100%;
  padding: 24rpx 32rpx;
  border-radius: 20rpx;
  box-sizing: border-box;
  box-shadow: 0 0 0 1rpx rgba(0,0,0,0.05);
}

.action-icon {
  width: 90rpx;
  height: 90rpx;
  background: #ffffff;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #171717;
  box-shadow: 0 0 0 1rpx rgba(0,0,0,0.08);
}

.action-icon.primary {
  background: #171717;
  color: #ffffff;
  box-shadow: none;
}

.action-label {
  font-size: 22rpx;
  color: #666;
  font-weight: 500;
}

.action-item.full .action-label {
  font-size: 28rpx;
  color: #171717;
}

/* ===== Workbench Mini Grid ===== */
.workbench-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  padding: 0 40rpx;
  margin-bottom: 60rpx;
}

.workbench-card-mini {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 0 0 1rpx rgba(0,0,0,0.08);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.wb-mini-label {
  font-size: 22rpx;
  color: #999;
  font-weight: 500;
}

.wb-mini-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #171717;
  letter-spacing: -0.02em;
}

/* ===== Sections ===== */
.floorplan-section {
  padding-top: 20rpx;
}

.section-header {
  padding: 0 40rpx;
  margin-bottom: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #171717;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.section-count {
  font-size: 22rpx;
  color: #999;
}

.floorplan-list {
  padding: 0 40rpx;
}

.floorplan-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 0 0 1rpx rgba(0,0,0,0.08);
  display: flex;
  align-items: center;
}

.card-body {
  display: flex;
  align-items: center;
  width: 100%;
}

.fp-icon-container {
  width: 80rpx;
  height: 80rpx;
  background: #f4f4f5;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.fp-emoji {
  font-size: 32rpx;
  font-weight: 700;
}

.fp-content {
  flex: 1;
  min-width: 0;
}

.fp-title-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 4rpx;
}

.fp-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #171717;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.status-tag {
  font-size: 18rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-weight: 600;
  background: #f4f4f5;
  color: #71717a;
}

.status-tag.converted {
  background: #eff6ff;
  color: #2563eb;
}

.status-tag.draft {
  background: #fff1f2;
  color: #e11d48;
}

.fp-info-line {
  font-size: 22rpx;
  color: #999;
}

.login-section {
  padding: 160rpx 60rpx;
  text-align: center;
}

.login-logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  margin-bottom: 40rpx;
}

.login-title {
  font-size: 48rpx;
  font-weight: 800;
  letter-spacing: -0.04em;
  margin-bottom: 12rpx;
}

.login-subtitle {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 60rpx;
}

.login-btn {
  background: #171717;
  color: #fff;
  border-radius: 12rpx;
  font-weight: 600;
  height: 100rpx;
  line-height: 100rpx;
}
