page {
  height: 100%;
  overflow-y: auto !important;
  background-color: var(--bg-page);
}

.container {
  min-height: 100%;
  padding-bottom: 120rpx;
}

/* ===== Profile Header ===== */
.profile-header {
  padding: 80rpx 40rpx 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  background: var(--bg-surface);
  border-bottom-left-radius: var(--radius-xl);
  border-bottom-right-radius: var(--radius-xl);
  box-shadow: var(--shadow-card);
  margin-bottom: 30rpx;
}

.profile-main {
  display: flex;
  align-items: center;
}

.avatar-wrapper {
  padding: 0;
  margin: 0;
  width: 140rpx !important;
  height: 140rpx !important;
  border-radius: var(--radius-full);
  background-color: var(--neutral-100);
  position: relative;
  overflow: visible;
  border: 4rpx solid var(--neutral-0);
  box-shadow: var(--shadow-card);
  flex-shrink: 0;
}

.avatar-wrapper::after {
  border: none;
}

.avatar {
  width: 132rpx;
  height: 132rpx;
  border-radius: var(--radius-full);
  display: block;
}

.edit-badge {
  position: absolute;
  bottom: 4rpx;
  right: -4rpx;
  background-color: var(--brand-primary);
  color: var(--text-inverse);
  font-size: 18rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: var(--radius-full);
  border: 4rpx solid var(--neutral-0);
  font-weight: var(--font-weight-bold);
}

.profile-info {
  margin-left: 32rpx;
  display: flex;
  flex-direction: column;
}

.profile-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.profile-name {
  font-size: 36rpx;
  font-weight: var(--font-weight-bold);
  color: var(--neutral-900);
  letter-spacing: -0.02em;
}

.identity-tag {
  background: var(--bg-brand-soft);
  color: var(--brand-primary);
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-full);
  font-weight: var(--font-weight-medium);
}

.profile-enterprise {
  font-size: 24rpx;
  color: var(--neutral-500);
  margin-bottom: 4rpx;
}

.profile-phone {
  font-size: 24rpx;
  color: var(--neutral-300);
  font-family: 'Geist Mono', monospace;
}

.logout-icon-btn {
  padding: 16rpx;
  background: var(--neutral-100);
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== Action Grid ===== */
.action-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
  padding: 0 32rpx;
  margin-bottom: 40rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.action-item.full {
  grid-column: span 4;
  flex-direction: row;
  background: var(--bg-surface);
  width: 100%;
  padding: 30rpx 32rpx;
  border-radius: var(--radius-lg);
  box-sizing: border-box;
  box-shadow: var(--shadow-card);
  margin-bottom: 10rpx;
}

.action-icon {
  width: 88rpx;
  height: 88rpx;
  background: var(--bg-surface);
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: var(--font-weight-bold);
  color: var(--brand-primary);
  box-shadow: var(--shadow-card);
}

.action-icon.primary {
  background: var(--brand-primary);
  color: var(--text-inverse);
  box-shadow: 0 8rpx 16rpx rgba(34, 197, 94, 0.2);
}

.action-label {
  font-size: 24rpx;
  color: var(--neutral-700);
  font-weight: var(--font-weight-medium);
}

.action-item.full .action-label {
  font-size: 28rpx;
  color: var(--neutral-900);
  flex: 1;
}

/* ===== Workbench Mini Grid ===== */
.workbench-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  padding: 0 32rpx;
  margin-bottom: 40rpx;
}

.workbench-card-mini {
  background: var(--bg-surface);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-card);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
}

.wb-mini-label {
  font-size: 24rpx;
  color: var(--neutral-500);
  font-weight: var(--font-weight-medium);
}

.wb-mini-value {
  font-size: 44rpx;
  font-weight: var(--font-weight-bold);
  color: var(--brand-primary);
  letter-spacing: -0.02em;
}

/* ===== Sections ===== */
.floorplan-section {
  padding-top: 20rpx;
}

.section-header {
  padding: 0 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-title {
  font-size: 32rpx;
  font-weight: var(--font-weight-bold);
  color: var(--neutral-900);
  position: relative;
  padding-left: 20rpx;
}

.section-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 32rpx;
  background: var(--brand-primary);
  border-radius: var(--radius-full);
}

.section-count {
  font-size: 24rpx;
  color: var(--neutral-500);
  background: var(--neutral-100);
  padding: 4rpx 16rpx;
  border-radius: var(--radius-full);
}

.floorplan-list {
  padding: 0 32rpx;
}

.floorplan-card {
  background: var(--bg-surface);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
  display: flex;
  align-items: center;
  transition: all 0.2s ease;
}

.floorplan-card:active {
  transform: scale(0.98);
  box-shadow: none;
}

.card-body {
  display: flex;
  align-items: center;
  width: 100%;
}

.fp-icon-container {
  width: 96rpx;
  height: 96rpx;
  background: var(--bg-surface-soft);
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.fp-emoji {
  font-size: 36rpx;
  font-weight: var(--font-weight-bold);
}

.fp-content {
  flex: 1;
  min-width: 0;
}

.fp-title-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.fp-name {
  font-size: 30rpx;
  font-weight: var(--font-weight-bold);
  color: var(--neutral-900);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.status-tag {
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-full);
  font-weight: var(--font-weight-medium);
}

.status-tag.converted {
  background: var(--status-measuring-bg);
  color: var(--status-measuring-text);
}

.status-tag.designing {
  background: var(--status-designing-bg);
  color: var(--status-designing-text);
}

.status-tag.draft {
  background: var(--status-cancelled-bg);
  color: var(--status-cancelled-text);
}

.fp-info-line {
  font-size: 24rpx;
  color: var(--neutral-500);
  display: flex;
  align-items: center;
}

.fp-dot {
  margin: 0 12rpx;
  opacity: 0.3;
}

/* ===== Login Section ===== */
.login-section {
  min-height: 100vh;
  padding: 120rpx 60rpx;
  text-align: center;
  background-color: var(--bg-page);
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.login-icon {
  width: 220rpx;
  height: 220rpx;
  background: var(--bg-surface);
  border-radius: var(--radius-xl);
  margin: 0 auto 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-float);
  position: relative;
}

.login-logo {
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--radius-lg);
}

.login-title {
  font-size: 56rpx;
  font-weight: var(--font-weight-bold);
  color: var(--neutral-900);
  letter-spacing: -0.04em;
  margin-bottom: 20rpx;
}

.login-subtitle {
  font-size: 32rpx;
  color: var(--neutral-500);
  margin-bottom: 100rpx;
  line-height: 1.5;
}

.login-btn {
  background: var(--brand-primary) !important;
  color: var(--text-inverse) !important;
  border-radius: var(--radius-lg) !important;
  font-weight: var(--font-weight-bold) !important;
  height: 110rpx !important;
  line-height: 110rpx !important;
  font-size: 34rpx !important;
  box-shadow: 0 16rpx 32rpx rgba(34, 197, 94, 0.25) !important;
  width: 100% !important;
}

.login-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 8rpx 16rpx rgba(34, 197, 94, 0.2) !important;
}

/* ===== Logout Section ===== */
.logout-section {
  margin: 60rpx 32rpx;
  padding-bottom: 60rpx;
}

.logout-btn-large {
  width: 100% !important;
  height: 100rpx;
  background-color: var(--bg-surface);
  color: #EF4444;
  border-radius: var(--radius-lg);
  font-size: 30rpx;
  font-weight: var(--font-weight-medium);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-card);
  border: 1rpx solid rgba(239, 68, 68, 0.1);
}

.logout-btn-large::after {
  display: none;
}

/* ===== Empty State ===== */
.empty-wrapper {
  padding: 32rpx;
  margin-top: 20rpx;
}

.empty-state-card {
  background: var(--bg-surface);
  border-radius: var(--radius-xl);
  padding: 100rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-shadow: var(--shadow-card);
}

.empty-icon-box {
  width: 160rpx;
  height: 160rpx;
  background: var(--bg-surface-soft);
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 48rpx;
}

.empty-emoji {
  font-size: 64rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: var(--font-weight-bold);
  color: var(--neutral-900);
  margin-bottom: 20rpx;
}

.empty-subtitle {
  font-size: 26rpx;
  color: var(--neutral-500);
  line-height: 1.6;
  max-width: 480rpx;
  margin-bottom: 48rpx;
}

.empty-action {
  font-size: 28rpx;
  font-weight: var(--font-weight-bold);
  color: var(--brand-primary);
  padding: 20rpx 48rpx;
  background: var(--bg-surface-soft);
  border-radius: var(--radius-full);
}

.empty-action:active {
  opacity: 0.8;
}

/* ===== Settings Section ===== */
.settings-list {
  margin: 40rpx 32rpx;
  background: var(--bg-surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 36rpx 32rpx;
  border-bottom: 1rpx solid var(--neutral-100);
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-item:active {
  background-color: var(--neutral-50);
}

.setting-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.setting-icon {
  font-size: 32rpx;
}

.setting-label {
  font-size: 28rpx;
  color: var(--neutral-900);
  font-weight: var(--font-weight-medium);
}

.setting-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.setting-status {
  font-size: 24rpx;
  color: var(--brand-primary);
  font-weight: var(--font-weight-medium);
}

.arrow-icon {
  width: 12rpx;
  height: 12rpx;
  border-top: 3rpx solid var(--neutral-300);
  border-right: 3rpx solid var(--neutral-300);
  transform: rotate(45deg);
}

/* User FloorPlan Specific */
.empty-container {
  padding: 120rpx 60rpx;
  text-align: center;
}

.empty-visual {
  margin-bottom: 60rpx;
}

.empty-circle {
  width: 200rpx;
  height: 200rpx;
  background: var(--bg-surface-soft);
  border-radius: var(--radius-full);
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
}

.primary-btn {
  background: var(--brand-primary) !important;
  color: var(--text-inverse) !important;
  border-radius: var(--radius-lg) !important;
  font-weight: var(--font-weight-bold) !important;
  height: 100rpx !important;
  line-height: 100rpx !important;
  font-size: 32rpx !important;
  box-shadow: 0 12rpx 24rpx rgba(34, 197, 94, 0.2) !important;
  margin-top: 60rpx !important;
}

.card-actions {
  display: flex;
  align-items: center;
  margin-left: 20rpx;
}

.ai-gen-btn {
  background: var(--bg-brand-soft);
  color: var(--brand-primary);
  padding: 12rpx 24rpx;
  border-radius: var(--radius-full);
  font-size: 22rpx;
  font-weight: var(--font-weight-bold);
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.ai-stars {
  font-size: 20rpx;
}

