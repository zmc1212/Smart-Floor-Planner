page {
  height: 100%;
  overflow-y: auto !important;
  background:
    linear-gradient(180deg, #fcfdfb 0%, #f5f7f4 46%, var(--bg-page) 100%);
}

.container {
  min-height: 100%;
  padding: 20rpx 20rpx 120rpx;
  box-sizing: border-box;
}

/* ===== Profile Header ===== */
.profile-header {
  padding: 32rpx 26rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  background:
    radial-gradient(circle at 82% 18%, rgba(168, 230, 191, 0.36) 0%, rgba(168, 230, 191, 0) 34%),
    linear-gradient(135deg, #eff9ef 0%, #edf8f2 48%, #f9fbf9 100%);
  border: 1rpx solid rgba(207, 220, 207, 0.55);
  border-radius: 24rpx;
  box-shadow: var(--shadow-home-card);
  margin-bottom: 16rpx;
  box-sizing: border-box;
}

.profile-main {
  display: flex;
  align-items: center;
  min-width: 0;
}

.avatar-wrapper {
  padding: 0;
  margin: 0;
  width: 128rpx !important;
  height: 128rpx !important;
  border-radius: var(--radius-full);
  background-color: var(--brand-primary-20);
  position: relative;
  overflow: visible;
  border: 6rpx solid rgba(255, 255, 255, 0.86);
  box-shadow: 0 10rpx 24rpx rgba(90, 110, 92, 0.12);
  flex-shrink: 0;
}

.avatar-wrapper::after {
  border: none;
}

.avatar {
  width: 116rpx;
  height: 116rpx;
  border-radius: var(--radius-full);
  display: block;
}

.edit-badge {
  position: absolute;
  bottom: 2rpx;
  right: -6rpx;
  background-color: var(--brand-primary);
  color: var(--text-inverse);
  font-size: 18rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: var(--radius-full);
  border: 4rpx solid var(--neutral-0);
  font-weight: 600;
}

.profile-info {
  margin-left: 22rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.profile-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 8rpx;
  min-width: 0;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #20262d;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 300rpx;
}

.identity-tag {
  background: rgba(34, 197, 94, 0.12);
  color: #17a14c;
  font-size: 20rpx;
  padding: 5rpx 14rpx;
  border-radius: var(--radius-full);
  font-weight: 500;
  flex-shrink: 0;
}

.profile-enterprise {
  font-size: 24rpx;
  color: #6f7782;
  margin-bottom: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.profile-phone {
  font-size: 24rpx;
  color: #9aa1aa;
  font-family: 'SFMono-Regular', 'Roboto Mono', Menlo, monospace;
}

.logout-icon-btn {
  width: 64rpx;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.84);
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(26, 35, 24, 0.05);
  flex-shrink: 0;
}

/* ===== Action Grid ===== */
.action-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.action-item {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 18rpx 8rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(207, 220, 207, 0.55);
  border-radius: 20rpx;
  box-shadow: var(--shadow-home-card);
  box-sizing: border-box;
}

.action-item.full {
  grid-column: span 4;
  flex-direction: row;
  width: 100%;
  padding: 22rpx;
  margin-bottom: 0;
}

.action-icon {
  width: 64rpx;
  height: 64rpx;
  background: rgba(34, 197, 94, 0.12);
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #17a14c;
  flex-shrink: 0;
}

.action-icon.primary {
  background: linear-gradient(135deg, #0fb04d 0%, #18a94b 100%);
  color: var(--text-inverse);
  box-shadow: 0 10rpx 20rpx rgba(17, 164, 66, 0.18);
}

.action-label {
  font-size: 23rpx;
  color: #5e6975;
  font-weight: 500;
  text-align: center;
}

.action-item.full .action-label {
  font-size: 28rpx;
  color: #20262d;
  flex: 1;
  text-align: left;
}

/* ===== Workbench Mini Grid ===== */
.workbench-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  padding: 0 0 18rpx;
}

.workbench-card-mini {
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(207, 220, 207, 0.55);
  border-radius: 20rpx;
  padding: 20rpx;
  box-shadow: var(--shadow-home-card);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  box-sizing: border-box;
}

.wb-mini-label {
  font-size: 22rpx;
  color: #8a919c;
  font-weight: 500;
}

.wb-mini-value {
  font-size: 38rpx;
  font-weight: 600;
  color: #17a14c;
}

/* ===== Sections ===== */
.floorplan-section {
  padding-top: 0;
}

.section-header {
  padding: 0 4rpx;
  margin: 18rpx 0 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #21262d;
}

.section-title::before {
  display: none;
}

.section-count {
  font-size: 22rpx;
  color: #7e8793;
  background: rgba(255, 255, 255, 0.84);
  padding: 6rpx 16rpx;
  border-radius: var(--radius-full);
}

.floorplan-list {
  padding: 0;
}

.floorplan-card {
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(207, 220, 207, 0.55);
  border-radius: 22rpx;
  padding: 20rpx;
  margin-bottom: 14rpx;
  box-shadow: var(--shadow-home-card);
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.floorplan-card:active {
  transform: translateY(1rpx);
  opacity: 0.92;
}

.card-body {
  display: flex;
  align-items: center;
  width: 100%;
  min-width: 0;
}

.fp-icon-container {
  width: 72rpx;
  height: 72rpx;
  background: rgba(34, 197, 94, 0.12);
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
  color: #17a14c;
}

.fp-emoji {
  font-size: 30rpx;
  font-weight: 600;
}

.fp-content {
  flex: 1;
  min-width: 0;
}

.fp-title-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.fp-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #20262d;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.status-tag {
  font-size: 20rpx;
  padding: 5rpx 14rpx;
  border-radius: var(--radius-full);
  font-weight: 500;
  flex-shrink: 0;
}

.status-tag.converted {
  background: var(--status-measuring-bg);
  color: var(--status-measuring-text);
}

.status-tag.designing {
  background: var(--status-designing-bg);
  color: var(--status-designing-text);
}

.status-tag.draft {
  background: var(--status-cancelled-bg);
  color: var(--status-cancelled-text);
}

.fp-info-line {
  font-size: 23rpx;
  color: #8a919c;
  display: flex;
  align-items: center;
  min-width: 0;
}

.fp-date,
.fp-rooms {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.fp-dot {
  margin: 0 10rpx;
  opacity: 0.35;
}

/* ===== Login Section ===== */
.login-section {
  padding: 40rpx 0;
}

.login-card {
  background:
    radial-gradient(circle at 70% 18%, rgba(168, 230, 191, 0.34) 0%, rgba(168, 230, 191, 0) 36%),
    linear-gradient(135deg, #eff9ef 0%, #edf8f2 48%, #f9fbf9 100%);
  border: 1rpx solid rgba(207, 220, 207, 0.55);
  border-radius: 24rpx;
  padding: 70rpx 34rpx;
  box-shadow: var(--shadow-home-card);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  margin-bottom: 22rpx;
}

.login-icon {
  width: 150rpx;
  height: 150rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 34rpx;
  margin-bottom: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(90, 110, 92, 0.12);
}

.login-logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
}

.login-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #20262d;
  margin-bottom: 12rpx;
}

.login-subtitle {
  font-size: 26rpx;
  color: #6f7782;
  margin-bottom: 42rpx;
}

.login-features {
  display: flex;
  justify-content: center;
  gap: 14rpx;
  flex-wrap: wrap;
}

.feature-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 23rpx;
  color: #7e8793;
  background: rgba(255, 255, 255, 0.84);
  padding: 10rpx 16rpx;
  border-radius: var(--radius-full);
}

.feature-dot {
  color: var(--brand-primary);
  font-size: 18rpx;
}

.login-btn {
  background: linear-gradient(135deg, #0fb04d 0%, #18a94b 100%) !important;
  color: var(--text-inverse) !important;
  border-radius: var(--radius-full) !important;
  font-weight: 500 !important;
  height: 92rpx !important;
  font-size: 30rpx !important;
  box-shadow: 0 10rpx 24rpx rgba(17, 164, 66, 0.22) !important;
  width: 100% !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  padding: 0 !important;
  margin: 0 auto !important;
}

.login-btn:active {
  transform: translateY(1rpx);
}

/* ===== Logout Section ===== */
.logout-section {
  margin: 28rpx 0 0;
  padding-bottom: 40rpx;
}

.logout-btn-large {
  width: 100% !important;
  height: 92rpx;
  background-color: rgba(255, 255, 255, 0.94);
  color: #ef4444;
  border-radius: var(--radius-full);
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-home-card);
  border: 1rpx solid rgba(239, 68, 68, 0.1);
}

.logout-btn-large::after {
  display: none;
}

/* ===== Empty State ===== */
.empty-wrapper {
  padding: 0;
  margin-top: 14rpx;
}

.empty-state-card {
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(207, 220, 207, 0.55);
  border-radius: 24rpx;
  padding: 76rpx 34rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-shadow: var(--shadow-home-card);
}

.empty-icon-box {
  width: 136rpx;
  height: 136rpx;
  background: var(--brand-primary-20);
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 34rpx;
}

.empty-emoji {
  font-size: 56rpx;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #20262d;
  margin-bottom: 16rpx;
}

.empty-subtitle {
  font-size: 25rpx;
  color: #6f7782;
  line-height: 1.6;
  max-width: 520rpx;
  margin-bottom: 34rpx;
}

.empty-action {
  font-size: 27rpx;
  font-weight: 500;
  color: var(--text-inverse);
  padding: 18rpx 44rpx;
  background: linear-gradient(135deg, #0fb04d 0%, #18a94b 100%);
  border-radius: var(--radius-full);
  box-shadow: 0 10rpx 20rpx rgba(17, 164, 66, 0.18);
}

.empty-action:active {
  opacity: 0.88;
}

/* ===== Settings Section ===== */
.settings-list {
  margin: 22rpx 0;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(207, 220, 207, 0.55);
  border-radius: 22rpx;
  box-shadow: var(--shadow-home-card);
  overflow: hidden;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid rgba(228, 233, 230, 0.92);
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-item:active {
  background-color: rgba(234, 248, 236, 0.5);
}

.setting-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.setting-icon {
  font-size: 30rpx;
}

.setting-label {
  font-size: 27rpx;
  color: #20262d;
  font-weight: 500;
}

.setting-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.setting-status {
  font-size: 23rpx;
  color: #17a14c;
  font-weight: 500;
}

.arrow-icon {
  width: 12rpx;
  height: 12rpx;
  border-top: 3rpx solid #c1c7ce;
  border-right: 3rpx solid #c1c7ce;
  transform: rotate(45deg);
  flex-shrink: 0;
}

/* User FloorPlan Specific */
.empty-container {
  margin-top: 20rpx;
  padding: 76rpx 36rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(207, 220, 207, 0.55);
  border-radius: 24rpx;
  box-shadow: var(--shadow-home-card);
}

.empty-visual {
  margin-bottom: 38rpx;
}

.empty-circle {
  width: 170rpx;
  height: 170rpx;
  background: var(--bg-surface-soft);
  border-radius: var(--radius-full);
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
}

.primary-btn {
  background: linear-gradient(135deg, #0fb04d 0%, #18a94b 100%) !important;
  color: var(--text-inverse) !important;
  border-radius: var(--radius-full) !important;
  font-weight: 500 !important;
  height: 92rpx !important;
  line-height: 92rpx !important;
  font-size: 30rpx !important;
  box-shadow: 0 10rpx 24rpx rgba(17, 164, 66, 0.22) !important;
  margin-top: 42rpx !important;
}

.card-actions {
  display: flex;
  align-items: center;
  margin-left: 14rpx;
  flex-shrink: 0;
}

.ai-gen-btn {
  background: rgba(34, 197, 94, 0.12);
  color: #17a14c;
  padding: 12rpx 20rpx;
  border-radius: var(--radius-full);
  font-size: 22rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 6rpx;
  white-space: nowrap;
}

.ai-stars {
  font-size: 18rpx;
}
