<!--
THESIS: “我的”是身份管家与账号中心，顶部保留资料卡，下方集中权限与账号入口。
OWN-WORLD: 柔白底、清透薄荷场景、绿/蓝/橙/紫四组工具色，以及来自 v6 参考稿的真实室内切图。
STORY: 用户确认身份，扫描进度，进入角色化工具，处理待办，并在同一页完成账号与系统权限管理。
FIRST VIEWPORT: 标题操作区与室内场景融合；半透明资料卡压住场景；账号菜单紧随其后或接在工作台内容之后。
FORM: Operate 模式的专业个人工作台，严格继承 miniprogram-mine-v6 的层级和构图。
-->
<template name="mineAccountPanel">
  <view class="mine-account-panel">
    <view class="account-section-title">权限</view>
    <view class="account-surface">
      <view class="account-row" hover-class="account-row-pressed" bindtap="onOpenSystemSettings" aria-role="button">
        <image class="account-row-icon" src="/images/mine-v6/settings.png" mode="aspectFit" />
        <view class="account-row-copy">
          <view class="account-row-label">微信权限管理</view>
          <view class="account-row-helper">查看通知、相册等系统授权</view>
        </view>
        <view class="account-chevron"></view>
      </view>
    </view>

    <view class="account-section-title">账号</view>
    <view class="account-surface">
      <view class="account-row" hover-class="account-row-pressed" bindtap="onEditProfile" aria-role="button">
        <image class="account-row-icon" src="/images/mine-icons/edit.png" mode="aspectFit" />
        <view class="account-row-copy">
          <view class="account-row-label">编辑资料</view>
          <view class="account-row-helper">修改头像、昵称和个人资料</view>
        </view>
        <view class="account-chevron"></view>
      </view>
      <view class="account-row" hover-class="account-row-pressed" bindtap="onOpenIdentitySwitch" aria-role="button">
        <image class="account-row-icon" src="/images/mine-icons/users.png" mode="aspectFit" />
        <view class="account-row-copy">
          <view class="account-row-label">当前身份</view>
          <view class="account-row-helper">在个人用户、员工和推荐人身份之间切换</view>
        </view>
        <view class="account-chevron"></view>
      </view>
      <view class="account-row" hover-class="account-row-pressed" bindtap="onOpenAccountSecurity" aria-role="button">
        <image class="account-row-icon" src="/images/mine-icons/shield-check.png" mode="aspectFit" />
        <view class="account-row-copy">
          <view class="account-row-label">账号与安全</view>
          <view class="account-row-helper">查看登录账号、手机号和密码设置</view>
        </view>
        <view class="account-chevron"></view>
      </view>
    </view>

    <button class="danger-action mine-logout-action" bindtap="onLogout">退出当前账号</button>
  </view>
</template>

<view class="mine-page {{isLoggedIn ? 'sfp-tab-page' : 'guest-page'}}">
  <scroll-view class="mine-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view wx:if="{{!isLoggedIn}}" class="login-state">
      <view
        class="guest-brand-lockup"
        style="padding-top: {{navigationTop}}px; min-height: {{navigationHeight}}px;"
        aria-label="JoveKore，家客来"
      >
        <image class="guest-brand-logo" src="/images/home-ip-v1/brand-logo.png" mode="aspectFit" />
        <view class="guest-brand-name"><text>JoveKore</text><text class="guest-brand-divider">｜</text><text>家客来</text></view>
      </view>
      <view class="login-visual" aria-hidden="true">
        <image class="login-visual-image" src="/images/home-ip-v1/login-identity-portal-v2.jpg" mode="aspectFill" />
      </view>
      <view class="login-panel">
        <view class="login-title">登录后，打开你的专属工作台</view>
        <view class="login-subtitle">客户、量房与方案进度，都会跟着你的身份进入</view>

        <view class="identity-rail" aria-label="登录后可匹配个人用户、员工或推荐人身份">
          <view class="identity-track" aria-hidden="true"></view>
          <view class="identity-options">
            <view class="identity-option">
              <view class="identity-icon-shell">
                <image src="/images/mine-icons/identity-personal-user.png" mode="aspectFit" />
              </view>
              <text>个人用户</text>
            </view>
            <view class="identity-option">
              <view class="identity-icon-shell">
                <image src="/images/mine-icons/identity-staff.png" mode="aspectFit" />
              </view>
              <text>员工</text>
            </view>
            <view class="identity-option">
              <view class="identity-icon-shell">
                <image src="/images/mine-icons/identity-referrer.png" mode="aspectFit" />
              </view>
              <text>推荐人</text>
            </view>
          </view>
          <view class="identity-match-note">
            <view class="identity-note-line"></view>
            <text>登录后自动匹配身份</text>
            <view class="identity-note-line"></view>
          </view>
        </view>

        <button class="primary-button login-button" bindtap="goToLogin">立即登录</button>
        <view class="login-trust-note"><view class="login-trust-mark"></view><text>一个账号 · 多重身份 · 随时切换</text></view>
      </view>
    </view>

    <view wx:else class="mine-content">
      <view wx:if="{{loadingMine}}" class="loading-state" aria-label="正在加载工作台">
        <view class="skeleton skeleton-hero"></view>
        <view class="skeleton skeleton-stats"></view>
        <view class="skeleton skeleton-section"></view>
      </view>

      <view wx:elif="{{mineError}}" class="request-error">
        <image class="request-error-icon" src="/images/mine-icons/clipboard-pen.png" mode="aspectFit" />
        <view class="request-error-title">工作台暂时无法加载</view>
        <view class="request-error-message">{{mineError}}</view>
        <button class="retry-button" bindtap="retryMine">重新加载</button>
      </view>

      <view wx:elif="{{isStaff}}" class="staff-dashboard">
        <view class="profile-hero">
          <image class="profile-scene" src="/images/mine-v6/profile-scene.jpg" mode="aspectFill" aria-hidden="true" />
          <view class="profile-scene-fade" aria-hidden="true"></view>
          <image class="mine-role-scene" src="/images/page-ip-v3/mine.png" mode="aspectFit" aria-hidden="true" />

          <view
            class="mine-header"
            style="margin-top: {{navigationTop}}px; min-height: {{navigationHeight}}px; padding-right: {{navigationRight}}px;"
          >
            <view class="mine-title">我的</view>
          </view>

          <view class="profile-card">
            <image class="avatar" src="{{mineData.profile.avatar || defaultAvatarUrl}}" mode="aspectFill" />
            <view class="profile-copy">
              <view class="profile-name-row">
                <text class="profile-name">{{mineData.profile.name}}</text>
                <text class="role-badge">{{mineData.profile.roleLabel}}</text>
              </view>
              <view class="profile-detail-row">
                <image src="/images/mine-icons/building.png" mode="aspectFit" />
                <text>{{mineData.profile.enterpriseName}}</text>
              </view>
              <view class="profile-detail-row verified">
                <image src="/images/mine-icons/shield-check.png" mode="aspectFit" />
                <text>{{mineData.profile.phoneMasked || '企业身份已验证'}}</text>
              </view>
            </view>
          </view>
        </view>

        <scroll-view wx:if="{{!isRoleShellMine}}" class="stats-scroll" scroll-x enhanced show-scrollbar="{{false}}">
          <view class="stats-row">
            <view
              wx:for="{{summaryCards}}"
              wx:key="key"
              class="stat-card tone-summary-{{index}}"
              data-target="{{item.target}}"
              bindtap="onTapCard"
              aria-role="button"
              aria-label="{{item.label}}{{item.value}}{{item.unit}}"
            >
              <view class="stat-label">{{item.label}}</view>
              <view class="stat-value"><text>{{item.value}}</text><text>{{item.unit}}</text></view>
              <image class="stat-illustration" src="{{item.illustration}}" mode="aspectFit" aria-hidden="true" />
            </view>
          </view>
        </scroll-view>

        <view wx:if="{{!isRoleShellMine}}" class="surface-section workbench-section">
          <view class="section-heading-row">
            <view class="section-title">我的工作台</view>
            <view class="section-meta all-tools-label">
              <text>全部工具</text>
              <view class="css-chevron"></view>
            </view>
          </view>
          <view class="tool-grid">
            <view
              wx:for="{{workbenchActions}}"
              wx:key="key"
              class="tool-item {{item.toneClass}}"
              data-target="{{item.target}}"
              bindtap="onTapAction"
              aria-role="button"
              aria-label="{{item.label}}"
            >
              <view class="tool-icon">
                <image src="{{item.iconPath}}" mode="aspectFit" />
                <view wx:if="{{item.badgeCount}}" class="tool-badge">{{item.badgeCount > 99 ? '99+' : item.badgeCount}}</view>
              </view>
              <view class="tool-label">{{item.label}}</view>
              <view class="tool-sublabel">{{item.sublabel}}</view>
            </view>
          </view>
        </view>

        <view wx:if="{{!isRoleShellMine}}" class="surface-section todo-section">
          <view class="section-heading-row">
            <view class="section-title">我的待办</view>
            <view class="section-link" bindtap="onOpenAllTodos" aria-role="button">
              <text>全部待办</text>
              <view class="css-chevron"></view>
            </view>
          </view>

          <view wx:if="{{displayTodos.length}}" class="todo-list">
            <view
              wx:for="{{displayTodos}}"
              wx:key="recordId"
              class="todo-item"
              data-id="{{item.recordId}}"
              bindtap="onOpenTodoDetail"
              aria-role="button"
              aria-label="处理{{item.title}}"
            >
              <view class="todo-time tone-{{item.statusTone}}">
                <view class="todo-time-day">{{item.dayLabel}}</view>
                <view class="todo-time-hour">{{item.timeLabel}}</view>
              </view>
              <image class="todo-thumb" src="{{item.thumbnail}}" mode="aspectFill" />
              <view class="todo-copy">
                <view class="todo-title">{{item.locationText || item.title}}</view>
                <view class="todo-kind">{{item.title}}</view>
                <view class="todo-contact">{{item.contactName || '查看任务详情'}}</view>
              </view>
              <view class="todo-status tone-{{item.statusTone}}">{{item.statusLabel}}</view>
            </view>
          </view>

          <view wx:else class="todo-empty">
            <image src="/images/mine-icons/deal.png" mode="aspectFit" />
            <view>
              <view class="todo-empty-title">暂无待办</view>
              <view class="todo-empty-caption">新的量房与设计任务会出现在这里</view>
            </view>
          </view>
        </view>

        <view wx:if="{{canUseAIDesign && !isRoleShellMine}}" class="ai-banner" bindtap="onOpenAIHome" aria-role="button" aria-label="进入 AI 设计空间">
          <image class="ai-banner-image" src="/images/mine-v6/ai-room.jpg" mode="aspectFill" />
          <view class="ai-banner-copy">
            <view class="ai-banner-kicker">AI 设计空间</view>
            <view class="ai-banner-title">让户型快速生成设计灵感</view>
            <view class="ai-banner-caption">从现有户型继续创作</view>
            <view class="ai-banner-action">去查看</view>
          </view>
          <view class="ai-banner-arrow"><view class="css-chevron"></view></view>
        </view>

        <template is="mineAccountPanel" />
      </view>

      <view wx:else class="user-dashboard">
        <view class="profile-hero user-profile-hero">
          <image class="profile-scene" src="/images/mine-v6/profile-scene.jpg" mode="aspectFill" aria-hidden="true" />
          <view class="profile-scene-fade" aria-hidden="true"></view>
          <image class="mine-role-scene" src="/images/page-ip-v3/mine.png" mode="aspectFit" aria-hidden="true" />
          <view
            class="mine-header"
            style="margin-top: {{navigationTop}}px; min-height: {{navigationHeight}}px; padding-right: {{navigationRight}}px;"
          >
            <view class="mine-title">我的</view>
          </view>
          <view class="profile-card compact-profile-card">
            <image class="avatar" src="{{mineData.profile.avatar || defaultAvatarUrl}}" mode="aspectFill" />
            <view class="profile-copy">
              <view class="profile-name-row">
                <text class="profile-name">{{mineData.profile.name || '微信用户'}}</text>
                <text class="role-badge">{{mineData.profile.roleLabel || (activeRole === 'referrer' ? '推荐人' : '个人用户')}}</text>
              </view>
              <view class="profile-detail-row verified">
                <image src="/images/mine-icons/shield-check.png" mode="aspectFit" />
                <text>{{mineData.profile.phoneMasked || '家客来'}}</text>
              </view>
            </view>
          </view>
        </view>

        <view wx:if="{{!isRoleRestrictedUser}}" class="user-summary">
          <view>
            <view class="section-meta">我的空间档案</view>
            <view wx:if="{{floorPlansLoading}}" class="user-summary-title">正在读取户型</view>
            <view wx:elif="{{floorPlansError}}" class="user-summary-title">户型信息待重试</view>
            <view wx:else class="user-summary-title">已保存 {{floorPlans.length}} 个户型</view>
            <view class="user-summary-caption">{{floorPlansError ? '请重新加载户型数据' : (canUseAIDesign ? '继续量房，或使用 AI 生成设计灵感' : '继续量房，维护空间档案')}}</view>
          </view>
          <button class="summary-action" bindtap="onCreateNew">新建量房</button>
        </view>

        <view wx:if="{{!isRoleRestrictedUser}}" class="surface-section floorplan-section">
          <view class="section-heading-row">
            <view class="section-title">我的户型</view>
            <view class="section-meta">{{floorPlans.length}} 个</view>
          </view>
          <view wx:if="{{floorPlansLoading}}" class="floorplan-loading">
            <view class="skeleton floorplan-skeleton"></view>
            <view class="skeleton floorplan-skeleton"></view>
          </view>
          <view wx:elif="{{floorPlansError}}" class="floorplan-error">
            <view class="todo-empty-title">户型暂时无法加载</view>
            <view class="todo-empty-caption">{{floorPlansError}}</view>
            <button class="inline-retry-button" bindtap="retryFloorPlans">重新加载</button>
          </view>
          <view wx:elif="{{floorPlans.length}}" class="floorplan-list">
            <view wx:for="{{floorPlans}}" wx:key="_id" class="floorplan-row" data-id="{{item._id}}" bindtap="onOpenFloorPlan" aria-role="button">
              <view class="floorplan-icon"><image src="/images/mine-icons/home.png" mode="aspectFit" /></view>
              <view class="floorplan-copy">
                <view class="floorplan-title">{{item.projectTitle}}</view>
                <view class="floorplan-meta">{{item.projectMeta}}</view>
              </view>
              <view wx:if="{{canUseAIDesign}}" class="floorplan-ai" catchtap="onAIGen" data-id="{{item._id}}" aria-role="button">AI 设计</view>
            </view>
          </view>
          <view wx:else class="todo-empty floorplan-empty">
            <image src="/images/mine-icons/home.png" mode="aspectFit" />
            <view>
              <view class="todo-empty-title">还没有保存户型</view>
              <view class="todo-empty-caption">从一次正式量房开始建立空间档案</view>
            </view>
          </view>
        </view>

        <view wx:if="{{!isRoleRestrictedUser}}" class="user-actions">
          <view class="user-action tone-green" bindtap="onCreateNew" aria-role="button">
            <image src="/images/mine-icons/home.png" mode="aspectFit" /><text>开始量房</text>
          </view>
          <view wx:if="{{canUseAIDesign}}" class="user-action tone-orange" bindtap="onOpenAIHome" aria-role="button">
            <image src="/images/mine-icons/bulb.png" mode="aspectFit" /><text>AI 设计</text>
          </view>
        </view>
        <template is="mineAccountPanel" />
      </view>
    </view>
  </scroll-view>
</view>
