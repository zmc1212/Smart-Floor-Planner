<view class="mine-page bg-page">
  <view wx:if="{{!isLoggedIn}}" class="login-state">
    <view class="login-card flex-col items-center justify-center bg-white">
      <image class="login-avatar rounded-full" src="{{defaultAvatarUrl}}" mode="aspectFill" />
      <view class="login-title text-xl font-bold text-main">智能量房大师</view>
      <view class="login-subtitle text-sm text-muted">登录后查看工作台、客户任务和我的户型</view>
      <button class="primary-btn bg-main text-white text-base rounded-full" bindtap="goToLogin">立即登录</button>
    </view>
  </view>

  <view wx:else class="mine-content">
    <view wx:if="{{isStaff}}" class="staff-dashboard flex-col gap-8">
      <view class="profile-card bg-white">
        <view class="profile-main flex-row items-center">
          <image class="avatar rounded-full" src="{{mineData.profile.avatar || defaultAvatarUrl}}" mode="aspectFill" />
          <view class="profile-text">
            <view class="name-row flex-row items-center">
              <text class="profile-name text-lg font-bold text-main">{{mineData.profile.name}}</text>
              <text class="role-badge text-xs rounded-full">{{mineData.profile.roleLabel}}</text>
            </view>
            <view class="enterprise-name text-base text-muted">{{mineData.profile.enterpriseName}}</view>
            <view class="phone-line flex-row items-center text-base text-muted">
              <image class="inline-icon" src="/images/mine-icons/tab-mine-active.png" mode="aspectFit" />
              <text>{{mineData.profile.phoneMasked || '未绑定手机号'}}</text>
            </view>
          </view>
        </view>
        <button class="edit-profile-btn flex-row items-center justify-center text-sm rounded-full" bindtap="onOpenAccountSecurity">
          <image class="button-icon" src="/images/mine-icons/edit.png" mode="aspectFit" />
          <text>编辑</text>
        </button>
        <view class="room-scene">
          <view class="scene-wall"></view>
          <view class="scene-sofa"></view>
          <view class="scene-table"></view>
          <view class="scene-plant scene-plant-left"></view>
          <view class="scene-plant scene-plant-right"></view>
        </view>
      </view>

      <view class="action-panel bg-white">
        <view
          wx:for="{{mineData.actions}}"
          wx:key="key"
          class="action-item flex-col items-center justify-center"
          data-target="{{item.target}}"
          bindtap="onTapAction"
        >
          <image class="action-icon-img" src="/images/mine-icons/{{item.icon}}.png" mode="aspectFit" />
          <view class="action-label text-base font-medium text-main">{{item.label}}</view>
          <view class="action-sub text-xs text-muted">{{item.sublabel}}</view>
        </view>
      </view>

      <view class="section-card bg-white">
        <view class="section-header flex-row items-center justify-between">
          <text class="section-title text-lg font-bold text-main">工作看板</text>
          <view class="section-more flex-row items-center gap-4 text-sm text-muted" bindtap="onOpenAllTodos">
            <text>查看全部</text>
            <text class="chevron">›</text>
          </view>
        </view>
        <view class="workbench-grid">
          <view
            wx:for="{{mineData.workbenchCards}}"
            wx:key="key"
            class="workbench-card"
            data-target="{{item.target}}"
            bindtap="onTapCard"
          >
            <view class="card-heading flex-row items-center text-xs">
              <image class="mini-icon-img" src="/images/mine-icons/{{item.icon}}.png" mode="aspectFit" />
              <text>{{item.label}}</text>
            </view>
            <view class="metric-row flex-row">
              <text class="metric-value text-xl font-bold text-main">{{item.value}}</text>
              <text class="metric-unit text-xs text-main">{{item.unit}}</text>
            </view>
            <view class="metric-delta text-xs text-muted">{{item.detailText || item.deltaText}}</view>
          </view>
        </view>
      </view>

      <view class="section-card bg-white">
        <view class="section-header flex-row items-center justify-between">
          <text class="section-title text-lg font-bold text-main">我的待办</text>
          <view class="section-more flex-row items-center gap-4 text-sm text-muted" bindtap="onOpenAllTodos">
            <text>查看全部</text>
            <text class="chevron">›</text>
          </view>
        </view>

        <view wx:if="{{mineData.todos.length > 0}}" class="todo-list">
          <view
            wx:for="{{mineData.todos}}"
            wx:key="recordId"
            class="todo-item flex-row items-center"
            data-id="{{item.recordId}}"
            bindtap="onOpenTodoDetail"
          >
            <view class="todo-icon rounded-full flex-row items-center justify-center {{item.statusTone}}">
              <image class="todo-icon-img" src="/images/mine-icons/todo-{{item.statusTone}}.png" mode="aspectFit" />
            </view>
            <view class="todo-body">
              <view class="todo-title text-base font-bold text-main">{{item.title}}</view>
              <view class="todo-desc text-sm text-muted">{{item.locationText}} · {{item.contactName}}</view>
              <view class="todo-time flex-row items-center text-sm text-muted">
                <image class="tiny-icon" src="/images/mine-icons/search.png" mode="aspectFit" />
                <text>{{item.dueLabel}}</text>
              </view>
            </view>
            <view class="todo-right flex-row items-center">
              <text class="status-pill text-sm rounded-full {{item.statusTone}}">{{item.statusLabel}}</text>
              <text class="item-chevron">›</text>
            </view>
          </view>
        </view>

        <view wx:else class="empty-mini flex-col items-center justify-center">
          <view class="empty-title text-lg font-bold text-main">暂无待办</view>
          <view class="empty-subtitle text-sm text-muted">新的报备、量房和设计任务会出现在这里</view>
        </view>
      </view>

      <view class="settings-card bg-white">
        <view class="setting-item flex-row items-center justify-between with-border" bindtap="onEnableNotification">
          <view class="setting-left flex-row items-center text-base font-medium text-main">
            <image class="setting-icon-img" src="/images/mine-icons/bulb.png" mode="aspectFit" />
            <text>业务通知提醒</text>
          </view>
          <text class="item-chevron">›</text>
        </view>
        <view class="setting-item flex-row items-center justify-between" bindtap="onOpenAccountSecurity">
          <view class="setting-left flex-row items-center text-base font-medium text-main">
            <image class="setting-icon-img" src="/images/mine-icons/tab-mine.png" mode="aspectFit" />
            <text>账号与安全</text>
          </view>
          <text class="item-chevron">›</text>
        </view>
      </view>

      <button class="logout-btn flex-row items-center justify-center text-base text-muted rounded-full" bindtap="onLogout">
        <image class="button-icon" src="/images/mine-icons/tab-leads.png" mode="aspectFit" />
        <text>切换账号 / 退出登录</text>
      </button>
    </view>

    <view wx:else class="user-dashboard flex-col gap-8">
      <view class="profile-card user-profile bg-white">
        <view class="profile-main flex-row items-center">
          <image class="avatar rounded-full" src="{{mineData.profile.avatar || defaultAvatarUrl}}" mode="aspectFill" />
          <view class="profile-text">
            <view class="name-row flex-row items-center">
              <text class="profile-name text-lg font-bold text-main">{{mineData.profile.name || '微信用户'}}</text>
              <text class="role-badge text-xs rounded-full">普通用户</text>
            </view>
            <view class="enterprise-name text-base text-muted">{{mineData.profile.phoneMasked || '智能量房大师'}}</view>
          </view>
        </view>
      </view>

      <view wx:if="{{floorPlans.length > 0}}" class="section-card bg-white">
        <view class="section-header flex-row items-center justify-between">
          <text class="section-title text-lg font-bold text-main">我的户型</text>
          <view class="section-more text-sm text-muted">{{floorPlans.length}} 份</view>
        </view>
        <view class="todo-list">
          <view
            wx:for="{{floorPlans}}"
            wx:key="_id"
            class="todo-item flex-row items-center"
            data-id="{{item._id}}"
            bindtap="onOpenFloorPlan"
          >
            <view class="todo-icon rounded-full flex-row items-center justify-center green">
              <image class="todo-icon-img" src="/images/mine-icons/home.png" mode="aspectFit" />
            </view>
            <view class="todo-body">
              <view class="todo-title text-base font-bold text-main">{{item.name}}</view>
              <view class="todo-desc text-sm text-muted">{{item.createdAt}} · {{item.roomCount}} 个空间</view>
            </view>
            <view class="todo-right flex-row items-center">
              <view class="ai-btn bg-blue text-white text-sm rounded-full" catchtap="onAIGen" data-id="{{item._id}}">AI 设计</view>
            </view>
          </view>
        </view>
      </view>

      <view wx:else class="empty-card flex-col items-center justify-center bg-white">
        <view class="empty-title text-lg font-bold text-main">开启智能测量之旅</view>
        <view class="empty-subtitle text-sm text-muted">连接蓝牙测距仪，让每一寸空间都被精准记录</view>
        <button class="primary-btn bg-main text-white text-base rounded-full" bindtap="onCreateNew">测量新户型</button>
      </view>

      <button class="logout-btn flex-row items-center justify-center text-base text-muted rounded-full" bindtap="onLogout">
        <image class="button-icon" src="/images/mine-icons/tab-leads.png" mode="aspectFit" />
        <text>切换账号 / 退出登录</text>
      </button>
    </view>
  </view>
</view>
