<view class="mine-page">
  <view wx:if="{{!isLoggedIn}}" class="login-state">
    <view class="login-card">
      <image class="login-avatar" src="{{defaultAvatarUrl}}" mode="aspectFill" />
      <view class="login-title">智能量房大师</view>
      <view class="login-subtitle">登录后查看工作台、客户任务和我的户型</view>
      <button class="primary-btn" bindtap="goToLogin">立即登录</button>
    </view>
  </view>

  <view wx:else class="mine-content">
    <view wx:if="{{isStaff}}" class="staff-dashboard">
      <view class="profile-card">
        <view class="profile-main">
          <image class="avatar" src="{{mineData.profile.avatar || defaultAvatarUrl}}" mode="aspectFill" />
          <view class="profile-text">
            <view class="name-row">
              <text class="profile-name">{{mineData.profile.name}}</text>
              <text class="role-badge">{{mineData.profile.roleLabel}}</text>
            </view>
            <view class="enterprise-name">{{mineData.profile.enterpriseName}}</view>
            <view class="phone-line">
              <image class="inline-icon" src="/images/mine1.png" mode="aspectFit" />
              <text>{{mineData.profile.phoneMasked || '未绑定手机号'}}</text>
            </view>
          </view>
        </view>
        <button class="edit-profile-btn" bindtap="onOpenAccountSecurity">
          <image class="button-icon" src="/images/mine0.png" mode="aspectFit" />
          <text>编辑</text>
        </button>
        <view class="room-scene">
          <view class="scene-wall"></view>
          <view class="scene-sofa"></view>
          <view class="scene-table"></view>
          <view class="scene-plant scene-plant-left"></view>
          <view class="scene-plant scene-plant-right"></view>
        </view>
      </view>

      <view class="action-panel">
        <view
          wx:for="{{mineData.actions}}"
          wx:key="key"
          class="action-item"
          data-target="{{item.target}}"
          bindtap="onTapAction"
        >
          <image class="action-icon-img" src="/images/mine1.png" mode="aspectFit" />
          <view class="action-label">{{item.label}}</view>
          <view class="action-sub">{{item.sublabel}}</view>
        </view>
      </view>

      <view class="section-card">
        <view class="section-header">
          <text class="section-title">工作看板</text>
          <view class="section-more" bindtap="onOpenAllTodos">查看全部 <text class="chevron">›</text></view>
        </view>
        <view class="workbench-grid">
          <view
            wx:for="{{mineData.workbenchCards}}"
            wx:key="key"
            class="workbench-card"
            data-target="{{item.target}}"
            bindtap="onTapCard"
          >
            <view class="card-heading">
              <image class="mini-icon-img" src="/images/mine1.png" mode="aspectFit" />
              <text>{{item.label}}</text>
            </view>
            <view class="metric-row">
              <text class="metric-value">{{item.value}}</text>
              <text class="metric-unit">{{item.unit}}</text>
            </view>
            <view class="metric-delta">较本月 {{item.deltaText}}</view>
          </view>
        </view>
      </view>

      <view class="section-card">
        <view class="section-header">
          <text class="section-title">我的待办</text>
          <view class="section-more" bindtap="onOpenAllTodos">查看全部 <text class="chevron">›</text></view>
        </view>

        <view wx:if="{{mineData.todos.length > 0}}" class="todo-list">
          <view
            wx:for="{{mineData.todos}}"
            wx:key="recordId"
            class="todo-item"
            data-id="{{item.recordId}}"
            bindtap="onOpenTodoDetail"
          >
            <view class="todo-icon {{item.statusTone}}">
              <image class="todo-icon-img" src="/images/mine0.png" mode="aspectFit" />
            </view>
            <view class="todo-body">
              <view class="todo-title">{{item.title}}</view>
              <view class="todo-desc">{{item.locationText}} · {{item.contactName}}</view>
              <view class="todo-time">
                <image class="tiny-icon" src="/images/mine0.png" mode="aspectFit" />
                <text>{{item.dueLabel}}</text>
              </view>
            </view>
            <view class="todo-right">
              <text class="status-pill {{item.statusTone}}">{{item.statusLabel}}</text>
              <text class="item-chevron">›</text>
            </view>
          </view>
        </view>

        <view wx:else class="empty-mini">
          <view class="empty-title">暂无待办</view>
          <view class="empty-subtitle">新的报备、量房和设计任务会出现在这里</view>
        </view>
      </view>

      <view class="settings-card">
        <view class="setting-item with-border" bindtap="onEnableNotification">
          <view class="setting-left">
            <image class="setting-icon-img" src="/images/mine0.png" mode="aspectFit" />
            <text>业务通知提醒</text>
          </view>
          <text class="item-chevron">›</text>
        </view>
        <view class="setting-item" bindtap="onOpenAccountSecurity">
          <view class="setting-left">
            <image class="setting-icon-img" src="/images/mine0.png" mode="aspectFit" />
            <text>账号与安全</text>
          </view>
          <text class="item-chevron">›</text>
        </view>
      </view>

      <button class="logout-btn" bindtap="onLogout">
        <image class="button-icon" src="/images/mine0.png" mode="aspectFit" />
        <text>切换账号 / 退出登录</text>
      </button>
    </view>

    <view wx:else class="user-dashboard">
      <view class="profile-card user-profile">
        <view class="profile-main">
          <image class="avatar" src="{{mineData.profile.avatar || defaultAvatarUrl}}" mode="aspectFill" />
          <view class="profile-text">
            <view class="name-row">
              <text class="profile-name">{{mineData.profile.name || '微信用户'}}</text>
              <text class="role-badge">普通用户</text>
            </view>
            <view class="enterprise-name">{{mineData.profile.phoneMasked || '智能量房大师'}}</view>
          </view>
        </view>
      </view>

      <view wx:if="{{floorPlans.length > 0}}" class="section-card">
        <view class="section-header">
          <text class="section-title">我的户型</text>
          <view class="section-more">{{floorPlans.length}} 份</view>
        </view>
        <view class="todo-list">
          <view
            wx:for="{{floorPlans}}"
            wx:key="_id"
            class="todo-item"
            data-id="{{item._id}}"
            bindtap="onOpenFloorPlan"
          >
            <view class="todo-icon green">
              <image class="todo-icon-img" src="/images/mine0.png" mode="aspectFit" />
            </view>
            <view class="todo-body">
              <view class="todo-title">{{item.name}}</view>
              <view class="todo-desc">{{item.createdAt}} · {{item.roomCount}} 个空间</view>
            </view>
            <view class="todo-right">
              <view class="ai-btn" catchtap="onAIGen" data-id="{{item._id}}">AI 设计</view>
            </view>
          </view>
        </view>
      </view>

      <view wx:else class="empty-card">
        <view class="empty-title">开启智能测量之旅</view>
        <view class="empty-subtitle">连接蓝牙测距仪，让每一寸空间都被精准记录</view>
        <button class="primary-btn" bindtap="onCreateNew">测量新户型</button>
      </view>

      <button class="logout-btn" bindtap="onLogout">
        <image class="button-icon" src="/images/mine0.png" mode="aspectFit" />
        <text>切换账号 / 退出登录</text>
      </button>
    </view>
  </view>
</view>
