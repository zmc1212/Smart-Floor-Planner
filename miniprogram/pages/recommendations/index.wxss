.container {
  min-height: 100vh;
  background: var(--bg-page);
  padding: var(--space-section);
  box-sizing: border-box;
}

.header,
.progress-section,
.recommendation-card,
.share-tips {
  background: var(--bg-surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.header {
  padding: var(--space-section);
  margin-bottom: var(--space-section);
}

.title {
  display: block;
  font-size: var(--font-size-title);
  font-weight: var(--font-weight-bold);
  color: var(--text-primary);
  margin-bottom: var(--space-sm);
}

.subtitle,
.step-description,
.card-description,
.budget-info,
.tips-text {
  display: block;
  font-size: var(--font-size-caption);
  color: var(--text-secondary);
  line-height: 1.5;
}

.progress-section,
.recommendations-section,
.share-section {
  margin-bottom: var(--space-section);
}

.progress-section {
  padding: var(--space-section);
}

.progress-title,
.section-title {
  font-size: 32rpx;
  font-weight: var(--font-weight-bold);
  color: var(--text-primary);
  margin-bottom: var(--space-xl);
}

.step-item {
  display: flex;
  gap: var(--space-lg);
  align-items: flex-start;
}

.step-number {
  width: 52rpx;
  height: 52rpx;
  border-radius: var(--radius-full);
  background: var(--neutral-100);
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: var(--font-weight-bold);
}

.step-item.active .step-number,
.step-item.completed .step-number,
.step-line.completed {
  background: var(--brand-primary);
  color: var(--text-inverse);
}

.step-title {
  display: block;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
  color: var(--text-primary);
}

.step-line {
  width: 4rpx;
  height: 34rpx;
  background: var(--neutral-100);
  margin-left: 24rpx;
}

.recommendations-scroll {
  white-space: nowrap;
}

.recommendation-card {
  display: inline-block;
  width: 600rpx;
  margin-right: var(--space-xxl);
  overflow: hidden;
  vertical-align: top;
}

.recommendation-image {
  width: 100%;
  height: 300rpx;
}

.card-content {
  padding: var(--space-section);
}

.card-title {
  display: block;
  font-size: 32rpx;
  font-weight: var(--font-weight-bold);
  color: var(--text-primary);
  margin-bottom: var(--space-md);
}

.budget-info,
.match-score {
  margin-top: var(--space-md);
}

.match-score {
  color: var(--text-brand);
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-medium);
}

.card-actions {
  display: flex;
  gap: var(--space-lg);
  margin-top: var(--space-xl);
}

.action-btn,
.share-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-medium);
  margin: 0;
}

.action-btn.primary,
.share-btn {
  background: var(--brand-primary);
  color: var(--text-inverse);
}

.action-btn.secondary {
  background: var(--bg-surface);
  color: var(--text-brand);
  box-shadow: inset 0 0 0 1rpx var(--border-brand);
}

.action-btn::after,
.share-btn::after {
  border: none;
}

.share-tips {
  padding: var(--space-section);
}

.share-btn {
  width: 100%;
  margin-top: var(--space-xl);
}
