.container {
  min-height: 100vh;
  background:
    linear-gradient(180deg, #fcfdfb 0%, #f5f7f4 46%, var(--bg-page) 100%);
  padding: 20rpx 20rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.header,
.progress-section,
.recommendation-card,
.share-tips {
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(207, 220, 207, 0.55);
  border-radius: 22rpx;
  box-shadow: var(--shadow-home-card);
  box-sizing: border-box;
}

.header {
  padding: 28rpx 26rpx;
  margin-bottom: 16rpx;
  border-radius: 24rpx;
  background:
    radial-gradient(circle at 82% 18%, rgba(168, 230, 191, 0.34) 0%, rgba(168, 230, 191, 0) 34%),
    linear-gradient(135deg, #eff9ef 0%, #edf8f2 48%, #f9fbf9 100%);
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  overflow: hidden;
}

.header-copy {
  flex: 1;
  min-width: 0;
}

.eyebrow {
  display: block;
  font-size: 22rpx;
  color: #17a14c;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.hero-moodboard {
  position: relative;
  width: 166rpx;
  min-width: 166rpx;
  height: 126rpx;
}

.mood-card {
  position: absolute;
  background: rgba(255, 255, 255, 0.96);
  border: 2rpx solid rgba(198, 228, 203, 0.86);
  box-shadow: 0 10rpx 24rpx rgba(90, 110, 92, 0.1);
}

.mood-a {
  right: 46rpx;
  top: 14rpx;
  width: 96rpx;
  height: 70rpx;
  border-radius: 18rpx;
  transform: rotate(-7deg);
}

.mood-b {
  right: 6rpx;
  top: 52rpx;
  width: 86rpx;
  height: 56rpx;
  border-radius: 16rpx;
  transform: rotate(8deg);
}

.mood-chip {
  position: absolute;
  right: 118rpx;
  bottom: 18rpx;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: rgba(255, 200, 87, 0.26);
}

.title {
  display: block;
  font-size: 38rpx;
  font-weight: 600;
  color: #20262d;
  margin-bottom: 10rpx;
  line-height: 1.25;
}

.subtitle,
.step-description,
.card-description,
.budget-info,
.tips-text {
  display: block;
  font-size: 24rpx;
  color: #7e8793;
  line-height: 1.5;
}

.progress-section,
.recommendations-section,
.share-section {
  margin-bottom: 16rpx;
}

.progress-section {
  padding: 24rpx;
}

.progress-title,
.section-title {
  font-size: 29rpx;
  font-weight: 500;
  color: #21262d;
  margin-bottom: 18rpx;
}

.step-item {
  display: flex;
  gap: 14rpx;
  align-items: flex-start;
}

.step-content {
  min-width: 0;
  flex: 1;
}

.step-number {
  width: 52rpx;
  height: 52rpx;
  border-radius: var(--radius-full);
  background: rgba(236, 240, 245, 1);
  color: #8f98a4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  flex-shrink: 0;
}

.step-item.active .step-number,
.step-item.completed .step-number,
.step-line.completed {
  background: var(--brand-primary);
  color: var(--text-inverse);
}

.step-title {
  display: block;
  font-size: 27rpx;
  font-weight: 500;
  color: #20262d;
  margin-bottom: 4rpx;
}

.step-line {
  width: 4rpx;
  height: 34rpx;
  background: rgba(236, 240, 245, 1);
  margin-left: 24rpx;
}

.recommendations-scroll {
  white-space: nowrap;
}

.recommendation-card {
  display: inline-block;
  width: 610rpx;
  margin-right: 16rpx;
  overflow: hidden;
  vertical-align: top;
}

.recommendation-image {
  width: 100%;
  height: 300rpx;
  background: var(--bg-surface-soft);
}

.card-content {
  padding: 22rpx;
}

.card-title {
  display: block;
  font-size: 31rpx;
  font-weight: 600;
  color: #20262d;
  margin-bottom: 10rpx;
}

.budget-info,
.match-score {
  margin-top: 12rpx;
}

.match-score {
  color: #17a14c;
  font-size: 24rpx;
  font-weight: 500;
}

.card-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.card-actions .action-btn {
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.action-btn,
.share-btn {
  flex: 1;
  height: 76rpx;
  border-radius: var(--radius-full);
  font-size: 24rpx;
  font-weight: 500;
  margin: 0;
  padding: 0 16rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.action-btn.primary,
.share-btn {
  background: linear-gradient(135deg, #0fb04d 0%, #18a94b 100%);
  color: var(--text-inverse);
  box-shadow: 0 10rpx 20rpx rgba(17, 164, 66, 0.18);
}

.action-btn.secondary {
  background: var(--bg-surface);
  color: var(--text-brand);
  box-shadow: inset 0 0 0 1rpx var(--border-brand);
}

.action-btn::after,
.share-btn::after {
  border: none;
}

.share-tips {
  padding: 24rpx;
}

.share-btn {
  width: 100%;
  margin-top: 18rpx;
}
