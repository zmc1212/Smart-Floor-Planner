page {
  height: auto;
  overflow-y: auto !important;
  background: #f8fafc;
}

.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 100rpx 32rpx; /* Added bottom padding for safe area and scrolling */
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03), 0 0 0 1rpx rgba(0, 0, 0, 0.08);
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 32rpx;
  letter-spacing: -0.5rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 24rpx;
}

.meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
}

.input {
  width: 100%;
  height: 100rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  margin-top: 24rpx;
  color: #1e293b;
}

.textarea {
  width: 100%;
  min-height: 200rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  margin-top: 24rpx;
  color: #1e293b;
}

.placeholder-cls {
  color: #94a3b8;
  font-size: 28rpx;
}

.picker {
  width: 100%;
  height: 100rpx;
  display: flex;
  align-items: center;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  margin-top: 24rpx;
  color: #1e293b;
}

.primary-btn,
.secondary-btn {
  width: 100% !important;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}

.primary-btn {
  background: #111827;
  color: #ffffff;
}

.secondary-btn {
  background: #ffffff;
  color: #111827;
  box-shadow: 0 0 0 1rpx rgba(0, 0, 0, 0.1);
}

.primary-btn::after,
.secondary-btn::after {
  border: none;
}

.log {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #e2e8f0;
}

.log-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #0f172a;
}

.log-content {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #64748b;
}

.empty {
  text-align: center;
  color: #94a3b8;
  padding: 120rpx 0;
  font-size: 28rpx;
}
