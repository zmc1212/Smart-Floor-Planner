<view class="container">
  <view class="detail-hero" wx:if="{{lead}}">
    <view class="hero-copy">
      <text class="eyebrow">客户详情</text>
      <text class="title">{{lead.name}}</text>
      <text class="info">手机：{{lead.phone}}</text>
      <text class="info">小区：{{lead.communityName || '未填写'}}</text>
      <text class="info">意向风格：{{lead.stylePreference || '未选择'}}</text>
    </view>
    <view class="hero-status">
      <view class="status-pill">量房中</view>
      <view class="hero-house">
        <view class="house-room house-room-a"></view>
        <view class="house-room house-room-b"></view>
        <view class="house-room house-room-c"></view>
      </view>
    </view>
  </view>

  <view class="content" wx:if="{{!loading}}">
    <view class="summary-card" wx:if="{{rooms.length > 0}}">
      <view class="summary-item">
        <text class="summary-value">{{rooms.length}}</text>
        <text class="summary-label">房间</text>
      </view>
      <view class="summary-item">
        <text class="summary-value">{{activeFloorPlan.status || '草稿'}}</text>
        <text class="summary-label">状态</text>
      </view>
      <view class="summary-action" bindtap="onAddRoom">增加房间</view>
    </view>

    <block wx:if="{{rooms.length === 0}}">
      <view class="empty-state">
        <view class="icon">房</view>
        <view class="title">当前客户暂无户型数据</view>
        <view class="subtitle">选择一个标准户型模板，快速开始测量。</view>
      </view>

      <view class="section-title">
        <text>选择户型模板</text>
      </view>
      <view class="template-list">
        <view class="template-item" wx:for="{{templates}}" wx:key="id" data-id="{{item.id}}" bindtap="onSelectTemplate">
          <view class="template-thumb">
            <view class="template-line line-a"></view>
            <view class="template-line line-b"></view>
            <view class="template-line line-c"></view>
          </view>
          <view class="template-copy">
            <text class="template-name">{{item.name}}</text>
            <text class="template-desc">快速生成房间结构</text>
          </view>
          <text class="template-action">使用</text>
        </view>
      </view>
    </block>

    <block wx:else>
      <view class="section-title">
        <text>户型房间</text>
        <text class="add-btn" bindtap="onAddRoom">+ 增加房间</text>
      </view>

      <view class="room-list">
        <view class="room-item" wx:for="{{rooms}}" wx:key="id" data-id="{{item.id}}" bindtap="onEnterRoom">
          <view class="room-icon">{{item.measured ? '✓' : '房'}}</view>
          <view class="room-copy">
            <text class="room-name">{{item.name}}</text>
            <text class="room-meta">{{item.width || item.defaultWidth || 40}} × {{item.height || item.defaultHeight || 40}}</text>
          </view>
          <text class="room-status {{item.measured ? 'measured' : ''}}">{{item.measured ? '已测量' : '待测量'}}</text>
        </view>
      </view>
    </block>
  </view>

  <view class="loading-state" wx:else>加载中...</view>
</view>
