<view class="container" wx:if="{{!loading}}">
  <view class="detail-hero" wx:if="{{lead}}">
    <view class="hero-copy">
      <text class="eyebrow">客户详情</text>
      <text class="title">{{lead.name}}</text>
      <text class="info">手机：{{lead.phone}}</text>
      <text class="info">小区：{{lead.communityName || '未填写'}}</text>
    </view>
  </view>
  <view class="whole-home-card">
    <view class="whole-home-copy">
      <view class="whole-home-title">正式量房</view>
      <view class="whole-home-subtitle">{{activeFloorPlan ? '继续编辑已保存的正式墙图' : '从墙图开始创建客户户型'}}</view>
    </view>
    <view class="whole-home-actions">
      <view class="whole-home-action" bindtap="onStartMeasure">{{activeFloorPlan ? '继续量房' : '开始量房'}}</view>
      <view class="whole-home-secondary-actions" wx:if="{{activeFloorPlan}}">
        <view class="whole-home-action secondary" bindtap="onStartNewMeasure">新增量房</view>
        <view class="whole-home-action danger" bindtap="onDeleteMeasure">{{deleting ? '删除中' : '删除'}}</view>
      </view>
    </view>
  </view>
  <view class="measurement-history" wx:if="{{previousFloorPlans.length > 0}}">
    <view class="measurement-history-heading">
      <text>历史量房记录</text>
      <text>{{previousFloorPlans.length}} 份</text>
    </view>
    <view class="measurement-record" wx:for="{{previousFloorPlans}}" wx:key="_id">
      <view class="measurement-record-copy">
        <text class="measurement-record-name">{{item.displayName}}</text>
        <text class="measurement-record-meta">{{item.displayMeta}}</text>
      </view>
      <view class="measurement-record-actions">
        <view class="measurement-record-continue" data-id="{{item._id}}" bindtap="onContinueMeasure">继续</view>
        <view class="measurement-record-delete" data-id="{{item._id}}" bindtap="onDeleteMeasure">删除</view>
      </view>
    </view>
  </view>
</view>
<view class="loading-state" wx:else>加载中...</view>
