.page-container {
  min-height: 100vh;
  background:
    linear-gradient(180deg, #fcfdfb 0%, #f5f7f4 48%, var(--bg-page) 100%);
}

.custom-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.94);
  z-index: 100;
  box-shadow: 0 8rpx 24rpx rgba(85, 104, 90, 0.05);
  backdrop-filter: blur(16px);
}

.header-content {
  display: flex;
  align-items: center;
  padding: 0 32rpx;
}

.page-title {
  font-size: 32rpx;
  font-weight: var(--font-weight-medium);
  color: #20262d;
  letter-spacing: 0;
}

.main-content {
  height: 100vh;
  box-sizing: border-box;
  background: transparent;
}
