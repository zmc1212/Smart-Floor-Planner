page {
  height: 100%;
  overflow: hidden;
  background: #ffffff;
}

.page-container {
  height: 100vh;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.top-safe {
  flex-shrink: 0;
}

.page-header {
  flex-shrink: 0;
  height: 150rpx;
  padding: 18rpx 36rpx 26rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

.header-copy {
  display: flex;
  flex-direction: column;
}

.page-title {
  font-size: 44rpx;
  line-height: 1.18;
  font-weight: 800;
  color: #0f1724;
}

.page-subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.25;
  color: #657187;
}

.main-content {
  flex: 1;
  min-height: 0;
}
