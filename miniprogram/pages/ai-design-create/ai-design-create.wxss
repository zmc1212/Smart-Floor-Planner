.create-page { height: 100vh; background: #f5f7f5; color: var(--text-primary); }
.create-shell { padding: 34rpx 28rpx calc(64rpx + env(safe-area-inset-bottom)); }
.create-head { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 30rpx; }
.create-title { display: block; font-size: 42rpx; font-weight: 700; }
.create-step { display: block; margin-top: 8rpx; color: var(--text-secondary); font-size: 23rpx; }
.cost-pill { display: flex; align-items: center; height: 58rpx; padding: 0 20rpx; background: #fff; border-radius: var(--radius-full); box-shadow: var(--shadow-card); font-size: 25rpx; font-weight: 700; }
.diamond { width: 12rpx; height: 12rpx; margin-right: 9rpx; background: #e5a900; border-radius: var(--radius-full); }
.workflow-context, .plan-source { display: flex; align-items: center; margin-bottom: 22rpx; padding: 22rpx 24rpx; background: var(--bg-surface); border-radius: var(--radius-lg); box-shadow: var(--shadow-card); }
.workflow-dot { flex: 0 0 14rpx; width: 14rpx; height: 14rpx; margin-right: 18rpx; background: var(--brand-primary); border-radius: var(--radius-full); }
.workflow-copy, .plan-copy { min-width: 0; }
.workflow-title, .plan-title { display: block; font-size: 25rpx; font-weight: 600; }
.workflow-meta, .plan-meta { display: block; margin-top: 7rpx; color: var(--text-secondary); font-size: 21rpx; line-height: 1.45; }
.plan-source { min-height: 120rpx; box-sizing: border-box; border: 2rpx dashed var(--border-soft); box-shadow: none; }
.plan-source.ready { border-style: solid; border-color: var(--border-brand-soft); background: var(--bg-surface-soft); }
.plan-mark { flex: 0 0 76rpx; height: 76rpx; margin-right: 20rpx; display: flex; align-items: center; justify-content: center; background: var(--bg-surface); border-radius: var(--radius-md); color: var(--text-brand); font-size: 21rpx; font-weight: 700; }
.upload-block { position: relative; width: 100%; height: 420rpx; overflow: hidden; background: #fff; border-radius: var(--radius-lg); box-shadow: var(--shadow-card); }
.upload-preview { width: 100%; height: 100%; }
.upload-empty { display: flex; height: 100%; flex-direction: column; align-items: center; justify-content: center; }
.upload-add { display: flex; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; background: var(--brand-primary-20); border-radius: var(--radius-full); color: var(--brand-primary); font-size: 56rpx; line-height: 1; font-weight: 300; }
.upload-title { margin-top: 20rpx; font-size: 29rpx; font-weight: 600; }
.upload-meta { margin-top: 8rpx; color: var(--text-secondary); font-size: 22rpx; }
.upload-status { position: absolute; left: 20rpx; bottom: 20rpx; padding: 10rpx 20rpx; background: rgba(31,41,55,.82); border-radius: var(--radius-full); color: var(--text-inverse); font-size: 22rpx; }
.upload-status.error { background: rgba(31,41,55,.9); }
.replace-chip { position: absolute; right: 20rpx; bottom: 20rpx; padding: 10rpx 20rpx; background: rgba(255,255,255,.92); border-radius: var(--radius-full); color: var(--text-brand); font-size: 22rpx; box-shadow: var(--shadow-card); }
.flow-arrow { height: 68rpx; display: flex; align-items: center; justify-content: center; color: var(--brand-primary); font-size: 34rpx; }
.style-section { margin-top: 36rpx; }
.style-heading { display: block; margin-bottom: 18rpx; font-size: 29rpx; font-weight: 600; }
.style-scroll { width: calc(100vw - 28rpx); }
.style-row { display: flex; gap: 16rpx; padding-right: 28rpx; }
.style-chip { flex: 0 0 150rpx; min-height: 150rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; background: #fff; border: 2rpx solid transparent; border-radius: var(--radius-lg); color: var(--text-secondary); box-shadow: var(--shadow-card); font-size: 22rpx; }
.style-chip.active { border-color: var(--brand-primary); color: var(--text-brand); }
.style-initial { display: flex; align-items: center; justify-content: center; width: 60rpx; height: 60rpx; margin-bottom: 12rpx; border-radius: var(--radius-full); background: var(--brand-primary-20); font-size: 25rpx; font-weight: 700; }
.mode-note { margin: 24rpx 6rpx 0; padding: 20rpx 22rpx; background: var(--bg-surface-soft); border-radius: var(--radius-md); color: var(--neutral-700); font-size: 21rpx; line-height: 1.55; }
.privacy-row { display: flex; align-items: flex-start; gap: 12rpx; margin: 32rpx 6rpx 24rpx; color: var(--text-secondary); font-size: 21rpx; line-height: 1.5; }
.privacy-dot { flex: 0 0 12rpx; width: 12rpx; height: 12rpx; margin-top: 9rpx; border-radius: var(--radius-full); background: var(--brand-primary); }
.generate-button { display: flex; align-items: center; justify-content: center; gap: 22rpx; height: 96rpx; margin: 0; border: none; border-radius: var(--radius-full); background: var(--brand-primary); color: #fff; font-size: 29rpx; font-weight: 600; box-shadow: 0 12rpx 26rpx rgba(34,197,94,.22); }
.generate-button::after { border: none; }
.generate-button[disabled] { opacity: .58; }
.button-cost { font-size: 23rpx; color: rgba(255,255,255,.82); }
