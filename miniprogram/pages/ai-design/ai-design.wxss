.ai-page {
  background:
    radial-gradient(circle at 12% 4%, rgba(247, 235, 215, 0.52), rgba(248, 248, 244, 0) 30%),
    #f8f8f4;
  color: var(--text-primary);
}

.ai-scroll {
  height: 100%;
}

.ai-shell {
  padding: 34rpx 36rpx 44rpx;
}

.page-head,
.project-context,
.journey-head,
.next-action,
.recent-head,
.sheet-head,
.source-item {
  display: flex;
  align-items: center;
}

.page-head {
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.immersive-page-head {
  width: 100%;
  box-sizing: border-box;
}

.without-plan .immersive-page-head {
  position: relative;
  z-index: 5;
  align-items: flex-start;
  flex-direction: column;
  padding-top: 20rpx;
  padding-left: 20rpx;
  margin-bottom: 0;
}

.without-plan .balance-pill {
  height: 60rpx;
  margin-top: 20rpx;
  margin-left: 0;
  padding: 0 20rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 6rpx 18rpx rgba(49, 42, 32, 0.08);
}

.page-heading,
.project-context-main,
.journey-copy,
.next-action-copy,
.source-item-main {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.page-heading {
  flex: 1;
}

.page-title {
  color: #292a2f;
  font-size: 56rpx;
  line-height: 1.16;
  font-weight: 700;
  letter-spacing: -2rpx;
}

.page-subtitle {
  max-width: 480rpx;
  margin-top: 8rpx;
  overflow: hidden;
  color: #6f7479;
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: 400;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.balance-pill {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  height: 64rpx;
  margin-left: 20rpx;
  padding: 0 19rpx;
  background: #fff8df;
  border-radius: var(--radius-full);
  box-sizing: border-box;
}

.credit-dot {
  position: relative;
  width: 24rpx;
  height: 24rpx;
  margin-right: 12rpx;
  background: linear-gradient(135deg, #18b957 0 50%, #5dd683 50% 100%);
  border-radius: 4rpx;
  transform: rotate(45deg);
}

.credit-dot::after {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 7rpx;
  height: 7rpx;
  background: rgba(255, 255, 255, 0.82);
  border-radius: 2rpx;
  content: "";
  transform: translate(-50%, -50%);
}

.balance-value {
  font-size: 24rpx;
  font-weight: 700;
}

.loading-balance {
  background: rgba(238, 232, 217, 0.9);
  color: var(--neutral-500);
}

.loading-balance .credit-dot {
  background: #d9cfb7;
}

.service-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
  padding: 18rpx 22rpx;
  background: #fff7e8;
  border-radius: 18rpx;
}

.service-copy {
  min-width: 0;
  flex: 1;
}

.service-title,
.service-message {
  display: block;
}

.service-title {
  color: #7a4f00;
  font-size: 24rpx;
  font-weight: 600;
}

.service-message {
  margin-top: 6rpx;
  color: #8b641d;
  font-size: 24rpx;
  line-height: 1.4;
}

.error-banner {
  background: #fff0ee;
}

.error-banner .service-title {
  color: #9b2f25;
}

.error-banner .service-message {
  color: #7e4b45;
}

.service-retry {
  flex: 0 0 auto;
  min-height: 64rpx;
  display: flex;
  align-items: center;
  margin-left: 18rpx;
  padding: 0 8rpx 0 20rpx;
  color: #9b2f25;
  font-size: 24rpx;
  font-weight: 700;
}

.home-skeleton {
  overflow: hidden;
  background: #fff;
  border-radius: 32rpx;
  box-shadow: 0 18rpx 44rpx rgba(64, 55, 37, 0.07);
}

.skeleton-visual {
  height: 650rpx;
  background: #ece9e1;
}

.skeleton-panel {
  padding: 28rpx 24rpx 32rpx;
}

.skeleton-line {
  width: 74%;
  height: 24rpx;
  background: #eceeea;
  border-radius: var(--radius-full);
}

.skeleton-line.short {
  width: 34%;
  margin-bottom: 18rpx;
}

.skeleton-action {
  width: 42%;
  height: 74rpx;
  margin-top: 26rpx;
  margin-left: auto;
  background: #e4e8e2;
  border-radius: 18rpx;
}

.shimmer {
  position: relative;
  overflow: hidden;
}

.shimmer::after {
  position: absolute;
  top: 0;
  bottom: 0;
  left: -55%;
  width: 40%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.58), transparent);
  content: "";
  animation: ai-shimmer 1.35s ease-in-out infinite;
}

@keyframes ai-shimmer {
  100% {
    left: 115%;
  }
}

.load-state {
  min-height: 680rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: #fff;
  border-radius: 32rpx;
  text-align: center;
  box-sizing: border-box;
}

.load-state-title {
  font-size: 30rpx;
  font-weight: 700;
}

.load-state-copy {
  margin-top: 12rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
  line-height: 1.5;
}

.load-state-action {
  min-width: 210rpx;
  min-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 28rpx;
  background: var(--brand-primary);
  border-radius: 18rpx;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}

.project-context {
  justify-content: space-between;
  min-height: 68rpx;
  margin-bottom: 12rpx;
}

.project-context-main {
  flex: 1;
}

.journey-kicker,
.next-kicker,
.discovery-source-label {
  color: var(--text-brand);
  font-size: 20rpx;
  line-height: 1.25;
  font-weight: 600;
}

.project-context-title {
  overflow: hidden;
  font-size: 26rpx;
  line-height: 1.3;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.project-context-meta {
  margin-top: 4rpx;
  color: var(--text-secondary);
  font-size: 20rpx;
  line-height: 1.3;
}

.project-context-actions {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  margin-left: 18rpx;
}

.context-action {
  min-height: 64rpx;
  display: flex;
  align-items: center;
  padding: 0 0 0 18rpx;
  color: var(--text-brand);
  font-size: 24rpx;
  font-weight: 600;
}

.context-action.muted {
  margin-left: 4rpx;
  color: var(--neutral-500);
  font-size: 24rpx;
  font-weight: 400;
}

.plan-navigator {
  overflow: hidden;
  background: #fffefa;
  border-radius: 32rpx;
  box-shadow: 0 18rpx 44rpx rgba(64, 55, 37, 0.09);
}

.plan-stage {
  position: relative;
  height: 620rpx;
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 44%, rgba(232, 222, 200, 0.36), rgba(250, 248, 241, 0) 54%),
    #f7f4ec;
}

.plan-guide-scene {
  position: absolute;
  right: -26rpx;
  bottom: -42rpx;
  z-index: 4;
  width: 198rpx;
  height: 198rpx;
  opacity: 0.96;
  pointer-events: none;
}

.plan-ai-image,
.plan-graph {
  position: absolute;
  left: 50%;
  top: 34rpx;
  width: 560rpx;
  height: 560rpx;
}

.plan-ai-image {
  border-radius: 18rpx;
  transform: translateX(-50%) scale(1);
  transition: transform 520ms cubic-bezier(0.16, 1, 0.3, 1);
}

.plan-graph {
  transform: translateX(-50%) perspective(800rpx) rotateX(8deg);
  transform-origin: 50% 72%;
  transition: transform 520ms cubic-bezier(0.16, 1, 0.3, 1);
}

.plan-stage.room-focused .plan-ai-image {
  transform: translateX(-50%) scale(1.045);
}

.plan-stage.room-focused .plan-graph {
  transform: translateX(-50%) perspective(800rpx) rotateX(8deg) scale(1.045);
}

.plan-room-fill {
  position: absolute;
  background: rgba(232, 225, 209, 0.68);
}

.plan-room-fill:nth-child(3n + 2) {
  background: rgba(224, 235, 219, 0.7);
}

.plan-room-fill:nth-child(3n + 3) {
  background: rgba(244, 229, 201, 0.66);
}

.plan-room-fill.active {
  background: rgba(181, 226, 186, 0.76);
}

.plan-wall {
  position: absolute;
  z-index: 3;
  height: 6rpx;
  background: #5d5a51;
  border-radius: var(--radius-full);
  transform-origin: 0 50%;
}

.plan-room-label {
  position: absolute;
  z-index: 4;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 60rpx;
  padding: 7rpx 12rpx;
  background: rgba(255, 255, 255, 0.94);
  border-radius: 12rpx;
  box-shadow: 0 6rpx 16rpx rgba(52, 48, 40, 0.08);
  font-size: 24rpx;
  line-height: 1.1;
  font-weight: 600;
  transform: translate(-50%, -50%);
  box-sizing: border-box;
}

.plan-room-label.active {
  color: #087f36;
  box-shadow: 0 8rpx 18rpx rgba(16, 157, 67, 0.14);
}

.room-current {
  margin-bottom: 5rpx;
  color: var(--text-brand);
  font-size: 24rpx;
  font-weight: 700;
}

.map-waypoint {
  position: absolute;
  z-index: 8;
  min-height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 22rpx;
  background: rgba(255, 255, 255, 0.96);
  border-radius: var(--radius-full);
  color: #3b3a35;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 22rpx rgba(60, 53, 41, 0.1);
  box-sizing: border-box;
}

.map-waypoint::after {
  content: "";
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  background: var(--brand-primary);
  border: 5rpx solid #fffefa;
  border-radius: var(--radius-full);
  box-shadow: 0 0 0 1rpx rgba(119, 95, 49, 0.32);
}

.waypoint-top {
  left: 50%;
  top: 12rpx;
  transform: translateX(-50%);
}

.waypoint-top::after {
  left: 50%;
  bottom: -23rpx;
  transform: translateX(-50%);
}

.waypoint-left {
  left: 8rpx;
  top: 48%;
}

.waypoint-left::after {
  right: -23rpx;
  top: 50%;
  transform: translateY(-50%);
}

.waypoint-right {
  right: 8rpx;
  top: 48%;
}

.waypoint-right::after {
  left: -23rpx;
  top: 50%;
  transform: translateY(-50%);
}

.waypoint-bottom {
  left: 50%;
  bottom: 12rpx;
  transform: translateX(-50%);
}

.waypoint-bottom::after {
  left: 50%;
  top: -23rpx;
  transform: translateX(-50%);
}

.preview-progress {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 7;
  width: 270rpx;
  padding: 20rpx 22rpx;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 18rpx;
  box-shadow: 0 12rpx 34rpx rgba(31, 41, 55, 0.14);
  transform: translate(-50%, -50%);
  box-sizing: border-box;
}

.preview-progress-label,
.preview-progress-value {
  display: block;
  text-align: center;
}

.preview-progress-label {
  font-size: 24rpx;
  font-weight: 700;
}

.preview-progress-value {
  margin-top: 6rpx;
  color: var(--text-brand);
  font-size: 24rpx;
  font-weight: 700;
}

.preview-progress-track {
  height: 7rpx;
  margin-top: 14rpx;
  overflow: hidden;
  background: var(--brand-primary-20);
  border-radius: var(--radius-full);
}

.preview-progress-bar {
  height: 100%;
  background: var(--brand-primary);
  border-radius: var(--radius-full);
}

.room-selector {
  position: relative;
  z-index: 4;
  margin-top: -4rpx;
  padding-top: 14rpx;
  overflow: hidden;
  background: #fff;
  border-radius: 30rpx 30rpx 0 0;
  box-shadow: 0 -10rpx 28rpx rgba(55, 48, 38, 0.08);
}

.room-selector-handle {
  width: 76rpx;
  height: 7rpx;
  margin: 0 auto 8rpx;
  background: #d8d9d7;
  border-radius: var(--radius-full);
}

.room-tabs {
  width: 100%;
}

.room-tabs-row {
  display: flex;
  min-width: 100%;
  padding: 8rpx 28rpx 20rpx;
  box-sizing: border-box;
}

.room-tab {
  position: relative;
  flex: 0 0 auto;
  min-width: 78rpx;
  min-height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  padding: 0 18rpx;
  border-radius: 15rpx;
  color: #40454a;
  font-size: 27rpx;
  line-height: 1;
  font-weight: 500;
  box-sizing: border-box;
}

.room-tab.active {
  background: var(--brand-primary);
  color: #fff;
  font-weight: 700;
}

.room-tab.active::after {
  position: absolute;
  left: 50%;
  bottom: -13rpx;
  width: 38rpx;
  height: 4rpx;
  background: var(--brand-primary);
  border-radius: var(--radius-full);
  content: "";
  transform: translateX(-50%);
}

.journey-panel,
.discovery-panel {
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  background: #fff;
  border-radius: 26rpx;
  box-shadow: 0 12rpx 34rpx rgba(57, 64, 54, 0.07);
}

.with-plan .journey-panel {
  position: relative;
  z-index: 5;
  margin-top: 16rpx;
  padding: 22rpx 24rpx 26rpx;
  border-radius: 24rpx;
  box-shadow: 0 18rpx 46rpx rgba(57, 64, 54, 0.1);
}

.journey-head {
  justify-content: space-between;
}

.journey-copy {
  flex: 1;
}

.journey-title {
  margin-top: 4rpx;
  overflow: hidden;
  font-size: 26rpx;
  line-height: 1.3;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.journey-change {
  min-height: 64rpx;
  display: flex;
  align-items: center;
  margin-left: 16rpx;
  padding: 0 0 0 18rpx;
  color: var(--text-brand);
  font-size: 24rpx;
  font-weight: 600;
}

.stage-rail {
  display: flex;
  margin-top: 24rpx;
}

.stage-item {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 106rpx;
}

.stage-node {
  position: relative;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stage-dot {
  position: relative;
  z-index: 2;
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border: 3rpx solid #bfc4c0;
  border-radius: var(--radius-full);
  color: #fff;
  font-size: 20rpx;
  line-height: 1;
  box-sizing: border-box;
}

.stage-line {
  position: absolute;
  left: calc(50% + 21rpx);
  top: 20rpx;
  z-index: 1;
  width: calc(100% - 42rpx);
  height: 0;
  border-top: 1px dashed #c9cdca;
}

.stage-item.done .stage-dot {
  background: #fff;
  border-color: var(--brand-primary);
}

.stage-item.current .stage-dot {
  background: var(--brand-primary);
  border-color: var(--brand-primary);
}

.stage-check {
  width: 15rpx;
  height: 8rpx;
  border-bottom: 3rpx solid var(--brand-primary);
  border-left: 3rpx solid var(--brand-primary);
  transform: translateY(-2rpx) rotate(-45deg);
  box-sizing: border-box;
}

.stage-item.current .stage-dot {
  box-shadow:
    inset 0 0 0 5rpx #fff,
    0 0 0 2rpx var(--brand-primary);
}

.stage-item.done .stage-line {
  border-top-color: var(--brand-primary);
  border-top-style: solid;
}

.stage-label {
  margin-top: 13rpx;
  color: #4f5551;
  font-size: 25rpx;
  line-height: 1.2;
  text-align: center;
}

.stage-item.done .stage-label,
.stage-item.current .stage-label {
  color: #263129;
  font-weight: 600;
}

.stage-status {
  margin-top: 7rpx;
  padding: 4rpx 15rpx;
  background: var(--brand-primary-20);
  border-radius: var(--radius-full);
  color: var(--text-brand);
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 600;
}

.next-action-panel {
  margin-top: 16rpx;
  padding: 22rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 34rpx rgba(57, 64, 54, 0.07);
}

.workflow-state {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  background: var(--brand-primary-20);
  border-radius: 16rpx;
}

.workflow-state.error {
  background: #fff0ee;
}

.workflow-state-copy {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.workflow-state-title {
  font-size: 24rpx;
  font-weight: 700;
}

.workflow-state-detail {
  margin-top: 4rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
  line-height: 1.35;
}

.workflow-state-action {
  min-height: 64rpx;
  display: flex;
  align-items: center;
  margin-left: 16rpx;
  padding-left: 16rpx;
  color: #9b2f25;
  font-size: 24rpx;
  font-weight: 700;
}

.next-action {
  position: relative;
  align-items: stretch;
  margin-top: 0;
  padding-top: 0;
}

.next-action::before {
  display: none;
}

.next-action-copy {
  flex: 1;
}

.next-title {
  margin-top: 5rpx;
  font-size: 29rpx;
  line-height: 1.25;
  font-weight: 700;
}

.next-description {
  margin-top: 7rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
  line-height: 1.4;
}

.next-button {
  flex: 0 0 auto;
  min-width: 190rpx;
  min-height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  align-self: center;
  margin-left: 18rpx;
  padding: 0 22rpx;
  background: var(--brand-primary);
  border-radius: 18rpx;
  color: #fff;
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 700;
  box-shadow: 0 12rpx 22rpx rgba(20, 173, 75, 0.18);
  box-sizing: border-box;
}

.next-button.disabled,
.secondary-action.disabled {
  opacity: 0.45;
}

.next-cost {
  margin-left: 4rpx;
}

.secondary-nav {
  position: relative;
  display: flex;
  margin-top: 14rpx;
  padding: 12rpx 8rpx 0;
}

.secondary-nav::before {
  position: absolute;
  top: 0;
  right: 0;
  width: 76%;
  height: 1px;
  background: #dfe5dc;
  content: "";
  transform: scaleY(0.5);
  transform-origin: 100% 0;
}

.secondary-action {
  position: relative;
  min-width: 0;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
  padding: 0 6rpx;
  color: #3f4540;
  font-size: 24rpx;
  line-height: 1.2;
}

.secondary-action + .secondary-action {
  padding-left: 9rpx;
}

.secondary-action + .secondary-action::before {
  position: absolute;
  top: 50%;
  left: 0;
  width: 1px;
  height: 34rpx;
  background: #edf0eb;
  content: "";
  transform: translateY(-50%) scaleX(0.5);
  transform-origin: center;
}

.secondary-icon {
  width: 34rpx;
  height: 34rpx;
  margin-right: 8rpx;
}

.scene-navigator {
  position: relative;
  height: calc(1024rpx + var(--ai-navigation-top, 24px));
  overflow: hidden;
  border-radius: 0;
  background: #eee5d7;
}

.without-plan .scene-navigator {
  margin: calc(-214rpx - var(--ai-navigation-top, 24px)) -36rpx 0;
}

.scene-image {
  width: 100%;
  height: 100%;
  transform: scale(1.01) translate3d(0, 0, 0);
  transform-origin: 50% 50%;
  transition: transform 680ms cubic-bezier(0.16, 1, 0.3, 1), filter 680ms cubic-bezier(0.16, 1, 0.3, 1);
  will-change: transform;
}

.scene-focus-inspiration .scene-image {
  transform: scale(1.04) translate3d(1.5%, 1%, 0);
}

.scene-focus-style .scene-image {
  transform: scale(1.055) translate3d(-2%, -1%, 0);
}

.scene-focus-floor-plan .scene-image {
  transform: scale(1.065) translate3d(1%, -2%, 0);
}

.scene-focus-furnishing .scene-image {
  transform: scale(1.05) translate3d(-2%, 1.5%, 0);
}

.scene-shade {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    180deg,
    rgba(255, 252, 247, 0.42) 0%,
    rgba(255, 252, 247, 0.12) 24%,
