.ai-page {
  background:
    radial-gradient(circle at 12% 4%, rgba(247, 235, 215, 0.52), rgba(248, 248, 244, 0) 30%),
    #f8f8f4;
  color: var(--text-primary);
}

/* Design-reference restoration: customer project workbench v3 */
.project-hero-progress.home-progress {
  right: auto;
  left: 30rpx;
  width: 500rpx;
}

.home-progress .project-hero-progress-head,
.home-progress .project-hero-progress-track {
  width: 400rpx;
}

.home-progress .project-hero-stage-rail {
  width: 440rpx;
}

.project-hero-progress.picker-progress {
  right: 30rpx;
  left: 30rpx;
  width: auto;
}

.project-hero-primary {
  position: absolute;
  right: 28rpx;
  bottom: 30rpx;
  z-index: 17;
  display: flex;
  min-width: 190rpx;
  min-height: 76rpx;
  align-items: center;
  justify-content: center;
  padding: 0 22rpx;
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 10rpx 24rpx rgba(0, 45, 22, 0.2);
  color: #078b40;
  font-size: 28rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.project-hero-primary.disabled {
  opacity: 0.5;
}

.home-project-query {
  display: flex;
  gap: 12rpx;
  margin: 24rpx 12rpx 0;
}

.home-project-search,
.home-project-filter {
  display: flex;
  height: 58rpx;
  align-items: center;
  border: 1rpx solid #dedfdc;
  border-radius: 20rpx;
  background: #fff;
  color: #858b87;
  font-size: 24rpx;
}

.home-project-search {
  flex: 1;
  padding: 0 22rpx;
}

.home-project-search image {
  width: 34rpx;
  height: 34rpx;
  margin-right: 14rpx;
  opacity: 0.55;
}

.home-project-filter {
  width: 126rpx;
  justify-content: center;
  color: #3f4943;
}

.home-project-filter image {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

.space-scheme-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 20rpx 12rpx 12rpx;
}

.space-scheme-title {
  color: #222724;
  font-size: 34rpx;
  font-weight: 700;
}

.space-scheme-more {
  display: flex;
  align-items: center;
  color: #078f41;
  font-size: 24rpx;
  font-weight: 600;
}

.space-scheme-more image {
  width: 24rpx;
  height: 24rpx;
  margin-left: 4rpx;
}

.space-scheme-strip {
  margin: 0 -16rpx;
  white-space: nowrap;
}

.space-scheme-row {
  display: inline-flex;
  padding: 0 28rpx;
}

.space-scheme-card {
  position: relative;
  flex: 0 0 auto;
  width: 320rpx;
  height: 380rpx;
  margin-right: 16rpx;
  overflow: hidden;
  border-radius: 22rpx;
  background: #e9e4db;
}

.space-scheme-card.active {
  box-shadow: inset 0 0 0 3rpx #18ae53;
}

.space-scheme-image,
.space-room-art {
  width: 100%;
  height: 100%;
}

.space-room-art {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #f1eee8 0%, #d6ded8 100%);
}

.space-room-art image {
  width: 150rpx;
  height: 150rpx;
  opacity: 0.62;
}

.space-mini-plan {
  position: relative;
  width: 248rpx;
  height: 288rpx;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: 0 8rpx 24rpx rgba(32, 48, 38, 0.1);
}

.space-mini-room,
.space-mini-wall {
  position: absolute;
}

.space-mini-room {
  background: rgba(38, 169, 84, 0.1);
}

.space-mini-wall {
  height: 4rpx;
  background: #3f4842;
  transform-origin: left center;
}

.space-scheme-shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 42%, rgba(0, 0, 0, 0.66) 100%);
}

.space-scheme-copy {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  left: 20rpx;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.space-scheme-name {
  overflow: hidden;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.space-scheme-status {
  margin-top: 10rpx;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(13, 153, 69, 0.88);
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
}

.design-preparation-card {
  display: flex;
  height: 112rpx;
  align-items: center;
  margin: 22rpx 12rpx 0;
  padding: 0 22rpx;
  border: 1rpx solid #e2e6e2;
  border-radius: 22rpx;
  background: linear-gradient(105deg, #fff 0%, #f3faf5 100%);
}

.design-preparation-art {
  display: flex;
  width: 96rpx;
  height: 82rpx;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: transparent;
}

.design-preparation-art image {
  width: 96rpx;
  height: 82rpx;
}

.design-preparation-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  margin-left: 14rpx;
}

.design-preparation-title {
  color: #28302b;
  font-size: 28rpx;
  font-weight: 700;
}

.design-preparation-meta {
  margin-top: 8rpx;
  color: #79817c;
  font-size: 22rpx;
}

.design-preparation-chevron {
  width: 32rpx;
  height: 32rpx;
}

.secondary-tool-dock {
  margin-top: 24rpx;
}

.source-sheet {
  height: 49vh;
  max-height: none;
  padding-top: 12rpx;
  padding-right: 30rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  padding-left: 30rpx;
}

.source-sheet .sheet-handle {
  margin-bottom: 14rpx;
}

.source-sheet .sheet-title {
  font-size: 34rpx;
}

.source-sheet .sheet-subtitle {
  font-size: 22rpx;
}

.source-sheet .project-search-field,
.source-sheet .project-search-input {
  height: 66rpx;
  line-height: 66rpx;
}

.source-sheet .project-group-tabs {
  margin: 12rpx 0;
  padding: 4rpx;
}

.source-sheet .project-group-tab {
  min-height: 54rpx;
}

.source-sheet .project-group-count {
  display: none;
}

.source-sheet .project-source-item {
  min-height: 154rpx;
  margin-bottom: 12rpx;
  padding: 8rpx;
  border-radius: 20rpx;
}

.source-sheet .project-source-preview {
  width: 248rpx;
  min-height: 138rpx;
  border-radius: 14rpx;
}

.source-sheet .source-item-main {
  padding: 4rpx 12rpx;
}

.source-sheet .source-item-title {
  font-size: 26rpx;
}

.source-sheet .source-item-meta {
  font-size: 20rpx;
}

.source-sheet .project-source-detail {
  font-size: 22rpx;
}

.source-sheet .project-source-action {
  width: 112rpx;
  min-height: 62rpx;
  padding: 0 8rpx;
  font-size: 23rpx;
}

.source-sheet .project-source-item.active .project-source-action {
  min-width: 108rpx;
}

.ai-scroll {
  height: 100%;
}

.ai-shell {
  padding: 34rpx 36rpx 44rpx;
}

.page-head,
.project-context,
.journey-head,
.next-action,
.recent-head,
.sheet-head,
.source-item {
  display: flex;
  align-items: center;
}

.page-head {
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.immersive-page-head {
  width: 100%;
  box-sizing: border-box;
}

.without-plan .immersive-page-head {
  position: relative;
  z-index: 5;
  align-items: flex-start;
  flex-direction: column;
  padding-top: 20rpx;
  padding-left: 20rpx;
  margin-bottom: 0;
}

.without-plan .balance-pill {
  height: 60rpx;
  margin-top: 20rpx;
  margin-left: 0;
  padding: 0 20rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 6rpx 18rpx rgba(49, 42, 32, 0.08);
}

.page-heading,
.project-context-main,
.journey-copy,
.next-action-copy,
.source-item-main {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.page-heading {
  flex: 1;
}

.page-title {
  color: #292a2f;
  font-size: 56rpx;
  line-height: 1.16;
  font-weight: 700;
  letter-spacing: -2rpx;
}

.page-subtitle {
  max-width: 480rpx;
  margin-top: 8rpx;
  overflow: hidden;
  color: #6f7479;
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: 400;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.balance-pill {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  height: 64rpx;
  margin-left: 20rpx;
  padding: 0 19rpx;
  background: #fff8df;
  border-radius: var(--radius-full);
  box-sizing: border-box;
}

.credit-dot {
  position: relative;
  width: 24rpx;
  height: 24rpx;
  margin-right: 12rpx;
  background: linear-gradient(135deg, #18b957 0 50%, #5dd683 50% 100%);
  border-radius: 4rpx;
  transform: rotate(45deg);
}

.credit-dot::after {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 7rpx;
  height: 7rpx;
  background: rgba(255, 255, 255, 0.82);
  border-radius: 2rpx;
  content: "";
  transform: translate(-50%, -50%);
}

.balance-value {
  font-size: 24rpx;
  font-weight: 700;
}

.loading-balance {
  background: rgba(238, 232, 217, 0.9);
  color: var(--neutral-500);
}

.loading-balance .credit-dot {
  background: #d9cfb7;
}

.service-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
  padding: 18rpx 22rpx;
  background: #fff7e8;
  border-radius: 18rpx;
}

.service-copy {
  min-width: 0;
  flex: 1;
}

.service-title,
.service-message {
  display: block;
}

.service-title {
  color: #7a4f00;
  font-size: 24rpx;
  font-weight: 600;
}

.service-message {
  margin-top: 6rpx;
  color: #8b641d;
  font-size: 24rpx;
  line-height: 1.4;
}

.error-banner {
  background: #fff0ee;
}

.error-banner .service-title {
  color: #9b2f25;
}

.error-banner .service-message {
  color: #7e4b45;
}

.service-retry {
  flex: 0 0 auto;
  min-height: 64rpx;
  display: flex;
  align-items: center;
  margin-left: 18rpx;
  padding: 0 8rpx 0 20rpx;
  color: #9b2f25;
  font-size: 24rpx;
  font-weight: 700;
}

.home-skeleton {
  overflow: hidden;
  background: #fff;
  border-radius: 32rpx;
  box-shadow: 0 18rpx 44rpx rgba(64, 55, 37, 0.07);
}

.skeleton-visual {
  height: 650rpx;
  background: #ece9e1;
}

.skeleton-panel {
  padding: 28rpx 24rpx 32rpx;
}

.skeleton-line {
  width: 74%;
  height: 24rpx;
  background: #eceeea;
  border-radius: var(--radius-full);
}

.skeleton-line.short {
  width: 34%;
  margin-bottom: 18rpx;
}

.skeleton-action {
  width: 42%;
  height: 74rpx;
  margin-top: 26rpx;
  margin-left: auto;
  background: #e4e8e2;
  border-radius: 18rpx;
}

.shimmer {
  position: relative;
  overflow: hidden;
}

.shimmer::after {
  position: absolute;
  top: 0;
  bottom: 0;
  left: -55%;
  width: 40%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.58), transparent);
  content: "";
  animation: ai-shimmer 1.35s ease-in-out infinite;
}

@keyframes ai-shimmer {
  100% {
    left: 115%;
  }
}

.load-state {
  min-height: 680rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: #fff;
  border-radius: 32rpx;
  text-align: center;
  box-sizing: border-box;
}

.load-state-title {
  font-size: 30rpx;
  font-weight: 700;
}

.load-state-copy {
  margin-top: 12rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
  line-height: 1.5;
}

.load-state-action {
  min-width: 210rpx;
  min-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 28rpx;
  background: var(--brand-primary);
  border-radius: 18rpx;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}

.project-context {
  justify-content: space-between;
  min-height: 68rpx;
  margin-bottom: 12rpx;
}

.project-context-main {
  flex: 1;
}

.journey-kicker,
.next-kicker,
.discovery-source-label {
  color: var(--text-brand);
  font-size: 20rpx;
  line-height: 1.25;
  font-weight: 600;
}

.project-context-title {
  overflow: hidden;
  font-size: 26rpx;
  line-height: 1.3;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.project-context-meta {
  margin-top: 4rpx;
  color: var(--text-secondary);
  font-size: 20rpx;
  line-height: 1.3;
}

.project-context-actions {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  margin-left: 18rpx;
}

.context-action {
  min-height: 64rpx;
  display: flex;
  align-items: center;
  padding: 0 0 0 18rpx;
  color: var(--text-brand);
  font-size: 24rpx;
  font-weight: 600;
}

.context-action.muted {
  margin-left: 4rpx;
  color: var(--neutral-500);
  font-size: 24rpx;
  font-weight: 400;
}

.plan-navigator {
  overflow: hidden;
  background: #fffefa;
  border-radius: 32rpx;
  box-shadow: 0 18rpx 44rpx rgba(64, 55, 37, 0.09);
}

.plan-stage {
  position: relative;
  height: 620rpx;
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 44%, rgba(232, 222, 200, 0.36), rgba(250, 248, 241, 0) 54%),
    #f7f4ec;
}

.plan-guide-scene {
  position: absolute;
  right: -26rpx;
  bottom: -42rpx;
  z-index: 4;
  width: 198rpx;
  height: 198rpx;
  opacity: 0.96;
  pointer-events: none;
}

.plan-ai-image,
.plan-graph {
  position: absolute;
  left: 50%;
  top: 34rpx;
  width: 560rpx;
  height: 560rpx;
}

.plan-ai-image {
  border-radius: 18rpx;
  transform: translateX(-50%) scale(1);
  transition: transform 520ms cubic-bezier(0.16, 1, 0.3, 1);
}

.plan-graph {
  transform: translateX(-50%) perspective(800rpx) rotateX(8deg);
  transform-origin: 50% 72%;
  transition: transform 520ms cubic-bezier(0.16, 1, 0.3, 1);
}

.plan-stage.room-focused .plan-ai-image {
  transform: translateX(-50%) scale(1.045);
}

.plan-stage.room-focused .plan-graph {
  transform: translateX(-50%) perspective(800rpx) rotateX(8deg) scale(1.045);
}

.plan-room-fill {
  position: absolute;
  background: rgba(232, 225, 209, 0.68);
}

.plan-room-fill:nth-child(3n + 2) {
  background: rgba(224, 235, 219, 0.7);
}

.plan-room-fill:nth-child(3n + 3) {
  background: rgba(244, 229, 201, 0.66);
}

.plan-room-fill.active {
  background: rgba(181, 226, 186, 0.76);
}

.plan-wall {
  position: absolute;
  z-index: 3;
  height: 6rpx;
  background: #5d5a51;
  border-radius: var(--radius-full);
  transform-origin: 0 50%;
}

.plan-room-label {
  position: absolute;
  z-index: 4;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 60rpx;
  padding: 7rpx 12rpx;
  background: rgba(255, 255, 255, 0.94);
  border-radius: 12rpx;
  box-shadow: 0 6rpx 16rpx rgba(52, 48, 40, 0.08);
  font-size: 24rpx;
  line-height: 1.1;
  font-weight: 600;
  transform: translate(-50%, -50%);
  box-sizing: border-box;
}

.plan-room-label.active {
  color: #087f36;
  box-shadow: 0 8rpx 18rpx rgba(16, 157, 67, 0.14);
}

.room-current {
  margin-bottom: 5rpx;
  color: var(--text-brand);
  font-size: 24rpx;
  font-weight: 700;
}

.map-waypoint {
  position: absolute;
  z-index: 8;
  min-height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 22rpx;
  background: rgba(255, 255, 255, 0.96);
  border-radius: var(--radius-full);
  color: #3b3a35;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 22rpx rgba(60, 53, 41, 0.1);
  box-sizing: border-box;
}

.map-waypoint::after {
  content: "";
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  background: var(--brand-primary);
  border: 5rpx solid #fffefa;
  border-radius: var(--radius-full);
  box-shadow: 0 0 0 1rpx rgba(119, 95, 49, 0.32);
}

.waypoint-top {
  left: 50%;
  top: 12rpx;
  transform: translateX(-50%);
}

.waypoint-top::after {
  left: 50%;
  bottom: -23rpx;
  transform: translateX(-50%);
}

.waypoint-left {
  left: 8rpx;
  top: 48%;
}

.waypoint-left::after {
  right: -23rpx;
  top: 50%;
  transform: translateY(-50%);
}

.waypoint-right {
  right: 8rpx;
  top: 48%;
}

.waypoint-right::after {
  left: -23rpx;
  top: 50%;
  transform: translateY(-50%);
}

.waypoint-bottom {
  left: 50%;
  bottom: 12rpx;
  transform: translateX(-50%);
}

.waypoint-bottom::after {
  left: 50%;
  top: -23rpx;
  transform: translateX(-50%);
}

.preview-progress {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 7;
  width: 270rpx;
  padding: 20rpx 22rpx;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 18rpx;
  box-shadow: 0 12rpx 34rpx rgba(31, 41, 55, 0.14);
  transform: translate(-50%, -50%);
  box-sizing: border-box;
}

.preview-progress-label,
.preview-progress-value {
  display: block;
  text-align: center;
}

.preview-progress-label {
  font-size: 24rpx;
  font-weight: 700;
}

.preview-progress-value {
  margin-top: 6rpx;
  color: var(--text-brand);
  font-size: 24rpx;
  font-weight: 700;
}

.preview-progress-track {
  height: 7rpx;
  margin-top: 14rpx;
  overflow: hidden;
  background: var(--brand-primary-20);
  border-radius: var(--radius-full);
}

.preview-progress-bar {
  height: 100%;
  background: var(--brand-primary);
  border-radius: var(--radius-full);
}

.room-selector {
  position: relative;
  z-index: 4;
  margin-top: -4rpx;
  padding-top: 14rpx;
  overflow: hidden;
  background: #fff;
  border-radius: 30rpx 30rpx 0 0;
  box-shadow: 0 -10rpx 28rpx rgba(55, 48, 38, 0.08);
}

.room-selector-handle {
  width: 76rpx;
  height: 7rpx;
  margin: 0 auto 8rpx;
  background: #d8d9d7;
  border-radius: var(--radius-full);
}

.room-tabs {
  width: 100%;
}

.room-tabs-row {
  display: flex;
  min-width: 100%;
  padding: 8rpx 28rpx 20rpx;
  box-sizing: border-box;
}

.room-tab {
  position: relative;
  flex: 0 0 auto;
  min-width: 78rpx;
  min-height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  padding: 0 18rpx;
  border-radius: 15rpx;
  color: #40454a;
  font-size: 27rpx;
  line-height: 1;
  font-weight: 500;
  box-sizing: border-box;
}

.room-tab.active {
  background: var(--brand-primary);
  color: #fff;
  font-weight: 700;
}

.room-tab.active::after {
  position: absolute;
  left: 50%;
  bottom: -13rpx;
  width: 38rpx;
  height: 4rpx;
  background: var(--brand-primary);
  border-radius: var(--radius-full);
  content: "";
  transform: translateX(-50%);
}

.journey-panel,
.discovery-panel {
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  background: #fff;
  border-radius: 26rpx;
  box-shadow: 0 12rpx 34rpx rgba(57, 64, 54, 0.07);
}

.with-plan .journey-panel {
  position: relative;
  z-index: 5;
  margin-top: 16rpx;
  padding: 22rpx 24rpx 26rpx;
  border-radius: 24rpx;
  box-shadow: 0 18rpx 46rpx rgba(57, 64, 54, 0.1);
}

.journey-head {
  justify-content: space-between;
}

.journey-copy {
  flex: 1;
}

.journey-title {
  margin-top: 4rpx;
  overflow: hidden;
  font-size: 26rpx;
  line-height: 1.3;
  font-weight: 700;
  text-overflow: ellipsis;
