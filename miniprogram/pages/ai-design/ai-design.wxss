  box-shadow:
    inset 0 0 0 4rpx #fff,
    0 0 0 2rpx var(--brand-primary);
}

.reference-stage-rail .stage-label {
  margin-top: 12rpx;
  color: #797e7b;
  font-size: 24rpx;
}

.reference-stage-rail .stage-item.done .stage-label,
.reference-stage-rail .stage-item.current .stage-label {
  color: #0fa848;
  font-weight: 600;
}

.reference-stage-rail .stage-status {
  display: none;
}

.workflow-cards {
  display: flex;
  margin-top: 8rpx;
}

.workflow-card {
  min-width: 0;
  flex: 1;
  margin-right: 12rpx;
}

.workflow-card:last-child {
  margin-right: 0;
}

.workflow-card-title {
  display: block;
  overflow: hidden;
  color: #202327;
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 600;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.workflow-art {
  position: relative;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 12rpx;
  overflow: hidden;
  background:
    linear-gradient(145deg, rgba(248, 249, 247, 0.98), rgba(239, 244, 239, 0.98));
  border-radius: 16rpx;
  box-shadow: inset 0 0 0 1rpx rgba(220, 226, 220, 0.75);
}

.workflow-card:nth-child(2) .workflow-art {
  background: linear-gradient(145deg, #e8f5ea, #cbe8d0);
}

.workflow-card:nth-child(3) .workflow-art {
  background: linear-gradient(145deg, #f6f6f2, #e6ebe5);
}

.workflow-card:nth-child(4) .workflow-art {
  background: linear-gradient(145deg, #edf6ed, #d9ead8);
}

.workflow-art image {
  width: 62rpx;
  height: 62rpx;
}

.workflow-card.recommended .workflow-art {
  box-shadow: inset 0 0 0 2rpx rgba(34, 197, 94, 0.42);
}

.workflow-art-corner {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  width: 9rpx;
  height: 9rpx;
  background: var(--brand-primary);
  border-radius: var(--radius-full);
}

.workflow-card.disabled {
  opacity: 0.46;
}

.design-workbench .workflow-state {
  margin-right: 0;
  margin-left: 0;
}

.reference-next-action {
  position: relative;
  min-height: 114rpx;
  display: flex;
  align-items: stretch;
  margin: 16rpx -22rpx 0;
  padding: 0 28rpx 0 148rpx;
  overflow: hidden;
  background: linear-gradient(112deg, #09ad4b 0%, #16c75b 48%, #08a844 100%);
  border-radius: 30rpx;
  color: #fff;
  box-shadow: 0 12rpx 26rpx rgba(14, 169, 72, 0.2);
  box-sizing: border-box;
}

.reference-next-action.disabled {
  filter: grayscale(0.25);
  opacity: 0.58;
}

.next-action-k {
  position: absolute;
  left: 22rpx;
  bottom: -8rpx;
  z-index: 2;
  width: 120rpx;
  height: 120rpx;
}

.reference-next-action .next-action {
  width: 100%;
  min-width: 0;
  display: flex;
  align-items: center;
}

.reference-next-action .next-action-copy {
  justify-content: center;
}

.next-kicker-row {
  display: flex;
  align-items: center;
}

.reference-next-action .next-kicker {
  color: rgba(255, 255, 255, 0.94);
  font-size: 28rpx;
  line-height: 1.1;
  font-weight: 700;
}

.next-action-meta {
  margin-left: 14rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
  line-height: 1.1;
  font-weight: 500;
  white-space: nowrap;
}

.reference-next-action .next-title {
  max-width: 390rpx;
  margin-top: 10rpx;
  overflow: hidden;
  color: #fff;
  font-size: 32rpx;
  line-height: 1.16;
  font-weight: 700;
  letter-spacing: -1rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.reference-next-action .next-button {
  width: 72rpx;
  min-width: 72rpx;
  height: 72rpx;
  min-height: 72rpx;
  margin-left: 12rpx;
  padding: 0;
  background: rgba(0, 122, 48, 0.28);
  border: 5rpx solid rgba(255, 255, 255, 0.22);
  border-radius: var(--radius-full);
  box-shadow: none;
}

.reference-next-action .next-button-chevron {
  width: 24rpx;
  height: 24rpx;
  margin-left: -7rpx;
  border-top-width: 7rpx;
  border-right-width: 7rpx;
  color: #fff;
}

.sheet-actions {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
}

.sheet-clear,
.sheet-close {
  min-height: 84rpx;
  display: flex;
  align-items: center;
  padding-left: 22rpx;
  font-size: 24rpx;
}

.sheet-clear {
  color: #8b4d40;
}

@media (max-width: 360px) {
  .with-plan {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .with-plan .immersive-page-head {
    padding-left: 4rpx;
  }

  .with-plan .page-title {
    font-size: 52rpx;
  }

  .with-plan .balance-pill {
    padding-right: 14rpx;
    padding-left: 14rpx;
  }

  .reference-plan-navigator {
    margin-right: -24rpx;
    margin-left: -24rpx;
  }

  .reference-plan-stage {
    height: 760rpx;
  }

  .reference-plan-stage .plan-ai-image,
  .reference-plan-stage .plan-graph {
    width: 626rpx;
    height: 674rpx;
  }

  .plan-guide-stage {
    width: 120rpx;
    height: 120rpx;
  }

  .design-workbench {
    margin-top: -70rpx;
    padding-right: 18rpx;
    padding-left: 18rpx;
  }

  .workflow-card {
    margin-right: 8rpx;
  }

  .workflow-card-title {
    font-size: 24rpx;
  }

  .workflow-art {
    height: 92rpx;
  }

  .reference-next-action {
    margin-right: -18rpx;
    margin-left: -18rpx;
    padding-left: 132rpx;
  }

  .next-action-k {
    left: 14rpx;
    width: 112rpx;
    height: 112rpx;
  }

  .reference-next-action .next-title {
    max-width: 326rpx;
    font-size: 29rpx;
  }
}
