.ai-page { min-height: 100vh; background: #fafbf8; color: var(--text-primary); }
.ai-shell { padding: 26rpx 28rpx calc(46rpx + env(safe-area-inset-bottom)); }
.balance-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.page-title { font-size: 48rpx; line-height: 1.15; font-weight: 700; }
.balance-pill { display: flex; align-items: center; height: 58rpx; padding: 0 22rpx; background: #fff8df; border-radius: var(--radius-full); }
.credit-dot { width: 14rpx; height: 14rpx; margin-right: 10rpx; background: #e9b000; border-radius: var(--radius-full); }
.balance-value { font-size: 25rpx; font-weight: 700; }
.service-banner { margin-bottom: 20rpx; padding: 20rpx 22rpx; background: #fff7e8; border-radius: var(--radius-md); }
.service-title { display: block; font-size: 24rpx; font-weight: 600; color: #8a5a00; }
.service-message { display: block; margin-top: 7rpx; font-size: 21rpx; color: #9a6b1a; }
.hero-card { position: relative; height: 272rpx; overflow: hidden; border-radius: var(--radius-xl); box-shadow: var(--shadow-card); }
.hero-image { width: 100%; height: 100%; }
.hero-shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(18,32,23,.74) 0%, rgba(18,32,23,.26) 62%, rgba(18,32,23,.03) 100%); }
.hero-copy { position: absolute; left: 28rpx; top: 0; bottom: 0; width: 330rpx; display: flex; flex-direction: column; justify-content: center; }
.hero-title { color: var(--text-inverse); font-size: 34rpx; line-height: 1.35; font-weight: 700; }
.hero-meta { margin-top: 12rpx; color: rgba(255,255,255,.76); font-size: 21rpx; }
.source-card { min-height: 112rpx; margin-top: 20rpx; padding: 20rpx 22rpx; display: flex; align-items: center; box-sizing: border-box; background: var(--bg-surface); border-radius: var(--radius-lg); box-shadow: var(--shadow-card); }
.source-card.selected { background: var(--bg-surface-soft); box-shadow: inset 0 0 0 1rpx var(--border-brand-soft); }
.source-badge { flex: 0 0 70rpx; height: 70rpx; margin-right: 18rpx; display: flex; align-items: center; justify-content: center; background: var(--brand-primary-20); border-radius: var(--radius-md); color: var(--text-brand); font-size: 20rpx; font-weight: 700; }
.source-copy { min-width: 0; flex: 1; display: flex; flex-direction: column; }
.source-title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 24rpx; font-weight: 700; }
.source-meta { margin-top: 7rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text-secondary); font-size: 20rpx; }
.source-actions { margin-left: 16rpx; display: flex; flex-direction: column; align-items: flex-end; gap: 10rpx; }
.source-change { margin-left: 16rpx; color: var(--text-brand); font-size: 22rpx; font-weight: 600; }
.source-clear { color: var(--neutral-500); font-size: 19rpx; }
.section-head { display: flex; align-items: center; justify-content: space-between; margin: 30rpx 2rpx 16rpx; }
.task-head { margin-top: 24rpx; }
.section-label { display: flex; align-items: center; }
.section-mark { width: 7rpx; height: 28rpx; margin-right: 13rpx; background: var(--brand-primary); border-radius: var(--radius-full); }
.section-title { font-size: 29rpx; font-weight: 700; }
.context-chip { padding: 8rpx 15rpx; background: var(--bg-surface-soft); border-radius: var(--radius-full); color: var(--text-brand); font-size: 20rpx; }
.workflow-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; }
.workflow-card { position: relative; min-height: 216rpx; padding: 22rpx; display: flex; flex-direction: column; background: var(--bg-surface); border-radius: var(--radius-lg); box-shadow: var(--shadow-card); box-sizing: border-box; }
.workflow-card.recommended { box-shadow: inset 0 0 0 2rpx var(--border-brand-soft), var(--shadow-card); }
.recommend-chip { position: absolute; top: 16rpx; right: 16rpx; padding: 5rpx 10rpx; background: var(--brand-primary-20); border-radius: var(--radius-full); color: var(--text-brand); font-size: 17rpx; font-weight: 700; }
.workflow-card.disabled { opacity: .48; }
.workflow-icon { width: 48rpx; height: 48rpx; }
.workflow-title { margin-top: 12rpx; font-size: 26rpx; line-height: 1.25; font-weight: 700; }
.workflow-desc { margin-top: 7rpx; color: var(--text-secondary); font-size: 20rpx; line-height: 1.4; }
.workflow-cost { margin-top: auto; padding-top: 12rpx; color: var(--text-brand); font-size: 21rpx; font-weight: 600; }
.history-link { color: var(--text-brand); font-size: 23rpx; }
.link-arrow { font-size: 29rpx; }
.recent-strip { width: calc(100vw - 28rpx); }
.recent-row { display: flex; gap: 16rpx; padding-right: 28rpx; }
.result-card { flex: 0 0 286rpx; overflow: hidden; background: var(--bg-surface); border-radius: var(--radius-lg); box-shadow: var(--shadow-card); }
.result-image { width: 286rpx; height: 174rpx; background: var(--neutral-100); }
.result-footer { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 5rpx 10rpx; padding: 13rpx 16rpx; }
.result-mode { font-size: 21rpx; font-weight: 600; }
.result-target { grid-column: 1 / -1; overflow: hidden; color: var(--text-secondary); font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }
.result-status { font-size: 19rpx; color: var(--text-secondary); }
.empty-result { display: flex; align-items: center; justify-content: center; height: 116rpx; background: var(--bg-surface); border-radius: var(--radius-lg); box-shadow: var(--shadow-card); }
.empty-icon { display: flex; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; margin-right: 16rpx; border-radius: var(--radius-full); background: var(--brand-primary-20); color: var(--brand-primary); font-size: 19rpx; font-weight: 700; }
.empty-title { color: var(--text-secondary); font-size: 22rpx; }
.source-mask { position: fixed; inset: 0; z-index: 30; background: rgba(15, 24, 18, .42); }
.source-sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 31; max-height: 72vh; padding: 14rpx 28rpx calc(28rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: var(--bg-surface); border-radius: 30rpx 30rpx 0 0; }
.sheet-handle { width: 72rpx; height: 7rpx; margin: 0 auto 22rpx; background: var(--border-soft); border-radius: var(--radius-full); }
.sheet-head { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 20rpx; }
.sheet-title { display: block; font-size: 30rpx; font-weight: 700; }
.sheet-subtitle { display: block; margin-top: 8rpx; color: var(--text-secondary); font-size: 20rpx; }
.sheet-close { padding: 4rpx 0 12rpx 22rpx; color: var(--text-brand); font-size: 22rpx; }
.source-list { height: 760rpx; max-height: 55vh; }
.source-back { padding: 4rpx 2rpx 18rpx; color: var(--text-brand); font-size: 22rpx; font-weight: 600; }
.source-item { min-height: 122rpx; margin-bottom: 14rpx; padding: 20rpx 22rpx; display: flex; align-items: center; box-sizing: border-box; background: var(--bg-surface-soft); border-radius: var(--radius-lg); }
.source-item.target-item { min-height: 128rpx; }
.source-item.active { box-shadow: inset 0 0 0 2rpx var(--border-brand-soft); }
.source-item-main { min-width: 0; flex: 1; display: flex; flex-direction: column; }
.source-item-title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 24rpx; font-weight: 700; }
.source-item-meta, .source-item-detail { margin-top: 6rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text-secondary); font-size: 19rpx; }
.source-item-detail { color: var(--neutral-500); }
.source-check { margin-left: 18rpx; color: var(--text-brand); font-size: 21rpx; font-weight: 600; }
.scheme-card { display: flex; align-items: center; margin-top: 16rpx; padding: 20rpx 22rpx; background: var(--bg-surface-soft); border-radius: var(--radius-lg); box-shadow: var(--shadow-card); }
.scheme-card.alternative { background: var(--bg-surface); border: 1rpx dashed var(--border-brand-soft); box-shadow: none; }
.scheme-status { flex: 0 0 14rpx; width: 14rpx; height: 14rpx; margin-right: 18rpx; background: var(--brand-primary); border-radius: var(--radius-full); }
.scheme-copy { min-width: 0; flex: 1; }
.scheme-eyebrow { display: block; color: var(--text-brand); font-size: 18rpx; font-weight: 600; }
.scheme-title { display: block; margin-top: 5rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 24rpx; font-weight: 700; }
.scheme-meta { display: block; margin-top: 6rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text-secondary); font-size: 19rpx; }
.scheme-next { display: block; margin-top: 4rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text-brand); font-size: 19rpx; font-weight: 600; }
.scheme-change { margin-left: 16rpx; color: var(--text-brand); font-size: 20rpx; }
.source-item.new-scheme { border: 1rpx dashed var(--border-brand-soft); background: var(--bg-surface); }
