<!--
THESIS: Turn a real measured home into the navigation surface; refuse the generic AI tool grid.
OWN-WORLD: Warm residential space, formal wall geometry, crisp white controls, quiet oak, and one committed green action.
STORY: Choose a real home or room, see its live scheme stage, enter one of four implemented tasks, then continue one honest next action.
FIRST VIEWPORT: Project identity and credits sit above the warm spatial hero; only real, successful user floor-plan generations replace it as a tappable carousel, while one raised workbench joins the stage rail, four task entries, and the final CTA before the shared TabBar.
FORM: The retained ai-design-hero-v3 scene is the honest empty/default hero; verified user-generated floor-plan results become its carousel content.
-->
<view class="ai-page sfp-tab-page">
  <scroll-view
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    refresher-enabled
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
    class="ai-scroll"
  >
    <view
      class="ai-shell {{selectedSource ? 'with-plan' : 'without-plan'}}"
      style="--ai-navigation-top: {{navigationTop}}px; padding-top: {{navigationTop}}px;"
    >
      <view
        class="page-head immersive-page-head"
        style="--ai-navigation-right: {{navigationRight}}px; padding-right: {{navigationRight}}px; min-height: {{navigationHeight}}px;"
      >
        <view class="page-heading">
          <text class="page-title">{{selectedSource ? '探索这个家' : '设计空间'}}</text>
          <view
            class="page-subtitle-line"
            bindtap="openSourcePicker"
            aria-role="button"
            aria-label="{{selectedSource ? '更换当前客户户型' : '选择客户户型'}}"
          >
            <text class="page-subtitle">{{selectedSource ? (selectedSource.leadName + ' · ' + (selectedSource.communityName || selectedSource.floorPlanName)) : '为客户探索下一种生活方式'}}</text>
            <view wx:if="{{selectedSource}}" class="project-chevron"></view>
          </view>
        </view>
        <view class="balance-pill {{hasLoadedOnce ? '' : 'loading-balance'}}">
          <view class="credit-dot"></view>
          <text class="balance-value">{{hasLoadedOnce ? account.availableBalance + ' 点' : '加载中'}}</text>
        </view>
      </view>

      <view wx:if="{{loading && !hasLoadedOnce}}" class="home-skeleton">
        <view class="skeleton-visual shimmer"></view>
        <view class="skeleton-panel">
          <view class="skeleton-line short shimmer"></view>
          <view class="skeleton-line shimmer"></view>
          <view class="skeleton-action shimmer"></view>
        </view>
      </view>

      <view wx:elif="{{loadError && !hasLoadedOnce}}" class="load-state">
        <text class="load-state-title">设计空间加载失败</text>
        <text class="load-state-copy">{{loadError}}</text>
        <view class="load-state-action" bindtap="retryLoad">重新加载</view>
      </view>

      <block wx:else>
        <view wx:if="{{loadError}}" class="service-banner error-banner">
          <view class="service-copy">
            <text class="service-title">刷新失败</text>
            <text class="service-message">已保留当前内容，可稍后重试</text>
          </view>
          <text class="service-retry" bindtap="retryLoad">重试</text>
        </view>

        <view wx:if="{{!provider.available}}" class="service-banner">
          <view class="service-copy">
            <text class="service-title">设计服务暂不可用</text>
            <text class="service-message">{{provider.error || '请联系平台管理员配置企业 AI 服务'}}</text>
          </view>
        </view>

        <block wx:if="{{selectedSource}}">
        <view class="plan-navigator reference-plan-navigator">
          <view class="plan-stage reference-plan-stage {{selectedSource.targetScope === 'single_room' ? 'room-focused' : 'whole-focused'}} {{heroSlides.length ? 'has-generated-hero' : 'has-default-hero'}}">
            <swiper
              wx:if="{{heroSlides.length}}"
              class="plan-hero-swiper"
              circular="{{heroSlides.length > 1}}"
              autoplay="{{heroSlides.length > 1}}"
              interval="4200"
              duration="460"
              current="{{activeHeroSlide}}"
              bindchange="onHeroSlideChange"
            >
              <swiper-item wx:for="{{heroSlides}}" wx:key="id">
                <view
                  class="plan-hero-slide"
                  data-id="{{item.id}}"
                  bindtap="openHeroSlide"
                  aria-role="button"
                  aria-label="查看{{item.title}}"
                >
                  <image class="plan-hero-image" src="{{item.imageUrl}}" mode="aspectFill"></image>
                  <view class="plan-hero-shade"></view>
                  <view class="plan-hero-caption">
                    <text class="plan-hero-title">{{item.title}}</text>
                    <text class="plan-hero-meta">{{item.meta}}</text>
                  </view>
                </view>
              </swiper-item>
            </swiper>
            <view wx:else class="plan-default-scene">
              <image class="plan-default-scene-image scene-image" src="/images/ai-design-hero-v3.png" mode="aspectFill"></image>
              <view class="plan-default-scene-shade"></view>
            </view>

            <scroll-view scroll-x class="hero-room-rail" enhanced show-scrollbar="{{false}}">
              <view class="hero-room-row">
                <view
                  class="hero-room-chip {{selectedSource.targetScope === 'whole_floor_plan' ? 'active' : ''}}"
                  data-scope="whole_floor_plan"
                  bindtap="selectMapTarget"
                  aria-role="button"
                  aria-label="选择完整户型"
                  aria-checked="{{selectedSource.targetScope === 'whole_floor_plan'}}"
                >
                  <view class="hero-room-chip-label"><text>全屋</text></view>
                </view>
                <view
                  wx:for="{{selectedSource.rooms}}"
                  wx:for-item="room"
                  wx:key="roomId"
                  class="hero-room-chip {{selectedSource.roomId === room.roomId ? 'active' : ''}}"
                  data-scope="single_room"
                  data-index="{{index}}"
                  bindtap="selectMapTarget"
                  aria-role="button"
                  aria-label="选择{{room.roomName}}"
                  aria-checked="{{selectedSource.roomId === room.roomId}}"
                >
                  <view class="hero-room-chip-label"><text>{{room.roomName}}</text></view>
                </view>
              </view>
            </scroll-view>

            <view wx:if="{{heroSlides.length > 1}}" class="hero-slide-count">
              <text>{{activeHeroSlide + 1}} / {{heroSlides.length}}</text>
            </view>

            <view wx:if="{{selectedSource.navigationPreview.state === 'processing'}}" class="preview-progress">
              <text class="preview-progress-label">3D 户型生成中</text>
              <text class="preview-progress-value">{{selectedSource.navigationPreview.task.progress}}%</text>
              <view class="preview-progress-track">
                <view class="preview-progress-bar" style="width: {{selectedSource.navigationPreview.task.progress}}%"></view>
              </view>
            </view>
            <image
              class="plan-guide-scene plan-guide-stage"
              src="/images/mine-icons/tab-measure-k.png"
              mode="aspectFit"
              aria-hidden="true"
            ></image>
          </view>
        </view>

        <view class="journey-panel design-workbench">
          <view
            class="stage-rail reference-stage-rail"
            bindtap="openWorkflowPicker"
            aria-role="button"
            aria-label="{{schemeOptions.length ? '查看或更换当前客户方案' : '当前客户方案阶段'}}"
          >
            <view
              wx:for="{{stageRail}}"
              wx:for-item="stage"
              wx:key="key"
              class="stage-item {{stage.status}}"
            >
              <view class="stage-node">
                <view class="stage-dot">
                  <view wx:if="{{stage.status === 'done'}}" class="stage-check"></view>
                </view>
                <view wx:if="{{index < stageRail.length - 1}}" class="stage-line"></view>
              </view>
              <text class="stage-label">{{stage.label}}</text>
              <text wx:if="{{stage.status === 'current'}}" class="stage-status">进行中</text>
            </view>
          </view>

          <view class="workflow-cards">
            <view
              wx:for="{{workflows}}"
              wx:for-item="workflow"
              wx:key="key"
              class="workflow-card {{primaryAction.mode === workflow.key ? 'recommended' : ''}} {{workflow.enabled && !workflowLoading && !workflowLoadError ? '' : 'disabled'}}"
              data-mode="{{workflow.key}}"
              data-scope="{{workflow.key === 'floor_plan_render' ? 'whole_floor_plan' : ''}}"
              bindtap="openMode"
              aria-role="button"
              aria-label="{{workflow.title + '，' + workflow.credits + '点'}}"
              aria-disabled="{{workflow.enabled && !workflowLoading && !workflowLoadError ? false : true}}"
            >
              <text class="workflow-card-title">{{workflow.title}}</text>
              <view class="workflow-art">
                <image src="{{workflow.icon}}" mode="aspectFit"></image>
                <view wx:if="{{primaryAction.mode === workflow.key}}" class="workflow-art-corner"></view>
              </view>
            </view>
          </view>

          <view wx:if="{{workflowLoading || workflowLoadError}}" class="workflow-state {{workflowLoadError ? 'error' : ''}}">
            <view class="workflow-state-copy">
              <text class="workflow-state-title">{{workflowLoading ? '正在加载客户方案' : '客户方案加载失败'}}</text>
              <text class="workflow-state-detail">{{workflowLoading ? '加载完成后即可继续设计' : '为避免成果写入错误方案，请先重新加载'}}</text>
            </view>
            <text wx:if="{{workflowLoadError}}" class="workflow-state-action" bindtap="retryWorkflowLoad">重试</text>
          </view>

          <view
            class="next-action-panel reference-next-action {{primaryAction.enabled && !workflowLoading && !workflowLoadError ? '' : 'disabled'}}"
            bindtap="openPrimaryAction"
            aria-role="button"
            aria-label="{{primaryAction.title + '，' + primaryAction.buttonLabel + (primaryAction.credits ? '，' + primaryAction.credits + '点' : '')}}"
          >
            <image class="next-action-k" src="/images/page-ip-v3/ai-create.png" mode="aspectFit"></image>
            <view class="next-action">
              <view class="next-action-copy">
                <view class="next-kicker-row">
                  <text class="next-kicker">下一步</text>
                  <text class="next-action-meta">{{primaryAction.buttonLabel}}{{primaryAction.credits ? ' · ' + primaryAction.credits + ' 点' : ''}}</text>
                </view>
                <text class="next-title">{{primaryAction.title}}</text>
              </view>
              <view class="next-button">
                <view class="next-button-chevron"></view>
              </view>
            </view>
          </view>
        </view>
        </block>

        <block wx:else>
        <view class="scene-navigator {{sceneNavigation.focusClass}}">
          <image class="scene-image" src="/images/ai-design-hero-v3.png" mode="aspectFill"></image>
          <view class="scene-shade"></view>
          <view class="scene-waypoint scene-point-one {{activeSceneMode === 'reference_recreate' ? 'active' : ''}}" data-mode="reference_recreate" bindtap="focusSceneWaypoint">
            <view class="scene-waypoint-icon"><image src="/images/ai-design-icons/reference.png" mode="aspectFit"></image></view>
            <text>参考图复刻</text>
          </view>
          <view class="scene-waypoint scene-point-two {{activeSceneMode === 'style_transform' ? 'active' : ''}}" data-mode="style_transform" bindtap="focusSceneWaypoint">
            <view class="scene-waypoint-icon"><image src="/images/ai-design-icons/palette.png" mode="aspectFit"></image></view>
            <text>拍照换风格</text>
          </view>
          <view class="scene-waypoint scene-point-three {{activeSceneMode === 'floor_plan_render' ? 'active' : ''}}" data-mode="floor_plan_render" bindtap="focusSceneWaypoint">
            <view class="scene-waypoint-icon"><image src="/images/ai-design-icons/floor-plan.png" mode="aspectFit"></image></view>
            <text>户型生成</text>
          </view>
          <view class="scene-waypoint scene-point-four {{activeSceneMode === 'soft_furnishing' ? 'active' : ''}}" data-mode="soft_furnishing" bindtap="focusSceneWaypoint">
            <view class="scene-waypoint-icon"><image src="/images/ai-design-icons/armchair.png" mode="aspectFit"></image></view>
            <text>软装搭配</text>
          </view>
          <view class="scene-source-card" bindtap="openSourcePicker">
            <view class="scene-source-preview">
              <image src="/images/ai-design-icons/floor-plan.png" mode="aspectFit"></image>
            </view>
            <view class="scene-source-copy">
              <text class="scene-source-title">选择真实户型</text>
              <text class="scene-source-meta">{{sources.length ? '按全屋或房间开始探索' : '完成正式量房后即可关联'}}</text>
            </view>
            <view class="scene-source-action {{sources.length ? '' : 'disabled'}}">
              <text>{{sources.length ? '选择' : '暂无户型'}}</text>
              <view wx:if="{{sources.length}}" class="scene-source-chevron"></view>
            </view>
          </view>
        </view>

        <view class="discovery-panel">
          <view class="discovery-handle"></view>
          <view class="next-action standalone">
            <view class="next-action-copy">
              <view class="discovery-recommendation">
                <image src="/images/mine-icons/tab-ai-active.png" mode="aspectFit"></image>
                <text class="next-kicker">建议下一步</text>
              </view>
              <text class="next-title">{{sceneNavigation.title}}</text>
            </view>
            <view class="next-button {{sceneNavigation.enabled ? '' : 'disabled'}}" bindtap="enterSceneMode">
              <text>{{sceneNavigation.buttonLabel}}</text>
              <view class="next-button-chevron"></view>
            </view>
          </view>
        </view>
        </block>

        <view wx:if="{{historyLoadError}}" class="history-state">
          <text>最近成果暂时加载失败</text>
          <text class="history-state-action" bindtap="retryLoad">重试</text>
        </view>

        <view class="recent-head">
          <text class="recent-title">最近方案</text>
          <view class="history-link" bindtap="openHistory">更多 <view class="history-chevron"></view></view>
        </view>

        <scroll-view wx:if="{{recent.length}}" scroll-x class="recent-strip" enhanced show-scrollbar="{{false}}">
          <view class="recent-row">
            <view
              wx:for="{{recent}}"
              wx:for-item="result"
              wx:key="id"
              class="result-card {{result.isProcessing ? 'processing' : ''}}"
              data-id="{{result.id}}"
              bindtap="openResult"
            >
              <image wx:if="{{result.displayImageUrl}}" class="result-image" src="{{result.displayImageUrl}}" mode="aspectFill"></image>
              <view wx:else class="result-image result-placeholder">
                <view class="result-placeholder-dot"></view>
                <text>{{result.isProcessing ? '正在生成 ' + result.progress + '%' : '暂无预览'}}</text>
              </view>
              <view class="result-footer">
                <text class="result-mode">{{result.modeTitle}}</text>
                <text class="result-status {{result.statusClass}}">{{result.statusLabel}}</text>
                <text wx:if="{{result.targetLabel}}" class="result-target">{{result.targetLabel}}</text>
              </view>
              <view wx:if="{{result.isProcessing}}" class="result-progress-track">
                <view class="result-progress-bar" style="width: {{result.progress}}%"></view>
              </view>
            </view>
          </view>
        </scroll-view>

        <view wx:else class="empty-result">
          <text class="empty-title">还没有设计成果</text>
          <text class="empty-copy">完成第一次探索后，方案会保存在这里</text>
        </view>
      </block>
    </view>
  </scroll-view>

  <view wx:if="{{sourcePickerOpen}}" class="source-mask" catchtap="closeSourcePicker"></view>
  <view wx:if="{{sourcePickerOpen}}" class="source-sheet" catchtap="noop">
    <view class="sheet-handle"></view>
    <view class="sheet-head">
      <view>
        <text class="sheet-title">{{sourcePickerStep === 'plans' ? '选择客户户型' : '选择设计范围'}}</text>
        <text class="sheet-subtitle">{{sourcePickerStep === 'plans' ? '选择一份正式量房户型' : (activeSourcePlan ? activeSourcePlan.leadName + ' · ' + activeSourcePlan.floorPlanName : '')}}</text>
      </view>
      <view class="sheet-actions">
        <text wx:if="{{selectedSource}}" class="sheet-clear" bindtap="clearSource" aria-role="button" aria-label="清除当前户型">清除</text>
        <text class="sheet-close" bindtap="closeSourcePicker" aria-role="button" aria-label="关闭户型选择">关闭</text>
      </view>
    </view>
    <scroll-view scroll-y class="source-list" enhanced show-scrollbar="{{false}}">
      <block wx:if="{{sourcePickerStep === 'plans'}}">
        <view wx:for="{{sources}}" wx:key="sourceKey" class="source-item {{item.selected ? 'active' : ''}}" data-index="{{index}}" bindtap="selectSourcePlan">
          <view class="source-item-main">
            <text class="source-item-title">{{item.leadName}} · {{item.floorPlanName}}</text>
            <text class="source-item-meta">{{item.communityName || '未填写小区'}} · {{item.closedRoomCount}} 个闭合房间</text>
            <text class="source-item-detail">选择后可设计完整户型或其中一个房间</text>
          </view>
          <text class="source-check">下一步</text>
        </view>
      </block>
      <block wx:else>
        <view class="source-back" bindtap="backSourcePlans">返回户型列表</view>
        <view class="source-item target-item {{selectedSource && selectedSource.floorPlanId === activeSourcePlan.floorPlanId && selectedSource.targetScope === 'whole_floor_plan' ? 'active' : ''}}" bindtap="selectWholeSource">
          <view class="source-item-main">
            <text class="source-item-title">完整户型</text>
            <text class="source-item-meta">{{activeSourcePlan.closedRoomCount}} 个闭合房间 · 全屋 3D 剖切效果</text>
            <text class="source-item-detail">生成一张来自正式墙图的 3D 户型导览图</text>
          </view>
          <text class="source-check">选择</text>
        </view>
        <view wx:for="{{activeSourcePlan.rooms}}" wx:key="roomId" class="source-item target-item {{selectedSource && selectedSource.roomId === item.roomId ? 'active' : ''}}" data-index="{{index}}" bindtap="selectRoomSource">
          <view class="source-item-main">
            <text class="source-item-title">{{item.roomName}}</text>
            <text class="source-item-meta">{{item.roomSize}} · {{item.openingCount}} 个门窗开口</text>
            <text class="source-item-detail">生成该房间的室内视角概念图</text>
          </view>
          <text class="source-check">选择</text>
        </view>
      </block>
    </scroll-view>
  </view>

  <view wx:if="{{workflowPickerOpen}}" class="source-mask" catchtap="closeWorkflowPicker"></view>
  <view wx:if="{{workflowPickerOpen}}" class="source-sheet" catchtap="noop">
    <view class="sheet-handle"></view>
    <view class="sheet-head">
      <view>
        <text class="sheet-title">选择客户方案</text>
        <text class="sheet-subtitle">本次成果会继续写入选中的方案</text>
      </view>
      <text class="sheet-close" bindtap="closeWorkflowPicker">关闭</text>
    </view>
    <scroll-view scroll-y class="source-list" enhanced show-scrollbar="{{false}}">
      <view wx:for="{{schemeOptions}}" wx:key="id" class="source-item {{item.id === workflowId ? 'active' : ''}}" data-index="{{index}}" bindtap="selectWorkflow">
        <view class="source-item-main">
          <text class="source-item-title">{{item.title}}</text>
          <text class="source-item-meta">{{item.currentStageLabel}} · {{item.recommendedLabel}}</text>
          <text class="source-item-detail">{{item.isPrimary ? '主方案' : '备选方案'}}</text>
        </view>
        <text class="source-check">{{item.id === workflowId ? '已选' : '选择'}}</text>
      </view>
      <view class="source-item new-scheme" bindtap="createAlternativeWorkflow">
        <view class="source-item-main">
          <text class="source-item-title">新建备选方案</text>
          <text class="source-item-meta">保留现有方案，另外创建一条设计路线</text>
        </view>
        <text class="source-check">新建</text>
      </view>
    </scroll-view>
  </view>
</view>
