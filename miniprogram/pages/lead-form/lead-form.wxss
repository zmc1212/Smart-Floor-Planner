.page-container {
  min-height: 100vh;
  background: var(--bg-page);
  display: flex;
  flex-direction: column;
}

.custom-header {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  background: var(--bg-surface);
  z-index: 100;
  box-shadow: var(--shadow-card);
}

.header-content {
  display: flex;
  align-items: center;
  padding: 0 var(--space-section);
  position: relative;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: var(--space-lg);
  border-radius: var(--radius-full);
  background: var(--brand-primary-20);
}

.back-arrow {
  font-size: 48rpx;
  color: var(--text-brand);
  font-weight: var(--font-weight-regular);
  line-height: 1;
}

.page-title {
  font-size: 32rpx;
  font-weight: var(--font-weight-medium);
  color: var(--text-primary);
}

.main-content {
  flex: 1;
}

.form-wrapper {
  padding: var(--space-section);
  padding-bottom: 100rpx;
}

.form-intro {
  margin-bottom: var(--space-section);
  padding: var(--space-xxl);
  border-radius: var(--radius-lg);
  background: var(--bg-surface-soft);
}

.form-intro .desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.quick-select-section {
  margin-bottom: var(--space-section);
  background: var(--bg-surface);
  padding: var(--space-xxl);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.quick-select-title {
  font-size: var(--font-size-caption);
  color: var(--text-secondary);
  margin-bottom: var(--space-lg);
  display: block;
  font-weight: var(--font-weight-medium);
}

.quick-select-list {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
}

.quick-select-item {
  display: inline-block;
  background: var(--brand-primary-20);
  color: var(--text-brand);
  padding: 12rpx 24rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-size-caption);
  margin-right: var(--space-lg);
}

.form-card {
  background: var(--bg-surface);
  border-radius: var(--radius-lg);
  padding: var(--space-section);
  box-shadow: var(--shadow-card);
}

.form-group {
  margin-bottom: var(--space-section);
}

.form-group:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 26rpx;
  font-weight: var(--font-weight-medium);
  color: var(--text-primary);
  margin-bottom: var(--space-md);
  display: block;
}

.required {
  color: var(--status-converted-text);
  margin-left: var(--space-xs);
}

.input,
.picker-view {
  width: 100%;
  height: 96rpx;
  background: var(--neutral-100);
  border-radius: var(--radius-md);
  padding: 0 var(--space-xxl);
  font-size: var(--font-size-body);
  color: var(--text-primary);
  box-sizing: border-box;
  box-shadow: var(--shadow-border-soft);
}

.input-phone-group {
  display: flex;
  align-items: center;
  gap: var(--space-lg);
}

.picker-view {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-view.placeholder {
  color: var(--text-secondary);
}

.arrow {
  font-size: 32rpx;
  color: var(--text-brand);
}

.form-footer {
  margin-top: 56rpx;
  padding: 0 var(--space-xl);
}

.submit-btn {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  background: var(--brand-primary);
  color: var(--text-inverse);
  font-size: 30rpx;
  font-weight: var(--font-weight-medium);
  border-radius: var(--radius-lg);
  margin: 0;
  padding: 0;
  box-shadow: var(--shadow-float);
}

.submit-btn-hover {
  opacity: 0.9;
  transform: translateY(1rpx);
}

.submit-btn::after {
  border: none;
}

.privacy-note {
  font-size: 22rpx;
  color: var(--text-secondary);
  text-align: center;
  margin-top: var(--space-section);
}
