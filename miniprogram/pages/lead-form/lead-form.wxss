.page-container {
  min-height: 100vh;
  background:
    linear-gradient(180deg, #fcfdfb 0%, #f5f7f4 46%, var(--bg-page) 100%);
  display: flex;
  flex-direction: column;
}

.custom-header {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  background: rgba(255, 255, 255, 0.94);
  z-index: 100;
  box-shadow: 0 8rpx 24rpx rgba(85, 104, 90, 0.05);
  backdrop-filter: blur(16px);
}

.header-content {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  position: relative;
}

.back-btn {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 14rpx;
  border-radius: var(--radius-full);
  background: rgba(34, 197, 94, 0.12);
}

.back-arrow {
  font-size: 46rpx;
  color: #17a14c;
  font-weight: 400;
  line-height: 1;
}

.page-title {
  font-size: 31rpx;
  font-weight: 500;
  color: #20262d;
}

.main-content {
  flex: 1;
}

.form-wrapper {
  padding: 20rpx;
  padding-bottom: 96rpx;
  box-sizing: border-box;
}

.form-hero {
  margin-bottom: 18rpx;
  padding: 28rpx 26rpx;
  min-height: 182rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(207, 220, 207, 0.55);
  background:
    radial-gradient(circle at 82% 18%, rgba(168, 230, 191, 0.34) 0%, rgba(168, 230, 191, 0) 34%),
    linear-gradient(135deg, #eff9ef 0%, #edf8f2 48%, #f9fbf9 100%);
  box-shadow: var(--shadow-home-card);
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.hero-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.hero-title {
  font-size: 40rpx;
  line-height: 1.18;
  color: #20262d;
  font-weight: 600;
}

.hero-desc {
  font-size: 25rpx;
  line-height: 1.5;
  color: #6f7782;
}

.hero-visual {
  width: 150rpx;
  min-width: 150rpx;
  height: 126rpx;
  position: relative;
}

.visual-paper,
.visual-home {
  position: absolute;
  background: rgba(255, 255, 255, 0.96);
  border: 2rpx solid rgba(198, 228, 203, 0.86);
  box-shadow: 0 10rpx 24rpx rgba(90, 110, 92, 0.1);
}

.visual-paper {
  right: 46rpx;
  top: 12rpx;
  width: 78rpx;
  height: 102rpx;
  border-radius: 18rpx;
  transform: rotate(-8deg);
}

.visual-home {
  right: 8rpx;
  bottom: 12rpx;
  width: 86rpx;
  height: 58rpx;
  border-radius: 16rpx;
  transform: rotate(8deg);
}

.form-intro {
  margin-bottom: 16rpx;
  padding: 26rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(207, 220, 207, 0.55);
  background:
    radial-gradient(circle at 82% 18%, rgba(168, 230, 191, 0.34) 0%, rgba(168, 230, 191, 0) 34%),
    linear-gradient(135deg, #eff9ef 0%, #edf8f2 48%, #f9fbf9 100%);
  box-shadow: var(--shadow-home-card);
}

.form-intro .desc {
  font-size: 26rpx;
  color: #5e6975;
  line-height: 1.6;
}

.quick-select-section {
  margin-bottom: 16rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(207, 220, 207, 0.55);
  padding: 22rpx;
  border-radius: 22rpx;
  box-shadow: var(--shadow-home-card);
}

.quick-select-title {
  font-size: 24rpx;
  color: #7e8793;
  margin-bottom: 14rpx;
  display: block;
  font-weight: 500;
}

.quick-select-list {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
}

.quick-select-item {
  display: inline-block;
  background: rgba(34, 197, 94, 0.12);
  color: #17a14c;
  padding: 12rpx 22rpx;
  border-radius: var(--radius-full);
  font-size: 24rpx;
  margin-right: 12rpx;
}

.form-card {
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(207, 220, 207, 0.55);
  border-radius: 22rpx;
  padding: 24rpx;
  box-shadow: var(--shadow-home-card);
}

.form-group {
  margin-bottom: 22rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 26rpx;
  font-weight: 500;
  color: #20262d;
  margin-bottom: 10rpx;
  display: block;
}

.required {
  color: var(--status-converted-text);
  margin-left: 4rpx;
}

.input,
.picker-view {
  width: 100%;
  height: 92rpx;
  background: rgba(248, 250, 248, 0.98);
  border-radius: 18rpx;
  padding: 0 22rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
  box-shadow: inset 0 0 0 1rpx rgba(227, 232, 227, 0.95);
}

.input-phone-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.phone-input {
  flex: 1;
}

.picker-view {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-view.placeholder {
  color: #a0a6af;
}

.arrow {
  font-size: 32rpx;
  color: #17a14c;
}

.form-footer {
  margin-top: 34rpx;
  padding: 0 4rpx;
}

.submit-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  background: linear-gradient(135deg, #0fb04d 0%, #18a94b 100%);
  color: var(--text-inverse);
  font-size: 30rpx;
  font-weight: 500;
  border-radius: var(--radius-full);
  margin: 0;
  padding: 0;
  box-shadow: 0 10rpx 24rpx rgba(17, 164, 66, 0.22);
}

.submit-btn-hover {
  opacity: 0.9;
  transform: translateY(1rpx);
}

.submit-btn::after {
  border: none;
}

.privacy-note {
  font-size: 22rpx;
  color: #8a919c;
  text-align: center;
  margin-top: 22rpx;
}
