<view class="login-page">
  <view class="hero-wrap">
    <image class="hero-image" src="/images/login-hero.png" mode="widthFix"></image>
  </view>

  <view class="login-card">
    <view class="tabs">
      <view class="tab {{loginType === 'phone' ? 'active' : ''}}" bindtap="switchTab" data-type="phone">
        <text>快捷登录</text>
        <view class="tab-line"></view>
      </view>
      <view class="tab {{loginType === 'password' ? 'active' : ''}}" bindtap="switchTab" data-type="password">
        <text>账号登录</text>
        <view class="tab-line"></view>
      </view>
    </view>

    <view wx:if="{{loginType === 'phone'}}" class="login-body">
      <view class="wechat-icon">
        <view class="bubble bubble-large">
          <view class="eye eye-left"></view>
          <view class="eye eye-right"></view>
        </view>
        <view class="bubble bubble-small">
          <view class="eye eye-left"></view>
          <view class="eye eye-right"></view>
        </view>
      </view>

      <view class="login-title">微信授权登录</view>
      <view class="login-desc">授权后即可使用完整功能</view>

      <button class="primary-btn" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber" loading="{{loading}}" disabled="{{loading}}">
        手机号快捷登录
      </button>

      <view class="agreement">
        <text class="check">✓</text>
        <text>我已阅读并同意</text>
        <text class="link">《用户协议》</text>
        <text>和</text>
        <text class="link">《隐私政策》</text>
      </view>
    </view>

    <view wx:else class="login-body password-body">
      <view class="field">
        <text class="label">账号 / 手机号</text>
        <input class="input" placeholder="请输入员工账号或手机号" placeholder-class="placeholder" bindinput="onInputUsername" value="{{username}}" />
      </view>

      <view class="field">
        <text class="label">密码</text>
        <input class="input" password placeholder="请输入登录密码" placeholder-class="placeholder" bindinput="onInputPassword" value="{{password}}" />
      </view>

      <button class="primary-btn {{(!username || !password || loading) ? 'disabled' : ''}}" bindtap="onPasswordLogin" loading="{{loading}}" disabled="{{!username || !password || loading}}">
        立即登录
      </button>

      <view class="staff-tip">
        <text class="tip-badge">i</text>
        <text class="tip-text">账号登录主要面向设计师、地推员等企业内部员工。</text>
      </view>
    </view>
  </view>

  <view class="feature-row">
    <view class="feature-card">
      <view class="feature-icon target-icon">
        <view class="target-dot"></view>
      </view>
      <view class="feature-copy">
        <view class="feature-title">精准量房</view>
        <view class="feature-desc">毫米级精度</view>
      </view>
    </view>
    <view class="feature-card">
      <view class="feature-icon ai-icon">AI</view>
      <view class="feature-copy">
        <view class="feature-title">AI设计</view>
        <view class="feature-desc">智能设计方案</view>
      </view>
    </view>
    <view class="feature-card">
      <view class="feature-icon image-icon">
        <view class="image-sun"></view>
        <view class="image-mountain"></view>
      </view>
      <view class="feature-copy">
        <view class="feature-title">灵感图库</view>
        <view class="feature-desc">海量实景案例</view>
      </view>
    </view>
  </view>

  <view class="back-row" bindtap="onBack">
    <view class="back-line"></view>
    <view class="home-icon">
      <view class="home-roof"></view>
      <view class="home-body"></view>
    </view>
    <text>返回首页</text>
    <view class="back-line"></view>
  </view>
</view>
