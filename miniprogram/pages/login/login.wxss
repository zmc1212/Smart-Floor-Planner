.container {
  min-height: 100vh;
  background: var(--bg-page);
  padding: 72rpx var(--space-section) var(--space-section);
  box-sizing: border-box;
}

.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  margin-bottom: 48rpx;
}

.logo-circle {
  width: 144rpx;
  height: 144rpx;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, var(--brand-primary) 0%, var(--accent-secondary-green) 100%);
  color: var(--text-inverse);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-shadow: var(--shadow-float);
  margin-bottom: var(--space-xxl);
}

.logo-text {
  font-size: 50rpx;
  font-weight: var(--font-weight-bold);
}

.logo-sparkle {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  font-size: 22rpx;
}

.login-title {
  font-size: var(--font-size-title);
  font-weight: var(--font-weight-bold);
  color: var(--text-primary);
  margin-bottom: var(--space-md);
}

.login-subtitle,
.agreement-text,
.staff-tip,
.back-link {
  font-size: var(--font-size-caption);
  color: var(--text-secondary);
}

.login-tabs {
  position: relative;
  display: flex;
  background: var(--bg-surface);
  border-radius: var(--radius-full);
  padding: var(--space-xs);
  box-shadow: var(--shadow-card);
  margin-bottom: var(--space-section);
}

.tab {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
  color: var(--text-secondary);
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
  z-index: 2;
}

.tab.active {
  color: var(--text-brand);
}

.tab-indicator {
  position: absolute;
  top: var(--space-xs);
  left: var(--space-xs);
  width: calc(50% - var(--space-xs));
  height: 72rpx;
  border-radius: var(--radius-full);
  background: var(--brand-primary-20);
  transition: transform 0.2s ease;
}

.login-body,
.info-card,
.staff-tip {
  background: var(--bg-surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.login-body {
  padding: var(--space-section);
}

.info-card {
  display: flex;
  align-items: center;
  gap: var(--space-lg);
  padding: var(--space-xl);
  background: var(--bg-surface-soft);
  margin-bottom: var(--space-section);
}

.info-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-full);
  background: var(--bg-surface);
  color: var(--text-brand);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: var(--font-weight-bold);
}

.info-title,
.label {
  font-size: var(--font-size-body);
  color: var(--text-primary);
  font-weight: var(--font-weight-medium);
}

.info-desc {
  font-size: var(--font-size-caption);
  color: var(--text-secondary);
  margin-top: var(--space-xs);
}

.form-group {
  margin-bottom: var(--space-xxl);
}

.label {
  display: block;
  margin-bottom: var(--space-md);
}

.input {
  width: 100%;
  height: 92rpx;
  background: var(--neutral-100);
  border-radius: var(--radius-md);
  padding: 0 var(--space-xl);
  box-sizing: border-box;
  font-size: var(--font-size-body);
  color: var(--text-primary);
}

.primary-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: var(--brand-primary);
  color: var(--text-inverse);
  border-radius: var(--radius-full);
  font-size: 30rpx;
  font-weight: var(--font-weight-medium);
  margin: 0;
  box-shadow: var(--shadow-float);
}

.primary-btn.disabled {
  opacity: 0.48;
}

.primary-btn::after {
  border: none;
}

.agreement-text {
  text-align: center;
  margin-top: var(--space-xxl);
}

.link {
  color: var(--text-brand);
}

.staff-tip {
  margin-top: var(--space-section);
  padding: var(--space-lg);
  background: var(--bg-surface-soft);
  display: flex;
  gap: var(--space-md);
  line-height: 1.5;
}

.tip-icon {
  color: var(--text-brand);
  font-weight: var(--font-weight-bold);
}

.footer-actions {
  text-align: center;
  margin-top: var(--space-section);
}
