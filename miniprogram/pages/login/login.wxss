.container {
  min-height: 100vh;
  background:
    linear-gradient(180deg, #fcfdfb 0%, #f5f7f4 46%, var(--bg-page) 100%);
  padding: 72rpx 20rpx 32rpx;
  box-sizing: border-box;
}

.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  margin-bottom: 28rpx;
  padding: 44rpx 28rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(207, 220, 207, 0.55);
  background:
    radial-gradient(circle at 68% 18%, rgba(168, 230, 191, 0.34) 0%, rgba(168, 230, 191, 0) 36%),
    linear-gradient(135deg, #eff9ef 0%, #edf8f2 48%, #f9fbf9 100%);
  box-shadow: var(--shadow-home-card);
  overflow: hidden;
}

.logo-circle {
  width: 136rpx;
  height: 136rpx;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, #0fb04d 0%, #18a94b 100%);
  color: var(--text-inverse);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-shadow: 0 10rpx 24rpx rgba(17, 164, 66, 0.22);
  margin-bottom: 24rpx;
}

.logo-text {
  font-size: 50rpx;
  font-weight: 600;
}

.logo-sparkle {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  font-size: 22rpx;
}

.login-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #20262d;
  margin-bottom: 10rpx;
}

.login-subtitle,
.agreement-text,
.staff-tip,
.back-link {
  font-size: 24rpx;
  color: #7e8793;
}

.login-visual {
  position: relative;
  width: 240rpx;
  height: 110rpx;
  margin-top: 24rpx;
}

.visual-room {
  position: absolute;
  background: rgba(255, 255, 255, 0.96);
  border: 2rpx solid rgba(198, 228, 203, 0.86);
  box-shadow: 0 10rpx 24rpx rgba(90, 110, 92, 0.1);
}

.visual-room-a {
  left: 48rpx;
  top: 10rpx;
  width: 118rpx;
  height: 72rpx;
  border-radius: 18rpx;
  transform: rotate(-7deg);
}

.visual-room-b {
  right: 32rpx;
  top: 38rpx;
  width: 92rpx;
  height: 56rpx;
  border-radius: 16rpx;
  transform: rotate(8deg);
}

.visual-device {
  position: absolute;
  left: 28rpx;
  bottom: 10rpx;
  width: 44rpx;
  height: 72rpx;
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(90, 110, 92, 0.12);
}

.login-tabs {
  position: relative;
  display: flex;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(207, 220, 207, 0.55);
  border-radius: var(--radius-full);
  padding: 6rpx;
  box-shadow: var(--shadow-home-card);
  margin-bottom: 16rpx;
}

.tab {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
  color: #7e8793;
  font-size: 28rpx;
  font-weight: 500;
  z-index: 2;
}

.tab.active {
  color: #17a14c;
}

.tab-indicator {
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  width: calc(50% - 6rpx);
  height: 72rpx;
  border-radius: var(--radius-full);
  background: rgba(34, 197, 94, 0.12);
  transition: transform 0.2s ease;
}

.login-body,
.info-card,
.staff-tip {
  background: rgba(255, 255, 255, 0.94);
  border-radius: 22rpx;
  box-shadow: var(--shadow-home-card);
}

.login-body {
  padding: 24rpx;
  border: 1rpx solid rgba(207, 220, 207, 0.55);
}

.info-card {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx;
  background: rgba(234, 248, 236, 0.62);
  margin-bottom: 22rpx;
  box-shadow: none;
}

.info-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: var(--bg-surface);
  color: #17a14c;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  flex-shrink: 0;
}

.info-title,
.label {
  font-size: 28rpx;
  color: #20262d;
  font-weight: 500;
}

.info-desc {
  font-size: 24rpx;
  color: #7e8793;
  margin-top: 4rpx;
}

.form-group {
  margin-bottom: 22rpx;
}

.label {
  display: block;
  margin-bottom: 10rpx;
}

.input {
  width: 100%;
  height: 92rpx;
  background: rgba(248, 250, 248, 0.98);
  border-radius: 18rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: var(--text-primary);
  box-shadow: inset 0 0 0 1rpx rgba(227, 232, 227, 0.95);
}

.primary-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  background: linear-gradient(135deg, #0fb04d 0%, #18a94b 100%);
  color: var(--text-inverse);
  border-radius: var(--radius-full);
  font-size: 30rpx;
  font-weight: 500;
  margin: 0;
  box-shadow: 0 10rpx 24rpx rgba(17, 164, 66, 0.22);
}

.primary-btn.disabled {
  opacity: 0.48;
}

.primary-btn::after {
  border: none;
}

.agreement-text {
  text-align: center;
  margin-top: 22rpx;
}

.link {
  color: #17a14c;
}

.staff-tip {
  margin-top: 16rpx;
  padding: 18rpx;
  background: rgba(234, 248, 236, 0.62);
  display: flex;
  gap: 10rpx;
  line-height: 1.5;
  box-shadow: none;
}

.tip-icon {
  color: #17a14c;
  font-weight: 600;
}

.footer-actions {
  text-align: center;
  margin-top: 24rpx;
}

.login-features {
  margin-top: 18rpx;
  display: flex;
  justify-content: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.feature-chip {
  padding: 10rpx 18rpx;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.84);
  color: #7e8793;
  font-size: 23rpx;
  box-shadow: 0 6rpx 20rpx rgba(26, 35, 24, 0.05);
}
