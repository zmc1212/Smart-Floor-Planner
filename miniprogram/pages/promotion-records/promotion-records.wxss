page {
  height: 100%;
  overflow: hidden;
  background: #f6faf6;
}

.page {
  position: relative;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background:
    radial-gradient(circle at 70% 8%, rgba(205, 237, 211, 0.36), transparent 34%),
    linear-gradient(180deg, #fbfdf9 0%, #f4f8f3 100%);
  box-sizing: border-box;
}

.top-safe {
  flex-shrink: 0;
}

.hero {
  position: relative;
  flex-shrink: 0;
  height: 286rpx;
  overflow: hidden;
}

.hero::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 70rpx;
  background: linear-gradient(180deg, rgba(246, 250, 246, 0), #f6faf6 90%);
  pointer-events: none;
}

.hero-scene {
  position: absolute;
  z-index: 0;
  top: -30rpx;
  right: -58rpx;
  width: 488rpx;
  height: 326rpx;
}

.hero-copy {
  position: relative;
  z-index: 1;
  height: 100%;
  padding: 22rpx 0 18rpx 46rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  box-sizing: border-box;
}

.title-row {
  display: flex;
  align-items: center;
}

.page-title {
  color: #10281f;
  font-size: 50rpx;
  line-height: 1.12;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.title-swoop {
  position: relative;
  width: 80rpx;
  height: 38rpx;
  margin: 8rpx 0 0 -4rpx;
  border: 3rpx solid #81c900;
  border-left-color: transparent;
  border-radius: 50%;
  box-sizing: border-box;
  transform: rotate(-10deg);
}

.title-dot {
  position: absolute;
  left: -3rpx;
  top: 10rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #81c900;
}

.page-subtitle {
  margin-top: 14rpx;
  color: #687487;
  font-size: 25rpx;
  line-height: 1.3;
}

.create-btn {
  height: 72rpx;
  margin: auto 0 0;
  padding: 0 28rpx 0 22rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #2bc561 0%, #12a949 100%);
  color: #fff;
  font-size: 28rpx;
  line-height: 72rpx;
  font-weight: 600;
  box-shadow: 0 14rpx 30rpx rgba(25, 173, 76, 0.22);
}

.create-btn::after,
.card-action::after,
.empty-action::after {
  border: none;
}

.create-plus {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(255, 255, 255, 0.96);
  border-radius: 50%;
  box-sizing: border-box;
}

.create-plus-icon {
  width: 26rpx;
  height: 26rpx;
}

.content-sheet {
  position: relative;
  z-index: 2;
  flex: 1;
  min-height: 0;
  margin-top: -2rpx;
  padding: 28rpx 24rpx 0;
  display: flex;
  flex-direction: column;
  border-radius: 42rpx 42rpx 0 0;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 -8rpx 30rpx rgba(71, 92, 76, 0.08);
  box-sizing: border-box;
}

.search-surface {
  flex-shrink: 0;
  height: 76rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  border: 1rpx solid rgba(203, 211, 205, 0.82);
  border-radius: 38rpx;
  background: #fff;
  box-shadow: inset 0 1rpx 2rpx rgba(31, 41, 55, 0.02);
  box-sizing: border-box;
}

.search-icon {
  width: 34rpx;
  height: 34rpx;
  opacity: 0.62;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  color: #293447;
  font-size: 26rpx;
  line-height: 76rpx;
}

.search-placeholder {
  color: #7b8494;
}

.view-tabs {
  flex-shrink: 0;
  width: 100%;
  margin-top: 20rpx;
  white-space: nowrap;
}

.view-tabs-inner {
  min-width: 100%;
  height: 64rpx;
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.view-tab {
  position: relative;
  min-width: 112rpx;
  height: 52rpx;
  padding: 0 20rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 13rpx;
  background: #f2f3f3;
  color: #596275;
  font-size: 25rpx;
  line-height: 1;
  box-sizing: border-box;
}

.view-tab.active {
  background: linear-gradient(135deg, #2bc561 0%, #12a949 100%);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 8rpx 18rpx rgba(27, 175, 76, 0.18);
}

.view-tab:nth-child(4) {
  color: #f27422;
  background: #fff1e7;
}

.view-tab:nth-child(4).active {
  color: #fff;
  background: linear-gradient(135deg, #ff9d4f 0%, #f17322 100%);
}

.tab-indicator {
  position: absolute;
  left: 50%;
  bottom: -16rpx;
  width: 28rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: currentColor;
  transform: translateX(-50%);
}

.record-scroll {
  flex: 1;
  min-height: 0;
  width: calc(100% + 8rpx);
  margin-left: -4rpx;
}

.record-list,
.skeleton-list {
  padding: 8rpx 4rpx 0;
  box-sizing: border-box;
}

.record-card {
  position: relative;
  min-height: 238rpx;
  margin-bottom: 18rpx;
  padding: 54rpx 28rpx 20rpx;
  overflow: hidden;
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(61, 77, 66, 0.09), 0 0 0 1rpx rgba(222, 228, 223, 0.58);
  box-sizing: border-box;
}

.record-card:active {
  transform: translateY(1rpx);
  opacity: 0.94;
}

.status-badge {
  position: absolute;
  top: 0;
  left: 14rpx;
  min-width: 92rpx;
  height: 42rpx;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 0 12rpx 12rpx;
  color: #1ba751;
  background: #e8f7ec;
  font-size: 21rpx;
  line-height: 1;
  font-weight: 500;
  box-sizing: border-box;
}

.tone-designing .status-badge {
  color: #2f7bf4;
  background: #e9f0ff;
}

.tone-overdue .status-badge {
  color: #f06d19;
  background: #fff0e4;
}

.tone-pool .status-badge,
.tone-paid .status-badge {
  color: #727b8b;
  background: #f0f1f3;
}

.record-heading {
  max-width: calc(100% - 116rpx);
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  color: #172238;
  white-space: nowrap;
}

.record-name {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 30rpx;
  line-height: 1.25;
  font-weight: 600;
}

.heading-divider,
.contact-name {
  flex-shrink: 0;
  font-size: 26rpx;
  line-height: 1.25;
  font-weight: 400;
}

.contact-name {
  max-width: 124rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}

.record-meta {
  max-width: calc(100% - 112rpx);
  margin-top: 15rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  color: #697386;
  font-size: 21rpx;
  line-height: 1.2;
}

.meta-item {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 7rpx;
  white-space: nowrap;
}

.location-item {
  flex: 1;
}

.meta-label {
  color: #87909f;
  font-size: 20rpx;
}

.location-text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}

.record-icon-tile {
  position: absolute;
  top: 45rpx;
  right: 24rpx;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 17rpx;
  background: #eff8f0;
}

.tone-designing .record-icon-tile {
  background: #eef3ff;
}

.tone-overdue .record-icon-tile {
  background: #fff3e8;
}

.tone-pool .record-icon-tile,
.tone-paid .record-icon-tile {
  background: #f2f3f5;
}

.record-icon {
  width: 54rpx;
  height: 54rpx;
}

.follow-row {
  max-width: calc(100% - 180rpx);
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #697386;
  font-size: 21rpx;
  line-height: 1.25;
  white-space: nowrap;
}

.follow-label {
  flex-shrink: 0;
  padding: 7rpx 12rpx;
  border-radius: 8rpx;
  color: #1a9b4a;
  background: #eaf7ee;
  font-size: 20rpx;
  line-height: 1;
}

.follow-text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}

.time-row {
  max-width: calc(100% - 180rpx);
  margin-top: 14rpx;
  overflow: hidden;
  color: #697386;
  font-size: 21rpx;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-action {
  position: absolute;
  right: 24rpx;
  bottom: 20rpx;
  min-width: 160rpx;
  height: 54rpx;
  margin: 0;
  padding: 0 18rpx 0 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  border: 2rpx solid #13a64a;
  border-radius: 11rpx;
  background: #fff;
  color: #129846;
  font-size: 23rpx;
  line-height: 52rpx;
  font-weight: 500;
  box-sizing: border-box;
}

.card-action.primary {
  border-color: transparent;
  background: linear-gradient(135deg, #29c55f 0%, #11a848 100%);
  color: #fff;
  box-shadow: 0 8rpx 18rpx rgba(19, 168, 73, 0.18);
}

.action-chevron {
  width: 13rpx;
  height: 13rpx;
  border-right: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  transform: rotate(-45deg);
  box-sizing: border-box;
}

.skeleton-card {
  min-height: 218rpx;
}

.skeleton {
  border-radius: 8rpx;
  background: linear-gradient(90deg, #f1f4f1 20%, #f8faf8 45%, #f1f4f1 70%);
  background-size: 240% 100%;
  animation: skeleton-shift 1.2s linear infinite;
}

.skeleton-badge {
  position: absolute;
  top: 0;
  left: 14rpx;
  width: 92rpx;
  height: 42rpx;
  border-radius: 0 0 12rpx 12rpx;
}

.skeleton-title {
  width: 52%;
  height: 34rpx;
}

.skeleton-meta {
  width: 70%;
  height: 24rpx;
  margin-top: 20rpx;
}

.skeleton-follow {
  width: 82%;
  height: 52rpx;
  margin-top: 24rpx;
}

@keyframes skeleton-shift {
  from { background-position: 100% 0; }
  to { background-position: -100% 0; }
}

.empty-state {
  margin: 8rpx 4rpx 0;
  padding: 70rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(61, 77, 66, 0.07), 0 0 0 1rpx rgba(222, 228, 223, 0.58);
  box-sizing: border-box;
}

.empty-icon-tile {
  width: 94rpx;
  height: 94rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: #eef8f0;
}

.empty-icon {
  width: 58rpx;
  height: 58rpx;
}

.empty-title {
  margin-top: 22rpx;
  color: #1d2939;
  font-size: 28rpx;
  line-height: 1.3;
  font-weight: 600;
}

.empty-copy {
  margin-top: 10rpx;
  color: #768093;
  font-size: 22rpx;
  line-height: 1.45;
}

.empty-action {
  min-width: 200rpx;
  height: 68rpx;
  margin: 28rpx 0 0;
  padding: 0 28rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #2bc561 0%, #12a949 100%);
  color: #fff;
  font-size: 25rpx;
  line-height: 68rpx;
  font-weight: 600;
}

.scroll-spacer {
  height: calc(132rpx + env(safe-area-inset-bottom));
}

.page-dock {
  position: fixed;
  z-index: 10;
  left: 18rpx;
  right: 18rpx;
  bottom: calc(8rpx + env(safe-area-inset-bottom));
  height: 116rpx;
  padding: 0 12rpx;
  display: flex;
  align-items: stretch;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -2rpx 28rpx rgba(52, 68, 57, 0.09), 0 8rpx 30rpx rgba(52, 68, 57, 0.08);
  box-sizing: border-box;
}

.dock-item {
  position: relative;
  flex: 1;
  min-width: 0;
  height: 116rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #6e7788;
}

.dock-item:active {
  opacity: 0.72;
}

.dock-icon-wrap {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dock-icon {
  width: 44rpx;
  height: 44rpx;
}

.center-icon-wrap {
  position: absolute;
  top: -27rpx;
  left: 50%;
  width: 106rpx;
  height: 106rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 8rpx 22rpx rgba(35, 67, 46, 0.14);
  transform: translateX(-50%);
}

.center-icon {
  width: 88rpx;
  height: 88rpx;
}

.dock-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1;
  white-space: nowrap;
}

.dock-item.center .dock-label {
  margin-top: 60rpx;
}

@media (max-width: 360px) {
  .hero-copy {
    padding-left: 34rpx;
  }

  .hero-scene {
    right: -82rpx;
  }

  .view-tabs-inner {
    gap: 10rpx;
  }

  .view-tab {
    min-width: 106rpx;
    padding: 0 16rpx;
  }
}
