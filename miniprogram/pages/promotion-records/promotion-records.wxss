.page {
  min-height: 100vh;
  background:
    linear-gradient(180deg, #fcfdfb 0%, #f5f7f4 46%, var(--bg-page) 100%);
  padding: 20rpx;
  box-sizing: border-box;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
  padding: 28rpx 26rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(207, 220, 207, 0.55);
  background:
    radial-gradient(circle at 82% 18%, rgba(168, 230, 191, 0.34) 0%, rgba(168, 230, 191, 0) 34%),
    linear-gradient(135deg, #eff9ef 0%, #edf8f2 48%, #f9fbf9 100%);
  box-shadow: var(--shadow-home-card);
  box-sizing: border-box;
}

.header-copy {
  min-width: 0;
}

.eyebrow {
  font-size: 22rpx;
  color: #17a14c;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.title {
  font-size: 38rpx;
  line-height: 1.2;
  font-weight: 600;
  color: #20262d;
}

.subtitle,
.meta,
.empty {
  font-size: 24rpx;
  color: #7e8793;
}

.subtitle {
  margin-top: 8rpx;
}

.record-tools {
  margin-bottom: 16rpx;
}

.search-surface {
  height: 76rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  border-radius: 38rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(207, 220, 207, 0.55);
  box-shadow: 0 6rpx 20rpx rgba(26, 35, 24, 0.05);
  color: #8a919c;
  font-size: 25rpx;
  box-sizing: border-box;
}

.filter-row {
  margin-top: 12rpx;
  display: flex;
  gap: 10rpx;
  overflow: hidden;
}

.filter-chip {
  padding: 12rpx 22rpx;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.94);
  color: #7e8793;
  font-size: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(26, 35, 24, 0.05);
  white-space: nowrap;
}

.filter-chip.active {
  background: linear-gradient(135deg, #0fb04d 0%, #18a94b 100%);
  color: var(--text-inverse);
  box-shadow: 0 10rpx 20rpx rgba(17, 164, 66, 0.18);
}

.create-btn,
.primary-btn {
  background: linear-gradient(135deg, #0fb04d 0%, #18a94b 100%);
  color: var(--text-inverse);
  border-radius: var(--radius-full);
  font-size: 24rpx;
  font-weight: 500;
  padding: 0 28rpx;
  height: 70rpx;
  line-height: 70rpx;
  margin: 0;
  box-shadow: 0 10rpx 20rpx rgba(17, 164, 66, 0.18);
  flex-shrink: 0;
}

.create-btn::after,
.primary-btn::after,
.secondary-btn::after {
  border: none;
}

.card {
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(207, 220, 207, 0.55);
  border-radius: 22rpx;
  padding: 22rpx;
  box-shadow: var(--shadow-home-card);
  margin-bottom: 14rpx;
  box-sizing: border-box;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 14rpx;
}

.name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: #20262d;
  line-height: 1.3;
}

.badge {
  min-height: 34rpx;
  padding: 0 16rpx;
  border-radius: var(--radius-full);
  background: var(--status-measuring-bg);
  color: var(--status-measuring-text);
  font-size: 20rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.badge-warn {
  background: var(--status-converted-bg);
  color: var(--status-converted-text);
}

.meta {
  line-height: 1.55;
  margin-top: 4rpx;
}

.record-list {
  display: flex;
  flex-direction: column;
}

.card-footer {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(228, 233, 230, 0.92);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.footer-pill {
  padding: 8rpx 16rpx;
  border-radius: var(--radius-full);
  background: rgba(34, 197, 94, 0.1);
  color: #17a14c;
  font-size: 22rpx;
  font-weight: 500;
}

.card-arrow {
  color: #c1c7ce;
  font-size: 42rpx;
  line-height: 1;
}

.empty {
  padding: 90rpx 32rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(207, 220, 207, 0.55);
  border-radius: 24rpx;
  box-shadow: var(--shadow-home-card);
}
