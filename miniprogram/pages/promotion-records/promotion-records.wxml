<view class="page">
  <view class="top-safe" style="height: {{statusBarHeight}}px;"></view>

  <view class="hero">
    <image class="hero-scene" src="/images/promotion-records/hero-scene.jpg" mode="aspectFill" />
    <view class="hero-copy">
      <view class="title-row">
        <text class="page-title">企业报备</text>
        <view class="title-swoop"><view class="title-dot"></view></view>
      </view>
      <text class="page-subtitle">持续跟进客户与合作企业</text>
      <button wx:if="{{view === 'my'}}" class="create-btn" bindtap="onCreateRecord">
        <view class="create-plus">
          <image class="create-plus-icon" src="/images/leads-v4/plus-white.png" mode="aspectFit" />
        </view>
        <text>新建报备</text>
      </button>
    </view>
  </view>

  <view class="content-sheet">
    <view class="search-surface">
      <image class="search-icon" src="/images/mine-icons/search.png" mode="aspectFit" />
      <input
        class="search-input"
        value="{{searchText}}"
        placeholder="搜索企业 / 联系人"
        placeholder-class="search-placeholder"
        confirm-type="search"
        bindinput="onSearchInput"
      />
    </view>

    <scroll-view class="view-tabs" scroll-x="true" enhanced="true" show-scrollbar="false">
      <view class="view-tabs-inner">
        <view
          wx:for="{{viewTabs}}"
          wx:key="key"
          class="view-tab {{view === item.key ? 'active' : ''}}"
          data-view="{{item.key}}"
          bindtap="onViewTap"
        >
          <text>{{item.label}}</text>
          <view wx:if="{{view === item.key}}" class="tab-indicator"></view>
        </view>
      </view>
    </scroll-view>

    <scroll-view class="record-scroll" scroll-y="true" enhanced="true" show-scrollbar="false">
      <view wx:if="{{loading}}" class="skeleton-list">
        <view class="record-card skeleton-card" wx:for="{{skeletonItems}}" wx:key="*this">
          <view class="skeleton skeleton-badge"></view>
          <view class="skeleton skeleton-title"></view>
          <view class="skeleton skeleton-meta"></view>
          <view class="skeleton skeleton-follow"></view>
        </view>
      </view>

      <view wx:elif="{{displayedRecords.length > 0}}" class="record-list">
        <view
          class="record-card tone-{{item.statusKey}}"
          wx:for="{{displayedRecords}}"
          wx:key="key"
          data-id="{{item.recordId}}"
          bindtap="onOpenDetail"
        >
          <view class="status-badge">{{item.statusText}}</view>

          <view class="record-heading">
            <text class="record-name">{{item.enterpriseName}}</text>
            <text class="heading-divider">·</text>
            <text class="contact-name">{{item.contactPerson}}</text>
          </view>

          <view class="record-meta">
            <view class="meta-item">
              <text class="meta-label">电话</text>
              <text>{{item.phoneText}}</text>
            </view>
            <view class="meta-item location-item">
              <text class="meta-label">地址</text>
              <text class="location-text">{{item.locationText}}</text>
            </view>
          </view>

          <view class="record-icon-tile">
            <image class="record-icon" src="{{item.iconPath}}" mode="aspectFit" />
          </view>

          <view class="follow-row">
            <text class="follow-label">跟进记录</text>
            <text class="follow-text">{{item.followUpText}}</text>
          </view>

          <view class="time-row">{{item.timeLabel}}：{{item.timeText}}</view>

          <button
            wx:if="{{item.canClaim}}"
            class="card-action primary"
            catchtap="onClaimRecord"
            data-id="{{item.recordId}}"
          >
            <text>立即认领</text><view class="action-chevron"></view>
          </button>
          <view wx:else class="card-action" data-id="{{item.recordId}}">
            <text>继续跟进</text><view class="action-chevron"></view>
          </view>
        </view>
      </view>

      <view wx:else class="empty-state">
        <view class="empty-icon-tile">
          <image class="empty-icon" src="/images/mine-icons/clipboard-pen.png" mode="aspectFit" />
        </view>
        <view class="empty-title">{{searchText ? '没有匹配的报备' : '暂无报备记录'}}</view>
        <view class="empty-copy">{{searchText ? '试试搜索其他企业或联系人' : '新的企业报备会显示在这里'}}</view>
        <button wx:if="{{!searchText && view === 'my'}}" class="empty-action" bindtap="onCreateRecord">新建报备</button>
      </view>
      <view class="scroll-spacer"></view>
    </scroll-view>
  </view>

  <view class="page-dock">
    <view
      wx:for="{{dockItems}}"
      wx:key="key"
      class="dock-item {{item.center ? 'center' : ''}}"
      data-key="{{item.key}}"
      bindtap="onDockTap"
    >
      <view class="dock-icon-wrap {{item.center ? 'center-icon-wrap' : ''}}">
        <image class="dock-icon {{item.center ? 'center-icon' : ''}}" src="{{item.iconPath}}" mode="aspectFit" />
      </view>
      <text class="dock-label">{{item.text}}</text>
    </view>
  </view>
</view>
