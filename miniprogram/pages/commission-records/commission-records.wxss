@import "../promotion-records/promotion-records.wxss";

.header {
  align-items: center;
}

.coin-visual {
  width: 96rpx;
  height: 96rpx;
  border-radius: 32rpx;
  background: rgba(255, 200, 87, 0.18);
  color: #df9b00;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.summary-card,
.rule-card {
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(207, 220, 207, 0.55);
  border-radius: 22rpx;
  box-shadow: var(--shadow-home-card);
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}

.summary-card {
  background:
    radial-gradient(circle at 82% 18%, rgba(255, 200, 87, 0.18) 0%, rgba(255, 200, 87, 0) 34%),
    linear-gradient(135deg, #ffffff 0%, #f4fbf5 100%);
}

.summary-main {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 22rpx;
}

.summary-label,
.mini-label {
  font-size: 22rpx;
  color: #8a919c;
}

.summary-amount {
  font-size: 58rpx;
  line-height: 1;
  color: #17a14c;
  font-weight: 700;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
}

.summary-mini {
  padding: 16rpx 12rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.74);
  box-shadow: inset 0 0 0 1rpx rgba(227, 232, 227, 0.9);
}

.mini-value {
  display: block;
  font-size: 31rpx;
  font-weight: 600;
  color: #20262d;
  margin-bottom: 8rpx;
}

.amount {
  font-size: 42rpx;
  font-weight: 600;
  color: #17a14c;
  margin-bottom: 10rpx;
}

.section-title {
  font-size: 29rpx;
  color: #21262d;
  font-weight: 500;
  margin-bottom: 12rpx;
}
