<view class="page">
  <view class="header">
    <view>
      <view class="eyebrow">收益中心</view>
      <view class="title">我的提成</view>
      <view class="subtitle">共 {{records.length}} 条提成记录</view>
    </view>
    <view class="coin-visual">¥</view>
  </view>

  <view class="summary-card">
    <view class="summary-main">
      <text class="summary-label">本月预估提成</text>
      <text class="summary-amount">¥ 12,860</text>
    </view>
    <view class="summary-grid">
      <view class="summary-mini">
        <text class="mini-value">5</text>
        <text class="mini-label">待结算</text>
      </view>
      <view class="summary-mini">
        <text class="mini-value">18</text>
        <text class="mini-label">已到账</text>
      </view>
      <view class="summary-mini">
        <text class="mini-value">4</text>
        <text class="mini-label">本月成交</text>
      </view>
    </view>
  </view>

  <view class="filter-row">
    <text class="filter-chip active">全部</text>
    <text class="filter-chip">待结算</text>
    <text class="filter-chip">已结算</text>
    <text class="filter-chip">已到账</text>
  </view>

  <view wx:if="{{loading}}" class="empty">加载中...</view>

  <view wx:elif="{{records.length > 0}}">
    <view class="card" wx:for="{{records}}" wx:key="_id">
      <view class="row">
        <view class="name">{{item.commissionType}}</view>
        <view class="badge">{{item.status}}</view>
      </view>
      <view class="amount">¥{{item.commissionAmount}}</view>
      <view class="meta">{{item.orderId.packageName || '企业订单'}}</view>
      <view class="meta">{{item.generatedAt}}</view>
    </view>
  </view>

  <view wx:else class="empty">暂无提成记录</view>

  <view class="rule-card">
    <view class="section-title">结算说明</view>
    <view class="meta">提成会在企业订单完成后进入结算流程，到账状态以企业财务确认结果为准。</view>
  </view>
</view>
