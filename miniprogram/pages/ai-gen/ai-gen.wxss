.atelier-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg-page);
  color: var(--text-primary);
  font-family: 'Source Han Sans', 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.atelier-header {
  padding: 20rpx var(--space-section);
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(16px);
  z-index: 100;
  box-shadow: var(--shadow-card);
}

.nav-back,
.nav-spacer {
  width: 80rpx;
  height: 80rpx;
}

.nav-back {
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.segmented-control {
  flex: 1;
  max-width: 360rpx;
  height: 72rpx;
  background: var(--brand-primary-20);
  border-radius: var(--radius-full);
  display: flex;
  padding: 4rpx;
}

.segment-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: var(--font-weight-medium);
  color: var(--text-secondary);
}

.segment-item.active {
  color: var(--text-brand);
  background: var(--bg-surface);
  border-radius: var(--radius-full);
  box-shadow: var(--shadow-card);
}

.atelier-content {
  flex: 1;
  height: 0;
}

.hero-preview-section {
  padding: var(--space-section);
}

.preview-frame {
  width: 100%;
  min-height: 480rpx;
  background: var(--bg-surface-soft);
  border-radius: var(--radius-xl);
  overflow: hidden;
  position: relative;
  box-shadow: var(--shadow-card);
}

.preview-frame.is-generating {
  opacity: 0.96;
}

.main-rendering {
  width: 100%;
  height: 480rpx;
}

.glass-tag {
  position: absolute;
  padding: 10rpx 24rpx;
  background: rgba(255, 255, 255, 0.84);
  backdrop-filter: blur(10px);
  border-radius: var(--radius-full);
  font-size: 20rpx;
  font-weight: var(--font-weight-medium);
  color: var(--text-primary);
  box-shadow: var(--shadow-card);
}

.top-right { top: 24rpx; right: 24rpx; }
.bottom-left { bottom: 24rpx; left: 24rpx; }

.dim-text {
  font-family: var(--font-mono);
  letter-spacing: 0.5px;
}

.empty-state {
  height: 480rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  text-align: center;
  position: relative;
}

.empty-glow {
  position: absolute;
  width: 320rpx;
  height: 320rpx;
  border-radius: var(--radius-full);
  background: radial-gradient(circle, rgba(34, 197, 94, 0.18) 0%, rgba(34, 197, 94, 0) 70%);
}

.empty-icon {
  width: 104rpx;
  height: 104rpx;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-surface);
  color: var(--text-brand);
  font-size: 42rpx;
  font-weight: var(--font-weight-bold);
  margin-bottom: var(--space-xxl);
  z-index: 2;
}

.empty-title {
  font-size: 32rpx;
  font-weight: var(--font-weight-bold);
  color: var(--text-primary);
  margin-bottom: var(--space-md);
  z-index: 2;
}

.empty-desc {
  font-size: var(--font-size-caption);
  color: var(--text-secondary);
  z-index: 2;
}

.scan-line {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 10rpx;
  background: linear-gradient(to bottom, rgba(34, 197, 94, 0), var(--brand-primary), rgba(34, 197, 94, 0));
  animation: scan 1.5s ease-in-out infinite;
  z-index: 10;
}

@keyframes scan {
  0% { top: 0%; opacity: 0; }
  20% { opacity: 1; }
  80% { opacity: 1; }
  100% { top: 100%; opacity: 0; }
}

.result-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-md);
  padding: var(--space-lg);
  background: var(--bg-surface);
}

.action-btn {
  min-height: 72rpx;
  border-radius: var(--radius-md);
  background: var(--bg-surface-soft);
  color: var(--text-brand);
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-medium);
  margin: 0;
  padding: 0 var(--space-lg);
}

.action-btn.primary {
  background: var(--brand-primary);
  color: var(--text-inverse);
}

.action-btn.secondary {
  background: var(--bg-surface);
  color: var(--text-brand);
  box-shadow: inset 0 0 0 1rpx var(--border-brand);
}

.action-btn::after {
  border: none;
}

.room-memo {
  display: flex;
  align-items: center;
  padding: 0 48rpx 40rpx;
}

.memo-line {
  width: 6rpx;
  height: 28rpx;
  background: var(--brand-primary);
  margin-right: var(--space-lg);
  border-radius: var(--radius-full);
}

.memo-name {
  font-size: 36rpx;
  font-weight: var(--font-weight-bold);
  margin-right: var(--space-lg);
}

.memo-status {
  font-size: 22rpx;
  color: var(--text-secondary);
  font-weight: var(--font-weight-medium);
}

.atelier-section {
  padding: 0 40rpx 56rpx;
}

.section-head {
  display: flex;
  flex-direction: column;
  margin-bottom: var(--space-xxl);
}

.head-title {
  font-size: 30rpx;
  font-weight: var(--font-weight-bold);
  color: var(--text-primary);
}

.head-subtitle {
  font-size: 20rpx;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 2rpx;
  margin-top: var(--space-xs);
}

.style-palette {
  display: flex;
  white-space: nowrap;
  width: 100vw;
  margin-left: -40rpx;
  padding: 24rpx 40rpx;
  box-sizing: border-box;
}

.palette-item {
  flex-shrink: 0;
  margin-right: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 128rpx;
  padding: 10rpx 0;
}

.palette-preview {
  width: 112rpx;
  height: 112rpx;
  border-radius: var(--radius-xl);
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-card);
}

.palette-item.active .palette-preview {
  box-shadow: var(--shadow-float);
}

.style-initial {
  font-size: 38rpx;
  font-weight: var(--font-weight-bold);
  opacity: 0.68;
}

.active-check {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 36rpx;
  height: 36rpx;
  background: var(--brand-primary);
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid var(--bg-surface);
}

.palette-label {
  margin-top: var(--space-lg);
  font-size: 22rpx;
  color: var(--text-secondary);
  font-weight: var(--font-weight-medium);
}

.palette-item.active .palette-label {
  color: var(--text-brand);
}

.advice-atelier-card,
.lead-atelier-banner {
  border-radius: var(--radius-xl);
  padding: 40rpx;
  box-shadow: var(--shadow-card);
}

.advice-atelier-card {
  background: var(--bg-surface);
}

.advice-atelier-card.has-content {
  background: linear-gradient(135deg, var(--bg-surface) 0%, var(--brand-primary-20) 100%);
}

.advice-quotes {
  font-size: 80rpx;
  color: var(--brand-primary-40);
  margin-bottom: -40rpx;
  margin-top: -30rpx;
  font-family: Georgia, serif;
}

.advice-body {
  font-size: 26rpx;
  line-height: 1.8;
  color: var(--text-primary);
  display: block;
}

.advice-footer {
  margin-top: var(--space-section);
  display: flex;
  justify-content: flex-end;
}

.consultant-tag {
  font-size: 20rpx;
  color: var(--text-brand);
  background: var(--brand-primary-20);
  padding: 8rpx 16rpx;
  border-radius: var(--radius-sm);
  font-weight: var(--font-weight-medium);
}

.advice-empty-body {
  padding: 24rpx 0;
  color: var(--text-secondary);
  font-size: var(--font-size-caption);
  text-align: center;
}

.lead-atelier-banner {
  background: linear-gradient(135deg, var(--brand-primary) 0%, var(--accent-secondary-green) 100%);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.lead-main {
  display: flex;
  flex-direction: column;
}

.lead-h1 {
  color: var(--text-inverse);
  font-size: 30rpx;
  font-weight: var(--font-weight-bold);
}

.lead-p {
  color: rgba(255, 255, 255, 0.84);
  font-size: 22rpx;
  margin-top: var(--space-sm);
}

.lead-arrow {
  color: var(--text-inverse);
  font-size: 48rpx;
  opacity: 0.9;
}

.footer-gap {
  height: 240rpx;
}

.fixed-bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 40rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(16px);
  z-index: 1000;
  box-shadow: var(--shadow-card);
}

.btn-group {
  display: flex;
  gap: var(--space-xxl);
}

.btn-primary,
.btn-secondary {
  height: 100rpx;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-bold);
}

.btn-primary {
  flex: 3;
  background: var(--brand-primary);
  color: var(--text-inverse);
  box-shadow: var(--shadow-float);
}

.btn-secondary {
  flex: 2;
  background: var(--bg-surface);
  color: var(--text-brand);
  box-shadow: inset 0 0 0 1rpx var(--border-brand);
}

.btn-primary:active,
.btn-secondary:active {
  transform: translateY(2rpx);
  opacity: 0.9;
}

.is-loading {
  opacity: 0.6;
  pointer-events: none;
}
