.tabbar-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  height: calc(126rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 -12rpx 34rpx rgba(15, 23, 42, 0.08);
  backdrop-filter: blur(18px);
  box-sizing: border-box;
}

.tabbar {
  height: 126rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.tab-item {
  position: relative;
  flex: 1;
  height: 126rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #667085;
  font-size: 23rpx;
  box-sizing: border-box;
}

.tab-item.center {
  justify-content: flex-start;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: currentColor;
}

.center-icon {
  width: 106rpx;
  height: 106rpx;
  margin-top: -36rpx;
  border-radius: 50%;
  color: #ffffff;
  background: linear-gradient(150deg, #13c657 0%, #06a83f 100%);
  box-shadow: 0 18rpx 36rpx rgba(6, 168, 63, 0.34);
}

.tab-text {
  margin-top: 8rpx;
  line-height: 1;
  color: currentColor;
}

.tab-item.active {
  color: #08a943;
  font-weight: 650;
}

.tab-item.center .tab-text {
  margin-top: 0;
  color: #ffffff;
  transform: translateY(-45rpx);
  font-weight: 650;
}

.tab-image {
  display: block;
  width: 42rpx;
  height: 42rpx;
}

.center-image {
  width: 50rpx;
  height: 50rpx;
}
