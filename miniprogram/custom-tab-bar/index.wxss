.tabbar-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  height: var(--sfp-custom-tabbar-safe-height, calc(104rpx + env(safe-area-inset-bottom)));
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -6rpx 24rpx rgba(36, 58, 43, 0.08);
  overflow: visible;
  box-sizing: border-box;
}

.tabbar {
  position: relative;
  height: var(--sfp-custom-tabbar-height, 104rpx);
  display: flex;
  align-items: stretch;
  overflow: visible;
}

.tab-item {
  position: relative;
  flex: 1;
  min-width: 0;
  height: var(--sfp-custom-tabbar-height, 104rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #737b80;
  box-sizing: border-box;
}

.tab-item.center {
  overflow: visible;
}

.tab-icon {
  width: 56rpx;
  height: 56rpx;
  margin: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  display: flex;
  align-items: center;
  justify-content: center;
  color: currentColor;
}

.tab-image {
  display: block;
  width: 56rpx;
  height: 56rpx;
}

.center-icon {
  position: absolute;
  top: -22rpx;
  left: 50%;
  width: 112rpx;
  height: 112rpx;
  margin: 0;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(8, 169, 67, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  transform: translateX(-50%);
}

.center-image {
  display: block;
  width: 96rpx;
  height: 96rpx;
}

.tab-text,
.tab-item.center .tab-text {
  margin-top: 2rpx;
  color: currentColor;
  font-size: 24rpx;
  line-height: 1;
  font-weight: 400;
  transform: none;
  white-space: nowrap;
}

.tab-item.active {
  color: #08a943;
}

.tab-item.active .tab-text {
  font-weight: 600;
}
