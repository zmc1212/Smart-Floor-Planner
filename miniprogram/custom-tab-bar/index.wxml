<view wx:if="{{!suppressed && !keyboardHidden}}" class="tabbar-shell {{staffNavigation ? 'staff-notebook-tabs' : ''}} {{twoTabs ? 'two-tabs' : ''}}">
  <view wx:if="{{badgeUnavailable}}" class="tabbar-badge-error">{{badgeUnavailableText}}</view>
  <view class="tabbar">
    <view
      wx:if="{{item.visible !== false}}"
      wx:for="{{list}}"
      wx:key="key"
      class="tab-item tab-key-{{item.key}} {{item.center ? 'center' : ''}} {{selected === index ? 'active' : ''}}"
      data-index="{{index}}"
      bindtap="switchTab"
      aria-role="button"
      aria-label="{{item.text}}"
    >
      <view class="tab-icon {{item.center ? 'center-icon' : ''}} {{item.center && compactMeasureTab ? 'center-icon-compact' : ''}}">
        <image wx:if="{{item.center}}" class="tab-image center-image {{compactMeasureTab ? 'center-image-compact' : ''}}" src="/images/mine-icons/tab-measure-k.png" mode="aspectFit" />
        <image wx:else class="tab-image" src="{{selected === index ? item.selectedIconPath : item.iconPath}}" mode="aspectFit" />
        <view wx:if="{{item.badgeText}}" class="tab-badge">{{item.badgeText}}</view>
      </view>
      <text class="tab-text">{{item.text}}</text>
    </view>
  </view>
</view>
