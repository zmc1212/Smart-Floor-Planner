<view class="lead-list-container">
  <view class="lead-hero-card">
    <view class="lead-hero-stats">
      <view class="hero-stat" wx:for="{{heroStats}}" wx:key="key">
        <text class="hero-stat-label">{{item.label}}</text>
        <text class="hero-stat-value">{{item.count}}</text>
        <text class="hero-stat-unit">个客户</text>
      </view>
    </view>
    <image class="lead-hero-image" src="/images/mockups/leads-hero.png" mode="aspectFit" />
  </view>

  <view class="search-row">
    <view class="search-box">
      <icon type="search" size="20" color="#657187" />
      <input class="search-input" placeholder="搜索客户" placeholder-class="search-placeholder" bindconfirm="onSearch" />
    </view>
    <view class="add-lead-button" bindtap="onAddLead">
      <text class="add-lead-plus">+</text>
      <text>新增客户</text>
    </view>
    <view class="filter-button" bindtap="onFilterTap">
      <text class="filter-mark">▽</text>
      <text class="filter-text">筛选</text>
    </view>
  </view>

  <scroll-view scroll-x class="tabs-scroll" show-scrollbar="{{false}}">
    <view class="tabs-row">
      <view
        wx:for="{{tabs}}"
        wx:key="id"
        class="tab-pill {{currentTab === item.id ? 'active' : ''}}"
        bindtap="onTabChange"
        data-index="{{index}}"
      >
        {{item.label}}
      </view>
    </view>
  </scroll-view>

  <view class="loading-state" wx:if="{{loading && leads.length === 0}}">
    <view class="loading-spinner"></view>
    <text>加载中...</text>
  </view>

  <scroll-view
    wx:else
    scroll-y
    class="list-scroller"
    refresher-enabled
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
    bindscrolltolower="onLoadMore"
  >
    <view class="leads-collection" wx:if="{{leads.length > 0}}">
      <view
        class="lead-card"
        wx:for="{{leads}}"
        wx:key="_id"
        bindtap="onLeadClick"
        data-id="{{item._id}}"
      >
        <view class="avatar-wrap {{item.avatarTone}}">
          <image wx:if="{{item.avatarUrl}}" class="avatar-image" src="{{item.avatarUrl}}" mode="aspectFill" />
          <text wx:else class="avatar-text">{{item.avatarText}}</text>
        </view>

        <view class="lead-main">
          <view class="lead-title-row">
            <text class="lead-name">{{item.displayName}}</text>
            <view class="status-chip status-{{item.statusTone}}">{{item.statusLabel}}</view>
          </view>

          <view class="info-line">
            <text class="line-icon">☎</text>
            <text>{{item.phoneMasked}}</text>
          </view>
          <view class="info-line">
            <text class="line-icon">⌖</text>
            <text class="line-text">{{item.communityLabel}}</text>
          </view>

          <view class="meta-row">
            <view class="meta-pill" wx:if="{{item.areaLabel}}">{{item.areaLabel}}</view>
            <view class="meta-pill" wx:if="{{item.styleLabel}}">{{item.styleLabel}}</view>
          </view>

          <view class="follow-row">
            <text>{{item.followLabel}}</text>
          </view>
        </view>

        <view class="lead-actions">
          <text class="arrow">›</text>
          <text class="more">•••</text>
        </view>
      </view>

      <view class="footer-tip" wx:if="{{loading}}">正在加载...</view>
      <view class="footer-tip" wx:elif="{{!hasMore}}">已经到底了</view>
    </view>

    <view class="empty-placeholder" wx:else>
      <view class="empty-icon-box">线</view>
      <text class="empty-msg">暂无此类客户</text>
      <view class="empty-cta" bindtap="onAddLead">新增客户</view>
    </view>
  </scroll-view>

</view>
