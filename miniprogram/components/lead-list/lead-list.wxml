<view class="lead-list-container">
  <view class="lead-hero-card">
    <view class="folder-top-plane"></view>
    <view class="folder-fold"></view>
    <view class="lead-hero-summary">
      <text class="hero-summary-label">跟进中的客户</text>
      <text class="hero-summary-value">{{heroSummary.following}}</text>
      <view class="hero-summary-meta">
        <text>今日新增</text>
        <text class="hero-summary-number">{{heroSummary.todayNew}}</text>
        <text class="hero-summary-dot">·</text>
        <text>已签约</text>
        <text class="hero-summary-number">{{heroSummary.converted}}</text>
      </view>
    </view>
  </view>

  <view class="lead-workspace">
    <view class="search-row">
      <view class="search-box">
        <image class="search-icon" src="/images/leads-v4/search.png" mode="aspectFit" />
        <input
          class="search-input"
          value="{{searchKeyword}}"
          placeholder="搜索客户"
          placeholder-class="search-placeholder"
          confirm-type="search"
          bindinput="onSearchInput"
          bindconfirm="onSearch"
        />
      </view>
      <view class="filter-button" bindtap="onFilterTap">
        <image class="filter-icon" src="/images/leads-v4/filter.png" mode="aspectFit" />
        <text class="filter-text">筛选</text>
      </view>
      <view wx:if="{{canAdd}}" class="add-lead-button" bindtap="onAddLead">
        <image class="add-lead-icon" src="/images/leads-ip-v1/plus-white.png" mode="aspectFit" />
        <text>新增客户</text>
      </view>
    </view>

    <view wx:if="{{referrerMembershipId}}" class="referrer-filter-bar">
      <text class="referrer-filter-label">{{referrerFilterLabel}}的推广客户</text>
      <view class="referrer-filter-clear" bindtap="clearReferrerFilter" aria-role="button" aria-label="清除推广人筛选">
        <text>清除</text>
      </view>
    </view>

    <scroll-view scroll-x class="tabs-scroll" show-scrollbar="{{false}}">
      <view class="tabs-row">
        <view
          wx:for="{{tabs}}"
          wx:key="id"
          class="tab-slot"
          bindtap="onTabChange"
          data-index="{{index}}"
        >
          <view class="tab-pill {{currentTab === item.id ? 'active' : ''}}">
            <text>{{item.label}}</text>
          </view>
          <view wx:if="{{currentTab === item.id}}" class="tab-active-indicator"></view>
        </view>
      </view>
    </scroll-view>

    <view class="error-state" wx:if="{{errorMessage && leads.length === 0}}">
      <text class="error-title">线索加载失败</text>
      <text class="error-copy">{{errorMessage}}</text>
      <view class="retry-button" bindtap="onRetry">重新加载</view>
    </view>

    <view class="loading-state" wx:if="{{loading && leads.length === 0}}">
      <view class="loading-spinner"></view>
      <text>加载中...</text>
    </view>

    <scroll-view
      wx:elif="{{!errorMessage || leads.length > 0}}"
      scroll-y
      class="list-scroller"
      refresher-enabled
      refresher-triggered="{{refreshing}}"
      bindrefresherrefresh="onRefresh"
      bindscrolltolower="onLoadMore"
    >
      <view class="leads-collection" wx:if="{{leads.length > 0}}">
      <view
        class="lead-card-stack"
        wx:for="{{leads}}"
        wx:key="_id"
        bindtap="onLeadClick"
        data-id="{{item._id}}"
      >
        <view class="lead-card-back"></view>
        <view class="lead-card-layer layer-{{item.statusTone}}"></view>
        <view class="lead-card card-{{item.statusTone}}">
          <view class="status-ribbon">
            <text>{{item.statusLabel}}</text>
          </view>

          <view class="lead-main">
            <text class="lead-name">{{item.displayName}}</text>

            <view class="phone-row">
              <image class="line-icon" src="/images/leads-v4/phone.png" mode="aspectFit" />
              <text>{{item.phoneMasked}}</text>
            </view>
            <view class="location-row">
              <image class="line-icon" src="/images/leads-v4/map-pin.png" mode="aspectFit" />
              <view class="location-text">{{item.communityLabel}}</view>
            </view>

            <view class="card-bottom-row">
              <view class="meta-row">
                <view class="meta-pill meta-{{item.statusTone}}" wx:if="{{item.areaLabel}}">{{item.areaLabel}}</view>
                <view class="meta-pill meta-{{item.statusTone}}" wx:if="{{item.styleLabel}}">{{item.styleLabel}}</view>
              </view>
              <text class="follow-row">{{item.followLabel}}</text>
            </view>
          </view>

          <view class="lead-plan-frame plan-{{item.statusTone}}">
            <image
              wx:if="{{item.planPreview.type === 'image'}}"
              class="lead-plan-image"
              src="{{item.planPreview.previewUrl}}"
              mode="aspectFit"
              data-id="{{item._id}}"
              binderror="onPlanPreviewError"
            />
            <image
              wx:elif="{{item.planPreview.type === 'protected' && item.planPreview.previewPath}}"
              class="lead-plan-image"
              src="{{item.planPreview.previewPath}}"
              mode="aspectFit"
              data-id="{{item._id}}"
              binderror="onPlanPreviewError"
            />
            <view wx:elif="{{item.planPreview.type === 'graph' || (item.planPreview.type === 'protected' && item.planPreview.segments.length && !item.planPreview.previewPath)}}" class="lead-plan-graph">
              <view
                wx:for="{{item.planPreview.segments}}"
                wx:for-item="segment"
                wx:key="id"
                class="lead-plan-wall"
                style="{{segment.style}}"
              ></view>
            </view>
            <view wx:else class="lead-plan-empty">
              <image src="{{item.statusIcon}}" mode="aspectFit" />
              <text>{{item.planPreview.label}}</text>
            </view>
          </view>

          <view class="lead-actions">
            <image class="arrow" src="/images/leads-v4/chevron-right.png" mode="aspectFit" />
          </view>
        </view>
      </view>

      <view class="footer-tip" wx:if="{{loading}}">正在加载...</view>
      <view class="footer-tip" wx:elif="{{!hasMore}}">已经到底了</view>
      </view>

      <view class="empty-placeholder" wx:else>
        <image class="empty-icon-box" src="/images/mine-icons/users.png" mode="aspectFit" />
        <text class="empty-msg">{{referrerMembershipId ? '该推广人暂无客户线索' : (searchKeyword ? '未找到匹配客户' : '暂无此类客户')}}</text>
        <view wx:if="{{canAdd}}" class="empty-cta" bindtap="onAddLead">新增客户</view>
      </view>
    </scroll-view>
  </view>

</view>
