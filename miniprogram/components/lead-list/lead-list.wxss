.lead-list-container {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100%;
  background: #ffffff;
  box-sizing: border-box;
}

.lead-hero-card {
  position: relative;
  min-height: 286rpx;
  margin: 0 36rpx 28rpx;
  padding: 56rpx 28rpx 42rpx;
  border-radius: 30rpx;
  border: 1rpx solid rgba(203, 224, 211, 0.78);
  background:
    radial-gradient(circle at 80% 22%, rgba(171, 230, 195, 0.5), rgba(171, 230, 195, 0) 36%),
    linear-gradient(135deg, #f4fbf4 0%, #eff9f2 48%, #f7fbf8 100%);
  box-shadow: 0 18rpx 40rpx rgba(29, 64, 47, 0.08);
  overflow: hidden;
  box-sizing: border-box;
}

.lead-hero-stats {
  position: relative;
  z-index: 2;
  display: flex;
  width: 432rpx;
  align-items: center;
}

.hero-stat {
  width: 144rpx;
  text-align: center;
  border-right: 1rpx dashed rgba(113, 128, 150, 0.22);
  box-sizing: border-box;
}

.hero-stat:last-child {
  border-right: none;
}

.hero-stat-label,
.hero-stat-unit {
  display: block;
  font-size: 25rpx;
  line-height: 1.25;
  color: #59657a;
}

.hero-stat-value {
  display: block;
  margin: 18rpx 0 10rpx;
  font-size: 58rpx;
  line-height: 1;
  font-weight: 700;
  color: #10a648;
}

.lead-hero-image {
  position: absolute;
  right: 8rpx;
  bottom: 16rpx;
  z-index: 1;
  width: 300rpx;
  height: 230rpx;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 0 36rpx 28rpx;
  box-sizing: border-box;
}

.search-box {
  flex: 1;
  min-width: 0;
  height: 82rpx;
  padding: 0 28rpx;
  border-radius: 26rpx;
  border: 1rpx solid #e1e7ef;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.05);
  display: flex;
  align-items: center;
  gap: 18rpx;
  box-sizing: border-box;
}

.search-input {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  color: #18212d;
}

.search-placeholder {
  color: #a4adbb;
}

.filter-button {
  width: 126rpx;
  height: 82rpx;
  border-radius: 26rpx;
  border: 1rpx solid #e1e7ef;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.05);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #657187;
  box-sizing: border-box;
}

.filter-mark {
  font-size: 28rpx;
  line-height: 24rpx;
}

.filter-text {
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 1;
}

.tabs-scroll {
  width: 100%;
  white-space: nowrap;
  padding-bottom: 22rpx;
  box-sizing: border-box;
}

.tabs-row {
  display: inline-flex;
  align-items: center;
  gap: 20rpx;
  padding: 0 36rpx;
}

.tab-pill {
  min-width: 142rpx;
  height: 58rpx;
  padding: 0 30rpx;
  border-radius: 31rpx;
  background: #f5f6f8;
  color: #657187;
  font-size: 28rpx;
  line-height: 58rpx;
  text-align: center;
  box-sizing: border-box;
}

.tab-pill.active {
  background: linear-gradient(135deg, #0ab84f 0%, #04a941 100%);
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 14rpx 26rpx rgba(8, 172, 72, 0.24);
}

.list-scroller {
  flex: 1;
  min-height: 0;
}

.leads-collection {
  padding: 0 34rpx 250rpx;
  box-sizing: border-box;
}

.lead-card {
  position: relative;
  display: flex;
  min-height: 202rpx;
  margin-bottom: 24rpx;
  padding: 30rpx 28rpx 24rpx 24rpx;
  border-radius: 26rpx;
  border: 1rpx solid rgba(226, 232, 240, 0.94);
  background: #ffffff;
  box-shadow: 0 14rpx 34rpx rgba(31, 41, 55, 0.07);
  box-sizing: border-box;
}

.lead-card:active,
.floating-add:active,
.tab-pill:active,
.filter-button:active {
  opacity: 0.88;
}

.avatar-wrap {
  width: 100rpx;
  height: 100rpx;
  margin-right: 28rpx;
  border-radius: 50%;
  flex-shrink: 0;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(circle at 35% 28%, rgba(255, 255, 255, 0.88), rgba(255, 255, 255, 0) 40%),
    linear-gradient(145deg, #dff8e6 0%, #68d889 100%);
  color: #0da94a;
}

.avatar-wrap.building {
  border-radius: 50%;
  background: linear-gradient(145deg, #a8efbd 0%, #22c55e 100%);
}

.avatar-image {
  width: 100%;
  height: 100%;
}

.avatar-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
}

.lead-main {
  flex: 1;
  min-width: 0;
  padding-right: 64rpx;
  box-sizing: border-box;
}

.lead-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.lead-name {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 33rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #121826;
}

.status-chip {
  min-width: 94rpx;
  height: 40rpx;
  padding: 0 18rpx;
  border-radius: 22rpx;
  font-size: 23rpx;
  line-height: 40rpx;
  font-weight: 600;
  text-align: center;
  flex-shrink: 0;
  box-sizing: border-box;
}

.status-pending {
  background: #fff3dc;
  color: #f59e0b;
}

.status-measuring {
  background: #e8f8ee;
  color: #12aa4b;
}

.status-designing {
  background: #e9f2ff;
  color: #267cf6;
}

.status-converted {
  background: #f2e8ff;
  color: #7c3aed;
}

.status-closed {
  background: #f2f4f7;
  color: #667085;
}

.info-line {
  display: flex;
  align-items: center;
  min-width: 0;
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 1.25;
  color: #657187;
}

.line-icon {
  width: 28rpx;
  margin-right: 10rpx;
  color: #657187;
  font-size: 24rpx;
  text-align: center;
  flex-shrink: 0;
}

.line-text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta-row {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
  flex-wrap: wrap;
}

.meta-pill {
  min-height: 34rpx;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  background: #e9f9ef;
  color: #12a94c;
  font-size: 23rpx;
  line-height: 1.1;
  box-sizing: border-box;
}

.follow-row {
  position: absolute;
  right: 80rpx;
  bottom: 28rpx;
  max-width: 310rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 24rpx;
  line-height: 1.2;
  color: #657187;
}

.lead-actions {
  position: absolute;
  top: 78rpx;
  right: 24rpx;
  bottom: 24rpx;
  width: 38rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  color: #657187;
}

.arrow {
  font-size: 58rpx;
  line-height: 1;
}

.more {
  font-size: 28rpx;
  letter-spacing: 2rpx;
  line-height: 1;
}

.floating-add {
  position: absolute;
  left: 132rpx;
  right: 132rpx;
  bottom: calc(118rpx + env(safe-area-inset-bottom));
  z-index: 5;
  height: 74rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #08b64d 0%, #00a840 100%);
  box-shadow: 0 16rpx 32rpx rgba(9, 164, 68, 0.28);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.floating-plus {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #ffffff;
  color: #09ad49;
  font-size: 30rpx;
  line-height: 34rpx;
  text-align: center;
  font-weight: 700;
}

.loading-state,
.empty-placeholder {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx 260rpx;
  color: #657187;
  box-sizing: border-box;
}

.loading-spinner {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 16rpx;
  border-radius: 50%;
  border: 4rpx solid #e9f9ef;
  border-top-color: #12aa4b;
}

.empty-icon-box {
  width: 136rpx;
  height: 136rpx;
  margin-bottom: 24rpx;
  border-radius: 50%;
  background: #e9f9ef;
  color: #12aa4b;
  font-size: 44rpx;
  line-height: 136rpx;
  text-align: center;
  font-weight: 700;
}

.empty-msg {
  margin-bottom: 28rpx;
  font-size: 28rpx;
  color: #657187;
}

.empty-cta {
  padding: 18rpx 48rpx;
  border-radius: 40rpx;
  background: #0ab84f;
  color: #ffffff;
  font-size: 28rpx;
}

.footer-tip {
  text-align: center;
  font-size: 24rpx;
  color: #8b96a8;
  padding: 30rpx 0;
}
