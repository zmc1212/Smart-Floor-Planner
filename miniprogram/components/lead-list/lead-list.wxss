.lead-list-container {
  display: flex;
  flex-direction: column;
  height: 100%;
  background: var(--bg-page);
}

.stats-dashboard {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--space-lg);
  padding: var(--space-section) var(--space-section) var(--space-xl);
  background: var(--bg-page);
}

.stat-card-mini {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 22rpx 8rpx;
  background: var(--bg-surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.stat-icon-bg {
  width: 52rpx;
  height: 52rpx;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--space-sm);
  font-size: 22rpx;
  font-weight: var(--font-weight-medium);
  background: var(--brand-primary-20);
  color: var(--brand-primary);
}

.stat-icon-bg.yellow {
  background: rgba(255, 200, 87, 0.18);
  color: #B7791F;
}

.stat-icon-bg.mint {
  background: var(--bg-surface-soft);
  color: var(--accent-secondary-green);
}

.stat-count {
  font-size: 32rpx;
  font-weight: var(--font-weight-bold);
  color: var(--text-primary);
  line-height: 1;
  margin-bottom: var(--space-xs);
  text-align: center;
}

.stat-label-mini {
  font-size: 20rpx;
  color: var(--text-secondary);
}

.search-section {
  display: flex;
  align-items: center;
  padding: 0 var(--space-section) var(--space-xl);
  background: var(--bg-page);
  gap: var(--space-lg);
}

.search-box {
  flex: 1;
  height: 80rpx;
  background: var(--bg-surface);
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  padding: 0 var(--space-xxl);
  box-shadow: var(--shadow-border-soft);
}

.search-icon-wrapper {
  margin-right: var(--space-md);
  display: flex;
  align-items: center;
}

.search-input-new {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-primary);
}

.action-buttons {
  display: flex;
  align-items: center;
  gap: var(--space-md);
}

.filter-btn,
.add-circle-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
}

.filter-btn {
  background: var(--bg-surface);
  color: var(--text-secondary);
  box-shadow: var(--shadow-card);
  font-size: 26rpx;
}

.add-circle-btn {
  background: var(--brand-primary);
  box-shadow: var(--shadow-float);
}

.plus-icon {
  font-size: 46rpx;
  color: var(--text-inverse);
  font-weight: var(--font-weight-regular);
  margin-bottom: 4rpx;
}

.tabs-wrapper {
  background: var(--bg-surface);
  box-shadow: var(--shadow-border-soft);
}

.tabs-scroll {
  white-space: nowrap;
  padding: 0 var(--space-section);
}

.tab-node {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 28rpx;
  position: relative;
}

.tab-text {
  font-size: var(--font-size-body);
  color: var(--text-secondary);
}

.tab-node.active .tab-text {
  color: var(--text-brand);
  font-weight: var(--font-weight-medium);
}

.tab-bar-indicator {
  position: absolute;
  bottom: 0;
  width: 44rpx;
  height: 6rpx;
  background: var(--brand-primary);
  border-radius: var(--radius-full);
}

.list-swiper {
  flex: 1;
}

.list-scroller {
  height: 100%;
}

.leads-collection {
  padding: var(--space-xxl) var(--space-section);
}

.premium-lead-card {
  background: var(--bg-surface);
  border-radius: var(--radius-lg);
  padding: var(--space-section);
  margin-bottom: var(--space-xxl);
  box-shadow: var(--shadow-card);
}

.card-top,
.card-bottom-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card-top {
  align-items: flex-start;
  margin-bottom: var(--space-xxl);
}

.lead-user-info {
  display: flex;
  align-items: center;
}

.avatar-placeholder {
  width: 80rpx;
  height: 80rpx;
  background: var(--brand-primary-20);
  color: var(--text-brand);
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: var(--font-weight-bold);
  margin-right: var(--space-xl);
}

.user-text {
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 32rpx;
  font-weight: var(--font-weight-medium);
  color: var(--text-primary);
  margin-bottom: var(--space-xs);
}

.user-phone {
  font-size: var(--font-size-caption);
  color: var(--text-secondary);
}

.status-chip {
  padding: 8rpx 20rpx;
  border-radius: var(--radius-full);
  font-size: 22rpx;
  font-weight: var(--font-weight-medium);
  background: var(--status-cancelled-bg);
  color: var(--status-cancelled-text);
}

.status-new,
.status-contacted,
.status-quoting {
  background: var(--status-converted-bg);
  color: var(--status-converted-text);
}

.status-measuring {
  background: var(--status-measuring-bg);
  color: var(--status-measuring-text);
}

.status-designing {
  background: var(--status-designing-bg);
  color: var(--status-designing-text);
}

.status-converted {
  background: var(--status-converted-bg);
  color: var(--status-converted-text);
}

.card-mid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-xl);
  padding: var(--space-xl) 0;
  border-top: 1rpx solid var(--neutral-100);
  border-bottom: 1rpx solid var(--neutral-100);
  margin-bottom: var(--space-xl);
}

.project-info {
  display: flex;
  flex-direction: column;
}

.project-label {
  font-size: 20rpx;
  color: var(--text-secondary);
  margin-bottom: var(--space-xs);
}

.project-value {
  font-size: 26rpx;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta-stats {
  display: flex;
  gap: var(--space-md);
}

.meta-pill {
  display: flex;
  align-items: center;
  background: var(--bg-surface-soft);
  padding: 6rpx 16rpx;
  border-radius: var(--radius-full);
}

.pill-icon {
  font-size: 20rpx;
  color: var(--text-brand);
  margin-right: var(--space-sm);
}

.pill-text {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.card-action-btn,
.empty-cta {
  background: var(--brand-primary);
  color: var(--text-inverse);
  border-radius: var(--radius-full);
  font-weight: var(--font-weight-medium);
}

.card-action-btn {
  padding: 16rpx 30rpx;
  font-size: var(--font-size-caption);
}

.loading-state,
.empty-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 150rpx;
  color: var(--text-secondary);
}

.loading-spinner {
  width: 44rpx;
  height: 44rpx;
  border-radius: var(--radius-full);
  border: 4rpx solid var(--brand-primary-20);
  border-top-color: var(--brand-primary);
  margin-bottom: var(--space-lg);
}

.empty-icon-box {
  width: 160rpx;
  height: 160rpx;
  background: var(--brand-primary-20);
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--space-section);
}

.empty-emoji {
  font-size: 56rpx;
  color: var(--text-brand);
  font-weight: var(--font-weight-bold);
}

.empty-msg {
  font-size: var(--font-size-body);
  color: var(--text-secondary);
  margin-bottom: 40rpx;
}

.empty-cta {
  padding: 20rpx 56rpx;
  font-size: var(--font-size-body);
}

.footer-tip {
  text-align: center;
  font-size: var(--font-size-caption);
  color: var(--text-secondary);
  padding: 40rpx 0;
}
