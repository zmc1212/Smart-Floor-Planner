.lead-list-container {
  display: flex;
  flex-direction: column;
  height: 100%;
  background: var(--bg-page);
}

/* Stats Dashboard */
.stats-dashboard {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  padding: 32rpx;
  background: #fff;
}

.stat-card-mini {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  background: var(--bg-surface-soft);
  border-radius: var(--radius-lg);
  border: 1px solid var(--neutral-100);
}

.stat-icon-bg {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
  font-size: 24rpx;
}

.stat-icon-bg.blue { background: #e0f2fe; color: #0ea5e9; }
.stat-icon-bg.orange { background: #fff7ed; color: #f97316; }
.stat-icon-bg.green { background: #f0fdf4; color: #22c55e; }
.stat-icon-bg.purple { background: #faf5ff; color: #a855f7; }

.stat-count {
  font-size: 32rpx;
  font-weight: var(--font-weight-bold);
  color: var(--neutral-900);
  line-height: 1;
  margin-bottom: 4rpx;
  text-align: center;
}

.stat-label-mini {
  font-size: 20rpx;
  color: var(--text-muted);
}

/* Search Section */
.search-section {
  display: flex;
  align-items: center;
  padding: 0 32rpx 24rpx;
  background: #fff;
  gap: 20rpx;
}

.search-box {
  flex: 1;
  height: 80rpx;
  background: var(--neutral-100);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}

.search-icon-wrapper {
  margin-right: 16rpx;
  display: flex;
  align-items: center;
}

.search-input-new {
  flex: 1;
  font-size: 26rpx;
  color: var(--neutral-900);
}

.action-buttons {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.filter-btn {
  width: 80rpx;
  height: 80rpx;
  background: var(--neutral-100);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: var(--neutral-700);
}

.add-circle-btn {
  width: 80rpx;
  height: 80rpx;
  background: var(--brand-primary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 16rpx rgba(34, 197, 94, 0.3);
}

.plus-icon {
  font-size: 48rpx;
  color: #fff;
  font-weight: 300;
  margin-bottom: 4rpx;
}

/* Tabs */
.tabs-wrapper {
  background: #fff;
  border-bottom: 1rpx solid var(--neutral-100);
}

.tabs-scroll {
  white-space: nowrap;
  padding: 0 32rpx;
}

.tab-node {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 32rpx;
  position: relative;
}

.tab-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  transition: all 0.2s;
}

.tab-node.active .tab-text {
  color: var(--brand-primary);
  font-weight: var(--font-weight-medium);
}

.tab-bar-indicator {
  position: absolute;
  bottom: 0;
  width: 40rpx;
  height: 6rpx;
  background: var(--brand-primary);
  border-radius: 3rpx;
}

/* List */
.list-swiper {
  flex: 1;
}

.list-scroller {
  height: 100%;
}

.leads-collection {
  padding: 24rpx 32rpx;
}

.premium-lead-card {
  background: #fff;
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
  border: 1px solid rgba(0,0,0,0.02);
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 32rpx;
}

.lead-user-info {
  display: flex;
  align-items: center;
}

.avatar-placeholder {
  width: 80rpx;
  height: 80rpx;
  background: var(--bg-brand-soft);
  color: var(--brand-primary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: bold;
  margin-right: 20rpx;
}

.user-text {
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 32rpx;
  font-weight: var(--font-weight-medium);
  color: var(--neutral-900);
  margin-bottom: 4rpx;
}

.user-phone {
  font-size: 24rpx;
  color: var(--text-muted);
}

.status-chip {
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 22rpx;
  font-weight: var(--font-weight-medium);
}

.status-new { background: #fef3c7; color: #d97706; }
.status-measuring { background: #dcfce7; color: #16a34a; }
.status-designing { background: #dbeafe; color: #2563eb; }
.status-converted { background: #f3e8ff; color: #9333ea; }

.card-mid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  padding: 24rpx 0;
  border-top: 1rpx dashed var(--neutral-100);
  border-bottom: 1rpx dashed var(--neutral-100);
  margin-bottom: 24rpx;
}

.project-info {
  display: flex;
  flex-direction: column;
}

.project-label {
  font-size: 20rpx;
  color: var(--text-muted);
  margin-bottom: 4rpx;
}

.project-value {
  font-size: 26rpx;
  color: var(--neutral-700);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-bottom-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.meta-stats {
  display: flex;
  gap: 16rpx;
}

.meta-pill {
  display: flex;
  align-items: center;
  background: var(--neutral-100);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.pill-icon {
  font-size: 20rpx;
  margin-right: 8rpx;
}

.pill-text {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.card-action-btn {
  padding: 16rpx 32rpx;
  background: var(--brand-primary);
  color: #fff;
  font-size: 24rpx;
  border-radius: 32rpx;
  font-weight: var(--font-weight-medium);
}

/* Empty */
.empty-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 160rpx;
}

.empty-icon-box {
  width: 160rpx;
  height: 160rpx;
  background: #f8fafc;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.empty-emoji {
  font-size: 80rpx;
}

.empty-msg {
  font-size: 28rpx;
  color: var(--text-muted);
  margin-bottom: 40rpx;
}

.empty-cta {
  padding: 20rpx 60rpx;
  background: var(--brand-primary);
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.footer-tip {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-muted);
  padding: 40rpx 0;
}
