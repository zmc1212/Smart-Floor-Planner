.lead-list-container {
  display: flex;
  flex-direction: column;
  height: 100%;
  background:
    linear-gradient(180deg, #fcfdfb 0%, #f5f7f4 46%, var(--bg-page) 100%);
}

.leads-hero {
  margin: 20rpx 20rpx 14rpx;
  padding: 26rpx;
  min-height: 150rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(207, 220, 207, 0.55);
  background:
    radial-gradient(circle at 78% 24%, rgba(168, 230, 191, 0.36) 0%, rgba(168, 230, 191, 0) 34%),
    linear-gradient(135deg, #eff9ef 0%, #edf8f2 48%, #f9fbf9 100%);
  box-shadow: var(--shadow-home-card);
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.leads-hero-copy {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  z-index: 2;
}

.leads-hero-title {
  font-size: 42rpx;
  line-height: 1.15;
  font-weight: 600;
  color: #1d252d;
}

.leads-hero-subtitle {
  font-size: 25rpx;
  line-height: 1.5;
  color: #6f7782;
}

.leads-hero-visual {
  position: relative;
  width: 174rpx;
  min-width: 174rpx;
  height: 116rpx;
}

.lead-mini-card {
  position: absolute;
  background: rgba(255, 255, 255, 0.96);
  border: 2rpx solid rgba(198, 228, 203, 0.86);
  box-shadow: 0 10rpx 24rpx rgba(90, 110, 92, 0.1);
}

.lead-mini-card-a {
  right: 38rpx;
  top: 12rpx;
  width: 106rpx;
  height: 68rpx;
  border-radius: 18rpx;
  transform: rotate(-7deg);
}

.lead-mini-card-b {
  right: 0;
  top: 46rpx;
  width: 92rpx;
  height: 54rpx;
  border-radius: 16rpx;
  transform: rotate(8deg);
}

.lead-mini-dot {
  position: absolute;
  right: 112rpx;
  bottom: 18rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: rgba(34, 197, 94, 0.24);
}

.stats-dashboard {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
  padding: 20rpx 20rpx 14rpx;
}

.stat-card-mini {
  min-width: 0;
  min-height: 98rpx;
  padding: 14rpx 10rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(207, 220, 207, 0.55);
  border-radius: 18rpx;
  box-shadow: var(--shadow-home-card);
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  box-sizing: border-box;
}

.stat-icon-bg {
  width: 30rpx;
  height: 30rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(34, 197, 94, 0.16);
  color: #159a49;
  font-size: 18rpx;
  font-weight: 600;
}

.stat-icon-bg.yellow {
  background: rgba(255, 200, 87, 0.18);
  color: #df9b00;
}

.stat-icon-bg.mint {
  background: rgba(168, 230, 207, 0.22);
  color: #1aa350;
}

.stat-count {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #171d22;
  line-height: 1;
}

.stat-label-mini {
  display: block;
  font-size: 20rpx;
  color: #9aa1aa;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-top: 8rpx;
}

.stat-info {
  min-width: 0;
}

.stat-icon-text {
  line-height: 1;
}

.search-section {
  display: flex;
  align-items: center;
  padding: 0 20rpx 14rpx;
  gap: 12rpx;
}

.search-box {
  flex: 1;
  height: 76rpx;
  min-width: 0;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(207, 220, 207, 0.55);
  border-radius: 38rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(26, 35, 24, 0.05);
  box-sizing: border-box;
}

.search-icon-wrapper {
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  opacity: 0.72;
}

.search-input-new {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--text-primary);
}

.action-buttons {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.filter-btn,
.add-circle-btn {
  width: 76rpx;
  height: 76rpx;
  border-radius: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.filter-btn {
  background: rgba(255, 255, 255, 0.94);
  color: #5e6975;
  box-shadow: 0 6rpx 20rpx rgba(26, 35, 24, 0.05);
  font-size: 24rpx;
}

.add-circle-btn {
  background: linear-gradient(135deg, #0fb04d 0%, #18a94b 100%);
  box-shadow: 0 10rpx 20rpx rgba(17, 164, 66, 0.2);
}

.plus-icon {
  font-size: 44rpx;
  color: var(--text-inverse);
  font-weight: 400;
  margin-bottom: 4rpx;
}

.tabs-wrapper {
  margin: 0 20rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 1rpx solid rgba(207, 220, 207, 0.55);
  border-radius: 22rpx;
  box-shadow: var(--shadow-home-card);
}

.tabs-scroll {
  white-space: nowrap;
  padding: 0 10rpx;
}

.tab-node {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 22rpx 22rpx 18rpx;
  position: relative;
}

.tab-text {
  font-size: 26rpx;
  color: #7e8793;
}

.tab-node.active .tab-text {
  color: #19a24d;
  font-weight: 500;
}

.tab-bar-indicator {
  position: absolute;
  bottom: 8rpx;
  width: 36rpx;
  height: 5rpx;
  background: var(--brand-primary);
  border-radius: var(--radius-full);
}

.list-swiper {
  flex: 1;
  margin-top: 10rpx;
}

.list-scroller {
  height: 100%;
}

.leads-collection {
  padding: 14rpx 20rpx 40rpx;
}

.premium-lead-card {
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(207, 220, 207, 0.55);
  border-radius: 22rpx;
  padding: 22rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-home-card);
  box-sizing: border-box;
}

.card-top,
.card-bottom-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
}

.card-top {
  align-items: flex-start;
  margin-bottom: 18rpx;
}

.lead-user-info {
  display: flex;
  align-items: center;
  min-width: 0;
}

.avatar-placeholder {
  width: 76rpx;
  height: 76rpx;
  background: linear-gradient(180deg, rgba(34, 197, 94, 0.18) 0%, rgba(34, 197, 94, 0.1) 100%);
  color: #1fb056;
  border-radius: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.user-text {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.user-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #20262d;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.user-phone {
  font-size: 22rpx;
  color: #9aa1aa;
}

.status-chip {
  min-height: 34rpx;
  padding: 0 16rpx;
  border-radius: 17rpx;
  font-size: 20rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--status-cancelled-bg);
  color: var(--status-cancelled-text);
  flex-shrink: 0;
}

.status-new,
.status-contacted,
.status-quoting {
  background: var(--status-converted-bg);
  color: var(--status-converted-text);
}

.status-measuring {
  background: var(--status-measuring-bg);
  color: var(--status-measuring-text);
}

.status-designing {
  background: var(--status-designing-bg);
  color: var(--status-designing-text);
}

.status-converted {
  background: var(--status-converted-bg);
  color: var(--status-converted-text);
}

.card-mid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid rgba(228, 233, 230, 0.92);
  border-bottom: 1rpx solid rgba(228, 233, 230, 0.92);
  margin-bottom: 16rpx;
}

.project-info {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.project-label {
  font-size: 20rpx;
  color: #a0a6af;
}

.project-value {
  font-size: 25rpx;
  color: #20262d;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta-stats {
  min-width: 0;
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}

.meta-pill {
  display: flex;
  align-items: center;
  background: rgba(34, 197, 94, 0.1);
  padding: 6rpx 14rpx;
  border-radius: var(--radius-full);
}

.pill-icon {
  font-size: 20rpx;
  color: #17a14c;
  margin-right: 6rpx;
}

.pill-text {
  font-size: 22rpx;
  color: #6f7782;
}

.card-action-btn,
.empty-cta {
  background: linear-gradient(135deg, #0fb04d 0%, #18a94b 100%);
  color: var(--text-inverse);
  border-radius: var(--radius-full);
  font-weight: 500;
  box-shadow: 0 10rpx 20rpx rgba(17, 164, 66, 0.18);
}

.card-action-btn {
  padding: 14rpx 24rpx;
  font-size: 24rpx;
  flex-shrink: 0;
}

.loading-state,
.empty-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 150rpx 32rpx 0;
  color: var(--text-secondary);
  box-sizing: border-box;
}

.loading-spinner {
  width: 44rpx;
  height: 44rpx;
  border-radius: var(--radius-full);
  border: 4rpx solid var(--brand-primary-20);
  border-top-color: var(--brand-primary);
  margin-bottom: 16rpx;
}

.empty-icon-box {
  width: 136rpx;
  height: 136rpx;
  background: var(--brand-primary-20);
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.empty-emoji {
  font-size: 48rpx;
  color: var(--text-brand);
  font-weight: 600;
}

.empty-msg {
  font-size: var(--font-size-body);
  color: #7e8793;
  margin-bottom: 28rpx;
}

.empty-cta {
  padding: 18rpx 48rpx;
  font-size: var(--font-size-body);
}

.footer-tip {
  text-align: center;
  font-size: var(--font-size-caption);
  color: var(--text-secondary);
  padding: 36rpx 0;
}
