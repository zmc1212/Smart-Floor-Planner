.lead-list-container {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100%;
  background: #ffffff;
  box-sizing: border-box;
}

.lead-hero-card {
  position: relative;
  flex-shrink: 0;
  height: 250rpx;
  margin: 0 29rpx 26rpx;
  padding: 44rpx 24rpx 30rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(189, 225, 203, 0.76);
  background: #ffffff;
  box-shadow: 0 12rpx 34rpx rgba(43, 79, 59, 0.08);
  overflow: hidden;
  box-sizing: border-box;
}

.lead-hero-stats {
  position: relative;
  z-index: 2;
  display: flex;
  width: 442rpx;
  align-items: center;
}

.hero-stat {
  width: 147rpx;
  text-align: center;
  box-sizing: border-box;
}

.hero-stat + .hero-stat {
  position: relative;
}

.hero-stat + .hero-stat::before {
  position: absolute;
  left: 0;
  top: 0;
  width: 1rpx;
  height: 145rpx;
  border-left: 1rpx dashed rgba(112, 128, 149, 0.24);
  content: "";
  transform: scaleX(0.5);
  transform-origin: left center;
}

.hero-stat-label,
.hero-stat-unit {
  display: block;
  font-size: 24rpx;
  line-height: 1.25;
  color: #5e6980;
}

.hero-stat-value {
  display: block;
  margin: 18rpx 0 11rpx;
  font-size: 56rpx;
  line-height: 1;
  font-weight: 700;
  color: #0ab653;
}

.lead-hero-image {
  position: absolute;
  right: -1rpx;
  bottom: 0;
  z-index: 1;
  width: 276rpx;
  height: 222rpx;
}

.search-row {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 14rpx;
  padding: 0 32rpx 26rpx;
  box-sizing: border-box;
}

.search-box,
.filter-button {
  height: 68rpx;
  border-radius: 29rpx;
  border: 1rpx solid #e1e6ed;
  background: #ffffff;
  box-shadow: 0 7rpx 22rpx rgba(31, 41, 55, 0.045);
  box-sizing: border-box;
}

.search-box {
  flex: 1;
  min-width: 0;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.search-icon {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  font-size: 27rpx;
  line-height: 68rpx;
  color: #18212d;
}

.search-placeholder {
  color: #778298;
}

.add-lead-button {
  width: 172rpx;
  height: 68rpx;
  border-radius: 30rpx;
  background: #09b54d;
  box-shadow: 0 8rpx 22rpx rgba(8, 172, 72, 0.18);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.add-lead-icon {
  width: 30rpx;
  height: 30rpx;
}

.filter-button {
  width: 132rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #657187;
  flex-shrink: 0;
}

.filter-icon {
  width: 28rpx;
  height: 28rpx;
}

.filter-text {
  font-size: 25rpx;
  line-height: 1;
}

.tabs-scroll {
  width: 100%;
  flex-shrink: 0;
  white-space: nowrap;
  padding-bottom: 22rpx;
  box-sizing: border-box;
}

.tabs-row {
  display: flex;
  width: 750rpx;
  align-items: center;
  gap: 12rpx;
  padding: 0 34rpx;
  box-sizing: border-box;
}

.tab-pill {
  position: relative;
  flex: 1;
  min-width: 0;
  height: 52rpx;
  border-radius: 27rpx;
  background: #f5f6f8;
  color: #59657a;
  font-size: 24rpx;
  line-height: 52rpx;
  text-align: center;
  box-sizing: border-box;
}

.tab-pill.active {
  background: #08b44c;
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 9rpx 20rpx rgba(8, 172, 72, 0.18);
}

.tab-pill.active::after {
  position: absolute;
  left: 50%;
  bottom: -12rpx;
  width: 23rpx;
  height: 3rpx;
  border-radius: 3rpx;
  background: #08b44c;
  content: "";
  transform: translateX(-50%);
}

.list-scroller {
  flex: 1;
  min-height: 0;
}

.leads-collection {
  padding: 0 34rpx 46rpx;
  box-sizing: border-box;
}

.lead-card-stack {
  position: relative;
  height: 214rpx;
  margin-bottom: 16rpx;
}

.lead-card-layer {
  position: absolute;
  left: 0;
  top: 0;
  width: 149rpx;
  height: 53rpx;
  border-top: 6rpx solid #0ab653;
  border-left: 7rpx solid #0ab653;
  border-radius: 20rpx 0 0 0;
  background: transparent;
  box-shadow: none;
  box-sizing: border-box;
}

.lead-card {
  position: absolute;
  left: 7rpx;
  top: 6rpx;
  z-index: 1;
  display: flex;
  width: calc(100% - 7rpx);
  height: 208rpx;
  padding: 58rpx 26rpx 20rpx 28rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(31, 41, 55, 0.075);
  overflow: hidden;
  box-sizing: border-box;
}

.lead-card-stack:active .lead-card,
.add-lead-button:active,
.tab-pill:active,
.filter-button:active,
.retry-button:active {
  opacity: 0.88;
}

.status-ribbon {
  position: absolute;
  left: 0;
  top: 0;
  min-width: 142rpx;
  height: 47rpx;
  padding: 0 18rpx 0 20rpx;
  border-radius: 0 0 26rpx 0;
  background: #e9faef;
  color: #0bb85b;
  font-size: 24rpx;
  line-height: 47rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 9rpx;
  box-sizing: border-box;
}

.status-icon {
  width: 27rpx;
  height: 27rpx;
}

.layer-pending {
  border-color: #1687f8;
  box-shadow: 0 6rpx 16rpx rgba(22, 135, 248, 0.14);
}

.card-pending .status-ribbon {
  background: #edf6ff;
  color: #1687f8;
}

.layer-remeasuring {
  border-color: #8b5cf6;
  box-shadow: 0 6rpx 16rpx rgba(139, 92, 246, 0.14);
}

.card-remeasuring .status-ribbon {
  background: #f2edff;
  color: #8055f3;
}

.layer-designing {
  border-color: #ff7100;
  box-shadow: 0 6rpx 16rpx rgba(255, 113, 0, 0.14);
}

.card-designing .status-ribbon {
  background: #fff1e7;
  color: #ff7100;
}

.layer-converted {
  border-color: #f59e0b;
  box-shadow: 0 6rpx 16rpx rgba(245, 158, 11, 0.14);
}

.card-converted .status-ribbon {
  background: #fff6df;
  color: #d88900;
}

.layer-closed {
  border-color: #9aa3b2;
  box-shadow: 0 6rpx 16rpx rgba(102, 112, 133, 0.12);
}

.card-closed .status-ribbon {
  background: #f2f4f7;
  color: #667085;
}

.lead-plan-frame {
  position: relative;
  width: 164rpx;
  height: 128rpx;
  margin-right: 36rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  overflow: hidden;
  color: #12ad50;
  background: #effaf3;
  border: 6rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 4rpx 12rpx rgba(31, 41, 55, 0.08);
  box-sizing: border-box;
}

.lead-plan-image,
.lead-plan-graph {
  width: 100%;
  height: 100%;
}

.lead-plan-graph {
  position: relative;
  background-image:
    linear-gradient(rgba(18, 173, 80, 0.055) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(18, 173, 80, 0.055) 1rpx, transparent 1rpx);
  background-size: 20rpx 20rpx;
}

.lead-plan-wall {
  position: absolute;
  height: 5rpx;
  border-radius: 4rpx;
  background: currentColor;
  box-shadow: 0 0 3rpx currentColor;
  transform-origin: left center;
}

.lead-plan-empty {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  color: currentColor;
  font-size: 19rpx;
}

.lead-plan-empty image {
  width: 28rpx;
  height: 28rpx;
}

.plan-pending {
  color: #1687f8;
  background: #edf6ff;
}

.plan-remeasuring {
  color: #8055f3;
  background: #f2edff;
}

.plan-designing {
  color: #ff7100;
  background: #fff1e7;
}

.plan-converted {
  color: #d88900;
  background: #fff6df;
}

.plan-closed {
  color: #667085;
  background: #f2f4f7;
}

.lead-main {
  position: static;
  flex: 1;
  min-width: 0;
  height: 122rpx;
  padding-right: 34rpx;
  box-sizing: border-box;
}

.lead-name {
  display: block;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 31rpx;
  line-height: 1.15;
  font-weight: 700;
  color: #0f1724;
}

.contact-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  min-width: 0;
  margin-top: 13rpx;
  color: #657187;
}

.contact-item {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 8rpx;
  font-size: 23rpx;
  line-height: 1.15;
  white-space: nowrap;
}

.phone-item {
  flex-shrink: 0;
}

.location-item {
  flex: 1;
}

.line-icon {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
}

.line-text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta-row {
  display: flex;
  flex-shrink: 0;
  gap: 11rpx;
  margin-top: 0;
  flex-wrap: nowrap;
}

.meta-pill {
  max-width: 128rpx;
  min-height: 34rpx;
  padding: 4rpx 13rpx;
  border-radius: 8rpx;
  background: #e9f9ef;
  color: #0baa4a;
  font-size: 22rpx;
  line-height: 26rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-sizing: border-box;
}

.meta-pending {
  background: #eaf4ff;
  color: #1687f8;
}

.meta-remeasuring {
  background: #f2edff;
  color: #8055f3;
}

.meta-closed {
  background: #f1f4f7;
  color: #657187;
}

.meta-designing {
  background: #fff1e7;
  color: #ff7100;
}

.meta-converted {
  background: #fff6df;
  color: #d88900;
}

.card-bottom-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  margin-top: 16rpx;
}

.follow-row {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 19rpx;
  line-height: 1.2;
  color: #657187;
  text-align: right;
}

.lead-actions {
  position: absolute;
  top: 77rpx;
  right: 22rpx;
  width: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.arrow {
  width: 27rpx;
  height: 27rpx;
}

.loading-state,
.error-state,
.empty-placeholder {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 32rpx 60rpx;
  color: #657187;
  box-sizing: border-box;
}

.loading-spinner {
  width: 42rpx;
  height: 42rpx;
  margin-bottom: 16rpx;
  border-radius: 50%;
  border: 4rpx solid #e9f9ef;
  border-top-color: #12aa4b;
  animation: lead-spin 0.7s linear infinite;
}

@keyframes lead-spin {
  to {
    transform: rotate(360deg);
  }
}

.error-title {
  font-size: 29rpx;
  font-weight: 600;
  color: #1f2937;
}

.error-copy {
  max-width: 560rpx;
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.45;
  color: #7a8494;
  text-align: center;
}

.retry-button,
.empty-cta {
  margin-top: 24rpx;
  padding: 15rpx 42rpx;
  border-radius: 34rpx;
  background: #0ab84f;
  color: #ffffff;
  font-size: 26rpx;
}

.empty-icon-box {
  width: 84rpx;
  height: 84rpx;
  margin-bottom: 18rpx;
}

.empty-msg {
  font-size: 27rpx;
  color: #657187;
}

.footer-tip {
  text-align: center;
  font-size: 23rpx;
  color: #8b96a8;
  padding: 26rpx 0;
}
