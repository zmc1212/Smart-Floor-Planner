<view class="modal-overlay" wx:if="{{show}}">
  <view class="modal-container opening-modal-container">
    <view class="modal-close" bindtap="onClose">关闭</view>

    <view class="title-section">
      <text class="modal-title">{{openingType === 'DOOR' ? '测量门洞' : '测量窗洞'}}</text>
      <text class="modal-subtitle">{{wallLabel}} · 墙长 {{wallLengthMeters}}m</text>
    </view>

    <view class="opening-ref-row">
      <view class="ref-btn {{ref === 'start' ? 'active' : ''}}" data-ref="start" bindtap="onSelectReference">
        <text class="ref-title">从起点量</text>
        <text class="ref-desc">靠近墙段起点</text>
      </view>
      <view class="ref-btn {{ref === 'end' ? 'active' : ''}}" data-ref="end" bindtap="onSelectReference">
        <text class="ref-title">从终点量</text>
        <text class="ref-desc">靠近墙段终点</text>
      </view>
    </view>

    <view class="opening-steps">
      <view class="opening-step {{step === 1 ? 'active' : ''}} {{offsetMeters > 0 ? 'done' : ''}}">
        <text class="step-num">1</text>
        <view class="step-copy">
          <text class="step-title">距墙角偏移</text>
          <text class="step-value">{{offsetText}}m</text>
        </view>
        <view class="step-retry" wx:if="{{offsetMeters > 0}}" data-step="1" bindtap="onRetryStep">重测</view>
      </view>

      <view class="opening-step {{step === 2 ? 'active' : ''}} {{widthMeters > 0 ? 'done' : ''}}">
        <text class="step-num">2</text>
        <view class="step-copy">
          <text class="step-title">洞口宽度</text>
          <text class="step-value">{{widthText}}m</text>
        </view>
        <view class="step-retry" wx:if="{{widthMeters > 0}}" data-step="2" bindtap="onRetryStep">重测</view>
      </view>
    </view>

    <view class="opening-preview">
      <view class="wall-line">
        <view class="wall-start"></view>
        <view class="wall-opening" style="left: {{previewLeft}}%; width: {{previewWidth}}%;"></view>
        <view class="wall-end"></view>
      </view>
    </view>

    <view class="hint-section">
      <text class="hint-icon">!</text>
      <text class="hint-text">先从选定墙角量到门窗起边，再测量洞口净宽。两次读数会自动落到平面图上。</text>
    </view>

    <view class="action-section">
      <view wx:if="{{step < 3}}" class="btn btn-primary btn-confirm {{isMeasuring ? 'loading' : ''}}" bindtap="onMeasureTap">
        {{isMeasuring ? '测量中...' : (step === 1 ? '测量偏移' : '测量宽度')}}
      </view>
      <view wx:else class="btn btn-primary btn-confirm" bindtap="onConfirm">确认添加</view>
      <view class="btn btn-outline btn-finish" bindtap="onClose">取消</view>
    </view>
  </view>
</view>
