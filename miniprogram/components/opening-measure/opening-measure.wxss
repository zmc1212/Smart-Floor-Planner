@import "../measure-modal/measure-modal.wxss";

.opening-modal-container {
  max-height: 88vh;
  overflow: hidden;
}

.opening-ref-row {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-md);
  margin-bottom: var(--space-section);
}

.ref-btn {
  padding: var(--space-lg);
  border-radius: var(--radius-lg);
  background: var(--bg-surface-soft);
  box-shadow: var(--shadow-border-soft);
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.ref-btn.active {
  background: var(--brand-primary-20);
  box-shadow: inset 0 0 0 2rpx var(--brand-primary);
}

.ref-title {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-bold);
  color: var(--text-primary);
}

.ref-desc {
  font-size: var(--font-size-caption);
  color: var(--text-secondary);
}

.opening-steps {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  margin-bottom: var(--space-section);
}

.opening-step {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  padding: var(--space-lg);
  border-radius: var(--radius-lg);
  background: var(--bg-surface-soft);
  box-shadow: var(--shadow-border-soft);
}

.opening-step.active,
.opening-step.done {
  background: var(--brand-primary-20);
}

.step-num {
  width: 46rpx;
  height: 46rpx;
  border-radius: var(--radius-full);
  background: var(--neutral-100);
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: var(--font-weight-bold);
}

.opening-step.active .step-num,
.opening-step.done .step-num {
  background: var(--brand-primary);
  color: var(--text-inverse);
}

.step-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.step-title {
  font-size: var(--font-size-caption);
  color: var(--text-secondary);
}

.step-value {
  font-size: 30rpx;
  font-weight: var(--font-weight-bold);
  color: var(--text-primary);
}

.step-retry {
  font-size: var(--font-size-caption);
  color: var(--text-brand);
  padding: 8rpx 12rpx;
}

.opening-preview {
  height: 120rpx;
  background: var(--bg-surface-soft);
  border-radius: var(--radius-lg);
  margin-bottom: var(--space-section);
  display: flex;
  align-items: center;
  padding: 0 38rpx;
}

.wall-line {
  position: relative;
  width: 100%;
  height: 8rpx;
  border-radius: var(--radius-full);
  background: var(--neutral-300);
}

.wall-start,
.wall-end {
  position: absolute;
  top: -10rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: var(--radius-full);
  background: var(--brand-primary);
}

.wall-start {
  left: -14rpx;
}

.wall-end {
  right: -14rpx;
}

.wall-opening {
  position: absolute;
  top: -12rpx;
  min-width: 0;
  height: 32rpx;
  border-radius: var(--radius-full);
  background: #3b82f6;
}
