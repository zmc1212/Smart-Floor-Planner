<!--
  THESIS: 用“三项免费服务通行证”统一效果图、家装设计顾问和家装现场顾问，不再保留双免旧心智。
  OWN-WORLD: 单一品牌绿主场景、暖白阶段票据、浅薄荷权益卡和一次完整小K引导。
  STORY: 用户先认清三项免费权益，再确认当前真实服务阶段，最后进入预约、顾问联系、交付方案或服务档案。
  FIRST VIEWPORT: 胶囊安全身份栏；小K手持三权益牌的绿色 Hero；跨层真实阶段票据；三张紧凑权益卡；保障条。
  FORM: design-references/customer-service-home-three-free-v1/customer-service-home-three-free-v1.png；Operate 模式，真实媒体与动态阶段合同不变。
-->
<view class="customer-service-home sfp-tab-page">
  <scroll-view scroll-y class="csh-scroll" enhanced show-scrollbar="{{false}}">
    <view class="csh-content">
      <view
        class="identity-nav"
        style="padding-top: {{navigationTop}}px; min-height: {{navigationHeight}}px; padding-right: {{navigationRight}}px;"
      >
        <view class="identity-left">
          <view class="brand-mark">
            <image src="/images/home-ip-v1/brand-logo.png" mode="aspectFit" />
          </view>
          <text class="identity-role-name">家客来 · 服务向导</text>
          <view class="identity-tag">
            <text>专业服务</text>
          </view>
        </view>
        <view class="identity-actions">
          <view class="qr-btn" bindtap="openScan" aria-role="button" aria-label="扫码">
            <image class="action-icon" src="/images/mine-icons/scan.png" mode="aspectFit" />
          </view>
        </view>
      </view>

      <view wx:if="{{loading}}" class="state-block">
        <text>正在读取你的装修服务</text>
      </view>
      <view wx:elif="{{error}}" class="state-block">
        <text>{{error}}</text>
        <view class="retry" bindtap="retry">重新加载</view>
      </view>

      <block wx:else>
        <view class="benefit-hero">
          <view class="benefit-hero-copy">
            <text class="benefit-kicker">三项免费权益</text>
            <view class="benefit-headline" aria-label="三个免费，装修更省心">
              <text>三个免费，</text>
              <text>装修更省心</text>
            </view>
            <text class="benefit-subline">专业团队陪伴，全程为你服务</text>
            <view
              class="guide-inline-entry"
              bindtap="openCustomerGuide"
              aria-role="button"
              aria-label="点击我带你看看装修服务向导"
            >
              <text>点击我带你看看</text>
              <view class="guide-entry-chevron guide-inline-chevron" aria-hidden="true"></view>
            </view>
          </view>
          <view class="guide-entry" bindtap="openCustomerGuide" aria-role="button" aria-label="打开装修服务向导">
            <view class="guide-entry-bubble">
              <text class="guide-entry-name">我是小K</text>
              <text class="guide-entry-copy">想了解服务？</text>
              <view class="guide-entry-action">
                <text>点击我带你看看</text>
                <view class="guide-entry-chevron" aria-hidden="true"></view>
              </view>
            </view>
            <image class="benefit-guide" src="{{xiaoKImage}}" mode="aspectFit" />
          </view>

          <view class="service-ticket">
            <view class="ticket-main-row {{showFloorPlanThumb || showSchemeThumb ? 'has-media' : 'no-media'}}">
              <view wx:if="{{showFloorPlanThumb || showSchemeThumb}}" class="ticket-media {{mediaMode}}">
                <image
                  wx:if="{{showFloorPlanThumb}}"
                  class="ticket-thumb floor-plan"
                  src="{{floorPlanImagePath}}"
                  mode="aspectFill"
                />
                <image
                  wx:if="{{showSchemeThumb}}"
                  class="ticket-thumb scheme"
                  src="{{schemeImagePath}}"
                  mode="aspectFill"
                />
              </view>
              <view class="ticket-status">
                <view class="ticket-copy">
                  <text class="ticket-title">{{insetTitle}}</text>
                  <text wx:if="{{subtitle}}" class="ticket-summary">{{subtitle}}</text>
                  <text wx:if="{{insetHelper && !subtitle}}" class="ticket-helper">{{insetHelper}}</text>
                </view>
                <view class="progress-track">
                  <view
                    wx:for="{{progressPills}}"
                    wx:key="key"
                    class="progress-step tone-{{item.tone}}"
                  >
                    <view class="progress-node" aria-hidden="true">
                      <view class="progress-node-mark"></view>
                    </view>
                    <text class="progress-label">{{item.label}}</text>
                  </view>
                </view>
              </view>
            </view>

            <view wx:if="{{!isTerminated}}" class="ticket-actions {{showSecondaryCta ? 'dual' : 'single'}}">
              <view
                class="ticket-cta primary {{nextActionKind === 'wait_designer' ? 'weak' : ''}}"
                bindtap="onPrimaryCta"
                hover-class="btn-pressed"
              >
                <text>{{primaryCta.label}}</text>
              </view>
              <view
                wx:if="{{showSecondaryCta}}"
                class="ticket-cta secondary"
                bindtap="onSecondaryCta"
                hover-class="btn-pressed"
                aria-label="我的服务档案"
              >
                <text>我的服务档案</text>
              </view>
            </view>
            <view wx:if="{{isTerminated}}" class="termination-home-note"><text>本次推广服务记录已撤销，如需继续服务，请重新扫描有效服务码</text></view>
          </view>
        </view>

        <view wx:if="{{showSwitcher}}" class="switcher-strip" bindtap="openSwitcher" hover-class="card-pressed">
          <text class="switcher-copy">还有 {{switcherCount}} 个进行中的服务</text>
          <text class="switcher-action">切换</text>
        </view>

        <view wx:if="{{!isTerminated}}" class="benefit-stack">
          <view
            class="benefit-service-card effect-card"
            bindtap="openEffectShortcut"
            hover-class="card-pressed"
            aria-role="button"
            aria-label="免费效果图"
          >
            <view class="benefit-art-stage">
              <image class="benefit-service-art effect-art" src="/images/customer-service-three-free/effect-room.jpg" mode="aspectFill" />
            </view>
            <view class="benefit-service-copy">
              <text class="benefit-service-title">免费效果图</text>
              <text class="benefit-service-desc">出到客户满意为止</text>
            </view>
            <view class="benefit-arrow" aria-hidden="true">
              <image class="benefit-arrow-icon" src="/images/customer-service-three-free/chevron-right.png" mode="aspectFit" />
            </view>
          </view>

          <view
            class="benefit-service-card design-advisor-card"
            bindtap="openDesignerShortcut"
            hover-class="card-pressed"
            aria-role="button"
            aria-label="免费家装设计顾问"
          >
            <view class="benefit-art-stage">
              <image class="benefit-service-art advisor-art" src="/images/customer-service-three-free/design-advisor-3d.png" mode="aspectFit" />
            </view>
            <view class="benefit-service-copy">
              <text class="benefit-service-title">免费家装设计顾问</text>
              <text class="benefit-service-desc">解答你的装修问题</text>
            </view>
            <view class="benefit-arrow" aria-hidden="true">
              <image class="benefit-arrow-icon" src="/images/customer-service-three-free/chevron-right.png" mode="aspectFit" />
            </view>
          </view>

          <view
            class="benefit-service-card onsite-advisor-card"
            bindtap="openBookShortcut"
            hover-class="card-pressed"
            aria-role="button"
            aria-label="免费家装现场顾问"
          >
            <view class="benefit-art-stage">
              <image class="benefit-service-art onsite-art" src="/images/customer-service-three-free/onsite-advisor-3d.png" mode="aspectFit" />
            </view>
            <view class="benefit-service-copy">
              <text class="benefit-service-title">免费家装现场顾问</text>
              <text class="benefit-service-desc">解答现场问题</text>
            </view>
            <view class="benefit-arrow" aria-hidden="true">
              <image class="benefit-arrow-icon" src="/images/customer-service-three-free/chevron-right.png" mode="aspectFit" />
            </view>
          </view>
        </view>

        <view class="benefit-assurance">
          <view class="assurance-check" aria-hidden="true"></view>
          <text class="assurance-benefit">三项服务不收费</text>
          <view class="assurance-divider"></view>
          <text class="assurance-status">{{benefitStatusLabel}}</text>
        </view>
      </block>
    </view>
  </scroll-view>

  <view wx:if="{{showSwitcherSheet}}" class="switcher-mask" bindtap="closeSwitcher">
    <view class="switcher-sheet" catchtap="noop">
      <view class="switcher-sheet-head">
        <text class="switcher-sheet-title">切换进行中的服务</text>
        <text class="switcher-sheet-close" bindtap="closeSwitcher">关闭</text>
      </view>
      <scroll-view scroll-y class="switcher-sheet-list">
        <view
          wx:for="{{switcherProjects}}"
          wx:key="leadId"
          class="switcher-row {{item.leadId === leadId ? 'active' : ''}}"
          data-lead-id="{{item.leadId}}"
          bindtap="selectSwitcherProject"
        >
          <view class="switcher-row-text">
            <text class="switcher-row-title">{{item.switcherTitle}}</text>
            <text class="switcher-row-summary">{{item.appointmentSummary || '服务进行中'}}</text>
            <text class="switcher-row-meta">{{item.updatedLabel}}</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <designer-contact-sheet
    visible="{{showContactSheet}}"
    designer="{{designer}}"
    bind:close="closeContactSheet"
  />
</view>
