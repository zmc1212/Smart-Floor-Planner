.modal-overlay {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(31, 41, 55, 0.32);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-container {
  width: 620rpx;
  background: var(--bg-surface);
  border-radius: var(--radius-xl);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: var(--shadow-popup);
}

.modal-header {
  padding: var(--space-section);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.title {
  font-size: 34rpx;
  font-weight: var(--font-weight-bold);
  color: var(--text-primary);
}

.close-btn {
  font-size: 36rpx;
  color: var(--text-secondary);
  line-height: 1;
  padding: 0 10rpx;
}

.modal-body {
  padding: 0 var(--space-section) var(--space-section);
}

.desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.5;
  margin-bottom: var(--space-section);
  display: block;
}

.form-group {
  margin-bottom: var(--space-xxl);
}

.label {
  font-size: var(--font-size-body);
  color: var(--text-primary);
  margin-bottom: var(--space-md);
  display: block;
  font-weight: var(--font-weight-medium);
}

.required {
  color: var(--status-converted-text);
  margin-left: var(--space-xs);
}

.input,
.picker-view {
  width: 100%;
  height: 84rpx;
  background: var(--neutral-100);
  border-radius: var(--radius-md);
  padding: 0 var(--space-xxl);
  font-size: var(--font-size-body);
  color: var(--text-primary);
  box-sizing: border-box;
}

.input-phone-group {
  display: flex;
  align-items: center;
  gap: var(--space-lg);
}

.phone-input {
  flex: 1;
}

.picker-view {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-view.placeholder,
.arrow {
  color: var(--text-secondary);
}

.modal-footer {
  padding: 0 var(--space-section) 40rpx;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--brand-primary);
  color: var(--text-inverse);
  font-size: 32rpx;
  font-weight: var(--font-weight-medium);
  border-radius: var(--radius-full);
  margin: 0;
  padding: 0;
}

.submit-btn::after {
  border: none;
}

.privacy-note {
  font-size: 22rpx;
  color: var(--text-secondary);
  text-align: center;
  margin-top: var(--space-lg);
}

.quick-select-section {
  margin-bottom: var(--space-section);
  background: var(--bg-surface-soft);
  padding: var(--space-lg);
  border-radius: var(--radius-md);
}

.quick-select-title {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-bottom: var(--space-md);
  display: block;
}

.quick-select-list {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
}

.quick-select-item {
  display: inline-block;
  background: var(--bg-surface);
  color: var(--text-brand);
  padding: 12rpx 20rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-size-caption);
  margin-right: var(--space-lg);
}
