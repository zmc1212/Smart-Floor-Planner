.poster-mask {
  position: fixed;
  inset: 0;
  background: rgba(31, 41, 55, 0.32);
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.poster-panel,
.poster-container {
  background: var(--bg-surface);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-popup);
}

.poster-panel {
  width: 650rpx;
  overflow: hidden;
}

.poster-header,
.poster-actions {
  padding: var(--space-section);
}

.poster-title {
  font-size: 32rpx;
  font-weight: var(--font-weight-bold);
  color: var(--text-primary);
}

.poster-subtitle,
.poster-desc {
  font-size: var(--font-size-caption);
  color: var(--text-secondary);
}

.poster-container {
  margin: 0 var(--space-section);
  padding: var(--space-section);
  background: linear-gradient(180deg, var(--bg-surface) 0%, var(--brand-primary-20) 100%);
}

.poster-cover {
  width: 100%;
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.poster-actions {
  display: flex;
  gap: var(--space-lg);
}

.poster-btn,
.save-btn,
.close-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
  margin: 0;
}

.save-btn,
.poster-btn.primary {
  background: var(--brand-primary);
  color: var(--text-inverse);
}

.close-btn,
.poster-btn.secondary {
  background: var(--bg-surface);
  color: var(--text-brand);
  box-shadow: inset 0 0 0 1rpx var(--border-brand);
}

.save-btn::after,
.close-btn::after,
.poster-btn::after {
  border: none;
}
