.nav-bar {
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 8rpx 24rpx rgba(85, 104, 90, 0.05);
  backdrop-filter: blur(16px);
  z-index: 20;
}

.nav-bar-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 40rpx;
  box-sizing: border-box;
}

.nav-left,
.nav-right,
.action-group {
  display: flex;
  align-items: center;
}

.nav-left {
  gap: var(--space-lg);
}

.nav-right,
.action-group {
  gap: var(--space-md);
}

.logo-box {
  width: 52rpx;
  height: 52rpx;
  background: linear-gradient(135deg, #0fb04d 0%, #18a94b 100%);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 20rpx rgba(17, 164, 66, 0.18);
}

.logo-icon {
  font-size: 24rpx;
  color: var(--text-inverse);
  font-weight: var(--font-weight-bold);
}

.logo-text {
  display: flex;
  flex-direction: column;
}

.app-title {
  font-size: 28rpx;
  font-weight: var(--font-weight-bold);
  color: var(--text-primary);
  line-height: 1;
}

.app-subtitle {
  font-size: 11rpx;
  color: var(--text-secondary);
  letter-spacing: 1rpx;
  font-weight: var(--font-weight-medium);
  margin-top: var(--space-xs);
  text-transform: uppercase;
}

.ble-status-icon,
.action-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 0 0 1rpx rgba(209, 213, 219, 0.45);
  color: var(--text-secondary);
}

.ble-status-icon.connected {
  background: var(--brand-primary-20);
  color: var(--text-brand);
}

.action-btn {
  font-size: 26rpx;
  transition: all 0.15s ease;
}

.action-btn:active {
  opacity: 0.88;
  transform: translateY(1rpx);
}

.action-btn.disabled {
  opacity: 0.28;
  pointer-events: none;
}

.nav-divider {
  width: 1rpx;
  height: 32rpx;
  background: var(--neutral-100);
  margin: 0 var(--space-sm);
}

.btn-export {
  padding: 10rpx 22rpx;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-medium);
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, #0fb04d 0%, #18a94b 100%);
  color: var(--text-inverse);
}
