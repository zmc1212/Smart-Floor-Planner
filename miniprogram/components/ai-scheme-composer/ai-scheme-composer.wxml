<view class="composer-root">
  <view class="composer-shell dock {{dockExpanded ? 'expanded' : 'collapsed'}} {{keyboardHeight > 0 ? 'keyboard-open' : ''}} {{timelineMode ? 'timeline' : ''}}" catchtap="toggleDock">
    <view wx:if="{{timelineMode}}" class="timeline-dock-handle" catchtap="toggleDock" aria-role="button" aria-label="展开或收起创作参数">
      <image src="/images/ai-studio-icons-v3/chevron-down.png" mode="aspectFit"></image>
    </view>

    <view wx:if="{{view && !timelineMode}}" class="credit-bar">
      <block wx:if="{{timelineMode}}">
        <image class="credit-info" src="/images/ai-studio-icons-v3/info.png" mode="aspectFit"></image>
        <text>{{view.timelineCreditLabel}}</text>
        <image class="credit-chevron" src="/images/ai-studio-icons-v3/chevron-right.png" mode="aspectFit"></image>
      </block>
      <text wx:else>{{view.creditSummary}}</text>
    </view>
    <view wx:elif="{{!timelineMode}}" class="credit-bar muted">加载模型与点数配置中</view>

    <view wx:if="{{view && !view.modeConfirmed && !timelineMode}}" class="start-round" catchtap="openModePicker" aria-role="button" aria-label="开始新一轮设计">
      <view class="start-round-copy">
        <text class="start-round-title">开始新一轮设计</text>
        <text class="start-round-meta">先选整屋或单间，再安排参考图</text>
      </view>
      <view class="start-round-action">选择方式</view>
    </view>

    <view wx:if="{{dockExpanded && view && (view.modeConfirmed || timelineMode)}}" class="dock-expanded" catchtap="noop">
      <view class="mode-intent-banner">
        <image class="mode-intent-art" src="{{view.modeArtwork}}" mode="aspectFit"></image>
        <view class="mode-intent-copy">
          <text class="mode-intent-title">{{view.modeTitle}}</text>
          <text class="mode-intent-meta">{{view.modeCopy}}</text>
        </view>
        <view class="mode-intent-change" bindtap="openModePicker">更换方式</view>
      </view>

      <view wx:if="{{view.showRenovationType}}" class="renovation-switch">
        <text class="renovation-label">改造类型</text>
        <view class="renovation-options">
          <view class="renovation-option {{view.fullRoomActive ? 'active' : ''}}" data-mode="single_room_photo" bindtap="selectRenovationType">全空间设计</view>
          <view class="renovation-option {{view.softFurnishingActive ? 'active' : ''}}" data-mode="soft_furnishing" bindtap="selectRenovationType">仅软装换搭</view>
        </view>
      </view>

      <view wx:if="{{view && (view.hasControlPreview || view.hasReferences || view.canAddReference)}}" class="reference-row">
        <view
          wx:if="{{view.hasControlPreview}}"
          class="reference-item compact locked"
          bindtap="previewControl"
        >
          <image
            wx:if="{{view.controlPreviewUrl}}"
            class="reference-image"
            src="{{view.controlPreviewUrl}}"
            mode="aspectFill"
          ></image>
          <view wx:else class="reference-image placeholder"></view>
          <text class="control-badge">控制图</text>
        </view>
        <view
          wx:if="{{view.canAddReference}}"
          class="reference-add compact {{uploading ? 'disabled' : ''}}"
          bindtap="uploadReference"
        >
          <text class="reference-add-icon">+</text>
        </view>
        <scroll-view wx:if="{{view.hasReferences}}" scroll-x enhanced show-scrollbar="{{false}}" class="reference-scroll">
          <view class="reference-track">
            <view wx:for="{{view.referenceAssets}}" wx:key="id" class="reference-item compact">
              <image wx:if="{{item.previewUrl}}" class="reference-image" src="{{item.previewUrl}}" mode="aspectFill"></image>
              <view wx:else class="reference-image placeholder"></view>
              <text class="site-photo-badge">{{item.role === 'site_photo' ? '现场图' : '基准图'}}</text>
              <view class="reference-remove" data-id="{{item.id}}" catchtap="removeReference">×</view>
            </view>
          </view>
        </scroll-view>
        <text wx:if="{{!view.hasControlPreview && !view.hasReferences && !view.canAddReference}}" class="reference-hint">当前模型不支持参考图</text>
      </view>
    </view>

    <view wx:if="{{timelineMode && dockExpanded && view && !view.hasTemplate}}" class="timeline-compose-heading" catchtap="noop">
      <text>手动创作</text>
      <view bindtap="openTemplates" aria-role="button">选择模板</view>
    </view>

    <view wx:if="{{timelineMode && !dockExpanded && view && view.hasTemplate}}" class="template-collapsed-row" catchtap="enterTemplateFullEdit">
      <image wx:if="{{draft.templatePreviewUrl}}" class="template-collapsed-cover" src="{{draft.templatePreviewUrl}}" mode="aspectFill"></image>
      <view wx:else class="template-collapsed-cover placeholder"><text>模板</text></view>
      <view class="template-collapsed-copy">
        <text class="template-collapsed-name">{{draft.templateName || view.templateName}}</text>
        <text class="template-collapsed-meta">模板底稿 · 可编辑</text>
      </view>
      <view class="template-collapsed-adjust">编辑</view>
      <view class="timeline-control {{view.timelineControlUrl ? '' : 'empty'}}" catchtap="openTimelineControl">
        <image wx:if="{{view.timelineControlUrl}}" src="{{view.timelineControlUrl}}" mode="aspectFill"></image>
        <text>{{view.timelineControlLabel}}</text>
        <image class="timeline-control-chevron" src="/images/ai-studio-icons-v3/chevron-down.png" mode="aspectFit"></image>
      </view>
      <view class="generate-fab compact {{!view.canSubmit ? 'blocked' : ''}}" catchtap="submitGeneration">
        <image class="generate-fab-spark" src="/images/ai-studio-icons-v3/generate-white.png" mode="aspectFit"></image>
      </view>
    </view>

    <view wx:if="{{timelineMode && dockExpanded && view && view.hasTemplate}}" class="template-full-edit-panel" catchtap="noop">
      <view class="template-edit-head">
        <image wx:if="{{draft.templatePreviewUrl}}" src="{{draft.templatePreviewUrl}}" mode="aspectFill"></image>
        <view wx:else class="template-edit-cover placeholder"><text>模板</text></view>
        <view class="template-edit-title-wrap">
          <text class="template-edit-title">{{draft.templateName || view.templateName}}</text>
          <text class="template-edit-badge">模板底稿</text>
        </view>
        <view class="template-edit-change" bindtap="returnToTemplateSummary">收起</view>
      </view>
      <view class="template-adjustment-label">完整提示词 <text>ⓘ</text></view>
      <text class="template-adjustment-copy">可逐字修改，保存后仍保留模板来源</text>
      <view class="template-full-field">
        <textarea
          class="template-full-input"
          value="{{draft.prompt}}"
          maxlength="2000"
          bindinput="onPromptInput"
          bindblur="onTemplateFullEditBlur"
          auto-height="true"
          show-confirm-bar="{{false}}"
          adjust-position="{{false}}"
        ></textarea>
        <text class="template-adjustment-count">{{draft.prompt.length || 0}}/2000</text>
      </view>
      <view class="template-full-footer">
        <view class="template-source-line"><image src="/images/ai-studio-icons-v3/check-white.png" mode="aspectFit"></image><text>源自模板：{{draft.templateName || view.templateName}}</text></view>
        <view class="template-restore" bindtap="restoreSelectedTemplate">恢复模板</view>
      </view>
    </view>

    <view wx:if="{{timelineMode && !dockExpanded && view && !view.modeConfirmed && !view.hasTemplate}}" class="timeline-start-round" catchtap="openModePicker" aria-role="button" aria-label="开始新一轮设计">
      <image src="/images/ai-studio-icons-v3/generate-white.png" mode="aspectFit"></image>
      <text>开始新一轮设计</text>
    </view>

    <view wx:if="{{!view || (!timelineMode && view.modeConfirmed) || (timelineMode && !draft.templateId && view && view.modeConfirmed)}}" class="prompt-row">
      <view wx:if="{{!timelineMode || (view && view.modeConfirmed)}}" class="prompt-field">
        <textarea
          class="prompt-input"
          value="{{draft.prompt}}"
          maxlength="2000"
          placeholder="{{timelineMode ? '补充本轮设计要求…' : (view && view.renderMode === 'whole_floor_plan' ? '补充整屋设计要求…' : '补充这个房间的设计要求…')}}"
          focus="{{promptFocused}}"
          bindinput="onPromptInput"
          bindfocus="onPromptFocus"
          bindblur="onPromptBlur"
          auto-height="{{dockExpanded && keyboardHeight <= 0}}"
          show-confirm-bar="{{false}}"
          disabled="{{!view}}"
          adjust-position="{{false}}"
          hold-keyboard="{{false}}"
        ></textarea>
      </view>
      <view wx:if="{{timelineMode && view && view.modeConfirmed}}" class="timeline-control {{view.timelineControlUrl ? '' : 'empty'}}" bindtap="openTimelineControl">
        <image wx:if="{{view.timelineControlUrl}}" src="{{view.timelineControlUrl}}" mode="aspectFill"></image>
        <text>{{view.timelineControlLabel}}</text>
        <image class="timeline-control-chevron" src="/images/ai-studio-icons-v3/chevron-down.png" mode="aspectFit"></image>
      </view>
      <view
        wx:if="{{!dockExpanded && (!timelineMode || (view && view.modeConfirmed))}}"
        class="generate-fab compact {{!view || !view.canSubmit ? 'blocked' : ''}}"
        catchtap="submitGeneration"
      >
        <image class="generate-fab-spark" src="/images/ai-studio-icons-v3/generate-white.png" mode="aspectFit"></image>
      </view>
    </view>

    <view wx:if="{{timelineMode && !dockExpanded && view && view.modeConfirmed}}" class="timeline-expand-hint" catchtap="expandDock">
      <text>展开参数</text>
      <image src="/images/ai-studio-icons-v3/chevron-down.png" mode="aspectFit"></image>
    </view>

    <view wx:if="{{dockExpanded && view && (view.modeConfirmed || timelineMode)}}" class="dock-toolbar" catchtap="noop">
      <view class="dock-toolbar-actions">
        <view
          wx:for="{{view.toolbarItems}}"
          wx:key="key"
          class="dock-tool"
          data-key="{{item.key}}"
          catchtap="onToolbarTap"
        >
          <image class="dock-tool-icon" src="{{item.icon}}" mode="aspectFit"></image>
          <text class="dock-tool-label">{{item.label}}</text>
        </view>
      </view>
      <view
        class="generate-fab {{!view || !view.canSubmit ? 'blocked' : ''}}"
        catchtap="submitGeneration"
      >
        <image class="generate-fab-spark" src="/images/ai-studio-icons-v3/generate-white.png" mode="aspectFit"></image>
        <text class="generate-fab-label">{{generating ? '提交' : '生成'}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{modePickerMounted}}" class="sheet-root mode-picker-layer">
    <view class="sheet-mask {{modePickerVisible ? 'open' : ''}}" catchtap="closeModePicker"></view>
    <view class="sheet-panel mode-picker-panel {{modePickerVisible ? 'open' : ''}}" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="mode-picker-heading">
        <text class="mode-picker-title">准备新一轮</text>
        <text class="mode-picker-copy">先定目标，系统会自动匹配输入依据</text>
      </view>
      <view class="setup-label">
        <view class="setup-label-main"><text class="setup-step-number">1</text><text class="setup-label-title">设计目标</text></view>
      </view>
      <view class="mode-choice-grid">
        <view class="mode-choice {{pendingRenderMode === 'whole_floor_plan' ? 'active' : ''}}" data-mode="whole_floor_plan" bindtap="selectRenderMode">
          <view class="mode-choice-select"><image src="/images/ai-studio-icons-v3/check-white.png" mode="aspectFit"></image></view>
          <image class="mode-choice-art whole" src="/images/ai-design/round-setup-v3/whole-floor-plan.png" mode="aspectFit"></image>
          <view class="mode-choice-copy">
            <text class="mode-choice-title">设计整屋</text>
            <text class="mode-choice-meta">正式户型负责结构</text>
          </view>
        </view>
        <view class="mode-choice {{pendingRenderMode === 'single_room_photo' ? 'active' : ''}}" data-mode="single_room_photo" bindtap="selectRenderMode">
          <view class="mode-choice-select"><image src="/images/ai-studio-icons-v3/check-white.png" mode="aspectFit"></image></view>
          <image class="mode-choice-art single" src="/images/ai-design/round-setup-v3/single-room-reference.png" mode="aspectFit"></image>
          <view class="mode-choice-copy">
            <text class="mode-choice-title">设计单间</text>
            <text class="mode-choice-meta">现场照片负责镜头</text>
          </view>
        </view>
      </view>
      <view wx:if="{{view && view.wholeHouseAvailable}}" class="setup-label setup-label-secondary">
        <view class="setup-label-main"><text class="setup-step-number">2</text><text class="setup-label-title">输入依据</text></view>
      </view>
      <view wx:if="{{view && view.wholeHouseAvailable}}" class="setup-basis-row">
        <view class="setup-basis-icon"><image src="/images/ai-design-icons/floor-plan.png" mode="aspectFit"></image></view>
        <view><text>正式户型与结构</text><text>系统已安排</text></view>
        <view wx:if="{{view.canAddReference}}" class="setup-basis-change" bindtap="uploadReference"><text>更换输入依据</text><image src="/images/ai-studio-icons-v3/chevron-right.png" mode="aspectFit"></image></view>
        <text wx:else class="setup-basis-status">系统安排</text>
      </view>
      <view wx:if="{{draft.templateName}}" class="setup-label setup-label-secondary">
        <view class="setup-label-main"><text class="setup-step-number">3</text><text class="setup-label-title">装修配方</text><text class="setup-optional">可选</text></view>
      </view>
      <view wx:if="{{draft.templateName}}" class="setup-recipe-row">
        <image src="/images/ai-design/unified-entry-v1/recipe-modern-minimal.jpg" mode="aspectFill"></image>
        <view><text>{{draft.templateName}}</text></view>
        <view class="setup-recipe-change" bindtap="openTemplates"><text>更换</text><image src="/images/ai-studio-icons-v3/chevron-right.png" mode="aspectFit"></image></view>
      </view>
      <view class="mode-picker-footnote"><image src="/images/ai-studio-icons-v3/info.png" mode="aspectFit"></image><text>切换为设计单间后，系统会改为要求现场照片</text></view>
      <view class="mode-picker-primary" bindtap="confirmRenderMode"><image src="/images/ai-studio-icons-v3/generate-white.png" mode="aspectFit"></image><text>进入创作</text></view>
    </view>
  </view>

  <view wx:if="{{settingsMounted}}" class="sheet-root settings-layer">
    <view class="sheet-mask {{settingsOpen ? 'open' : ''}}" catchtap="closeSettings"></view>
    <view class="sheet-panel tall settings-panel {{settingsOpen ? 'open' : ''}}" catchtap="noop">
      <view class="sheet-head">
        <text class="sheet-title">创作设置</text>
        <view class="sheet-close" bindtap="closeSettings">×</view>
      </view>
      <scroll-view wx:if="{{view}}" scroll-y class="settings-scroll">
        <view wx:if="{{view.hasScopePicker}}" class="settings-list">
          <view class="settings-row" data-type="scope" bindtap="openPicker">
            <text class="settings-row-title">应用到哪里</text>
            <text class="settings-row-value">{{view.scopeLabel || '完整户型'}}</text>
            <view class="settings-row-chevron"></view>
          </view>
        </view>
        <text wx:if="{{view.hasScopePicker}}" class="settings-note">{{view.scopeNote}}</text>
        <view class="settings-section">
          <text class="settings-label">比例</text>
          <view class="settings-chips">
            <view
              wx:for="{{view.aspectOptions}}"
              wx:key="value"
              class="settings-chip {{item.active ? 'active' : ''}}"
              data-field="aspectRatio"
              data-value="{{item.value}}"
              bindtap="selectSettingChip"
            >{{item.label}}</view>
          </view>
        </view>
        <view class="settings-section">
          <text class="settings-label">出图张数</text>
          <view class="settings-chips">
            <view
              wx:for="{{view.countOptions}}"
              wx:key="value"
              class="settings-chip {{item.active ? 'active' : ''}}"
              data-field="count"
              data-value="{{item.value}}"
              bindtap="selectSettingChip"
            >{{item.label}}</view>
          </view>
        </view>
        <view class="settings-section">
          <text class="settings-label">分辨率</text>
          <view class="settings-chips">
            <view
              wx:for="{{view.resolutionOptions}}"
              wx:key="value"
              class="settings-chip {{item.active ? 'active' : ''}}"
              data-field="resolutionTier"
              data-value="{{item.value}}"
              bindtap="selectSettingChip"
            >{{item.label}}</view>
          </view>
        </view>

        <view class="settings-list">
          <view class="settings-row" data-type="model" bindtap="openPicker">
            <text class="settings-row-title">模型</text>
            <text class="settings-row-value">{{view.modelLabel || '选择模型'}}</text>
            <view class="settings-row-chevron"></view>
          </view>
          <view class="settings-row" bindtap="openTemplates">
            <text class="settings-row-title">提示词模板</text>
            <text class="settings-row-value">{{draft.templateName || '未选择'}}</text>
            <view class="settings-row-chevron"></view>
          </view>
          <view class="settings-row {{assisting ? 'disabled' : ''}}" bindtap="assistPrompt">
            <text class="settings-row-title">提示词优化</text>
            <text class="settings-row-value">{{assisting ? '优化中…' : '一键优化'}}</text>
            <view class="settings-row-chevron"></view>
          </view>
        </view>

        <view class="settings-credit">{{view.creditSummary}}</view>
      </scroll-view>
      <view class="settings-footer">
        <view class="settings-apply" bindtap="applySettings">应用并继续编辑</view>
      </view>
    </view>
  </view>

  <view wx:if="{{pickerMounted}}" class="sheet-root picker-layer">
    <view class="sheet-mask {{pickerVisible ? 'open' : ''}}" catchtap="closePicker"></view>
    <view class="sheet-panel picker-panel {{pickerVisible ? 'open' : ''}}" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-head">
        <text class="sheet-title">{{pickerTitle}}</text>
        <view class="sheet-close" bindtap="closePicker">×</view>
      </view>
      <scroll-view scroll-y class="sheet-scroll">
        <view
          wx:for="{{pickerOptions}}"
          wx:key="value"
          class="sheet-option {{item.active ? 'active' : ''}}"
          data-value="{{item.value}}"
          bindtap="selectPickerOption"
        >
          <image wx:if="{{item.icon}}" class="sheet-option-icon" src="{{item.icon}}" mode="aspectFit"></image>
          <view class="sheet-option-copy">
            <text class="sheet-option-title">{{item.label}}</text>
            <text wx:if="{{item.subtitle}}" class="sheet-option-subtitle">{{item.subtitle}}</text>
          </view>
          <text wx:if="{{item.active}}" class="sheet-check">✓</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{templateSheetMounted}}" class="sheet-root template-layer">
    <view class="sheet-mask {{templateSheetOpen ? 'open' : ''}}" catchtap="closeTemplates"></view>
    <view class="sheet-panel tall {{templateSheetOpen ? 'open' : ''}}" catchtap="noop">
      <view class="sheet-head">
        <text class="sheet-title">选择模板</text>
        <view class="sheet-close" bindtap="closeTemplates">×</view>
      </view>

      <view class="template-filters">
        <view class="template-search">
          <input
            class="template-search-input"
            value="{{templateQuery}}"
            placeholder="搜索风格、空间或模板"
            confirm-type="search"
            bindinput="onTemplateQueryInput"
            bindconfirm="onTemplateQueryConfirm"
          />
          <view wx:if="{{templateQuery}}" class="template-search-clear" bindtap="clearTemplateQuery">清除</view>
        </view>
        <scroll-view wx:if="{{templateCategoryChips.length}}" scroll-x enhanced show-scrollbar="{{false}}" class="template-category-scroll">
          <view class="template-category-track">
            <view
              wx:for="{{templateCategoryChips}}"
              wx:key="id"
              class="template-category-chip {{item.active ? 'active' : ''}}"
              data-id="{{item.id}}"
              bindtap="selectTemplateCategory"
            >{{item.name}}</view>
          </view>
        </scroll-view>
      </view>

      <view wx:if="{{templateLoading && !templates.length}}" class="sheet-loading">正在加载模板...</view>
      <scroll-view wx:else scroll-y class="sheet-scroll template-sheet-scroll" bindscrolltolower="loadMoreTemplates">
        <view wx:if="{{!templates.length}}" class="sheet-empty">{{templateQuery ? '没有匹配的模板' : '暂无可用模板'}}</view>
        <view wx:else class="template-grid">
          <view
            wx:for="{{templates}}"
            wx:key="id"
            class="template-card {{draft.templateId === item.id ? 'selected' : ''}}"
          >
            <view
              class="template-cover"
              data-id="{{item.id}}"
              catchtap="previewTemplateImage"
            >
              <image
                wx:if="{{item.previewUrl && !item.previewFailed}}"
                class="template-cover-image"
                src="{{item.previewUrl}}"
                mode="aspectFill"
                data-id="{{item.id}}"
                binderror="onTemplateImageError"
              ></image>
              <view wx:else class="template-cover-placeholder">
                <text>模板</text>
              </view>
              <view wx:if="{{item.previewUrl && !item.previewFailed}}" class="template-zoom-hint">查看大图</view>
            </view>
            <text class="template-name">{{item.name}}</text>
            <view class="template-use" data-id="{{item.id}}" bindtap="selectTemplate">使用此模板</view>
          </view>
        </view>
        <view wx:if="{{templateHasMore}}" class="template-load-more {{templateLoadingMore ? 'disabled' : ''}}" bindtap="loadMoreTemplates">
          {{templateLoadingMore ? '加载中...' : '加载更多'}}
        </view>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{templatePreviewVisible}}" class="template-preview-mask" catchtap="closeTemplatePreview">
    <view class="template-preview-panel" catchtap="noop">
      <view class="template-preview-head">
        <text class="template-preview-title">{{templatePreview.name || '模板预览'}}</text>
        <view class="sheet-close" bindtap="closeTemplatePreview">×</view>
      </view>
      <view class="template-preview-body">
        <image
          wx:if="{{templatePreview.previewUrl}}"
          class="template-preview-image"
          src="{{templatePreview.previewUrl}}"
          mode="aspectFit"
          bindtap="openNativeTemplatePreview"
        ></image>
        <view wx:else class="sheet-empty">暂无预览图</view>
      </view>
      <view class="template-preview-actions">
        <view class="template-preview-secondary" bindtap="closeTemplatePreview">关闭</view>
        <view class="template-preview-primary" data-id="{{templatePreview.id}}" bindtap="selectTemplate">使用此模板</view>
      </view>
    </view>
  </view>
</view>
