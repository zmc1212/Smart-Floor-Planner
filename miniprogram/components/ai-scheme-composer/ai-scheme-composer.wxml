<view class="composer-root">
  <view
    class="composer-dock-mask {{dockExpanded ? 'open' : ''}}"
    catchtap="toggleDock"
    aria-role="button"
    aria-label="收起创作面板"
  ></view>
  <view class="composer-shell dock composer-v4 {{dockExpanded ? 'expanded' : 'collapsed'}} {{keyboardHeight > 0 ? 'keyboard-open' : ''}}">
    <view class="composer-arc-handle" catchtap="toggleDock" aria-role="button" aria-label="{{dockExpanded ? '收起创作面板' : '展开创作面板'}}">
      <image src="/images/ai-studio-icons-v3/chevron-down.png" mode="aspectFit"></image>
    </view>

    <view wx:if="{{view && !view.modeConfirmed}}" class="composer-v4-surface composer-v4-empty" catchtap="noop">
      <view class="composer-empty-copy"><text>开始新一轮设计</text><text>先配置设计目标、提示词模板和参考图</text></view>
      <view class="composer-empty-action" bindtap="openModePicker">配置本轮</view>
    </view>

    <view wx:elif="{{view && !dockExpanded}}" class="composer-v4-surface composer-v4-collapsed" catchtap="noop">
      <view class="collapsed-entry-row">
        <view class="collapsed-config-entry" bindtap="openModePicker" aria-role="button" aria-label="打开本轮配置">
          <image wx:if="{{view.summaryPreviewUrl}}" class="collapsed-template-cover" src="{{view.summaryPreviewUrl}}" mode="aspectFill"></image>
          <view wx:else class="collapsed-template-cover placeholder"><image src="/images/ai-studio-icons-v3/template.png" mode="aspectFit"></image></view>
          <view class="collapsed-summary-copy"><text class="collapsed-summary-title">{{view.templateDisplayName}}</text><text class="collapsed-summary-meta">{{view.modeTitle}} · 参考图 {{view.referenceDisplayCount}}张</text></view>
          <view class="collapsed-adjust" catchtap="openModePicker">调整 <image src="/images/ai-studio-icons-v3/chevron-right.png" mode="aspectFit"></image></view>
        </view>
        <view class="collapsed-generate {{!view.canSubmit ? 'blocked' : ''}}" catchtap="submitGeneration"><text>{{generating ? '提交中' : '生成'}}</text></view>
      </view>
    </view>

    <view wx:elif="{{view}}" class="composer-v4-surface composer-v4-expanded" catchtap="noop">
      <view class="composer-v4-heading"><text>本轮创作</text><view bindtap="collapseDock">收起</view></view>
      <view class="quick-config-grid">
        <view class="quick-config-card configured" bindtap="openModePicker"><image src="/images/ai-design/round-setup-v3/whole-floor-plan.png" mode="aspectFit"></image><text>{{view.modeTitle}}</text><image class="quick-config-chevron" src="/images/ai-studio-icons-v3/chevron-right.png" mode="aspectFit"></image></view>
        <view class="quick-config-card {{view.hasTemplate ? 'configured' : ''}}" bindtap="openModePicker"><image src="/images/ai-studio-icons-v3/template.png" mode="aspectFit"></image><text>{{view.templateDisplayName}}</text><image class="quick-config-chevron" src="/images/ai-studio-icons-v3/chevron-right.png" mode="aspectFit"></image></view>
        <view class="quick-config-card {{view.referenceDisplayCount > 0 ? 'configured' : ''}}" bindtap="openModePicker"><image src="/images/ai-studio-icons-v3/reference.png" mode="aspectFit"></image><text>参考图 {{view.referenceDisplayCount}}张</text><image class="quick-config-chevron" src="/images/ai-studio-icons-v3/chevron-right.png" mode="aspectFit"></image></view>
      </view>
      <view class="design-requirement-head">
        <view><text>设计要求</text><image src="/images/ai-studio-icons-v3/info.png" mode="aspectFit"></image></view>
        <view class="prompt-assist {{assisting ? 'disabled' : ''}}" bindtap="assistPrompt"><image src="/images/ai-studio-icons-v3/process-spark.png" mode="aspectFit"></image><text>{{assisting ? '优化中…' : 'AI 优化'}}</text></view>
      </view>
      <view class="expanded-prompt-field">
        <textarea class="expanded-prompt-input" value="{{draft.prompt}}" maxlength="2000" placeholder="补充本轮设计要求…" focus="{{promptFocused}}" bindinput="onPromptInput" bindfocus="onPromptFocus" bindblur="onPromptBlur" auto-height="false" show-confirm-bar="{{false}}" adjust-position="{{false}}" hold-keyboard="{{false}}"></textarea>
        <view class="expanded-prompt-count"><text>{{draft.prompt.length || 0}}/2000</text></view>
      </view>
      <view wx:if="{{view.hasTemplate}}" class="template-source-footer"><view><image src="/images/ai-studio-icons-v3/check-white.png" mode="aspectFit"></image><text>源自模板：{{view.templateDisplayName}}</text></view><view bindtap="restoreSelectedTemplate">恢复模板</view></view>
      <view wx:else class="template-source-footer manual"><text>当前为手动创作</text><view bindtap="openModePicker">选择模板</view></view>
      <view class="composer-cost-strip expanded"><text>{{view.advancedSummary}}</text><text>{{view.estimatedCreditLabel}}</text></view>
      <view class="expanded-generate {{!view.canSubmit ? 'blocked' : ''}}" catchtap="submitGeneration"><image src="/images/ai-studio-icons-v3/generate-white.png" mode="aspectFit"></image><text>{{generating ? '提交中' : '生成'}}</text></view>
    </view>
  </view>

  <view wx:if="{{modePickerMounted}}" class="sheet-root mode-picker-layer">
    <view class="sheet-mask {{modePickerVisible ? 'open' : ''}}" catchtap="closeModePicker"></view>
    <view class="sheet-panel mode-picker-panel config-sheet {{modePickerVisible ? 'open' : ''}}" catchtap="noop">
      <view class="config-arc-handle"></view>
      <scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="config-sheet-surface">
        <view class="config-heading"><text class="config-title">本轮配置</text><text class="config-subtitle">随时调整本轮设计内容</text></view>
        <view class="config-section-label"><text>1</text><view>设计目标</view></view>
        <view class="config-goal-grid">
          <view class="config-goal-card {{pendingRenderMode === 'whole_floor_plan' ? 'active' : ''}}" data-mode="whole_floor_plan" bindtap="selectRenderMode"><view class="config-check"><image src="/images/ai-studio-icons-v3/check-white.png" mode="aspectFit"></image></view><image src="/images/ai-design/round-setup-v3/whole-floor-plan.png" mode="aspectFit"></image><text>设计整屋</text></view>
          <view class="config-goal-card {{pendingRenderMode !== 'whole_floor_plan' ? 'active' : ''}}" data-mode="single_room_photo" bindtap="selectRenderMode"><view class="config-check"><image src="/images/ai-studio-icons-v3/check-white.png" mode="aspectFit"></image></view><image class="single" src="/images/ai-design/round-setup-v3/single-room-reference.png" mode="aspectFit"></image><text>设计单间</text></view>
        </view>
        <view wx:if="{{pendingRenderMode === 'whole_floor_plan' && view.wholeHouseAvailable}}" class="config-linked-row" bindtap="openScopePicker"><image src="/images/ai-design-icons/floor-plan.png" mode="aspectFit"></image><text>正式户型 · {{view.scopeLabel}}</text><view>更换 <image src="/images/ai-studio-icons-v3/chevron-right.png" mode="aspectFit"></image></view></view>
        <view wx:elif="{{pendingRenderMode !== 'whole_floor_plan' && view.hasScopePicker}}" class="config-linked-row" bindtap="openScopePicker"><image src="/images/ai-studio-icons-v3/floor-plan.png" mode="aspectFit"></image><text>设计空间 · {{view.scopeLabel}}</text><view>选择 <image src="/images/ai-studio-icons-v3/chevron-right.png" mode="aspectFit"></image></view></view>

        <view class="config-section-label"><text>2</text><view>提示词模板</view></view>
        <view class="config-template-row" bindtap="openTemplates">
          <image wx:if="{{draft.templatePreviewUrl}}" src="{{draft.templatePreviewUrl}}" mode="aspectFill"></image>
          <view wx:else class="config-template-placeholder"><image src="/images/ai-studio-icons-v3/template.png" mode="aspectFit"></image></view>
          <view class="config-template-copy"><text>{{view.templateDisplayName}}</text><text>{{view.hasTemplate ? '已应用到设计要求' : '可选择常用提示词模板'}}</text></view>
          <view class="config-template-change" catchtap="openTemplates">{{view.hasTemplate ? '更换' : '选择'}} <image src="/images/ai-studio-icons-v3/chevron-right.png" mode="aspectFit"></image></view>
          <view wx:if="{{view.hasTemplate}}" class="config-template-clear" catchtap="clearTemplate">清除</view>
        </view>

        <view class="config-section-label"><text>3</text><view>参考图</view></view>
        <view class="config-reference-grid">
          <view wx:if="{{pendingRenderMode === 'whole_floor_plan' && view.wholeHouseAvailable}}" class="config-reference-card locked" bindtap="previewFloorPlanReference"><image class="config-reference-image" src="{{floorPlanPreviewUrl}}" mode="aspectFill"></image><view class="reference-lock">锁</view><text>参考图1</text><text>户型图 · 结构参考</text></view>
          <view wx:for="{{view.referenceAssets}}" wx:key="id" wx:for-index="referenceIndex" class="config-reference-card" data-reference-index="{{referenceIndex}}" bindtap="previewReferenceImage" aria-role="button" aria-label="预览参考图">
            <image wx:if="{{item.previewUrl}}" class="config-reference-image" src="{{item.previewUrl}}" mode="aspectFill"></image>
            <view wx:else class="config-reference-image placeholder"><image src="/images/ai-studio-icons-v3/reference.png" mode="aspectFit"></image></view>
            <view class="reference-remove" data-id="{{item.id}}" catchtap="removeReference">×</view>
            <text>参考图{{pendingRenderMode === 'whole_floor_plan' && view.wholeHouseAvailable ? referenceIndex + 2 : referenceIndex + 1}}</text><text>{{item.role === 'site_photo' ? '现场图 · 镜头参考' : '基准图 · 风格参考'}}</text>
          </view>
          <view wx:if="{{pendingRenderMode === 'whole_floor_plan' ? view.canAddReference : view.singleModeCanAddReference}}" class="config-reference-add {{uploading ? 'disabled' : ''}}" bindtap="uploadReference"><image src="/images/ai-studio-icons-v3/add.png" mode="aspectFit"></image><text>{{uploading ? '上传中…' : '添加参考图'}}</text></view>
        </view>
        <text wx:if="{{pendingRenderMode !== 'whole_floor_plan' && !view.hasSitePhoto}}" class="config-reference-warning">设计单间需要至少添加一张现场图</text>
        <view class="config-more-row" bindtap="openSettings"><image src="/images/ai-studio-icons-v3/settings.png" mode="aspectFit"></image><text>更多设置</text><view>{{view.advancedSummary}} <image src="/images/ai-studio-icons-v3/chevron-down.png" mode="aspectFit"></image></view></view>
      </scroll-view>
      <view class="config-save" bindtap="confirmRenderMode"><image src="/images/ai-studio-icons-v3/generate-white.png" mode="aspectFit"></image><text>保存配置</text></view>
    </view>
  </view>

  <view wx:if="{{settingsMounted}}" class="sheet-root settings-layer">
    <view class="sheet-mask {{settingsOpen ? 'open' : ''}}" catchtap="closeSettings"></view>
    <view class="sheet-panel tall settings-panel {{settingsOpen ? 'open' : ''}}" catchtap="noop">
      <view class="sheet-head"><text class="sheet-title">更多设置</text><view class="sheet-close" bindtap="closeSettings">×</view></view>
      <scroll-view wx:if="{{view}}" scroll-y class="settings-scroll">
        <view wx:if="{{pendingRenderMode !== 'whole_floor_plan'}}" class="settings-section"><text class="settings-label">单间改造范围</text><view class="settings-chips"><view class="settings-chip {{pendingRenderMode === 'single_room_photo' ? 'active' : ''}}" data-mode="single_room_photo" bindtap="selectRenovationType">全空间设计</view><view class="settings-chip {{pendingRenderMode === 'soft_furnishing' ? 'active' : ''}}" data-mode="soft_furnishing" bindtap="selectRenovationType">仅软装换搭</view></view></view>
        <view class="settings-list"><view class="settings-row" data-type="model" bindtap="openPicker"><text class="settings-row-title">模型</text><text class="settings-row-value">{{view.modelLabel || '选择模型'}}</text><view class="settings-row-chevron"></view></view></view>
        <view class="settings-section"><text class="settings-label">比例</text><view class="settings-chips"><view wx:for="{{view.aspectOptions}}" wx:key="value" class="settings-chip {{item.active ? 'active' : ''}}" data-field="aspectRatio" data-value="{{item.value}}" bindtap="selectSettingChip">{{item.label}}</view></view></view>
        <view class="settings-section"><text class="settings-label">分辨率</text><view class="settings-chips"><view wx:for="{{view.resolutionOptions}}" wx:key="value" class="settings-chip {{item.active ? 'active' : ''}}" data-field="resolutionTier" data-value="{{item.value}}" bindtap="selectSettingChip">{{item.label}}</view></view></view>
        <view class="settings-section"><text class="settings-label">出图张数</text><view class="settings-chips"><view wx:for="{{view.countOptions}}" wx:key="value" class="settings-chip {{item.active ? 'active' : ''}}" data-field="count" data-value="{{item.value}}" bindtap="selectSettingChip">{{item.label}}</view></view></view>
        <view class="settings-credit">{{view.creditSummary}}</view>
      </scroll-view>
      <view class="settings-footer"><view class="settings-apply" bindtap="applySettings">保存更多设置</view></view>
    </view>
  </view>

  <view wx:if="{{pickerMounted}}" class="sheet-root picker-layer">
    <view class="sheet-mask {{pickerVisible ? 'open' : ''}}" catchtap="closePicker"></view>
    <view class="sheet-panel picker-panel {{pickerVisible ? 'open' : ''}}" catchtap="noop">
      <view class="sheet-handle"></view><view class="sheet-head"><text class="sheet-title">{{pickerTitle}}</text><view class="sheet-close" bindtap="closePicker">×</view></view>
      <scroll-view scroll-y class="sheet-scroll"><view wx:for="{{pickerOptions}}" wx:key="value" class="sheet-option {{item.active ? 'active' : ''}}" data-value="{{item.value}}" bindtap="selectPickerOption"><image wx:if="{{item.icon}}" class="sheet-option-icon" src="{{item.icon}}" mode="aspectFit"></image><view class="sheet-option-copy"><text class="sheet-option-title">{{item.label}}</text><text wx:if="{{item.subtitle}}" class="sheet-option-subtitle">{{item.subtitle}}</text></view><text wx:if="{{item.active}}" class="sheet-check">✓</text></view></scroll-view>
    </view>
  </view>

  <view wx:if="{{templateSheetMounted}}" class="sheet-root template-layer">
    <view class="sheet-mask {{templateSheetOpen ? 'open' : ''}}" catchtap="closeTemplates"></view>
    <view class="sheet-panel tall {{templateSheetOpen ? 'open' : ''}}" catchtap="noop">
      <view class="sheet-head"><text class="sheet-title">选择模板</text><view class="sheet-close" bindtap="closeTemplates">×</view></view>
      <view class="template-filters"><view class="template-search"><input class="template-search-input" value="{{templateQuery}}" placeholder="搜索风格、空间或模板" confirm-type="search" bindinput="onTemplateQueryInput" bindconfirm="onTemplateQueryConfirm" /><view wx:if="{{templateQuery}}" class="template-search-clear" bindtap="clearTemplateQuery">清除</view></view><scroll-view wx:if="{{templateCategoryChips.length}}" scroll-x enhanced show-scrollbar="{{false}}" class="template-category-scroll"><view class="template-category-track"><view wx:for="{{templateCategoryChips}}" wx:key="id" class="template-category-chip {{item.active ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectTemplateCategory">{{item.name}}</view></view></scroll-view></view>
      <view wx:if="{{templateLoading && !templates.length}}" class="sheet-loading">正在加载模板...</view>
      <scroll-view wx:else scroll-y class="sheet-scroll template-sheet-scroll" bindscrolltolower="loadMoreTemplates">
        <view wx:if="{{!templates.length}}" class="sheet-empty">{{templateQuery ? '没有匹配的模板' : '暂无可用模板'}}</view>
        <view wx:else class="template-grid"><view wx:for="{{templates}}" wx:key="id" class="template-card {{draft.templateId === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectTemplate"><view class="template-cover" data-id="{{item.id}}" catchtap="previewTemplateImage"><image wx:if="{{item.previewUrl && !item.previewFailed}}" class="template-cover-image" src="{{item.previewUrl}}" mode="aspectFill" data-id="{{item.id}}" binderror="onTemplateImageError"></image><view wx:else class="template-cover-placeholder"><text>模板</text></view><view wx:if="{{item.previewUrl && !item.previewFailed}}" class="template-zoom-hint">查看大图</view></view><text class="template-name">{{item.name}}</text><view class="template-use" data-id="{{item.id}}" catchtap="selectTemplate">使用此模板</view></view></view>
        <view wx:if="{{templateHasMore}}" class="template-load-more {{templateLoadingMore ? 'disabled' : ''}}" bindtap="loadMoreTemplates">{{templateLoadingMore ? '加载中...' : '加载更多'}}</view>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{templatePreviewVisible}}" class="template-preview-mask" catchtap="closeTemplatePreview">
    <view class="template-preview-panel" catchtap="noop"><view class="template-preview-head"><text class="template-preview-title">{{templatePreview.name || '模板预览'}}</text><view class="sheet-close" bindtap="closeTemplatePreview">×</view></view><view class="template-preview-body"><image wx:if="{{templatePreview.previewUrl}}" class="template-preview-image" src="{{templatePreview.previewUrl}}" mode="aspectFit" bindtap="openNativeTemplatePreview"></image><view wx:else class="sheet-empty">暂无预览图</view></view><view class="template-preview-actions"><view class="template-preview-secondary" bindtap="closeTemplatePreview">关闭</view><view class="template-preview-primary" data-id="{{templatePreview.id}}" bindtap="selectTemplate">使用此模板</view></view></view>
  </view>
</view>
