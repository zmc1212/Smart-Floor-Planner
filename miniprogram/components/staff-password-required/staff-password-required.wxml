<template name="staff-password-required">
  <view id="staff-password-required" class="password-required" role="alert">
    <view class="password-required-kicker">
      <text>账号安全</text>
      <view class="password-required-rule" aria-hidden="true" />
    </view>

    <view class="password-required-title" role="heading" aria-label="请先修改初始密码">
      <text class="password-required-title-intro">请先修改</text>
      <text class="password-required-title-emphasis">初始密码</text>
      <view class="password-required-underline" aria-hidden="true" />
    </view>
    <view class="password-required-exhibit" aria-hidden="true">
      <view class="password-required-mount-depth" />
      <view class="password-required-mount" />
      <image class="password-required-photo" src="/components/staff-password-required/oak-door-v004.jpg" mode="aspectFill" />
    </view>

    <text class="password-required-copy">修改后，请用新密码重新登录。</text>
    <view class="password-required-actions">
      <button class="password-required-back" bindtap="goBackFromPasswordRequired">
        <view class="password-required-back-icon" aria-hidden="true">
          <view class="password-required-arrow password-required-arrow-left" />
        </view>
        <text>返回</text>
      </button>
      <button class="password-required-change" bindtap="openAccountSecurity">
        <view class="password-required-plate-depth" aria-hidden="true" />
        <view class="password-required-plate">
          <text class="password-required-change-label">修改密码</text>
          <view class="password-required-arrow-cell" aria-hidden="true">
            <view class="password-required-arrow" />
          </view>
        </view>
      </button>
    </view>
    <text class="password-required-alternative">也可使用微信手机号登录。</text>
  </view>
</template>
