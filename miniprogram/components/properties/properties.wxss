.properties-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.96);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  box-shadow: var(--shadow-popup);
  border: 1rpx solid rgba(207, 220, 207, 0.55);
  z-index: 900;
  max-height: 72vh;
  transform: translateY(100%);
  transition: transform 0.2s ease;
  overflow: hidden;
}

.properties-panel.visible {
  transform: translateY(0);
}

.drag-handle {
  padding: 18rpx 0 8rpx;
  display: flex;
  justify-content: center;
}

.drag-bar {
  width: 72rpx;
  height: 8rpx;
  border-radius: var(--radius-full);
  background: var(--neutral-300);
}

.panel-header,
.header-actions,
.form-row,
.opening-header,
.color-picker {
  display: flex;
  align-items: center;
}

.panel-header {
  justify-content: space-between;
  padding: 16rpx var(--space-section) var(--space-xxl);
}

.panel-title {
  font-size: 32rpx;
  font-weight: var(--font-weight-bold);
  color: var(--text-primary);
}

.header-actions {
  gap: var(--space-md);
}

.header-btn {
  min-width: 64rpx;
  height: 56rpx;
  padding: 0 var(--space-lg);
  border-radius: var(--radius-full);
  background: var(--neutral-100);
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
}

.header-btn-danger {
  color: var(--status-converted-text);
  background: var(--status-converted-bg);
}

.panel-content {
  max-height: calc(72vh - 120rpx);
  padding: 0 var(--space-section) calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.merge-section,
.tips-section {
  background: var(--bg-surface-soft);
  border-radius: var(--radius-lg);
  padding: var(--space-xxl);
}

.merge-hint,
.tips-item {
  display: block;
  font-size: var(--font-size-caption);
  color: var(--text-secondary);
  margin-bottom: var(--space-md);
}

.btn-primary {
  min-height: 88rpx;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, #0fb04d 0%, #18a94b 100%);
  color: var(--text-inverse);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
}

.form-group {
  margin-bottom: var(--space-xxl);
}

.form-row {
  gap: var(--space-lg);
}

.form-group-half {
  flex: 1;
}

.form-label,
.form-label-sm,
.tips-title {
  display: block;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-medium);
  color: var(--text-primary);
  margin-bottom: var(--space-md);
}

.form-input,
.form-input-sm {
  width: 100%;
  height: 84rpx;
  background: rgba(248, 250, 248, 0.98);
  border-radius: 18rpx;
  padding: 0 var(--space-lg);
  box-sizing: border-box;
  font-size: var(--font-size-body);
  color: var(--text-primary);
  box-shadow: inset 0 0 0 1rpx rgba(227, 232, 227, 0.95);
}

.form-input-sm {
  height: 72rpx;
  font-size: var(--font-size-caption);
}

.section-divider {
  height: 1rpx;
  background: var(--neutral-100);
  margin: var(--space-section) 0;
}

.opening-card {
  background: var(--bg-surface-soft);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  margin-bottom: var(--space-lg);
}

.opening-header {
  justify-content: space-between;
  margin-bottom: var(--space-lg);
}

.opening-type {
  font-size: var(--font-size-body);
  color: var(--text-primary);
  font-weight: var(--font-weight-medium);
}

.opening-delete {
  color: var(--status-converted-text);
  font-size: var(--font-size-caption);
}

.color-picker {
  flex-wrap: wrap;
  gap: var(--space-lg);
  margin-bottom: var(--space-section);
}

.color-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-full);
  box-shadow: var(--shadow-border-soft);
}

.color-dot-active {
  box-shadow: 0 0 0 4rpx var(--brand-primary-40);
}
