<view class="role-workbench sfp-tab-page">
  <scroll-view scroll-y class="role-scroll" enhanced show-scrollbar="{{false}}">
    <view class="role-content">
      <block wx:if="{{role === 'enterprise_admin' && focus === 'overview'}}">
        <view
          class="identity-nav"
          style="padding-top: {{navigationTop}}px; min-height: {{navigationHeight}}px; padding-right: {{navigationRight}}px;"
        >
          <view class="identity-left">
            <view class="brand-mark">
              <image src="/images/home-ip-v1/brand-logo.png" mode="aspectFit" />
            </view>
            <text class="identity-role-name">家客来 · 经营端</text>
            <view wx:if="{{enterpriseName}}" class="identity-tag">
              <text>{{enterpriseName}}</text>
            </view>
          </view>
        </view>

        <view class="role-hero-card enterprise-hero-card">
          <view class="hero-top-row">
            <view class="hero-text-wrap">
              <text class="hero-title">{{title || '门店经营与全盘调度'}}</text>
              <text class="hero-subtitle">{{subtitle || '派单跟踪 · 测量调度 · 方案交付'}}</text>
            </view>
            <image class="hero-mascot enterprise-hero-mascot" src="/images/airy-v1/thumbs-up-xiao-k.png" mode="aspectFit" aria-label="小K" />
          </view>

          <view class="stats-pills-row">
            <view wx:for="{{summary}}" wx:key="key" class="stat-pill">
              <text class="stat-pill-label">{{item.label}}</text>
              <text class="stat-pill-value">{{item.value}}</text>
            </view>
          </view>

          <view wx:if="{{activityCode}}" class="hero-action-pill solid enterprise-activity-pill" bindtap="openActivityCode" hover-class="btn-pressed">
            <text>{{activityCode.label}}</text>
          </view>
        </view>

        <view class="quick-nav-grid">
          <view
            wx:for="{{quickNav}}"
            wx:key="key"
            class="quick-nav-card"
            data-target="{{item.target}}"
            bindtap="openQuickNav"
            hover-class="card-pressed"
          >
            <view class="quick-text">
              <text class="quick-title">{{item.title}}</text>
              <text class="quick-desc tone-{{item.tone || 'green'}}">{{item.desc}}</text>
            </view>
            <image
              class="quick-nav-mascot"
              src="{{item.key === 'staffLoad' ? '/images/airy-v1/xiao-k-measurer-3d.png' : '/images/airy-v1/leads-phone-3d.png'}}"
              mode="aspectFit"
            />
          </view>
        </view>

        <view class="enterprise-dashboard-section">
          <view class="section-head compact dashboard-head">
            <view class="section-title-wrap">
              <text class="section-icon">📊</text>
              <text class="section-title-text">经营大盘</text>
            </view>
            <text wx:if="{{dashboardPeriod.subtitle}}" class="dashboard-scope">{{dashboardPeriod.subtitle}}</text>
          </view>
          <view class="period-chip-row">
            <view
              wx:for="{{periodChips}}"
              wx:key="key"
              class="period-chip {{dashboardPeriod.kind === item.key ? 'active' : ''}}"
              data-kind="{{item.key}}"
              bindtap="selectPeriodChip"
            >
              <text>{{item.label}}</text>
            </view>
            <view
              class="period-chip custom {{dashboardPeriod.kind === 'custom' ? 'active' : ''}}"
              bindtap="openPeriodSheet"
            >
              <text>自定义</text>
            </view>
          </view>
          <view class="enterprise-dashboard-grid">
            <view wx:for="{{dashboard}}" wx:key="key" class="enterprise-dashboard-card">
              <text class="dashboard-label">{{item.label}}</text>
              <view class="dashboard-value-row">
                <text class="dashboard-value">{{item.value}}</text>
                <text wx:if="{{item.unit}}" class="dashboard-unit">{{item.unit}}</text>
              </view>
              <text wx:if="{{item.detail}}" class="dashboard-detail tone-{{item.tone || 'green'}}">{{item.detail}}</text>
            </view>
          </view>
        </view>

        <view class="enterprise-priority-section">
          <view class="section-head compact">
            <view class="section-title-wrap">
              <text class="section-icon">⚡</text>
              <text class="section-title-text">需优先处理事项（异常监控）</text>
            </view>
            <view wx:if="{{secondary}}" class="section-link" bindtap="openSecondary">
              <text>{{secondary.label}}</text>
              <view class="chevron"></view>
            </view>
          </view>

          <view wx:if="{{loading}}" class="state-block"><text>正在读取真实工作数据</text></view>
          <view wx:elif="{{error}}" class="state-block"><text>{{error}}</text><view class="retry" bindtap="load">重新加载</view></view>
          <view wx:elif="{{items.length}}" class="enterprise-exception-list">
            <view
              wx:for="{{items}}"
              wx:key="id"
              class="enterprise-exception-card"
              data-item="{{item}}"
              bindtap="openEnterpriseException"
              hover-class="work-item-pressed"
            >
              <view class="exception-marker tone-{{item.exceptionTone || 'orange'}}"></view>
              <view class="exception-copy">
                <text class="exception-title">{{item.title}}</text>
                <text class="exception-subtitle">{{item.subtitle}}</text>
                <text class="exception-meta">{{item.metaLabel}}</text>
              </view>
              <view wx:if="{{item.actionLabel}}" class="exception-cta" catchtap="openEnterpriseException" data-item="{{item}}">
                <text>{{item.actionLabel}}</text>
              </view>
            </view>
          </view>
          <view wx:else class="state-block empty">
            <text>{{emptyCopy}}</text>
          </view>
        </view>
      </block>

      <block wx:else>
        <view
          class="identity-nav"
          style="padding-top: {{navigationTop}}px; min-height: {{navigationHeight}}px; padding-right: {{navigationRight}}px;"
        >
          <view class="identity-left">
            <view class="brand-mark">
              <image src="/images/home-ip-v1/brand-logo.png" mode="aspectFit" />
            </view>
            <text class="identity-role-name">家客来 · {{role === 'designer' ? '设计师端' : role === 'measurer' ? '测量员端' : role === 'enterprise_admin' ? '经营端' : '服务向导'}}</text>
            <view wx:if="{{enterpriseName}}" class="identity-tag">
              <text>{{enterpriseName}}</text>
            </view>
          </view>
        </view>

        <view class="role-hero-card">
          <view class="hero-top-row">
            <view class="hero-text-wrap">
              <text class="hero-title">{{title || (role === 'designer' ? '方案协作与客户交付' : role === 'measurer' ? '今日量房排班与调度' : '工作台')}}</text>
              <text class="hero-subtitle">{{subtitle || (role === 'designer' ? '户型自动同步 · AI出图交付' : role === 'measurer' ? '激光测距直连 · 毫米级拓扑建图' : '')}}</text>
            </view>
            <image
              class="hero-mascot"
              src="{{role === 'designer' ? '/images/airy-v1/xiao-k-designer-3d.png' : role === 'measurer' ? '/images/airy-v1/xiao-k-measurer-3d.png' : '/images/airy-v1/thumbs-up-xiao-k.png'}}"
              mode="aspectFit"
              aria-label="小K"
            />
            <image style="display:none;" src="/images/page-ip-v3/mine.png" />
          </view>

          <view wx:if="{{role === 'measurer'}}" class="ble-status-pill" bindtap="openBleConnector" hover-class="btn-pressed">
            <view class="ble-dot {{bleConnected ? 'connected' : 'disconnected'}}"></view>
            <text>{{bleConnected ? '测距仪已连接' : '测距仪未连接'}}</text>
          </view>

          <view wx:if="{{focus === 'overview'}}" class="stats-pills-row">
            <view wx:for="{{summary}}" wx:key="key" class="stat-pill">
              <text class="stat-pill-label">{{item.label}}</text>
              <text class="stat-pill-value">{{item.value}}</text>
            </view>
          </view>

          <view wx:if="{{role === 'designer'}}" class="hero-action-pill outline" bindtap="openActivityCode" hover-class="btn-pressed">
            <text>出示获客活动码 📳</text>
          </view>
          <view wx:elif="{{role === 'measurer'}}" class="hero-action-pill solid" bindtap="openBleConnector" hover-class="btn-pressed">
            <text>链接测距仪 · {{bleConnected ? '已连接' : '未连接'}}</text>
          </view>
        </view>

        <view wx:if="{{focus === 'overview'}}" class="quick-nav-grid">
          <block wx:if="{{role === 'designer'}}">
            <view class="quick-nav-card" bindtap="openCustomers" hover-class="card-pressed">
              <view class="quick-text">
                <text class="quick-title">客户线索</text>
                <text class="quick-desc">{{summary.length > 0 ? summary[0].label + ' ' + summary[0].value + ' →' : '进入查看 →'}}</text>
              </view>
              <image class="quick-nav-mascot" src="/images/airy-v1/leads-phone-3d.png" mode="aspectFit" />
            </view>
            <view class="quick-nav-card" bindtap="openAIDesign" hover-class="card-pressed">
              <view class="quick-text">
                <text class="quick-title">风格配方</text>
                <text class="quick-desc">爆款模板一键套用 →</text>
              </view>
              <image class="quick-nav-mascot" src="/images/airy-v1/palette-recipe-3d.png" mode="aspectFit" />
            </view>
          </block>
          <block wx:elif="{{role === 'measurer'}}">
            <view class="quick-nav-card" bindtap="openCalendar" hover-class="card-pressed">
              <view class="quick-text">
                <text class="quick-title">量房路线</text>
                <text class="quick-desc">规划最优上门路径 →</text>
              </view>
              <image class="quick-nav-mascot" src="/images/airy-v1/route-map-3d.png" mode="aspectFit" />
            </view>
            <view class="quick-nav-card" bindtap="openUnavailability" hover-class="card-pressed">
              <view class="quick-text">
                <text class="quick-title">请假登记</text>
                <text class="quick-desc">维护不可用时段 →</text>
              </view>
              <image class="quick-nav-mascot" src="/images/airy-v1/leave-calendar-3d.png" mode="aspectFit" />
            </view>
          </block>
        </view>

        <view wx:if="{{focus === 'overview' && (role === 'designer' || role === 'measurer') && dashboard.length}}" class="enterprise-dashboard-section">
          <view class="section-head compact dashboard-head">
            <view class="section-title-wrap">
              <text class="section-icon">📊</text>
              <text class="section-title-text">经营大盘</text>
            </view>
            <text wx:if="{{dashboardPeriod.subtitle}}" class="dashboard-scope">{{dashboardPeriod.subtitle}}</text>
          </view>
          <view class="period-chip-row">
            <view
              wx:for="{{periodChips}}"
              wx:key="key"
              class="period-chip {{dashboardPeriod.kind === item.key ? 'active' : ''}}"
              data-kind="{{item.key}}"
              bindtap="selectPeriodChip"
            >
              <text>{{item.label}}</text>
            </view>
            <view
              class="period-chip custom {{dashboardPeriod.kind === 'custom' ? 'active' : ''}}"
              bindtap="openPeriodSheet"
            >
              <text>自定义</text>
            </view>
          </view>
          <view class="enterprise-dashboard-grid">
            <view wx:for="{{dashboard}}" wx:key="key" class="enterprise-dashboard-card">
              <text class="dashboard-label">{{item.label}}</text>
              <view class="dashboard-value-row">
                <text class="dashboard-value">{{item.value}}</text>
                <text wx:if="{{item.unit}}" class="dashboard-unit">{{item.unit}}</text>
              </view>
              <text wx:if="{{item.detail}}" class="dashboard-detail tone-{{item.tone || 'green'}}">{{item.detail}}</text>
            </view>
          </view>
        </view>

        <view class="section-head">
          <view class="section-title-wrap">
            <text class="section-icon">📐</text>
            <text class="section-title-text">{{role === 'customer' ? '我的服务' : role === 'designer' ? '待交付方案 (量房已完成)' : role === 'measurer' ? '今日待上门任务' : focus === 'tasks' ? '我的任务' : focus === 'survey' ? '可进入量房' : focus === 'appointments' ? '预约安排' : '优先处理'}}</text>
          </view>
          <view wx:if="{{focus === 'overview'}}" class="section-links">
            <view wx:if="{{activityCode}}" class="section-link" bindtap="openActivityCode"><text>{{activityCode.label}}</text><view class="chevron"></view></view>
            <view wx:if="{{secondary}}" class="section-link" bindtap="openSecondary"><text>{{secondary.label}}</text><view class="chevron"></view></view>
          </view>
        </view>

        <view wx:if="{{loading}}" class="state-block"><text>正在读取真实工作数据</text></view>
        <view wx:elif="{{error}}" class="state-block"><text>{{error}}</text><view class="retry" bindtap="load">重新加载</view></view>
        <view wx:elif="{{items.length}}" class="item-list">
          <view wx:for="{{items}}" wx:key="id" class="work-item" data-item="{{item}}" bindtap="openItem" hover-class="work-item-pressed">
            <view class="item-marker tone-{{item.status === 'confirmed' ? 'green' : 'blue'}}"></view>
            <view class="item-copy">
              <view class="item-title-row">
                <text class="item-title">{{item.title}}</text>
                <view wx:if="{{item.statusBadge}}" class="item-tag-green">
                  <text>{{item.statusBadge}}</text>
                </view>
              </view>
              <text class="item-subtitle">{{item.subtitle}}</text>
              <text class="item-meta">{{item.metaLabel}}</text>
              <view class="item-cta-row">
                <view wx:if="{{item.customerPhone}}" class="item-cta item-cta-secondary sfp-icon-action" catchtap="callCustomer" data-item="{{item}}">
                  <image class="sfp-icon-action__icon" src="/images/leads-v4/phone.png" mode="aspectFit" />
                  <text>电话联系</text>
                </view>
                <view wx:if="{{item.latitude && item.longitude}}" class="item-cta item-cta-secondary sfp-icon-action" catchtap="openNavigation" data-item="{{item}}">
                  <image class="sfp-icon-action__icon" src="/images/leads-v4/map-pin.png" mode="aspectFit" />
                  <text>导航</text>
                </view>
                <view wx:if="{{item.canCompleteSurvey}}" class="item-cta sfp-icon-action" catchtap="openAppointment" data-item="{{item}}">
                  <image class="sfp-icon-action__icon" src="/packages/business/assets/promotion-detail/calendar.png" mode="aspectFit" />
                  <text>确认完成量房</text>
                </view>
                <view wx:if="{{(item.canSurveyNow || item.canContinueSurvey) && !item.canCompleteSurvey}}" class="item-cta sfp-icon-action" catchtap="openSurvey" data-item="{{item}}">
                  <image class="sfp-icon-action__icon" src="/images/leads-v4/ruler-green.png" mode="aspectFit" />
                  <text>{{item.canContinueSurvey ? '继续量房' : '立即量房'}}</text>
                </view>
                <view wx:elif="{{item.canContinueSurvey && item.canCompleteSurvey}}" class="item-cta item-cta-secondary sfp-icon-action" catchtap="openSurvey" data-item="{{item}}">
                  <image class="sfp-icon-action__icon" src="/images/leads-v4/ruler-green.png" mode="aspectFit" />
                  <text>继续量房</text>
                </view>
                <view wx:if="{{item.canStartNewSurvey}}" class="item-cta item-cta-secondary sfp-icon-action" catchtap="openNewSurvey" data-item="{{item}}">
                  <image class="sfp-icon-action__icon" src="/images/leads-v4/ruler-green.png" mode="aspectFit" />
                  <text>新增量房</text>
                </view>
                <view wx:if="{{item.canReschedule}}" class="item-cta sfp-icon-action" catchtap="openReschedule" data-item="{{item}}">
                  <image class="sfp-icon-action__icon" src="/packages/business/assets/promotion-detail/calendar.png" mode="aspectFit" />
                  <text>{{item.actionLabel || '改期'}}</text>
                </view>
                <view wx:elif="{{item.canBookAppointment}}" class="item-cta item-cta-secondary sfp-icon-action" catchtap="openBooking" data-item="{{item}}">
                  <image class="sfp-icon-action__icon" src="/packages/business/assets/promotion-detail/calendar.png" mode="aspectFit" />
                  <text>{{item.canRebook ? (item.actionLabel || '重新预约') : '预约上门'}}</text>
                </view>
                <view wx:elif="{{item.action === 'appointment' && item.appointmentId && !item.canCompleteSurvey}}" class="item-cta item-cta-secondary sfp-icon-action" catchtap="openAppointment" data-item="{{item}}">
                  <image class="sfp-icon-action__icon" src="/packages/business/assets/promotion-detail/calendar.png" mode="aspectFit" />
                  <text>查看预约</text>
                </view>
              </view>
            </view>
            <view wx:if="{{!(item.canSurveyNow || item.canContinueSurvey || item.canStartNewSurvey || item.canCompleteSurvey || item.canBookAppointment || item.canReschedule || (item.action === 'appointment' && item.appointmentId))}}" class="item-action">
              <text>{{item.actionLabel}}</text>
              <view class="chevron"></view>
            </view>
          </view>
        </view>
        <view wx:else class="state-block empty">
          <text>{{emptyCopy}}</text>
          <view wx:if="{{secondary}}" class="retry" bindtap="openSecondary">{{secondary.label}}</view>
        </view>
      </block>
    </view>
  </scroll-view>

  <view wx:if="{{showPeriodSheet}}" class="period-sheet-mask" catchtouchmove="noop" bindtap="closePeriodSheet">
    <view class="period-sheet" catchtap="noop">
      <text class="period-sheet-title">自定义周期</text>
      <text class="period-sheet-hint">与新增线索同窗统计签单率</text>
      <view class="period-sheet-field">
        <text class="period-sheet-label">开始日期</text>
        <picker mode="date" value="{{customFrom}}" bindchange="onCustomFromChange">
          <view class="period-sheet-value">{{customFrom || '请选择'}}</view>
        </picker>
      </view>
      <view class="period-sheet-field">
        <text class="period-sheet-label">结束日期</text>
        <picker mode="date" value="{{customTo}}" bindchange="onCustomToChange">
          <view class="period-sheet-value">{{customTo || '请选择'}}</view>
        </picker>
      </view>
      <view class="period-sheet-actions">
        <view class="period-sheet-btn ghost" bindtap="closePeriodSheet"><text>取消</text></view>
        <view class="period-sheet-btn solid" bindtap="confirmCustomPeriod"><text>确定</text></view>
      </view>
    </view>
  </view>

  <ble-connector
    show="{{showBLEConnector}}"
    bindclose="onCloseBleConnector"
    bindsuccess="onBleSuccess"
    binddisconnect="onBleDisconnect"
  />
</view>
