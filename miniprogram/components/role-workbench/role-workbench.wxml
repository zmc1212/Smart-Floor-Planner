<!--
THESIS: 三个专业角色共用一套获客工作台骨架，角色差异只落在真实统计、权限文案和后续任务。
OWN-WORLD: 延续家客来明绿 Hero、轻白卡片与小 K 业务插画，个人和全店数据面统一使用薄荷底板。
STORY: 工作台先完成获客与推广，再进入角色任务；数据 Tab 分别读取本人或全店周期事实。
FIRST VIEWPORT: 胶囊安全身份栏下是等高绿色 Hero，随后是一张主卡加两张次卡的获客入口。
FORM: 负责人保留经营闭环；设计顾问与现场顾问使用同一路由呈现五项个人数据，不出现全店金额。
-->
<wxs src="../../utils/stat-format.wxs" module="stat" />
<view class="role-workbench sfp-tab-page">
  <scroll-view scroll-y class="role-scroll" enhanced show-scrollbar="{{false}}">
    <view class="role-content">
      <block wx:if="{{(role === 'enterprise_admin' || role === 'designer' || role === 'measurer') && focus === 'overview'}}">
        <view
          class="identity-nav enterprise-operations-nav"
          style="padding-top: {{navigationTop}}px; min-height: {{navigationHeight}}px; padding-right: {{navigationRight}}px;"
        >
          <view class="identity-brand-stack">
            <view class="identity-brand-row">
              <view class="brand-mark">
                <image src="/images/home-ip-v1/brand-logo.png" mode="aspectFit" />
              </view>
              <text class="identity-brand-name">家客来 · {{role === 'enterprise_admin' ? '经营端' : role === 'designer' ? '家装设计顾问端' : '家装现场顾问端'}}</text>
            </view>
            <text wx:if="{{enterpriseName}}" class="identity-enterprise-name">{{enterpriseName}}</text>
          </view>
        </view>

        <view class="role-hero-card enterprise-hero-card role-hero-card-{{role}}">
          <view class="hero-top-row">
            <view class="hero-text-wrap">
              <text class="hero-title">{{title || (role === 'enterprise_admin' ? '门店经营与全盘调度' : role === 'designer' ? '家装设计顾问工作台' : '家装现场顾问工作台')}}</text>
            </view>
            <image class="hero-mascot enterprise-hero-mascot" src="{{role === 'enterprise_admin' ? '/images/operations-dashboard/enterprise-guide.png' : role === 'designer' ? '/images/airy-v1/xiao-k-designer-workbench-v2.png' : '/images/airy-v1/xiao-k-measurer-3d.png'}}" mode="aspectFit" aria-label="小K" />
          </view>

          <view class="stats-pills-row">
            <view wx:for="{{summary}}" wx:key="key" class="stat-pill">
              <text class="stat-pill-label">{{item.label}}</text>
              <text class="stat-pill-value">{{stat.count(item.value)}}</text>
            </view>
          </view>

        </view>

        <view class="enterprise-action-hub">
          <text class="enterprise-action-hub-title">{{role === 'enterprise_admin' ? '获客与团队' : '获客与推广'}}</text>
          <view class="enterprise-action-layout {{activityCode ? '' : 'without-activity'}}">
            <view
              wx:if="{{activityCode}}"
              class="enterprise-action-share-card"
              bindtap="openActivityCode"
              hover-class="card-pressed"
              aria-role="button"
              aria-label="分享活动码，发给客户扫码留资"
            >
              <view class="enterprise-action-copy share">
                <text class="enterprise-action-title">{{activityCode.label}}</text>
                <text class="enterprise-action-detail">{{activityCode.detail}}</text>
              </view>
              <image class="enterprise-activity-art" src="/images/operations-dashboard/activity-code-share-v3.png" mode="aspectFit" aria-hidden="true" />
              <view class="enterprise-share-cta"><text>去分享活动码</text><view class="enterprise-code-chevron"></view></view>
            </view>

            <view class="enterprise-action-stack">
              <view
                wx:if="{{joinCode}}"
                class="enterprise-action-mini-card invite"
                bindtap="openJoinCodes"
                hover-class="card-pressed"
                aria-role="button"
                aria-label="{{role === 'enterprise_admin' ? '邀请员工或推荐人入驻' : '邀请推荐人入驻'}}"
              >
                <view class="enterprise-action-copy mini">
                  <text class="enterprise-action-title">{{joinCode.label}}</text>
                  <text class="enterprise-action-detail">{{joinCode.detail}}</text>
                </view>
                <image class="enterprise-mini-art invite" src="/images/operations-dashboard/team-onboarding-v3.png" mode="aspectFit" aria-hidden="true" />
                <view class="enterprise-mini-arrow"><view></view></view>
              </view>
              <view
                wx:if="{{referrerRoster}}"
                class="enterprise-action-mini-card referrer"
                bindtap="openReferrerRoster"
                hover-class="card-pressed"
                aria-role="button"
                aria-label="{{referrerRoster.label}}，{{referrerRoster.detail}}"
              >
                <view class="enterprise-action-copy mini">
                  <text class="enterprise-action-title">{{referrerRoster.label}}</text>
                  <text class="enterprise-action-detail">{{referrerRoster.detail}}</text>
                </view>
                <image class="enterprise-mini-art referrer" src="/images/operations-dashboard/referrer-roster-v2.png" mode="aspectFit" aria-hidden="true" />
                <view class="enterprise-mini-arrow"><view></view></view>
              </view>
            </view>
          </view>

          <view wx:if="{{role === 'enterprise_admin' && secondary}}" class="enterprise-appointment-row" bindtap="openSecondary" hover-class="card-pressed" aria-role="button" aria-label="{{secondary.label}}">
            <image class="enterprise-appointment-icon" src="/images/mine-icons/book-g.png" mode="aspectFit" aria-hidden="true" />
            <text class="enterprise-appointment-label">{{secondary.label}}</text>
            <text class="enterprise-appointment-meta">· 共 {{stat.count(appointmentCount)}} 项</text>
            <view class="enterprise-code-chevron"></view>
          </view>

          <view wx:if="{{role === 'enterprise_admin' && enterpriseReminder.length}}" class="enterprise-reminder-row" bindtap="openOperations" hover-class="card-pressed" aria-role="button" aria-label="查看经营提醒">
            <image class="enterprise-reminder-icon" src="/images/mine-icons/bell.png" mode="aspectFit" aria-hidden="true" />
            <text class="enterprise-reminder-title">经营提醒</text>
            <view class="enterprise-reminder-title-divider"></view>
            <view class="enterprise-reminder-facts">
              <view wx:for="{{enterpriseReminder}}" wx:key="key" wx:for-index="reminderIndex" class="enterprise-reminder-fact">
                <view wx:if="{{reminderIndex}}" class="enterprise-reminder-divider"></view>
                <text class="enterprise-reminder-label">{{item.label}}</text>
                <text class="enterprise-reminder-value">{{item.value}}{{item.unit}}</text>
              </view>
            </view>
            <view class="enterprise-code-chevron"></view>
          </view>

          <view wx:if="{{role === 'enterprise_admin'}}" class="quick-nav-grid">
            <view
              wx:for="{{quickNav}}"
              wx:key="key"
              class="quick-nav-card {{item.key === 'staffLoad' ? 'staff-load' : 'lead-inbox'}}"
              data-target="{{item.target}}"
              bindtap="openQuickNav"
              hover-class="card-pressed"
            >
              <view class="quick-text">
                <text class="quick-title">{{item.title}}</text>
                <text class="quick-desc tone-{{item.tone || 'green'}}">{{item.desc}}</text>
              </view>
              <image
                class="quick-nav-mascot {{item.key === 'staffLoad' ? 'staff-load-mascot' : ''}}"
                src="{{item.key === 'staffLoad' ? '/images/operations-dashboard/staff-load.png' : '/images/operations-dashboard/lead-inbox-v2.png'}}"
                mode="aspectFit"
              />
              <view class="quick-nav-arrow"><view></view></view>
            </view>
          </view>
        </view>

        <view wx:if="{{role === 'enterprise_admin'}}" class="enterprise-priority-section">
          <view class="enterprise-priority-tray {{items.length ? 'has-items' : 'is-empty'}}">
            <view class="section-head compact priority-head">
              <view class="section-title-wrap">
                <image class="priority-title-icon" src="/images/operations-dashboard/zap.png" mode="aspectFit" aria-hidden="true" />
                <text class="section-title-text">需优先处理事项</text>
              </view>
            </view>

            <view wx:if="{{loading}}" class="state-block priority-state"><text>正在读取真实工作数据</text></view>
            <view wx:elif="{{error}}" class="state-block priority-state"><text>{{error}}</text><view class="retry" bindtap="load">重新加载</view></view>
            <view wx:elif="{{items.length}}" class="enterprise-exception-list">
              <view
                wx:for="{{items}}"
                wx:key="id"
                class="enterprise-exception-card"
                data-item="{{item}}"
                bindtap="openEnterpriseException"
                hover-class="work-item-pressed"
              >
                <image class="exception-marker" src="/images/operations-dashboard/priority-alert-v2.png" mode="aspectFit" aria-hidden="true" />
                <view class="exception-copy">
                  <text class="exception-title">{{item.title}}</text>
                  <text class="exception-subtitle">{{item.subtitle}}</text>
                  <text class="exception-meta">{{item.metaLabel}}</text>
                </view>
                <view wx:if="{{item.actionLabel}}" class="exception-cta" catchtap="openEnterpriseException" data-item="{{item}}">
                  <text>{{item.actionLabel}}</text>
                </view>
              </view>
            </view>
            <view wx:else class="priority-empty-copy">
              <image class="priority-empty-pin" src="/images/leads-v4/map-pin.png" mode="aspectFit" aria-hidden="true" />
              <text>{{emptyCopy}}</text>
            </view>
          </view>
        </view>

        <block wx:else>
          <view
            wx:if="{{role === 'designer' && claimPoolSummary && claimPoolSummary.count > 0}}"
            class="claim-pool-alert"
            bindtap="openClaimPool"
            hover-class="card-pressed"
            aria-role="button"
            aria-label="进入抢单池，共{{stat.count(claimPoolSummary.count)}}条待抢线索"
          >
            <view class="claim-alert-clock"><view class="claim-alert-hand"></view></view>
            <view class="claim-alert-copy">
              <text class="claim-alert-title">有 {{stat.count(claimPoolSummary.count)}} 条新线索正在等你</text>
              <text class="claim-alert-subtitle">最近一单还剩 {{claimPoolSummary.remainingSeconds}} 秒{{claimPoolSummary.capacityAvailable ? '' : ' · 当前容量已满'}}</text>
            </view>
            <view class="claim-alert-action"><text>去抢单</text><view class="claim-alert-chevron"></view></view>
          </view>

          <view wx:if="{{role === 'designer'}}" class="quick-nav-grid staff-role-quick-grid">
            <view class="quick-nav-card lead-inbox" bindtap="openCustomers" hover-class="card-pressed">
              <view class="quick-text">
                <text class="quick-title">客户线索</text>
                <view class="quick-desc quick-desc-lines"><text>查看与推进</text><text>我的客户 →</text></view>
              </view>
              <image class="quick-nav-mascot" src="/images/airy-v1/leads-phone-3d.png" mode="aspectFit" aria-hidden="true" />
            </view>
            <view class="quick-nav-card staff-load" bindtap="openAIDesign" hover-class="card-pressed">
              <view class="quick-text">
                <text class="quick-title">方案交付</text>
                <view class="quick-desc quick-desc-lines"><text>进入设计与</text><text>风格配方 →</text></view>
              </view>
              <image class="quick-nav-mascot" src="/images/airy-v1/palette-recipe-3d.png" mode="aspectFit" aria-hidden="true" />
            </view>
          </view>

          <view wx:if="{{role === 'measurer'}}" class="staff-utility-grid">
            <view class="staff-utility-card meter" bindtap="openBleConnector" hover-class="card-pressed" aria-role="button">
              <image src="/images/airy-v1/laser-meter-3d.png" mode="aspectFit" aria-hidden="true" />
              <text class="staff-utility-title">连接测距仪</text>
              <text class="staff-utility-detail">{{bleConnected ? '设备已连接' : '设备未连接'}}</text>
            </view>
            <view class="staff-utility-card calendar" bindtap="openCalendar" hover-class="card-pressed" aria-role="button">
              <image src="/images/airy-v1/route-map-3d.png" mode="aspectFit" aria-hidden="true" />
              <text class="staff-utility-title">量房日程</text>
              <text class="staff-utility-detail">查看上门安排</text>
            </view>
            <view class="staff-utility-card leave" bindtap="openUnavailability" hover-class="card-pressed" aria-role="button">
              <image src="/images/airy-v1/leave-calendar-3d.png" mode="aspectFit" aria-hidden="true" />
              <text class="staff-utility-title">请假登记</text>
              <text class="staff-utility-detail">维护不可用时段</text>
            </view>
          </view>

          <view wx:if="{{withdrawalNotices.length}}" class="withdrawal-notice-list">
            <view wx:for="{{withdrawalNotices}}" wx:key="id" class="withdrawal-notice">
              <view class="withdrawal-notice-copy"><text class="withdrawal-notice-title">{{item.title}}</text><text class="withdrawal-notice-message">{{item.message}}</text><text wx:if="{{item.recordCode}}" class="withdrawal-notice-code">记录编号 {{item.recordCode}}</text></view>
              <button class="withdrawal-notice-action" data-id="{{item.id}}" bindtap="acknowledgeWithdrawal">我知道了</button>
            </view>
          </view>

          <view class="section-head staff-task-heading">
            <view class="section-title-wrap">
              <image class="staff-task-heading-icon" src="{{role === 'designer' ? '/images/ai-design-icons/floor-plan.png' : '/images/leads-v4/ruler-green.png'}}" mode="aspectFit" aria-hidden="true" />
              <text class="section-title-text">{{role === 'designer' ? '待推进与方案交付' : '日程与量房任务'}}</text>
            </view>
            <view wx:if="{{secondary}}" class="section-link" bindtap="openSecondary"><text>{{secondary.label}}</text><view class="chevron"></view></view>
          </view>

          <view wx:if="{{loading}}" class="state-block"><text>正在读取真实工作数据</text></view>
          <view wx:elif="{{error}}" class="state-block"><text>{{error}}</text><view class="retry" bindtap="load">重新加载</view></view>
          <view wx:elif="{{items.length}}" class="item-list">
            <view wx:for="{{items}}" wx:key="id" class="work-item staff-task-item" data-item="{{item}}" bindtap="openItem" hover-class="work-item-pressed">
              <view class="item-marker tone-{{item.status === 'confirmed' ? 'green' : 'blue'}}"></view>
              <view class="item-copy">
                <view class="item-title-row"><text class="item-title">{{item.title}}</text><view wx:if="{{item.statusBadge}}" class="item-tag-green"><text>{{item.statusBadge}}</text></view></view>
                <text class="item-subtitle">{{item.subtitle}}</text>
                <text class="item-meta">{{item.metaLabel}}</text>
                <view class="item-cta-row">
                  <view wx:if="{{item.customerPhone}}" class="item-cta item-cta-secondary sfp-icon-action" catchtap="callCustomer" data-item="{{item}}"><image class="sfp-icon-action__icon" src="/images/leads-v4/phone.png" mode="aspectFit" /><text>电话联系</text></view>
                  <view wx:if="{{item.latitude && item.longitude}}" class="item-cta item-cta-secondary sfp-icon-action" catchtap="openNavigation" data-item="{{item}}"><image class="sfp-icon-action__icon" src="/images/leads-v4/map-pin.png" mode="aspectFit" /><text>导航</text></view>
                  <view wx:if="{{item.canCompleteSurvey}}" class="item-cta sfp-icon-action" catchtap="openAppointment" data-item="{{item}}"><image class="sfp-icon-action__icon" src="/packages/business/assets/promotion-detail/calendar.png" mode="aspectFit" /><text>确认完成量房</text></view>
                  <view wx:if="{{(item.canSurveyNow || item.canContinueSurvey) && !item.canCompleteSurvey}}" class="item-cta sfp-icon-action" catchtap="openSurvey" data-item="{{item}}"><image class="sfp-icon-action__icon" src="/images/leads-v4/ruler-green.png" mode="aspectFit" /><text>{{item.canContinueSurvey ? '继续量房' : '立即量房'}}</text></view>
                  <view wx:elif="{{item.canContinueSurvey && item.canCompleteSurvey}}" class="item-cta item-cta-secondary sfp-icon-action" catchtap="openSurvey" data-item="{{item}}"><image class="sfp-icon-action__icon" src="/images/leads-v4/ruler-green.png" mode="aspectFit" /><text>继续量房</text></view>
                  <view wx:if="{{item.canStartNewSurvey}}" class="item-cta item-cta-secondary sfp-icon-action" catchtap="openNewSurvey" data-item="{{item}}"><image class="sfp-icon-action__icon" src="/images/leads-v4/ruler-green.png" mode="aspectFit" /><text>新增量房</text></view>
                  <view wx:if="{{item.canReschedule}}" class="item-cta sfp-icon-action" catchtap="openReschedule" data-item="{{item}}"><image class="sfp-icon-action__icon" src="/packages/business/assets/promotion-detail/calendar.png" mode="aspectFit" /><text>{{item.actionLabel || '改期'}}</text></view>
                  <view wx:elif="{{item.canBookAppointment}}" class="item-cta item-cta-secondary sfp-icon-action" catchtap="openBooking" data-item="{{item}}"><image class="sfp-icon-action__icon" src="/packages/business/assets/promotion-detail/calendar.png" mode="aspectFit" /><text>{{item.canRebook ? (item.actionLabel || '重新预约') : '预约上门'}}</text></view>
                  <view wx:elif="{{item.action === 'appointment' && item.appointmentId && !item.canCompleteSurvey}}" class="item-cta item-cta-secondary sfp-icon-action" catchtap="openAppointment" data-item="{{item}}"><image class="sfp-icon-action__icon" src="/packages/business/assets/promotion-detail/calendar.png" mode="aspectFit" /><text>查看预约</text></view>
                  <view wx:if="{{!(item.canSurveyNow || item.canContinueSurvey || item.canStartNewSurvey || item.canCompleteSurvey || item.canBookAppointment || item.canReschedule || (item.action === 'appointment' && item.appointmentId))}}" class="item-action"><text>{{item.actionLabel}}</text><view class="chevron"></view></view>
                </view>
              </view>
            </view>
          </view>
          <view wx:else class="state-block empty"><text>{{emptyCopy}}</text><view wx:if="{{secondary}}" class="retry" bindtap="openSecondary">{{secondary.label}}</view></view>
        </block>
      </block>

      <block wx:elif="{{(role === 'enterprise_admin' || role === 'designer' || role === 'measurer') && focus === 'operations'}}">
        <view
          class="identity-nav"
          style="padding-top: {{navigationTop}}px; min-height: {{navigationHeight}}px; padding-right: {{navigationRight}}px;"
        >
          <view class="identity-brand-stack">
            <view class="identity-brand-row">
              <view class="brand-mark"><image src="/images/home-ip-v1/brand-logo.png" mode="aspectFit" /></view>
              <text class="identity-brand-name">家客来 · {{role === 'enterprise_admin' ? '经营端' : role === 'designer' ? '家装设计顾问端' : '家装现场顾问端'}}</text>
            </view>
            <text wx:if="{{enterpriseName}}" class="identity-enterprise-name">{{enterpriseName}}</text>
          </view>
        </view>

        <block wx:if="{{role === 'enterprise_admin'}}">
        <view class="enterprise-operations-hero">
          <view class="enterprise-operations-hero-copy">
            <text class="enterprise-operations-title">{{dashboardPeriod.label || '本月'}}经营大盘</text>
            <view class="period-chip-row operations-period-chip-row">
              <view wx:for="{{periodChips}}" wx:key="key" class="period-chip {{dashboardPeriod.kind === item.key ? 'active' : ''}}" data-kind="{{item.key}}" bindtap="selectPeriodChip"><text>{{item.label}}</text></view>
              <view class="period-chip custom {{dashboardPeriod.kind === 'custom' ? 'active' : ''}}" bindtap="openPeriodSheet"><text>自定义</text></view>
            </view>
          </view>
          <image class="operations-hero-chart-asset" src="/images/operations-dashboard/operations-growth-chart-v2.png" mode="aspectFit" aria-hidden="true" />
          <image class="enterprise-operations-mascot" src="/images/operations-dashboard/enterprise-hero-k-v2.png" mode="aspectFit" aria-label="小K" />
          <view class="operations-hero-kpi-grid" wx:if="{{enterpriseHeroKpis.length}}">
            <view wx:for="{{enterpriseHeroKpis}}" wx:key="key" class="operations-hero-kpi-card">
              <image class="operations-hero-kpi-icon" src="{{item.key === 'newLeads' ? '/images/operations-dashboard/new-leads-kpi-v2.png' : item.key === 'completedSurveys' ? '/images/operations-dashboard/completed-survey-kpi-v2.png' : item.key === 'signedCount' ? '/images/operations-dashboard/signed-contract-kpi-v2.png' : '/images/operations-dashboard/contract-amount-kpi-v2.png'}}" mode="aspectFit" aria-hidden="true" />
              <text class="operations-hero-kpi-label">{{item.label}}</text>
              <view class="operations-hero-kpi-value {{item.key === 'contractAmount' && stat.isMoneyCompact(item.value) ? 'is-compact' : ''}}"><text>{{item.key === 'contractAmount' ? stat.moneyValue(item.value) : stat.count(item.value)}}</text><text wx:if="{{item.key === 'contractAmount'}}">{{stat.moneyUnit(item.value)}}</text><text wx:elif="{{item.unit}}">{{item.unit}}</text></view>
            </view>
          </view>
        </view>

        <view wx:if="{{loading}}" class="state-block"><text>正在读取经营数据</text></view>
        <view wx:elif="{{error}}" class="state-block"><text>{{error}}</text><view class="retry" bindtap="load">重新加载</view></view>
        <block wx:else>
          <view wx:if="{{dashboardStages.length}}" class="enterprise-operations-board">
            <view class="operations-board-kicker"><text>经营闭环</text></view>
            <view class="operations-stage-grid">
              <view wx:for="{{dashboardStages}}" wx:key="key" class="operations-stage operations-stage-{{item.key}} state-{{item.state}}">
                <view class="operations-stage-icon"><image src="{{item.key === 'newLeads' ? '/images/operations-dashboard/new-leads-kpi-v2.png' : item.key === 'completedSurveys' ? '/images/operations-dashboard/completed-survey-kpi-v2.png' : '/images/operations-dashboard/signed-contract-kpi-v2.png'}}" mode="aspectFit" aria-hidden="true" /></view>
                <text class="operations-stage-label">{{item.flowLabel}}</text>
                <text class="operations-stage-detail">{{item.flowDetail}}</text>
              </view>
            </view>
          </view>
          <view class="operations-efficiency-grid">
            <view wx:for="{{dashboardEfficiencies}}" wx:key="key" class="operations-efficiency-card operations-efficiency-{{item.key}}">
              <text class="operations-efficiency-label">{{item.label}}</text><view class="operations-efficiency-value-row"><text class="operations-efficiency-value">{{stat.percent(item.value)}}</text></view><text wx:if="{{item.detail}}" class="operations-efficiency-detail">{{item.detail}}</text>
            </view>
          </view>
          <view class="operations-trend-card">
            <view class="operations-trend-heading"><text>签约金额趋势（万元）</text><view class="operations-trend-legend"><text class="current">{{contractAmountTrend.currentLabel}}</text><text>{{contractAmountTrend.previousLabel}}</text></view></view>
            <view wx:if="{{contractAmountTrend.hasData}}" class="operations-trend-plot">
              <canvas type="2d" id="operations-trend-canvas" class="operations-trend-canvas"></canvas>
              <view class="operations-trend-axis"><text wx:for="{{contractAmountTrend.axisLabels}}" wx:key="*this">{{item}}</text></view>
            </view>
            <view wx:else class="operations-trend-empty"><text>暂无签约金额趋势数据</text></view>
          </view>
        </block>
        </block>

        <block wx:else>
          <view class="staff-data-hero">
            <view class="staff-data-hero-copy">
              <text class="staff-data-title">{{dashboardPeriod.label || '本月'}}个人数据</text>
              <text class="staff-data-scope">仅统计我的业务数据</text>
              <view class="period-chip-row staff-data-period-row">
                <view wx:for="{{periodChips}}" wx:key="key" class="period-chip {{dashboardPeriod.kind === item.key ? 'active' : ''}}" data-kind="{{item.key}}" bindtap="selectPeriodChip"><text>{{item.label}}</text></view>
                <view class="period-chip custom {{dashboardPeriod.kind === 'custom' ? 'active' : ''}}" bindtap="openPeriodSheet"><text>自定义</text></view>
              </view>
            </view>
            <image class="staff-data-mascot {{role}}" src="{{role === 'designer' ? '/images/operations-dashboard/staff-data-designer-v1.png' : '/images/operations-dashboard/staff-data-measurer-v1.png'}}" mode="aspectFit" aria-label="{{role === 'designer' ? '手持户型图的家装设计顾问小K' : '使用测距仪量房的家装现场顾问小K'}}" />
          </view>

          <view wx:if="{{loading}}" class="state-block"><text>正在读取个人数据</text></view>
          <view wx:elif="{{error}}" class="state-block"><text>{{error}}</text><view class="retry" bindtap="load">重新加载</view></view>
          <block wx:else>
            <view class="personal-dashboard-section">
              <view class="enterprise-dashboard-grid personal-dashboard-grid">
                <view wx:for="{{dashboard}}" wx:key="key" class="enterprise-dashboard-card personal-dashboard-card personal-dashboard-card-{{item.key}}">
                  <image class="personal-dashboard-icon" src="{{item.key === 'newLeads' ? '/images/operations-dashboard/new-leads-kpi-v2.png' : item.key === 'completedSurveys' ? '/images/operations-dashboard/completed-survey-kpi-v2.png' : item.key === 'schemeDelivery' ? '/images/operations-dashboard/scheme-delivery-kpi-v1.png' : item.key === 'signedCount' ? '/images/operations-dashboard/signed-contract-kpi-v2.png' : '/images/operations-dashboard/signing-rate-kpi-v1.png'}}" mode="aspectFit" aria-hidden="true" />
                  <text class="dashboard-label">{{item.label}}</text>
                  <view class="dashboard-value-row"><text class="dashboard-value">{{item.key === 'schemeDelivery' || item.key === 'signingRate' ? stat.percent(item.value) : stat.count(item.value)}}</text><text wx:if="{{item.unit && item.key !== 'schemeDelivery' && item.key !== 'signingRate'}}" class="dashboard-unit">{{item.unit}}</text></view>
                </view>
              </view>
            </view>

            <view wx:if="{{personalDashboardStages.length}}" class="personal-data-path">
              <view class="operations-board-kicker"><text>我的转化路径</text></view>
              <view class="personal-data-stage-grid">
                <view wx:for="{{personalDashboardStages}}" wx:key="key" class="personal-data-stage personal-data-stage-{{item.key}}">
                  <view class="personal-data-stage-icon-wrap">
                    <image class="personal-data-stage-icon" src="{{item.key === 'newLeads' ? '/images/operations-dashboard/new-leads-kpi-v2.png' : item.key === 'completedSurveys' ? '/images/operations-dashboard/completed-survey-kpi-v2.png' : item.key === 'schemeDelivery' ? '/images/operations-dashboard/scheme-delivery-kpi-v1.png' : '/images/operations-dashboard/signed-contract-kpi-v2.png'}}" mode="aspectFit" aria-hidden="true" />
                  </view>
                  <text class="personal-data-stage-label">{{item.flowLabel}}</text>
                </view>
              </view>
            </view>
          </block>
        </block>
      </block>

      <block wx:else>
        <view
          class="identity-nav"
          style="padding-top: {{navigationTop}}px; min-height: {{navigationHeight}}px; padding-right: {{navigationRight}}px;"
        >
          <view class="identity-brand-stack">
            <view class="identity-brand-row">
              <view class="brand-mark">
                <image src="/images/home-ip-v1/brand-logo.png" mode="aspectFit" />
              </view>
              <text class="identity-brand-name">家客来 · {{role === 'designer' ? '家装设计顾问端' : role === 'measurer' ? '家装现场顾问端' : role === 'enterprise_admin' ? '经营端' : '服务向导'}}</text>
            </view>
            <text wx:if="{{enterpriseName}}" class="identity-enterprise-name">{{enterpriseName}}</text>
          </view>
        </view>

        <view class="role-hero-card">
          <view class="hero-top-row">
            <view class="hero-text-wrap">
              <text wx:if="{{staffName}}" class="hero-staff-name">{{staffName}}</text>
              <text class="hero-title">{{title || (role === 'designer' ? '方案协作与客户交付' : role === 'measurer' ? '今日量房排班与调度' : '工作台')}}</text>
              <text class="hero-subtitle">{{subtitle || (role === 'designer' ? '户型自动同步 · AI出图交付' : role === 'measurer' ? '激光测距直连 · 毫米级拓扑建图' : '')}}</text>
            </view>
            <image
              class="hero-mascot"
              src="{{role === 'designer' ? '/images/airy-v1/xiao-k-designer-3d.png' : role === 'measurer' ? '/images/airy-v1/xiao-k-measurer-3d.png' : '/images/airy-v1/thumbs-up-xiao-k.png'}}"
              mode="aspectFit"
              aria-label="小K"
            />
            <image style="display:none;" src="/images/page-ip-v3/mine.png" />
          </view>

          <view wx:if="{{role === 'measurer'}}" class="ble-status-pill" bindtap="openBleConnector" hover-class="btn-pressed">
            <view class="ble-dot {{bleConnected ? 'connected' : 'disconnected'}}"></view>
            <text>{{bleConnected ? '测距仪已连接' : '测距仪未连接'}}</text>
          </view>

          <view wx:if="{{focus === 'overview'}}" class="stats-pills-row">
            <view wx:for="{{summary}}" wx:key="key" class="stat-pill">
              <text class="stat-pill-label">{{item.label}}</text>
              <text class="stat-pill-value">{{item.value}}</text>
            </view>
          </view>

          <view wx:if="{{role === 'designer'}}" class="hero-action-pill outline" bindtap="openActivityCode" hover-class="btn-pressed">
            <text>出示获客活动码 📳</text>
          </view>
          <view wx:elif="{{role === 'measurer'}}" class="hero-action-pill solid" bindtap="openBleConnector" hover-class="btn-pressed">
            <text>链接测距仪 · {{bleConnected ? '已连接' : '未连接'}}</text>
          </view>
        </view>

        <view
          wx:if="{{focus === 'overview' && role === 'designer' && claimPoolSummary && claimPoolSummary.count > 0}}"
          class="claim-pool-alert"
          bindtap="openClaimPool"
          hover-class="card-pressed"
          aria-role="button"
          aria-label="进入抢单池，共{{stat.count(claimPoolSummary.count)}}条待抢线索"
        >
          <view class="claim-alert-clock"><view class="claim-alert-hand"></view></view>
          <view class="claim-alert-copy">
            <text class="claim-alert-title">有 {{stat.count(claimPoolSummary.count)}} 条新线索正在等你</text>
            <text class="claim-alert-subtitle">最近一单还剩 {{claimPoolSummary.remainingSeconds}} 秒{{claimPoolSummary.capacityAvailable ? '' : ' · 当前容量已满'}}</text>
          </view>
          <view class="claim-alert-action"><text>去抢单</text><view class="claim-alert-chevron"></view></view>
        </view>

        <view wx:if="{{focus === 'overview'}}" class="quick-nav-grid">
          <block wx:if="{{role === 'designer'}}">
            <view class="quick-nav-card" bindtap="openCustomers" hover-class="card-pressed">
              <view class="quick-text">
                <text class="quick-title">客户线索</text>
                <text class="quick-desc">{{summary.length > 0 ? summary[0].label + ' ' + stat.count(summary[0].value) + ' →' : '进入查看 →'}}</text>
              </view>
              <image class="quick-nav-mascot" src="/images/airy-v1/leads-phone-3d.png" mode="aspectFit" />
            </view>
            <view class="quick-nav-card" bindtap="openAIDesign" hover-class="card-pressed">
              <view class="quick-text">
                <text class="quick-title">风格配方</text>
                <text class="quick-desc">爆款模板一键套用 →</text>
              </view>
              <image class="quick-nav-mascot" src="/images/airy-v1/palette-recipe-3d.png" mode="aspectFit" />
            </view>
          </block>
          <block wx:elif="{{role === 'measurer'}}">
            <view class="quick-nav-card" bindtap="openCalendar" hover-class="card-pressed">
              <view class="quick-text">
                <text class="quick-title">量房路线</text>
                <text class="quick-desc">规划最优上门路径 →</text>
              </view>
              <image class="quick-nav-mascot" src="/images/airy-v1/route-map-3d.png" mode="aspectFit" />
            </view>
            <view class="quick-nav-card" bindtap="openUnavailability" hover-class="card-pressed">
              <view class="quick-text">
                <text class="quick-title">请假登记</text>
                <text class="quick-desc">维护不可用时段 →</text>
              </view>
              <image class="quick-nav-mascot" src="/images/airy-v1/leave-calendar-3d.png" mode="aspectFit" />
            </view>
          </block>
        </view>

        <view wx:if="{{focus === 'overview' && (role === 'designer' || role === 'measurer') && dashboard.length}}" class="enterprise-dashboard-section">
          <view class="section-head compact dashboard-head">
            <view class="section-title-wrap">
              <text class="section-icon">📊</text>
              <text class="section-title-text">经营大盘</text>
            </view>
            <text wx:if="{{dashboardPeriod.subtitle}}" class="dashboard-scope">{{dashboardPeriod.subtitle}}</text>
          </view>
          <view class="period-chip-row">
            <view
              wx:for="{{periodChips}}"
              wx:key="key"
              class="period-chip {{dashboardPeriod.kind === item.key ? 'active' : ''}}"
              data-kind="{{item.key}}"
              bindtap="selectPeriodChip"
            >
              <text>{{item.label}}</text>
            </view>
            <view
              class="period-chip custom {{dashboardPeriod.kind === 'custom' ? 'active' : ''}}"
              bindtap="openPeriodSheet"
            >
              <text>自定义</text>
            </view>
          </view>
          <view class="enterprise-dashboard-grid">
            <view wx:for="{{dashboard}}" wx:key="key" class="enterprise-dashboard-card">
              <text class="dashboard-label">{{item.label}}</text>
              <view class="dashboard-value-row">
                <text class="dashboard-value">{{item.key === 'schemeDelivery' || item.key === 'signingRate' ? stat.percent(item.value) : stat.count(item.value)}}</text>
                <text wx:if="{{item.unit && item.key !== 'schemeDelivery' && item.key !== 'signingRate'}}" class="dashboard-unit">{{item.unit}}</text>
              </view>
              <text wx:if="{{item.detail}}" class="dashboard-detail tone-{{item.tone || 'green'}}">{{item.detail}}</text>
            </view>
          </view>
        </view>

        <view wx:if="{{withdrawalNotices.length}}" class="withdrawal-notice-list">
          <view wx:for="{{withdrawalNotices}}" wx:key="id" class="withdrawal-notice">
            <view class="withdrawal-notice-copy">
              <text class="withdrawal-notice-title">{{item.title}}</text>
              <text class="withdrawal-notice-message">{{item.message}}</text>
              <text wx:if="{{item.recordCode}}" class="withdrawal-notice-code">记录编号 {{item.recordCode}}</text>
            </view>
            <button class="withdrawal-notice-action" data-id="{{item.id}}" bindtap="acknowledgeWithdrawal">我知道了</button>
          </view>
        </view>

        <view class="section-head">
          <view class="section-title-wrap">
            <text class="section-icon">📐</text>
            <text class="section-title-text">{{role === 'customer' ? '我的服务' : role === 'designer' ? '待交付方案 (量房已完成)' : role === 'measurer' ? '今日待上门任务' : focus === 'tasks' ? '我的任务' : focus === 'survey' ? '可进入量房' : focus === 'appointments' ? '预约安排' : '优先处理'}}</text>
          </view>
          <view wx:if="{{focus === 'overview'}}" class="section-links">
            <view wx:if="{{activityCode}}" class="section-link" bindtap="openActivityCode"><text>{{activityCode.label}}</text><view class="chevron"></view></view>
            <view wx:if="{{secondary}}" class="section-link" bindtap="openSecondary"><text>{{secondary.label}}</text><view class="chevron"></view></view>
          </view>
        </view>

        <view wx:if="{{loading}}" class="state-block"><text>正在读取真实工作数据</text></view>
        <view wx:elif="{{error}}" class="state-block"><text>{{error}}</text><view class="retry" bindtap="load">重新加载</view></view>
        <view wx:elif="{{items.length}}" class="item-list">
          <view wx:for="{{items}}" wx:key="id" class="work-item" data-item="{{item}}" bindtap="openItem" hover-class="work-item-pressed">
            <view class="item-marker tone-{{item.status === 'confirmed' ? 'green' : 'blue'}}"></view>
            <view class="item-copy">
              <view class="item-title-row">
                <text class="item-title">{{item.title}}</text>
                <view wx:if="{{item.statusBadge}}" class="item-tag-green">
                  <text>{{item.statusBadge}}</text>
                </view>
              </view>
              <text class="item-subtitle">{{item.subtitle}}</text>
              <text class="item-meta">{{item.metaLabel}}</text>
              <view class="item-cta-row">
                <view wx:if="{{item.customerPhone}}" class="item-cta item-cta-secondary sfp-icon-action" catchtap="callCustomer" data-item="{{item}}">
                  <image class="sfp-icon-action__icon" src="/images/leads-v4/phone.png" mode="aspectFit" />
                  <text>电话联系</text>
                </view>
                <view wx:if="{{item.latitude && item.longitude}}" class="item-cta item-cta-secondary sfp-icon-action" catchtap="openNavigation" data-item="{{item}}">
                  <image class="sfp-icon-action__icon" src="/images/leads-v4/map-pin.png" mode="aspectFit" />
                  <text>导航</text>
                </view>
                <view wx:if="{{item.canCompleteSurvey}}" class="item-cta sfp-icon-action" catchtap="openAppointment" data-item="{{item}}">
                  <image class="sfp-icon-action__icon" src="/packages/business/assets/promotion-detail/calendar.png" mode="aspectFit" />
                  <text>确认完成量房</text>
                </view>
                <view wx:if="{{(item.canSurveyNow || item.canContinueSurvey) && !item.canCompleteSurvey}}" class="item-cta sfp-icon-action" catchtap="openSurvey" data-item="{{item}}">
                  <image class="sfp-icon-action__icon" src="/images/leads-v4/ruler-green.png" mode="aspectFit" />
                  <text>{{item.canContinueSurvey ? '继续量房' : '立即量房'}}</text>
                </view>
                <view wx:elif="{{item.canContinueSurvey && item.canCompleteSurvey}}" class="item-cta item-cta-secondary sfp-icon-action" catchtap="openSurvey" data-item="{{item}}">
                  <image class="sfp-icon-action__icon" src="/images/leads-v4/ruler-green.png" mode="aspectFit" />
                  <text>继续量房</text>
                </view>
                <view wx:if="{{item.canStartNewSurvey}}" class="item-cta item-cta-secondary sfp-icon-action" catchtap="openNewSurvey" data-item="{{item}}">
                  <image class="sfp-icon-action__icon" src="/images/leads-v4/ruler-green.png" mode="aspectFit" />
                  <text>新增量房</text>
                </view>
                <view wx:if="{{item.canReschedule}}" class="item-cta sfp-icon-action" catchtap="openReschedule" data-item="{{item}}">
                  <image class="sfp-icon-action__icon" src="/packages/business/assets/promotion-detail/calendar.png" mode="aspectFit" />
                  <text>{{item.actionLabel || '改期'}}</text>
                </view>
                <view wx:elif="{{item.canBookAppointment}}" class="item-cta item-cta-secondary sfp-icon-action" catchtap="openBooking" data-item="{{item}}">
                  <image class="sfp-icon-action__icon" src="/packages/business/assets/promotion-detail/calendar.png" mode="aspectFit" />
                  <text>{{item.canRebook ? (item.actionLabel || '重新预约') : '预约上门'}}</text>
                </view>
                <view wx:elif="{{item.action === 'appointment' && item.appointmentId && !item.canCompleteSurvey}}" class="item-cta item-cta-secondary sfp-icon-action" catchtap="openAppointment" data-item="{{item}}">
                  <image class="sfp-icon-action__icon" src="/packages/business/assets/promotion-detail/calendar.png" mode="aspectFit" />
                  <text>查看预约</text>
                </view>
              </view>
            </view>
            <view wx:if="{{!(item.canSurveyNow || item.canContinueSurvey || item.canStartNewSurvey || item.canCompleteSurvey || item.canBookAppointment || item.canReschedule || (item.action === 'appointment' && item.appointmentId))}}" class="item-action">
              <text>{{item.actionLabel}}</text>
              <view class="chevron"></view>
            </view>
          </view>
        </view>
        <view wx:else class="state-block empty">
          <text>{{emptyCopy}}</text>
          <view wx:if="{{secondary}}" class="retry" bindtap="openSecondary">{{secondary.label}}</view>
        </view>
      </block>
    </view>
  </scroll-view>

  <view wx:if="{{showPeriodSheet}}" class="period-sheet-mask" catchtouchmove="noop" bindtap="closePeriodSheet">
    <view class="period-sheet" catchtap="noop">
      <text class="period-sheet-title">自定义周期</text>
      <text class="period-sheet-hint">与新增线索同窗统计签单率</text>
      <view class="period-sheet-field">
        <text class="period-sheet-label">开始日期</text>
        <picker mode="date" value="{{customFrom}}" bindchange="onCustomFromChange">
          <view class="period-sheet-value">{{customFrom || '请选择'}}</view>
        </picker>
      </view>
      <view class="period-sheet-field">
        <text class="period-sheet-label">结束日期</text>
        <picker mode="date" value="{{customTo}}" bindchange="onCustomToChange">
          <view class="period-sheet-value">{{customTo || '请选择'}}</view>
        </picker>
      </view>
      <view class="period-sheet-actions">
        <view class="period-sheet-btn ghost" bindtap="closePeriodSheet"><text>取消</text></view>
        <view class="period-sheet-btn solid" bindtap="confirmCustomPeriod"><text>确定</text></view>
      </view>
    </view>
  </view>

  <ble-connector
    show="{{showBLEConnector}}"
    bindclose="onCloseBleConnector"
    bindsuccess="onBleSuccess"
    binddisconnect="onBleDisconnect"
  />
</view>
