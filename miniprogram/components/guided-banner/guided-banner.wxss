.guided-wizard-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-lg);
  padding: var(--space-lg) var(--space-section);
  background: rgba(255, 255, 255, 0.94);
  color: var(--text-primary);
  box-shadow: 0 8rpx 24rpx rgba(85, 104, 90, 0.05);
  border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  border-bottom: 1rpx solid rgba(207, 220, 207, 0.55);
}

.wizard-cancel,
.wizard-btn-action,
.wizard-btn-finish {
  height: 56rpx;
  padding: 0 var(--space-lg);
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: var(--font-weight-medium);
  white-space: nowrap;
}

.wizard-cancel,
.wizard-btn-action {
  background: var(--bg-surface-soft);
  color: var(--text-brand);
}

.wizard-btn-finish {
  background: linear-gradient(135deg, #0fb04d 0%, #18a94b 100%);
  color: var(--text-inverse);
}

.wizard-text {
  flex: 1;
  color: var(--text-secondary);
  font-size: var(--font-size-caption);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wizard-text .text-blue {
  color: var(--text-brand);
  font-weight: var(--font-weight-bold);
}

.wizard-actions {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}
