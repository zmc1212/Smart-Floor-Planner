@import "../measure-modal/measure-modal.wxss";

.angle-modal-container {
  max-height: 88vh;
  overflow: hidden;
}

.step-indicator {
  display: flex;
  align-items: center;
  margin-bottom: var(--space-section);
}

.step-dot {
  width: 46rpx;
  height: 46rpx;
  border-radius: var(--radius-full);
  background: var(--neutral-100);
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: var(--font-weight-bold);
}

.step-dot.done,
.step-dot.current {
  background: var(--brand-primary);
  color: var(--text-inverse);
}

.step-line {
  flex: 1;
  height: 4rpx;
  background: var(--neutral-100);
}

.step-line.done {
  background: var(--brand-primary-60);
}

.step-info {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  padding: var(--space-lg);
  background: var(--bg-surface-soft);
  border-radius: var(--radius-lg);
  margin-bottom: var(--space-section);
}

.step-label {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
  color: var(--text-primary);
}

.step-desc {
  font-size: var(--font-size-caption);
  color: var(--text-secondary);
}

.triangle-preview {
  height: 260rpx;
  background: var(--bg-surface-soft);
  border-radius: var(--radius-lg);
  margin-bottom: var(--space-section);
  position: relative;
}

.triangle-svg-wrapper,
.tri-shape {
  width: 100%;
  height: 100%;
  position: relative;
}

.tri-edge {
  position: absolute;
  background: var(--brand-primary-60);
  border-radius: var(--radius-full);
}

.tri-edge.measuring,
.tri-edge.measured {
  background: var(--brand-primary);
}

.edge-a {
  width: 6rpx;
  height: 150rpx;
  left: 170rpx;
  top: 50rpx;
}

.edge-b {
  width: 210rpx;
  height: 6rpx;
  left: 170rpx;
  top: 200rpx;
}

.edge-d {
  width: 244rpx;
  height: 6rpx;
  left: 154rpx;
  top: 124rpx;
  transform: rotate(38deg);
}

.edge-label,
.angle-value {
  position: absolute;
  color: var(--text-brand);
  background: var(--bg-surface);
  border-radius: var(--radius-full);
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  white-space: nowrap;
}

.tri-vertex {
  position: absolute;
  width: 18rpx;
  height: 18rpx;
  border-radius: var(--radius-full);
  background: var(--brand-primary);
}

.vertex-origin { left: 161rpx; top: 192rpx; }
.vertex-a { left: 161rpx; top: 42rpx; }
.vertex-b { left: 372rpx; top: 192rpx; }

.tri-angle-arc {
  position: absolute;
  left: 210rpx;
  top: 160rpx;
}

.result-cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-md);
  margin-bottom: var(--space-section);
}

.result-card,
.angle-result-inner {
  background: var(--bg-surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-border-soft);
  padding: var(--space-lg);
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.result-card.active {
  background: var(--brand-primary-20);
}

.rc-label,
.rc-action,
.angle-result-label,
.angle-result-hint {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.rc-value,
.angle-result-value {
  font-size: 30rpx;
  font-weight: var(--font-weight-bold);
  color: var(--text-primary);
}

.angle-result {
  margin-bottom: var(--space-section);
}

.angle-result-inner.invalid {
  background: var(--status-cancelled-bg);
}
