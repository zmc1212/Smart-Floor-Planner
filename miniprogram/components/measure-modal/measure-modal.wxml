<view class="modal-overlay" wx:if="{{show}}">
  <view class="modal-container">
    <view class="modal-close" bindtap="onClose">关闭</view>

    <view class="title-section">
      <text class="modal-title">{{guidanceTitle}}</text>
      <text class="modal-subtitle">{{currentStep === 0 ? '测量层高' : '步骤 ' + currentStep + ' · 测量墙边'}}</text>
    </view>

    <view class="smart-card">
      <view class="smart-card-main">
        <text class="smart-kicker">{{smartKicker}}</text>
        <text class="smart-title">{{activeDirectionLabel}}</text>
        <text class="smart-desc">{{activeDirectionDesc}}</text>
      </view>
      <view class="smart-badge">{{smartBadgeText}}</view>
    </view>

    <view class="dir-preview-box">
      <view class="dir-angle-simulator" wx:if="{{selectedDirection === 'ANGLE'}}">
        <view class="angle-tri-edge edge-a-mini"></view>
        <view class="angle-tri-edge edge-b-mini"></view>
        <view class="angle-tri-edge edge-d-mini"></view>
        <view class="angle-tri-vertex"></view>
        <text class="angle-tri-label">角</text>
      </view>
      <view class="dir-room-simulator" wx:else>
        <view class="laser-line E {{selectedDirection === 'E' ? 'active' : ''}}"></view>
        <view class="laser-line S {{selectedDirection === 'S' ? 'active' : ''}}"></view>
        <view class="laser-line W {{selectedDirection === 'W' ? 'active' : ''}}"></view>
        <view class="laser-line N {{selectedDirection === 'N' ? 'active' : ''}}"></view>
        <view class="simulator-origin"></view>
      </view>
    </view>

    <view class="hint-section">
      <text class="hint-icon">!</text>
      <text class="hint-text">{{guidanceText}}</text>
    </view>

    <view class="advanced-toggle" wx:if="{{canOverrideDirection}}" bindtap="onToggleAdvanced">
      <text>{{showAdvancedDirections ? '收起方向选择' : '方向不对？手动修改'}}</text>
      <text class="toggle-arrow">{{showAdvancedDirections ? '↑' : '↓'}}</text>
    </view>

    <view class="direction-grid" wx:if="{{showAdvancedDirections}}">
      <view
        class="direction-cell {{selectedDirection === item.key ? 'active' : ''}}"
        wx:for="{{availableDirections}}"
        wx:key="key"
        data-dir="{{item.key}}"
        bindtap="onSelectDirection"
      >
        <text class="dir-label">{{item.label}}</text>
        <text class="dir-desc">{{item.desc}}</text>
      </view>
    </view>

    <view class="action-section">
      <view class="btn btn-primary btn-confirm" bindtap="onConfirm">{{primaryActionText}}</view>
      <view class="btn btn-outline btn-finish" wx:if="{{canFinish}}" bindtap="onFinish">测完了，闭合轮廓</view>
    </view>
  </view>
</view>
