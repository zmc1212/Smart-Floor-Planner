.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(31, 41, 55, 0.32);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}

.modal-container,
.angle-modal-container {
  width: 100%;
  max-width: 650rpx;
  background: var(--bg-surface);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-popup);
  padding: 40rpx;
  box-sizing: border-box;
}

.modal-close {
  align-self: flex-end;
  color: var(--text-secondary);
  font-size: var(--font-size-caption);
  text-align: right;
  margin-bottom: var(--space-lg);
}

.title-section {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  margin-bottom: var(--space-section);
}

.modal-title {
  font-size: 36rpx;
  font-weight: var(--font-weight-bold);
  color: var(--text-primary);
}

.modal-subtitle {
  font-size: var(--font-size-caption);
  color: var(--text-secondary);
}

.direction-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-lg);
  margin-bottom: var(--space-section);
}

.direction-cell {
  padding: var(--space-xl);
  background: var(--neutral-100);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-border-soft);
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.direction-cell.active {
  background: var(--brand-primary-20);
  box-shadow: inset 0 0 0 2rpx var(--brand-primary);
}

.dir-label {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
  color: var(--text-primary);
}

.dir-desc {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.dir-preview-box {
  height: 210rpx;
  border-radius: var(--radius-lg);
  background: var(--bg-surface-soft);
  margin-bottom: var(--space-section);
  position: relative;
  overflow: hidden;
}

.dir-room-simulator,
.dir-angle-simulator {
  width: 100%;
  height: 100%;
  position: relative;
}

.laser-line {
  position: absolute;
  background: var(--brand-primary-40);
  border-radius: var(--radius-full);
}

.laser-line.active {
  background: var(--brand-primary);
}

.laser-line.E,
.laser-line.W {
  width: 170rpx;
  height: 6rpx;
  top: 50%;
}

.laser-line.E { left: 50%; }
.laser-line.W { right: 50%; }

.laser-line.N,
.laser-line.S {
  width: 6rpx;
  height: 90rpx;
  left: 50%;
}

.laser-line.N { bottom: 50%; }
.laser-line.S { top: 50%; }

.simulator-origin,
.angle-tri-vertex {
  position: absolute;
  width: 22rpx;
  height: 22rpx;
  border-radius: var(--radius-full);
  background: var(--brand-primary);
  top: calc(50% - 11rpx);
  left: calc(50% - 11rpx);
}

.angle-tri-edge {
  position: absolute;
  background: var(--brand-primary);
  border-radius: var(--radius-full);
}

.edge-a-mini { width: 6rpx; height: 120rpx; left: 45%; top: 40rpx; }
.edge-b-mini { width: 150rpx; height: 6rpx; left: 45%; top: 156rpx; }
.edge-d-mini { width: 170rpx; height: 6rpx; left: 42%; top: 98rpx; transform: rotate(40deg); }

.angle-tri-label {
  position: absolute;
  left: 52%;
  top: 116rpx;
  color: var(--text-brand);
  font-size: var(--font-size-caption);
}

.hint-section {
  display: flex;
  gap: var(--space-md);
  padding: var(--space-lg);
  border-radius: var(--radius-lg);
  background: var(--bg-surface-soft);
  margin-bottom: var(--space-section);
}

.hint-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: var(--radius-full);
  background: var(--brand-primary);
  color: var(--text-inverse);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.hint-text {
  font-size: var(--font-size-caption);
  color: var(--text-secondary);
  line-height: 1.5;
}

.action-section {
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
}

.btn {
  min-height: 88rpx;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
}

.btn-primary {
  background: var(--brand-primary);
  color: var(--text-inverse);
  box-shadow: var(--shadow-float);
}

.btn-outline {
  background: var(--bg-surface);
  color: var(--text-brand);
  box-shadow: inset 0 0 0 1rpx var(--border-brand);
}
