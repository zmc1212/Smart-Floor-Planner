.toolbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 8rpx 24rpx rgba(85, 104, 90, 0.05);
  backdrop-filter: blur(16px);
  padding: 16rpx 24rpx;
  gap: var(--space-xl);
  z-index: 30;
  position: relative;
}

.tool-wrapper {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-sm);
}

.tool-wrapper.disabled {
  opacity: 0.28;
  pointer-events: none;
}

.tool-divider {
  width: 1rpx;
  height: 48rpx;
  background: var(--neutral-100);
  margin: 0 var(--space-xs);
}

.tool-btn {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 0 0 1rpx rgba(209, 213, 219, 0.45);
}

.tool-btn-active {
  background: linear-gradient(135deg, #0fb04d 0%, #18a94b 100%);
  box-shadow: 0 10rpx 20rpx rgba(17, 164, 66, 0.18);
}

.tool-btn-active .tool-icon {
  color: var(--text-inverse);
}

.tool-icon {
  font-size: 32rpx;
  color: var(--text-primary);
  line-height: 1;
}

.tool-label {
  font-size: 18rpx;
  color: var(--text-secondary);
  white-space: nowrap;
  font-weight: var(--font-weight-medium);
}

.tool-dot {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  width: 10rpx;
  height: 10rpx;
  background: var(--brand-primary);
  border-radius: var(--radius-full);
  border: 2rpx solid var(--bg-surface);
}

.room-type-menu {
  position: absolute;
  bottom: 100%;
  left: 50%;
  transform: translateX(-50%);
  margin-bottom: 20rpx;
  background: rgba(255, 255, 255, 0.96);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-popup);
  border: 1rpx solid rgba(207, 220, 207, 0.55);
  padding: var(--space-lg);
  min-width: 280rpx;
  z-index: 50;
}

.menu-header {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  margin-bottom: var(--space-md);
  padding: var(--space-sm) var(--space-md);
}

.menu-header-bar {
  width: 6rpx;
  height: 26rpx;
  background: var(--brand-primary);
  border-radius: var(--radius-full);
}

.menu-header-text {
  font-size: 22rpx;
  font-weight: var(--font-weight-bold);
  color: var(--text-primary);
}

.menu-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  border-radius: var(--radius-md);
  font-size: 26rpx;
  color: var(--text-secondary);
}

.menu-item:active,
.menu-item-active {
  background: var(--brand-primary-20);
  color: var(--text-brand);
  font-weight: var(--font-weight-medium);
}

.menu-item-check {
  font-size: 24rpx;
  color: var(--text-brand);
}

.menu-arrow {
  display: none;
}

.menu-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 29;
  background: transparent;
}
