<view wx:if="{{dialogMounted}}" class="dcs-root" catchtouchmove="noop" aria-role="dialog" aria-label="联系设计师">
  <view class="dcs-mask {{dialogOpen ? 'open' : ''}}" bindtap="onClose"></view>
  <view class="dcs-dialog {{dialogOpen ? 'open' : ''}}" catchtap="noop">
    <view class="dcs-card">
      <image
        class="dcs-xiao-k"
        src="/images/designer-contact/xiao-k-peeking.png"
        mode="aspectFit"
        aria-label="小K引导添加设计师微信"
      />

      <view class="dcs-surface">
        <view class="dcs-hero">
          <view class="dcs-spatial-mark" aria-hidden="true">
            <view class="dcs-spatial-room room-a"></view>
            <view class="dcs-spatial-room room-b"></view>
            <view class="dcs-spatial-room room-c"></view>
          </view>
          <block wx:if="{{hasQr}}">
            <text class="dcs-title">长按二维码，加设计师微信</text>
            <text class="dcs-subtitle">方案细节、户型想法，随时沟通</text>
          </block>
          <block wx:else>
            <text class="dcs-title">复制微信号，加设计师微信</text>
            <text class="dcs-subtitle">方案细节、户型想法，随时沟通</text>
          </block>
        </view>

        <view class="dcs-body">
          <view class="dcs-designer-pill">
            <text class="dcs-designer-label">你的专属设计师</text>
            <block wx:if="{{!professionalTitleVisible}}">
              <text class="dcs-designer-separator">·</text>
              <text class="dcs-designer-name">{{displayName}}</text>
            </block>
          </view>

          <view wx:if="{{professionalTitleVisible || professionalExperienceLabel || professionalServiceLabel}}" class="dcs-professional-profile">
            <view wx:if="{{professionalTitleVisible}}" class="dcs-professional-heading">
              <view class="dcs-professional-badge" aria-hidden="true">
                <image
                  class="dcs-professional-badge-icon"
                  src="/images/designer-contact/professional-badge.png"
                  mode="aspectFit"
                />
              </view>
              <text class="dcs-professional-title">{{professionalTitle}} · {{displayName}}</text>
            </view>
            <view wx:if="{{professionalTitleVisible && (professionalExperienceLabel || professionalServiceLabel)}}" class="dcs-professional-divider"></view>
            <view
              wx:if="{{professionalExperienceLabel || professionalServiceLabel}}"
              class="dcs-professional-proof {{professionalExperienceLabel && professionalServiceLabel ? '' : 'single'}}"
            >
              <view wx:if="{{professionalExperienceLabel}}" class="dcs-professional-proof-item experience">
                <image
                  class="dcs-professional-proof-icon"
                  src="/images/designer-contact/professional-experience.png"
                  mode="aspectFit"
                  aria-hidden="true"
                />
                <text class="dcs-professional-proof-text">{{professionalExperienceLabel}}</text>
              </view>
              <view wx:if="{{professionalExperienceLabel && professionalServiceLabel}}" class="dcs-professional-proof-separator"></view>
              <view wx:if="{{professionalServiceLabel}}" class="dcs-professional-proof-item service">
                <image
                  class="dcs-professional-proof-icon"
                  src="/images/designer-contact/professional-service.png"
                  mode="aspectFit"
                  aria-hidden="true"
                />
                <text class="dcs-professional-proof-text">{{professionalServiceLabel}}</text>
              </view>
            </view>
          </view>

          <view wx:if="{{hasQr}}" class="dcs-qr-block">
            <view class="dcs-qr-shell">
              <image
                wx:if="{{qrPath}}"
                class="dcs-qr"
                src="{{qrPath}}"
                mode="aspectFit"
                show-menu-by-longpress="{{true}}"
                bindtap="onPreviewQr"
                aria-label="设计师微信二维码，长按可识别添加"
              />
              <view wx:elif="{{qrLoading}}" class="dcs-qr-state">正在加载二维码…</view>
              <view wx:else class="dcs-qr-state error">
                <text>二维码暂时无法读取</text>
                <text class="dcs-retry" bindtap="onRetryQr">重新加载</text>
              </view>
              <view class="dcs-hold-pill" aria-hidden="true">按住二维码 2 秒</view>
            </view>
          </view>

          <view wx:if="{{wechatId}}" class="dcs-wechat-row">
            <text class="dcs-wechat">微信号　{{wechatId}}</text>
            <text class="dcs-copy" bindtap="onCopyWechat">复制</text>
          </view>
          <text wx:if="{{wechatId && hasQr}}" class="dcs-hint">识别不了？复制微信号后去微信搜索添加</text>
          <text wx:elif="{{wechatId}}" class="dcs-hint">复制微信号后，前往微信搜索添加</text>
          <text wx:elif="{{!hasQr}}" class="dcs-empty">设计师联系方式暂未提供</text>
        </view>
      </view>
    </view>

    <view class="dcs-close-action" bindtap="onClose" aria-role="button" aria-label="关闭联系设计师弹窗">
      <view class="dcs-close-circle">
        <image class="dcs-close-icon" src="/images/designer-contact/close.png" mode="aspectFit" />
      </view>
      <text class="dcs-close-label">关闭</text>
    </view>
  </view>
</view>
