<view wx:if="{{visible}}" class="designer-sheet-layer" aria-role="dialog" aria-label="设计师名片">
  <view class="designer-sheet-scrim" bindtap="onClose"></view>
  <view class="designer-sheet" catchtap="onSheetTap">
    <view class="designer-sheet-handle" aria-hidden="true"></view>
    <view class="designer-sheet-header">
      <view>
        <view class="designer-sheet-title">设计师名片</view>
        <view class="designer-sheet-subtitle">将客户微信交接给专属设计师</view>
      </view>
      <button class="designer-sheet-close" bindtap="onClose" aria-label="关闭设计师名片">关闭</button>
    </view>

    <view wx:if="{{profile}}" class="designer-sheet-body">
      <view class="designer-profile-row">
        <view class="designer-profile-avatar">
          <image src="/images/mine-icons/user.png" mode="aspectFit" />
        </view>
        <view class="designer-profile-copy">
          <view class="designer-profile-name">{{profile.displayName || profile.username || '专属设计师'}}</view>
          <view class="designer-profile-role">专属设计师 · 客户方案协作</view>
        </view>
      </view>

      <view class="designer-wechat-row">
        <view class="designer-wechat-label">微信号</view>
        <view class="designer-wechat-value">{{profile.wechatId || '暂未提供'}}</view>
      </view>

      <view class="designer-qr-panel">
        <view wx:if="{{qrImageUrl && !qrError}}" class="designer-qr-frame">
          <view wx:if="{{qrLoading}}" class="designer-qr-loading">二维码加载中…</view>
          <image
            class="designer-qr-image"
            src="{{qrImageUrl}}"
            mode="aspectFit"
            show-menu-by-longpress="{{true}}"
            bindload="onQrLoad"
            binderror="onQrError"
          />
        </view>
        <view wx:elif="{{qrError}}" class="designer-qr-state">
          <view class="designer-qr-state-title">二维码加载失败</view>
          <view class="designer-qr-state-copy">签名地址可能已过期，请重新获取</view>
          <button class="designer-qr-retry" bindtap="onRetryQr">重新加载</button>
        </view>
        <view wx:else class="designer-qr-state">
          <view class="designer-qr-state-title">暂未提供二维码</view>
          <view class="designer-qr-state-copy">可先复制微信号完成客户交接</view>
        </view>
        <view class="designer-qr-helper">长按二维码识别并添加设计师</view>
      </view>

      <button
        class="designer-copy-button {{profile.wechatId ? '' : 'is-disabled'}}"
        bindtap="onCopyWechat"
        aria-label="复制设计师微信号"
      >复制微信号</button>
    </view>

    <view wx:else class="designer-sheet-empty">设计师资料暂不可用，请返回后重试</view>
    <view class="designer-sheet-safe"></view>
  </view>
</view>
