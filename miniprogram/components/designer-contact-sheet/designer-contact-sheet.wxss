.designer-sheet-layer {
  position: fixed;
  z-index: 1200;
  inset: 0;
}

.designer-sheet-scrim {
  position: absolute;
  inset: 0;
  background: rgba(18, 28, 22, 0.46);
}

.designer-sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  max-height: 88vh;
  padding: 14rpx 28rpx 0;
  overflow-y: auto;
  border-radius: 34rpx 34rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -14rpx 42rpx rgba(19, 52, 31, 0.14);
  box-sizing: border-box;
  animation: designer-sheet-enter 180ms cubic-bezier(0.16, 1, 0.3, 1);
}

.designer-sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 20rpx;
  border-radius: 999rpx;
  background: #cfd6d1;
}

.designer-sheet-header,
.designer-profile-row,
.designer-wechat-row {
  display: flex;
  align-items: center;
}

.designer-sheet-header {
  min-height: 84rpx;
  justify-content: space-between;
  gap: 20rpx;
}

.designer-sheet-title {
  color: #17221b;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.2;
}

.designer-sheet-subtitle {
  margin-top: 8rpx;
  color: #758078;
  font-size: 22rpx;
  line-height: 1.35;
}

.designer-sheet-close {
  width: 96rpx;
  height: 76rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 38rpx;
  color: #536057;
  background: #f1f5f2;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 72rpx;
}

.designer-sheet-close::after,
.designer-copy-button::after,
.designer-qr-retry::after {
  border: 0;
}

.designer-sheet-body {
  margin-top: 24rpx;
}

.designer-profile-row {
  min-height: 116rpx;
  padding: 18rpx 20rpx;
  gap: 18rpx;
  border-radius: 22rpx;
  background: #eff9f2;
  box-sizing: border-box;
}

.designer-profile-avatar {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #ffffff;
}

.designer-profile-avatar image {
  width: 38rpx;
  height: 38rpx;
}

.designer-profile-copy {
  min-width: 0;
  flex: 1;
}

.designer-profile-name {
  overflow: hidden;
  color: #17221b;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.designer-profile-role {
  margin-top: 6rpx;
  color: #3f8f5b;
  font-size: 22rpx;
  line-height: 1.3;
}

.designer-wechat-row {
  min-height: 80rpx;
  margin-top: 16rpx;
  padding: 0 20rpx;
  justify-content: space-between;
  gap: 20rpx;
  border-radius: 18rpx;
  background: #f7f9f7;
  box-sizing: border-box;
}

.designer-wechat-label {
  color: #737d76;
  font-size: 24rpx;
}

.designer-wechat-value {
  overflow: hidden;
  color: #202a23;
  font-size: 26rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.designer-qr-panel {
  margin-top: 16rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #f5faf6;
  box-sizing: border-box;
}

.designer-qr-frame,
.designer-qr-state {
  position: relative;
  display: flex;
  width: 330rpx;
  height: 330rpx;
  margin: 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.designer-qr-image {
  width: 294rpx;
  height: 294rpx;
}

.designer-qr-loading {
  position: absolute;
  z-index: 2;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #738078;
  background: #ffffff;
  font-size: 22rpx;
}

.designer-qr-state {
  padding: 30rpx;
  flex-direction: column;
  text-align: center;
}

.designer-qr-state-title {
  color: #273129;
  font-size: 26rpx;
  font-weight: 700;
}

.designer-qr-state-copy,
.designer-qr-helper {
  color: #7a847c;
  font-size: 22rpx;
  line-height: 1.4;
}

.designer-qr-state-copy {
  margin-top: 10rpx;
}

.designer-qr-retry {
  min-width: 160rpx;
  min-height: 72rpx;
  margin-top: 22rpx;
  padding: 0 24rpx;
  border: 0;
  border-radius: 36rpx;
  color: #178344;
  background: #e8f7ed;
  font-size: 24rpx;
  line-height: 72rpx;
}

.designer-qr-helper {
  margin-top: 16rpx;
  text-align: center;
}

.designer-copy-button {
  width: 100%;
  min-height: 88rpx;
  margin: 20rpx 0 0;
  padding: 0 28rpx;
  border: 0;
  border-radius: 20rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #0fb04d 0%, #18a94b 100%);
  box-shadow: 0 10rpx 20rpx rgba(17, 164, 66, 0.2);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.designer-copy-button.is-disabled {
  color: #879088;
  background: #e7ece8;
  box-shadow: none;
}

.designer-sheet-empty {
  padding: 72rpx 24rpx;
  color: #707a72;
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
}

.designer-sheet-safe {
  height: calc(24rpx + env(safe-area-inset-bottom));
}

@keyframes designer-sheet-enter {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
