<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=1080, height=1920">
    <title>家客来小程序产品说明</title>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
    <style>
      body {
        margin: 0;
        background: #ffffff;
        color: #1f2937;
        font-family: "Source Han Sans", "PingFang SC", "Microsoft YaHei", sans-serif;
      }
      #root {
        position: relative;
        width: 1080px;
        height: 1920px;
        overflow: hidden;
        background: #ffffff;
      }
      .clip {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
      }
    </style>
  </head>
  <body>
    <div data-hf-id="hf-qs5z" id="root" data-composition-id="main" data-start="0" data-width="1080" data-height="1920" data-duration="102.25">
      <section data-hf-id="hf-9b5o" id="placeholder" class="clip" data-start="12.25" data-duration="90"></section>
    </div>
    <script>
      const tl = gsap.timeline({ paused: true });
      window.__timelines["main"] = tl;
    </script>
  </body>
</html>
